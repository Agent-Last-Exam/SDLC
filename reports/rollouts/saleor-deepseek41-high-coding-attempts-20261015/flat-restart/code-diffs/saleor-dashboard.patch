+    mockPermission(true);
+    const onRetry = jest.fn();
+
+    // Act
+    const { getByTestId } = renderItem({ onRetry });
+
+    // Assert
+    const retryButton = getByTestId("retry-delivery-delivery-1");
+
+    expect(retryButton).toBeInTheDocument();
+
+    fireEvent.click(retryButton);
+    expect(onRetry).toHaveBeenCalledWith("delivery-1");
+  });
+
+  it("shows the retry action for a RETRYING delivery", () => {
+    // Arrange
+    mockPermission(true);
+
+    // Act
+    const { getByTestId } = renderItem({
+      status: EventDeliveryStatusEnum.RETRYING,
+      onRetry: jest.fn(),
+    });
+
+    // Assert
+    expect(getByTestId("retry-delivery-delivery-1")).toBeInTheDocument();
