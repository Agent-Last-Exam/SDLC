+import Wrapper from "@test/wrapper";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+
+import CategoryHierarchyBreadcrumb from "./CategoryHierarchyBreadcrumb";
+
+const path = [
+  { id: "a", name: "A" },
+  { id: "a1", name: "A1" },
+];
+
+describe("CategoryHierarchyBreadcrumb", () => {
+  it("renders the whole path and navigates to the clicked level", () => {
+    // Arrange
+    const onNavigate = jest.fn();
+
+    // Act
+    render(
+      <Wrapper>
+        <CategoryHierarchyBreadcrumb path={path} onNavigate={onNavigate} />
+      </Wrapper>,
+    );
+
+    // Assert
+    expect(screen.getByTestId("category-hierarchy-breadcrumb")).toBeInTheDocument();
+    expect(screen.getByTestId("breadcrumb-a")).toHaveTextContent("A");
+
+    fireEvent.click(screen.getByTestId("breadcrumb-a"));
+    expect(onNavigate).toHaveBeenCalledWith("a");
+  });
+
+  it("navigates back to the root level", () => {
+    // Arrange
+    const onNavigate = jest.fn();
+
+    // Act
+    render(
+      <Wrapper>
+        <CategoryHierarchyBreadcrumb path={path} onNavigate={onNavigate} />
+      </Wrapper>,
+    );
