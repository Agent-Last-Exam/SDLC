+    );
+    const { getByText: getSuccess } = render(
+      <EventDeliveryStatusChip status={EventDeliveryStatusEnum.SUCCESS} />,
+    );
+    const { getByText: getFailed } = render(
+      <EventDeliveryStatusChip status={EventDeliveryStatusEnum.FAILED} />,
+    );
+    const { getByText: getRetrying } = render(
+      <EventDeliveryStatusChip status={EventDeliveryStatusEnum.RETRYING} />,
+    );
+
+    // Assert
+    expect(getPending("Pending")).toBeInTheDocument();
+    expect(getSuccess("Success")).toBeInTheDocument();
+    expect(getFailed("Failed")).toBeInTheDocument();
+    expect(getRetrying("Retrying")).toBeInTheDocument();
+  });
+
+  it("does not display an async, not-yet-generated delivery as success (AC-23-5)", () => {
+    // Arrange & Act - a registered delivery whose payload is not built yet is PENDING
+    const { queryByText, getByText } = render(
+      <EventDeliveryStatusChip status={EventDeliveryStatusEnum.PENDING} />,
+    );
+
+    // Assert
+    expect(getByText("Pending")).toBeInTheDocument();
+    expect(queryByText("Success")).not.toBeInTheDocument();
+  });
+
