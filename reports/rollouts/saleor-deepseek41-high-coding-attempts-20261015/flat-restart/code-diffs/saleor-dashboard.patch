+++ b/src/products/components/ProductChannelDiagnostics/index.tsx
@@ -0,0 +1,204 @@
+import { useUserPermissions } from "@dashboard/auth/hooks/useUserPermissions";
+import { hasPermissions } from "@dashboard/components/RequirePermissions";
+import {
+  ChannelAvailabilityDiagnosticsQueryVariables,
+  PermissionEnum,
+  ProductChannelAvailabilityDiagnosticsSortField,
+  OrderDirection,
+  useChannelAvailabilityDiagnosticsQuery,
+} from "@dashboard/graphql";
+import { useEffect, useMemo, useRef, useState } from "react";
+
+import ProductChannelDiagnostics from "./ProductChannelDiagnostics";
+import { DiagnosticsViewState } from "./types";
+import { computeDiagnosticsState } from "./utils";
+
+export const DIAGNOSTICS_PAGE_SIZE = 10;
+
+const SORT_BY: ChannelAvailabilityDiagnosticsQueryVariables["sortBy"] = {
+  field: ProductChannelAvailabilityDiagnosticsSortField.CHANNEL_NAME,
+  direction: OrderDirection.ASC,
+};
+
+export interface ProductChannelDiagnosticsContainerProps {
+  /** Product id. Diagnostics are only fetched for an already saved product. */
+  productId?: string | null;
+  /**
+   * Opaque key describing the current editing context. When it changes while a
+   * request is in flight, the late response is discarded so it is never treated
+   * as the latest conclusion.
+   */
+  editContextKey?: string;
+}
+
+const INITIAL_STATE: DiagnosticsViewState = {
+  status: "loading",
+  channels: [],
+  totalCount: 0,
+};
+
+const ProductChannelDiagnosticsContainer = ({
+  productId,
+  editContextKey = "",
+}: ProductChannelDiagnosticsContainerProps) => {
+  const userPermissions = useUserPermissions();
+  const hasPermission = hasPermissions(userPermissions ?? [], [PermissionEnum.MANAGE_PRODUCTS]);
+
+  const [channelFilter, setChannelFilter] = useState("");
+  const [currencyFilter, setCurrencyFilter] = useState("");
+  const [pagination, setPagination] = useState<
+    Pick<ChannelAvailabilityDiagnosticsQueryVariables, "after" | "before" | "first" | "last">
+  >({ first: DIAGNOSTICS_PAGE_SIZE });
+  const [state, setState] = useState<DiagnosticsViewState>(INITIAL_STATE);
+
+  const filter = useMemo<ChannelAvailabilityDiagnosticsQueryVariables["filter"]>(() => {
+    const next: NonNullable<ChannelAvailabilityDiagnosticsQueryVariables["filter"]> = {};
+
+    if (channelFilter) {
+      next.channel = channelFilter;
+    }
+
+    if (currencyFilter) {
+      next.currency = currencyFilter;
+    }
+
+    return Object.keys(next).length > 0 ? next : undefined;
+  }, [channelFilter, currencyFilter]);
+
+  const enabled = Boolean(productId) && hasPermission;
+
+  // requestId of the currently available data (bumped only when query variables change)
+  const variablesKey = JSON.stringify({ productId, filter, pagination });
+  const variablesRequestIdRef = useRef(0);
+  const lastVariablesKeyRef = useRef<string | null>(null);
+
+  if (lastVariablesKeyRef.current !== variablesKey) {
+    lastVariablesKeyRef.current = variablesKey;
+    variablesRequestIdRef.current += 1;
+  }
+
+  // requestId of the latest issued request (bumped when variables OR editing context change)
+  const contextKey = JSON.stringify({ productId, filter, pagination, editContextKey });
+  const currentRequestIdRef = useRef(0);
+  const lastContextKeyRef = useRef<string | null>(null);
+
+  if (lastContextKeyRef.current !== contextKey) {
+    lastContextKeyRef.current = contextKey;
+    currentRequestIdRef.current += 1;
+  }
+
+  const variablesRequestId = variablesRequestIdRef.current;
+  const currentRequestId = currentRequestIdRef.current;
+
+  const { data, loading, error, refetch } = useChannelAvailabilityDiagnosticsQuery({
+    variables: {
+      id: productId ?? "",
+      filter,
+      sortBy: SORT_BY,
+      ...pagination,
+    },
+    skip: !enabled,
+    fetchPolicy: "cache-and-network",
+  });
+
+  const connection = data?.product?.channelAvailabilityDiagnostics;
+  // Keep stable references so the state effect only re-runs when the query result changes.
+  const edges = useMemo(
+    () => data?.product?.channelAvailabilityDiagnostics?.edges ?? null,
+    [data],
+  );
+  const totalCount = data?.product?.channelAvailabilityDiagnostics?.totalCount;
+
+  useEffect(() => {
+    if (!hasPermission) {
+      setState(prev =>
+        computeDiagnosticsState({
+          hasPermission,
+          requestId: variablesRequestId,
+          currentRequestId,
+          loading,
+          error: Boolean(error),
+          edges: null,
+          totalCount: 0,
+          previous: prev,
+        }),
+      );
+
+      return;
+    }
+
+    if (!enabled) {
+      return;
+    }
+
+    setState(prev =>
+      computeDiagnosticsState({
+        hasPermission,
+        requestId: variablesRequestId,
+        currentRequestId,
+        loading,
+        error: Boolean(error),
+        edges,
+        totalCount,
+        previous: prev,
+      }),
+    );
+  }, [
+    hasPermission,
+    enabled,
+    variablesRequestId,
+    currentRequestId,
+    loading,
+    error,
+    edges,
+    totalCount,
+  ]);
+
+  if (!productId) {
+    return null;
+  }
+
+  const handleChannelFilterChange = (value: string) => {
+    setChannelFilter(value);
+    setPagination({ first: DIAGNOSTICS_PAGE_SIZE });
+  };
+
+  const handleCurrencyFilterChange = (value: string) => {
+    setCurrencyFilter(value);
+    setPagination({ first: DIAGNOSTICS_PAGE_SIZE });
+  };
+
+  const handleNextPage = () => {
+    const endCursor = connection?.pageInfo?.endCursor;
+
+    if (endCursor) {
+      setPagination({ after: endCursor, first: DIAGNOSTICS_PAGE_SIZE });
+    }
+  };
+
+  const handlePreviousPage = () => {
+    const startCursor = connection?.pageInfo?.startCursor;
+
+    if (startCursor) {
+      setPagination({ before: startCursor, last: DIAGNOSTICS_PAGE_SIZE });
+    }
+  };
+
+  return (
+    <ProductChannelDiagnostics
+      state={state}
+      channelFilter={channelFilter}
+      currencyFilter={currencyFilter}
+      hasNextPage={Boolean(connection?.pageInfo?.hasNextPage)}
+      hasPreviousPage={Boolean(connection?.pageInfo?.hasPreviousPage)}
+      onChannelFilterChange={handleChannelFilterChange}
+      onCurrencyFilterChange={handleCurrencyFilterChange}
+      onRetry={() => refetch()}
+      onNextPage={handleNextPage}
+      onPreviousPage={handlePreviousPage}
+    />
+  );
+};
+
+ProductChannelDiagnosticsContainer.displayName = "ProductChannelDiagnosticsContainer";
+export default ProductChannelDiagnosticsContainer;
