+import { fireEvent, render } from "@testing-library/react";
+
+import {
+  AutomaticallyCompleteCheckouts,
+  fromDateTimeLocalValue,
+  toDateTimeLocalValue,
+} from "./AutomaticallyCompleteCheckouts";
+
+const renderComponent = (
+  props: Partial<React.ComponentProps<typeof AutomaticallyCompleteCheckouts>> = {},
+) =>
+  render(
+    <AutomaticallyCompleteCheckouts
+      onChange={jest.fn()}
+      isChecked
+      hasError={false}
+      automaticCompletionDelay={null}
+      automaticCompletionCutoffDate={null}
+      {...props}
+    />,
+  );
+
+describe("toDateTimeLocalValue / fromDateTimeLocalValue", () => {
+  it("round-trips an ISO date into the datetime-local format and back", () => {
+    // Arrange
+    const iso = "2024-05-01T10:30:00.000Z";
+
+    // Act
+    const local = toDateTimeLocalValue(iso);
+    const backToIso = fromDateTimeLocalValue(local);
+
+    // Assert
+    expect(local).toMatch(/^2024-05-01T/);
+    expect(backToIso).not.toBeNull();
+  });
+
+  it("returns null for an empty value", () => {
+    // Arrange & Act & Assert
+    expect(fromDateTimeLocalValue("")).toBeNull();
+    expect(toDateTimeLocalValue(null)).toBe("");
+  });
+});
+
+describe("AutomaticallyCompleteCheckouts", () => {
+  it("reads the configured delay and cutoff values", () => {
+    // Arrange & Act
+    const { container } = renderComponent({
+      automaticCompletionDelay: 30,
+      automaticCompletionCutoffDate: "2024-05-01T10:30:00.000Z",
+    });
+
+    // Assert
+    const delayInput = container.querySelector<HTMLInputElement>(
+      'input[name="automaticCompletionDelay"]',
+    );
+    const cutoffInput = container.querySelector<HTMLInputElement>(
+      'input[name="automaticCompletionCutoffDate"]',
+    );
+
+    expect(delayInput?.value).toBe("30");
+    expect(cutoffInput?.value).toMatch(/^2024-05-01T/);
+  });
+
+  it("submits the delay as a number", () => {
+    // Arrange
+    const onChange = jest.fn();
+    const { container } = renderComponent({ onChange });
+    const delayInput = container.querySelector<HTMLInputElement>(
+      'input[name="automaticCompletionDelay"]',
+    )!;
+
+    // Act
+    fireEvent.change(delayInput, { target: { value: "45" } });
+
+    // Assert
+    expect(onChange).toHaveBeenCalledWith({
+      target: { name: "automaticCompletionDelay", value: 45 },
+    });
+  });
+
+  it("clears the delay to null when emptied", () => {
+    // Arrange
+    const onChange = jest.fn();
+    const { container } = renderComponent({ onChange, automaticCompletionDelay: 45 });
+    const delayInput = container.querySelector<HTMLInputElement>(
+      'input[name="automaticCompletionDelay"]',
+    )!;
+
+    // Act
+    fireEvent.change(delayInput, { target: { value: "" } });
+
+    // Assert
+    expect(onChange).toHaveBeenCalledWith({
+      target: { name: "automaticCompletionDelay", value: null },
+    });
+  });
+
+  it("submits the cutoff as an ISO DateTime value", () => {
+    // Arrange
+    const onChange = jest.fn();
+    const { container } = renderComponent({ onChange });
+    const cutoffInput = container.querySelector<HTMLInputElement>(
+      'input[name="automaticCompletionCutoffDate"]',
+    )!;
+
+    // Act
+    fireEvent.change(cutoffInput, { target: { value: "2024-06-01T12:00" } });
+
+    // Assert
+    expect(onChange).toHaveBeenCalledWith({
+      target: { name: "automaticCompletionCutoffDate", value: expect.stringMatching(/^2024-06-01T/) },
+    });
+  });
+
+  it("explains that the cutoff is a lower bound of the creation time, not a stop time (AC-06-3)", () => {
+    // Arrange & Act
+    const { getByText } = renderComponent();
+
+    // Assert
+    expect(
+      getByText(
+        "Lower bound of the checkout creation time. Only checkouts created at or after this moment are picked up. This is not a moment at which the task stops running.",
+      ),
+    ).toBeInTheDocument();
+  });
+
+  it("does not claim that orders were generated after saving (AC-06-7)", () => {
+    // Arrange & Act
+    const { queryByText } = renderComponent();
+
+    // Assert
+    expect(queryByText(/order(s)? (has|have) been (created|generated)/i)).not.toBeInTheDocument();
+  });
+
+  it("keeps the delay and cutoff fields hidden while automatic completion is off (AC-06-1)", () => {
+    // Arrange & Act
+    const { container } = renderComponent({ isChecked: false });
+
+    // Assert
+    expect(container.querySelector('input[name="automaticCompletionDelay"]')).toBeNull();
+    expect(container.querySelector('input[name="automaticCompletionCutoffDate"]')).toBeNull();
+  });
+});
