--- /dev/null
+++ b/src/orders/utils/draftActions.test.ts
@@ -0,0 +1,106 @@
+import { ChannelUsabilityDataQuery, OrderDetailsFragment } from "@dashboard/graphql";
+
+import {
+  draftOrderActionMessages,
+  getDraftOrderActionAvailability,
+  getDraftOrderConditions,
+} from "./draftActions";
+
+const order = (overrides: Partial<OrderDetailsFragment> = {}): OrderDetailsFragment =>
+  ({
+    channel: { isActive: true },
+    shippingAddress: { country: { code: "US" } },
+    lines: [{ id: "line-1" }],
+    shippingMethods: [{ id: "sm-1" }],
+    ...overrides,
+  }) as unknown as OrderDetailsFragment;
+
+const usability = (totalCount: number): ChannelUsabilityDataQuery =>
+  ({ products: { totalCount } }) as unknown as ChannelUsabilityDataQuery;
+
+describe("orders/utils/draftActions", () => {
+  describe("getDraftOrderConditions", () => {
+    it("reads channel activity, product count and shipping-method determinability", () => {
+      // Act
+      const conditions = getDraftOrderConditions(order(), usability(5));
+
+      // Assert
+      expect(conditions).toEqual({
+        isChannelActive: true,
+        hasProductsInChannel: true,
+        shippingMethodsDeterminable: true,
+        hasShippingMethods: true,
+      });
+    });
+
+    it("cannot determine shipping methods without an address or lines", () => {
+      // Act
+      const conditions = getDraftOrderConditions(
+        order({ shippingAddress: null, lines: [] }),
+        usability(5),
+      );
+
+      // Assert
+      expect(conditions.shippingMethodsDeterminable).toBe(false);
+    });
+  });
+
+  describe("getDraftOrderActionAvailability", () => {
+    it("enables both actions when all conditions hold", () => {
+      // Arrange
+      const conditions = getDraftOrderConditions(order(), usability(5));
+
+      // Act / Assert
+      expect(getDraftOrderActionAvailability("addProducts", conditions).available).toBe(true);
+      expect(getDraftOrderActionAvailability("finalize", conditions).available).toBe(true);
+    });
+
+    it("disables actions on an inactive channel and explains why", () => {
+      // Arrange
+      const conditions = getDraftOrderConditions(
+        order({ channel: { isActive: false } as any }),
+        usability(5),
+      );
+
+      // Act
+      const addProducts = getDraftOrderActionAvailability("addProducts", conditions);
+      const finalize = getDraftOrderActionAvailability("finalize", conditions);
+
+      // Assert
+      expect(addProducts.available).toBe(false);
+      expect(addProducts.reasons).toContain(draftOrderActionMessages.inactiveChannel);
+      expect(finalize.available).toBe(false);
+      expect(finalize.reasons).toContain(draftOrderActionMessages.inactiveChannel);
+    });
+
+    it("disables actions when there are no products in the channel", () => {
+      // Arrange
+      const conditions = getDraftOrderConditions(order(), usability(0));
+
+      // Act
+      const addProducts = getDraftOrderActionAvailability("addProducts", conditions);
+
+      // Assert
+      expect(addProducts.available).toBe(false);
+      expect(addProducts.reasons).toContain(draftOrderActionMessages.noProductsInChannel);
+    });
+
+    it("only requires shipping methods to finalize, and only when determinable", () => {
+      // Arrange
+      const determinable = getDraftOrderConditions(order({ shippingMethods: [] }), usability(5));
+      const notDeterminable = getDraftOrderConditions(
+        order({ shippingMethods: [], shippingAddress: null, lines: [] }),
+        usability(5),
+      );
+
+      // Act / Assert
+      expect(getDraftOrderActionAvailability("addProducts", determinable).available).toBe(true);
+      expect(getDraftOrderActionAvailability("finalize", determinable).available).toBe(false);
+      expect(getDraftOrderActionAvailability("finalize", determinable).reasons).toContain(
+        draftOrderActionMessages.noShippingMethods,
+      );
+      // nothing to ship yet -> finalize is not blocked by the missing methods
+      expect(getDraftOrderActionAvailability("finalize", notDeterminable).available).toBe(true);
+    });
+  });
+});
