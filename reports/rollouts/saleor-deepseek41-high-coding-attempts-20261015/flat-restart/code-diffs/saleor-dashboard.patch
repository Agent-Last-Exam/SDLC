@@ -0,0 +1,74 @@
+/**
+ * Shared, dependency-free helpers describing the search semantics used by list
+ * filters, dialogs and the conditional filter UI (FD09 / R12 / R13).
+ *
+ * Keeping them pure makes the "empty keyword", "too long" and "invalid input"
+ * behaviour explicit and testable, and lets every entry point apply the same
+ * rules instead of relying on ad-hoc checks.
+ */
+
+/** Hard upper bound for a search keyword. Longer input is treated as invalid. */
+export const MAX_SEARCH_QUERY_LENGTH = 250;
+
+export type SearchQueryInvalidReason = "empty" | "too-long" | "invalid";
+
+export type SearchQueryValidation =
+  | { valid: true; query: string }
+  | { valid: false; reason: SearchQueryInvalidReason; query: string };
+
+/** Trim a raw keyword, tolerating null/undefined. */
+export const normalizeSearchQuery = (query?: string | null): string => (query ?? "").trim();
+
+/** True when the keyword is empty or only whitespace. */
+export const isEmptySearchQuery = (query?: string | null): boolean =>
+  normalizeSearchQuery(query).length === 0;
+
+/** True when the keyword exceeds the maximum allowed length. */
+export const isTooLongSearchQuery = (query?: string | null): boolean =>
+  normalizeSearchQuery(query).length > MAX_SEARCH_QUERY_LENGTH;
+
+/** Control characters are never valid in a search keyword. */
+const hasInvalidCharacters = (query: string): boolean =>
+  // eslint-disable-next-line no-control-regex
+  /[\u0000-\u0008\u000b\u000c\u000e-\u001f]/.test(query);
+
+/**
+ * Validate a keyword.
+ * - empty / whitespace-only -> `empty`
+ * - longer than `MAX_SEARCH_QUERY_LENGTH` -> `too-long`
+ * - contains control characters -> `invalid`
+ */
+export const validateSearchQuery = (query?: string | null): SearchQueryValidation => {
+  const normalized = normalizeSearchQuery(query);
+
+  if (normalized.length === 0) {
+    return { valid: false, reason: "empty", query: normalized };
+  }
+
+  if (normalized.length > MAX_SEARCH_QUERY_LENGTH) {
+    return { valid: false, reason: "too-long", query: normalized };
+  }
+
+  if (hasInvalidCharacters(normalized)) {
+    return { valid: false, reason: "invalid", query: normalized };
+  }
+
+  return { valid: true, query: normalized };
+};
+
+/** True when a non-empty keyword is safe to send to the backend. */
+export const isValidSearchQuery = (query?: string | null): boolean =>
+  validateSearchQuery(query).valid;
+
+/**
+ * Whether a search request should be skipped entirely because the keyword is
+ * malformed (too long / invalid). Empty keywords are intentionally not skipped
+ * here: callers decide whether an empty keyword clears the list or is ignored.
+ */
+export const shouldSkipInvalidSearchQuery = (query?: string | null): boolean => {
+  if (isEmptySearchQuery(query)) {
+    return false;
+  }
+
+  return !isValidSearchQuery(query);
+};
