index 0000000000000000000000000000000000000000..8321d66f30838c1b738d78d28a9ee7130956f67b
--- /dev/null
+++ b/src/orders/utils/paymentActions.ts
@@ -0,0 +1,245 @@
+import {
+  OrderAction,
+  OrderDetailsFragment,
+  OrderStatus,
+  TransactionActionEnum,
+  TransactionItemFragment,
+} from "@dashboard/graphql";
+
+/**
+ * Centralised rules for which manual funds actions are available on an order or a
+ * single transaction, together with a machine readable reason when they are not.
+ *
+ * This replaces the inline `order.actions.includes(...)` checks that used to be
+ * scattered across `OrderPayment`, `OrderPaymentSummaryCard`, `OrderTransaction`
+ * card titles and the refund form. Keeping the rules in one place makes them
+ * auditable and lets every consumer show the same reason.
+ */
+
+export type OrderPaymentAction = "capture" | "void" | "refund" | "markAsPaid";
+
+export type PaymentActionUnavailableReason =
+  | "missing_permission"
+  | "order_canceled"
+  | "existing_payment"
+  | "no_balance"
+  | "amount_invalid"
+  | "amount_zero"
+  | "amount_exceeds_authorized"
+  | "amount_exceeds_refundable";
+
+export interface PaymentActionAvailability {
+  available: boolean;
+  reason?: PaymentActionUnavailableReason;
+}
+
+const available: PaymentActionAvailability = { available: true };
+
+const unavailable = (reason: PaymentActionUnavailableReason): PaymentActionAvailability => ({
+  available: false,
+  reason,
+});
+
+export const isAvailable = (availability: PaymentActionAvailability | undefined): boolean =>
+  !!availability?.available;
+
+export const isValidPaymentAmount = (amount: number | null | undefined): boolean =>
+  typeof amount === "number" && Number.isFinite(amount) && amount >= 0;
+
+/** Any existing payment or transaction means the order is not "unpaid" anymore. */
+export const hasExistingPaymentRecords = (order: OrderDetailsFragment | undefined): boolean =>
+  (order?.payments?.length ?? 0) > 0 || (order?.transactions?.length ?? 0) > 0;
+
+export const canMarkAsPaid = (order: OrderDetailsFragment | undefined): PaymentActionAvailability => {
+  if (!order) {
+    return unavailable("missing_permission");
+  }
+
+  if (order.status === OrderStatus.CANCELED) {
+    return unavailable("order_canceled");
+  }
+
+  if (!(order.actions ?? []).includes(OrderAction.MARK_AS_PAID)) {
+    return unavailable("missing_permission");
+  }
+
+  if (hasExistingPaymentRecords(order)) {
+    return unavailable("existing_payment");
+  }
+
+  return available;
+};
+
+/**
+ * Availability for the order level actions (Payment flow).
+ * A canceled order never exposes funds actions.
+ */
+export const getOrderActionAvailability = (
+  order: OrderDetailsFragment | undefined,
+): Record<OrderPaymentAction, PaymentActionAvailability> => {
+  const actions = order?.actions ?? [];
+  const isCanceled = order?.status === OrderStatus.CANCELED;
+
+  const gate = (action: OrderAction): PaymentActionAvailability => {
+    if (isCanceled) {
+      return unavailable("order_canceled");
+    }
+
+    return actions.includes(action) ? available : unavailable("missing_permission");
+  };
+
+  return {
+    capture: gate(OrderAction.CAPTURE),
+    void: gate(OrderAction.VOID),
+    refund: gate(OrderAction.REFUND),
+    markAsPaid: canMarkAsPaid(order),
+  };
+};
+
+export const getAvailableOrderActions = (
+  order: OrderDetailsFragment | undefined,
+): OrderPaymentAction[] =>
+  (Object.keys(getOrderActionAvailability(order)) as OrderPaymentAction[]).filter(action =>
+    isAvailable(getOrderActionAvailability(order)[action]),
+  );
+
+/**
+ * Amount currently available to capture. Capture cannot exceed the outstanding
+ * authorization (authorized funds that were not charged yet).
+ */
+export const getMaxCapturableAmount = (order: OrderDetailsFragment | undefined): number => {
+  const authorized = order?.totalAuthorized?.amount ?? 0;
+  const charged = order?.totalCharged?.amount ?? 0;
+
+  return Math.max(0, authorized - charged);
+};
+
+export const canCaptureAmount = (
+  order: OrderDetailsFragment | undefined,
+  amount: number | null | undefined,
+): PaymentActionAvailability => {
+  if (!isAvailable(getOrderActionAvailability(order).capture)) {
+    return getOrderActionAvailability(order).capture;
+  }
+
+  if (!isValidPaymentAmount(amount)) {
+    return unavailable("amount_invalid");
+  }
+
+  if (!amount) {
+    return unavailable("amount_zero");
+  }
+
+  if (amount > getMaxCapturableAmount(order)) {
+    return unavailable("amount_exceeds_authorized");
+  }
+
+  return available;
+};
+
+/** Amount that can still be refunded on the order (captured minus refunded/pending). */
+export const getRefundableAmount = (order: OrderDetailsFragment | undefined): number => {
+  const charged = order?.totalCharged?.amount ?? 0;
+  const refunded = order?.totalRefunded?.amount ?? 0;
+  const refundPending = order?.totalRefundPending?.amount ?? 0;
+
+  return Math.max(0, charged - refunded - refundPending);
+};
+
+export const canRefundAmount = (
+  order: OrderDetailsFragment | undefined,
+  amount: number | null | undefined,
+): PaymentActionAvailability => {
+  if (!isAvailable(getOrderActionAvailability(order).refund)) {
+    return getOrderActionAvailability(order).refund;
+  }
+
+  if (!isValidPaymentAmount(amount)) {
+    return unavailable("amount_invalid");
+  }
+
+  if (!amount) {
+    return unavailable("amount_zero");
+  }
+
+  if (amount > getRefundableAmount(order)) {
+    return unavailable("amount_exceeds_refundable");
+  }
+
+  return available;
+};
+
+/** Refundable amount on a single transaction, tracked per transaction so the same
+ * balance is not occupied twice across multiple transactions. */
+export const getTransactionRefundableAmount = (
+  transaction: TransactionItemFragment | undefined,
+): number => {
+  const charged = transaction?.chargedAmount?.amount ?? 0;
+  const refunded = transaction?.refundedAmount?.amount ?? 0;
+  const refundPending = transaction?.refundPendingAmount?.amount ?? 0;
+
+  return Math.max(0, charged - refunded - refundPending);
+};
+
+export const canRefundTransactionAmount = (
+  transaction: TransactionItemFragment | undefined,
+  amount: number | null | undefined,
+): PaymentActionAvailability => {
+  if (!transaction?.actions?.includes(TransactionActionEnum.REFUND)) {
+    return unavailable("missing_permission");
+  }
+
+  if (!isValidPaymentAmount(amount)) {
+    return unavailable("amount_invalid");
+  }
+
+  if (!amount) {
+    return unavailable("amount_zero");
+  }
+
+  if (amount > getTransactionRefundableAmount(transaction)) {
+    return unavailable("amount_exceeds_refundable");
+  }
+
+  return available;
+};
+
+/**
+ * Actions exposed for a single transaction. `REFUND` is intentionally filtered
+ * out: refunds are handled by the dedicated send-refund flow, not the transaction
+ * card, to avoid duplicating the action.
+ */
+export const getAvailableTransactionActions = (
+  transaction: { actions?: TransactionActionEnum[] } | undefined,
+): TransactionActionEnum[] =>
+  (transaction?.actions ?? []).filter(action => action !== TransactionActionEnum.REFUND);
+
+export interface PaymentActionGuard {
+  /** Returns true the first time a key is seen while it is in-flight, false afterwards. */
+  acquire: (key: string) => boolean;
+  release: (key: string) => void;
+}
+
+/**
+ * Tiny in-memory guard that makes repeated submissions of the same funds action
+ * idempotent on the client: a second click while the first request is in flight
+ * is ignored instead of issuing a duplicate mutation.
+ */
+export const createPaymentActionGuard = (): PaymentActionGuard => {
+  const inFlight = new Set<string>();
+
+  return {
+    acquire: (key: string) => {
+      if (inFlight.has(key)) {
+        return false;
+      }
+
+      inFlight.add(key);
+
+      return true;
+    },
+    release: (key: string) => {
+      inFlight.delete(key);
+    },
+  };
+};
