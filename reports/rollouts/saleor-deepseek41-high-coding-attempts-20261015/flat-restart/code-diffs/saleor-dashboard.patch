+import {
+  buildBreadcrumbPath,
+  getAncestorIds,
+  getChildNodes,
+  isDescendantOf,
+} from "./categoryHierarchy";
+
+const nodes = [
+  { id: "root", name: "Root", parentId: null },
+  { id: "a", name: "A", parentId: "root" },
+  { id: "b", name: "B", parentId: "root" },
+  { id: "a1", name: "A1", parentId: "a" },
+  { id: "a1x", name: "A1X", parentId: "a1" },
+];
+
+describe("categoryHierarchy", () => {
+  describe("getChildNodes", () => {
+    it("returns direct children of a node", () => {
+      expect(getChildNodes(nodes, "root").map(n => n.id)).toEqual(["a", "b"]);
+    });
+
+    it("returns root-level nodes when parentId is null", () => {
+      expect(getChildNodes(nodes, null).map(n => n.id)).toEqual(["root"]);
+    });
+
+    it("keeps parent/child relationships consistent when descending", () => {
+      // Act: descend root -> a -> a1
+      const levelA = getChildNodes(nodes, "root").find(n => n.id === "a");
+      const levelA1 = getChildNodes(nodes, levelA.id);
+
+      // Assert
+      expect(levelA1.map(n => n.id)).toEqual(["a1"]);
+      expect(levelA1.every(n => n.parentId === "a")).toBe(true);
+    });
+  });
+
+  describe("getAncestorIds", () => {
+    it("returns ancestors ordered from root to parent", () => {
+      expect(getAncestorIds(nodes, "a1x")).toEqual(["root", "a", "a1"]);
+    });
+
+    it("returns an empty list for a root node", () => {
+      expect(getAncestorIds(nodes, "root")).toEqual([]);
+    });
+  });
+
+  describe("buildBreadcrumbPath", () => {
+    it("returns the path from the root to the current node", () => {
+      // Act
+      const path = buildBreadcrumbPath(nodes, "a1");
+
+      // Assert
+      expect(path.map(n => n.id)).toEqual(["root", "a", "a1"]);
+    });
+
+    it("updates the breadcrumb when switching levels", () => {
+      // Act
+      const first = buildBreadcrumbPath(nodes, "a");
+      const second = buildBreadcrumbPath(nodes, "a1x");
+
