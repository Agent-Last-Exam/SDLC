+import { ConditionalFilterContext } from "@dashboard/components/ConditionalFilter/context";
+import { Condition } from "@dashboard/components/ConditionalFilter/FilterElement/Condition";
+import { ConditionOptions } from "@dashboard/components/ConditionalFilter/FilterElement/ConditionOptions";
+import { ConditionSelected } from "@dashboard/components/ConditionalFilter/FilterElement/ConditionSelected";
+import { FilterElement } from "@dashboard/components/ConditionalFilter/FilterElement";
+import { ExpressionValue } from "@dashboard/components/ConditionalFilter/FilterElement/FilterElement";
+import { render, screen } from "@testing-library/react";
+import { ReactNode } from "react";
+
+import { LockedFiltersChips } from "./LockedFiltersChips";
+
+const makeStaticElement = (slug: string, value: string) =>
+  new FilterElement(
+    new ExpressionValue(slug, slug, "s"),
+    new Condition(
+      ConditionOptions.empty(),
+      new ConditionSelected(value, { type: "text", label: "is", value: "is" }, [], false),
+      false,
+    ),
+    false,
+  );
+
+const renderWithContext = (lockedValue: FilterElement[] | undefined, children: ReactNode) =>
+  render(
+    <ConditionalFilterContext.Provider
+      value={
+        {
+          valueProvider: { lockedValue },
+        } as any
+      }
+    >
+      {children}
+    </ConditionalFilterContext.Provider>,
+  );
+
+describe("AppLayout / ListFilters / LockedFiltersChips", () => {
+  it("renders a read-only chip per locked condition with no remove entry", () => {
+    // Arrange & Act
+    renderWithContext([makeStaticElement("channel", "pln")], <LockedFiltersChips />);
+
+    // Assert
+    const chips = screen.getAllByTestId("locked-filter-chip");
+
+    expect(chips).toHaveLength(1);
+    expect(chips[0]).toHaveTextContent("channel: pln");
+    // No delete/remove entry is rendered for locked conditions (AC-14-2)
+    expect(chips[0].querySelector("button")).toBeNull();
+    expect(screen.queryByRole("button")).toBeNull();
+  });
+
+  it("renders nothing when there are no locked conditions", () => {
+    // Arrange & Act
+    renderWithContext([], <LockedFiltersChips />);
+
+    // Assert
+    expect(screen.queryByTestId("locked-filters")).toBeNull();
+  });
+});
diff --git a/src/components/AppLayout/ListFilters/components/LockedFiltersChips.tsx b/src/components/AppLayout/ListFilters/components/LockedFiltersChips.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a80d131b4e98a438ee42e5f0c297d86da6e44cb6
--- /dev/null
+++ b/src/components/AppLayout/ListFilters/components/LockedFiltersChips.tsx
@@ -0,0 +1,66 @@
+import { ConditionalFilterContext } from "@dashboard/components/ConditionalFilter/context";
+import { FilterElement } from "@dashboard/components/ConditionalFilter/FilterElement";
+import { getFilterElements } from "@dashboard/components/ConditionalFilter/lockedFilters";
+import { Box, Text } from "@saleor/macaw-ui-next";
+import { useContext } from "react";
+
+const describeSelectedValue = (element: FilterElement): string => {
+  const value = element.condition?.selected?.value;
+
+  if (Array.isArray(value)) {
+    return value
+      .map(entry => (entry && typeof entry === "object" ? entry.label : String(entry)))
+      .join(", ");
+  }
+
+  if (value && typeof value === "object") {
+    return value.label ?? "";
+  }
+
+  return value == null ? "" : String(value);
+};
+
+/**
+ * Renders conditions injected by the entry point (e.g. a channel assignment
+ * action) as read-only chips. They are intentionally non-removable: there is no
+ * delete entry, and the underlying `lockedValue` is never mutated by regular
+ * filter edits (see `useUrlValueProvider` / `useFilterHandlers`).
+ */
+export const LockedFiltersChips = () => {
+  const context = useContext(ConditionalFilterContext);
+  const lockedValue = context?.valueProvider.lockedValue ?? [];
+  const elements = getFilterElements(lockedValue);
+
+  if (elements.length === 0) {
+    return null;
+  }
+
+  return (
+    <Box
+      display="flex"
+      gap={2}
+      flexWrap="wrap"
+      paddingX={6}
+      paddingBottom={2}
+      data-test-id="locked-filters"
+    >
+      {elements.map((element, index) => (
+        <Box
+          key={`${element.value.value}-${index}`}
+          display="flex"
+          alignItems="center"
+          gap={1}
+          paddingX={2}
+          paddingY={1}
+          borderRadius={2}
+          backgroundColor="default1"
+          data-test-id="locked-filter-chip"
+        >
+          <Text size={2} color="default2">
+            {`${element.value.label}: ${describeSelectedValue(element)}`}
+          </Text>
+        </Box>
+      ))}
+    </Box>
+  );
+};
