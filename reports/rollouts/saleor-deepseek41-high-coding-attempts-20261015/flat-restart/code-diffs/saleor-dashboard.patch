+import { getDateGroupKey, groupByDate } from "./dateGrouping";
+
+interface Order {
+  id: string;
+  created: string;
+}
+
+describe("orders/utils/dateGrouping", () => {
+  describe("getDateGroupKey", () => {
+    it("uses the local calendar day for the given timezone", () => {
+      // Arrange
+      const justAfterUtcMidnight = "2026-10-15T02:00:00Z";
+
+      // Act / Assert - New York is still on the previous day, UTC is not
+      expect(getDateGroupKey(justAfterUtcMidnight, "America/New_York")).toBe("2026-10-14");
+      expect(getDateGroupKey(justAfterUtcMidnight, "UTC")).toBe("2026-10-15");
+    });
+  });
+
+  describe("groupByDate", () => {
+    it("groups orders by their local day without reordering them", () => {
+      // Arrange
+      const orders: Order[] = [
+        { id: "a", created: "2026-10-15T12:00:00Z" },
+        { id: "b", created: "2026-10-15T08:00:00Z" },
+        { id: "c", created: "2026-10-14T12:00:00Z" },
+      ];
+
+      // Act
+      const groups = groupByDate(orders, order => order.created, {
+        locale: "en",
+        timezone: "UTC",
+      });
+
+      // Assert
+      expect(groups.map(group => group.key)).toEqual(["2026-10-15", "2026-10-14"]);
+      expect(groups[0].items.map(item => item.id)).toEqual(["a", "b"]);
+      expect(groups[1].items.map(item => item.id)).toEqual(["c"]);
+    });
+
+    it("does not mis-group orders that straddle a timezone day boundary", () => {
+      // Arrange - both are 2026-10-15 in UTC, but split in New York
+      const orders: Order[] = [
+        { id: "late", created: "2026-10-15T02:00:00Z" },
+        { id: "noon", created: "2026-10-15T12:00:00Z" },
+      ];
+
+      // Act
+      const groups = groupByDate(orders, order => order.created, {
+        locale: "en",
+        timezone: "America/New_York",
+      });
+
+      // Assert
+      expect(groups.map(group => group.key)).toEqual(["2026-10-14", "2026-10-15"]);
+      expect(groups[0].items.map(item => item.id)).toEqual(["late"]);
+      expect(groups[1].items.map(item => item.id)).toEqual(["noon"]);
+    });
+
+    it("produces a localized label for each group", () => {
+      // Act
+      const groups = groupByDate(
+        [{ id: "a", created: "2026-10-15T12:00:00Z" }],
+        order => order.created,
+        { locale: "en", timezone: "UTC" },
+      );
+
+      // Assert
+      expect(groups[0].label).toBe("October 15, 2026");
+    });
+  });
+});
diff --git a/src/orders/utils/dateGrouping.ts b/src/orders/utils/dateGrouping.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1937d58e4597f6e26daf84eff0de791a3435da6b
--- /dev/null
+++ b/src/orders/utils/dateGrouping.ts
@@ -0,0 +1,73 @@
+import moment from "moment-timezone";
+
+/**
+ * Client-side order date grouping (R30 / AC-30-3).
+ *
+ * The dashboard renders dates by locale only; this helper additionally applies
+ * the configured timezone so orders are grouped by their *local* calendar day.
+ * Grouping is a pure display concern: it does not reorder items (input order is
+ * authoritative) and therefore does not affect list sorting or pagination.
+ */
+
+export type DateLike = string | number | Date;
+
+export interface DateGroupingOptions {
+  locale: string;
+  /** IANA timezone name, e.g. "America/New_York". Falls back to the local zone. */
+  timezone?: string;
+}
+
+export interface DateGroup<T> {
+  /** Stable key for the group: the local calendar day as `YYYY-MM-DD`. */
+  key: string;
+  /** Localized, human-readable label for the group. */
+  label: string;
+  items: T[];
+}
+
+const toMoment = (date: DateLike, timezone?: string) => {
+  const value = moment(date);
+
+  return timezone ? value.tz(timezone) : value;
+};
+
+/** Local calendar-day key (`YYYY-MM-DD`) for `date` in the given timezone. */
+export function getDateGroupKey(date: DateLike, timezone?: string): string {
+  return toMoment(date, timezone).format("YYYY-MM-DD");
+}
+
+/** Localized label (e.g. "October 15, 2026") for the group `date` falls into. */
+export function getDateGroupLabel(date: DateLike, options: DateGroupingOptions): string {
+  return toMoment(date, options.timezone).locale(options.locale).format("LL");
+}
+
+/**
+ * Groups `items` by the local calendar day of the date returned by `getDate`.
+ * Group order follows first appearance and item order within a group follows
+ * input order, so sorting/pagination are left untouched. Two timestamps on
+ * opposite sides of a timezone day boundary land in different groups.
+ */
+export function groupByDate<T>(
+  items: T[],
+  getDate: (item: T) => DateLike,
+  options: DateGroupingOptions,
+): DateGroup<T>[] {
+  const groups: DateGroup<T>[] = [];
+  const byKey = new Map<string, DateGroup<T>>();
+
+  for (const item of items) {
+    const date = getDate(item);
+    const key = getDateGroupKey(date, options.timezone);
+    let group = byKey.get(key);
+
+    if (!group) {
+      group = { key, label: getDateGroupLabel(date, options), items: [] };
+      byKey.set(key, group);
+      groups.push(group);
+    }
+
+    group.items.push(item);
+  }
+
+  return groups;
+}
diff --git a/src/orders/utils/draftActions.test.ts b/src/orders/utils/draftActions.test.ts
