--- /dev/null
+++ b/src/utils/weight.ts
@@ -0,0 +1,81 @@
+/**
+ * Weight unit conversion helpers (R30 / AC-30-1).
+ *
+ * Saleor returns weights as `{ unit, value }` where `unit` is one of
+ * `WeightUnitsEnum` (`G`, `KG`, `TONNE`, `LB`, `OZ`) and `value` is the amount
+ * expressed in that unit. Different objects (products, shipping methods) may
+ * come back in different units, so displaying raw `value unit` pairs side by
+ * side mixes units. These helpers convert a weight to a single target unit
+ * before display, so values are shown in a consistent, actual unit.
+ *
+ * The conversion factors below are the standard definitions of each unit
+ * (relative to the gram); they are not tunable thresholds.
+ */
+
+export type WeightUnit = "G" | "KG" | "TONNE" | "LB" | "OZ";
+
+export interface WeightValue {
+  unit: string;
+  value: number;
+}
+
+/** Number of grams in one unit of the given weight unit. */
+export const GRAMS_PER_WEIGHT_UNIT: Record<WeightUnit, number> = {
+  G: 1,
+  KG: 1_000,
+  TONNE: 1_000_000,
+  LB: 453.59237,
+  OZ: 28.349523125,
+};
+
+const isKnownUnit = (unit: string): unit is WeightUnit =>
+  Object.prototype.hasOwnProperty.call(GRAMS_PER_WEIGHT_UNIT, unit);
+
+/** Rounds to 6 significant digits to remove floating point noise. */
+const round = (value: number): number => Number(value.toPrecision(6));
+
+/**
+ * Converts `weight` to `targetUnit`.
+ *
+ * When the target is missing, equal to the source unit, or either unit is not a
+ * known weight unit, the weight is returned unchanged — a value is never altered
+ * merely by being displayed in its own unit, so there is no unit-mixing drift.
+ */
+export function convertWeight(weight: WeightValue, targetUnit?: string | null): WeightValue {
+  if (!targetUnit || targetUnit === weight.unit) {
+    return weight;
+  }
+
+  if (!isKnownUnit(weight.unit) || !isKnownUnit(targetUnit)) {
+    return weight;
+  }
+
+  const grams = weight.value * GRAMS_PER_WEIGHT_UNIT[weight.unit];
+
+  return { unit: targetUnit, value: round(grams / GRAMS_PER_WEIGHT_UNIT[targetUnit]) };
+}
+
+/**
+ * Converts both ends of a weight range to a single unit (the `from` unit when
+ * present, otherwise the `to` unit) so a range is never rendered with mixed
+ * units.
+ */
+export function normalizeWeightRange(
+  from?: WeightValue | null,
+  to?: WeightValue | null,
+): { from?: WeightValue; to?: WeightValue; unit?: string } {
+  const unit = from?.unit ?? to?.unit;
+
+  return {
+    from: from ? convertWeight(from, unit) : undefined,
+    to: to ? convertWeight(to, unit) : undefined,
+    unit,
+  };
+}
+
+/** Formats a weight as `"<value> <unit>"`, optionally converted to `targetUnit`. */
+export function formatWeight(weight: WeightValue, targetUnit?: string | null): string {
+  const converted = convertWeight(weight, targetUnit);
+
+  return `${round(converted.value)} ${converted.unit}`;
+}
