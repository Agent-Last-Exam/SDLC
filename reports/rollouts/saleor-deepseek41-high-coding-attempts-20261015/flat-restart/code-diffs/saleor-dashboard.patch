new file mode 100644
index 0000000000000000000000000000000000000000..46792800bc913f4f2abfb1a5992d27ec7a05fd1e
--- /dev/null
+++ b/src/utils/collections.ts
@@ -0,0 +1,55 @@
+/**
+ * Selection helpers shared by the assign dialogs and warehouse/category pickers.
+ *
+ * All selection sets are keyed by the object id so that toggling an item off and
+ * on again never produces duplicate entries, and de-selecting removes the value
+ * completely (no ghost entries left in the selection or the query conditions).
+ */
+
+interface Identifiable {
+  id: string;
+}
+
+/** Merges two collections by id, keeping the first occurrence of each id. */
+export function dedupeById<T extends Identifiable>(items: T[]): T[] {
+  const seen = new Set<string>();
+  const result: T[] = [];
+
+  for (const item of items) {
+    if (!item || seen.has(item.id)) {
+      continue;
+    }
+
+    seen.add(item.id);
+    result.push(item);
+  }
+
+  return result;
+}
+
+/** Returns true when the collection already contains an item with the given id. */
+export function isSelectedById<T extends Identifiable>(items: T[], id: string): boolean {
+  return items.some(item => item.id === id);
+}
+
+/**
+ * Toggles an item in a selection set by id:
+ * - when present, it is removed (de-selection leaves no residue);
+ * - when absent, it is appended once (never duplicated).
+ */
+export function toggleSelectionById<T extends Identifiable>(items: T[], item: T): T[] {
+  if (isSelectedById(items, item.id)) {
+    return items.filter(selected => selected.id !== item.id);
+  }
+
+  return [...items, item];
+}
+
+/** Removes an item by id, returning the same reference when nothing changed. */
+export function removeSelectionById<T extends Identifiable>(items: T[], id: string): T[] {
+  if (!isSelectedById(items, id)) {
+    return items;
+  }
+
+  return items.filter(item => item.id !== id);
+}
