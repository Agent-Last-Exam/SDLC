+import { WarehouseFragment } from "@dashboard/graphql";
+import Wrapper from "@test/wrapper";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+
+import { ProductStocksAssignWarehouses } from "./ProductStocksAssignWarehouses";
+
+const warehouses = [
+  { id: "w1", name: "Warehouse one" },
+  { id: "w2", name: "Warehouse two" },
+] as unknown as WarehouseFragment[];
+
+const defaultProps = {
+  warehousesToAssign: warehouses,
+  hasMoreWarehouses: false,
+  loadMoreWarehouses: jest.fn(),
+  loading: false,
+  searchWarehouses: jest.fn(),
+  showAssignWarehousesButton: true,
+};
+
+const renderComponent = (onWarehouseSelect = jest.fn()) => {
+  render(
+    <Wrapper>
+      <ProductStocksAssignWarehouses {...defaultProps} onWarehouseSelect={onWarehouseSelect} />
+    </Wrapper>,
+  );
+
+  // open the dialog
+  fireEvent.click(screen.getByTestId("assign-warehouse-button"));
+
+  return { onWarehouseSelect };
+};
+
+const checkboxes = () => screen.getAllByRole("checkbox") as HTMLInputElement[];
+
+describe("ProductStocksAssignWarehouses", () => {
+  it("does not duplicate a warehouse when it is selected, unselected and selected again", () => {
+    // Arrange
+    const { onWarehouseSelect } = renderComponent();
+
+    // Act
+    fireEvent.click(checkboxes()[0]); // select w1
+    fireEvent.click(checkboxes()[0]); // unselect w1
+    fireEvent.click(checkboxes()[0]); // select w1 again
+    fireEvent.click(screen.getByText("Confirm"));
+
+    // Assert
+    expect(onWarehouseSelect).toHaveBeenCalledTimes(1);
+    expect(onWarehouseSelect).toHaveBeenCalledWith("w1", "Warehouse one");
+  });
+
+  it("removes a de-selected warehouse so it does not linger in the selection", () => {
+    // Arrange
+    const { onWarehouseSelect } = renderComponent();
+
+    // Act
+    fireEvent.click(checkboxes()[0]); // select w1
+    fireEvent.click(checkboxes()[1]); // select w2
+    fireEvent.click(checkboxes()[0]); // unselect w1
+    fireEvent.click(screen.getByText("Confirm"));
+
+    // Assert
+    expect(onWarehouseSelect).toHaveBeenCalledTimes(1);
+    expect(onWarehouseSelect).toHaveBeenCalledWith("w2", "Warehouse two");
+  });
+
+  it("reflects the checked state of a selected warehouse", () => {
+    // Act
+    renderComponent();
+
+    // Assert
+    expect(checkboxes()[0].checked).toBe(false);
+    fireEvent.click(checkboxes()[0]);
+    expect(checkboxes()[0].checked).toBe(true);
+  });
+
+  it("keeps the pending selection when the dialog is closed without confirming", () => {
+    // Arrange
+    renderComponent();
+    fireEvent.click(checkboxes()[0]);
+    expect(checkboxes()[0].checked).toBe(true);
+
+    // Act - close (back button) then reopen
+    fireEvent.click(screen.getByTestId("assign-warehouse-button"));
+
+    // Assert - still selected
+    expect((screen.getAllByRole("checkbox") as HTMLInputElement[])[0].checked).toBe(true);
+  });
+
+  it("truncates long names but keeps the full value in the title attribute", () => {
+    // Arrange
+    const longName = "A very long warehouse name that overflows the dialog width";
+    render(
+      <Wrapper>
+        <ProductStocksAssignWarehouses
+          {...defaultProps}
+          warehousesToAssign={[{ id: "w3", name: longName }] as unknown as WarehouseFragment[]}
+          onWarehouseSelect={jest.fn()}
+        />
+      </Wrapper>,
+    );
+    fireEvent.click(screen.getByTestId("assign-warehouse-button"));
+
+    // Act
+    const cell = screen.getByText(longName);
+
+    // Assert
+    expect(cell).toHaveAttribute("title", longName);
+    expect(cell).toHaveStyle({ textOverflow: "ellipsis" });
+  });
+});
+
+afterEach(cleanup);
