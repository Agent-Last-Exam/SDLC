+import {
+  dedupeById,
+  isSelectedById,
+  removeSelectionById,
+  toggleSelectionById,
+} from "./collections";
+
+describe("utils/collections", () => {
+  const a = { id: "a", name: "A" };
+  const b = { id: "b", name: "B" };
+
+  describe("dedupeById", () => {
+    it("merges items with the same id keeping the first occurrence", () => {
+      // Act
+      const result = dedupeById([a, b, { id: "a", name: "A duplicate" }]);
+
+      // Assert
+      expect(result).toHaveLength(2);
+      expect(result[0].name).toBe("A");
+    });
+
+    it("ignores nullish entries", () => {
+      expect(dedupeById([a, undefined as any, a])).toHaveLength(1);
+    });
+  });
+
+  describe("toggleSelectionById", () => {
+    it("adds an item once and removes it on the next toggle (no duplicates)", () => {
+      // Act
+      const selected = toggleSelectionById([], a);
+      const removed = toggleSelectionById(selected, a);
+      const reAdded = toggleSelectionById(removed, a);
+
+      // Assert
+      expect(selected).toHaveLength(1);
+      expect(removed).toHaveLength(0); // toggling again de-selects
+      expect(reAdded).toHaveLength(1); // re-selecting adds a single entry, never a duplicate
+    });
+
+    it("keeps other selected items when toggling one off", () => {
+      // Act
+      const removed = toggleSelectionById([a, b], a);
+
+      // Assert
+      expect(removed.map(item => item.id)).toEqual(["b"]);
+    });
+  });
+
+  describe("removeSelectionById", () => {
+    it("removes the value so it does not linger in the selection", () => {
+      // Act
+      const result = removeSelectionById([a, b], "a");
+
+      // Assert
+      expect(result.map(item => item.id)).toEqual(["b"]);
+      expect(isSelectedById(result, "a")).toBe(false);
+    });
+
+    it("returns the same reference when nothing matches", () => {
+      const items = [a];
+      expect(removeSelectionById(items, "z")).toBe(items);
+    });
+  });
+});
