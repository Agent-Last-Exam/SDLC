diff --git a/src/components/AssignCategoryDialog/CategoryHierarchyBreadcrumb.tsx b/src/components/AssignCategoryDialog/CategoryHierarchyBreadcrumb.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..ad235a1d879a99c004874dc736e8e052c8221a5e
--- /dev/null
+++ b/src/components/AssignCategoryDialog/CategoryHierarchyBreadcrumb.tsx
@@ -0,0 +1,72 @@
+import { Box, Text } from "@saleor/macaw-ui-next";
+import { CSSProperties } from "react";
+import { useIntl } from "react-intl";
+
+import { CategoryHierarchyNode } from "./categoryHierarchy";
+import { messages } from "./messages";
+
+export interface CategoryHierarchyBreadcrumbProps<T extends CategoryHierarchyNode> {
+  /** Ancestor chain below the root, ordered root-adjacent → current node. Empty means we are at the root level. */
+  path: T[];
+  onNavigate: (id: string | null) => void;
+}
+
+const buttonStyle: CSSProperties = {
+  background: "none",
+  border: "none",
+  cursor: "pointer",
+  padding: 0,
+  font: "inherit",
+};
+
+/**
+ * Breadcrumb for the hierarchical category picker. Clicking an entry navigates
+ * to that level; the root entry returns to the top level.
+ */
+function CategoryHierarchyBreadcrumb<T extends CategoryHierarchyNode>({
+  path,
+  onNavigate,
+}: CategoryHierarchyBreadcrumbProps<T>) {
+  const intl = useIntl();
+
+  return (
+    <Box
+      display="flex"
+      alignItems="center"
+      flexWrap="wrap"
+      gap={1}
+      data-test-id="category-hierarchy-breadcrumb"
+    >
+      <Text size={2} color="default2">
+        <button
+          type="button"
+          onClick={() => onNavigate(null)}
+          data-test-id="breadcrumb-root"
+          style={buttonStyle}
+        >
+          {intl.formatMessage(messages.breadcrumbRoot)}
+        </button>
+      </Text>
+      {path.map(node => (
+        <Box key={node.id} display="flex" alignItems="center" gap={1}>
+          <Text size={2} color="default2">
+            /
+          </Text>
+          <Text size={2} color="default2">
+            <button
+              type="button"
+              onClick={() => onNavigate(node.id)}
+              data-test-id={`breadcrumb-${node.id}`}
+              style={buttonStyle}
+            >
+              {node.name}
+            </button>
+          </Text>
+        </Box>
+      ))}
+    </Box>
+  );
+}
+
+CategoryHierarchyBreadcrumb.displayName = "CategoryHierarchyBreadcrumb";
+export default CategoryHierarchyBreadcrumb;
