diff --git a/src/products/components/ProductChannelDiagnostics/utils.ts b/src/products/components/ProductChannelDiagnostics/utils.ts
new file mode 100644
index 0000000000000000000000000000000000000000..068bf1dcc27caae47d65f796e227c6f1bd9ab966
--- /dev/null
+++ b/src/products/components/ProductChannelDiagnostics/utils.ts
@@ -0,0 +1,162 @@
+import { ProductChannelAvailabilityProblemSeverityEnum } from "@dashboard/graphql";
+
+import {
+  DiagnosticsChannel,
+  DiagnosticsEdge,
+  DiagnosticsProblem,
+  DiagnosticsViewState,
+} from "./types";
+
+/**
+ * Order in which severity groups are rendered. Blockers first so real problems
+ * are not drowned out by warnings or skipped checks.
+ */
+export const SEVERITY_GROUP_ORDER = [
+  ProductChannelAvailabilityProblemSeverityEnum.BLOCKER,
+  ProductChannelAvailabilityProblemSeverityEnum.WARNING,
+  ProductChannelAvailabilityProblemSeverityEnum.NOT_APPLICABLE,
+] as const;
+
+export interface GroupedProblems {
+  blocker: DiagnosticsProblem[];
+  warning: DiagnosticsProblem[];
+  notApplicable: DiagnosticsProblem[];
+}
+
+/**
+ * Groups the flat list of problems reported for a channel into the three
+ * severities. Counts derived from the returned arrays are always consistent with
+ * the number of rendered entries ("问题数量 == 明细条目数").
+ */
+export function groupProblemsBySeverity(problems: DiagnosticsProblem[] = []): GroupedProblems {
+  return problems.reduce<GroupedProblems>(
+    (acc, problem) => {
+      switch (problem.severity) {
+        case ProductChannelAvailabilityProblemSeverityEnum.BLOCKER:
+          acc.blocker.push(problem);
+          break;
+        case ProductChannelAvailabilityProblemSeverityEnum.WARNING:
+          acc.warning.push(problem);
+          break;
+        case ProductChannelAvailabilityProblemSeverityEnum.NOT_APPLICABLE:
+          acc.notApplicable.push(problem);
+          break;
+        default:
+          break;
+      }
+
+      return acc;
+    },
+    { blocker: [], warning: [], notApplicable: [] },
+  );
+}
+
+export function countGroupedProblems(grouped: GroupedProblems) {
+  return {
+    blocker: grouped.blocker.length,
+    warning: grouped.warning.length,
+    notApplicable: grouped.notApplicable.length,
+    total: grouped.blocker.length + grouped.warning.length + grouped.notApplicable.length,
+  };
+}
+
+export function mapEdgesToChannels(edges: DiagnosticsEdge[] = []): DiagnosticsChannel[] {
+  return edges.map(edge => ({
+    channel: {
+      id: edge.channel.id,
+      name: edge.channel.name,
+      slug: edge.channel.slug,
+      currencyCode: edge.channel.currencyCode,
+    },
+    diagnostics: edge.node
+      ? {
+          problemsCount: edge.node.problemsCount,
+          warningsCount: edge.node.warningsCount,
+          notApplicableCount: edge.node.notApplicableCount,
+          problems: edge.node.problems,
+        }
+      : null,
+  }));
+}
+
+/**
+ * A result is stale when it does not belong to the currently active request.
+ * Late results of superseded requests must never overwrite the latest state nor
+ * be treated as the latest conclusion.
+ */
+export function isStaleResult(resultRequestId: number, currentRequestId: number): boolean {
+  return resultRequestId !== currentRequestId;
+}
+
+export interface ComputeDiagnosticsStateArgs {
+  hasPermission: boolean;
+  /** requestId the currently available data/error belongs to */
+  requestId: number;
+  /** requestId of the latest issued request */
+  currentRequestId: number;
+  loading: boolean;
+  error: boolean;
+  edges?: DiagnosticsEdge[] | null;
+  totalCount?: number | null;
+  previous: DiagnosticsViewState;
+}
+
+/**
+ * Pure state machine for the diagnostics panel. Encodes the required statuses:
+ * - loading (never clears the previously loaded list)
+ * - ready
+ * - loaded-empty (positive "no problems" empty state)
+ * - permission-denied
+ * - error-retryable (explicit retry, never rendered as an empty result)
+ * Stale (superseded) results are discarded and never committed.
+ */
+export function computeDiagnosticsState({
+  hasPermission,
+  requestId,
+  currentRequestId,
+  loading,
+  error,
+  edges,
+  totalCount,
+  previous,
+}: ComputeDiagnosticsStateArgs): DiagnosticsViewState {
+  if (!hasPermission) {
+    return { status: "permission-denied", channels: [], totalCount: 0 };
+  }
+
+  // A late result of a superseded request must not overwrite the latest state.
+  if (isStaleResult(requestId, currentRequestId)) {
+    return previous;
+  }
+
+  if (error) {
+    // A failed query is never shown as an empty result: keep previous data and
+    // expose a retryable error status.
+    return {
+      status: "error-retryable",
+      channels: previous.channels,
+      totalCount: previous.totalCount,
+    };
+  }
+
+  if (edges) {
+    const channels = mapEdgesToChannels(edges);
+
+    return {
+      status: channels.length === 0 ? "loaded-empty" : "ready",
+      channels,
+      totalCount: totalCount ?? channels.length,
+    };
+  }
+
+  if (loading) {
+    // Loading must not clear the previously loaded list.
+    return {
+      status: previous.channels.length > 0 ? previous.status : "loading",
+      channels: previous.channels,
+      totalCount: previous.totalCount,
+    };
+  }
+
+  return previous;
+}
