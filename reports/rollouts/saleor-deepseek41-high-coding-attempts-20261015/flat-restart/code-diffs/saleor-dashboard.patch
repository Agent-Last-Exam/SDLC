+import { renderHook } from "@testing-library/react-hooks";
+
+import { FilterElement } from "../FilterElement";
+
+const mockReplace = jest.fn();
+
+jest.mock("use-react-router", () => () => ({
+  history: { replace: mockReplace },
+  location: { pathname: "/products" },
+}));
+
+// eslint-disable-next-line import/first
+import { useUrlValueProvider } from "./useUrlValueProvider";
+
+const getValues = (container: ReturnType<typeof useUrlValueProvider>["value"]) =>
+  Array.from(container)
+    .filter(FilterElement.isCompatible)
+    .map(el => el.value.value);
+
+describe("ConditionalFilter / ValueProvider / useUrlValueProvider (locked conditions)", () => {
+  beforeEach(() => {
+    mockReplace.mockClear();
+  });
+
+  it("splits locked and regular tokens from the URL (AC-14-1)", () => {
+    // Arrange & Act
+    const { result } = renderHook(() =>
+      useUrlValueProvider("?locked[0][s0.channel]=pln&0[s0.productType]=beer", "product"),
+    );
+
+    // Assert
+    expect(getValues(result.current.lockedValue ?? [])).toEqual(["channel"]);
+    expect(getValues(result.current.value)).toEqual(["productType"]);
+  });
+
+  it("merges locked first and regular after, locked wins on the same dimension (AC-14-2)", () => {
+    // Arrange & Act
+    const { result } = renderHook(() =>
+      useUrlValueProvider("?locked[0][s0.channel]=pln&0[s0.channel]=usd", "product"),
+    );
+
+    // Assert
+    const effective = Array.from(result.current.effectiveValue ?? []);
+    const elements = effective.filter(FilterElement.isCompatible) as FilterElement[];
+
+    expect(elements).toHaveLength(1);
+    expect(elements[0].value.value).toBe("channel");
+    // Locked channel wins over the regular channel condition.
+    expect(result.current.getTokenByName("channel")?.value).toBe("pln");
+  });
+
+  it("exposes the locked token through getTokenByName (channel detection)", () => {
+    // Arrange & Act
+    const { result } = renderHook(() =>
+      useUrlValueProvider("?locked[0][s0.channel]=pln", "product"),
+    );
+
+    // Assert
+    expect(result.current.getTokenByName("channel")?.value).toBe("pln");
+  });
+
+  it("keeps locked conditions when persisting regular ones (AC-14-3)", () => {
+    // Arrange
+    const { result } = renderHook(() =>
+      useUrlValueProvider("?locked[0][s0.channel]=pln&0[s0.productType]=beer", "product"),
+    );
+
+    // Act
+    result.current.persist(result.current.value);
+
+    // Assert
+    const search = mockReplace.mock.calls[0][0].search as string;
+
+    expect(search).toContain("locked");
+    expect(decodeURIComponent(search)).toContain("locked[0][s0.channel]=pln");
+  });
+
+  it("keeps locked conditions when clearing all regular conditions (AC-14-1)", () => {
+    // Arrange
+    const { result } = renderHook(() =>
+      useUrlValueProvider("?locked[0][s0.channel]=pln&0[s0.productType]=beer", "product"),
+    );
+
+    // Act
+    result.current.clear();
+
+    // Assert
+    const search = mockReplace.mock.calls[0][0].search as string;
+
+    expect(decodeURIComponent(search)).toContain("locked[0][s0.channel]=pln");
+    expect(decodeURIComponent(search)).not.toContain("productType");
+  });
+
+  it("does not emit a search string when there is nothing to clear or lock", () => {
+    // Arrange
+    const { result } = renderHook(() => useUrlValueProvider("?0[s0.productType]=beer", "product"));
+
+    // Act
+    result.current.clear();
+
+    // Assert
+    expect(mockReplace).toHaveBeenCalledWith({ pathname: "/products" });
+  });
+});
