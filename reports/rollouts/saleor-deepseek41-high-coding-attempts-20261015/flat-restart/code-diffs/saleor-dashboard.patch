@@ -0,0 +1,224 @@
+import { AllFormPayloadUpdatePayloads, FormPayloadUpdate } from "@saleor/app-sdk/app-bridge";
+
+/**
+ * R20 / FD05 - extension form response contract (pure client contract, no Core changes).
+ *
+ * A popup extension can push form content back to the Dashboard with the
+ * `formPayloadUpdate` action from the app-sdk. This module defines how the
+ * Dashboard interprets that response and applies it to the form that is
+ * currently being edited.
+ *
+ * Five response inputs are recognised:
+ *  - default values: optional fields omitted from `fields` keep their current value;
+ *  - success: the provided fields are applied to the editing context;
+ *  - field level validation failure: reported through `errors`/`status`, the form is
+ *    *not* saved as successful;
+ *  - permission error: `status: "permissionError"`, the form is *not* saved as successful;
+ *  - app closed: ignored by the caller before this function runs (see `appClosed`).
+ */
+
+export type FormPayloadFieldResult = { value: string };
+
+export type ExtensionFormName = AllFormPayloadUpdatePayloads["form"];
+
+/**
+ * Payload understood by the Dashboard. It is a superset of the app-sdk
+ * `AllFormPayloadUpdatePayloads`: apps using the SDK shape (only `fields` and
+ * `closePopup`) get the "success"/"default values" behaviour, while the optional
+ * `status`/`errors` let an app signal a field level validation or permission failure.
+ */
+export type FormPayloadUpdatePayload = AllFormPayloadUpdatePayloads & {
+  /** Correlation id the app attaches to every action (SDK `ActionWithId`). */
+  actionId: string;
+  status?: "success" | "validationError" | "permissionError";
+  errors?: Array<{ field: string; message?: string }>;
+};
+
+export type FormPayloadAction = Omit<FormPayloadUpdate, "payload"> & {
+  payload: FormPayloadUpdatePayload;
+};
+
+export type FormFieldErrors = Record<string, string | undefined>;
+
+/**
+ * The form currently open in the Dashboard that a payload update can target.
+ */
+export interface FormEditingContext {
+  /** which form is open, e.g. "product-edit" or "product-translate" */
+  form: ExtensionFormName | string;
+  /** id of the app whose popup is currently open */
+  appId: string;
+  /** current values of the form */
+  values: Record<string, string>;
+  /** fields the user is editing right now - must never be overwritten */
+  dirtyFields: string[];
+  /** optional per-field validation used to detect field level failures */
+  validateField?: (
+    field: string,
+    value: string,
+    values: Record<string, string>,
+  ) => string | undefined;
+}
+
+export type FormPayloadIgnoredReason =
+  | "unknownAction"
+  | "duplicateResponse"
+  | "appClosed"
+  | "frameNotLoaded"
+  | "multiFrame"
+  | "noEditingContext"
+  | "foreignContext"
+  | "emptyPayload";
+
+export type FormPayloadOutcome =
+  | {
+      status: "success";
+      values: Record<string, string>;
+      appliedFields: string[];
+      closePopup: boolean;
+    }
+  | {
+      status: "validationError";
+      values: Record<string, string>;
+      fieldErrors: FormFieldErrors;
+    }
+  | {
+      status: "permissionError";
+      values: Record<string, string>;
+    }
+  | {
+      status: "ignored";
+      reason: FormPayloadIgnoredReason;
+    };
+
+export interface ApplyFormPayloadUpdateInput {
+  action: Pick<FormPayloadAction, "type" | "payload"> | undefined | null;
+  /** app that produced the response (contextual, not part of the SDK payload) */
+  appId: string;
+  /** the form currently being edited, or null when no form is open */
+  context: FormEditingContext | null;
+  /** action ids already processed - used to reject duplicates */
+  processedActionIds: readonly string[];
+  /** apps with a mounted / loaded frame */
+  loadedFrameAppIds: readonly string[];
+  /** apps that are currently active (not deactivated) */
+  activeAppIds: readonly string[];
+}
+
+const ignore = (reason: FormPayloadIgnoredReason): FormPayloadOutcome => ({
+  status: "ignored",
+  reason,
+});
+
+export const applyFormPayloadUpdate = (
+  input: ApplyFormPayloadUpdateInput,
+): FormPayloadOutcome => {
+  const { action, appId, context, processedActionIds, loadedFrameAppIds, activeAppIds } = input;
+
+  // Unknown / malformed action must never touch the editing state.
+  if (!action || action.type !== "formPayloadUpdate" || !action.payload?.actionId) {
+    return ignore("unknownAction");
+  }
+
+  const { actionId } = action.payload;
+
+  // A repeated response for an already handled action id is rejected.
+  if (processedActionIds.includes(actionId)) {
+    return ignore("duplicateResponse");
+  }
+
+  // Responses from a frame that has not finished loading are ignored.
+  if (!loadedFrameAppIds.includes(appId)) {
+    return ignore("frameNotLoaded");
+  }
+
+  // Responses from a closed (deactivated) app are ignored.
+  if (!activeAppIds.includes(appId)) {
+    return ignore("appClosed");
+  }
+
+  // More than one loaded frame makes the target ambiguous - reject to avoid
+  // polluting an unrelated form.
+  if (loadedFrameAppIds.length > 1) {
+    return ignore("multiFrame");
+  }
+
+  // Without an open form there is nothing to update.
+  if (!context) {
+    return ignore("noEditingContext");
+  }
+
+  // Only the form that belongs to the responding app can receive the response.
+  if (context.appId !== appId) {
+    return ignore("foreignContext");
+  }
+
+  // The response must target the form that is currently open.
+  if (context.form !== action.payload.form) {
+    return ignore("foreignContext");
+  }
+
+  const fields = action.payload.fields ?? {};
+  const errors = action.payload.errors ?? [];
+  const status = action.payload.status;
+
+  if (Object.keys(fields).length === 0 && errors.length === 0 && !status) {
+    return ignore("emptyPayload");
+  }
+
+  // Explicit permission error - never saved as success.
+  if (status === "permissionError") {
+    return {
+      status: "permissionError",
+      values: context.values,
+    };
+  }
+
+  // Field level validation failure - never saved as success.
+  const fieldErrors: FormFieldErrors = {};
+
+  errors.forEach(({ field, message }) => {
+    fieldErrors[field] = message ?? "Invalid value";
+  });
+
+  // Optional fields omitted from the payload keep their current value (default).
+  Object.entries(fields).forEach(([field, result]) => {
+    // Never overwrite the value the user is currently editing.
+    if (context.dirtyFields.includes(field)) {
+      return;
+    }
+
+    const validationError = context.validateField?.(field, result.value, context.values);
+
+    if (validationError) {
+      fieldErrors[field] = validationError;
+    }
+  });
+
+  if (status === "validationError" || Object.keys(fieldErrors).length > 0) {
+    return {
+      status: "validationError",
+      values: context.values,
+      fieldErrors,
+    };
+  }
+
+  const nextValues: Record<string, string> = { ...context.values };
+  const appliedFields: string[] = [];
+
+  Object.entries(fields).forEach(([field, result]) => {
+    if (context.dirtyFields.includes(field)) {
+      return;
+    }
+
+    nextValues[field] = result.value;
+    appliedFields.push(field);
+  });
+
+  return {
+    status: "success",
+    values: nextValues,
+    appliedFields,
+    closePopup: action.payload.closePopup ?? true,
+  };
+};
