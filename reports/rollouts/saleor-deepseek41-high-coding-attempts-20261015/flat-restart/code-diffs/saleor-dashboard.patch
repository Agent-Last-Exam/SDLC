+    it.each([
+      [-1, false],
+      [0, true],
+      [10, true],
+      [undefined, false],
+      [null, false],
+      [Number.NaN, false],
+      [Number.POSITIVE_INFINITY, false],
+    ])("validates %p as %p", (amount, expected) => {
+      expect(isValidPaymentAmount(amount as number)).toBe(expected);
+    });
+  });
+
+  describe("getOrderActionAvailability", () => {
+    it("exposes actions present in order.actions", () => {
+      // Arrange
+      const order = buildOrder({
+        actions: [OrderAction.CAPTURE, OrderAction.REFUND],
+      });
+
+      // Act
+      const availability = getOrderActionAvailability(order);
+
+      // Assert
+      expect(availability.capture.available).toBe(true);
+      expect(availability.refund.available).toBe(true);
+      expect(availability.void.available).toBe(false);
+      expect(availability.void.reason).toBe("missing_permission");
+    });
+
+    it("never exposes actions for a canceled order", () => {
+      // Arrange
+      const order = buildOrder({
+        status: OrderStatus.CANCELED,
+        actions: [OrderAction.CAPTURE, OrderAction.REFUND, OrderAction.MARK_AS_PAID],
+      });
+
+      // Act
+      const availability = getOrderActionAvailability(order);
+
+      // Assert
+      expect(availability.capture).toStrictEqual({ available: false, reason: "order_canceled" });
+      expect(availability.refund.reason).toBe("order_canceled");
+      expect(availability.markAsPaid.reason).toBe("order_canceled");
+    });
+
+    it("returns a list of available actions", () => {
+      // Arrange
+      const order = buildOrder({ actions: [OrderAction.CAPTURE, OrderAction.VOID] });
+
+      // Act
+      const available = getAvailableOrderActions(order);
+
+      // Assert
+      expect(available).toEqual(["capture", "void"]);
+    });
+  });
+
+  describe("canMarkAsPaid", () => {
+    it("is available when the action is present and there are no payment records", () => {
+      const order = buildOrder({ actions: [OrderAction.MARK_AS_PAID] });
+
+      expect(canMarkAsPaid(order)).toStrictEqual({ available: true });
+    });
+
+    it("is not available when the order already has payments", () => {
+      const order = buildOrder({
+        actions: [OrderAction.MARK_AS_PAID],
+        payments: [{} as OrderDetailsFragment["payments"][number]],
+      });
+
+      expect(canMarkAsPaid(order)).toStrictEqual({
+        available: false,
+        reason: "existing_payment",
+      });
+    });
+
+    it("is not available when the order already has transactions", () => {
+      const order = buildOrder({
+        actions: [OrderAction.MARK_AS_PAID],
+        transactions: [buildTransaction()],
+      });
+
+      expect(canMarkAsPaid(order)).toStrictEqual({
+        available: false,
+        reason: "existing_payment",
+      });
+    });
+  });
+
+  describe("capture amount boundary", () => {
+    it("computes the capturable amount from the outstanding authorization", () => {
+      const order = buildOrder({ totalAuthorized: money(100), totalCharged: money(30) });
+
+      expect(getMaxCapturableAmount(order)).toBe(70);
+    });
+
+    it("never returns a negative capturable amount", () => {
+      const order = buildOrder({ totalAuthorized: money(10), totalCharged: money(30) });
+
+      expect(getMaxCapturableAmount(order)).toBe(0);
+    });
+
+    it("rejects negative amounts", () => {
+      const order = buildOrder({ actions: [OrderAction.CAPTURE], totalAuthorized: money(100) });
+
+      expect(canCaptureAmount(order, -1)).toStrictEqual({
+        available: false,
+        reason: "amount_invalid",
+      });
+    });
+
+    it("rejects zero amounts", () => {
+      const order = buildOrder({ actions: [OrderAction.CAPTURE], totalAuthorized: money(100) });
+
+      expect(canCaptureAmount(order, 0)).toStrictEqual({
+        available: false,
+        reason: "amount_zero",
+      });
+    });
+
+    it("accepts exactly the capturable amount", () => {
+      const order = buildOrder({ actions: [OrderAction.CAPTURE], totalAuthorized: money(100) });
+
+      expect(canCaptureAmount(order, 100)).toStrictEqual({ available: true });
+    });
+
+    it("rejects amounts above the capturable amount", () => {
+      const order = buildOrder({ actions: [OrderAction.CAPTURE], totalAuthorized: money(100) });
+
+      expect(canCaptureAmount(order, 101)).toStrictEqual({
+        available: false,
+        reason: "amount_exceeds_authorized",
+      });
+    });
+
+    it("respects the order action gate", () => {
+      const order = buildOrder({ actions: [] });
+
+      expect(canCaptureAmount(order, 10)).toStrictEqual({
+        available: false,
+        reason: "missing_permission",
+      });
+    });
+  });
+
+  describe("refund amount boundary", () => {
+    it("computes the refundable amount from captured minus refunded and pending", () => {
+      const order = buildOrder({
+        totalCharged: money(100),
+        totalRefunded: money(30),
+        totalRefundPending: money(10),
+      });
+
+      expect(getRefundableAmount(order)).toBe(60);
+    });
+
+    it("accepts exactly the refundable amount", () => {
+      const order = buildOrder({ actions: [OrderAction.REFUND], totalCharged: money(60) });
+
+      expect(canRefundAmount(order, 60)).toStrictEqual({ available: true });
+    });
+
+    it("rejects amounts above the refundable amount", () => {
+      const order = buildOrder({ actions: [OrderAction.REFUND], totalCharged: money(60) });
+
+      expect(canRefundAmount(order, 61)).toStrictEqual({
+        available: false,
+        reason: "amount_exceeds_refundable",
+      });
+    });
+  });
+
+  describe("transaction refunds", () => {
+    it("tracks the refundable amount per transaction so it is not double counted", () => {
+      const first = buildTransaction({ chargedAmount: money(60) });
+      const second = buildTransaction({ chargedAmount: money(40) });
+
+      expect(getTransactionRefundableAmount(first)).toBe(60);
+      expect(getTransactionRefundableAmount(second)).toBe(40);
+    });
+
+    it("rejects a refund above the transaction refundable amount", () => {
+      const transaction = buildTransaction({
+        actions: [TransactionActionEnum.REFUND],
+        chargedAmount: money(60),
+        refundedAmount: money(20),
+      });
+
+      expect(canRefundTransactionAmount(transaction, 41)).toStrictEqual({
+        available: false,
+        reason: "amount_exceeds_refundable",
+      });
+    });
+
+    it("accepts a refund equal to the transaction refundable amount", () => {
+      const transaction = buildTransaction({
+        actions: [TransactionActionEnum.REFUND],
+        chargedAmount: money(60),
+        refundedAmount: money(20),
+      });
+
+      expect(canRefundTransactionAmount(transaction, 40)).toStrictEqual({ available: true });
+    });
+
+    it("requires the refund action on the transaction", () => {
+      const transaction = buildTransaction({
+        actions: [],
+        chargedAmount: money(60),
+      });
+
+      expect(canRefundTransactionAmount(transaction, 10)).toStrictEqual({
+        available: false,
+        reason: "missing_permission",
+      });
+    });
+  });
+
+  describe("getAvailableTransactionActions", () => {
+    it("filters out REFUND because refunds use the dedicated flow", () => {
+      const transaction = buildTransaction({
+        actions: [
+          TransactionActionEnum.CHARGE,
+          TransactionActionEnum.REFUND,
+          TransactionActionEnum.CANCEL,
+        ],
+      });
+
+      expect(getAvailableTransactionActions(transaction)).toEqual([
+        TransactionActionEnum.CHARGE,
+        TransactionActionEnum.CANCEL,
+      ]);
+    });
+
+    it("returns an empty list for undefined transactions", () => {
+      expect(getAvailableTransactionActions(undefined)).toEqual([]);
+    });
+  });
+
+  describe("createPaymentActionGuard", () => {
+    it("lets the first submission through and blocks the duplicate while in flight", () => {
+      // Arrange
+      const guard = createPaymentActionGuard();
+
+      // Act
+      const first = guard.acquire("order-1:capture");
+      const second = guard.acquire("order-1:capture");
+
+      // Assert
+      expect(first).toBe(true);
+      expect(second).toBe(false);
+    });
+
+    it("allows a retry after the in-flight action is released", () => {
+      // Arrange
+      const guard = createPaymentActionGuard();
+
+      // Act
+      guard.acquire("order-1:refund");
+      guard.release("order-1:refund");
+      const retry = guard.acquire("order-1:refund");
+
+      // Assert
+      expect(retry).toBe(true);
+    });
+  });
+});
