@@ -0,0 +1,47 @@
+import {
+  ChannelAvailabilityDiagnosticsQuery,
+  ProductChannelAvailabilityProblemSeverityEnum,
+  ProductChannelAvailabilityProblemTypeEnum,
+} from "@dashboard/graphql";
+
+export type DiagnosticsEdge = NonNullable<
+  NonNullable<
+    NonNullable<ChannelAvailabilityDiagnosticsQuery["product"]>["channelAvailabilityDiagnostics"]
+  >["edges"]
+>[number];
+
+export interface DiagnosticsProblem {
+  type: ProductChannelAvailabilityProblemTypeEnum;
+  severity: ProductChannelAvailabilityProblemSeverityEnum;
+  message: string;
+  field: string | null;
+  variantId: string | null;
+}
+
+export interface DiagnosticsChannel {
+  channel: {
+    id: string;
+    name: string;
+    slug: string;
+    currencyCode: string;
+  };
+  diagnostics: {
+    problemsCount: number;
+    warningsCount: number;
+    notApplicableCount: number;
+    problems: DiagnosticsProblem[];
+  } | null;
+}
+
+export type DiagnosticsStatus =
+  | "loading"
+  | "ready"
+  | "loaded-empty"
+  | "permission-denied"
+  | "error-retryable";
+
+export interface DiagnosticsViewState {
+  status: DiagnosticsStatus;
+  channels: DiagnosticsChannel[];
+  totalCount: number;
+}
diff --git a/src/products/components/ProductChannelDiagnostics/utils.test.ts b/src/products/components/ProductChannelDiagnostics/utils.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2261250d0583614fe52c709c828dc8891e19a50b
--- /dev/null
+++ b/src/products/components/ProductChannelDiagnostics/utils.test.ts
@@ -0,0 +1,262 @@
+import {
+  ProductChannelAvailabilityProblemSeverityEnum,
+  ProductChannelAvailabilityProblemTypeEnum,
+} from "@dashboard/graphql";
+
+import { DiagnosticsEdge, DiagnosticsProblem, DiagnosticsViewState } from "./types";
+import {
+  computeDiagnosticsState,
+  countGroupedProblems,
+  groupProblemsBySeverity,
+  isStaleResult,
+  mapEdgesToChannels,
+} from "./utils";
+
+const problem = (
+  severity: ProductChannelAvailabilityProblemSeverityEnum,
+  type: ProductChannelAvailabilityProblemTypeEnum = ProductChannelAvailabilityProblemTypeEnum.NOT_PUBLISHED,
+): DiagnosticsProblem => ({
+  severity,
+  type,
+  message: `${type} (${severity})`,
+  field: null,
+  variantId: null,
+});
+
+const edge = (
+  id: string,
+  problems: DiagnosticsProblem[],
+  counts?: Partial<{ problemsCount: number; warningsCount: number; notApplicableCount: number }>,
+): DiagnosticsEdge =>
+  ({
+    cursor: `cursor-${id}`,
+    channel: { id, name: `Channel ${id}`, slug: id, currencyCode: "USD" },
+    node: {
+      problemsCount: counts?.problemsCount ?? problems.length,
+      warningsCount: counts?.warningsCount ?? 0,
+      notApplicableCount: counts?.notApplicableCount ?? 0,
+      problems,
+    },
+  }) as DiagnosticsEdge;
+
+describe("ProductChannelDiagnostics / utils", () => {
+  describe("groupProblemsBySeverity", () => {
+    it("groups problems into blocker / warning / not-applicable", () => {
+      // Arrange
+      const problems = [
+        problem(ProductChannelAvailabilityProblemSeverityEnum.BLOCKER),
+        problem(ProductChannelAvailabilityProblemSeverityEnum.WARNING),
+        problem(ProductChannelAvailabilityProblemSeverityEnum.NOT_APPLICABLE),
+        problem(ProductChannelAvailabilityProblemSeverityEnum.BLOCKER),
+      ];
+
+      // Act
+      const grouped = groupProblemsBySeverity(problems);
+      const counts = countGroupedProblems(grouped);
+
+      // Assert
+      expect(grouped.blocker).toHaveLength(2);
+      expect(grouped.warning).toHaveLength(1);
+      expect(grouped.notApplicable).toHaveLength(1);
+      // problem count matches the number of rendered detail entries
+      expect(counts.total).toBe(problems.length);
+    });
+
+    it("classifies a digital product's shipping check as not-applicable", () => {
+      // Arrange
+      const problems = [
+        problem(ProductChannelAvailabilityProblemSeverityEnum.NOT_APPLICABLE, ProductChannelAvailabilityProblemTypeEnum.SHIPPING_NOT_APPLICABLE),
+        problem(ProductChannelAvailabilityProblemSeverityEnum.BLOCKER, ProductChannelAvailabilityProblemTypeEnum.NOT_PUBLISHED),
+      ];
+
+      // Act
+      const grouped = groupProblemsBySeverity(problems);
+
+      // Assert
+      expect(grouped.notApplicable[0].type).toBe(
+        ProductChannelAvailabilityProblemTypeEnum.SHIPPING_NOT_APPLICABLE,
+      );
+      // the shipping check is not counted as a blocking problem
+      expect(grouped.blocker).toHaveLength(1);
+      expect(grouped.blocker[0].type).toBe(ProductChannelAvailabilityProblemTypeEnum.NOT_PUBLISHED);
+    });
+
+    it("returns empty groups for no problems", () => {
+      // Act
+      const grouped = groupProblemsBySeverity([]);
+
+      // Assert
+      expect(countGroupedProblems(grouped)).toEqual({
+        blocker: 0,
+        warning: 0,
+        notApplicable: 0,
+        total: 0,
+      });
+    });
+  });
+
+  describe("mapEdgesToChannels", () => {
+    it("maps edges to channels with their diagnostics", () => {
+      // Act
+      const result = mapEdgesToChannels([edge("a", [problem(ProductChannelAvailabilityProblemSeverityEnum.BLOCKER)])]);
+
+      // Assert
+      expect(result[0].channel.id).toBe("a");
+      expect(result[0].diagnostics?.problems).toHaveLength(1);
+    });
+
+    it("keeps a channel with null node (diagnostics unavailable)", () => {
+      // Arrange
+      const unavailable = { cursor: "c", channel: { id: "x", name: "X", slug: "x", currencyCode: "EUR" }, node: null } as DiagnosticsEdge;
+
+      // Act
+      const result = mapEdgesToChannels([unavailable]);
+
+      // Assert
+      expect(result[0].channel.id).toBe("x");
+      expect(result[0].diagnostics).toBeNull();
+    });
+  });
+
+  describe("isStaleResult", () => {
+    it("flags a superseded result as stale", () => {
+      expect(isStaleResult(1, 2)).toBe(true);
+      expect(isStaleResult(2, 2)).toBe(false);
+    });
+  });
+
+  describe("computeDiagnosticsState", () => {
+    const previous: DiagnosticsViewState = { status: "loading", channels: [], totalCount: 0 };
+
+    it("returns permission-denied and no details when the user lacks permission", () => {
+      // Act
+      const state = computeDiagnosticsState({
+        hasPermission: false,
+        requestId: 1,
+        currentRequestId: 1,
+        loading: false,
+        error: false,
+        edges: [edge("a", [problem(ProductChannelAvailabilityProblemSeverityEnum.BLOCKER)])],
+        totalCount: 1,
+        previous,
+      });
+
+      // Assert
+      expect(state.status).toBe("permission-denied");
+      // restricted detail is never exposed
+      expect(state.channels).toHaveLength(0);
+    });
+
+    it("returns loaded-empty (positive empty state) when there are no channels", () => {
+      // Act
+      const state = computeDiagnosticsState({
+        hasPermission: true,
+        requestId: 1,
+        currentRequestId: 1,
+        loading: false,
+        error: false,
+        edges: [],
+        totalCount: 0,
+        previous,
+      });
+
+      // Assert
+      expect(state.status).toBe("loaded-empty");
+    });
+
+    it("returns ready with channels and consistent totalCount", () => {
+      // Act
+      const state = computeDiagnosticsState({
+        hasPermission: true,
+        requestId: 1,
+        currentRequestId: 1,
+        loading: false,
+        error: false,
+        edges: [edge("a", []), edge("b", [])],
+        totalCount: 2,
+        previous,
+      });
+
+      // Assert
+      expect(state.status).toBe("ready");
+      expect(state.channels).toHaveLength(2);
+      expect(state.totalCount).toBe(2);
+    });
+
+    it("shows error-retryable (not empty) when the query fails", () => {
+      // Arrange
+      const loaded: DiagnosticsViewState = {
+        status: "ready",
+        channels: mapEdgesToChannels([edge("a", [])]),
+        totalCount: 1,
+      };
+
+      // Act
+      const state = computeDiagnosticsState({
+        hasPermission: true,
+        requestId: 1,
+        currentRequestId: 1,
+        loading: false,
+        error: true,
+        edges: null,
+        totalCount: null,
+        previous: loaded,
+      });
+
+      // Assert
+      expect(state.status).toBe("error-retryable");
+      // previous list is preserved, never rendered as an empty result
+      expect(state.channels).toHaveLength(1);
+    });
+
+    it("does not clear the previous list while loading", () => {
+      // Arrange
+      const loaded: DiagnosticsViewState = {
+        status: "ready",
+        channels: mapEdgesToChannels([edge("a", [])]),
+        totalCount: 1,
+      };
+
+      // Act
+      const state = computeDiagnosticsState({
+        hasPermission: true,
+        requestId: 2,
+        currentRequestId: 2,
+        loading: true,
+        error: false,
+        edges: null,
+        totalCount: null,
+        previous: loaded,
+      });
+
+      // Assert
+      expect(state.status).toBe("ready");
+      expect(state.channels).toHaveLength(1);
+    });
