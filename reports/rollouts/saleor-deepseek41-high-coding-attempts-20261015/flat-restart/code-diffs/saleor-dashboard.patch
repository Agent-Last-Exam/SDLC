+import { DashboardCard } from "@dashboard/components/Card";
+import { ProductChannelAvailabilityProblemSeverityEnum } from "@dashboard/graphql";
+import { Button, Input, Spinner, Text } from "@saleor/macaw-ui-next";
+import { useIntl } from "react-intl";
+
+import { messages } from "./messages";
+import { DiagnosticsChannel, DiagnosticsProblem, DiagnosticsViewState } from "./types";
+import { groupProblemsBySeverity } from "./utils";
+
+export interface ProductChannelDiagnosticsProps {
+  state: DiagnosticsViewState;
+  channelFilter: string;
+  currencyFilter: string;
+  hasNextPage: boolean;
+  hasPreviousPage: boolean;
+  onChannelFilterChange: (value: string) => void;
+  onCurrencyFilterChange: (value: string) => void;
+  onRetry: () => void;
+  onNextPage: () => void;
+  onPreviousPage: () => void;
+}
+
+const severityGroupMessages = {
+  [ProductChannelAvailabilityProblemSeverityEnum.BLOCKER]: messages.blockerGroup,
+  [ProductChannelAvailabilityProblemSeverityEnum.WARNING]: messages.warningGroup,
+  [ProductChannelAvailabilityProblemSeverityEnum.NOT_APPLICABLE]: messages.notApplicableGroup,
+};
+
+const ProblemList = ({
+  severity,
+  problems,
+  testId,
+}: {
+  severity: ProductChannelAvailabilityProblemSeverityEnum;
+  problems: DiagnosticsProblem[];
+  testId: string;
+}) => {
+  const intl = useIntl();
+
+  if (problems.length === 0) {
+    return null;
+  }
+
+  return (
+    <div data-test-id={testId}>
+      <Text size={2} fontWeight="bold">
+        {intl.formatMessage(severityGroupMessages[severity])} ({problems.length})
+      </Text>
+      <ul>
+        {problems.map((problem, index) => (
+          <li key={`${problem.type}-${problem.variantId ?? ""}-${index}`}>
+            <Text size={2}>{problem.message}</Text>
+          </li>
+        ))}
+      </ul>
+    </div>
+  );
+};
+
+const ChannelDiagnosticsRow = ({ entry }: { entry: DiagnosticsChannel }) => {
+  const intl = useIntl();
+  const { channel, diagnostics } = entry;
+
+  if (!diagnostics) {
+    return (
+      <div data-test-id="channel-diagnostics-unavailable">
+        <Text size={2} fontWeight="bold">
+          {channel.name}
+        </Text>
+        <Text size={2}>{intl.formatMessage(messages.diagnosticsUnavailable)}</Text>
+      </div>
+    );
+  }
+
+  const grouped = groupProblemsBySeverity(diagnostics.problems);
+
+  return (
+    <div data-test-id="channel-diagnostics-row">
+      <Text size={2} fontWeight="bold">
+        {channel.name} ({channel.currencyCode})
+      </Text>
+      {diagnostics.problems.length === 0 ? (
+        <Text size={2} data-test-id="channel-no-problems">
+          {intl.formatMessage(messages.noProblemsInChannel)}
+        </Text>
+      ) : (
+        <>
+          <ProblemList
+            severity={ProductChannelAvailabilityProblemSeverityEnum.BLOCKER}
+            problems={grouped.blocker}
+            testId="diagnostics-group-blocker"
+          />
+          <ProblemList
+            severity={ProductChannelAvailabilityProblemSeverityEnum.WARNING}
+            problems={grouped.warning}
+            testId="diagnostics-group-warning"
+          />
+          <ProblemList
+            severity={ProductChannelAvailabilityProblemSeverityEnum.NOT_APPLICABLE}
+            problems={grouped.notApplicable}
+            testId="diagnostics-group-not-applicable"
+          />
+        </>
+      )}
+    </div>
+  );
+};
+
+const ProductChannelDiagnostics = ({
+  state,
+  channelFilter,
+  currencyFilter,
+  hasNextPage,
+  hasPreviousPage,
+  onChannelFilterChange,
+  onCurrencyFilterChange,
+  onRetry,
+  onNextPage,
+  onPreviousPage,
+}: ProductChannelDiagnosticsProps) => {
+  const intl = useIntl();
+
+  const renderBody = () => {
+    switch (state.status) {
+      case "permission-denied":
+        return (
+          <Text size={2} data-test-id="diagnostics-permission-denied">
+            {intl.formatMessage(messages.permissionDenied)}
+          </Text>
+        );
+      case "error-retryable":
+        return (
+          <div data-test-id="diagnostics-error">
+            <Text size={2}>{intl.formatMessage(messages.errorRetryable)}</Text>
+            <Button onClick={onRetry} data-test-id="diagnostics-retry">
+              {intl.formatMessage(messages.retry)}
+            </Button>
+          </div>
+        );
+      case "loaded-empty":
+        return (
+          <Text size={2} data-test-id="diagnostics-empty">
+            {intl.formatMessage(messages.noProblems)}
+          </Text>
+        );
+      case "loading":
+        return (
+          <div data-test-id="diagnostics-loading">
+            <Spinner />
+            <Text size={2}>{intl.formatMessage(messages.loading)}</Text>
+          </div>
+        );
+      case "ready":
+        return (
+          <div data-test-id="diagnostics-list">
+            {state.channels.map(entry => (
+              <ChannelDiagnosticsRow key={entry.channel.id} entry={entry} />
+            ))}
+          </div>
+        );
+      default:
+        return null;
+    }
+  };
+
+  const showList = state.status === "ready" && state.channels.length > 0;
+
+  return (
+    <DashboardCard>
+      <DashboardCard.Header>
+        <DashboardCard.Title>{intl.formatMessage(messages.title)}</DashboardCard.Title>
+      </DashboardCard.Header>
+      <DashboardCard.Content>
+        <div data-test-id="channel-diagnostics">
+          <Input
+            value={channelFilter}
+            onChange={event => onChannelFilterChange(event.target.value)}
+            placeholder={intl.formatMessage(messages.channelFilterPlaceholder)}
+            data-test-id="diagnostics-channel-filter"
+          />
+          <Input
+            value={currencyFilter}
+            onChange={event => onCurrencyFilterChange(event.target.value)}
+            placeholder={intl.formatMessage(messages.currencyFilterPlaceholder)}
+            data-test-id="diagnostics-currency-filter"
+          />
+          {renderBody()}
+          {showList && (
+            <div>
+              <Button
+                disabled={!hasPreviousPage}
+                onClick={onPreviousPage}
+                data-test-id="diagnostics-prev"
+              >
+                {intl.formatMessage(messages.previousPage)}
+              </Button>
+              <Button disabled={!hasNextPage} onClick={onNextPage} data-test-id="diagnostics-next">
+                {intl.formatMessage(messages.nextPage)}
+              </Button>
+            </div>
+          )}
+        </div>
+      </DashboardCard.Content>
+    </DashboardCard>
+  );
+};
+
+ProductChannelDiagnostics.displayName = "ProductChannelDiagnostics";
+export default ProductChannelDiagnostics;
