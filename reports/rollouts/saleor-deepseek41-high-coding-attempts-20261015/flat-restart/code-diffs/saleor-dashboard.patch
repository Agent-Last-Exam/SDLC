diff --git a/src/components/AssignCategoryDialog/categoryHierarchy.ts b/src/components/AssignCategoryDialog/categoryHierarchy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3a603e97315a149ebb33620eaa3a11810f4c37f6
--- /dev/null
+++ b/src/components/AssignCategoryDialog/categoryHierarchy.ts
@@ -0,0 +1,84 @@
+/**
+ * Pure hierarchy helpers for the category selector.
+ *
+ * The category picker supports navigating parent/child levels and showing a
+ * breadcrumb. Nodes are addressed by id and carry an optional `parentId` so the
+ * tree can be reconstructed without a dedicated tree component (there is no
+ * `CategoryTree` in the codebase).
+ */
+
+export interface CategoryHierarchyNode {
+  id: string;
+  name: string;
+  parentId?: string | null;
+}
+
+const byId = <T extends CategoryHierarchyNode>(nodes: T[]) =>
+  nodes.reduce<Record<string, T>>((acc, node) => {
+    acc[node.id] = node;
+    return acc;
+  }, {});
+
+/** Direct children of a node (or root level when `parentId` is null/undefined). */
+export function getChildNodes<T extends CategoryHierarchyNode>(
+  nodes: T[],
+  parentId: string | null | undefined,
+): T[] {
+  const normalized = parentId ?? null;
+
+  return nodes.filter(node => (node.parentId ?? null) === normalized);
+}
+
+/** Ids of every ancestor of `nodeId`, ordered from the root down to the parent. */
+export function getAncestorIds<T extends CategoryHierarchyNode>(
+  nodes: T[],
+  nodeId: string,
+): string[] {
+  const index = byId(nodes);
+  const ancestors: string[] = [];
+  let current = index[nodeId];
+  const visited = new Set<string>();
+
+  while (current && current.parentId != null && !visited.has(current.parentId)) {
+    visited.add(current.parentId);
+    ancestors.unshift(current.parentId);
+    current = index[current.parentId];
+  }
+
+  return ancestors;
+}
+
+/**
+ * Breadcrumb path from the root to `nodeId` (inclusive). When `nodeId` is null
+ * the path is empty (root level). Nodes whose ancestor is missing are ignored to
+ * avoid dangling/incorrect breadcrumbs.
+ */
+export function buildBreadcrumbPath<T extends CategoryHierarchyNode>(
+  nodes: T[],
+  nodeId: string | null | undefined,
+): T[] {
+  if (!nodeId) {
+    return [];
+  }
+
+  const index = byId(nodes);
+
+  if (!index[nodeId]) {
+    return [];
+  }
+
+  return [...getAncestorIds(nodes, nodeId), nodeId].map(id => index[id]);
+}
+
+/** True when `nodeId` is `ancestorId` itself or one of its descendants. */
+export function isDescendantOf<T extends CategoryHierarchyNode>(
+  nodes: T[],
+  ancestorId: string,
+  nodeId: string,
+): boolean {
+  if (ancestorId === nodeId) {
+    return true;
+  }
+
+  return getAncestorIds(nodes, nodeId).includes(ancestorId);
+}
