index 0000000000000000000000000000000000000000..3b645944cfac2d3418570d8812a73b756ec87b88
--- /dev/null
+++ b/src/components/AssignCategoryDialog/useCategoryHierarchy.ts
@@ -0,0 +1,41 @@
+import { useMemo, useState } from "react";
+
+import {
+  buildBreadcrumbPath,
+  CategoryHierarchyNode,
+  getChildNodes,
+} from "./categoryHierarchy";
+
+export interface UseCategoryHierarchyResult<T extends CategoryHierarchyNode> {
+  /** Currently opened node id, or null for the root level. */
+  currentId: string | null;
+  /** Root → current node path (empty at the root level). */
+  breadcrumb: T[];
+  /** Nodes shown for the current level. */
+  children: T[];
+  navigateTo: (id: string | null) => void;
+  goToRoot: () => void;
+}
+
+/**
+ * Keeps the current hierarchy level and derives the breadcrumb path and the
+ * visible children from it, so parent/child relationships stay consistent when
+ * switching levels.
+ */
+export function useCategoryHierarchy<T extends CategoryHierarchyNode>(
+  nodes: T[],
+  initialId: string | null = null,
+): UseCategoryHierarchyResult<T> {
+  const [currentId, setCurrentId] = useState<string | null>(initialId);
+
+  const breadcrumb = useMemo(() => buildBreadcrumbPath(nodes, currentId), [nodes, currentId]);
+  const children = useMemo(() => getChildNodes(nodes, currentId), [nodes, currentId]);
+
+  return {
+    currentId,
+    breadcrumb,
+    children,
+    navigateTo: setCurrentId,
+    goToRoot: () => setCurrentId(null),
+  };
+}
