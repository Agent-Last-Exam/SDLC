--- /dev/null
+++ b/src/components/ConditionalFilter/lockedFilters.ts
@@ -0,0 +1,150 @@
+import { parse, stringify } from "qs";
+
+import { FilterContainer, FilterElement } from "./FilterElement";
+
+/**
+ * URL parameter namespace used to inject locked conditions from an entry point
+ * (e.g. a channel or warehouse assignment action) into a list.
+ *
+ * Locked conditions are stored under their own namespace as an indexed list of
+ * token entries, exactly like the regular filter array but namespaced, e.g.:
+ *
+ *   /products?locked[0][s0.channel]=channel-pln
+ *
+ * This keeps the existing URL format untouched (regular conditions stay at the
+ * top level) while giving locked conditions a first-class, separate storage.
+ */
+export const LOCKED_FILTERS_URL_PARAM = "locked";
+
+/**
+ * A "dimension" is the logical field a condition targets. Two conditions share
+ * a dimension when they filter the same field (e.g. two `channel` conditions or
+ * two conditions on the same attribute). Locked conditions take precedence over
+ * regular ones that target the same dimension.
+ */
+export const getFilterElementDimension = (element: FilterElement): string =>
+  element.isAttribute && element.selectedAttribute
+    ? element.selectedAttribute.value
+    : element.value.value;
+
+/** Flatten a container down to its top-level filter elements (drops AND/OR strings). */
+export const getFilterElements = (container: FilterContainer): FilterElement[] =>
+  container.filter(FilterElement.isCompatible) as FilterElement[];
+
+/** Unique dimensions present in a container. */
+export const getLockedDimensions = (container: FilterContainer): string[] => {
+  const dimensions = getFilterElements(container).map(getFilterElementDimension);
+
+  return Array.from(new Set(dimensions));
+};
+
+/** True when the given element targets a dimension already locked. */
+export const isElementLocked = (element: FilterElement, locked: FilterContainer): boolean =>
+  getLockedDimensions(locked).includes(getFilterElementDimension(element));
+
+/**
+ * Drop regular conditions that collide with a locked dimension and return a
+ * canonical `[el, "AND", el, ...]` container.
+ * Locked conditions are never overridden by a regular condition on the same
+ * dimension, so the regular one is discarded.
+ */
+export const excludeLockedDimensions = (
+  regular: FilterContainer,
+  locked: FilterContainer,
+): FilterContainer => {
+  const kept = getFilterElements(regular).filter(element => !isElementLocked(element, locked));
+
+  return kept.reduce<FilterContainer>(
+    (acc, element, index) => (index === 0 ? [element] : [...acc, "AND", element]),
+    [],
+  );
+};
+
+/**
+ * Merge locked and regular conditions into the "effective conditions" used by
+ * list queries, sorting, export and bulk actions.
+ *
+ * Rules:
+ *  - locked conditions always win; a regular condition on a locked dimension is
+ *    dropped,
+ *  - locked conditions are placed first, followed by the remaining regular ones,
+ *  - a canonical `[el, "AND", el, ...]` container is produced so it can be fed to
+ *    the existing query builders and URL serializers unchanged.
+ */
+export const mergeFilterContainers = (
+  locked: FilterContainer,
+  regular: FilterContainer,
+): FilterContainer => {
+  const merged = [
+    ...getFilterElements(locked),
+    ...getFilterElements(excludeLockedDimensions(regular, locked)),
+  ];
+
+  return merged.reduce<FilterContainer>(
+    (acc, element, index) => (index === 0 ? [element] : [...acc, "AND", element]),
+    [],
+  );
+};
+
+/** Alias documenting intent at call sites that build query variables. */
+export const getEffectiveFilterContainer = mergeFilterContainers;
+
+/**
+ * Locked entries as parsed from the URL. `qs` returns an indexed array for the
+ * `locked[0][s0.channel]=pln` form, which is exactly what `TokenArray` expects.
+ */
+export type LockedFilterEntries = Array<Record<string, string | string[]>>;
+
+const isLockedEntriesEmpty = (locked: LockedFilterEntries | undefined): boolean =>
+  !locked || (Array.isArray(locked) && locked.length === 0);
+
+/**
+ * Parse locked conditions from a raw location search string.
+ * Returns an indexed array of token entries that can be handed to `TokenArray`
+ * (e.g. `[{ "s0.channel": "pln" }]`).
+ */
+export const parseLockedFromSearch = (locationSearch: string): LockedFilterEntries => {
+  const parsed = parse(locationSearch, { ignoreQueryPrefix: true });
+  const locked = parsed[LOCKED_FILTERS_URL_PARAM];
+
+  if (!locked || typeof locked !== "object") {
+    return [];
+  }
+
+  return (Array.isArray(locked) ? locked : [locked]) as LockedFilterEntries;
+};
+
+/** True when the location search carries any locked condition. */
+export const hasLockedFiltersInSearch = (locationSearch: string): boolean =>
+  !isLockedEntriesEmpty(parseLockedFromSearch(locationSearch));
+
+/**
+ * Serialize locked conditions back into an indexed query fragment that
+ * `TokenArray` understands, e.g. `0[s0.channel]=pln`.
+ */
+export const stringifyLockedTokens = (locked: LockedFilterEntries): string =>
+  isLockedEntriesEmpty(locked) ? "" : stringify(locked);
+
+/**
+ * Wrap locked entries under the dedicated URL namespace so they can be merged
+ * into the query string produced by the value provider.
+ */
+export const toLockedUrlParam = (
+  locked: LockedFilterEntries,
+): Record<string, LockedFilterEntries> =>
+  isLockedEntriesEmpty(locked) ? {} : { [LOCKED_FILTERS_URL_PARAM]: locked };
+
+/**
+ * Turn a locked container into an indexed array of URL token entries, mirroring
+ * the serialization used for regular conditions. Used by list views to preserve
+ * the locked namespace across navigation (reset / change filters).
+ */
+export const lockedContainerToUrlParams = (locked: FilterContainer): LockedFilterEntries =>
+  getFilterElements(locked).map(
+    element => element.asUrlEntry() as unknown as Record<string, string | string[]>,
+  );
+
+/** Convenience: locked container -> namespaced URL params (`{ locked: [...] }`). */
+export const lockedContainerToNamespacedUrlParams = (
+  locked: FilterContainer,
+): Record<string, LockedFilterEntries> => toLockedUrlParam(lockedContainerToUrlParams(locked));
