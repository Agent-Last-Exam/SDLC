+import { CheckoutSettingsInput } from "@dashboard/graphql";
+
+export interface CheckoutSettingsFormValues {
+  automaticallyCompleteCheckouts: boolean;
+  automaticCompletionDelay: number | null;
+  automaticCompletionCutoffDate: string | null;
+  expectedUpdatedAt: string | null;
+}
+
+/**
+ * Builds the `checkoutSettings` part of the channel create/update input.
+ *
+ * - `automaticCompletionDelay` / `automaticCompletionCutoffDate` are passed through as
+ *   `null` when unset so the backend keeps the existing (no delay / no lower bound) behaviour.
+ * - `expectedUpdatedAt` is the optimistic-concurrency token read from `CheckoutSettings.updatedAt`;
+ *   when it no longer matches, the backend rejects the whole update with
+ *   `CHECKOUT_SETTINGS_OUTDATED` and the previously effective settings are kept.
+ */
+export const buildCheckoutSettingsInput = (
+  values: CheckoutSettingsFormValues,
+): CheckoutSettingsInput => ({
+  automaticallyCompleteFullyPaidCheckouts: values.automaticallyCompleteCheckouts,
+  automaticCompletionDelay: values.automaticCompletionDelay,
+  automaticCompletionCutoffDate: values.automaticCompletionCutoffDate,
+  expectedUpdatedAt: values.expectedUpdatedAt,
+});
