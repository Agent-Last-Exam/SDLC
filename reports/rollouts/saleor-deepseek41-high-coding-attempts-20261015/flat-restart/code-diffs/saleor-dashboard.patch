+  it("does not show the retry action for a SUCCESS delivery", () => {
+    // Arrange
+    mockPermission(true);
+
+    // Act
+    const { queryByTestId } = renderItem({
+      status: EventDeliveryStatusEnum.SUCCESS,
+      onRetry: jest.fn(),
+    });
+
+    // Assert
+    expect(queryByTestId("retry-delivery-delivery-1")).not.toBeInTheDocument();
+  });
+
+  it("does not show the retry action without the App permission (AC-23-6)", () => {
+    // Arrange
+    mockPermission(false);
+
+    // Act
+    const { queryByTestId } = renderItem({ onRetry: jest.fn() });
+
+    // Assert
+    expect(queryByTestId("retry-delivery-delivery-1")).not.toBeInTheDocument();
+  });
+
+  it("does not show the retry action when no handler is provided", () => {
+    // Arrange
+    mockPermission(true);
+
+    // Act
+    const { queryByTestId } = renderItem();
+
+    // Assert
+    expect(queryByTestId("retry-delivery-delivery-1")).not.toBeInTheDocument();
+  });
+
+  it("disables the retry action while the retry is in flight", () => {
+    // Arrange
+    mockPermission(true);
+
+    // Act
+    const { getByTestId } = renderItem({ onRetry: jest.fn(), isRetrying: true });
+
+    // Assert
+    expect(getByTestId("retry-delivery-delivery-1")).toBeDisabled();
+  });
+
+  it("displays the error information for a failed delivery (AC-23-4)", () => {
+    // Arrange
+    mockPermission(true);
+
+    // Act
+    const { getByText } = renderItem({ onRetry: jest.fn() });
+
+    // Assert
+    expect(getByText('{"message":"Failed to send email"}')).toBeInTheDocument();
+    expect(getByText("400")).toBeInTheDocument();
+  });
+});
