@@ -0,0 +1,208 @@
+import isEqual from "lodash/isEqual";
+import { useCallback, useRef, useState } from "react";
+
+/**
+ * Distinguishable configuration load states (FD06 / R29).
+ *
+ * - `loading`: server data has not arrived yet. Form fields must be rendered as
+ *   disabled/skeleton, never with made-up defaults.
+ * - `loaded-empty`: data arrived but the value is empty/unconfigured. Render the
+ *   stable empty/default semantics (e.g. automatic completion stays off).
+ * - `permission-denied`: the caller lacks permission. This must be distinguishable
+ *   from "no data" — it is a permission error, not an empty result.
+ * - `error-retryable`: a network/server error occurred; an explicit retry is offered.
+ * - `ready`: data loaded and editable.
+ */
+export type ConfigLoadState =
+  | "loading"
+  | "loaded-empty"
+  | "permission-denied"
+  | "error-retryable"
+  | "ready";
+
+export interface ResolveConfigLoadStateArgs {
+  /** True while the query is in-flight. */
+  loading: boolean;
+  /** Query error, if any. */
+  error?: unknown;
+  /** Whether the caller has the permission required to load the configuration. */
+  hasPermission?: boolean;
+  /** Explicit permission denial (e.g. derived from a permission GraphQL error). */
+  permissionDenied?: boolean;
+  /** Whether the loaded configuration is empty/unconfigured. */
+  isEmpty?: boolean;
+  /** Whether any data (even empty) has already been loaded. */
+  hasData?: boolean;
+}
+
+/**
+ * Resolves the five distinguishable configuration states. The precedence is chosen
+ * so that a permission problem is never presented as an empty result, and a loading
+ * state is never presented as an error.
+ */
+export function resolveConfigLoadState({
+  loading,
+  error,
+  hasPermission = true,
+  permissionDenied = false,
+  isEmpty = false,
+  hasData = false,
+}: ResolveConfigLoadStateArgs): ConfigLoadState {
+  if (permissionDenied || !hasPermission) {
+    return "permission-denied";
+  }
+
+  if (loading && !hasData) {
+    return "loading";
+  }
+
+  if (error) {
+    return "error-retryable";
+  }
+
+  if (isEmpty) {
+    return "loaded-empty";
+  }
+
+  return "ready";
+}
+
+export interface UseFormContextGuardOptions<T> {
+  /**
+   * Identity of the current edit context (channel id, shop settings, product id...).
+   * When it changes, dirty tracking is reset and the form is re-seeded from the
+   * server data of the new context.
+   */
+  contextId: string | null | undefined;
+  /**
+   * The desired default values derived from the server. These may arrive late.
+   * Only fields that are not dirty are backfilled when this changes.
+   */
+  initialData: T;
+}
+
+export interface FormContextGuardResult<T> {
+  /** Current form data (user edits merged with late-arriving server data). */
+  data: T;
+  /** Marks a single field as user-modified and updates it. */
+  setField: <K extends keyof T>(name: K, value: T[K]) => void;
+  /** Marks several fields as user-modified and updates them. */
+  setFields: (partial: Partial<T>) => void;
+  /** Whether a specific field (or any field) has been modified by the user. */
+  isDirty: (name?: keyof T) => boolean;
+  /** The list of user-modified fields. */
+  dirtyFields: Array<keyof T>;
+  /**
+   * Clears dirty tracking and (optionally) seeds the form with the given data —
+   * e.g. the last effective server value after a failed save. Failed values must
+   * never be passed here.
+   */
+  reset: (data?: T) => void;
+}
+
+/**
+ * Protects an edit form against late-arriving data and context switches (FD06 / R29).
+ *
+ * - Each edit context is identified by `contextId`; when it changes, dirty tracking
+ *   is dropped and the form is re-seeded, so data from a previous context can never
+ *   leak into a new one.
+ * - When server data arrives late for the *same* context, only fields that the user
+ *   has not modified (`dirtyFields`) are backfilled. A value the user is currently
+ *   typing is never overwritten.
+ * - `reset` is the only way to seed the form with a server value again; callers use it
+ *   with the last *effective* value (never with a value from a failed save).
+ */
+export function useFormContextGuard<T extends Record<string, any>>({
+  contextId,
+  initialData,
+}: UseFormContextGuardOptions<T>): FormContextGuardResult<T> {
+  const [data, setData] = useState<T>(initialData);
+  const [dirtyFields, setDirtyFields] = useState<Array<keyof T>>([]);
+
+  const contextIdRef = useRef<string | null | undefined>(contextId);
+  const dirtyFieldsRef = useRef<Set<keyof T>>(new Set());
+  const initialDataRef = useRef<T>(initialData);
+
+  // Reconcile during render so late data never causes an intermediate paint with
+  // stale or wrong values (avoids flicker of incorrect content).
+  const contextChanged = contextIdRef.current !== contextId;
+  const initialDataChanged = !isEqual(initialDataRef.current, initialData);
+
+  if (contextChanged) {
+    contextIdRef.current = contextId;
+    initialDataRef.current = initialData;
+    dirtyFieldsRef.current = new Set();
+    setDirtyFields([]);
+    setData(initialData);
+  } else if (initialDataChanged) {
+    initialDataRef.current = initialData;
+    setData(prevData => {
+      const nextData = { ...prevData };
+
+      (Object.keys(initialData) as Array<keyof T>).forEach(key => {
+        // Only backfill fields the user has not touched.
+        if (!dirtyFieldsRef.current.has(key)) {
+          nextData[key] = initialData[key];
+        }
+      });
+
+      return nextData;
+    });
+  }
+
+  const markDirty = useCallback((names: Array<keyof T>) => {
+    let changed = false;
+
+    names.forEach(name => {
+      if (!dirtyFieldsRef.current.has(name)) {
+        dirtyFieldsRef.current.add(name);
+        changed = true;
+      }
+    });
+
+    if (changed) {
+      setDirtyFields(Array.from(dirtyFieldsRef.current));
+    }
+  }, []);
+
+  const setField = useCallback(
+    <K extends keyof T>(name: K, value: T[K]) => {
+      markDirty([name]);
+      setData(prevData => ({ ...prevData, [name]: value }));
+    },
+    [markDirty],
+  );
+
+  const setFields = useCallback(
+    (partial: Partial<T>) => {
+      markDirty(Object.keys(partial) as Array<keyof T>);
+      setData(prevData => ({ ...prevData, ...partial }));
+    },
+    [markDirty],
+  );
+
+  const isDirty = useCallback(
+    (name?: keyof T) =>
+      name === undefined ? dirtyFieldsRef.current.size > 0 : dirtyFieldsRef.current.has(name),
+    [],
+  );
+
+  const reset = useCallback(
+    (nextData?: T) => {
+      dirtyFieldsRef.current = new Set();
+      setDirtyFields([]);
+      initialDataRef.current = nextData ?? initialDataRef.current;
+      setData(nextData ?? initialDataRef.current);
+    },
+    [],
+  );
+
+  return {
+    data,
+    setField,
+    setFields,
+    isDirty,
+    dirtyFields,
+    reset,
+  };
+}
