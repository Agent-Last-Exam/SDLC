+import {
+  OrderAction,
+  OrderDetailsFragment,
+  OrderStatus,
+  TransactionActionEnum,
+  TransactionItemFragment,
+} from "@dashboard/graphql";
+
+import {
+  canCaptureAmount,
+  canMarkAsPaid,
+  canRefundAmount,
+  canRefundTransactionAmount,
+  createPaymentActionGuard,
+  getAvailableOrderActions,
+  getAvailableTransactionActions,
+  getMaxCapturableAmount,
+  getOrderActionAvailability,
+  getRefundableAmount,
+  getTransactionRefundableAmount,
+  isValidPaymentAmount,
+} from "./paymentActions";
+
+const money = (amount: number) => ({ __typename: "Money" as const, amount, currency: "USD" });
+
+const buildOrder = (overrides: Partial<OrderDetailsFragment> = {}): OrderDetailsFragment =>
+  ({
+    __typename: "Order",
+    status: OrderStatus.UNFULFILLED,
+    actions: [],
+    payments: [],
+    transactions: [],
+    grantedRefunds: [],
+    totalAuthorized: money(0),
+    totalCharged: money(0),
+    totalRefunded: money(0),
+    totalRefundPending: money(0),
+    ...overrides,
+  }) as unknown as OrderDetailsFragment;
+
+const buildTransaction = (
+  overrides: Partial<TransactionItemFragment> = {},
+): TransactionItemFragment =>
+  ({
+    __typename: "TransactionItem",
+    id: "tx-1",
+    actions: [],
+    chargedAmount: money(0),
+    refundedAmount: money(0),
+    refundPendingAmount: money(0),
+    ...overrides,
+  }) as unknown as TransactionItemFragment;
