diff --git a/src/hooks/useFormContextGuard.test.ts b/src/hooks/useFormContextGuard.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4eb92d1413914e2085fb498af5a15290c8a9b8c3
--- /dev/null
+++ b/src/hooks/useFormContextGuard.test.ts
@@ -0,0 +1,131 @@
+import { act, renderHook } from "@testing-library/react-hooks";
+
+import { resolveConfigLoadState, useFormContextGuard } from "./useFormContextGuard";
+
+describe("resolveConfigLoadState", () => {
+  it("distinguishes all five configuration states (AC-29-1)", () => {
+    // Arrange & Act & Assert
+    expect(resolveConfigLoadState({ loading: true })).toBe("loading");
+    expect(resolveConfigLoadState({ loading: false, isEmpty: true })).toBe("loaded-empty");
+    expect(resolveConfigLoadState({ loading: false, hasPermission: false })).toBe(
+      "permission-denied",
+    );
+    expect(resolveConfigLoadState({ loading: false, error: new Error("network") })).toBe(
+      "error-retryable",
+    );
+    expect(resolveConfigLoadState({ loading: false })).toBe("ready");
+  });
+
+  it("never presents a permission problem as empty data (AC-29-1)", () => {
+    // Arrange & Act
+    const state = resolveConfigLoadState({ loading: false, isEmpty: true, hasPermission: false });
+
+    // Assert
+    expect(state).toBe("permission-denied");
+  });
+
+  it("keeps showing loading before data arrives even if an error is later set (AC-29-2)", () => {
+    // Arrange & Act
+    const state = resolveConfigLoadState({ loading: true, error: new Error("pending") });
+
+    // Assert
+    expect(state).toBe("loading");
+  });
+});
+
+describe("useFormContextGuard", () => {
+  it("backfills only fields the user has not modified when data arrives late (AC-29-3)", () => {
+    // Arrange
+    const { result, rerender } = renderHook(
+      ({ initialData }) => useFormContextGuard({ contextId: "channel-1", initialData }),
+      {
+        initialProps: {
+          initialData: { name: "", slug: "initial-slug" } as Record<string, unknown>,
+        },
+      },
+    );
+
+    // Act - user starts typing in the name field
+    act(() => {
+      result.current.setField("name", "My channel");
+    });
+
+    // server data arrives late with a new slug and a different name
+    rerender({ initialData: { name: "server-name", slug: "server-slug" } });
+
+    // Assert - the typed value is preserved, the untouched field is backfilled
+    expect(result.current.data.name).toBe("My channel");
+    expect(result.current.data.slug).toBe("server-slug");
+    expect(result.current.isDirty("name")).toBe(true);
+    expect(result.current.isDirty("slug")).toBe(false);
+  });
+
+  it("resets dirty tracking and re-seeds the form when the edit context changes (AC-29-3)", () => {
+    // Arrange
+    const { result, rerender } = renderHook(
+      ({ contextId, initialData }) => useFormContextGuard({ contextId, initialData }),
+      {
+        initialProps: {
+          contextId: "channel-1",
+          initialData: { name: "Channel 1" } as Record<string, unknown>,
+        },
+      },
+    );
+
+    // Act - edit the current context, then switch to another channel
+    act(() => {
+      result.current.setField("name", "edited");
+    });
+    rerender({ contextId: "channel-2", initialData: { name: "Channel 2" } });
+
+    // Assert - edits from the previous context never leak into the new one
+    expect(result.current.data.name).toBe("Channel 2");
+    expect(result.current.isDirty()).toBe(false);
+  });
+
+  it("does not use a failed value as the default after reset (AC-29-5)", () => {
+    // Arrange
+    const { result } = renderHook(() =>
+      useFormContextGuard({
+        contextId: "channel-1",
+        initialData: { delay: 10 } as Record<string, unknown>,
+      }),
+    );
+
+    // Act - user submits an invalid value that fails to save, then the form is reset
+    // to the last effective server value (not the failed one).
+    act(() => {
+      result.current.setField("delay", -5);
+    });
+    act(() => {
+      result.current.reset({ delay: 10 });
+    });
+
+    // Assert
+    expect(result.current.data.delay).toBe(10);
+    expect(result.current.isDirty()).toBe(false);
+  });
+
+  it("clears dirty tracking via reset", () => {
+    // Arrange
+    const { result } = renderHook(() =>
+      useFormContextGuard({
+        contextId: "channel-1",
+        initialData: { a: 1 } as Record<string, unknown>,
+      }),
+    );
+
+    // Act
+    act(() => {
+      result.current.setFields({ a: 2 });
+    });
+
+    // Assert
+    expect(result.current.isDirty("a")).toBe(true);
+
+    act(() => {
+      result.current.reset();
+    });
+    expect(result.current.isDirty()).toBe(false);
+  });
+});
