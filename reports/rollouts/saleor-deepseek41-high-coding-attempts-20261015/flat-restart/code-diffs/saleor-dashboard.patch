+import { PasswordLoginModeEnum, PermissionEnum, ShopErrorFragment } from "@dashboard/graphql";
+import { getFormErrors } from "@dashboard/utils/errors";
+import { Box, RadioGroup, Skeleton, Text } from "@saleor/macaw-ui-next";
+import * as React from "react";
+import { useIntl, FormattedMessage } from "react-intl";
+
+import { SiteSettingsPageFormData } from "../SiteSettingsPage";
+import { messages } from "./messages";
+
+interface PasswordLoginSettingsCardProps {
+  data: SiteSettingsPageFormData;
+  errors: ShopErrorFragment[];
+  disabled: boolean;
+  /**
+   * Last mode known to be in effect on the server. Used to render the effective
+   * value independently from the pending (unsaved) form value, so a failed save
+   * never displays the un-saved value as effective.
+   */
+  currentMode?: PasswordLoginModeEnum;
+  onChange: (event: React.ChangeEvent<any>) => void;
+}
+
+const PasswordLoginSettingsCard = ({
+  data,
+  disabled,
+  errors,
+  currentMode,
+  onChange,
+}: PasswordLoginSettingsCardProps) => {
+  const intl = useIntl();
+  const userPermissions = useUserPermissions();
+  const canEdit =
+    !!userPermissions && hasPermissions(userPermissions, [PermissionEnum.MANAGE_SETTINGS]);
+  const formErrors = getFormErrors(["passwordLoginMode"], errors);
+  const fieldError = formErrors.passwordLoginMode;
+
+  const choices: Array<{ value: PasswordLoginModeEnum; label: string; description: string }> = [
+    {
+      value: PasswordLoginModeEnum.ENABLED,
+      label: intl.formatMessage(messages.enabledLabel),
+      description: intl.formatMessage(messages.enabledDescription),
+    },
+    {
+      value: PasswordLoginModeEnum.CUSTOMERS_ONLY,
+      label: intl.formatMessage(messages.customersOnlyLabel),
+      description: intl.formatMessage(messages.customersOnlyDescription),
+    },
+    {
+      value: PasswordLoginModeEnum.DISABLED,
+      label: intl.formatMessage(messages.disabledLabel),
+      description: intl.formatMessage(messages.disabledDescription),
+    },
+  ];
+
+  const modeLabel = (mode: PasswordLoginModeEnum | undefined) =>
+    choices.find(choice => choice.value === mode)?.label ?? "";
+
+  return (
+    <DashboardCard>
+      <DashboardCard.Header>
+        <DashboardCard.Title>{intl.formatMessage(messages.title)}</DashboardCard.Title>
+      </DashboardCard.Header>
+      <DashboardCard.Content>
+        <Text fontSize={3} display="block" marginBottom={4}>
+          {intl.formatMessage(messages.description)}
+        </Text>
+
+        {currentMode === undefined ? (
+          <Skeleton data-test-id="password-login-loading" />
+        ) : (
+          <>
+            <Text
+              fontSize={3}
+              fontWeight="medium"
+              display="block"
+              marginBottom={4}
+              data-test-id="password-login-current-mode"
+            >
+              <FormattedMessage
+                id="2y5hVf"
+                defaultMessage="Currently in effect:"
+                description="password login current effective mode label"
+              />{" "}
+              {modeLabel(currentMode)}
+            </Text>
+
+            <RadioGroup
+              value={data.passwordLoginMode}
+              disabled={disabled || !canEdit}
+              onValueChange={value =>
+                onChange({
+                  target: { name: "passwordLoginMode", value },
+                } as React.ChangeEvent<HTMLInputElement>)
+              }
+              data-test-id="password-login-mode"
+            >
+              {choices.map(choice => (
+                <RadioGroup.Item
+                  key={choice.value}
+                  value={choice.value}
+                  id={choice.value}
+                  data-test-id={`password-login-mode-${choice.value}`}
+                  marginBottom={3}
+                  alignItems="flex-start"
+                >
+                  <Box>
+                    <Text size={2} fontWeight="medium" display="block">
+                      {choice.label}
+                    </Text>
+                    <Text size={2} color="default2" display="block">
+                      {choice.description}
+                    </Text>
+                  </Box>
+                </RadioGroup.Item>
+              ))}
+            </RadioGroup>
+
+            {!canEdit && (
+              <Text
+                fontSize={3}
+                color="default2"
+                display="block"
+                marginTop={2}
+                data-test-id="password-login-read-only"
+              >
+                {intl.formatMessage(messages.readOnly)}
+              </Text>
+            )}
+
+            {fieldError && (
+              <Text
+                fontSize={3}
+                color="critical1"
+                display="block"
+                marginTop={2}
+                data-test-id="password-login-save-error"
+              >
+                {fieldError.message || intl.formatMessage(messages.saveError)}
+              </Text>
+            )}
+          </>
+        )}
+        <FormSpacer />
+      </DashboardCard.Content>
+    </DashboardCard>
+  );
+};
+
+PasswordLoginSettingsCard.displayName = "PasswordLoginSettingsCard";
+export default PasswordLoginSettingsCard;
