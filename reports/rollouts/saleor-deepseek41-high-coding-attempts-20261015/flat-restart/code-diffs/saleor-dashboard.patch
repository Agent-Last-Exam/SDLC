@@ -0,0 +1,134 @@
+import { atom, useAtom } from "jotai";
+import { useCallback } from "react";
+
+import {
+  applyFormPayloadUpdate,
+  FormEditingContext,
+  FormPayloadAction,
+  FormPayloadOutcome,
+} from "./formPayloadUpdate";
+
+interface FormPayloadState {
+  /** form currently being edited by the user */
+  editingContext: FormEditingContext | null;
+  /** action ids already handled - used to reject duplicate responses */
+  processedActionIds: string[];
+  /** apps with a mounted / loaded frame */
+  loadedFrameAppIds: string[];
+  /** apps that are currently active (not deactivated) */
+  activeAppIds: string[];
+  /** result of the last handled response, for the receiving form to react to */
+  lastOutcome: FormPayloadOutcome | null;
+}
+
+const initialState: FormPayloadState = {
+  editingContext: null,
+  processedActionIds: [],
+  loadedFrameAppIds: [],
+  activeAppIds: [],
+  lastOutcome: null,
+};
+
+const formPayloadStateAtom = atom<FormPayloadState>(initialState);
+
+/**
+ * R20 / FD05 - receiving side of the extension form response contract.
+ *
+ * Forms (product edit / translation, ...) register their editing context here;
+ * `AppFrame` registers itself as a loaded frame; the AppDialog frame dispatches
+ * responses through `handleFormPayloadUpdate`, which only forwards them to the
+ * matching editing context.
+ */
+export const useFormPayloadState = () => {
+  const [state, setState] = useAtom(formPayloadStateAtom);
+
+  const registerEditingContext = useCallback(
+    (context: FormEditingContext) => {
+      setState(prev => ({ ...prev, editingContext: context }));
+    },
+    [setState],
+  );
+
+  const clearEditingContext = useCallback(
+    (form?: string) => {
+      setState(prev => {
+        if (form && prev.editingContext?.form !== form) {
+          return prev;
+        }
+
+        return { ...prev, editingContext: null };
+      });
+    },
+    [setState],
+  );
+
+  const registerAppFrame = useCallback(
+    (appId: string, isAppActive = true) => {
+      setState(prev => ({
+        ...prev,
+        loadedFrameAppIds: prev.loadedFrameAppIds.includes(appId)
+          ? prev.loadedFrameAppIds
+          : [...prev.loadedFrameAppIds, appId],
+        activeAppIds:
+          isAppActive && !prev.activeAppIds.includes(appId)
+            ? [...prev.activeAppIds, appId]
+            : prev.activeAppIds,
+      }));
+    },
+    [setState],
+  );
+
+  const unregisterAppFrame = useCallback(
+    (appId: string) => {
+      setState(prev => ({
+        ...prev,
+        loadedFrameAppIds: prev.loadedFrameAppIds.filter(id => id !== appId),
+        activeAppIds: prev.activeAppIds.filter(id => id !== appId),
+      }));
+    },
+    [setState],
+  );
+
+  const handleFormPayloadUpdate = useCallback(
+    (action: FormPayloadAction | undefined, appId: string): FormPayloadOutcome => {
+      const outcome = applyFormPayloadUpdate({
+        action,
+        appId,
+        context: state.editingContext,
+        processedActionIds: state.processedActionIds,
+        loadedFrameAppIds: state.loadedFrameAppIds,
+        activeAppIds: state.activeAppIds,
+      });
+
+      const actionId = action?.payload?.actionId;
+
+      setState(prev => {
+        const nextState: FormPayloadState = { ...prev, lastOutcome: outcome };
+
+        if (outcome.status === "ignored") {
+          return nextState;
+        }
+
+        if (actionId && !prev.processedActionIds.includes(actionId)) {
+          nextState.processedActionIds = [...prev.processedActionIds, actionId];
+        }
+
+        // The form owns the value merge; keep the registered context untouched so
+        // a rejected/ignored response can never mutate the editing state.
+        return nextState;
+      });
+
+      return outcome;
+    },
+    [setState, state],
+  );
+
+  return {
+    ...state,
+    registerEditingContext,
+    clearEditingContext,
+    registerAppFrame,
+    unregisterAppFrame,
+    handleFormPayloadUpdate,
+  };
+};
