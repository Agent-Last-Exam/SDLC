+import { act, renderHook } from "@testing-library/react-hooks";
+
+import useSearchQuery from "./useSearchQuery";
+
+describe("useSearchQuery", () => {
+  it("calls onFetch with the typed value and keeps it in state", () => {
+    // Arrange
+    const onFetch = jest.fn();
+    const { result } = renderHook(() => useSearchQuery(onFetch));
+
+    // Act
+    act(() => {
+      result.current[1]({ target: { name: "", value: "beer" } } as any);
+    });
+
+    // Assert
+    expect(onFetch).toHaveBeenCalledWith("beer");
+    expect(result.current[0]).toBe("beer");
+  });
+
+  it("short-circuits whitespace-only input to an explicit empty query (AC-13-4)", () => {
+    // Arrange
+    const onFetch = jest.fn();
+    const { result } = renderHook(() => useSearchQuery(onFetch));
+
+    // Act
+    act(() => {
+      result.current[1]({ target: { name: "", value: "   " } } as any);
+    });
+
+    // Assert
+    expect(onFetch).toHaveBeenCalledWith("");
+  });
+
+  it("reset calls onFetch with the initial value", () => {
+    // Arrange
+    const onFetch = jest.fn();
+    const { result } = renderHook(() => useSearchQuery(onFetch, "init"));
+
+    // Act
+    act(() => {
+      result.current[2]();
+    });
+
+    // Assert
+    expect(onFetch).toHaveBeenCalledWith("init");
+    expect(result.current[0]).toBe("init");
+  });
+});
