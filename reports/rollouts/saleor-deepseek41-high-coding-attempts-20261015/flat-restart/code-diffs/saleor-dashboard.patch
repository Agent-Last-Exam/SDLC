@@ -0,0 +1,284 @@
+import { MockedProvider, MockedResponse } from "@apollo/client/testing";
+import { UserContext } from "@dashboard/auth";
+import { UserFragment, OrderDirection, PermissionEnum } from "@dashboard/graphql";
+import { ChannelAvailabilityDiagnosticsDocument } from "@dashboard/graphql/hooks.generated";
+import { ThemeWrapper } from "@test/themeWrapper";
+import { act, cleanup, render, screen } from "@testing-library/react";
+import { ReactNode } from "react";
+import { IntlProvider } from "react-intl";
+
+import ProductChannelDiagnostics from "./ProductChannelDiagnostics";
+import ProductChannelDiagnosticsContainer from "./index";
+import { DiagnosticsViewState } from "./types";
+
+/** Flushes pending Apollo mock responses (RTL v12 + React 18 needs an explicit tick). */
+const flush = async () => {
+  await act(async () => {
+    await new Promise(resolve => setTimeout(resolve, 400));
+  });
+};
+
+const user = (permissions: PermissionEnum[]): UserFragment =>
+  ({
+    userPermissions: permissions.map(code => ({ code, name: code, __typename: "UserPermission" })),
+  }) as unknown as UserFragment;
+
+const wrap = (children: ReactNode, mocks: MockedResponse[] = [], permissions?: PermissionEnum[]) => {
+  const Provider = ({ children: inner }: { children: ReactNode }) => (
+    <MockedProvider mocks={mocks} addTypename={false}>
+      <UserContext.Provider
+        value={{
+          user: permissions ? user(permissions) : null,
+          authenticating: false,
+          isCredentialsLogin: false,
+          authenticated: true,
+          errors: [],
+        }}
+      >
+        <IntlProvider defaultLocale="en" locale="en">
+          <ThemeWrapper>{inner}</ThemeWrapper>
+        </IntlProvider>
+      </UserContext.Provider>
+    </MockedProvider>
+  );
+
+  return <Provider>{children}</Provider>;
+};
+
+const baseState: DiagnosticsViewState = {
+  status: "ready",
+  channels: [],
+  totalCount: 0,
+};
+
+const presentationalProps = {
+  channelFilter: "",
+  currencyFilter: "",
+  hasNextPage: false,
+  hasPreviousPage: false,
+  onChannelFilterChange: jest.fn(),
+  onCurrencyFilterChange: jest.fn(),
+  onRetry: jest.fn(),
+  onNextPage: jest.fn(),
+  onPreviousPage: jest.fn(),
+};
+
+const channelEntry = (id: string, problems: any[], diagnosticsNull = false) => ({
+  channel: { id, name: `Channel ${id}`, slug: id, currencyCode: "USD" },
+  diagnostics: diagnosticsNull
+    ? null
+    : { problemsCount: problems.length, warningsCount: 0, notApplicableCount: 0, problems },
+});
+
+describe("ProductChannelDiagnostics (presentational)", () => {
+  it("renders the three severity groups with counts matching the detail entries", () => {
+    // Arrange
+    const state: DiagnosticsViewState = {
+      ...baseState,
+      channels: [
+        channelEntry("ch1", [
+          { type: "NOT_PUBLISHED", severity: "BLOCKER", message: "Not published", field: null, variantId: null },
+          { type: "NO_STOCK", severity: "WARNING", message: "No stock", field: null, variantId: null },
+          { type: "SHIPPING_NOT_APPLICABLE", severity: "NOT_APPLICABLE", message: "Shipping skipped", field: null, variantId: null },
+        ]),
+      ],
+      totalCount: 1,
+    };
+
+    // Act
+    render(wrap(<ProductChannelDiagnostics {...presentationalProps} state={state} />));
+
+    // Assert
+    expect(screen.getByText(/Channel ch1/)).toBeInTheDocument();
+    expect(screen.getByTestId("diagnostics-group-blocker")).toHaveTextContent("(1)");
+    expect(screen.getByTestId("diagnostics-group-warning")).toHaveTextContent("(1)");
+    expect(screen.getByTestId("diagnostics-group-not-applicable")).toHaveTextContent("(1)");
+    expect(screen.getByText("Not published")).toBeInTheDocument();
+  });
+
+  it("renders a positive empty state when there are no problems", () => {
+    // Act
+    render(
+      wrap(<ProductChannelDiagnostics {...presentationalProps} state={{ ...baseState, status: "loaded-empty" }} />),
+    );
+
+    // Assert
+    expect(screen.getByTestId("diagnostics-empty")).toBeInTheDocument();
+  });
+
+  it("renders a retryable error state (not an empty result)", () => {
+    // Arrange
+    const onRetry = jest.fn();
+
+    // Act
+    render(
+      wrap(
+        <ProductChannelDiagnostics
+          {...presentationalProps}
+          onRetry={onRetry}
+          state={{ ...baseState, status: "error-retryable" }}
+        />,
+      ),
+    );
+
+    // Assert
+    expect(screen.getByTestId("diagnostics-error")).toBeInTheDocument();
+    expect(screen.queryByTestId("diagnostics-empty")).toBeNull();
+    screen.getByTestId("diagnostics-retry").click();
+    expect(onRetry).toHaveBeenCalled();
+  });
+
+  it("does not expose restricted details when permission is denied", () => {
+    // Act
+    render(
+      wrap(
+        <ProductChannelDiagnostics
+          {...presentationalProps}
+          state={{ status: "permission-denied", channels: [], totalCount: 0 }}
+        />,
+      ),
+    );
+
+    // Assert
+    expect(screen.getByTestId("diagnostics-permission-denied")).toBeInTheDocument();
+    expect(screen.queryByTestId("diagnostics-list")).toBeNull();
+    expect(screen.queryByTestId("diagnostics-group-blocker")).toBeNull();
+  });
+
+  it("renders an unavailable state when a channel's diagnostics cannot be computed", () => {
+    // Act
+    render(
+      wrap(
+        <ProductChannelDiagnostics
+          {...presentationalProps}
+          state={{ ...baseState, channels: [channelEntry("ch1", [], true)], totalCount: 1 }}
+        />,
+      ),
+    );
+
+    // Assert
+    expect(screen.getByTestId("channel-diagnostics-unavailable")).toBeInTheDocument();
+  });
+});
+
+describe("ProductChannelDiagnosticsContainer", () => {
+  const diagnosticsData = {
+    product: {
+      __typename: "Product",
+      id: "p1",
+      channelAvailabilityDiagnostics: {
+        __typename: "ProductChannelAvailabilityDiagnosticsCountableConnection",
+        totalCount: 1,
+        edges: [
+          {
+            __typename: "ProductChannelAvailabilityDiagnosticsCountableEdge",
+            cursor: "c1",
+            channel: { __typename: "Channel", id: "ch1", name: "Default", slug: "default", currencyCode: "USD" },
+            node: {
+              __typename: "ProductChannelAvailabilityDiagnostics",
+              problemsCount: 1,
+              warningsCount: 0,
+              notApplicableCount: 0,
+              problems: [
+                {
+                  __typename: "ProductChannelAvailabilityProblem",
+                  type: "NOT_PUBLISHED",
+                  severity: "BLOCKER",
+                  message: "Not published",
+                  field: null,
+                  variantId: null,
+                },
+              ],
+            },
+          },
+        ],
+        pageInfo: {
+          __typename: "PageInfo",
+          hasNextPage: false,
+          hasPreviousPage: false,
+          startCursor: "c1",
+          endCursor: "c1",
+        },
+      },
+    },
+  };
+
+  const diagnosticsMock = (result: any, granted: PermissionEnum[] = [PermissionEnum.MANAGE_PRODUCTS]): MockedResponse => {
+    // makeQuery injects one boolean variable per permission into every request
+    const permissionVariables = Object.keys(PermissionEnum).reduce<Record<string, boolean>>(
+      (acc, code) => {
+        acc[`PERMISSION_${code}`] = granted.includes(code as PermissionEnum);
+        return acc;
+      },
+      {},
+    );
+
+    return {
+      request: {
+        query: ChannelAvailabilityDiagnosticsDocument,
+        variables: {
+          id: "p1",
+          filter: undefined,
+          sortBy: {
+            field: "CHANNEL_NAME",
+            direction: OrderDirection.ASC,
+          },
+          first: 10,
+          ...permissionVariables,
+        },
+      },
+      ...result,
+    };
+  };
+
+  it("fetches and renders diagnostics for a saved product", async () => {
+    // Arrange
+    const mocks = [diagnosticsMock({ result: { data: diagnosticsData } })];
+
+    // Act
+    render(
+      wrap(
+        <ProductChannelDiagnosticsContainer productId="p1" />,
+        mocks,
+        [PermissionEnum.MANAGE_PRODUCTS],
+      ),
+    );
+
+    // Assert
+    await flush();
+    expect(screen.getByTestId("channel-diagnostics-row")).toBeInTheDocument();
+    expect(screen.getByText(/Default/)).toBeInTheDocument();
+    expect(screen.getByTestId("diagnostics-group-blocker")).toHaveTextContent("Not published");
+  });
+
+  it("shows permission-denied and does not fetch without MANAGE_PRODUCTS", async () => {
+    // Act
+    render(wrap(<ProductChannelDiagnosticsContainer productId="p1" />, [], []));
+
+    // Assert
+    await flush();
+    expect(screen.getByTestId("diagnostics-permission-denied")).toBeInTheDocument();
+    expect(screen.queryByTestId("diagnostics-list")).toBeNull();
+  });
+
+  it("shows a retryable error instead of an empty result when the query fails", async () => {
+    // Arrange
+    const mocks = [diagnosticsMock({ error: new Error("boom") })];
+
+    // Act
+    render(
+      wrap(
+        <ProductChannelDiagnosticsContainer productId="p1" />,
+        mocks,
+        [PermissionEnum.MANAGE_PRODUCTS],
+      ),
+    );
+
+    // Assert
+    await flush();
+    expect(screen.getByTestId("diagnostics-error")).toBeInTheDocument();
+    expect(screen.queryByTestId("diagnostics-empty")).toBeNull();
+  });
+});
+
+afterEach(cleanup);
