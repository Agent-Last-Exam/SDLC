+
+    // Assert
+    expect(onNavigate).toHaveBeenCalledWith(null);
+  });
+
+  it("renders only the root entry at the top level", () => {
+    // Act
+    render(
+      <Wrapper>
+        <CategoryHierarchyBreadcrumb path={[]} onNavigate={jest.fn()} />
+      </Wrapper>,
+    );
+
+    // Assert
