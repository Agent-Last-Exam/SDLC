+describe("OrderShippingMethodMetadata", () => {
+  it("renders the public snapshot values captured with the order", () => {
+    // Arrange
+    render(
+      <OrderShippingMethodMetadata
+        metadata={metadata([{ key: "carrier_id", value: "dhl-express" }])}
+        privateMetadata={metadata([])}
+      />,
+    );
+
+    // Assert
+    expect(screen.getByTestId("shipping-method-metadata-snapshot")).toBeInTheDocument();
+    expect(screen.getByText("carrier_id")).toBeInTheDocument();
+    expect(screen.getByText("dhl-express")).toBeInTheDocument();
+  });
+
+  it("renders private metadata for authorised users", () => {
+    // Arrange
+    render(
+      <OrderShippingMethodMetadata
+        metadata={metadata([])}
+        privateMetadata={metadata([{ key: "internal_note", value: "fragile" }])}
+      />,
+    );
+
+    // Assert
+    expect(screen.getByTestId("shipping-metadata-private")).toBeInTheDocument();
+    expect(screen.getByText("internal_note")).toBeInTheDocument();
+  });
+
+  it("does not render the private section when the server hides private metadata", () => {
+    // Arrange
+    render(
+      <OrderShippingMethodMetadata
+        metadata={metadata([{ key: "carrier_id", value: "dhl-express" }])}
+        privateMetadata={metadata([])}
+      />,
+    );
+
+    // Assert
+    expect(screen.queryByTestId("shipping-metadata-private")).not.toBeInTheDocument();
+  });
+
+  it("shows a stable empty state when there is no metadata snapshot", () => {
+    // Arrange
+    render(<OrderShippingMethodMetadata metadata={metadata([])} privateMetadata={metadata([])} />);
+
+    // Assert
+    expect(screen.getByTestId("shipping-method-metadata-empty")).toBeInTheDocument();
+  });
+});
