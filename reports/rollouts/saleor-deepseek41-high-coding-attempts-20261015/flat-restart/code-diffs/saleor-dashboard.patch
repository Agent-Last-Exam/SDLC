+import { OrderDetailsFragment } from "@dashboard/graphql";
+import { order as orderFixture } from "@dashboard/orders/fixtures";
+import { render, screen } from "@testing-library/react";
+
+import OrderSummaryCard from "./OrderSummaryCard";
+
+jest.mock("@saleor/macaw-ui", () => ({
+  makeStyles: jest.fn(() => () => ({})),
+}));
+
+const money = (amount: number) => ({ __typename: "Money" as const, amount, currency: "USD" });
+
+const buildOrder = (overrides: Partial<OrderDetailsFragment> = {}): OrderDetailsFragment =>
+  ({
+    ...orderFixture("summary-test"),
+    giftCards: [],
+    totalGiftCard: money(0),
+    shippingMethodMetadata: [],
+    shippingMethodPrivateMetadata: [],
+    ...overrides,
+  }) as unknown as OrderDetailsFragment;
+
+const renderedAmounts = () =>
+  screen.getAllByTestId("money-value").map(element => element.textContent);
+
+describe("OrderSummaryCard", () => {
+  it("reads the gift card amount from the server totalGiftCard field", () => {
+    // Arrange
+    const order = buildOrder({
+      totalGiftCard: money(100),
+      giftCards: [
+        {
+          __typename: "GiftCard",
+          id: "gc-1",
+          last4CodeChars: "1234",
+          // Events deliberately imply a different amount than the server field,
+          // proving the summary does not recompute gift cards locally.
+          events: [],
+        },
+      ],
+    });
+
+    // Act
+    render(<OrderSummaryCard order={order} />);
+
+    // Assert
+    expect(renderedAmounts().some(amount => amount.includes("100"))).toBe(true);
+  });
+
+  it("does not render a gift card line when the server reports no gift card amount", () => {
+    // Arrange
+    const order = buildOrder({ totalGiftCard: money(0) });
+
+    // Act
+    render(<OrderSummaryCard order={order} />);
+
+    // Assert
+    expect(screen.queryByText(/gift card/i)).not.toBeInTheDocument();
+  });
+
+  it("renders the delivery method metadata snapshot from the order", () => {
+    // Arrange
+    const order = buildOrder({
+      shippingMethodMetadata: [
+        { __typename: "MetadataItem", key: "carrier", value: "dhl" },
+      ],
+    });
+
+    // Act
+    render(<OrderSummaryCard order={order} />);
+
+    // Assert
+    expect(screen.getByTestId("shipping-method-metadata-snapshot")).toBeInTheDocument();
+    expect(screen.getByText("carrier")).toBeInTheDocument();
+  });
+});
