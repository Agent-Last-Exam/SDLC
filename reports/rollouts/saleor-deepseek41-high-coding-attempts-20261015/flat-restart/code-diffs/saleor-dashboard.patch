+    // Assert
+    expect(screen.getByTestId("add-products-button")).toBeDisabled();
+    expect(screen.getByTestId("add-products-disabled-reason")).toHaveTextContent(
+      "This channel is inactive.",
+    );
+  });
+
+  it("disables 'Add products' with a reason when the channel has no products", () => {
+    // Act
+    render(
+      <Wrapper>
+        <OrderDraftDetails
+          {...baseProps}
+          order={draftOrder()}
