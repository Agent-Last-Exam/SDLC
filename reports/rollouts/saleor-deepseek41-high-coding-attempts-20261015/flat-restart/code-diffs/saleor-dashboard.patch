@@ -0,0 +1,36 @@
+import { getPrevLocationState } from "@dashboard/hooks/useBackLinkWithState";
+
+export interface NavigationLocation {
+  pathname: string;
+  search: string;
+}
+
+export interface ReturnNavigation {
+  url: string;
+  opts: {
+    /** Keep the current query string so filters/pagination survive the return. */
+    preserveQs: true;
+    /** Carry the source location so the list can restore its context. */
+    state: ReturnType<typeof getPrevLocationState>;
+  };
+}
+
+/**
+ * Builds the navigation used to go back from a selector/dialog to the list it
+ * was opened from. Both the query string and the source location are preserved
+ * so the original navigation context (filters, pagination, selection) is kept
+ * regardless of the state the selector was in (loading, empty, permission or
+ * network error).
+ */
+export function buildReturnNavigation(
+  url: string,
+  location: NavigationLocation,
+): ReturnNavigation {
+  return {
+    url,
+    opts: {
+      preserveQs: true,
+      state: getPrevLocationState(location as Parameters<typeof getPrevLocationState>[0]),
+    },
+  };
+}
