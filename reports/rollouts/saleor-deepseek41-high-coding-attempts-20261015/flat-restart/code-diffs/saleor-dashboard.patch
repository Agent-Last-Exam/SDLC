+import { ChannelUsabilityDataQuery, OrderDetailsFragment } from "@dashboard/graphql";
+import { defineMessages, MessageDescriptor } from "react-intl";
+
+/**
+ * Centralised availability rules for draft order actions (R30 / FD07).
+ *
+ * A draft order must not offer actions that are known to be invalid: when the
+ * channel is inactive, there are no purchasable products in the channel, or a
+ * required configuration (shipping methods) is missing, the actions are
+ * disabled with an explicit reason instead of being hidden.
+ */
+
+export const draftOrderActionMessages = defineMessages({
+  inactiveChannel: {
+    id: "0phtVW",
+    defaultMessage: "This channel is inactive.",
+    description: "disabled draft action reason",
+  },
+  noProductsInChannel: {
+    id: "yFc4vK",
+    defaultMessage: "There are no available products in this channel.",
+    description: "disabled draft action reason",
+  },
+  noShippingMethods: {
+    id: "1u2QyH",
+    defaultMessage: "No shipping methods are available for this order.",
+    description: "disabled draft action reason",
+  },
+});
+
+export type DraftOrderActionKey = "addProducts" | "finalize";
+
+export interface DraftOrderConditions {
+  /** Channel the draft order belongs to is active. */
+  isChannelActive: boolean;
+  /** At least one product is purchasable in the order's channel. */
+  hasProductsInChannel: boolean;
+  /** Shipping methods can be evaluated (address country + order lines present). */
+  shippingMethodsDeterminable: boolean;
+  /** The order has at least one applicable shipping method. */
+  hasShippingMethods: boolean;
+}
+
+export interface DraftOrderActionAvailability {
+  available: boolean;
+  /** Reasons the action is unavailable, in display order. Empty when available. */
+  reasons: MessageDescriptor[];
+}
+
+export function getDraftOrderConditions(
+  order?: OrderDetailsFragment | null,
+  channelUsabilityData?: ChannelUsabilityDataQuery | null,
+): DraftOrderConditions {
+  const shippingMethodsDeterminable = Boolean(
+    order?.shippingAddress?.country?.code && order?.lines?.length,
+  );
+
+  return {
+    isChannelActive: Boolean(order?.channel?.isActive),
+    hasProductsInChannel: Boolean(channelUsabilityData?.products?.totalCount),
+    shippingMethodsDeterminable,
+    hasShippingMethods: Boolean(order?.shippingMethods?.length),
+  };
+}
+
+export function getDraftOrderActionAvailability(
+  action: DraftOrderActionKey,
+  conditions: DraftOrderConditions,
+): DraftOrderActionAvailability {
+  const reasons: MessageDescriptor[] = [];
+
+  if (!conditions.isChannelActive) {
+    reasons.push(draftOrderActionMessages.inactiveChannel);
+  }
+
+  if (!conditions.hasProductsInChannel) {
+    reasons.push(draftOrderActionMessages.noProductsInChannel);
+  }
+
+  // Shipping methods are only required to finalize, and only when they can be
+  // determined (an order without an address or lines has nothing to ship yet).
+  if (
+    action === "finalize" &&
+    conditions.shippingMethodsDeterminable &&
+    !conditions.hasShippingMethods
+  ) {
+    reasons.push(draftOrderActionMessages.noShippingMethods);
+  }
+
+  return { available: reasons.length === 0, reasons };
+}
