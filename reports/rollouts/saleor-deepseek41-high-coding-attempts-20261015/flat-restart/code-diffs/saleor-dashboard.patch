+import { convertWeight, formatWeight, normalizeWeightRange, WeightValue } from "./weight";
+
+describe("utils/weight", () => {
+  describe("convertWeight", () => {
+    it("returns the weight unchanged when no target unit is given", () => {
+      // Arrange
+      const weight: WeightValue = { unit: "KG", value: 1.5 };
+
+      // Act
+      const result = convertWeight(weight);
+
+      // Assert
+      expect(result).toBe(weight);
+    });
+
+    it("does not alter a value displayed in its own unit", () => {
+      // Arrange
+      const weight: WeightValue = { unit: "KG", value: 2.5 };
+
+      // Act / Assert
+      expect(convertWeight(weight, "KG")).toBe(weight);
+    });
+
+    it("converts within the metric system", () => {
+      // Act / Assert
+      expect(convertWeight({ unit: "KG", value: 1 }, "G")).toEqual({ unit: "G", value: 1000 });
+      expect(convertWeight({ unit: "G", value: 1000 }, "KG")).toEqual({ unit: "KG", value: 1 });
+      expect(convertWeight({ unit: "TONNE", value: 1 }, "KG")).toEqual({ unit: "KG", value: 1000 });
+    });
+
+    it("converts between metric and imperial units using real unit definitions", () => {
+      // Act
+      const pounds = convertWeight({ unit: "KG", value: 1 }, "LB");
+      const ounces = convertWeight({ unit: "LB", value: 1 }, "OZ");
+
+      // Assert
+      expect(pounds.unit).toBe("LB");
+      expect(pounds.value).toBeCloseTo(2.204623, 5);
+      expect(ounces.unit).toBe("OZ");
+      expect(ounces.value).toBeCloseTo(16, 5);
+    });
+
+    it("leaves unknown units untouched instead of inventing a conversion", () => {
+      // Arrange
+      const weight: WeightValue = { unit: "STONE", value: 3 };
+
+      // Act / Assert
+      expect(convertWeight(weight, "KG")).toBe(weight);
+      expect(convertWeight({ unit: "KG", value: 3 }, "STONE")).toEqual({ unit: "KG", value: 3 });
+    });
+  });
+
+  describe("normalizeWeightRange", () => {
+    it("converts both ends to a single unit so a range is never mixed", () => {
+      // Act
+      const range = normalizeWeightRange({ unit: "KG", value: 1 }, { unit: "G", value: 2500 });
+
+      // Assert
+      expect(range.unit).toBe("KG");
+      expect(range.from).toEqual({ unit: "KG", value: 1 });
+      expect(range.to).toEqual({ unit: "KG", value: 2.5 });
+    });
+
+    it("falls back to the `to` unit when there is no lower bound", () => {
+      // Act
+      const range = normalizeWeightRange(undefined, { unit: "G", value: 500 });
+
+      // Assert
+      expect(range.unit).toBe("G");
+      expect(range.from).toBeUndefined();
+      expect(range.to).toEqual({ unit: "G", value: 500 });
+    });
+  });
+
+  describe("formatWeight", () => {
+    it("formats value and unit, converting when a target is provided", () => {
+      // Act / Assert
+      expect(formatWeight({ unit: "KG", value: 1 })).toBe("1 KG");
+      expect(formatWeight({ unit: "KG", value: 1 }, "G")).toBe("1000 G");
+    });
+  });
+});
