@@ -0,0 +1,94 @@
+import { DashboardCard } from "@dashboard/components/Card";
+import { OrderDetailsFragment } from "@dashboard/graphql";
+import { Box, Text } from "@saleor/macaw-ui-next";
+import { FormattedMessage } from "react-intl";
+
+type MetadataSnapshot = OrderDetailsFragment["shippingMethodMetadata"];
+
+interface OrderShippingMethodMetadataProps {
+  /** Public metadata snapshot captured when the order was created. */
+  metadata: MetadataSnapshot;
+  /**
+   * Private metadata snapshot captured when the order was created.
+   * The server only returns it to staff with the required permissions.
+   */
+  privateMetadata: MetadataSnapshot;
+}
+
+const MetadataSnapshotList = ({ items }: { items: MetadataSnapshot }) => {
+  if (items.length === 0) {
+    return (
+      <Text size={2} color="default2" data-test-id="shipping-method-metadata-empty">
+        <FormattedMessage
+          defaultMessage="No data"
+          id="orderShippingMetadataEmpty"
+          description="empty delivery method metadata snapshot"
+        />
+      </Text>
+    );
+  }
+
+  return (
+    <Box display="flex" flexDirection="column" gap={1}>
+      {items.map(item => (
+        <Box key={item.key} display="flex" justifyContent="space-between" gap={4}>
+          <Text size={2} color="default2">
+            {item.key}
+          </Text>
+          <Text size={2} data-test-id="shipping-method-metadata-value">
+            {item.value}
+          </Text>
+        </Box>
+      ))}
+    </Box>
+  );
+};
+
+/**
+ * Read-only snapshot of the delivery method metadata captured when the order was
+ * created. It never reflects later changes to the source delivery method, so the
+ * historical order stays stable even if the shipping method is edited or removed.
+ */
+export const OrderShippingMethodMetadata = ({
+  metadata,
+  privateMetadata,
+}: OrderShippingMethodMetadataProps) => {
+  return (
+    <DashboardCard data-test-id="shipping-method-metadata-snapshot">
+      <DashboardCard.Header>
+        <DashboardCard.Title>
+          <FormattedMessage
+            defaultMessage="Delivery method metadata"
+            id="orderShippingMetadataTitle"
+          />
+        </DashboardCard.Title>
+      </DashboardCard.Header>
+      <DashboardCard.Content>
+        <Box display="flex" flexDirection="column" gap={3}>
+          <Box display="flex" flexDirection="column" gap={1}>
+            <Text size={2} fontWeight="bold">
+              <FormattedMessage
+                defaultMessage="Public metadata"
+                id="orderShippingMetadataPublic"
+              />
+            </Text>
+            <MetadataSnapshotList items={metadata} />
+          </Box>
+          {privateMetadata.length > 0 && (
+            <Box display="flex" flexDirection="column" gap={1} data-test-id="shipping-metadata-private">
+              <Text size={2} fontWeight="bold">
+                <FormattedMessage
+                  defaultMessage="Private metadata"
+                  id="orderShippingMetadataPrivate"
+                />
+              </Text>
+              <MetadataSnapshotList items={privateMetadata} />
+            </Box>
+          )}
+        </Box>
+      </DashboardCard.Content>
+    </DashboardCard>
+  );
+};
+
+export default OrderShippingMethodMetadata;
