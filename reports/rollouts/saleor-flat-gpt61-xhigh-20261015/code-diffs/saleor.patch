+++ b/saleor/graphql/shop/tests/test_password_policy_sprint1.py
@@ -0,0 +1,242 @@
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier
+from types import SimpleNamespace
+
+import pytest
+from django.core.exceptions import ValidationError
+from django.db import close_old_connections
+
+from ....core.jwt import create_access_token, create_refresh_token
+from ....site import PasswordAuthenticationMode
+from ..mutations.shop_settings_update import ShopSettingsUpdate
+
+SHOP_UPDATE = """mutation($input:ShopSettingsInput!){shopSettingsUpdate(input:$input){shop{passwordAuthenticationMode settingsVersion headerText} errors{field code}}}"""
+TOKEN_CREATE = """mutation($email:String!,$password:String!){tokenCreate(email:$email,password:$password){token errors{field code}}}"""
+
+
+def test_sprint1_password_mode_public_and_settings_version_private(api_client):
+    # given / when
+    public = api_client.post_graphql("{shop{passwordAuthenticationMode}}").json()
+    private = api_client.post_graphql("{shop{settingsVersion}}").json()
+
+    # then
+    assert public["data"]["shop"]["passwordAuthenticationMode"] == "ENABLED"
+    assert private.get("errors")
+
+
+@pytest.mark.parametrize(
+    ("input", "error"),
+    [
+        ({"passwordAuthenticationMode": "DISABLED"}, "REQUIRED"),
+        ({"passwordAuthenticationMode": None, "expectedVersion": 0}, "INVALID"),
+        ({"passwordAuthenticationMode": "DISABLED", "expectedVersion": 5}, "CONFLICT"),
+    ],
+)
+def test_sprint1_password_mode_cas_rejects_without_writes(
+    staff_api_client, permission_manage_settings, site_settings, input, error
+):
+    # given
+    before = site_settings.settings_version
+
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_UPDATE, {"input": input}, permissions=[permission_manage_settings]
+    ).json()
+
+    # then
+    assert response["data"]["shopSettingsUpdate"]["errors"][0]["code"] == error
+    site_settings.refresh_from_db()
+    assert site_settings.settings_version == before
+    assert (
+        site_settings.password_authentication_mode == PasswordAuthenticationMode.ENABLED
+    )
+
+
+def test_sprint1_password_mode_cas_and_base_save_revision(
+    staff_api_client, permission_manage_settings, site_settings
+):
+    # given
+    revision = site_settings.settings_version
+    staff_api_client.token = create_access_token(
+        staff_api_client.user, {"auth_method": "external"}
+    )
+
+    # when
+    first = staff_api_client.post_graphql(
+        SHOP_UPDATE,
+        {
+            "input": {
+                "passwordAuthenticationMode": "CUSTOMERS_ONLY",
+                "expectedVersion": revision,
+            }
+        },
+        permissions=[permission_manage_settings],
+    ).json()
+    second = staff_api_client.post_graphql(
+        SHOP_UPDATE, {"input": {"headerText": "Base save"}}
+    ).json()
+
+    # then
+    assert first["data"]["shopSettingsUpdate"]["errors"] == []
+    assert second["data"]["shopSettingsUpdate"]["errors"] == []
+    site_settings.refresh_from_db()
+    assert site_settings.settings_version == revision + 2
+    assert site_settings.policy_generation == 1
+    assert (
+        site_settings.password_authentication_mode
+        == PasswordAuthenticationMode.CUSTOMERS_ONLY
+    )
+
+
+@pytest.mark.parametrize(
+    ("mode", "staff", "expected"),
+    [
+        (PasswordAuthenticationMode.ENABLED, False, None),
+        (PasswordAuthenticationMode.ENABLED, True, None),
+        (PasswordAuthenticationMode.CUSTOMERS_ONLY, False, None),
+        (
+            PasswordAuthenticationMode.CUSTOMERS_ONLY,
+            True,
+            "PASSWORD_AUTHENTICATION_CUSTOMERS_ONLY",
+        ),
+        (
+            PasswordAuthenticationMode.DISABLED,
+            False,
+            "PASSWORD_AUTHENTICATION_DISABLED",
+        ),
+        (PasswordAuthenticationMode.DISABLED, True, "PASSWORD_AUTHENTICATION_DISABLED"),
+    ],
+)
+def test_sprint1_token_create_policy_matrix(
+    api_client, customer_user, site_settings, mode, staff, expected
+):
+    # given
+    password = customer_user._password
+    customer_user.is_staff = staff
+    customer_user.save(update_fields=["is_staff"])
+    site_settings.password_authentication_mode = mode
+    site_settings.save(update_fields=["password_authentication_mode"])
+
+    # when
+    content = api_client.post_graphql(
+        TOKEN_CREATE,
+        {"email": customer_user.email, "password": password},
+    ).json()
+    result = content["data"]["tokenCreate"]
+
+    # then
+    if expected:
+        assert result["token"] is None
+        assert result["errors"][0]["code"] == expected
+    else:
+        assert result["token"]
+        assert result["errors"] == []
+
+
+@pytest.mark.parametrize("mutation", ["tokenVerify", "tokenRefresh"])
+def test_sprint1_password_old_token_rejected_after_disable(
+    api_client, customer_user, site_settings, mutation
+):
+    # given
+    token = (
+        create_access_token(customer_user)
+        if mutation == "tokenVerify"
+        else create_refresh_token(customer_user)
+    )
+    site_settings.password_authentication_mode = PasswordAuthenticationMode.DISABLED
+    site_settings.policy_generation += 1
+    site_settings.save(
+        update_fields=["password_authentication_mode", "policy_generation"]
+    )
+    if mutation == "tokenVerify":
+        query = "mutation($token:String!){tokenVerify(token:$token){isValid errors{code field}}}"
+    else:
+        query = "mutation($token:String!){tokenRefresh(refreshToken:$token){token errors{code field}}}"
+
+    # when
+    result = api_client.post_graphql(query, {"token": token}).json()["data"][mutation]
+
+    # then
+    assert result["errors"][0]["code"] == "PASSWORD_AUTHENTICATION_DISABLED"
+
+
+def test_sprint1_shop_digital_public_fields_removed():
+    # given
+    from ...api import schema
+
+    removed = {
+        "automaticFulfillmentDigitalProducts",
+        "defaultDigitalMaxDownloads",
+        "defaultDigitalUrlValidDays",
+    }
+
+    # when / then
+    for type_name in ("Shop", "ShopSettingsInput"):
+        assert removed.isdisjoint(schema.get_type(type_name).fields)
+
+
+def test_sprint1_base_order_settings_save_advances_channel_versions(
+    staff_api_client, permission_group_manage_orders, channel_USD, channel_PLN
+):
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    revisions = [channel_USD.settings_version, channel_PLN.settings_version]
+    query = """mutation{orderSettingsUpdate(input:{automaticallyConfirmAllNewOrders:false}){errors{code field}}}"""
+
+    # when
+    result = staff_api_client.post_graphql(query).json()["data"]["orderSettingsUpdate"]
+
+    # then
+    assert result["errors"] == []
+    for channel, revision in zip([channel_USD, channel_PLN], revisions, strict=True):
+        channel.refresh_from_db()
+        assert channel.settings_version == revision + 1
+        assert not channel.automatically_confirm_all_new_orders
+
+
+@pytest.mark.django_db(transaction=True)
+def test_sprint1_password_mode_concurrent_cas_has_one_winner(site_settings):
+    # given
+    revision = site_settings.settings_version
+    barrier = Barrier(2)
+
+    def save(mode):
+        close_old_connections()
+        try:
+            barrier.wait(timeout=10)
+            try:
+                ShopSettingsUpdate.perform_mutation(
+                    None,
+                    SimpleNamespace(),
+                    input={
+                        "password_authentication_mode": mode,
+                        "expected_version": revision,
+                    },
+                )
+            except ValidationError as error:
+                return error.error_dict["expected_version"][0].code
+            return "success"
+        finally:
+            close_old_connections()
+
+    # when
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(
+            pool.map(
+                save,
+                [
+                    PasswordAuthenticationMode.CUSTOMERS_ONLY,
+                    PasswordAuthenticationMode.DISABLED,
+                ],
+            )
+        )
+
+    # then
+    assert sorted(results) == ["conflict", "success"]
+    site_settings.refresh_from_db()
+    assert site_settings.settings_version == revision + 1
+    assert site_settings.policy_generation == 1
+    assert site_settings.password_authentication_mode in {
+        PasswordAuthenticationMode.CUSTOMERS_ONLY,
+        PasswordAuthenticationMode.DISABLED,
+    }
