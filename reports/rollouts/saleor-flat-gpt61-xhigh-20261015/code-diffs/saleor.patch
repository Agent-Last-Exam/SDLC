+"""Reservations for the compatibility Payment flow used by order mutations."""
+
+from decimal import Decimal
+
+from django.db import transaction as db_transaction
+
+from ..core.db.connection import allow_writer
+from . import TransactionKind
+from .action_reservations import (
+    ACTIVE_ACTION_STATES,
+    action_identity,
+    clean_idempotency_key,
+    existing_action,
+    failure_transaction,
+    finish_action,
+    input_fingerprint,
+    lock_source,
+    replay_action_error,
+    validate_amount,
+)
+from .models import Payment, PaymentActionRecord
+
+
+def pending_payment_transactions(payment, action):
+    """Ignore old pending facts only when an exact provider token has settled."""
+    transactions = list(payment.transactions.all())
+    pending = []
+    final_kinds = (
+        (TransactionKind.REFUND, TransactionKind.REFUND_FAILED)
+        if action == "refund"
+        else (TransactionKind.CAPTURE, TransactionKind.CAPTURE_FAILED)
+    )
+    for item in transactions:
+        is_pending = item.is_success and (
+            item.kind == TransactionKind.REFUND_ONGOING
+            if action == "refund"
+            else item.kind == TransactionKind.CAPTURE and item.action_required
+        )
+        if not is_pending:
+            continue
+        settled = item.token and any(
+            final.pk > item.pk
+            and final.token == item.token
+            and final.kind in final_kinds
+            and not final.action_required
+            for final in transactions
+        )
+        if not settled:
+            pending.append(item)
+    return pending
+
+
+def reconcile_legacy_payment_actions(payment):
+    """Settle linked callback results without accepting unrelated later money."""
+    transactions = {item.pk: item for item in payment.transactions.all()}
+    for record in payment.action_records.filter(
+        action__in=["capture", "refund"], state__in=ACTIVE_ACTION_STATES
+    ):
+        original = transactions.get(record.result_data.get("legacy_transaction_id"))
+        if not original or not original.token:
+            continue
+        final_kinds = (
+            (TransactionKind.REFUND, TransactionKind.REFUND_FAILED)
+            if record.action == "refund"
+            else (TransactionKind.CAPTURE, TransactionKind.CAPTURE_FAILED)
+        )
+        final = next(
+            (
+                item
+                for item in transactions.values()
+                if item.pk >= original.pk
+                and item.token == original.token
+                and item.kind in final_kinds
+                and not item.action_required
+            ),
+            None,
+        )
+        if final:
+            record.state = (
+                "succeeded"
+                if final.is_success and final.kind == final_kinds[0]
+                else "failed"
+            )
+            record.reserved_amount = 0
+            record.save(update_fields=["state", "reserved_amount", "updated_at"])
+
+
+def available_payment_amount(payment, action):
+    pending = pending_payment_transactions(payment, action)
+    pending_ids = {item.pk for item in pending}
+    occupancy = sum((item.amount for item in pending), Decimal(0))
+    for record in payment.action_records.filter(
+        action=action, state__in=ACTIVE_ACTION_STATES
+    ):
+        if record.result_data.get("legacy_transaction_id") not in pending_ids:
+            occupancy += record.reserved_amount
+    capacity = (
+        payment.captured_amount
+        if action == "refund"
+        else min(payment.get_authorized_amount().amount, payment.get_charge_amount())
+    )
+    return max(capacity - occupancy, Decimal(0))
+
+
+@allow_writer()
+def run_order_payment_action(
+    order, *, action, amount, key=None, user=None, app=None, clean, dispatch, on_success
+):
+    """Commit occupancy before dispatch; never repeat an unknown external result."""
+    key = clean_idempotency_key(key)
+    identity = action_identity(
+        source=order,
+        provider="saleor.legacy-payment",
+        action=action,
+        key=key,
+        user=user,
+        app=app,
+    )
+    fingerprint = input_fingerprint({"amount": amount, "currency": order.currency})
+    with db_transaction.atomic():
+        order = lock_source(order)
+        if record := existing_action(identity, fingerprint):
+            replay_action_error(record)
+            return order
+        validate_amount(amount, order.currency)
+        payment = order.get_last_payment()
+        if payment is not None:
+            payment = Payment.objects.select_for_update().get(pk=payment.pk)
+        payment = clean(payment)
+        reconcile_legacy_payment_actions(payment)
+        requested = validate_amount(
+            amount, order.currency, available_payment_amount(payment, action)
+        )
+        record = PaymentActionRecord.objects.create(
+            **identity,
+            input_hash=fingerprint,
+            payment=payment,
+            requested_amount=requested,
+            reserved_amount=requested,
+            currency=order.currency,
+            state="requested",
+        )
+    try:
+        result = dispatch(order, payment, requested, f"order-payment:{record.pk}")
+    except Exception as error:
+        result = failure_transaction(error)
+        data = {"legacy_transaction_id": result.pk} if result else {}
+        if hasattr(error, "error_dict"):
+            data["errors"] = {
+                field: [
+                    {"message": entry.message, "code": entry.code} for entry in entries
+                ]
+                for field, entries in error.error_dict.items()
+            }
+        finish_action(record, data=data, state="failed" if result else "unknown")
+        raise
+    with db_transaction.atomic():
+        order = lock_source(order)
+        record = PaymentActionRecord.objects.select_for_update().get(pk=record.pk)
+        payment.refresh_from_db()
+        pending = (
+            result.action_required or result.kind == TransactionKind.REFUND_ONGOING
+        )
+        success_kind = (
+            TransactionKind.REFUND if action == "refund" else TransactionKind.CAPTURE
+        )
+        success = result.is_success and not pending and result.kind == success_kind
+        finish_action(
+            record,
+            data={"legacy_transaction_id": result.pk},
+            state="requested" if pending else "succeeded" if success else "failed",
+        )
+        if success:
+            on_success(order, payment, requested)
+    order.refresh_from_db()
+    return order
