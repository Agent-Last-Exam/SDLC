+from uuid import UUID
+
+from django.db import migrations
+from django.db.models import F
+
+
+def retain_origin_and_provider(apps, schema_editor):
+    items = apps.get_model("payment", "TransactionItem").objects.using(
+        schema_editor.connection.alias
+    )
+    items.filter(checkout_id__isnull=False).update(
+        source_checkout_token=F("checkout_id")
+    )
+    items.exclude(app_identifier__isnull=True).update(
+        provider_namespace=F("app_identifier")
+    )
+    for item in (
+        items.filter(source_checkout_token__isnull=True, order_id__isnull=False)
+        .select_related("order")
+        .iterator(chunk_size=500)
+    ):
+        try:
+            token = UUID(item.order.checkout_token)
+        except (ValueError, TypeError, AttributeError):
+            continue
+        items.filter(pk=item.pk).update(source_checkout_token=token)
+
+
+class Migration(migrations.Migration):
+    dependencies = [("payment", "0066_sprint1_giftcard_action_ledger")]
+    operations = [
+        migrations.RunPython(retain_origin_and_provider, migrations.RunPython.noop)
+    ]
