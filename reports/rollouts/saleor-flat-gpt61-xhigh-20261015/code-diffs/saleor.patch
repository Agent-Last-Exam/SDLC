@@ -0,0 +1,472 @@
+"""The built-in gift-card provider. No installed App or plugin is involved."""
+
+from decimal import Decimal
+
+from django.conf import settings
+from django.core.exceptions import ValidationError
+from django.db import transaction as db_transaction
+from django.db.models import DecimalField, ExpressionWrapper, F, Sum
+from django.utils import timezone
+
+from ..channel import TransactionFlowStrategy
+from ..checkout.models import Checkout
+from ..core.db.connection import allow_writer
+from ..core.utils.events import call_event
+from ..giftcard import GiftCardEvents
+from ..giftcard.models import GiftCard, GiftCardEvent, GiftCardTransactionReservation
+from . import (
+    GIFT_CARD_PROVIDER,
+    GiftCardAmountBasis,
+    PaymentAggregationFlow,
+    PaymentMethodType,
+    TransactionAction,
+    TransactionEventType,
+)
+from .action_reservations import (
+    action_identity,
+    available_charge_amount,
+    available_refund_amount,
+    clean_idempotency_key,
+    existing_action,
+    finish_action,
+    get_initialization_amount,
+    input_fingerprint,
+    lock_source,
+    touch_transaction_source,
+    validate_amount,
+)
+from .models import PaymentActionRecord, TransactionEvent, TransactionItem
+from .transaction_item_calculations import recalculate_transaction_amounts
+
+
+def card_balances(card):
+    reserved = card.transaction_reservations.aggregate(
+        value=Sum(
+            ExpressionWrapper(
+                F("authorized_amount") - F("consumed_amount") - F("released_amount"),
+                output_field=DecimalField(),
+            )
+        )
+    )["value"]
+    reserved = reserved or Decimal(0)
+    return max(card.current_balance_amount - reserved, Decimal(0)), reserved
+
+
+def _error(field, message, code):
+    raise ValidationError({field: ValidationError(message, code=code)})
+
+
+def clean_card_data(data):
+    if (
+        not isinstance(data, dict)
+        or set(data) != {"code"}
+        or not isinstance(data["code"], str)
+        or not data["code"].strip()
+    ):
+        _error(
+            "payment_gateway",
+            "Gift-card data must contain only a non-empty code.",
+            "invalid",
+        )
+    return data["code"]
+
+
+def _check_card(card, currency):
+    if not card.is_active:
+        _error("payment_gateway", "Gift card is inactive.", "gift_card_inactive")
+    if card.expiry_date and card.expiry_date < timezone.localdate():
+        _error("payment_gateway", "Gift card has expired.", "gift_card_expired")
+    if card.currency != currency:
+        _error(
+            "payment_gateway",
+            "Gift-card currency does not match.",
+            "gift_card_currency_mismatch",
+        )
+
+
+def _lock_source(source):
+    return lock_source(source)
+
+
+def _event(item, record, event_type, amount, *, user=None, app=None, request=False):
+    reference = f"gift-card:{record.pk}"
+    event = TransactionEvent.objects.create(
+        transaction=item,
+        type=event_type,
+        amount_value=amount,
+        currency=item.currency,
+        include_in_calculations=True,
+        psp_reference=reference,
+        idempotency_key=f"gift-card:{record.pk}:{'request' if request else 'result'}",
+        user=user if user and user.is_authenticated else None,
+        app=app,
+        app_identifier=app.identifier if app else None,
+    )
+    if request:
+        record.request_event = event
+        record.provider_reference = reference
+        record.save(update_fields=["request_event", "provider_reference", "updated_at"])
+    return event
+
+
+def _update_source(item, manager, user=None, app=None, previous=(0, 0, 0)):
+    touch_transaction_source(item)
+    if manager is not None:
+        from .utils import process_order_or_checkout_with_transaction
+
+        process_order_or_checkout_with_transaction(
+            item,
+            manager,
+            user,
+            app,
+            previous_authorized_value=previous[0],
+            previous_charged_value=previous[1],
+            previous_refunded_value=previous[2],
+        )
+
+
+def _record_card_action(card, item, record, amount, manager, user=None, app=None):
+    # An existing target event type keeps the audit query contract unchanged.
+    # New-flow facts are explicitly tagged, never reinterpreted as legacy spend.
+    GiftCardEvent.objects.create(
+        gift_card=card,
+        order_id=item.order_id,
+        user=user if user and user.is_authenticated else None,
+        app=app,
+        type=GiftCardEvents.UPDATED,
+        parameters={
+            "transaction": str(item.token),
+            "action": record.action,
+            "amount": str(amount),
+            "balance": {
+                "currency": card.currency,
+                "current_balance": str(card.current_balance_amount),
+            },
+            "payment_flow": PaymentAggregationFlow.TRANSACTION,
+            "action_record": record.pk,
+        },
+    )
+    if manager is not None:
+        call_event(manager.gift_card_updated, card)
+
+
+def _update_actions(item):
+    actions = []
+    if item.authorized_value > 0:
+        actions.extend([TransactionAction.CHARGE, TransactionAction.CANCEL])
+    if item.charged_value > 0 and item.order_id:
+        actions.append(TransactionAction.REFUND)
+    item.available_actions = actions
+    item.save(update_fields=["available_actions", "modified_at"])
+
+
+@allow_writer()
+def initialize_gift_card(
+    source,
+    data,
+    *,
+    amount=None,
+    action=None,
+    key=None,
+    user=None,
+    app=None,
+    manager=None,
+):
+    code = clean_card_data(data)
+    input_action = action
+    action = action or source.channel.default_transaction_flow_strategy
+    if action not in (
+        TransactionFlowStrategy.AUTHORIZATION,
+        TransactionFlowStrategy.CHARGE,
+    ):
+        _error("action", "Unsupported gift-card action.", "invalid_state")
+    key = clean_idempotency_key(key)
+    fingerprint = input_fingerprint(
+        {
+            "amount": amount,
+            "action": input_action,
+            "currency": source.currency,
+            "data": {"code": code},
+        }
+    )
+    identity = action_identity(
+        source=source,
+        provider=GIFT_CARD_PROVIDER,
+        action="initialize",
+        key=key,
+        user=user,
+        app=app,
+    )
+    with db_transaction.atomic():
+        source = _lock_source(source)
+        if record := existing_action(identity, fingerprint):
+            return record.transaction, record.result_event or record.request_event, None
+        if isinstance(source, Checkout) and source.gift_cards.exists():
+            _error(
+                "id",
+                "Legacy gift-card deduction cannot be mixed with transactions.",
+                "invalid_state",
+            )
+        if source.payments.filter(is_active=True).exists():
+            _error("id", "A legacy payment flow is already active.", "invalid_state")
+        if isinstance(source, Checkout) and source.is_checkout_locked():
+            _error(
+                "id",
+                "Checkout completion is in progress.",
+                "checkout_completion_in_progress",
+            )
+        if source.payment_transactions.count() >= settings.TRANSACTION_ITEMS_LIMIT:
+            _error("id", "Transaction limit reached.", "invalid_state")
+        requested = get_initialization_amount(source, amount)
+        card = GiftCard.objects.select_for_update().filter(code=code).first()
+        if card is None:
+            _error("payment_gateway", "Gift card not found.", "gift_card_not_found")
+        _check_card(card, source.currency)
+        available, _ = card_balances(card)
+        if requested > available:
+            _error(
+                "amount",
+                "Gift card has insufficient available balance.",
+                "gift_card_insufficient_balance",
+            )
+        item = TransactionItem.objects.create(
+            checkout=source if isinstance(source, Checkout) else None,
+            order=None if isinstance(source, Checkout) else source,
+            provider_namespace=GIFT_CARD_PROVIDER,
+            currency=source.currency,
+            name="Gift card",
+            payment_method_name="Gift card",
+            payment_method_type=PaymentMethodType.GIFT_CARD,
+            gift_card_last4=card.display_code,
+            user=user if user and user.is_authenticated else None,
+            # Provider identity must not be an installable App identity.
+            app=None,
+            app_identifier=None,
+        )
+        record = PaymentActionRecord.objects.create(
+            **identity,
+            input_hash=fingerprint,
+            requested_amount=requested,
+            reserved_amount=requested,
+            currency=source.currency,
+            transaction=item,
+        )
+        reservation = GiftCardTransactionReservation.objects.create(
+            transaction=item,
+            gift_card=card,
+            currency=card.currency,
+            authorized_amount=requested,
+        )
+        if action == TransactionFlowStrategy.AUTHORIZATION:
+            request_type = TransactionEventType.AUTHORIZATION_REQUEST
+            success_type = TransactionEventType.AUTHORIZATION_SUCCESS
+        else:
+            request_type = TransactionEventType.CHARGE_REQUEST
+            success_type = TransactionEventType.CHARGE_SUCCESS
+            reservation.consumed_amount = requested
+            reservation.state = "consumed"
+            reservation.save(update_fields=["consumed_amount", "state"])
+            card.current_balance_amount -= requested
+            card.last_used_on = timezone.now()
+            card.save(update_fields=["current_balance_amount", "last_used_on"])
+        _event(item, record, request_type, requested, user=user, app=app, request=True)
+        event = _event(item, record, success_type, requested, user=user, app=app)
+        item.psp_reference = event.psp_reference
+        item.save(update_fields=["psp_reference"])
+        recalculate_transaction_amounts(item)
+        _update_actions(item)
+        fields = []
+        if hasattr(source, "gift_card_amount_basis"):
+            source.gift_card_amount_basis = GiftCardAmountBasis.TRANSACTION_PAYMENT
+            fields.append("gift_card_amount_basis")
+        if hasattr(source, "payment_flow"):
+            source.payment_flow = PaymentAggregationFlow.TRANSACTION
+            fields.append("payment_flow")
+        if fields:
+            source.save(update_fields=fields)
+        finish_action(record, event=event)
+        _record_card_action(card, item, record, requested, manager, user, app)
+        _update_source(item, manager, user, app)
+        return item, event, None
+
+
+@allow_writer()
+def process_gift_card(item, *, data=None, key=None, user=None, app=None):
+    # Initialization is local and synchronous. Continuation returns its immutable
+    # original result, not a second authorization or a newly charged amount.
+    if data is not None and data != {}:
+        _error("data", "Gift-card continuation cannot replace payment data.", "invalid")
+    key = clean_idempotency_key(key)
+    fingerprint = input_fingerprint({"transaction": str(item.token), "data": data})
+    identity = action_identity(
+        transaction=item,
+        provider=GIFT_CARD_PROVIDER,
+        action="process",
+        key=key,
+        user=user,
+        app=app,
+    )
+    with db_transaction.atomic():
+        source = item.checkout if item.checkout_id else item.order
+        if source:
+            source = _lock_source(source)
+        item = TransactionItem.objects.select_for_update().get(pk=item.pk)
+        if record := existing_action(identity, fingerprint):
+            return record.result_event, None
+        initial = item.action_records.filter(action="initialize").first()
+        if not initial or not initial.result_event_id:
+            _error("id", "Gift-card transaction is not initialized.", "invalid_state")
+        record = PaymentActionRecord.objects.create(
+            **identity,
+            input_hash=fingerprint,
+            transaction=item,
+            requested_amount=initial.requested_amount,
+            currency=item.currency,
+        )
+        finish_action(record, event=initial.result_event)
+        return initial.result_event, None
+
+
+@allow_writer()
+def request_gift_card_action(
+    item,
+    action,
+    *,
+    amount=None,
+    key=None,
+    user=None,
+    app=None,
+    manager=None,
+    request_event=None,
+    reason=None,
+    reason_reference=None,
+):
+    key = clean_idempotency_key(key)
+    fingerprint = input_fingerprint(
+        {
+            "transaction": str(item.token),
+            "action": action,
+            "amount": amount,
+            "currency": item.currency,
+            "reason": reason,
+            "reason_reference": reason_reference.pk if reason_reference else None,
+        }
+    )
+    identity = action_identity(
+        transaction=item,
+        provider=GIFT_CARD_PROVIDER,
+        action=action,
+        key=key,
+        user=user,
+        app=app,
+    )
+    with db_transaction.atomic():
+        source = item.checkout if item.checkout_id else item.order
+        if not source:
+            _error("id", "Transaction source is unavailable.", "invalid_state")
+        source = _lock_source(source)
+        item = TransactionItem.objects.select_for_update().get(pk=item.pk)
+        if record := existing_action(identity, fingerprint):
+            return item, record.result_event or record.request_event
+        if (
+            action == TransactionAction.CANCEL
+            and isinstance(source, Checkout)
+            and source.is_checkout_locked()
+        ):
+            _error(
+                "id",
+                "Checkout completion is in progress.",
+                "invalid_state",
+            )
+        reservation = GiftCardTransactionReservation.objects.filter(
+            transaction=item
+        ).first()
+        if not reservation or item.is_legacy_gift_card:
+            _error("id", "Gift-card reservation is unavailable.", "invalid_state")
+        card = GiftCard.objects.select_for_update().get(pk=reservation.gift_card_id)
+        reservation = GiftCardTransactionReservation.objects.select_for_update().get(
+            pk=reservation.pk
+        )
+        if action == TransactionAction.REFUND:
+            if not item.order_id:
+                _error(
+                    "action_type",
+                    "Only charged orders can be refunded.",
+                    "invalid_state",
+                )
+            available = available_refund_amount(item)
+            request_type, success_type = (
+                TransactionEventType.REFUND_REQUEST,
+                TransactionEventType.REFUND_SUCCESS,
+            )
+        elif action in (TransactionAction.CHARGE, TransactionAction.CANCEL):
+            available = min(available_charge_amount(item), reservation.remaining_amount)
+            if action == TransactionAction.CHARGE:
+                _check_card(card, item.currency)
+                request_type, success_type = (
+                    TransactionEventType.CHARGE_REQUEST,
+                    TransactionEventType.CHARGE_SUCCESS,
+                )
+            else:
+                request_type, success_type = (
+                    TransactionEventType.CANCEL_REQUEST,
+                    TransactionEventType.CANCEL_SUCCESS,
+                )
+        else:
+            _error("action_type", "Unsupported action.", "invalid_state")
+        requested = validate_amount(amount, item.currency, available)
+        record = PaymentActionRecord.objects.create(
+            **identity,
+            input_hash=fingerprint,
+            transaction=item,
+            requested_amount=requested,
+            reserved_amount=requested,
+            currency=item.currency,
+        )
+        previous = (item.authorized_value, item.charged_value, item.refunded_value)
+        if request_event is None:
+            request_event = _event(
+                item, record, request_type, requested, user=user, app=app, request=True
+            )
+        else:
+            request_event.psp_reference = f"gift-card:{record.pk}"
+            request_event.include_in_calculations = True
+            request_event.save(
+                update_fields=["psp_reference", "include_in_calculations"]
+            )
+            record.request_event = request_event
+            record.save(update_fields=["request_event"])
+        if action == TransactionAction.REFUND:
+            card.current_balance_amount += requested
+            reservation.refunded_amount += requested
+        elif action == TransactionAction.CHARGE:
+            if requested > card.current_balance_amount:
+                _error(
+                    "amount",
+                    "Gift-card balance is insufficient.",
+                    "gift_card_insufficient_balance",
+                )
+            card.current_balance_amount -= requested
+            reservation.consumed_amount += requested
+        else:
+            reservation.released_amount += requested
+        reservation.state = (
+            "active"
+            if reservation.remaining_amount
+            else (
+                "released"
+                if reservation.released_amount == reservation.authorized_amount
+                else "consumed"
+            )
+        )
+        reservation.save()
+        if action != TransactionAction.CANCEL:
+            card.last_used_on = timezone.now()
+            card.save(update_fields=["current_balance_amount", "last_used_on"])
+        event = _event(item, record, success_type, requested, user=user, app=app)
+        recalculate_transaction_amounts(item)
+        _update_actions(item)
+        finish_action(record, event=event)
+        _record_card_action(card, item, record, requested, manager, user, app)
+        _update_source(item, manager, user, app, previous)
+        return item, event
