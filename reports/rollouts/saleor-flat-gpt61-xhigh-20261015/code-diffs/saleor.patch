@@ -0,0 +1,148 @@
+from concurrent.futures import ThreadPoolExecutor
+from decimal import Decimal
+from threading import Event
+
+import graphene
+import pytest
+from django.core.exceptions import ValidationError
+from django.db import close_old_connections
+from django.db import transaction as db_transaction
+
+from ...checkout.models import Checkout
+from ...giftcard.models import GiftCardTransactionReservation
+from ...payment.models import TransactionItem
+from ..models import User
+from ..utils import remove_staff_member
+
+
+@pytest.mark.parametrize("email", [None, "snapshot@example.com"])
+def test_sprint1_staff_true_delete_preserves_order_and_funded_checkout(
+    staff_user, order, checkout, gift_card, email
+):
+    # given
+    staff_id = staff_user.pk
+    staff_email = staff_user.email
+    order.user = staff_user
+    order.user_email = staff_email
+    order.save(update_fields=["user", "user_email"])
+    checkout.user = staff_user
+    checkout.email = email
+    checkout.save(update_fields=["user", "email"])
+    transaction = TransactionItem.objects.create(
+        checkout=checkout, currency=checkout.currency, authorized_value=Decimal(10)
+    )
+    reservation = GiftCardTransactionReservation.objects.create(
+        transaction=transaction,
+        gift_card=gift_card,
+        currency=checkout.currency,
+        authorized_amount=Decimal(10),
+    )
+    checkout_id = checkout.pk
+
+    # when
+    remove_staff_member(staff_user)
+
+    # then
+    assert not User.objects.filter(pk=staff_id).exists()
+    order.refresh_from_db()
+    assert order.user_id is None
+    assert order.user_email == staff_email
+    checkout = Checkout.objects.get(pk=checkout_id)
+    assert checkout.user_id is None
+    assert checkout.email == (email or staff_email)
+    transaction.refresh_from_db()
+    reservation.refresh_from_db()
+    assert transaction.checkout_id == checkout_id
+    assert transaction.authorized_value == Decimal(10)
+    assert reservation.remaining_amount == Decimal(10)
+    assert reservation.state == "active"
+
+
+@pytest.mark.parametrize("bulk", [False, True])
+def test_sprint1_staff_delete_mutations_preserve_checkout_and_order(
+    superuser_api_client, staff_user, checkout, order, bulk
+):
+    # given
+    staff_id = staff_user.pk
+    checkout.user = staff_user
+    checkout.save(update_fields=["user"])
+    order.user = staff_user
+    order.save(update_fields=["user"])
+    global_id = graphene.Node.to_global_id("User", staff_id)
+    if bulk:
+        query = (
+            "mutation($ids:[ID!]!){staffBulkDelete(ids:$ids){count errors{code field}}}"
+        )
+        variables = {"ids": [global_id]}
+        name = "staffBulkDelete"
+    else:
+        query = "mutation($id:ID!){staffDelete(id:$id){user{id} errors{code field}}}"
+        variables = {"id": global_id}
+        name = "staffDelete"
+
+    # when
+    response = superuser_api_client.post_graphql(query, variables)
+    content = response.json()
+
+    # then
+    assert "errors" not in content
+    assert content["data"][name]["errors"] == []
+    assert not User.objects.filter(pk=staff_id).exists()
+    checkout.refresh_from_db()
+    order.refresh_from_db()
+    assert checkout.user_id is None
+    assert order.user_id is None
+
+
+@pytest.mark.django_db(transaction=True)
+def test_sprint1_staff_delete_rejects_busy_checkout_then_safely_retries(
+    staff_user, checkout, order
+):
+    # given
+    staff_id = staff_user.pk
+    checkout.user = staff_user
+    checkout.save(update_fields=["user"])
+    order.user = staff_user
+    order.save(update_fields=["user"])
+    financial_context = TransactionItem.objects.create(
+        checkout=checkout, currency=checkout.currency, authorized_value=Decimal(10)
+    )
+    acquired = Event()
+    release = Event()
+
+    def complete_in_flight():
+        close_old_connections()
+        try:
+            with db_transaction.atomic():
+                Checkout.objects.select_for_update().get(pk=checkout.pk)
+                acquired.set()
+                assert release.wait(timeout=15)
+        finally:
+            close_old_connections()
+
+    # when
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        future = pool.submit(complete_in_flight)
+        assert acquired.wait(timeout=15)
+        try:
+            with pytest.raises(ValidationError) as error:
+                remove_staff_member(staff_user)
+            assert error.value.code == "invalid"
+            assert User.objects.filter(pk=staff_id).exists()
+            checkout.refresh_from_db()
+            assert checkout.user_id == staff_id
+            assert TransactionItem.objects.filter(pk=financial_context.pk).exists()
+        finally:
+            release.set()
+        future.result(timeout=15)
+    remove_staff_member(staff_user)
+
+    # then
+    assert not User.objects.filter(pk=staff_id).exists()
+    checkout.refresh_from_db()
+    order.refresh_from_db()
+    financial_context.refresh_from_db()
