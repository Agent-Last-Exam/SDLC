@@ -0,0 +1,204 @@
+import jwt
+import pytest
+
+from ...core.jwt import (
+    JWT_ACCESS_TYPE,
+    JWT_SALEOR_OWNER_NAME,
+    create_access_token,
+    get_user_from_payload,
+    jwt_decode,
+    jwt_user_payload,
+)
+from ...site import PasswordAuthenticationMode
+from ..authentication import (
+    PasswordAuthenticationError,
+    ensure_password_authentication_allowed,
+)
+
+
+@pytest.mark.parametrize(
+    ("mode", "is_staff", "expected"),
+    [
+        (PasswordAuthenticationMode.ENABLED, False, None),
+        (PasswordAuthenticationMode.ENABLED, True, None),
+        (PasswordAuthenticationMode.CUSTOMERS_ONLY, False, None),
+        (
+            PasswordAuthenticationMode.CUSTOMERS_ONLY,
+            True,
+            "password_authentication_customers_only",
+        ),
+        (
+            PasswordAuthenticationMode.DISABLED,
+            False,
+            "password_authentication_disabled",
+        ),
+        (PasswordAuthenticationMode.DISABLED, True, "password_authentication_disabled"),
+    ],
+)
+def test_sprint1_password_policy_mode_matrix(
+    site_settings, customer_user, mode, is_staff, expected
+):
+    # given
+    site_settings.password_authentication_mode = mode
+    site_settings.save(update_fields=["password_authentication_mode"])
+    customer_user.is_staff = is_staff
+
+    # when / then
+    if expected:
+        with pytest.raises(PasswordAuthenticationError) as error:
+            ensure_password_authentication_allowed(customer_user)
+        assert error.value.code == expected
+    else:
+        assert (
+            ensure_password_authentication_allowed(customer_user).pk == site_settings.pk
+        )
+
+
+def test_sprint1_external_association_never_reopens_password(customer_user):
+    # given
+    customer_user.external_authentication_required = True
+
+    # when / then
+    with pytest.raises(PasswordAuthenticationError) as error:
+        ensure_password_authentication_allowed(customer_user)
+    assert error.value.code == "external_authentication_required"
+
+
+def test_sprint1_password_tokens_record_provenance_and_generations(
+    site_settings, customer_user
+):
+    # given
+    site_settings.policy_generation = 4
+    site_settings.save(update_fields=["policy_generation"])
+    customer_user.password_token_generation = 3
+    customer_user.save(update_fields=["password_token_generation"])
+
+    # when
+    payload = jwt_decode(create_access_token(customer_user))
+
+    # then
+    assert payload["auth_method"] == "password"
+    assert payload["policy_generation"] == 4
+    assert payload["password_token_generation"] == 3
+    assert get_user_from_payload(payload).pk == customer_user.pk
+
+
+@pytest.mark.parametrize("legacy", [True, False])
+def test_sprint1_old_password_tokens_fail_after_policy_generation(
+    site_settings, customer_user, legacy
+):
+    # given
+    payload = jwt_decode(create_access_token(customer_user))
+    if legacy:
+        for field in ("auth_method", "policy_generation", "password_token_generation"):
+            payload.pop(field)
+    site_settings.policy_generation += 1
+    site_settings.save(update_fields=["policy_generation"])
+
+    # when / then
+    with pytest.raises(jwt.InvalidTokenError):
+        get_user_from_payload(payload)
+
+
+def test_sprint1_old_password_token_fails_after_password_change(customer_user):
+    # given
+    payload = jwt_decode(create_access_token(customer_user))
+    customer_user.password_token_generation += 1
+    customer_user.save(update_fields=["password_token_generation"])
+
+    # when / then
+    with pytest.raises(jwt.InvalidTokenError):
+        get_user_from_payload(payload)
+
+
+def test_sprint1_customer_only_rejects_old_staff_capability_claims(
+    site_settings, customer_user
+):
+    # given
+    site_settings.password_authentication_mode = (
+        PasswordAuthenticationMode.CUSTOMERS_ONLY
+    )
+    site_settings.save(update_fields=["password_authentication_mode"])
+    payload = jwt_decode(create_access_token(customer_user))
+    payload["is_staff"] = True
+
+    # when / then
+    with pytest.raises(PasswordAuthenticationError) as error:
+        get_user_from_payload(payload)
+    assert error.value.code == "password_authentication_customers_only"
+
+
+def test_sprint1_external_tokens_independent_of_password_mode(
+    site_settings, customer_user
+):
+    # given
+    payload = jwt_user_payload(
+        customer_user, JWT_ACCESS_TYPE, None, token_owner="external.provider"
+    )
+    site_settings.password_authentication_mode = PasswordAuthenticationMode.DISABLED
+    site_settings.policy_generation += 1
+    site_settings.save(
+        update_fields=["password_authentication_mode", "policy_generation"]
+    )
+
+    # when
+    user = get_user_from_payload(payload)
+
+    # then
+    assert payload["auth_method"] == "external"
+    assert payload["owner"] != JWT_SALEOR_OWNER_NAME
+    assert user.pk == customer_user.pk
+
+
+def test_sprint1_external_user_id_survives_verified_email_change(customer_user):
+    # given
+    payload = jwt_user_payload(
+        customer_user, JWT_ACCESS_TYPE, None, token_owner="external.provider"
+    )
+    customer_user.email = "new-verified@example.com"
+    customer_user.save(update_fields=["email"])
+
+    # when
+    user = get_user_from_payload(payload)
+
+    # then
+    assert user.pk == customer_user.pk
+    assert user.email == "new-verified@example.com"
+
+
+@pytest.mark.parametrize("owner", [None, "saleor", "external.provider"])
+def test_sprint1_legacy_token_source_comes_from_signed_owner(
+    customer_user, site_settings, owner
+):
+    # given
+    payload = jwt_decode(create_access_token(customer_user))
+    for field in ("auth_method", "policy_generation", "password_token_generation"):
+        payload.pop(field)
+    payload["owner"] = owner
+    site_settings.password_authentication_mode = PasswordAuthenticationMode.DISABLED
+    site_settings.save(update_fields=["password_authentication_mode"])
+
+    # when / then
+    if owner == "external.provider":
+        assert get_user_from_payload(payload)._auth_method == "external"
+    else:
+        with pytest.raises(PasswordAuthenticationError):
+            get_user_from_payload(payload)
+
+
+def test_sprint1_deriving_token_does_not_upgrade_validated_generation(
+    customer_user, site_settings
+):
+    # given
+    old_payload = jwt_decode(create_access_token(customer_user))
+    authenticated = get_user_from_payload(old_payload)
+    site_settings.policy_generation += 1
+    site_settings.save(update_fields=["policy_generation"])
+
+    # when
+    derived = jwt_decode(create_access_token(authenticated))
+
+    # then
+    assert derived["policy_generation"] == old_payload["policy_generation"]
+    with pytest.raises(jwt.InvalidTokenError):
+        get_user_from_payload(derived)
diff --git a/saleor/account/tests/test_staff_delete_sprint1.py b/saleor/account/tests/test_staff_delete_sprint1.py
