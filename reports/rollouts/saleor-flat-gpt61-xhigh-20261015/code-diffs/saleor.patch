@@ -0,0 +1,92 @@
+"""Add audit-only historical card transactions without changing financial state."""
+
+import logging
+from decimal import Decimal, InvalidOperation
+from uuid import UUID
+
+from django.db import migrations
+
+logger = logging.getLogger(__name__)
+
+
+def map_historical_gift_cards(apps, schema_editor):
+    alias = schema_editor.connection.alias
+    events = apps.get_model("giftcard", "GiftCardEvent").objects.using(alias)
+    mappings = apps.get_model("giftcard", "GiftCardLegacyTransaction").objects.using(
+        alias
+    )
+    items = apps.get_model("payment", "TransactionItem").objects.using(alias)
+    transaction_events = apps.get_model("payment", "TransactionEvent").objects.using(
+        alias
+    )
+    skipped = 0
+    for event in (
+        events.filter(type="used_in_order", order_id__isnull=False)
+        .select_related("order", "gift_card")
+        .order_by("pk")
+        .iterator(chunk_size=500)
+    ):
+        if mappings.filter(source_event_id=event.pk).exists():
+            continue
+        parameters = event.parameters
+        balance = parameters.get("balance", {}) if isinstance(parameters, dict) else {}
+        try:
+            amount = Decimal(str(balance["old_current_balance"])) - Decimal(
+                str(balance["current_balance"])
+            )
+            if (
+                not amount.is_finite()
+                or amount <= 0
+                or balance.get("currency") != event.order.currency
+            ):
+                raise ValueError
+        except (KeyError, TypeError, ValueError, InvalidOperation):
+            skipped += 1
+            continue
+        try:
+            source_token = UUID(event.order.checkout_token)
+        except (ValueError, TypeError, AttributeError):
+            source_token = None
+        reference = f"legacy-gift-card:{event.pk}"
+        item = items.create(
+            order_id=event.order_id,
+            source_checkout_token=source_token,
+            provider_namespace="saleor.gift-card",
+            is_legacy_gift_card=True,
+            currency=event.order.currency,
+            name="Gift card",
+            payment_method_name="Gift card",
+            payment_method_type="gift_card",
+            gift_card_last4=event.gift_card.code[-4:],
+            charged_value=amount,
+            psp_reference=reference,
+            available_actions=[],
+        )
+        items.filter(pk=item.pk).update(created_at=event.date, modified_at=event.date)
+        transaction_events.create(
+            transaction_id=item.pk,
+            created_at=event.date,
+            type="charge_success",
+            amount_value=amount,
+            currency=item.currency,
+            psp_reference=reference,
+            idempotency_key=reference,
+            include_in_calculations=True,
+            message="Historical gift-card deduction; already included in the order total.",
+        )
+        mappings.create(source_event_id=event.pk, transaction_id=item.pk)
+    if skipped:
+        logger.warning(
+            "Skipped %s historical gift-card events without reliable monetary evidence",
+            skipped,
+        )
+
+
+class Migration(migrations.Migration):
+    dependencies = [
+        ("giftcard", "0023_sprint1_giftcard_action_ledger"),
+        ("payment", "0067_sprint1_retained_transaction_origin"),
+    ]
+    operations = [
+        migrations.RunPython(map_historical_gift_cards, migrations.RunPython.noop)
+    ]
