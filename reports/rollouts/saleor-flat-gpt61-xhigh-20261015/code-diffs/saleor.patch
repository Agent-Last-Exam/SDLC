+@pytest.mark.parametrize("entry_point", ["set", "set_with_session", "change"])
+def test_sprint1_successful_password_write_revokes_all_prior_local_tokens(
+    api_client, customer_user, entry_point
+):
+    # given
+    old_password = customer_user._password
+    old_access = create_access_token(customer_user)
+    old_refresh = create_refresh_token(customer_user)
+    if entry_point.startswith("set"):
+        if entry_point == "set_with_session":
+            api_client.token = old_access
+        query = SET
+        variables = {
+            "email": customer_user.email,
+            "token": token_generator.make_token(customer_user),
+        }
+        mutation = "setPassword"
+    else:
+        api_client.token = old_access
+        query = CHANGE
+        variables = {"old": old_password}
+        mutation = "passwordChange"
+
+    # when
+    result = api_client.post_graphql(query, variables).json()["data"][mutation]
+    # Exercise verify/refresh's argument guards, not the independently revoked
+    # Authorization header retained by an authenticated client.
+    api_client.token = None
+    verified = api_client.post_graphql(
+        "mutation($token:String!){tokenVerify(token:$token){isValid errors{code}}}",
+        {"token": old_access},
+    ).json()["data"]["tokenVerify"]
+    refreshed = api_client.post_graphql(
+        "mutation($token:String!){tokenRefresh(refreshToken:$token){token errors{code}}}",
+        {"token": old_refresh},
+    ).json()["data"]["tokenRefresh"]
+
+    # then
+    assert result["errors"] == []
+    customer_user.refresh_from_db()
+    assert customer_user.password_token_generation == 1
+    assert customer_user.check_password("new-safe-password-123")
+    assert not verified["isValid"]
+    assert verified["errors"][0]["code"] == "JWT_INVALID_TOKEN"
+    assert refreshed["token"] is None
+    assert refreshed["errors"][0]["code"] == "JWT_INVALID_TOKEN"
+    if entry_point.startswith("set"):
+        assert jwt_decode(result["token"])["password_token_generation"] == 1
+
