+"""Fresh, side-effect-free delivery calculation followed by short revision CAS writes."""
+
+from dataclasses import dataclass
+from decimal import Decimal
+
+import graphene
+from django.core.exceptions import ValidationError
+from django.db import transaction
+from django.utils import timezone
+
+from ..channel.models import Channel
+from ..shipping.interface import ShippingMethodData
+from ..warehouse.models import Warehouse
+from .actions import call_checkout_info_event
+from .error_codes import CheckoutErrorCode
+from .fetch import fetch_checkout_info, fetch_checkout_lines
+from .models import Checkout
+from .utils import (
+    assign_built_in_shipping_to_checkout,
+    assign_collection_point_to_checkout,
+    assign_external_shipping_to_checkout,
+    get_external_shipping_id,
+    get_valid_collection_points_for_checkout,
+    is_shipping_required,
+    remove_delivery_method_from_checkout,
+)
+
+
+@dataclass
+class DeliveryCalculation:
+    checkout: Checkout
+    checkout_info: object
+    lines: list
+    version: int
+    settings_version: int
+    shipping_methods: list
+    collection_points: list
+    delivery_method: object = None
+    selection_status: str = "NONE"
+    selection_error: ValidationError | None = None
+
+
+def delivery_error(code, message, field="delivery_method_id"):
+    return ValidationError({field: ValidationError(message, code=code.value)})
+
+
+def _normalize_external_id(value):
+    from ..webhook.transport.shipping_helpers import convert_to_app_id_with_identifier
+
+    try:
+        return convert_to_app_id_with_identifier(value) or value
+    except (ValueError, TypeError, UnicodeError):
+        raise delivery_error(
+            CheckoutErrorCode.INVALID, "Invalid delivery method identifier."
+        ) from None
+
+
+def _selection_key(checkout):
+    if checkout.shipping_method_id:
+        return graphene.Node.to_global_id("ShippingMethod", checkout.shipping_method_id)
+    external_id = get_external_shipping_id(checkout)
+    if external_id:
+        return _normalize_external_id(external_id)
+    if checkout.collection_point_id:
+        return graphene.Node.to_global_id("Warehouse", checkout.collection_point_id)
+    return None
+
+
+def _method_key(method):
+    if isinstance(method, Warehouse):
+        return graphene.Node.to_global_id("Warehouse", method.pk)
+    return method.graphql_id
+
+
+def calculate_delivery_options(
+    checkout, manager, *, expected_version=None, pickup_id=None, clear=False
+):
+    """Never save prices, clear selection, or use a previous external result here."""
+    fresh = Checkout.objects.select_related(
+        "channel__tax_configuration",
+        "billing_address",
+        "shipping_address",
+        "shipping_method",
+        "collection_point__address",
+        "user",
+    ).get(pk=checkout.pk)
+    if expected_version is not None and expected_version != fresh.version:
+        raise delivery_error(
+            CheckoutErrorCode.CONFLICT,
+            "Checkout has changed. Reload before retrying.",
+            "expected_version",
+        )
+    version = fresh.version
+    fresh._strict_shipping = True
+    fresh._staged_delivery = True
+    if clear:
+        lines, _ = fetch_checkout_lines(fresh)
+        info = fetch_checkout_info(fresh, lines, manager)
+        return DeliveryCalculation(
+            fresh, info, lines, version, fresh.channel.settings_version, [], []
+        )
+    fresh._strict_shipping = True
+    fresh._staged_delivery = True
+    lines, unavailable = fetch_checkout_lines(fresh)
+    if unavailable and fresh.channel.use_legacy_error_flow_for_checkout:
+        raise delivery_error(
+            CheckoutErrorCode.UNAVAILABLE_VARIANT_IN_CHANNEL,
+            "Some checkout variants are unavailable.",
+            "lines",
+        )
+    info = fetch_checkout_info(fresh, lines, manager)
+    result = DeliveryCalculation(
+        fresh, info, lines, version, fresh.channel.settings_version, [], []
+    )
+    if not is_shipping_required(lines):
+        result.selection_status = "NOT_REQUIRED"
+        return result
+    # Pickup can be selected without a pre-existing customer shipping address.
+    if pickup_id:
+        pickup = (
+            Warehouse.objects.for_channel(fresh.channel_id)
+            .filter(pk=pickup_id)
+            .select_related("address")
+            .first()
+        )
+        if not pickup:
+            raise delivery_error(
+                CheckoutErrorCode.DELIVERY_METHOD_NOT_APPLICABLE,
+                "This pickup point is not applicable.",
+            )
+        info.shipping_address = pickup.address
+        fresh.shipping_address = pickup.address
+    address = info.shipping_address
+    if address is None:
+        raise delivery_error(
+            CheckoutErrorCode.SHIPPING_ADDRESS_NOT_SET,
+            "Shipping address is not set.",
+            "shipping_address",
+        )
+    if not address.country or not address.city or not address.street_address_1:
+        raise delivery_error(
+            CheckoutErrorCode.MISSING_ADDRESS_DATA,
+            "Shipping address is incomplete.",
+            "shipping_address",
+        )
+    try:
+        methods = info.get_all_shipping_methods()
+        keys = set()
+        for method in methods:
+            if (
+                not isinstance(method, ShippingMethodData)
+                or not method.id
+                or method.price.currency != fresh.currency
+                or not isinstance(method.price.amount, Decimal)
+                or not method.price.amount.is_finite()
+                or method.price.amount < 0
+                or _method_key(method) in keys
+            ):
+                raise ValueError("Invalid shipping service result")
+            keys.add(_method_key(method))
+    except Exception as exc:
+        from ..webhook.transport.shipping import ShippingServiceError
+
+        if not isinstance(
+            exc, ShippingServiceError | ValueError | TypeError | AttributeError
+        ):
+            raise
+        raise delivery_error(
+            CheckoutErrorCode.SHIPPING_SERVICE_ERROR,
+            "The shipping service could not calculate delivery options.",
+            "shipping_methods",
+        ) from exc
+    points = list(
+        get_valid_collection_points_for_checkout(
+            lines, fresh.channel_id, quantity_check=True
+        )
+    )
+    result.shipping_methods, result.collection_points = methods, points
+    key = _selection_key(fresh)
+    if key is None:
+        return result
+    selected = next(
+        (item for item in methods + points if _method_key(item) == key), None
+    )
+    if selected is None:
+        result.selection_status = "INVALID"
+        result.selection_error = delivery_error(
+            CheckoutErrorCode.DELIVERY_METHOD_NOT_APPLICABLE,
+            "The previous delivery method is no longer applicable.",
+        )
+    elif isinstance(selected, ShippingMethodData) and not selected.active:
+        result.selection_status = "INVALID"
+        result.selection_error = delivery_error(
+            CheckoutErrorCode.DELIVERY_METHOD_UNAVAILABLE,
+            "The previous delivery method is unavailable.",
+        )
+    else:
+        result.selection_status = "VALID"
+        result.delivery_method = selected
+    return result
+
+
+def resolve_delivery_selection(calculation, delivery_method_id):
+    if delivery_method_id is None:
+        return None
+    delivery_method_id = _normalize_external_id(delivery_method_id)
+    selected = next(
+        (
+            method
+            for method in calculation.shipping_methods + calculation.collection_points
+            if _method_key(method) == delivery_method_id
+        ),
+        None,
+    )
+    if selected is None:
+        raise delivery_error(
+            CheckoutErrorCode.DELIVERY_METHOD_NOT_APPLICABLE,
+            "This delivery method is not applicable to the current checkout.",
+        )
+    if isinstance(selected, ShippingMethodData) and not selected.active:
+        raise delivery_error(
+            CheckoutErrorCode.DELIVERY_METHOD_UNAVAILABLE,
+            "This delivery method is unavailable.",
+        )
+    return selected
+
+
+def install_delivery_calculation(checkout_info, calculation):
+    """Pass already fresh methods through final pricing without another external call."""
+    checkout_info._cached_built_in_shipping_methods = [
+        method for method in calculation.shipping_methods if not method.is_external
+    ]
+    checkout_info._cached_external_shipping_methods = [
+        method for method in calculation.shipping_methods if method.is_external
+    ]
+    checkout_info.valid_pick_up_points = calculation.collection_points
+    checkout_info._validated_delivery_calculation = calculation
+    # Use the fresh price for this calculation without a denormalization save.
+    checkout_info.checkout._staged_delivery = True
+    if calculation.delivery_method is not None:
+        checkout_info._update_denormalized_shipping_method_fields(
+            calculation.delivery_method
+        )
+
+
+def validate_delivery_selection(checkout_info, manager):
+    calculation = calculate_delivery_options(checkout_info.checkout, manager)
+    if calculation.selection_status == "INVALID":
+        raise calculation.selection_error
+    if calculation.selection_status == "NONE" and is_shipping_required(
+        calculation.lines
+    ):
+        raise delivery_error(
+            CheckoutErrorCode.SHIPPING_METHOD_NOT_SET,
+            "A delivery method is required.",
+            "shipping_method",
+        )
+    install_delivery_calculation(checkout_info, calculation)
+    # Final CAS records the inputs used for fresh service qualification.
+    checkout_info._delivery_calculation = calculation
+    return calculation
+
+
+def save_delivery_calculation(
+    calculation, manager, *, selected=None, update_selection=False, check_access=None
+):
+    """Commit all calculation-dependent fields only if checkout and channel agree."""
+    with transaction.atomic():
+        channel = Channel.objects.select_for_update().get(
+            pk=calculation.checkout.channel_id
+        )
+        checkout = (
+            Checkout.objects.select_for_update(of=("self",))
+            .select_related("shipping_address", "collection_point")
+            .get(pk=calculation.checkout.pk)
+        )
+        if check_access:
+            check_access(checkout)
+        if (
+            checkout.version != calculation.version
+            or channel.settings_version != calculation.settings_version
+        ):
+            raise delivery_error(
+                CheckoutErrorCode.CONFLICT,
+                "Checkout or channel settings changed during calculation.",
+                "expected_version",
+            )
+        if not update_selection:
+            selected = calculation.delivery_method
+        if isinstance(selected, Warehouse):
+            fields = assign_collection_point_to_checkout(checkout, selected)
+        elif isinstance(selected, ShippingMethodData):
+            fields = (
+                assign_external_shipping_to_checkout(checkout, selected)
+                if selected.is_external
+                else assign_built_in_shipping_to_checkout(checkout, selected)
+            )
+        elif update_selection or calculation.selection_status in {
+            "INVALID",
+            "NOT_REQUIRED",
+        }:
+            fields = remove_delivery_method_from_checkout(checkout)
+        else:
+            fields = []
+        if fields:
+            checkout.price_expiration = timezone.now()
+            checkout.save(
+                update_fields=set(fields) | {"price_expiration", "last_change"}
+            )
+            info = calculation.checkout_info
+            info.checkout = checkout
+            info.shipping_address = checkout.shipping_address
+            info.shipping_method = checkout.shipping_method
+            info.collection_point = checkout.collection_point
+            install_delivery_calculation(info, calculation)
+            from ..webhook.event_types import WebhookEventAsyncType
+
+            transaction.on_commit(
+                lambda: call_checkout_info_event(
+                    manager,
+                    event_name=WebhookEventAsyncType.CHECKOUT_UPDATED,
+                    checkout_info=info,
+                    lines=calculation.lines,
+                )
+            )
+        calculation.checkout = checkout
+        if update_selection:
+            calculation.delivery_method = selected
+            calculation.selection_status = "VALID" if selected else "NONE"
+        return checkout
