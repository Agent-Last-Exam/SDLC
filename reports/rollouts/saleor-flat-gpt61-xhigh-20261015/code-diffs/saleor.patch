diff --git a/saleor/account/authentication.py b/saleor/account/authentication.py
new file mode 100644
index 000000000..81fcecd23
--- /dev/null
+++ b/saleor/account/authentication.py
@@ -0,0 +1,103 @@
+from django.conf import settings
+from django.core.exceptions import ValidationError
+
+from ..core.db.connection import allow_writer
+from ..site import PasswordAuthenticationMode
+from ..site.models import SiteSettings
+from .error_codes import AccountErrorCode
+
+AUTH_METHOD_FIELD = "auth_method"
+POLICY_GENERATION_FIELD = "policy_generation"
+PASSWORD_GENERATION_FIELD = "password_token_generation"
+AUTH_METHOD_PASSWORD = "password"
+AUTH_METHOD_EXTERNAL = "external"
+
+
+class PasswordAuthenticationError(ValidationError):
+    """A safe, public password-policy error (never contains an account identifier)."""
+
+
+@allow_writer()
+def get_password_authentication_settings(*, lock=False):
+    # Do not use the Site cache, a request dataloader, or a replica for authentication.
+    queryset = SiteSettings.objects.using(settings.DATABASE_CONNECTION_DEFAULT_NAME)
+    if lock:
+        queryset = queryset.select_for_update()
+    return queryset.get(site_id=settings.SITE_ID)
+
+
+def ensure_password_authentication_allowed(
+    user=None, *, field=None, site_settings=None
+):
+    site_settings = site_settings or get_password_authentication_settings()
+    error = None
+    if (
+        site_settings.password_authentication_mode
+        == PasswordAuthenticationMode.DISABLED
+    ):
+        error = PasswordAuthenticationError(
+            "Password authentication is disabled.",
+            code=AccountErrorCode.PASSWORD_AUTHENTICATION_DISABLED.value,
+        )
+    elif (
+        site_settings.password_authentication_mode
+        == PasswordAuthenticationMode.CUSTOMERS_ONLY
+        and user is not None
+        and user.is_staff
+    ):
+        error = PasswordAuthenticationError(
+            "Password authentication is available to customers only.",
+            code=AccountErrorCode.PASSWORD_AUTHENTICATION_CUSTOMERS_ONLY.value,
+        )
+    elif user is not None and user.external_authentication_required:
+        error = PasswordAuthenticationError(
+            "External authentication is required.",
+            code=AccountErrorCode.EXTERNAL_AUTHENTICATION_REQUIRED.value,
+        )
+    if error:
+        if field:
+            raise PasswordAuthenticationError({field: error})
+        raise error
+    return site_settings
+
+
+def validate_token_authentication(user, payload):
+    """Guard every password-derived session, including unmarked legacy tokens."""
+    import jwt
+
+    method = payload.get(AUTH_METHOD_FIELD)
+    if method is None:
+        # Before provenance was explicit, the signed owner distinguished provider
+        # wrappers from local password tokens. Never classify a local/missing owner
+        # as external merely because the per-account password became unusable.
+        owner = payload.get("owner")
+        method = (
+            AUTH_METHOD_EXTERNAL
+            if owner and owner != "saleor"
+            else AUTH_METHOD_PASSWORD
+        )
+    if method not in (AUTH_METHOD_PASSWORD, AUTH_METHOD_EXTERNAL):
+        raise jwt.InvalidTokenError("Invalid authentication source.")
+    if method == AUTH_METHOD_PASSWORD:
+        site_settings = ensure_password_authentication_allowed(user)
+        # A token with staff capabilities cannot be downgraded to a customer token.
+        if (
+            site_settings.password_authentication_mode
+            == PasswordAuthenticationMode.CUSTOMERS_ONLY
+            and (payload.get("is_staff") or payload.get("permissions"))
+        ):
+            raise PasswordAuthenticationError(
+                "Password authentication is available to customers only.",
+                code=AccountErrorCode.PASSWORD_AUTHENTICATION_CUSTOMERS_ONLY.value,
+            )
+        if (
+            payload.get(POLICY_GENERATION_FIELD, 0) != site_settings.policy_generation
+            or payload.get(PASSWORD_GENERATION_FIELD, 0)
+            != user.password_token_generation
+        ):
+            raise jwt.InvalidTokenError(
+                "Password authentication has changed. Log in again."
+            )
+    user._auth_method = method
+    user._auth_policy_generation = payload.get(POLICY_GENERATION_FIELD, 0)
+    user._auth_password_generation = payload.get(PASSWORD_GENERATION_FIELD, 0)
