+import graphene
+
+from ...payment import GiftCardAmountBasis, PaymentAggregationFlow
+from ..core.types import BaseObjectType, Money, TaxedMoney
+
+GiftCardAmountBasisEnum = graphene.Enum(
+    "GiftCardAmountBasisEnum",
+    {
+        "LEGACY_TOTAL_DEDUCTION": GiftCardAmountBasis.LEGACY_TOTAL_DEDUCTION,
+        "TRANSACTION_PAYMENT": GiftCardAmountBasis.TRANSACTION_PAYMENT,
+    },
+)
+PaymentAggregationFlowEnum = graphene.Enum(
+    "PaymentAggregationFlowEnum",
+    {
+        "PAYMENT": PaymentAggregationFlow.PAYMENT,
+        "TRANSACTION": PaymentAggregationFlow.TRANSACTION,
+    },
+)
+
+
+class PaymentSummary(BaseObjectType):
+    merchandise_after_discounts = graphene.Field(TaxedMoney, required=True)
+    shipping_after_discounts = graphene.Field(TaxedMoney, required=True)
+    discount = graphene.Field(Money, required=True)
+    tax = graphene.Field(Money, required=True)
+    total = graphene.Field(Money, required=True)
+    payable_before_gift_cards = graphene.Field(Money, required=True)
+    gift_card_charged = graphene.Field(Money, required=True)
+    authorized = graphene.Field(Money, required=True)
+    charged = graphene.Field(Money, required=True)
+    refunded = graphene.Field(Money, required=True)
+    charge_pending = graphene.Field(Money, required=True)
+    refund_pending = graphene.Field(Money, required=True)
+    balance = graphene.Field(Money, required=True)
+    outstanding = graphene.Field(Money, required=True)
+    gift_card_amount_basis = GiftCardAmountBasisEnum(required=True)
+    payment_flow = PaymentAggregationFlowEnum(required=True)
+
+    class Meta:
+        description = (
+            "Current net amounts and informational historical components. "
+            "Tax is already included in gross; pending is not confirmed payment."
+        )
diff --git a/saleor/graphql/payment/tests/mutations/test_sprint1_builtin_giftcard.py b/saleor/graphql/payment/tests/mutations/test_sprint1_builtin_giftcard.py
new file mode 100644
index 000000000..d18c3d7f5
--- /dev/null
+++ b/saleor/graphql/payment/tests/mutations/test_sprint1_builtin_giftcard.py
@@ -0,0 +1,192 @@
+from decimal import Decimal
+
+import graphene
+import pytest
+
+from .....payment import GIFT_CARD_PROVIDER, TransactionAction
+from .....payment.gift_card import card_balances, initialize_gift_card
+from .....payment.models import PaymentActionRecord, TransactionItem
+from ....tests.utils import get_graphql_content, get_graphql_content_from_response
+
+pytestmark = pytest.mark.django_db
+
+INITIALIZE = """
+mutation($id: ID!, $gateway: PaymentGatewayToInitialize!, $amount: PositiveDecimal, $key: String) {
+  transactionInitialize(id: $id, paymentGateway: $gateway, amount: $amount,
+    action: AUTHORIZATION, idempotencyKey: $key) {
+    transaction { id authorizedAmount { amount } chargedAmount { amount }
+      paymentMethodDetails { __typename name ... on GiftCardPaymentMethodDetails { displayCode last4CodeChars } }
+    }
+    transactionEvent { id type } errors { field code }
+  }
+}
+"""
+PROCESS = """
+mutation($id: ID!, $key: String, $data: JSON) {
+  transactionProcess(id: $id, idempotencyKey: $key, data: $data) {
+    transaction { id authorizedAmount { amount } chargedAmount { amount } }
+    transactionEvent { id type } errors { field code }
+  }
+}
+"""
+ACTION = """
+mutation($id: ID!, $key: String, $amount: PositiveDecimal, $action: TransactionActionEnum!) {
+  transactionRequestAction(id: $id, idempotencyKey: $key, amount: $amount, actionType: $action) {
+    transaction { id authorizedAmount { amount } availableChargeAmount { amount } }
+    errors { field code }
+  }
+}
+"""
+
+
+def test_builtin_giftcard_graphql_initialize_process_cancel_without_app(
+    api_client,
+    checkout,
+    gift_card,
+):
+    # Given an anonymous checkout capability, and no installed payment App.
+    variables = {
+        "id": graphene.Node.to_global_id("Checkout", checkout.pk),
+        "gateway": {"id": GIFT_CARD_PROVIDER, "data": {"code": gift_card.code}},
+        "amount": Decimal(8),
+        "key": "initialize",
+    }
+    # When authorization and continuation use the built-in provider.
+    initialized = get_graphql_content(api_client.post_graphql(INITIALIZE, variables))[
+        "data"
+    ]["transactionInitialize"]
+    assert initialized["errors"] == []
+    details = initialized["transaction"]["paymentMethodDetails"]
+    assert details["__typename"] == "GiftCardPaymentMethodDetails"
+    assert details["last4CodeChars"] == gift_card.display_code
+    assert details["displayCode"] != gift_card.code
+    assert "code" not in details
+    transaction_id = initialized["transaction"]["id"]
+    processed = get_graphql_content(
+        api_client.post_graphql(PROCESS, {"id": transaction_id, "key": "process"})
+    )["data"]["transactionProcess"]
+    assert processed["errors"] == []
+    assert processed["transactionEvent"] == initialized["transactionEvent"]
+    # Then the narrow capability can cancel, but cannot request a charge.
+    canceled = get_graphql_content(
+        api_client.post_graphql(
+            ACTION,
+            {"id": transaction_id, "key": "cancel", "action": "CANCEL", "amount": 3},
+        )
+    )["data"]["transactionRequestAction"]
+    assert canceled["errors"] == []
+    assert canceled["transaction"]["authorizedAmount"]["amount"] == 5
+    repeated = get_graphql_content(
+        api_client.post_graphql(
+            ACTION,
+            {"id": transaction_id, "key": "cancel", "action": "CANCEL", "amount": 3},
+        )
+    )["data"]["transactionRequestAction"]
+    assert repeated == canceled
+    forbidden = get_graphql_content_from_response(
+        api_client.post_graphql(
+            ACTION,
+            {"id": transaction_id, "key": "charge", "action": "CHARGE", "amount": 1},
+        )
+    )
+    assert forbidden["errors"][0]["extensions"]["code"] == "PERMISSION_DENIED"
+    gift_card.refresh_from_db()
+    assert gift_card.current_balance_amount == 10
+    assert card_balances(gift_card) == (Decimal(5), Decimal(5))
+    assert TransactionItem.objects.get().app_id is None
+
+
+@pytest.mark.parametrize("amount", [Decimal(0), Decimal("0.001")])
+def test_builtin_giftcard_graphql_zero_has_no_financial_side_effects(
+    api_client,
+    checkout,
+    gift_card,
+    amount,
+):
+    # Given valid card credentials but an explicitly invalid financial amount.
+    response = get_graphql_content(
+        api_client.post_graphql(
+            INITIALIZE,
+            {
+                "id": graphene.Node.to_global_id("Checkout", checkout.pk),
+                "gateway": {"id": GIFT_CARD_PROVIDER, "data": {"code": gift_card.code}},
+                "amount": amount,
+                "key": "zero",
+            },
+        )
+    )["data"]["transactionInitialize"]
+    # Then it is not interpreted as an omitted maximum.
+    assert response["errors"][0]["code"] == "INVALID_AMOUNT"
+    assert not TransactionItem.objects.exists()
+    assert not PaymentActionRecord.objects.exists()
+
+
+def test_giftcard_customer_cancel_exception_does_not_expand_ordinary_gateway(
+    api_client,
+    customer_user,
+    checkout,
+    transaction_item_generator,
+):
+    # Given an ordinary gateway transaction owned by the checkout customer.
+    checkout.user = customer_user
+    checkout.save(update_fields=["user"])
+    api_client.user = customer_user
+    item = transaction_item_generator(
+        checkout_id=checkout.pk,
+        authorized_value=10,
+        available_actions=[TransactionAction.CANCEL],
+    )
+    # When they attempt an ordinary gateway action without HANDLE_PAYMENTS.
+    content = get_graphql_content_from_response(
+        api_client.post_graphql(
+            ACTION,
+            {
+                "id": graphene.Node.to_global_id("TransactionItem", item.token),
+                "action": "CANCEL",
+                "key": "not-builtin",
+            },
+        )
+    )
+    # Then owner read access is not action authority.
+    assert content["errors"][0]["extensions"]["code"] == "PERMISSION_DENIED"
+    assert not PaymentActionRecord.objects.exists()
+
+
+def test_builtin_process_replay_survives_checkout_order_association(
+    api_client,
+    customer_user,
+    checkout,
+    gift_card,
+    order,
+):
+    # Given a customer initialization and a known continuation result.
+    checkout.user = customer_user
+    checkout.save(update_fields=["user"])
+    order.user = customer_user
+    order.save(update_fields=["user"])
+    api_client.user = customer_user
+    item, _, _ = initialize_gift_card(
+        checkout,
+        {"code": gift_card.code},
+        amount=8,
+        action="authorization",
+        key="initial",
+        user=customer_user,
+    )
+    variables = {
+        "id": graphene.Node.to_global_id("TransactionItem", item.token),
+        "key": "process",
+    }
+    first = get_graphql_content(api_client.post_graphql(PROCESS, variables))["data"][
+        "transactionProcess"
+    ]
+    item.checkout = None
+    item.order = order
+    item.save(update_fields=["checkout", "order"])
+    # When the source FK changes during order completion.
+    repeated = get_graphql_content(api_client.post_graphql(PROCESS, variables))["data"][
+        "transactionProcess"
+    ]
+    # Then original identity and result remain stable.
+    assert repeated == first
+    assert item.source_checkout_token == checkout.pk
diff --git a/saleor/graphql/payment/tests/queries/test_sprint1_root_transactions.py b/saleor/graphql/payment/tests/queries/test_sprint1_root_transactions.py
