@@ -0,0 +1,150 @@
+"""Durable dispatch for the compatibility checkout Payment completion flow."""
+
+from django.db import transaction as db_transaction
+
+from ..core.db.connection import allow_writer
+from . import PaymentError
+from .action_reservations import (
+    ACTIVE_ACTION_STATES,
+    action_identity,
+    clean_idempotency_key,
+    existing_action,
+    failure_transaction,
+    finish_action,
+    input_fingerprint,
+    lock_source,
+)
+from .models import Payment, PaymentActionRecord, Transaction
+
+
+@allow_writer()
+def run_checkout_payment_process(
+    checkout,
+    payment,
+    *,
+    manager,
+    channel_slug,
+    customer_id=None,
+    store_source=False,
+    payment_data=None,
+    key=None,
+    user=None,
+    app=None,
+    confirm=None,
+    qualification=None,
+):
+    """Replay a confirmed result; unknown outcomes require reconciliation, not resend."""
+    key = clean_idempotency_key(key)
+    # Confirm is continuation data, not a new identity after payment.to_confirm changes.
+    identity = action_identity(
+        source=checkout,
+        provider=payment.gateway,
+        action="checkout_process",
+        key=key,
+        user=user,
+        app=app,
+    )
+    fingerprint = input_fingerprint(
+        {
+            "payment": payment.pk,
+            "amount": payment.total,
+            "currency": payment.currency,
+            "data": payment_data,
+            "customer_id": customer_id,
+            "store_source": store_source,
+        }
+    )
+    with db_transaction.atomic():
+        checkout = lock_source(checkout)
+        payment = Payment.objects.select_for_update().get(pk=payment.pk)
+        if record := existing_action(identity, fingerprint):
+            transaction_id = record.result_data.get("legacy_transaction_id")
+            if transaction_id:
+                return Transaction.objects.get(pk=transaction_id)
+            raise PaymentError(
+                "Payment outcome is pending reconciliation; do not repeat the charge."
+            )
+        if qualification is not None:
+            # This final local-only fence runs while the source and Payment are
+            # locked, immediately before reserving a new provider dispatch.
+            qualification(checkout, payment)
+        confirm = payment.to_confirm if confirm is None else confirm
+        active = payment.action_records.filter(
+            action="checkout_process", state__in=ACTIVE_ACTION_STATES
+        )
+        for prior in active:
+            txn_id = prior.result_data.get("legacy_transaction_id")
+            # A recognized 3DS action is continuable under a separate confirm key;
+            # an unknown external outcome or a confirm already in flight is not.
+            if not confirm or not txn_id or prior.result_data.get("confirm"):
+                raise PaymentError(
+                    "A payment request is already pending reconciliation."
+                )
+            txn = Transaction.objects.filter(
+                pk=txn_id, action_required=True, is_success=True
+            ).first()
+            if not txn:
+                raise PaymentError(
+                    "A payment request is already pending reconciliation."
+                )
+        record = PaymentActionRecord.objects.create(
+            **identity,
+            input_hash=fingerprint,
+            payment=payment,
+            currency=payment.currency,
+            requested_amount=payment.total,
+            reserved_amount=payment.total,
+            state="requested",
+        )
+        confirm = payment.to_confirm if confirm is None else confirm
+    from . import gateway
+
+    provider_key = f"checkout-payment:{record.pk}"
+    try:
+        if confirm:
+            result = gateway.confirm(
+                payment,
+                manager,
+                channel_slug=channel_slug,
+                additional_data=payment_data,
+                idempotency_key=provider_key,
+            )
+        else:
+            result = gateway.process_payment(
+                payment=payment,
+                token=payment.token,
+                manager=manager,
+                channel_slug=channel_slug,
+                customer_id=customer_id,
+                store_source=store_source,
+                additional_data=payment_data,
+                idempotency_key=provider_key,
+            )
+        finish_action(
+            record,
+            data={"legacy_transaction_id": result.pk, "confirm": confirm},
+            state="requested"
+            if result.action_required
+            else "succeeded"
+            if result.is_success
+            else "failed",
+        )
+        if confirm and not result.action_required:
+            # The known action-required process phase has been consumed by this
+            # confirmation. Keep its original replay result, release only occupancy.
+            for prior in active:
+                if prior.result_data.get("legacy_transaction_id"):
+                    prior.state = "succeeded"
+                    prior.reserved_amount = 0
+                    prior.save(update_fields=["state", "reserved_amount", "updated_at"])
+        return result
+    except Exception as error:
+        result = failure_transaction(error)
+        finish_action(
+            record,
+            data={"legacy_transaction_id": result.pk, "confirm": confirm}
+            if result
+            else {},
+            state="failed" if result else "unknown",
+        )
+        raise
