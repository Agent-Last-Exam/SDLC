index 000000000..bbcbddc98
--- /dev/null
+++ b/saleor/core/subject_search.py
@@ -0,0 +1,289 @@
+"""Durable dirty revisions and bounded writer-only maintenance for four subjects."""
+
+import logging
+
+from django.apps import apps
+from django.conf import settings
+from django.db import transaction
+from django.db.models import F, Q
+from django.db.models.signals import post_save, pre_delete, pre_save
+
+from ..celeryconf import app
+from .db.connection import allow_writer
+from .search import prepare_search_document
+
+logger = logging.getLogger(__name__)
+SUBJECT_LABELS = (
+    "product.Product",
+    "order.Order",
+    "giftcard.GiftCard",
+    "checkout.Checkout",
+)
+SEARCH_UPDATE_FIELDS = {
+    "search_vector",
+    "search_fields",
+    "search_index_dirty",
+    "search_revision",
+    "search_indexed_revision",
+    "updated_at",
+}
+SEARCH_BATCH_SIZE = 100
+
+
+@allow_writer()
+def mark_subject_search_dirty(model_label, pks=None, *, queryset=None):
+    model = apps.get_model(model_label)
+    queryset = (
+        queryset if queryset is not None else model.objects.filter(pk__in=pks or [])
+    )
+    count = queryset.using(settings.DATABASE_CONNECTION_DEFAULT_NAME).update(
+        search_index_dirty=True, search_revision=F("search_revision") + 1
+    )
+    if count:
+        transaction.on_commit(lambda: refresh_subject_search_task.delay(model_label))
+    return count
+
+
+def _prepare_vectors(model_label, instance):
+    if model_label == "product.Product":
+        from ..product.search import prepare_product_search_vector_value
+
+        return prepare_product_search_vector_value(instance)
+    if model_label == "order.Order":
+        from ..order.search import prepare_order_search_vector_value
+
+        return prepare_order_search_vector_value(instance)
+    if model_label == "giftcard.GiftCard":
+        from ..giftcard.search import prepare_gift_card_search_vector_value
+
+        return prepare_gift_card_search_vector_value(instance)
+    if model_label == "checkout.Checkout":
+        from ..checkout.search import prepare_checkout_search_vector_value
+
+        return prepare_checkout_search_vector_value(instance)
+    raise ValueError("Unsupported search subject.")
+
+
+@allow_writer()
+def refresh_subject_search(model_label, pk):
+    model = apps.get_model(model_label)
+    writer = settings.DATABASE_CONNECTION_DEFAULT_NAME
+    with transaction.atomic(using=writer):
+        instance = model.objects.using(writer).select_for_update().filter(pk=pk).first()
+        if instance is None:
+            return False
+        revision = instance.search_revision
+        vector, fields = prepare_search_document(
+            _prepare_vectors(model_label, instance)
+        )
+        # A worker never trusts a queued model instance or a replica snapshot.
+        # The CAS protects newer dirty revisions, including related-field hooks.
+        return bool(
+            model.objects.using(writer)
+            .filter(pk=pk, search_revision=revision)
+            .update(
+                search_vector=vector,
+                search_fields=fields,
+                search_indexed_revision=revision,
+                search_index_dirty=False,
+            )
+        )
+
+
+@allow_writer()
+def refresh_subject_batch(model_label):
+    model = apps.get_model(model_label)
+    pks = list(
+        model.objects.using(settings.DATABASE_CONNECTION_DEFAULT_NAME)
+        .filter(search_index_dirty=True)
+        .order_by("pk")
+        .values_list("pk", flat=True)[:SEARCH_BATCH_SIZE]
+    )
+    for pk in pks:
+        refresh_subject_search(model_label, pk)
+    return len(pks)
+
+
+@app.task(
+    queue=settings.UPDATE_SEARCH_VECTOR_INDEX_QUEUE_NAME,
+    autoretry_for=(Exception,),
+    retry_backoff=True,
+    max_retries=3,
+)
+def refresh_subject_search_task(model_label):
+    if model_label not in SUBJECT_LABELS:
+        raise ValueError("Unsupported search subject.")
+    try:
+        count = refresh_subject_batch(model_label)
+    except Exception:
+        logger.exception("Subject search update failed; dirty revisions remain queued.")
+        raise
+    if count == SEARCH_BATCH_SIZE:
+        refresh_subject_search_task.delay(model_label)
+
+
+def _is_search_maintenance_save(instance, update_fields):
+    if update_fields is None or not set(update_fields) <= SEARCH_UPDATE_FIELDS:
+        return False
+    # Base bulk variant mutations explicitly save only dirty=True. This is a
+    # new document revision, not a worker result, including related Checkouts.
+    return not (
+        "search_index_dirty" in update_fields
+        and instance.search_index_dirty
+        and not {
+            "search_vector",
+            "search_indexed_revision",
+            "search_revision",
+        }.intersection(update_fields)
+    )
+
+
+def _subject_saved(sender, instance, raw=False, update_fields=None, **kwargs):
+    if raw or _is_search_maintenance_save(instance, update_fields):
+        return
+    mark_subject_search_dirty(sender._meta.label, [instance.pk])
+
+
+def _related_changed(sender, instance, raw=False, **kwargs):
+    if raw or _is_search_maintenance_save(instance, kwargs.get("update_fields")):
+        return
+    name = sender._meta.label
+    Product = apps.get_model("product.Product")
+    Order = apps.get_model("order.Order")
+    GiftCard = apps.get_model("giftcard.GiftCard")
+    Checkout = apps.get_model("checkout.Checkout")
+    if name == "product.ProductVariant":
+        mark_subject_search_dirty("product.Product", [instance.product_id])
+        mark_subject_search_dirty(
+            "checkout.Checkout",
+            queryset=Checkout.objects.filter(lines__variant_id=instance.pk).distinct(),
+        )
+    elif name == "product.Product":
+        mark_subject_search_dirty(
+            "checkout.Checkout",
+            queryset=Checkout.objects.filter(
+                lines__variant__product_id=instance.pk
+            ).distinct(),
+        )
+    elif name == "checkout.CheckoutLine":
+        mark_subject_search_dirty("checkout.Checkout", [instance.checkout_id])
+    elif name == "order.OrderLine":
+        mark_subject_search_dirty("order.Order", [instance.order_id])
+    elif name == "account.User":
+        emails = [
+            instance.email,
+            getattr(instance, "_subject_search_old_email", instance.email),
+        ]
+        mark_subject_search_dirty(
+            "order.Order", queryset=Order.objects.filter(user_id=instance.pk)
+        )
+        mark_subject_search_dirty(
+            "checkout.Checkout", queryset=Checkout.objects.filter(user_id=instance.pk)
+        )
+        mark_subject_search_dirty(
+            "giftcard.GiftCard",
+            queryset=GiftCard.objects.filter(
+                Q(created_by_id=instance.pk)
+                | Q(used_by_id=instance.pk)
+                | Q(created_by_email__in=emails)
+                | Q(used_by_email__in=emails)
+            ),
+        )
+    elif name == "account.Address":
+        mark_subject_search_dirty(
+            "order.Order",
+            queryset=Order.objects.filter(
+                Q(billing_address_id=instance.pk) | Q(shipping_address_id=instance.pk)
+            ),
+        )
+    elif name in {
+        "payment.Payment",
+        "payment.TransactionItem",
+        "discount.OrderDiscount",
+        "order.OrderEvent",
+        "invoice.Invoice",
+    }:
+        mark_subject_search_dirty("order.Order", [getattr(instance, "order_id", None)])
+        mark_subject_search_dirty(
+            "checkout.Checkout", [getattr(instance, "checkout_id", None)]
+        )
+    elif name == "payment.TransactionEvent":
+        transaction_item = instance.transaction if instance.transaction_id else None
+        if transaction_item:
+            mark_subject_search_dirty("order.Order", [transaction_item.order_id])
+            mark_subject_search_dirty(
+                "checkout.Checkout", [transaction_item.checkout_id]
+            )
+    elif name == "page.Page":
+        mark_subject_search_dirty(
+            "product.Product",
+            queryset=Product.objects.filter(
+                Q(attributevalues__value__reference_page_id=instance.pk)
+                | Q(variants__attributes__values__reference_page_id=instance.pk)
+            ).distinct(),
+        )
+    elif name == "attribute.AttributeValue":
+        mark_subject_search_dirty(
+            "product.Product",
+            queryset=Product.objects.filter(
+                Q(attributevalues__value_id=instance.pk)
+                | Q(variants__attributes__values__id=instance.pk)
+            ).distinct(),
+        )
+    elif name == "attribute.AssignedProductAttributeValue":
+        mark_subject_search_dirty("product.Product", [instance.product_id])
+    elif name == "attribute.AssignedVariantAttributeValue":
+        variant = instance.assignment.variant
+        mark_subject_search_dirty("product.Product", [variant.product_id])
+
+
+def _remember_user_email(sender, instance, raw=False, **kwargs):
+    if not raw and instance.pk:
+        instance._subject_search_old_email = (
+            sender.objects.filter(pk=instance.pk)
+            .values_list("email", flat=True)
+            .first()
+        )
+
+
+def register_subject_search_signals():
+    for label in SUBJECT_LABELS:
+        post_save.connect(
+            _subject_saved,
+            sender=apps.get_model(label),
+            weak=False,
+            dispatch_uid=f"subject-search:{label}",
+        )
+    labels = (
+        "product.Product",
+        "product.ProductVariant",
+        "checkout.CheckoutLine",
+        "order.OrderLine",
+        "account.User",
+        "account.Address",
+        "page.Page",
+        "attribute.AttributeValue",
+        "attribute.AssignedProductAttributeValue",
+        "attribute.AssignedVariantAttributeValue",
+        "payment.Payment",
+        "payment.TransactionItem",
+        "payment.TransactionEvent",
+        "discount.OrderDiscount",
+        "order.OrderEvent",
+        "invoice.Invoice",
+    )
+    for label in labels:
+        sender = apps.get_model(label)
+        for signal in (post_save, pre_delete):
+            signal.connect(
+                _related_changed,
+                sender=sender,
+                weak=False,
+                dispatch_uid=f"subject-search-related:{label}:{id(signal)}",
+            )
+    pre_save.connect(
+        _remember_user_email,
+        sender=apps.get_model("account.User"),
+        weak=False,
+        dispatch_uid="subject-search:user-email",
+    )
diff --git a/saleor/core/tests/test_subject_search_sprint1.py b/saleor/core/tests/test_subject_search_sprint1.py
new file mode 100644
index 000000000..3968e4992
--- /dev/null
+++ b/saleor/core/tests/test_subject_search_sprint1.py
@@ -0,0 +1,177 @@
+"""Four-subject search contract, without changing Page/User basic search."""
+
+import pytest
+from django.contrib.postgres.search import SearchVector
+from django.db.models import Value
+from graphql import GraphQLError
+
+from ...checkout.models import Checkout
+from ...checkout.search import search_checkouts
+from ...graphql.utils.sorting import sort_queryset_by_default
+from ...product.models import Product
+from ..search import SearchTerm, parse_search, prepare_search_document, search_queryset
+from ..subject_search import mark_subject_search_dirty, refresh_subject_search
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("  Ｒｅｄ SHOE  ", (SearchTerm("red"), SearchTerm("shoe", prefix=True))),
+        (
+            'red "running shoe"',
+            (SearchTerm("red"), SearchTerm("running shoe", phrase=True)),
+        ),
+        (
+            '"running shoe" red',
+            (SearchTerm("running shoe", phrase=True), SearchTerm("red", prefix=True)),
+        ),
+        ("red shoes red", (SearchTerm("shoes"), SearchTerm("red", prefix=True))),
+        ("  ", ()),
+        ("red red", (SearchTerm("red", prefix=True),)),
+        ("İSTANBUL", (SearchTerm("i̇stanbul", prefix=True),)),
+        ("foo/bar", (SearchTerm("foo/bar", prefix=True),)),
+    ],
+)
+def test_parse_subject_search_normalization(value, expected):
+    # when
+    parsed = parse_search(value)
+    # then
+    assert parsed.terms == expected
+
+
+@pytest.mark.parametrize(
+    "value", ["x" * 257, '"unclosed', '""', "a\x00b", 'word"phrase"']
+)
+def test_parse_subject_search_rejects_invalid_input(value):
+    # when / then
+    with pytest.raises(GraphQLError) as error:
+        parse_search(value)
+    assert error.value.extensions["code"] == "INPUT_ERROR"
+
+
+def test_original_unicode_length_is_checked_before_nfkc_expansion():
+    # given: each ligature expands to three letters under NFKC
+    value = "ﬃ" * 256
+    # when / then
+    assert parse_search(value).terms[0].text == "ffi" * 256
+
+
+def test_document_normalizes_each_independent_field_and_retains_weight():
+    # given
+    vectors = [
+        SearchVector(Value("ＲＥＤ"), Value("SHOE"), weight="A", config="simple")
+    ]
+    # when
+    document, fields = prepare_search_document(vectors)
+    # then
+    assert fields == ["red", "shoe"]
+    assert len(document.get_source_expressions()) == 2
+
+
+def test_search_and_final_prefix_and_integer_rank(product):
+    # given
+    product.name = "Ｒｅｄ shoes"
+    product.description_plaintext = "comfortable"
+    product.save(update_fields=["name", "description_plaintext"])
+    refresh_subject_search("product.Product", product.pk)
+    # when
+    result = search_queryset(Product.objects.filter(pk=product.pk), "RED sho").get()
+    # then
+    assert isinstance(result.search_rank_key, int)
+    assert result.search_rank_key > 0
+    assert not search_queryset(
+        Product.objects.filter(pk=product.pk), "red absent"
+    ).exists()
+    assert not search_queryset(
+        Product.objects.filter(pk=product.pk), "re shoes"
+    ).exists()
+
+
+def test_phrase_cannot_cross_independent_fields(product):
+    # given
+    product.name = "boundaryred"
+    product.description_plaintext = "boundaryshoe"
+    product.save(update_fields=["name", "description_plaintext"])
+    refresh_subject_search("product.Product", product.pk)
+    queryset = Product.objects.filter(pk=product.pk)
+    # when / then
+    assert search_queryset(queryset, "boundaryred boundaryshoe").exists()
+    assert not search_queryset(queryset, '"boundaryred boundaryshoe"').exists()
+    product.name = "boundaryred boundaryshoe"
+    product.save(update_fields=["name"])
+    refresh_subject_search("product.Product", product.pk)
+    assert search_queryset(queryset, '"boundaryred boundaryshoe"').exists()
+    assert not search_queryset(queryset, '"boundaryshoe boundaryred"').exists()
+
+
+def test_writer_refresh_ignores_stale_instance_and_preserves_business_timestamp(
+    product,
+):
+    # given
+    stale_pk = product.pk
+    timestamp = product.updated_at
+    Product.objects.filter(pk=stale_pk).update(name="latestwritername")
+    mark_subject_search_dirty("product.Product", [stale_pk])
+    # when
+    refresh_subject_search("product.Product", stale_pk)
+    product.refresh_from_db()
+    # then
+    assert product.search_revision == product.search_indexed_revision
+    assert not product.search_index_dirty
+    assert product.updated_at == timestamp
+    assert search_queryset(
+        Product.objects.filter(pk=stale_pk), "latestwritername"
+    ).exists()
+
+
+def test_checkout_exact_token_is_scoped_without_requiring_fresh_index(checkout):
+    # given
+    Checkout.objects.filter(pk=checkout.pk).update(search_vector=None)
+    # when / then
+    result = search_checkouts(
+        Checkout.objects.filter(pk=checkout.pk), str(checkout.pk)
+    ).get()
+    assert result.search_rank_key == 0
+    assert not search_checkouts(Checkout.objects.none(), str(checkout.pk)).exists()
+
+
+@pytest.mark.parametrize("name", ["İSTANBUL", "foo/bar", "sku_123", "red-shoe"])
+def test_unicode_and_identifier_search_matches_normalized_document(product, name):
+    # given
+    product.name = name
+    product.save(update_fields=["name"])
+    refresh_subject_search("product.Product", product.pk)
+    # when / then
+    assert search_queryset(Product.objects.filter(pk=product.pk), name).exists()
+
+
+def test_default_search_order_uses_quantized_rank_and_primary_key(product):
+    # given
+    product.name = "rankedterm"
+    product.save(update_fields=["name"])
+    refresh_subject_search("product.Product", product.pk)
+    queryset = search_queryset(Product.objects.filter(pk=product.pk), "rankedterm")
+    # when
+    ordered, sorting = sort_queryset_by_default(queryset, reversed=False)
+    backwards, reverse_sorting = sort_queryset_by_default(queryset, reversed=True)
+    # then
+    assert ordered.query.order_by == ("-search_rank_key", "-pk")
+    assert backwards.query.order_by == ("search_rank_key", "pk")
+    assert sorting == {"field": ["search_rank_key", "pk"], "direction": "-"}
+    assert reverse_sorting["direction"] == ""
+
+
+def test_explicit_product_dirty_save_invalidates_related_checkout(checkout_with_item):
+    # given
+    checkout = checkout_with_item
+    product = checkout.lines.get().variant.product
+    refresh_subject_search("checkout.Checkout", checkout.pk)
+    checkout.refresh_from_db()
+    revision = checkout.search_revision
+    # when: Base bulk variant mutation marks the Product dirty this way
+    product.search_index_dirty = True
+    product.save(update_fields=["search_index_dirty"])
+    checkout.refresh_from_db()
+    # then
+    assert checkout.search_index_dirty
+    assert checkout.search_revision > revision
diff --git a/saleor/core/utils/tests/test_editorjs_sprint1.py b/saleor/core/utils/tests/test_editorjs_sprint1.py
