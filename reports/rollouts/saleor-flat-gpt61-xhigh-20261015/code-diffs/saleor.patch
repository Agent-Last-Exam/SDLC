--- /dev/null
+++ b/saleor/graphql/product/types/channel_availability.py
@@ -0,0 +1,364 @@
+"""Read-only, scoped product diagnostics; this never performs pricing or service calls."""
+
+import base64
+import binascii
+from collections import defaultdict
+
+import graphene
+from babel.numbers import list_currencies
+from django.utils import timezone
+from graphql import GraphQLError
+from prices import Money
+
+from ....channel import StockSourceStrategy
+from ....channel.models import Channel
+from ....core.exceptions import PermissionDenied
+from ....permission.enums import ProductPermissions
+from ....product.models import (
+    ProductChannelListing,
+    ProductVariant,
+    ProductVariantChannelListing,
+)
+from ....warehouse.models import Stock, Warehouse
+from ...account.utils import get_user_accessible_channels
+from ...channel.types import Channel as ChannelType
+from ...core.scalars import DateTime
+from ...core.types import NonNullList
+from ...utils import get_user_or_app_from_context
+
+AvailabilityIssueSeverityEnum = graphene.Enum(
+    "AvailabilityIssueSeverityEnum",
+    [(value, value) for value in ("BLOCKING", "WARNING", "NOT_APPLICABLE")],
+)
+ProductAvailabilityIssueCodeEnum = graphene.Enum(
+    "ProductAvailabilityIssueCodeEnum",
+    [
+        (value, value)
+        for value in (
+            "CHANNEL_INACTIVE",
+            "PRODUCT_NOT_PUBLISHED",
+            "PRODUCT_NOT_YET_AVAILABLE",
+            "NO_CHANNEL_VARIANT_PRICE",
+            "NO_SALEABLE_VARIANT",
+            "INSUFFICIENT_STOCK",
+            "NO_ELIGIBLE_WAREHOUSE",
+            "NO_SHIPPING_ZONE",
+            "SHIPPING_NOT_REQUIRED",
+            "PRODUCT_NOT_LISTED_IN_CHANNEL",
+        )
+    ],
+)
+
+
+class ProductChannelAvailabilityFilterInput(graphene.InputObjectType):
+    search = graphene.String()
+    currency = graphene.String()
+
+
+class ProductAvailabilityIssue(graphene.ObjectType):
+    code = ProductAvailabilityIssueCodeEnum(required=True)
+    severity = AvailabilityIssueSeverityEnum(required=True)
+    message = graphene.String(required=True)
+    variant_ids = NonNullList(graphene.ID, required=True)
+
+
+class ProductChannelAvailability(graphene.ObjectType):
+    channel = graphene.Field(ChannelType, required=True)
+    is_available = graphene.Boolean(required=True)
+    issue_count = graphene.Int(required=True)
+    issues = NonNullList(ProductAvailabilityIssue, required=True)
+    evaluated_at = DateTime(required=True)
+
+
+class ProductChannelAvailabilityEdge(graphene.ObjectType):
+    node = graphene.Field(ProductChannelAvailability, required=True)
+    cursor = graphene.String(required=True)
+
+
+class ProductChannelAvailabilityConnection(graphene.ObjectType):
+    edges = NonNullList(ProductChannelAvailabilityEdge, required=True)
+    page_info = graphene.Field(graphene.relay.PageInfo, required=True)
+    total_count = graphene.Int(required=True)
+
+
+def input_error(message, field):
+    raise GraphQLError(message, extensions={"code": "INPUT_ERROR", "field": field})
+
+
+def _cursor(pk):
+    return base64.b64encode(f"product-channel:{pk}".encode()).decode()
+
+
+def _decode_cursor(value, field):
+    if value is None:
+        return None
+    try:
+        prefix, pk = base64.b64decode(value, validate=True).decode().split(":")
+        if (
+            prefix != "product-channel"
+            or not pk.isdigit()
+            or int(pk) < 1
+            or _cursor(int(pk)) != value
+        ):
+            raise ValueError
+        return int(pk)
+    except (ValueError, TypeError, UnicodeError, binascii.Error):
+        input_error("Invalid product channel availability cursor.", field)
+
+
+def resolve_channel_availability(
+    product, info, *, filter=None, first=None, last=None, before=None, after=None
+):
+    actor = get_user_or_app_from_context(info.context)
+    if not actor or not actor.has_perm(ProductPermissions.MANAGE_PRODUCTS):
+        raise PermissionDenied(permissions=[ProductPermissions.MANAGE_PRODUCTS])
+    # Product management is a Base domain qualification to read channels; an
+    # additional MANAGE_CHANNELS permission is not required to inspect one's scope.
+    channels = Channel.objects.order_by("pk")
+    user = info.context.user
+    if (
+        user
+        and user.is_authenticated
+        and user.is_staff
+        and not getattr(info.context, "app", None)
+    ):
+        channels = channels.filter(
+            pk__in=[channel.pk for channel in get_user_accessible_channels(info, user)]
+        )
+    filters = filter or {}
+    search = filters.get("search")
+    currency = filters.get("currency")
+    if search is not None:
+        if len(search) > 256:
+            input_error("Search cannot exceed 256 characters.", "filter.search")
+        channels = channels.filter(name__icontains=search)
+    if currency is not None:
+        try:
+            if (
+                len(currency) != 3
+                or currency != currency.upper()
+                or currency not in list_currencies()
+            ):
+                raise ValueError
+            Money(0, currency)
+        except (ValueError, TypeError):
+            input_error(
+                "Currency must be a valid ISO currency code.", "filter.currency"
+            )
+        channels = channels.filter(currency_code=currency)
+    for field, size in (("first", first), ("last", last)):
+        if size is not None and (type(size) is not int or not 1 <= size <= 100):
+            input_error("Page size must be between 1 and 100.", field)
+    if first is not None and last is not None:
+        input_error("Use either first or last.", "last")
+    if before is not None and after is not None:
+        input_error("Use either before or after.", "after")
+    if (
+        first is not None
+        and before is not None
+        or last is not None
+        and after is not None
+    ):
+        input_error(
+            "Cursor direction does not match page size.",
+            "before" if before else "after",
+        )
+    lower, upper = _decode_cursor(after, "after"), _decode_cursor(before, "before")
+    total = channels.count()
+    window = channels
+    if lower is not None:
+        window = window.filter(pk__gt=lower)
+    if upper is not None:
+        window = window.filter(pk__lt=upper)
+    reverse = last is not None or before is not None
+    size = last if last is not None else first if first is not None else 100
+    page = list(window.order_by("-pk" if reverse else "pk")[:size])
+    if reverse:
+        page.reverse()
+    rows = diagnose_product_channels(product, page)
+    edges = [
+        ProductChannelAvailabilityEdge(node=row, cursor=_cursor(channel.pk))
+        for row, channel in zip(rows, page, strict=True)
+    ]
+    return ProductChannelAvailabilityConnection(
+        total_count=total,
+        edges=edges,
+        page_info=graphene.relay.PageInfo(
+            has_previous_page=channels.filter(pk__lt=page[0].pk).exists()
+            if page
+            else False,
+            has_next_page=channels.filter(pk__gt=page[-1].pk).exists()
+            if page
+            else False,
+            start_cursor=edges[0].cursor if edges else None,
+            end_cursor=edges[-1].cursor if edges else None,
+        ),
+    )
+
+
+def diagnose_product_channels(product, channels):
+    """Batch all variants, listings, relationships and stocks for this page."""
+    now = timezone.now()
+    channel_ids = [channel.pk for channel in channels]
+    listings = {
+        listing.channel_id: listing
+        for listing in ProductChannelListing.objects.filter(
+            product=product, channel_id__in=channel_ids
+        )
+    }
+    variants = list(ProductVariant.objects.filter(product=product).order_by("pk"))
+    prices = {
+        (listing.channel_id, listing.variant_id): listing
+        for listing in ProductVariantChannelListing.objects.filter(
+            variant__in=variants, channel_id__in=channel_ids
+        )
+    }
+    relations = Channel.warehouses.through.objects.filter(
+        channel_id__in=channel_ids
+    ).values_list("channel_id", "warehouse_id")
+    warehouse_by_channel = defaultdict(set)
+    warehouse_ids = set()
+    for channel_id, warehouse_id in relations:
+        warehouse_by_channel[channel_id].add(warehouse_id)
+        warehouse_ids.add(warehouse_id)
+    warehouses = {
+        warehouse.pk: warehouse
+        for warehouse in Warehouse.objects.filter(
+            pk__in=warehouse_ids
+        ).prefetch_related("shipping_zones__channels")
+    }
+    eligible = defaultdict(set)
+    has_zone = defaultdict(bool)
+    for channel in channels:
+        for warehouse_id in warehouse_by_channel[channel.pk]:
+            warehouse = warehouses[warehouse_id]
+            reachable = any(
+                zone.countries
+                and any(assigned.pk == channel.pk for assigned in zone.channels.all())
+                for zone in warehouse.shipping_zones.all()
+            )
+            has_zone[channel.pk] |= reachable
+            if (
+                channel.stock_source_strategy == StockSourceStrategy.CHANNEL
+                or reachable
+                or warehouse.click_and_collect_option != "disabled"
+            ):
+                eligible[channel.pk].add(warehouse_id)
+    stocks = list(
+        Stock.objects.filter(
+            product_variant__in=variants, warehouse_id__in=warehouse_ids
+        )
+        .annotate_available_quantity()
+        .annotate_reserved_quantity()
+    )
+    quantities = defaultdict(int)
+    for stock in stocks:
+        quantities[(stock.warehouse_id, stock.product_variant_id)] += max(
+            stock.available_quantity - stock.reserved_quantity, 0
+        )
+    requires_shipping = product.product_type.is_shipping_required
+    result = []
+    for channel in channels:
+        issues = []
+
+        def issue(code, message, ids=(), severity="BLOCKING"):
+            issues.append(
+                ProductAvailabilityIssue(
+                    code=code,
+                    severity=severity,
+                    message=message,
+                    variant_ids=[
+                        graphene.Node.to_global_id("ProductVariant", pk) for pk in ids
+                    ],
+                )
+            )
+
+        listing = listings.get(channel.pk)
+        if not channel.is_active:
+            issue("CHANNEL_INACTIVE", "The channel is inactive.")
+        elif listing is None:
+            issue(
+                "PRODUCT_NOT_LISTED_IN_CHANNEL",
+                "The product is not assigned to this channel.",
+            )
+        elif not listing.is_published:
+            issue(
+                "PRODUCT_NOT_PUBLISHED", "The product is not published in this channel."
+            )
+        elif (
+            (listing.published_at and listing.published_at > now)
+            or not listing.available_for_purchase_at
+            or listing.available_for_purchase_at > now
+        ):
+            issue(
+                "PRODUCT_NOT_YET_AVAILABLE",
+                "The product is not yet available for purchase.",
+            )
+        else:
+            missing_price, unavailable, saleable = [], [], []
+            for variant in variants:
+                price = prices.get((channel.pk, variant.pk))
+                if price is None or price.price_amount is None:
+                    missing_price.append(variant.pk)
+                    continue
+                if (
+                    not variant.track_inventory
+                    or variant.is_preorder_active()
+                    or sum(
+                        quantities[(warehouse_id, variant.pk)]
+                        for warehouse_id in eligible[channel.pk]
+                    )
+                    > 0
+                ):
+                    saleable.append(variant.pk)
+                else:
+                    unavailable.append(variant.pk)
+            severity = "WARNING" if saleable else "BLOCKING"
+            if missing_price:
+                issue(
+                    "NO_CHANNEL_VARIANT_PRICE",
+                    "Some variants have no channel price.",
+                    missing_price,
+                    severity,
+                )
+            if unavailable:
+                if not eligible[channel.pk]:
+                    issue(
+                        "NO_ELIGIBLE_WAREHOUSE",
+                        "No eligible stock warehouse is assigned to this channel.",
+                        unavailable,
+                        severity,
+                    )
+                else:
+                    issue(
+                        "INSUFFICIENT_STOCK",
+                        "Some variants have insufficient available stock.",
+                        unavailable,
+                        severity,
+                    )
+            if not saleable:
+                issue(
+                    "NO_SALEABLE_VARIANT",
+                    "No variant is currently saleable in this channel.",
+                )
+            if requires_shipping and not has_zone[channel.pk]:
+                issue(
+                    "NO_SHIPPING_ZONE",
+                    "No reachable shipping zone is configured for this channel.",
+                )
+        if not requires_shipping:
+            issue(
+                "SHIPPING_NOT_REQUIRED",
+                "This product does not require shipping.",
+                severity="NOT_APPLICABLE",
+            )
+        result.append(
+            ProductChannelAvailability(
+                channel=channel,
+                is_available=not any(issue.severity == "BLOCKING" for issue in issues),
+                issue_count=sum(issue.severity != "NOT_APPLICABLE" for issue in issues),
+                issues=issues,
+                evaluated_at=now,
+            )
+        )
+    return result
diff --git a/saleor/graphql/shop/tests/test_password_policy_sprint1.py b/saleor/graphql/shop/tests/test_password_policy_sprint1.py
new file mode 100644
index 000000000..b480f0995
