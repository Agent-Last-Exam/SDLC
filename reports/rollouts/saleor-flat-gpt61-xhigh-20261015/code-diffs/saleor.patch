+        require_transaction_visible(info, instance, payment_permission=True)
+        return
+    if isinstance(instance, CheckoutLine | CheckoutMetadata):
+        instance = (
+            Checkout.objects.using("default").filter(pk=instance.checkout_id).first()
+        )
+        if instance is None:
+            raise PermissionDenied()
+    if isinstance(instance, Checkout):
+        from ..checkout.utils import check_checkout_access
+
+        check_checkout_access(info, instance)
+        return
+    if isinstance(instance, OrderLine | Fulfillment):
+        instance = Order.objects.using("default").filter(pk=instance.order_id).first()
+        if instance is None:
+            raise PermissionDenied()
+    if isinstance(instance, Order):
+        app = get_app_promise(info.context).get()
+        if app is not None:
+            return
+        user = info.context.user
