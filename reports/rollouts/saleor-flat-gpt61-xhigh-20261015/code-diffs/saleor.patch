+def has_scoped_tax_event_access(instance, info: ResolveInfo) -> bool:
+    """Allow HANDLE_TAXES reads only for a server-created tax-event subject.
+
+    The marker is constructed by the subscription payload executor, never from an
+    HTTP input or header. It belongs to one App execution and one source object.
+    It deliberately does not grant write privileges.
+    """
+    from ...checkout.models import Checkout, CheckoutLine, CheckoutMetadata
+    from ...order.models import Fulfillment, Order, OrderLine
+
+    subject = getattr(info.context, "_trusted_tax_event_subject", None)
+    if subject is None:
+        return False
+    from ..webhook.subscription_payload import TrustedTaxEventSubject
+
+    if not isinstance(subject, TrustedTaxEventSubject):
+        return False
+    app = get_app_promise(info.context).get()
+    if (
+        app is None
+        or app.pk != subject.app_id
+        or not app.has_perm(CheckoutPermissions.HANDLE_TAXES)
+    ):
+        return False
+    if isinstance(instance, CheckoutLine | CheckoutMetadata):
+        label, object_id = Checkout._meta.label_lower, instance.checkout_id
+    elif isinstance(instance, OrderLine | Fulfillment):
+        label, object_id = Order._meta.label_lower, instance.order_id
+    elif isinstance(instance, Checkout | Order):
+        label, object_id = instance._meta.label_lower, instance.pk
+    else:
+        return False
+    return label == subject.model_label and str(object_id) == subject.object_id
+
