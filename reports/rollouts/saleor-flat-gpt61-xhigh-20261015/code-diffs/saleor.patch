@@ -0,0 +1,64 @@
+import graphene
+
+from ....checkout.delivery import calculate_delivery_options, save_delivery_calculation
+from ...core.context import SyncWebhookControlContext
+from ...core.doc_category import DOC_CATEGORY_CHECKOUT
+from ...core.mutations import BaseMutation, validation_error_to_error_type
+from ...core.types import CheckoutError, NonNullList
+from ...plugins.dataloaders import get_plugin_manager_promise
+from ...shipping.types import ShippingMethod
+from ...warehouse.types import Warehouse
+from ..enums import DeliverySelectionStatusEnum
+from ..types import Checkout, DeliveryMethod
+from ..utils import check_checkout_access
+from .utils import get_checkout
+
+
+class CheckoutDeliveryRecalculate(BaseMutation):
+    checkout = graphene.Field(Checkout)
+    shipping_methods = NonNullList(ShippingMethod, required=True)
+    collection_points = NonNullList(Warehouse, required=True)
+    delivery_method = graphene.Field(DeliveryMethod)
+    selection_status = DeliverySelectionStatusEnum()
+    selection_error = graphene.Field(CheckoutError)
+
+    class Arguments:
+        id = graphene.ID(required=True)
+        expected_version = graphene.Int()
+
+    class Meta:
+        description = "Freshly recalculate delivery options without automatically selecting a replacement."
+        doc_category = DOC_CATEGORY_CHECKOUT
+        error_type_class = CheckoutError
+
+    @classmethod
+    def handle_typed_errors(cls, errors, **extra):
+        return super().handle_typed_errors(
+            errors, shipping_methods=[], collection_points=[], **extra
+        )
+
+    @classmethod
+    def perform_mutation(cls, _root, info, /, id, expected_version=None):
+        checkout = get_checkout(cls, info, checkout_id=None, id=id)
+        manager = get_plugin_manager_promise(info.context).get()
+        calculation = calculate_delivery_options(
+            checkout, manager, expected_version=expected_version
+        )
+        checkout = save_delivery_calculation(
+            calculation,
+            manager,
+            check_access=lambda item: check_checkout_access(info, item),
+        )
+        selection_error = None
+        if calculation.selection_error:
+            selection_error = validation_error_to_error_type(
+                calculation.selection_error, CheckoutError
+            )[0]
+        return cls(
+            checkout=SyncWebhookControlContext(checkout),
+            shipping_methods=calculation.shipping_methods,
+            collection_points=calculation.collection_points,
+            delivery_method=calculation.delivery_method,
+            selection_status=calculation.selection_status,
+            selection_error=selection_error,
+        )
