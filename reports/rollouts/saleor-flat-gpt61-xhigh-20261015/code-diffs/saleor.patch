+def test_giftcard_concurrent_authorizations_cannot_overspend(
+    checkout, gift_card, other_channel_USD, same_key
+):
+    # Given competing connections, including different-channel card consumers.
+    other = (
+        checkout
+        if same_key
+        else Checkout.objects.create(channel=other_channel_USD, currency="USD")
+    )
+    barrier = Barrier(2)
+    code = gift_card.code
+
+    def authorize(source_id, key):
+        close_old_connections()
+        try:
+            source = Checkout.objects.get(pk=source_id)
+            barrier.wait(timeout=10)
+            try:
+                item, event, _ = initialize_gift_card(
+                    source, {"code": code}, amount=8, action="authorization", key=key
+                )
+                return (item.pk, event.pk)
+            except ValidationError as error:
+                return error.error_dict["amount"][0].code
+        finally:
+            close_old_connections()
+
+    # When both callers reach the source/card lock boundary concurrently.
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        first = executor.submit(authorize, checkout.pk, "same" if same_key else "first")
+        second = executor.submit(authorize, other.pk, "same" if same_key else "second")
+        results = [first.result(timeout=30), second.result(timeout=30)]
+    # Then same keys share one fact and different sources cannot reserve above current.
+    if same_key:
+        assert results[0] == results[1]
+    else:
+        assert sum(isinstance(result, tuple) for result in results) == 1
+        assert "gift_card_insufficient_balance" in results
+    gift_card.refresh_from_db()
+    assert card_balances(gift_card) == (Decimal(2), Decimal(8))
+    assert gift_card.current_balance_amount == 10
+    assert PaymentActionRecord.objects.filter(action="initialize").count() == 1
