+    # Given an unpaid order without either payment representation.
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    order = order_with_lines
+    variables = {
+        "id": graphene.Node.to_global_id("Order", order.pk),
+        "key": "manual-once",
+        "reference": "bank-reference",
+    }
+    # When the same mark-paid command is retried.
+    first = get_graphql_content(staff_api_client.post_graphql(MARK_PAID, variables))[
+        "data"
+    ]["orderMarkAsPaid"]
+    repeated = get_graphql_content(staff_api_client.post_graphql(MARK_PAID, variables))[
+        "data"
+    ]["orderMarkAsPaid"]
+    assert first == repeated
+    assert first["errors"] == []
+    assert order.payments.count() + order.payment_transactions.count() == 1
+    assert PaymentActionRecord.objects.filter(action="mark_as_paid").count() == 1
+    # Then changed input conflicts and a different key cannot create another payment.
+    variables["reference"] = "different-reference"
+    changed = get_graphql_content(staff_api_client.post_graphql(MARK_PAID, variables))[
+        "data"
+    ]["orderMarkAsPaid"]
+    assert changed["errors"][0]["code"] == "IDEMPOTENCY_CONFLICT"
+    variables["key"] = "new-command"
+    existing = get_graphql_content(staff_api_client.post_graphql(MARK_PAID, variables))[
+        "data"
+    ]["orderMarkAsPaid"]
+    assert existing["errors"][0]["code"] == "PAYMENT_ALREADY_EXISTS"
