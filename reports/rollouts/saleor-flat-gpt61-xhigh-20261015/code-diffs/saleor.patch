+from django.db import migrations, models
+
+from saleor.csv.storage import ExportStorage
+
+
+def invalidate_public_export_links(apps, schema_editor):
+    """Old public objects must not be reissued as if they were protected files.
+
+    The public storage operator must also remove existing export_files objects
+    and invalidate any CDN copies; a database migration cannot revoke cached URLs.
+    """
+    ExportFile = apps.get_model("csv", "ExportFile")
+    ExportFile.objects.using(schema_editor.connection.alias).exclude(
+        content_file__isnull=True
+    ).exclude(content_file="").update(
+        content_file=None,
+        status="failed",
+        message="This legacy public export is no longer available. Create a new authorized export.",
+    )
+
+
+class Migration(migrations.Migration):
+    dependencies = [("csv", "0005_effective_export_scope_sprint1")]
+
+    operations = [
+        migrations.RunPython(invalidate_public_export_links, migrations.RunPython.noop),
+        migrations.AlterField(
+            model_name="exportfile",
+            name="content_file",
+            field=models.FileField(
+                upload_to="export_files", null=True, storage=ExportStorage()
