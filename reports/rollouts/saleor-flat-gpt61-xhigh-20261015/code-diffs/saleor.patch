+
+
+@pytest.fixture
+def current_manifest():
+    return {
+        "id": "sprint1-test-app",
+        "version": "1.2.3",
+        "name": "Test",
+        "extensions": [
+            {
+                "label": "Open",
+                "url": "https://example.com/open",
+                "mountName": "ORDER_DETAILS_MORE_ACTIONS",
+                "targetName": "NEW_TAB",
+            }
+        ],
+    }
+
+
+def test_optional_token_target_and_settings_default(current_manifest):
+    # given / when
+    clean_manifest_data(current_manifest)
+    # then
+    assert "tokenTargetUrl" not in current_manifest
+    assert current_manifest["extensions"][0]["settings"] == {}
+    assert (
+        current_manifest["extensions"][0]["mountName"] == "order_details_more_actions"
+    )
+
+
+@pytest.mark.parametrize("field", ["mount", "target", "options"])
+def test_new_manifest_rejects_legacy_extension_fields(current_manifest, field):
+    # given
+    current_manifest["extensions"][0][field] = {}
+    # when
+    with pytest.raises(ValidationError) as error:
+        clean_manifest_data(current_manifest)
+    # then
+    assert (
+        error.value.error_dict["extensions"][0].code
+        == AppErrorCode.MIGRATION_REQUIRED.value
+    )
+
+
+@pytest.mark.parametrize(
+    "url",
+    [
+        "https://other.example/open",
+        "http://example.com/open",
+        "https://example.com:444/open",
+    ],
+)
+def test_post_extension_requires_full_trusted_origin(current_manifest, url):
+    # given
+    current_manifest["tokenTargetUrl"] = "https://example.com/token"
+    current_manifest["extensions"][0].update(url=url, settings={"method": "POST"})
+    # when / then
+    with pytest.raises(ValidationError):
+        clean_manifest_data(current_manifest)
+
+
+def test_post_extension_effective_default_port(current_manifest):
+    # given
+    current_manifest["tokenTargetUrl"] = "https://example.com:443/token"
+    current_manifest["extensions"][0]["settings"] = {"method": "POST"}
+    # when / then
+    clean_manifest_data(current_manifest)
+
+
+@pytest.mark.parametrize(
+    "extension_settings", [None, [], {"secret": "no"}, {"method": "DELETE"}]
+)
+def test_invalid_extension_settings(current_manifest, extension_settings):
+    # given
+    current_manifest["extensions"][0]["settings"] = extension_settings
+    # when / then
+    with pytest.raises(ValidationError):
+        clean_manifest_data(current_manifest)
+
+
+@pytest.mark.parametrize("headers", [None, [], "", False])
+def test_manifest_rejects_non_object_custom_headers(current_manifest, headers):
+    # given
+    current_manifest["webhooks"] = [
+        {
+            "name": "Selected",
+            "targetUrl": "https://example.com/webhook",
+            "query": "subscription { event { ... on OrderCreated { order { id } } } }",
+            "customHeaders": headers,
+        }
+    ]
+    # when
+    with pytest.raises(ValidationError) as error:
+        clean_manifest_data(current_manifest)
+    # then
+    assert any(
+        item.code == AppErrorCode.INVALID_CUSTOM_HEADERS.value
+        for item in error.value.error_dict["webhooks"]
+    )
+
+
+def test_install_without_token_target_creates_no_token(
+    current_manifest, app_installation, mocker
+):
+    # given
+    mocker.patch(
+        "saleor.app.installation_utils.fetch_manifest",
+        return_value=deepcopy(current_manifest),
+    )
+    send = mocker.patch("saleor.app.installation_utils.send_app_token")
+    # when
+    installed, token = install_app(app_installation)
+    # then
+    assert token is None
+    assert not installed.tokens.exists()
+    assert installed.extensions.get().settings == {}
+    send.assert_not_called()
+
+
+def test_extension_clear_requires_cas(app):
+    # given / when
+    with pytest.raises(ValidationError) as error:
+        clean_app_settings(app, {"extensions": []}, {})
+    # then
+    assert error.value.error_dict["expected_version"][0].code == "required"
+    with pytest.raises(ValidationError) as error:
+        clean_app_settings(app, {"extensions": [], "expected_version": 99}, {})
+    assert error.value.error_dict["expected_version"][0].code == "conflict"
+
+
+def test_extension_clear_is_explicit(app_with_extensions):
+    # given
+    app, _ = app_with_extensions
+    original_count = app.extensions.count()
+    assert original_count
+    # when
+    cleaned = clean_app_settings(
+        app, {"extensions": [], "expected_version": app.settings_version}, {}
+    )
+    replace_extensions(app, cleaned["_extensions"])
+    # then
+    assert not app.extensions.exists()
+
+
+APP_SETTINGS_MUTATION = """
+mutation AppSettings($id: ID!, $input: AppInput!) {
+  appUpdate(id: $id, input: $input) {
+    app { id name settingsVersion extensions { id label mountName targetName settings } }
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_graphql_extension_settings_replace_clear_and_stale_version(
+    app, staff_api_client, permission_manage_apps
+):
+    # given
+    import graphene
+
+    from ...graphql.tests.utils import get_graphql_content
+
+    variables = {
+        "id": graphene.Node.to_global_id("App", app.pk),
+        "input": {
+            "expectedVersion": app.settings_version,
+            "extensions": [
+                {
+                    "label": "Open",
+                    "url": "https://example.com/open",
+                    "permissions": [],
+                    "mountName": "ORDER_DETAILS_MORE_ACTIONS",
+                    "targetName": "NEW_TAB",
+                    "settings": {},
+                }
+            ],
+        },
+    }
+    # when
+    response = staff_api_client.post_graphql(
+        APP_SETTINGS_MUTATION, variables, permissions=[permission_manage_apps]
+    )
+    data = get_graphql_content(response)["data"]["appUpdate"]
+    # then
+    assert data["errors"] == []
+    assert data["app"]["settingsVersion"] == 1
+    assert data["app"]["extensions"][0]["settings"] == {}
+    app.refresh_from_db()
+    assert app.settings_version == 1
+    variables["input"] = {
+        "name": "Do not save stale",
+        "extensions": [],
+        "expectedVersion": 0,
+    }
+    response = staff_api_client.post_graphql(APP_SETTINGS_MUTATION, variables)
+    data = get_graphql_content(response)["data"]["appUpdate"]
+    assert data["errors"][0]["code"] == "CONFLICT"
+    app.refresh_from_db()
+    assert app.name != "Do not save stale"
+    assert app.extensions.count() == 1
+    variables["input"]["expectedVersion"] = 1
+    response = staff_api_client.post_graphql(APP_SETTINGS_MUTATION, variables)
+    data = get_graphql_content(response)["data"]["appUpdate"]
+    assert data["errors"] == []
+    assert data["app"]["settingsVersion"] == 2
+    assert data["app"]["extensions"] == []
+
+
+def test_graphql_foreign_extension_id_rolls_back_other_fields(
+    app_with_extensions, staff_api_client, permission_manage_apps
+):
+    # given
+    import graphene
+
+    from ...graphql.tests.utils import get_graphql_content
+
+    owner, extensions = app_with_extensions
+    target = App.objects.create(name="Unchanged", identifier="different-owner")
+    variables = {
+        "id": graphene.Node.to_global_id("App", target.pk),
+        "input": {
+            "name": "Must roll back",
+            "expectedVersion": 0,
+            "extensions": [
+                {
+                    "id": graphene.Node.to_global_id("AppExtension", extensions[0].pk),
+                    "label": "Foreign",
+                    "url": "https://example.com/open",
+                    "permissions": [],
+                    "mountName": "ORDER_DETAILS_MORE_ACTIONS",
+                    "targetName": "NEW_TAB",
+                    "settings": {},
+                }
+            ],
+        },
+    }
+    # when
+    response = staff_api_client.post_graphql(
+        APP_SETTINGS_MUTATION, variables, permissions=[permission_manage_apps]
+    )
+    data = get_graphql_content(response)["data"]["appUpdate"]
+    # then
+    assert data["errors"][0]["code"] == "INVALID"
+    target.refresh_from_db()
+    assert target.name == "Unchanged"
+    assert target.settings_version == 0
+    assert owner.extensions.count() == len(extensions)
+
+
+def test_identifier_unique_constraint(app):
+    # given
+    app.identifier = "nonblank-unique"
+    app.save()
+    # when / then
+    from django.db import IntegrityError, transaction
+
+    with pytest.raises(IntegrityError), transaction.atomic():
+        App.objects.create(name="Duplicate", identifier=app.identifier)
