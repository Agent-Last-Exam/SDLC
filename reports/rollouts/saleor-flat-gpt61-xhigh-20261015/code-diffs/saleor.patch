+def test_order_capture_key_replays_without_second_capture(
+    staff_api_client, permission_group_manage_orders, payment_txn_preauth
+):
+    # Given order-management permission only and a successful authorization.
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    payment = payment_txn_preauth
+    variables = {
+        "id": graphene.Node.to_global_id("Order", payment.order_id),
+        "amount": payment.total,
+        "key": "capture-once",
+    }
+    # When the exact request is retried after all capture capacity is consumed.
+    first = get_graphql_content(staff_api_client.post_graphql(CAPTURE, variables))[
+        "data"
+    ]["orderCapture"]
+    repeated = get_graphql_content(staff_api_client.post_graphql(CAPTURE, variables))[
+        "data"
+    ]["orderCapture"]
+    # Then it replays successfully and has only one financial fact/business event.
+    assert first == repeated
+    assert first["errors"] == []
+    assert (
+        payment.transactions.filter(
+            kind=TransactionKind.CAPTURE, is_success=True
+        ).count()
+        == 1
+    )
+    assert PaymentActionRecord.objects.filter(action="capture").count() == 1
+    variables["amount"] = Decimal(1)
+    conflict = get_graphql_content(staff_api_client.post_graphql(CAPTURE, variables))[
+        "data"
+    ]["orderCapture"]
+    assert conflict["errors"][0]["code"] == "IDEMPOTENCY_CONFLICT"
+
+
+@pytest.mark.parametrize(
+    ("amount", "code"),
+    [
+        (Decimal(0), "INVALID_AMOUNT"),
