+from django.contrib.postgres.fields import ArrayField
+from django.db import migrations, models
+
+import saleor.core.utils.json_serializer
+
+
+class Migration(migrations.Migration):
+    dependencies = [("order", "0217_ordergrantedrefund_reason_reference")]
+
+    operations = [
+        # No historical backfill: the live shipping method cannot prove creation facts.
+        migrations.AddField(
+            model_name="order",
+            name="shipping_method_metadata",
+            field=models.JSONField(
+                blank=True,
+                db_default={},
+                default=dict,
+                encoder=saleor.core.utils.json_serializer.CustomJsonEncoder,
+            ),
+        ),
+        migrations.AddField(
