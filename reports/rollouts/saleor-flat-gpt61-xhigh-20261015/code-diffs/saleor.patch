new file mode 100644
index 000000000..673fa811f
--- /dev/null
+++ b/saleor/app/settings.py
@@ -0,0 +1,173 @@
+"""Validation and atomic replacement shared by App mutation boundaries."""
+
+import graphene
+from django.core.exceptions import ValidationError
+
+from .error_codes import AppErrorCode
+from .manifest_validations import _clean_extensions
+from .models import AppExtension
+from .types import AppExtensionTarget
+
+
+def input_error(field, message, code=AppErrorCode.INVALID):
+    return ValidationError({field: ValidationError(message, code=code.value)})
+
+
+def clean_extension_input(app, extensions, permissions):
+    if not isinstance(extensions, list):
+        raise input_error("extensions", "Expected a list, not null.")
+    existing_ids = set(app.extensions.values_list("pk", flat=True)) if app.pk else set()
+    seen = set()
+    normalized = []
+    from ..permission.enums import get_permissions_enum_list
+
+    permission_names = {value: name for name, value in get_permissions_enum_list()}
+    for item in extensions:
+        extension_id = item.get("id")
+        if extension_id is not None:
+            try:
+                type_name, pk = graphene.Node.from_global_id(extension_id)
+                pk = int(pk)
+            except (TypeError, ValueError):
+                raise input_error("extensions", "Invalid extension id.") from None
+            if type_name != "AppExtension" or pk not in existing_ids or pk in seen:
+                raise input_error(
+                    "extensions",
+                    "Extension id does not belong to this app or is repeated.",
+                )
+            seen.add(pk)
+        else:
+            pk = None
+        for field in ("label", "url"):
+            if not isinstance(item.get(field), str) or not item[field].strip():
+                raise input_error(
+                    "extensions", "Extension label and URL must not be blank."
+                )
+        values = item.get("permissions", [])
+        if (
+            values is None
+            or len(values) != len(set(values))
+            or any(value not in permission_names for value in values)
+        ):
+            raise input_error(
+                "extensions",
+                "Invalid extension permissions.",
+                AppErrorCode.INVALID_PERMISSION,
+            )
+        normalized.append(
+            {
+                "id": pk,
+                "label": item["label"],
+                "url": item["url"],
+                "mountName": item["mount_name"].upper(),
+                "targetName": item["target_name"].upper(),
+                "settings": item["settings"],
+                "permissions": [permission_names[value] for value in values],
+            }
+        )
+    from collections import defaultdict
+
+    errors = defaultdict(list)
+    _clean_extensions(
+        {
+            "extensions": normalized,
+            "appUrl": app.app_url,
+            "tokenTargetUrl": app.token_target_url,
+        },
+        list(permissions),
+        errors,
+    )
+    if errors:
+        raise ValidationError(errors)
+    return normalized
+
+
+def replace_extensions(app, extensions):
+    retained = []
+    for data in extensions:
+        method = (
+            data["settings"].get("method", "GET")
+            if data["targetName"]
+            in (AppExtensionTarget.NEW_TAB, AppExtensionTarget.WIDGET)
+            else None
+        )
+        fields = {
+            "label": data["label"],
+            "url": data["url"],
+            "mount": data["mountName"],
+            "target": data["targetName"],
+            "settings": data["settings"],
+            "http_target_method": method,
+        }
+        if data.get("id"):
+            extension = AppExtension.objects.get(pk=data["id"], app=app)
+            for key, value in fields.items():
+                setattr(extension, key, value)
+            extension.save()
+        else:
+            extension = AppExtension.objects.create(app=app, **fields)
+        extension.permissions.set(data["permissions"])
+        retained.append(extension.pk)
+    app.extensions.exclude(pk__in=retained).delete()
+
+
+def clean_app_settings(instance, data, cleaned_input):
+    for field in ("name", "identifier"):
+        if field in data and (
+            not isinstance(data[field], str) or not data[field].strip()
+        ):
+            raise input_error(field, "A nonblank string is required.")
+    if "identifier" in data:
+        from .models import App
+
+        if (
+            App.objects.not_removed()
+            .filter(identifier=data["identifier"])
+            .exclude(pk=instance.pk)
+            .exists()
+        ):
+            raise input_error(
+                "identifier",
+                "An app with this identifier already exists.",
+                AppErrorCode.UNIQUE,
+            )
+    if "permissions" in data and data["permissions"] is None:
+        raise input_error("permissions", "Expected a list, not null.")
+    if "extensions" in data:
+        expected = data.get("expected_version")
+        if expected is None:
+            raise input_error(
+                "expected_version",
+                "Required when replacing extensions.",
+                AppErrorCode.REQUIRED,
+            )
+        if expected != instance.settings_version:
+            raise input_error(
+                "expected_version",
+                "App settings changed. Refresh and retry.",
+                AppErrorCode.CONFLICT,
+            )
+        cleaned_input["_extensions"] = clean_extension_input(
+            instance,
+            data["extensions"],
+            cleaned_input.get(
+                "permissions", instance.permissions.all() if instance.pk else []
+            ),
+        )
+    elif "permissions" in cleaned_input and instance.pk:
+        allowed = {p.pk for p in cleaned_input["permissions"]}
+        if (
+            AppExtension.permissions.through.objects.filter(
+                appextension__app_id=instance.pk
+            )
+            .exclude(permission_id__in=allowed)
+            .exists()
+        ):
+            raise input_error(
+                "permissions",
+                "Existing extension permissions must remain within app permissions.",
+                AppErrorCode.OUT_OF_SCOPE_PERMISSION,
+            )
+    cleaned_input.pop("extensions", None)
+    cleaned_input.pop("expected_version", None)
+    return cleaned_input
