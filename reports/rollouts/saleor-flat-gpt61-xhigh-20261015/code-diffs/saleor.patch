+@contextmanager
+def lock_staff_accounts_for_deletion(staff_ids):
+    """Lock checkout context before users, without waiting on a reverse FK lock.
+
+    Checkout completion holds a checkout and can acquire a user key-share lock.
+    NOWAIT makes concurrent completion/attachment a safe retryable rejection,
+    rather than a deadlock or deletion of its financial context. Re-read after
+    the user lock to include checkouts attached before that lock was acquired.
+    """
+    from ..checkout.models import Checkout
+
+    database = settings.DATABASE_CONNECTION_DEFAULT_NAME
+    try:
+        with transaction.atomic(using=database):
+            checkouts = (
+                Checkout.objects.using(database)
+                .select_for_update(nowait=True)
+                .filter(user_id__in=staff_ids)
+                .order_by("pk")
+            )
+            list(checkouts)
+            users = list(
+                User.objects.using(database)
+                .select_for_update(nowait=True)
+                .filter(pk__in=staff_ids)
+                .order_by("pk")
+            )
+            if len(users) != len(set(staff_ids)):
+                raise ValidationError(
+                    "The account no longer exists.",
+                    code=AccountErrorCode.NOT_FOUND.value,
+                )
+            list(checkouts.all())
+            yield users
+    except OperationalError as error:
+        if getattr(error.__cause__, "sqlstate", None) != "55P03":
+            raise
+        raise ValidationError(
+            "The account is in use. Retry the deletion.",
+            code=AccountErrorCode.INVALID.value,
+        ) from error
+
