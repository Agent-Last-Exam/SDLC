+from decimal import Decimal
+from unittest.mock import Mock
+
+from ..utils.variant_prices import _update_or_create_listings
+
+
+def test_effective_variant_price_update_notifies_once_after_commit(
+    variant, django_capture_on_commit_callbacks, monkeypatch
+):
+    # given
+    listing = variant.channel_listings.first()
+    listing.discounted_price_amount = Decimal("7.00")
+    manager = Mock()
+    monkeypatch.setattr(
+        "saleor.plugins.manager.get_plugins_manager", lambda **kwargs: manager
+    )
+    # when
+    with django_capture_on_commit_callbacks(execute=True):
+        _update_or_create_listings([], [listing, listing], [], [])
+        assert not manager.product_variant_updated.called
+    # then
+    manager.product_variant_updated.assert_called_once()
+    assert manager.product_variant_updated.call_args.args[0].pk == variant.pk
+
+
+def test_unchanged_effective_variant_price_does_not_notify(
+    variant, django_capture_on_commit_callbacks, monkeypatch
+):
+    # given
+    listing = variant.channel_listings.first()
+    manager = Mock()
+    monkeypatch.setattr(
+        "saleor.plugins.manager.get_plugins_manager", lambda **kwargs: manager
+    )
+    # when
+    with django_capture_on_commit_callbacks(execute=True):
+        _update_or_create_listings([], [listing], [], [])
+    # then
+    manager.product_variant_updated.assert_not_called()
