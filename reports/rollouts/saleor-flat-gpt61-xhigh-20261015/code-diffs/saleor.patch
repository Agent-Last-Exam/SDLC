+"""One authorization boundary for root, Node and nested transaction reads."""
+
+from uuid import UUID
+
+from django.db.models import Q
+from graphql import GraphQLError
+
+from ...app.models import App
+from ...checkout.models import Checkout
+from ...core.exceptions import PermissionDenied
+from ...order import OrderStatus
+from ...order.models import Order
+from ...payment.models import TransactionItem
+from ...permission.enums import OrderPermissions, PaymentPermissions
+from ..account.utils import get_user_accessible_channels
+from ..core.context import get_database_connection_name
+from ..core.utils import from_global_id_or_error
+from ..utils import get_user_or_app_from_context
+
+
+def input_error(message, field=None, code="INPUT_ERROR"):
+    error = GraphQLError(message)
+    error.extensions = {"code": code}
+    if field:
+        error.extensions["field"] = field
+    return error
+
+
+def transaction_lookup(value, *, allow_legacy=True):
+    value = str(value)
+    try:
+        return Q(token=UUID(value))
+    except (ValueError, TypeError):
+        if allow_legacy and value.isdigit():
+            return Q(pk=int(value), use_old_id=True)
+        raise input_error("Invalid transaction identifier.", "id") from None
+
+
+def decode_id(value, typename, *, allow_legacy=False):
+    try:
+        kind, identifier = from_global_id_or_error(value, raise_error=False)
+        if kind != typename or not identifier:
+            raise ValueError
+        if typename == "TransactionItem":
+            transaction_lookup(identifier, allow_legacy=allow_legacy)
+        elif typename in ("Checkout", "Order"):
+            UUID(identifier)
+        return identifier
+    except (ValueError, TypeError):
+        raise input_error(f"Expected a valid {typename} ID.", "id") from None
+
+
+def visible_transactions(info, queryset=None):
+    if queryset is None:
+        queryset = TransactionItem.objects.all()
+    queryset = queryset.using(get_database_connection_name(info.context))
+    requestor = get_user_or_app_from_context(info.context)
+    if not requestor:
+        raise PermissionDenied(permissions=[PaymentPermissions.HANDLE_PAYMENTS])
+    if isinstance(requestor, App):
+        if not requestor.has_perm(PaymentPermissions.HANDLE_PAYMENTS):
+            raise PermissionDenied(permissions=[PaymentPermissions.HANDLE_PAYMENTS])
+        scope = Q(app_id=requestor.pk)
+        if requestor.identifier:
+            scope |= Q(app_identifier=requestor.identifier)
+        return queryset.filter(scope)
+    if requestor.is_staff:
+        if not requestor.has_perm(PaymentPermissions.HANDLE_PAYMENTS):
+            raise PermissionDenied(permissions=[PaymentPermissions.HANDLE_PAYMENTS])
+        channels = [c.pk for c in get_user_accessible_channels(info, requestor)]
+        return queryset.filter(
+            Q(order__channel_id__in=channels) | Q(checkout__channel_id__in=channels)
+        )
+    if not requestor.is_authenticated:
+        raise PermissionDenied(permissions=[PaymentPermissions.HANDLE_PAYMENTS])
+    return queryset.filter(
+        Q(checkout__user_id=requestor.pk)
+        | (Q(order__user_id=requestor.pk) & ~Q(order__status=OrderStatus.DRAFT))
+    )
+
+
+def require_transaction_visible(info, transaction, *, payment_permission=False):
+    queryset = visible_transactions(info, TransactionItem.objects.all())
+    if not queryset.filter(pk=transaction.pk).exists():
+        raise input_error("Transaction not found.", "id", "NOT_FOUND")
+    if payment_permission:
+        requestor = get_user_or_app_from_context(info.context)
+        if not requestor or not requestor.has_perm(PaymentPermissions.HANDLE_PAYMENTS):
+            raise PermissionDenied(permissions=[PaymentPermissions.HANDLE_PAYMENTS])
+
+
+def check_source_access(info, source, *, gift_card=False):
+    requestor = get_user_or_app_from_context(info.context)
+    if isinstance(requestor, App):
+        if not requestor.has_perm(PaymentPermissions.HANDLE_PAYMENTS):
+            raise PermissionDenied(permissions=[PaymentPermissions.HANDLE_PAYMENTS])
+        owned = (
+            source.payment_transactions.filter(
+                Q(app_id=requestor.pk) | Q(app_identifier=requestor.identifier)
+            )
+            if requestor.identifier
+            else source.payment_transactions.filter(app_id=requestor.pk)
+        )
+        if not owned.exists():
+            raise input_error("Object not found.", "id", "NOT_FOUND")
+        return
+    user = requestor
+    if user and user.is_staff:
+        permissions = [PaymentPermissions.HANDLE_PAYMENTS]
+        if isinstance(source, Order):
+            permissions.append(OrderPermissions.MANAGE_ORDERS)
+        if not user.has_perms(permissions):
+            raise PermissionDenied(permissions=permissions)
+        channels = [c.pk for c in get_user_accessible_channels(info, user)]
+        if source.channel_id not in channels:
+            raise input_error("Object not found.", "id", "NOT_FOUND")
+        return
+    if isinstance(source, Checkout):
+        # The checkout Relay ID encodes the unguessable token capability. A logged-in
+        # customer's token must not let them operate another owner's checkout.
+        if source.user_id and (not user or source.user_id != user.pk):
+            raise PermissionDenied(permissions=[PaymentPermissions.HANDLE_PAYMENTS])
+        return
+    if (
+        not user
+        or not user.is_authenticated
+        or source.user_id != user.pk
+        or source.status == OrderStatus.DRAFT
+    ):
+        raise PermissionDenied(permissions=[PaymentPermissions.HANDLE_PAYMENTS])
+
+
+def check_gift_card_cancel_access(info, transaction):
+    if transaction.checkout_id and transaction.checkout:
+        user = getattr(info.context, "user", None)
+        if (
+            not getattr(info.context, "app", None)
+            and not getattr(user, "is_staff", False)
+            and (
+                transaction.checkout.user_id is None
+                or (
+                    user
+                    and user.is_authenticated
+                    and transaction.checkout.user_id == user.pk
+                )
+            )
+        ):
+            # An anonymous checkout plus its unguessable transaction token is the
+            # same narrow consumer capability accepted by initialize/process. This
+            # exception is reached only for the built-in provider's CANCEL action.
+            return
+    require_transaction_visible(info, transaction, payment_permission=True)
