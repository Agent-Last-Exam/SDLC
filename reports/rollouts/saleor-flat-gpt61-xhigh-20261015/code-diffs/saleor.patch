+    assert content["delivery"]["payloadState"] == "WAITING"
+    enqueue.assert_called_once_with(delivery.pk)
+    assert rebuild_delivery_payload(delivery)
+    state.refresh_from_db()
+    assert state.event_id == event.pk
+    assert state.delivery_id == delivery.pk
+    assert state.payload_state == "ready"
+
+
+def test_success_delivery_keeps_minimum_audit(any_webhook):
+    # given
+    delivery = EventDelivery.objects.create(
+        webhook=any_webhook, event_type="order_created", status="success"
+    )
+    # when
+    clear_successful_delivery(delivery)
+    # then
+    assert EventDelivery.objects.filter(pk=delivery.pk).exists()
+    state = DeliveryState.objects.get(delivery=delivery)
+    assert state.confirmed_at
+    assert state.last_error is None
