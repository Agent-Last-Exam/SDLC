@@ -0,0 +1,417 @@
+"""Shared manual/automatic completion claims and successful-payment qualification."""
+
+from datetime import timedelta
+from decimal import Decimal
+
+from django.core.exceptions import ValidationError
+from django.db import transaction
+from django.utils import timezone
+
+from ..channel.models import Channel
+from ..order.models import Order
+from ..payment import ChargeStatus, TransactionKind
+from ..payment.action_reservations import ACTIVE_ACTION_STATES
+from ..payment.models import PaymentActionRecord
+from .error_codes import CheckoutErrorCode
+from .models import Checkout, CheckoutCompletionRecord
+
+LEASE = timedelta(minutes=10)
+HISTORICAL_CONFLICT_MESSAGE = "Multiple historical orders reference this checkout. Manual reconciliation is required."
+
+
+def completion_error(message, code=CheckoutErrorCode.CONFLICT, field="checkout"):
+    return ValidationError({field: ValidationError(message, code=code.value)})
+
+
+def qualification_total(checkout):
+    """Read the current payable without changing the pre-gift-card price cache."""
+    total = checkout.total.gross.amount
+    if checkout.gift_card_amount_basis == "legacy_total_deduction":
+        total = max(total - checkout.get_total_gift_cards_balance().amount, Decimal(0))
+    return total
+
+
+def successful_payment_covers(checkout, total):
+    """Pending statuses/amounts never count as confirmed coverage."""
+    if total <= 0:
+        return False
+    if PaymentActionRecord.objects.filter(
+        source_kind="checkout",
+        source_id=str(checkout.pk),
+        state__in=ACTIVE_ACTION_STATES,
+    ).exists():
+        return False
+    items = list(checkout.payment_transactions.all())
+    if items:
+        if checkout.payments.filter(is_active=True).exists():
+            return False
+        if any(
+            item.currency != checkout.currency
+            or any(
+                getattr(item, field) != 0
+                for field in (
+                    "authorize_pending_value",
+                    "charge_pending_value",
+                    "refund_pending_value",
+                    "cancel_pending_value",
+                )
+            )
+            for item in items
+        ):
+            return False
+        return (
+            sum(
+                (item.authorized_value + item.charged_value for item in items),
+                Decimal(0),
+            )
+            >= total
+        )
+    payment = checkout.get_last_active_payment()
+    if not payment or payment.currency != checkout.currency or payment.to_confirm:
+        return False
+    if payment.charge_status in (
+        ChargeStatus.PENDING,
+        ChargeStatus.REFUSED,
+        ChargeStatus.CANCELLED,
+        ChargeStatus.FULLY_REFUNDED,
+    ):
+        return False
+    txns = list(payment.transactions.order_by("pk"))
+    successful = [txn for txn in txns if txn.is_success]
+    # Historical 3DS/pending entries are immutable facts, not forever-pending
+    # current state. A later successful final action resolves the earlier stage.
+    last_final = max(
+        (
+            txn.pk
+            for txn in successful
+            if not txn.action_required
+            and txn.kind
+            in (
+                TransactionKind.AUTH,
+                TransactionKind.CAPTURE,
+                TransactionKind.CONFIRM,
+                TransactionKind.CANCEL,
+                TransactionKind.VOID,
+                TransactionKind.REFUND,
+                TransactionKind.REFUND_FAILED,
+                TransactionKind.REFUND_REVERSED,
+            )
+        ),
+        default=0,
+    )
+    if any(
+        txn.pk > last_final
+        and (
+            txn.action_required
+            or txn.kind in (TransactionKind.PENDING, TransactionKind.REFUND_ONGOING)
+        )
+        for txn in successful
+    ):
+        return False
+    if payment.captured_amount >= total and any(
+        txn.is_success
+        and not txn.action_required
+        and txn.kind == TransactionKind.CAPTURE
+        for txn in txns
+    ):
+        return True
+    # A void/cancel invalidates earlier authorization even when the legacy boolean
+    # property still reports a historical successful AUTH transaction.
+    last_cancel = max(
+        (
+            txn.pk
+            for txn in txns
+            if txn.is_success
+            and txn.kind in (TransactionKind.VOID, TransactionKind.CANCEL)
+        ),
+        default=0,
+    )
+    authorized = sum(
+        (
+            txn.amount
+            for txn in txns
+            if txn.pk > last_cancel
+            and txn.is_success
+            and not txn.action_required
+            and txn.kind == TransactionKind.AUTH
+        ),
+        Decimal(0),
+    )
+    return payment.charge_status == ChargeStatus.NOT_CHARGED and authorized >= total
+
+
+def automatic_eligibility(checkout, *, now=None, total=None):
+    now = now or timezone.now()
+    channel = checkout.channel
+    if not channel.automatically_complete_fully_paid_checkouts:
+        return "disabled"
+    if (
+        channel.automatic_completion_cutoff_date
+        and checkout.created_at < channel.automatic_completion_cutoff_date
+    ):
+        return "blocked"
+    if checkout.last_change >= now - timedelta(
+        minutes=channel.automatic_completion_delay
+    ):
+        return "waiting"
+    if total is not None and not successful_payment_covers(checkout, total):
+        return "blocked"
+    return None
+
+
+def get_completed_order(checkout_token, *, check_access=None):
+    """Resolve historical orders only when their checkout identity is unambiguous."""
+    orders = list(
+        Order.objects.non_draft()
+        .filter(checkout_token=str(checkout_token))
+        .select_related("channel")
+        .order_by("pk")[:2]
+    )
+    if check_access:
+        for order in orders:
+            check_access(order)
+    if CheckoutCompletionRecord.objects.filter(
+        checkout_token=checkout_token,
+        status="blocked",
+        error_code=CheckoutErrorCode.CONFLICT.value,
+        safe_message=HISTORICAL_CONFLICT_MESSAGE,
+    ).exists():
+        raise completion_error(HISTORICAL_CONFLICT_MESSAGE)
+    if len(orders) > 1:
+        raise completion_error(HISTORICAL_CONFLICT_MESSAGE)
+    return orders[0] if orders else None
+
+
+def claim_completion(checkout, *, automatic=False):
+    now = timezone.now()
+    with transaction.atomic():
+        channel = Channel.objects.select_for_update().get(pk=checkout.channel_id)
+        current = Checkout.objects.select_for_update().filter(pk=checkout.token).first()
+        record, _ = CheckoutCompletionRecord.objects.get_or_create(
+            checkout_token=checkout.token, defaults={"channel": channel}
+        )
+        record = CheckoutCompletionRecord.objects.select_for_update().get(pk=record.pk)
+        try:
+            historical = get_completed_order(checkout.token)
+        except ValidationError:
+            # Persist the safe audit outside the failed claim, without selecting,
+            # deleting, or rewriting either historical order.
+            record.order = None
+            record.status = "blocked"
+            record.error_code = CheckoutErrorCode.CONFLICT.value
+            record.error_field = "checkout"
+            record.safe_message = HISTORICAL_CONFLICT_MESSAGE
+            record.lease_until = record.next_attempt_at = None
+            record.save()
+        else:
+            if record.order_id:
+                return record, record.order
+            if historical:
+                record.order = historical
+                record.status = "completed"
+                record.save(update_fields=["order", "status"])
+                return record, historical
+            if current is None:
+                raise completion_error(
+                    "Checkout was not found.", CheckoutErrorCode.NOT_FOUND
+                )
+            if (
+                record.status == "processing"
+                and record.lease_until
+                and record.lease_until > now
+            ):
+                raise completion_error("This checkout is already being completed.")
+            current.channel = channel
+            if automatic and (state := automatic_eligibility(current, now=now)):
+                record.status = state
+                record.next_attempt_at = (
+                    (
+                        current.last_change
+                        + timedelta(
+                            minutes=channel.automatic_completion_delay, microseconds=1
+                        )
+                    )
+                    if state == "waiting"
+                    else None
+                )
+                record.save(update_fields=["status", "next_attempt_at"])
+                return record, None
+            record.claim_generation += 1
+            record.eligibility_revision = current.version
+            record.attempt_count += 1
+            record.last_attempt_at = now
+            record.lease_until = now + LEASE
+            record.next_attempt_at = None
+            record.status = "processing"
+            record.error_code = record.error_field = record.safe_message = ""
+            record.save()
+            return record, None
+    raise completion_error(HISTORICAL_CONFLICT_MESSAGE)
+
+
+def assert_completion_fence(checkout_info):
+    """Check the original claim within the final Channel -> Checkout transaction."""
+    claim = getattr(checkout_info, "_completion_claim", None)
+    if claim is None:
+        return
+    record = CheckoutCompletionRecord.objects.select_for_update().get(pk=claim.pk)
+    if (
+        record.claim_generation != claim.claim_generation
+        or record.status != "processing"
+        or not record.lease_until
+        or record.lease_until <= timezone.now()
+    ):
+        raise completion_error("The completion claim has expired. Retry safely.")
+    if getattr(checkout_info, "_automatic_completion", False):
+        if record.eligibility_revision != checkout_info.checkout.version:
+            raise completion_error(
+                "Checkout changed after this completion was claimed."
+            )
+        if automatic_eligibility(checkout_info.checkout):
+            raise completion_error("Automatic completion settings or checkout changed.")
+        if not successful_payment_covers(
+            checkout_info.checkout, qualification_total(checkout_info.checkout)
+        ):
+            raise completion_error(
+                "Checkout is not fully paid.", CheckoutErrorCode.CHECKOUT_NOT_FULLY_PAID
+            )
+
+
+def record_completed(checkout_info, order):
+    claim = getattr(checkout_info, "_completion_claim", None)
+    if claim:
+        updated = CheckoutCompletionRecord.objects.filter(
+            pk=claim.pk, claim_generation=claim.claim_generation, status="processing"
+        ).update(
+            order=order,
+            status="completed",
+            lease_until=None,
+            next_attempt_at=None,
+            error_code="",
+            error_field="",
+            safe_message="",
+        )
+        if updated != 1:
+            raise completion_error("The completion claim has changed.")
+
+
+def finish_attempt(claim, *, error=None):
+    values = {"lease_until": None}
+    if error is None:
+        values.update(
+            status="waiting", next_attempt_at=timezone.now() + timedelta(minutes=1)
+        )
+    else:
+        field = "checkout"
+        code = CheckoutErrorCode.INVALID.value
+        if isinstance(error, ValidationError):
+            if hasattr(error, "error_dict"):
+                field, errors = next(iter(error.error_dict.items()))
+                code = errors[0].code or code
+            elif error.error_list:
+                code = error.error_list[0].code or code
+        values.update(
+            status="blocked" if isinstance(error, ValidationError) else "failed",
+            error_code=code,
+            error_field=field,
+            safe_message="Checkout completion could not be completed. Review the checkout and retry.",
+            next_attempt_at=timezone.now() + timedelta(minutes=1),
+        )
+    CheckoutCompletionRecord.objects.filter(
+        pk=claim.pk, claim_generation=claim.claim_generation, status="processing"
+    ).update(**values)
+
+
+def complete_checkout(
+    *, manager, checkout_info, lines, is_automatic_completion=False, **kwargs
+):
+    from .calculations import fetch_checkout_data
+    from .complete_checkout import _complete_checkout_unfenced
+    from .delivery import validate_delivery_selection
+
+    claim, order = claim_completion(
+        checkout_info.checkout, automatic=is_automatic_completion
+    )
+    if order:
+        return order, False, {}
+    if claim.status != "processing":
+        return None, False, {}
+    try:
+        calculation = validate_delivery_selection(checkout_info, manager)
+        fresh_info = calculation.checkout_info
+        from .delivery import install_delivery_calculation
+
+        install_delivery_calculation(fresh_info, calculation)
+        fresh_info._completion_claim = claim
+        fresh_info._automatic_completion = is_automatic_completion
+        fetch_checkout_data(fresh_info, manager, calculation.lines, force_update=True)
+        if is_automatic_completion:
+            # Cache writes above must not be interpreted as a business edit.
+            fresh_info.checkout.refresh_from_db()
+            fresh_info.checkout.channel = Channel.objects.get(
+                pk=fresh_info.checkout.channel_id
+            )
+            if automatic_eligibility(
+                fresh_info.checkout, total=qualification_total(fresh_info.checkout)
+            ):
+                raise completion_error(
+                    "Checkout is not eligible for automatic completion.",
+                    CheckoutErrorCode.CHECKOUT_NOT_FULLY_PAID,
+                )
+        if not calculation.lines:
+            raise completion_error(
+                "Cannot complete checkout without lines.",
+                CheckoutErrorCode.NO_LINES,
+                "lines",
+            )
+        from .checkout_cleaner import clean_billing_address, validate_checkout_email
+
+        validate_checkout_email(fresh_info.checkout)
+        clean_billing_address(fresh_info, CheckoutErrorCode)
+        from ..account.forms import get_address_form
+        from .utils import is_shipping_required
+
+        addresses = [("billing_address", fresh_info.billing_address)]
+        if is_shipping_required(calculation.lines):
+            addresses.append(("shipping_address", fresh_info.shipping_address))
+        for field, address in addresses:
+            if address is not None and not address.validation_skipped:
+                form = get_address_form(address.as_data(), address.country.code)
+                if not form.is_valid():
+                    raise completion_error(
+                        "Checkout address is incomplete or invalid.",
+                        CheckoutErrorCode.MISSING_ADDRESS_DATA,
+                        field,
+                    )
+        if (
+            fresh_info.checkout.payment_transactions.exists() is False
+            and successful_payment_covers(
+                fresh_info.checkout, qualification_total(fresh_info.checkout)
+            )
+        ):
+            # Already successful legacy capture/auth is an existing fact, not a
+            # request to process the same funding source for a second time.
+            from .complete_checkout import create_order_from_checkout
+
+            order = create_order_from_checkout(
+                checkout_info=fresh_info,
+                manager=manager,
+                user=kwargs.get("user"),
+                app=kwargs.get("app"),
+                metadata_list=kwargs.get("metadata_list"),
+                private_metadata_list=kwargs.get("private_metadata_list"),
+                is_automatic_completion=is_automatic_completion,
+            )
+            return order, False, {}
+        result = _complete_checkout_unfenced(
+            manager=manager,
+            checkout_info=fresh_info,
+            lines=calculation.lines,
+            is_automatic_completion=is_automatic_completion,
+            **kwargs,
+        )
+        finish_attempt(claim)
+        return result
+    except Exception as exc:
+        finish_attempt(claim, error=exc)
+        raise
