--- /dev/null
+++ b/saleor/graphql/payment/root_transactions.py
@@ -0,0 +1,147 @@
+import graphene
+from django.db.models import Q
+from graphene.relay import PageInfo
+
+from ..core.connection import from_global_cursor, to_global_cursor
+from ..core.types import BaseInputObjectType
+from .authorization import (
+    decode_id,
+    input_error,
+    visible_transactions,
+)
+from .types import TransactionCountableConnection
+
+
+class RootTransactionFilterInput(BaseInputObjectType):
+    order_ids = graphene.List(graphene.NonNull(graphene.ID))
+    checkout_ids = graphene.List(graphene.NonNull(graphene.ID))
+    ids = graphene.List(graphene.NonNull(graphene.ID))
+    psp_reference = graphene.String()
+    app_identifier = graphene.String()
+
+
+def filter_transactions(info, filters=None):
+    queryset = visible_transactions(info)
+    filters = filters or {}
+    for field, typename in (
+        ("order_ids", "Order"),
+        ("checkout_ids", "Checkout"),
+        ("ids", "TransactionItem"),
+    ):
+        if field not in filters:
+            continue
+        values = filters[field]
+        if values is None:
+            raise input_error("ID lists cannot be null.", field)
+        identifiers = [
+            decode_id(value, typename, allow_legacy=False) for value in values
+        ]
+        if identifiers:
+            from ...payment.models import TransactionItem
+
+            unrestricted = TransactionItem.objects.using(queryset.db).all()
+            if field == "ids":
+                explicit = unrestricted.filter(token__in=identifiers)
+            elif field == "order_ids":
+                explicit = unrestricted.filter(order_id__in=identifiers)
+            else:
+                explicit = unrestricted.filter(
+                    Q(checkout_id__in=identifiers)
+                    | Q(source_checkout_token__in=identifiers)
+                )
+            visible = visible_transactions(info)
+            # A parent can have transactions owned by several Apps. Authorizing the
+            # requested parent must not require access to every one of its payments.
+            # Only an explicitly addressed transaction requires that exact row.
+            if field == "ids":
+                restricted = explicit.exclude(pk__in=visible.values("pk")).exists()
+            elif field == "order_ids":
+                restricted = explicit.exclude(
+                    order_id__in=visible.values("order_id")
+                ).exists()
+            else:
+                restricted = any(
+                    explicit.filter(
+                        Q(checkout_id=identifier) | Q(source_checkout_token=identifier)
+                    ).exists()
+                    and not visible.filter(
+                        Q(checkout_id=identifier) | Q(source_checkout_token=identifier)
+                    ).exists()
+                    for identifier in identifiers
+                )
+            if restricted:
+                raise input_error("Object not found.", field, "NOT_FOUND")
+        if field == "order_ids":
+            queryset = queryset.filter(order_id__in=identifiers)
+        elif field == "checkout_ids":
+            queryset = queryset.filter(
+                Q(checkout_id__in=identifiers)
+                | Q(source_checkout_token__in=identifiers)
+            )
+        else:
+            queryset = queryset.filter(token__in=identifiers)
+    if filters.get("psp_reference") is not None:
+        queryset = queryset.filter(
+            Q(psp_reference=filters["psp_reference"])
+            | Q(events__psp_reference=filters["psp_reference"])
+        ).distinct()
+    if filters.get("app_identifier") is not None:
+        queryset = queryset.filter(app_identifier=filters["app_identifier"])
+    return queryset.order_by("pk")
+
+
+def _cursor(value):
+    if value is None:
+        return None
+    try:
+        decoded = from_global_cursor(value)
+        if not isinstance(decoded, list) or len(decoded) != 1:
+            raise ValueError
+        pk = int(decoded[0])
+        if pk <= 0 or pk > 2147483647 or str(pk) != str(decoded[0]):
+            raise ValueError
+        return pk
+    except (ValueError, TypeError, IndexError):
+        raise input_error("Invalid transaction cursor.") from None
+
+
+def resolve_transaction_connection(info, **args):
+    first, last = args.get("first"), args.get("last")
+    if (first is None) == (last is None):
+        raise input_error("Provide exactly one of first or last.")
+    size = first if first is not None else last
+    if isinstance(size, bool) or not isinstance(size, int) or not 1 <= size <= 100:
+        raise input_error("Page size must be between 1 and 100.")
+    if first is not None and args.get("before") is not None:
+        raise input_error("first cannot be combined with before.")
+    if last is not None and args.get("after") is not None:
+        raise input_error("last cannot be combined with after.")
+    before, after = _cursor(args.get("before")), _cursor(args.get("after"))
+    if before is not None and after is not None and after >= before:
+        raise input_error("Invalid cursor window.")
+    queryset = filter_transactions(info, args.get("filter"))
+    count = queryset.count()
+    if after is not None:
+        queryset = queryset.filter(pk__gt=after)
+    if before is not None:
+        queryset = queryset.filter(pk__lt=before)
+    reverse = last is not None
+    rows = list(queryset.order_by("-pk" if reverse else "pk")[: size + 1])
+    extra = len(rows) > size
+    rows = rows[:size]
+    if reverse:
+        rows.reverse()
+    edges = [
+        TransactionCountableConnection.Edge(node=row, cursor=to_global_cursor([row.pk]))
+        for row in rows
+    ]
+    return TransactionCountableConnection(
+        edges=edges,
+        page_info=PageInfo(
+            has_previous_page=(extra if reverse else after is not None),
+            has_next_page=(before is not None if reverse else extra),
+            start_cursor=edges[0].cursor if edges else None,
+            end_cursor=edges[-1].cursor if edges else None,
+        ),
+        total_count=count,
+    )
