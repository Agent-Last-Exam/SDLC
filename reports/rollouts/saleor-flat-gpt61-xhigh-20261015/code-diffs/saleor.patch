+from types import SimpleNamespace
+
+import pytest
+
+from ...transport.shipping import (
+    ShippingServiceError,
+    get_excluded_shipping_methods_from_response,
+    parse_list_shipping_methods_response,
+    request_shipping_webhook,
+)
+
+
+def test_strict_shipping_explicit_empty_list(app):
+    # given / when / then
+    assert parse_list_shipping_methods_response([], app, "USD", strict=True) == []
+
+
+@pytest.mark.parametrize(
+    "response",
+    [
+        None,
+        {},
+        "[]",
+        [None],
+        [{"id": "a", "name": "A", "amount": "1", "currency": "EUR"}],
+        [{"id": "", "name": "A", "amount": "1", "currency": "USD"}],
+        [{"id": "a", "name": "A", "amount": "NaN", "currency": "USD"}],
+        [{"id": "a", "name": "A", "amount": True, "currency": "USD"}],
+    ],
+)
+def test_strict_shipping_rejects_invalid_response(app, response):
+    # given / when / then
+    with pytest.raises(ShippingServiceError):
+        parse_list_shipping_methods_response(response, app, "USD", strict=True)
+
+
+def test_strict_shipping_bypasses_cache(mocker):
+    # given
+    cached = mocker.patch(
+        "saleor.webhook.transport.shipping.trigger_webhook_sync_if_not_cached"
+    )
+    direct = mocker.patch(
+        "saleor.webhook.transport.shipping.trigger_webhook_sync", return_value=[]
+    )
+    # when
+    assert (
+        request_shipping_webhook(
+            strict=True,
+            event_type="event",
+            webhook=None,
+            payload="",
+            allow_replica=False,
+            cache_data={},
+            cache_timeout=10,
+            request_timeout=2,
+        )
+        == []
+    )
+    # then
+    direct.assert_called_once()
+    cached.assert_not_called()
+
+
+def test_strict_shipping_failure_is_not_empty(mocker):
+    # given
+    mocker.patch(
+        "saleor.webhook.transport.shipping.trigger_webhook_sync", return_value=None
+    )
+    # when / then
+    with pytest.raises(ShippingServiceError):
+        request_shipping_webhook(
+            strict=True,
+            event_type="event",
+            webhook=None,
+            payload="",
+            allow_replica=False,
+        )
+
+
+@pytest.mark.parametrize(
+    "response",
+    [None, {}, {"excluded_methods": None}, {"excluded_methods": [{"id": "invalid"}]}],
+)
+def test_strict_filter_rejects_malformed_response(response):
+    # given / when / then
+    with pytest.raises(ShippingServiceError):
+        get_excluded_shipping_methods_from_response(
+            response, SimpleNamespace(), strict=True
+        )
