+from ....tests.utils import get_graphql_content
+
+pytestmark = pytest.mark.django_db
+
+CAPTURE = """
+mutation($id: ID!, $amount: PositiveDecimal!, $key: String) {
+  orderCapture(id: $id, amount: $amount, idempotencyKey: $key) {
+    order { id } errors { field code }
+  }
+}
+"""
+REFUND = CAPTURE.replace("orderCapture", "orderRefund")
+MARK_PAID = """
+mutation($id: ID!, $key: String, $reference: String) {
+  orderMarkAsPaid(id: $id, idempotencyKey: $key, transactionReference: $reference) {
+    order { id } errors { field code }
