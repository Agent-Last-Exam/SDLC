+"""CAS and atomic configuration regressions for sprint1."""
+
+import graphene
+import pytest
+
+from .....account.models import Group
+from ....tests.utils import get_graphql_content
+
+MUTATION = """
+mutation Update($id: ID!, $input: ChannelUpdateInput!) {
+  channelUpdate(id: $id, input: $input) {
+    channel { id settingsVersion stockSettings { sourceStrategy allocationStrategy }
+      checkoutSettings { automaticallyCompleteFullyPaidCheckouts automaticCompletionDelay automaticCompletionCutoffDate }
+      warehouses { id } }
+    errors { field code message }
+  }
+}
+"""
+
+
+@pytest.fixture(autouse=True)
+def unrestricted_channel_scope(staff_user):
+    group = Group.objects.create(
+        name="Sprint1 channel scope", restricted_access_to_channels=False
+    )
+    group.user_set.add(staff_user)
+
+
+def test_source_only_patch_preserves_allocation_and_requires_version(
+    staff_api_client, permission_manage_channels, channel_USD
+):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Channel", channel_USD.pk),
+        "input": {"stockSettings": {"sourceStrategy": "CHANNEL"}},
+    }
+    allocation = channel_USD.allocation_strategy
+
+    # when
+    missing = get_graphql_content(
+        staff_api_client.post_graphql(
+            MUTATION,
+            variables,
+            permissions=[permission_manage_channels],
+            check_no_permissions=False,
+        )
+    )["data"]["channelUpdate"]
+    variables["input"]["expectedVersion"] = 0
+    saved = get_graphql_content(
+        staff_api_client.post_graphql(
+            MUTATION,
+            variables,
+            permissions=[permission_manage_channels],
+            check_no_permissions=False,
+        )
+    )["data"]["channelUpdate"]
+
+    # then
+    assert missing["errors"][0]["code"] == "REQUIRED"
+    assert saved["errors"] == []
+    assert saved["channel"]["settingsVersion"] == 1
+    assert saved["channel"]["stockSettings"]["sourceStrategy"] == "CHANNEL"
+    channel_USD.refresh_from_db()
+    assert channel_USD.allocation_strategy == allocation
+
+
+def test_stale_channel_settings_do_not_change_configuration(
+    staff_api_client, permission_manage_channels, channel_USD
+):
+    # given
+    channel_USD.settings_version = 4
+    channel_USD.save(update_fields=["settings_version"])
+    variables = {
+        "id": graphene.Node.to_global_id("Channel", channel_USD.pk),
+        "input": {
+            "expectedVersion": 3,
+            "checkoutSettings": {"automaticallyCompleteFullyPaidCheckouts": True},
+        },
+    }
+
+    # when
+    result = get_graphql_content(
+        staff_api_client.post_graphql(
+            MUTATION,
+            variables,
+            permissions=[permission_manage_channels],
+            check_no_permissions=False,
+        )
+    )["data"]["channelUpdate"]
+
+    # then
+    assert result["errors"][0]["code"] == "CONFLICT"
+    channel_USD.refresh_from_db()
+    assert channel_USD.settings_version == 4
+    assert channel_USD.automatically_complete_fully_paid_checkouts is False
