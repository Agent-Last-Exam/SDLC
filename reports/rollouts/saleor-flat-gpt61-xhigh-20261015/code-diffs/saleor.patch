+def migrate_export_permissions_and_domains(apps, schema_editor):
+    alias = schema_editor.connection.alias
+    Permission = apps.get_model("permission", "Permission")
+    ContentType = apps.get_model("contenttypes", "ContentType")
+    for app_label, model_name, old_code, new_code in (
+        ("product", "product", "manage_products", "manage_product_exports"),
+        ("giftcard", "giftcard", "manage_gift_card", "manage_gift_card_exports"),
+        ("discount", "voucher", "manage_discounts", "manage_voucher_exports"),
+    ):
+        content_type, _ = ContentType.objects.using(alias).get_or_create(
+            app_label=app_label, model=model_name
+        )
+        permission, _ = Permission.objects.using(alias).get_or_create(
+            content_type=content_type,
+            codename=new_code,
+            defaults={"name": new_code.replace("_", " ").capitalize()},
+        )
+        old_ids = (
+            Permission.objects.using(alias)
+            .filter(content_type__app_label=app_label, codename=old_code)
+            .values_list("pk", flat=True)
+        )
+        for label, field, owner_field in (
+            ("account.Group", "permissions", "group"),
+            ("app.App", "permissions", "app"),
+            ("account.User", "user_permissions", "user"),
+        ):
+            model = apps.get_model(label)
+            through = getattr(model, field).through
+            owner_ids = (
+                through.objects.using(alias)
+                .filter(permission_id__in=old_ids)
+                .values_list(f"{owner_field}_id", flat=True)
+                .distinct()
+            )
+            through.objects.using(alias).bulk_create(
+                [
+                    through(**{f"{owner_field}_id": pk, "permission_id": permission.pk})
+                    for pk in owner_ids
+                ],
+                ignore_conflicts=True,
+            )
+    # Older jobs did not record a domain. Only recover it where existing events
+    # provide evidence; unknown jobs remain unreadable rather than guessed.
+    ExportFile = apps.get_model("csv", "ExportFile")
+    for job in ExportFile.objects.using(alias).all().iterator(chunk_size=100):
+        domain = ""
+        for event in job.events.using(alias).all():
+            data_type = event.parameters.get("data_type", "")
+            domain = {
+                "products": "products",
+                "gift cards": "gift_cards",
+                "voucher codes": "voucher_codes",
+            }.get(data_type, domain)
+        owner = (
+            f"app:{job.app_id}"
+            if job.app_id
+            else f"user:{job.user_id}"
+            if job.user_id
+            else ""
+        )
+        ExportFile.objects.using(alias).filter(pk=job.pk).update(
+            domain=domain, actor_scope=owner
+        )
+
