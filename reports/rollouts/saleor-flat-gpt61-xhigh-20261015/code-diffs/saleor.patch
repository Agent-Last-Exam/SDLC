+        migrations.AddField(
+            "exportfile",
+            "effective_scope_snapshot",
+            models.JSONField(default=dict, blank=True, encoder=CustomJsonEncoder),
+        ),
+        migrations.AddConstraint(
+            "exportfile",
+            models.UniqueConstraint(
+                fields=("actor_scope", "domain", "idempotency_key"),
+                condition=django.db.models.Q(idempotency_key__isnull=False),
+                name="csv_actor_domain_key_unique",
