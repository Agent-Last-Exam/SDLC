+import csv
+import io
+from types import SimpleNamespace
+
+import graphene
+import pytest
+from django.core.exceptions import ValidationError
+from graphql.language.parser import parse
+from graphql.utils.value_from_ast import value_from_ast
+
+from .....core import JobStatus
+from .....core.exceptions import PermissionDenied
+from .....csv.authorization import (
+    actor_scope,
+    require_export_permission,
+    require_job_access,
+)
+from .....csv.downloads import export_download_url
+from .....csv.models import ExportFile
+from .....csv.tasks import export_effective_scope_task
+from .....permission.enums import (
+    DiscountPermissions,
+    GiftcardPermissions,
+    ProductPermissions,
+)
+from .....permission.models import Permission
+from ....api import schema
+from ....tests.utils import get_graphql_content
+from ...export_scope import submit_export, validate_scope
+
+
+@pytest.fixture
+def product_export_actor(staff_user, permission_manage_products):
+    export_permission = Permission.objects.get(
+        codename=ProductPermissions.MANAGE_PRODUCT_EXPORTS.codename
+    )
+    staff_user.user_permissions.add(permission_manage_products, export_permission)
+    return staff_user
+
+
+@pytest.mark.parametrize(
+    "input",
+    [
+        {"scope": "all", "ids": []},
+        {"scope": "all", "search": "shoe"},
+        {"scope": "filter", "where": {}},
+        {"scope": "filter", "search": "  "},
+        {"scope": "ids", "ids": []},
+        {"scope": "all", "search": None},
+    ],
+)
+def test_current_export_rejects_ambiguous_scope(input):
+    # when / then
+    with pytest.raises(ValidationError):
+        validate_scope(input, "products")
+
+
+def test_voucher_code_export_rejects_empty_selection_even_with_voucher():
+    # when / then: an explicit empty selection must never mean all voucher codes
+    with pytest.raises(ValidationError):
+        validate_scope({"voucher_id": "some-voucher", "ids": []}, "voucher_codes")
+
+
+def test_graphql_export_input_distinguishes_omitted_from_null():
+    # given
+    node = parse(
+        'query { x(input: {scope: ALL, fileType: CSV, idempotencyKey: "one"}) }'
+    )
+    value_node = node.definitions[0].selection_set.selections[0].arguments[0].value
+    # when
+    input = value_from_ast(value_node, schema.get_type("ProductsExportInput"))
+    # then
+    assert "search" not in input
+    validate_scope(input, "products")
+
+
+def test_export_requires_domain_and_dedicated_permission(
+    staff_user, permission_manage_products
+):
+    # given
+    staff_user.user_permissions.add(permission_manage_products)
+    # when / then
+    with pytest.raises(PermissionDenied):
+        require_export_permission(staff_user, "products")
+
+
+def test_current_export_idempotent_snapshot_and_conflict(product_export_actor, product):
+    # given
+    info = SimpleNamespace(context=SimpleNamespace(user=product_export_actor, app=None))
+    input = {"scope": "all", "file_type": "csv", "idempotency_key": "snapshot-one"}
+    # when
+    first = submit_export(info, "products", input)
+    second = submit_export(info, "products", input)
+    # then
+    assert first.pk == second.pk
+    assert str(product.pk) in first.effective_scope_snapshot["ids"]
+    with pytest.raises(ValidationError):
+        submit_export(info, "products", {**input, "file_type": "xlsx"})
+    assert (
+        ExportFile.objects.filter(actor_scope=actor_scope(product_export_actor)).count()
+        == 1
+    )
+
+
+def test_current_export_ids_must_match_effective_filter(product_export_actor, product):
+    # given
+    info = SimpleNamespace(context=SimpleNamespace(user=product_export_actor, app=None))
+    input = {
+        "scope": "ids",
