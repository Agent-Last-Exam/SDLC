+"""Side-effectful Query export resolvers with explicit no-cache semantics."""
+
+from ...core.db.connection import allow_writer
+from ...core.search import search_input_error
+from ..core.context import disallow_replica_in_context
+from ..core.doc_category import DOC_CATEGORY_DISCOUNTS
+from ..core.types import ExportError
+from .export_scope import submit_export
+from .mutations.base_export import BaseExportMutation
+from .mutations.export_gift_cards import ExportGiftCards
+from .mutations.export_products import ExportProducts
+from .mutations.export_voucher_codes import ExportVoucherCodes
+
+
+class ExportVouchers(BaseExportMutation):
+    class Meta:
+        description = "Create an export job for the current effective voucher list."
+        doc_category = DOC_CATEGORY_DISCOUNTS
+        error_type_class = ExportError
+
+    @classmethod
+    def perform_mutation(cls, root, info, *, input):
+        return cls(export_file=submit_export(info, "vouchers", input))
+
+
+@allow_writer()
+def resolve_query_export(info, domain, input):
+    info.context.export_query_no_store = True
+    if getattr(info.context, "method", "POST") == "GET":
+        raise search_input_error("Export queries require POST and must not be cached.")
+    disallow_replica_in_context(info.context)
+    payload = {
+        "products": ExportProducts,
+        "gift_cards": ExportGiftCards,
+        "vouchers": ExportVouchers,
+        "voucher_codes": ExportVoucherCodes,
+    }[domain]
+    from django.core.exceptions import ValidationError
+
+    try:
+        job = submit_export(info, domain, input)
+    except ValidationError as exc:
+        return payload.handle_errors(exc)
+    return payload(export_file=job, errors=[])
