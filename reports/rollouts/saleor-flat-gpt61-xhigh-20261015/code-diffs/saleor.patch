+def test_sprint1_oidc_concurrent_first_association_is_unique(customer_user, id_payload):
+    # given
+    id_payload["email"] = customer_user.email
+    barrier = Barrier(2)
+    original_key = customer_user.jwt_token_key
+    user_count = User.objects.count()
+
+    def associate(_index):
+        close_old_connections()
+        try:
+            barrier.wait(timeout=10)
+            user, created, _ = get_or_create_user_from_payload(
+                dict(id_payload), "https://saleor.io/oauth/authorize"
+            )
+            return user.pk, created, user.password_token_generation, user.jwt_token_key
+        finally:
+            close_old_connections()
+
+    # when
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(associate, range(2)))
+
+    # then
+    assert {result[0] for result in results} == {customer_user.pk}
+    assert not any(result[1] for result in results)
+    assert {result[2] for result in results} == {1}
+    assert len({result[3] for result in results}) == 1
+    assert results[0][3] != original_key
+    assert User.objects.count() == user_count
+    assert ExternalIdentity.objects.count() == 1
+    customer_user.refresh_from_db()
+    assert not customer_user.has_usable_password()
