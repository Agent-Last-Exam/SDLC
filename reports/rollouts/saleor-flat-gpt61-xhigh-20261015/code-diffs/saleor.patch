@@ -0,0 +1,412 @@
+from concurrent.futures import ThreadPoolExecutor
+from decimal import Decimal
+from threading import Barrier
+from types import SimpleNamespace
+
+import pytest
+from django.core.exceptions import ValidationError
+from django.db import close_old_connections, connection
+
+from ...checkout.models import Checkout
+from .. import (
+    GatewayError,
+    PaymentError,
+    TransactionAction,
+    TransactionEventType,
+    TransactionKind,
+)
+from ..action_reservations import available_charge_amount
+from ..checkout_actions import run_checkout_payment_process
+from ..gift_card import card_balances, initialize_gift_card
+from ..interface import GatewayResponse
+from ..models import PaymentActionRecord
+from ..order_actions import available_payment_amount, reconcile_legacy_payment_actions
+from ..summary import get_checkout_payment_summary, get_order_payment_summary
+from ..transaction_actions import reconcile_action, request_transaction_action
+from ..transaction_item_calculations import recalculate_transaction_amounts
+from ..utils import create_failed_transaction_event, gateway_postprocess
+
+pytestmark = pytest.mark.django_db
+
+
+@pytest.fixture
+def checkout_legacy_payment(checkout, payment_dummy):
+    payment_dummy.order = None
+    payment_dummy.checkout = checkout
+    payment_dummy.total = Decimal(10)
+    payment_dummy.save(update_fields=["order", "checkout", "total"])
+    return payment_dummy
+
+
+def response(payment, *, success=True, action_required=False, token="provider-charge"):
+    return GatewayResponse(
+        is_success=success,
+        action_required=action_required,
+        kind=TransactionKind.CAPTURE,
+        amount=payment.total,
+        currency=payment.currency,
+        transaction_id=token,
+        error=None if success else "Declined",
+        raw_response={},
+    )
+
+
+@pytest.mark.django_db(transaction=True)
+@pytest.mark.parametrize(
+    "failure", [TimeoutError("timeout"), GatewayError("invalid response")]
+)
+def test_checkout_unknown_keeps_occupancy_and_does_not_resend(
+    checkout, checkout_legacy_payment, failure
+):
+    # Given an external provider whose outcome cannot be established.
+    calls = []
+
+    def process(gateway, data, **kwargs):
+        assert not connection.in_atomic_block
+        calls.append(data.data["idempotency_key"])
+        raise failure
+
+    manager = SimpleNamespace(process_payment=process)
+    payment = checkout_legacy_payment
+    # When dispatch fails after the reservation has committed.
+    with pytest.raises(type(failure)):
+        run_checkout_payment_process(
+            checkout,
+            payment,
+            manager=manager,
+            channel_slug=checkout.channel.slug,
+            key="process",
+        )
+    record = PaymentActionRecord.objects.get()
+    assert record.state == "unknown"
+    assert record.reserved_amount == payment.total
+    assert not payment.transactions.exists()
+    # Then neither an identical key nor a different key can charge again.
+    for key in ["process", "another"]:
+        with pytest.raises(PaymentError, match="pending reconciliation"):
+            run_checkout_payment_process(
+                checkout,
+                payment,
+                manager=manager,
+                channel_slug=checkout.channel.slug,
+                key=key,
+            )
+    assert calls == [f"checkout-payment:{record.pk}"]
+
+
+def test_checkout_definite_failure_replays_exact_transaction(
+    checkout, checkout_legacy_payment
+):
+    # Given a definite provider refusal, not an exception without a financial fact.
+    payment = checkout_legacy_payment
+    calls = []
+
+    def process(*args, **kwargs):
+        calls.append(True)
+        return response(payment, success=False)
+
+    manager = SimpleNamespace(process_payment=process)
+    with pytest.raises(PaymentError, match="Declined"):
+        run_checkout_payment_process(
+            checkout,
+            payment,
+            manager=manager,
+            channel_slug=checkout.channel.slug,
+            key="refusal",
+        )
+    record = PaymentActionRecord.objects.get()
+    assert record.state == "failed"
+    assert record.reserved_amount == 0
+    # When the exact request is replayed, return its original failed fact.
+    result = run_checkout_payment_process(
+        checkout,
+        payment,
+        manager=manager,
+        channel_slug=checkout.channel.slug,
+        key="refusal",
+    )
+    assert not result.is_success
+    assert result.pk == record.result_data["legacy_transaction_id"]
+    assert calls == [True]
+
+
+def test_checkout_action_required_can_confirm_once(checkout, checkout_legacy_payment):
+    # Given a successful, recognized action-required process phase.
+    payment = checkout_legacy_payment
+    calls = []
+
+    def process(*args, **kwargs):
+        calls.append("process")
+        return response(payment, action_required=True)
+
+    def confirm(*args, **kwargs):
+        calls.append("confirm")
+        return response(payment, token="provider-confirm")
+
+    manager = SimpleNamespace(process_payment=process, confirm_payment=confirm)
+    first = run_checkout_payment_process(
+        checkout,
+        payment,
+        manager=manager,
+        channel_slug=checkout.channel.slug,
+        key="process",
+    )
+    assert first.action_required
+    payment.refresh_from_db()
+    assert payment.to_confirm
+    assert payment.captured_amount == 0
+    final = run_checkout_payment_process(
+        checkout,
+        payment,
+        manager=manager,
+        channel_slug=checkout.channel.slug,
+        key="confirm",
+    )
+    repeated = run_checkout_payment_process(
+        checkout,
+        payment,
+        manager=manager,
+        channel_slug=checkout.channel.slug,
+        key="confirm",
+    )
+    assert repeated.pk == final.pk
+    payment.refresh_from_db()
+    assert payment.captured_amount == 10
+    assert not PaymentActionRecord.objects.exclude(reserved_amount=0).exists()
+    assert calls == ["process", "confirm"]
+
+
+def test_checkout_qualification_rejects_before_ledger_but_not_replay(
+    checkout, checkout_legacy_payment
+):
+    # Given a final local fence which rejects changed completion qualification.
+    payment = checkout_legacy_payment
+    calls = []
+
+    def reject(locked_checkout, locked_payment):
+        assert connection.in_atomic_block
+        assert locked_checkout.pk == checkout.pk
+        assert locked_payment.pk == payment.pk
+        raise ValidationError("Qualification changed", code="conflict")
+
+    manager = SimpleNamespace(
+        process_payment=lambda *args, **kwargs: calls.append(True) or response(payment)
+    )
+    with pytest.raises(ValidationError, match="Qualification changed"):
+        run_checkout_payment_process(
+            checkout,
+            payment,
+            manager=manager,
+            channel_slug=checkout.channel.slug,
+            key="fenced",
+            qualification=reject,
+        )
+    assert not PaymentActionRecord.objects.exists()
+    assert calls == []
+    # When an already confirmed request is replayed, the old result wins.
+    first = run_checkout_payment_process(
+        checkout,
+        payment,
+        manager=manager,
+        channel_slug=checkout.channel.slug,
+        key="fenced",
+    )
+    repeated = run_checkout_payment_process(
+        checkout,
+        payment,
+        manager=manager,
+        channel_slug=checkout.channel.slug,
+        key="fenced",
+        qualification=reject,
+    )
+    assert repeated.pk == first.pk
+    assert calls == [True]
+
