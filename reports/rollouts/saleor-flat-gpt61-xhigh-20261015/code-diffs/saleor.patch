diff --git a/saleor/webhook/outbox.py b/saleor/webhook/outbox.py
new file mode 100644
index 000000000..edffe2feb
--- /dev/null
+++ b/saleor/webhook/outbox.py
@@ -0,0 +1,235 @@
+import hashlib
+import json
+
+from django.conf import settings
+from django.db import transaction
+from django.utils.dateparse import parse_datetime
+from django.utils.functional import LazyObject
+
+from ..celeryconf import app
+from ..core import EventDeliveryStatus
+from ..core.db.connection import allow_writer
+from ..core.models import EventDelivery, EventPayload
+from ..core.utils.lazyobjects import unwrap_lazy
+from .models import BusinessEvent, DeliveryState
+from .snapshots import capture_snapshot, restore_snapshot
+
+
+def enqueue_snapshot_event(
+    event_type,
+    webhooks,
+    source,
+    requestor=None,
+    request_time=None,
+    queue=None,
+    *,
+    source_key=None,
+):
+    """Persist facts and receiver identities before queuing any payload work."""
+    if isinstance(requestor, LazyObject):
+        requestor = unwrap_lazy(requestor)
+    snapshot = capture_snapshot(source)
+    identity = (
+        "explicit:" + str(source_key)
+        if source_key is not None
+        else json.dumps(snapshot, sort_keys=True, separators=(",", ":"))
+    )
+    source_key = hashlib.sha256(identity.encode()).hexdigest()
+    if request_time:
+        snapshot["request_time"] = request_time.isoformat()
+    with transaction.atomic():
+        event, _ = BusinessEvent.objects.get_or_create(
+            event_type=event_type,
+            source_key=source_key,
+            defaults={
+                "snapshot": snapshot,
+                "requestor_label": requestor._meta.label_lower
+                if requestor is not None
+                else "",
+                "requestor_id": str(requestor.pk) if requestor is not None else "",
+            },
+        )
+        # Serialize receiver creation for the same local event. A committed
+        # successful receiver remains attached and will never be sent again.
+        BusinessEvent.objects.select_for_update().get(pk=event.pk)
+        for webhook in webhooks:
+            if DeliveryState.objects.filter(event=event, webhook=webhook).exists():
+                continue
+            delivery = EventDelivery.objects.create(
+                webhook=webhook,
+                event_type=event_type,
+                status=EventDeliveryStatus.PENDING,
+            )
+            DeliveryState.objects.create(
+                delivery=delivery,
+                event=event,
+                webhook=webhook,
+                subscription_query=webhook.subscription_query or "",
+            )
+            transaction.on_commit(
+                lambda pk=delivery.pk: build_delivery_payload.apply_async(
+                    args=[pk, queue], queue=queue or settings.WEBHOOK_CELERY_QUEUE_NAME
+                )
+            )
+    return event
+
+
+def enqueue_order_created_event(order, source_key, requestor=None):
+    """Persist completion receivers on the writer inside the order transaction."""
+    from .event_types import WebhookEventAsyncType
+    from .utils import get_webhooks_for_event
+
+    event_type = WebhookEventAsyncType.ORDER_CREATED
+    webhooks = [
+        webhook
+        for webhook in get_webhooks_for_event(event_type).using(
+            settings.DATABASE_CONNECTION_DEFAULT_NAME
+        )
+        if not webhook.filterable_channel_slugs
+        or order.channel.slug in webhook.filterable_channel_slugs
+    ]
+    order._webhook_event_source_key = source_key
+    return enqueue_snapshot_event(
+        event_type,
+        webhooks,
+        order,
+        requestor=requestor,
+        queue=settings.ORDER_WEBHOOK_EVENTS_CELERY_QUEUE_NAME,
+        source_key=source_key,
+    )
+
+
+@transaction.atomic
+def rebuild_delivery_payload(delivery):
+    # Retain a database claim while executing local selection resolvers. A second
+    # builder waits, then observes the existing payload rather than publishing a
+    # second file or overwriting a receiver's completed payload.
+    current = EventDelivery.objects.select_for_update().get(pk=delivery.pk)
+    if current.payload_id:
+        delivery.payload = current.payload
+        return True
+    if current.status == EventDeliveryStatus.SUCCESS:
+        return False
+    state, _ = DeliveryState.objects.get_or_create(
+        delivery=delivery,
+        defaults={
+            "webhook": delivery.webhook,
+            "payload_state": "ready" if delivery.payload_id else "waiting",
+        },
+    )
+    if not state.event_id:
+        state.payload_state = "failed"
+        state.last_error = "Payload is unavailable and no event snapshot was retained."
+        state.save(update_fields=["payload_state", "last_error"])
+        EventDelivery.objects.filter(pk=delivery.pk).update(
+            status=EventDeliveryStatus.FAILED
+        )
+        return False
+    event = state.event
+    try:
+        if (
+            not delivery.webhook.app.is_active
+            or delivery.webhook.app.removed_at
+            or not delivery.webhook.is_active
+        ):
+            raise ValueError("Receiver inactive.")
+        from .event_types import WebhookEventAsyncType
+
+        permission = WebhookEventAsyncType.PERMISSIONS.get(delivery.event_type)
+        if permission and not delivery.webhook.app.has_perm(permission):
+            raise ValueError("Receiver permission changed.")
+        source, objects = restore_snapshot(event.snapshot)
+        requestor = None
+        if event.requestor_label in ("app.app", "account.user"):
+            from django.apps import apps
+
+            requestor = (
+                apps.get_model(event.requestor_label)
+                .objects.filter(pk=event.requestor_id)
+                .first()
+            )
+        if state.subscription_query:
+            from ..graphql.webhook.subscription_payload import (
+                generate_payload_from_subscription,
+                initialize_request,
+            )
+
+            request = initialize_request(
+                requestor=requestor,
+                event_type=delivery.event_type,
+                request_time=(
+                    parse_datetime(event.snapshot["request_time"])
+                    if event.snapshot.get("request_time")
+                    else event.created_at
+                ),
+                allow_replica=False,
+            )
+            request._webhook_snapshot_objects = objects
+            data = generate_payload_from_subscription(
+                delivery.event_type,
+                source,
+                state.subscription_query,
+                request,
+                app=delivery.webhook.app,
+            )
+            if not data or data.get("errors"):
+                raise ValueError("Selection could not be built from the snapshot.")
+            payload_text = json.dumps(data)
+        else:
+            # Legacy serialization is also deferred and receives only restored
+            # event-time objects; never regenerate from the changed live source.
+            from .payloads import generate_fulfillment_payload, generate_order_payload
+
+            node = source.get("fulfillment") if isinstance(source, dict) else source
+            if isinstance(node, list):
+                payload_text = json.dumps(
+                    [generate_order_payload(order, requestor) for order in node]
+                )
+            elif node._meta.label_lower == "order.fulfillment":
+                payload_text = generate_fulfillment_payload(node, requestor)
+            else:
+                payload_text = generate_order_payload(node, requestor)
+        with transaction.atomic():
+            payload = EventPayload.objects.create_with_payload_file(payload_text)
+            delivery.payload = payload
+            delivery.save(update_fields=["payload"])
+            state.payload_state = "ready"
+            state.last_error = None
+            state.save(update_fields=["payload_state", "last_error"])
+        return True
+    except Exception:
+        state.payload_state = "failed"
+        state.last_error = (
+            "Unable to build the selected payload from retained event facts."
+        )
+        state.save(update_fields=["payload_state", "last_error"])
+        EventDelivery.objects.filter(pk=delivery.pk).update(
+            status=EventDeliveryStatus.FAILED
+        )
+        return False
+
+
+@app.task
+@allow_writer()
+def build_delivery_payload(delivery_id, queue=None):
+    delivery = (
+        EventDelivery.objects.select_related("webhook__app", "payload")
+        .filter(pk=delivery_id)
+        .first()
+    )
+    if delivery is None or delivery.status == EventDeliveryStatus.SUCCESS:
+        return
+    if not delivery.payload_id and not rebuild_delivery_payload(delivery):
+        return
+    from ..core.telemetry import get_task_context
+    from .transport.asynchronous.transport import send_webhook_request_async
+
+    transaction.on_commit(
+        lambda: send_webhook_request_async.apply_async(
+            kwargs={
+                "event_delivery_id": delivery.pk,
+                "telemetry_context": get_task_context().to_dict(),
+            },
+            queue=queue or settings.WEBHOOK_CELERY_QUEUE_NAME,
+        )
+    )
diff --git a/saleor/webhook/snapshots.py b/saleor/webhook/snapshots.py
new file mode 100644
index 000000000..0ebe82ed7
--- /dev/null
+++ b/saleor/webhook/snapshots.py
@@ -0,0 +1,290 @@
+"""Event-time model facts for background webhook selection execution.
+
+This is an internal recipe, not a GraphQL payload. No resolvers, tax/shipping
+services or App-specific fields execute in the business request.
+"""
+
+import json
+
+from django.apps import apps
+from django.core.serializers.json import DjangoJSONEncoder
+from django.db import models
+from django.utils.encoding import is_protected_type
+
+
+class SnapshotUnavailable(Exception):
+    pass
+
+
+def capture_snapshot(source):
+    records = {}
+    relations = {}
+
+    def field_value(field, instance):
+        value = field.value_from_object(instance)
+        # Match Django's serialization boundary. Measurements, countries and
+        # phone numbers are not JSON primitives, but their fields know how to
+        # serialize and restore them. JSON facts must remain structured values.
+        if isinstance(field, models.JSONField) or is_protected_type(value):
+            return value
+        return field.value_to_string(instance)
+
+    def capture(instance):
+        if not isinstance(instance, models.Model):
+            if isinstance(instance, dict):
+                return {
+                    "dict": {key: capture(value) for key, value in instance.items()}
+                }
+            if isinstance(instance, tuple | list):
+                return {"list": [capture(value) for value in instance]}
+            return {"value": instance}
+        key = f"{instance._meta.label_lower}:{instance.pk}"
+        if key in records:
+            return {"ref": key}
+        records[key] = {
+            "model": instance._meta.label_lower,
+            "fields": {
+                field.attname: field_value(field, instance)
+                for field in instance._meta.concrete_fields
+            },
+        }
+        model = instance._meta.label_lower
+        related = {}
+        if model == "order.order":
+            for name in (
+                "lines",
+                "fulfillments",
+                "discounts",
+                "payments",
+                "payment_transactions",
+                "events",
+            ):
+                related[name] = [
+                    capture(value) for value in getattr(instance, name).all()
+                ]
+            for name in (
+                "billing_address",
+                "shipping_address",
+                "channel",
+                "shipping_method",
+                "collection_point",
+                "user",
+            ):
+                value = getattr(instance, name, None)
+                related[name] = capture(value)
+        elif model == "order.orderline":
+            related["variant"] = capture(instance.variant)
+            related["discounts"] = [
+                capture(value) for value in instance.discounts.all()
+            ]
+            related["allocations"] = [
+                capture(value)
+                for value in instance.allocations.select_related(
+                    "stock__warehouse"
+                ).all()
+            ]
+        elif model == "product.productvariant":
+            related["product"] = capture(instance.product)
+        elif model == "product.product":
+            related["product_type"] = capture(instance.product_type)
+        elif model == "warehouse.allocation":
+            related["stock"] = capture(instance.stock)
+        elif model == "warehouse.stock":
+            related["warehouse"] = capture(instance.warehouse)
+        elif model == "warehouse.warehouse":
+            related["address"] = capture(instance.address)
+        elif model == "shipping.shippingmethod":
+            related["channel_listings"] = [
+                capture(value) for value in instance.channel_listings.all()
+            ]
+        elif model == "order.fulfillment":
+            related["order"] = capture(instance.order)
+            related["lines"] = [capture(value) for value in instance.lines.all()]
+        elif model == "order.fulfillmentline":
+            related["order_line"] = capture(instance.order_line)
+            related["stock"] = capture(instance.stock)
+        relations[key] = related
+        return {"ref": key}
+
+    root = capture(source)
+    return json.loads(
+        json.dumps(
+            {"root": root, "records": records, "relations": relations},
+            cls=DjangoJSONEncoder,
+        )
+    )
+
+
+def restore_snapshot(snapshot):
+    objects = {}
+    for key, record in snapshot["records"].items():
+        model = apps.get_model(record["model"])
+        values = {}
+        for field in model._meta.concrete_fields:
+            value = record["fields"][field.attname]
+            values[field.attname] = (
+                value if isinstance(field, models.JSONField) else field.to_python(value)
+            )
+        obj = model(**values)
+        obj._state.adding = False
+        obj._webhook_snapshot = True
+        objects[key] = obj
+
+    def restore(value):
+        if "ref" in value:
+            return objects[value["ref"]]
+        if "dict" in value:
+            return {key: restore(item) for key, item in value["dict"].items()}
+        if "list" in value:
+            return [restore(item) for item in value["list"]]
+        return value["value"]
+
+    for key, related in snapshot["relations"].items():
+        obj = objects[key]
+        obj._prefetched_objects_cache = {}
+        for name, value in related.items():
+            if isinstance(value, list):
+                queryset = getattr(obj, name).all()
+                queryset._result_cache = [restore(item) for item in value]
+                queryset._prefetch_done = True
+                obj._prefetched_objects_cache[name] = queryset
+            else:
+                field = obj._meta.get_field(name)
+                field.set_cached_value(obj, restore(value))
+    root = restore(snapshot["root"])
+    return root, list(objects.values())
+
+
+def prime_snapshot_loaders(request, objects):
+    from ..graphql.account.dataloaders import AddressByIdLoader, UserByUserIdLoader
+    from ..graphql.channel.dataloaders.by_order import ChannelByOrderIdLoader
+    from ..graphql.channel.dataloaders.by_self import (
+        ChannelByIdLoader,
+        ChannelBySlugLoader,
+    )
+    from ..graphql.discount.dataloaders import (
+        OrderDiscountsByOrderIDLoader,
+        OrderLineDiscountsByOrderLineIDLoader,
+    )
+    from ..graphql.order.dataloaders import (
+        AllocationsByOrderLineIdLoader,
+        FulfillmentLinesByFulfillmentIdLoader,
+        FulfillmentsByOrderIdLoader,
+        OrderByIdLoader,
+        OrderEventsByOrderIdLoader,
+        OrderLineByIdLoader,
+        OrderLinesByOrderIdLoader,
+        TransactionItemsByOrderIDLoader,
+    )
+    from ..graphql.warehouse.dataloaders import StockByIdLoader, WarehouseByIdLoader
+    from ..payment.dataloaders import PaymentsByOrderIdLoader
+
+    mapping = {
+        "order.order": OrderByIdLoader,
+        "order.orderline": OrderLineByIdLoader,
+        "account.address": AddressByIdLoader,
+        "account.user": UserByUserIdLoader,
+        "channel.channel": ChannelByIdLoader,
+        "warehouse.stock": StockByIdLoader,
+        "warehouse.warehouse": WarehouseByIdLoader,
+    }
+    for obj in objects:
+        if loader := mapping.get(obj._meta.label_lower):
+            loader(request).prime(obj.pk, obj)
+        if obj._meta.label_lower == "channel.channel":
+            ChannelBySlugLoader(request).prime(obj.slug, obj)
+        if obj._meta.label_lower == "order.orderline":
+            AllocationsByOrderLineIdLoader(request).prime(
+                obj.pk, list(obj.allocations.all())
+            )
+            OrderLineDiscountsByOrderLineIDLoader(request).prime(
+                obj.pk, list(obj.discounts.all())
+            )
+        if obj._meta.label_lower == "order.order":
+            ChannelByOrderIdLoader(request).prime(obj.pk, obj.channel)
+            OrderDiscountsByOrderIDLoader(request).prime(
+                obj.pk, list(obj.discounts.all())
+            )
+            PaymentsByOrderIdLoader(request).prime(obj.pk, list(obj.payments.all()))
+            TransactionItemsByOrderIDLoader(request).prime(
+                obj.pk, list(obj.payment_transactions.all())
+            )
+            # Async event selections use persisted facts. Do not recalculate a
+            # historical draft against today's discounts/taxes/shipping rules.
+            obj._webhook_snapshot_lines = list(obj.lines.all())
+            OrderLinesByOrderIdLoader(request).prime(obj.pk, list(obj.lines.all()))
+            FulfillmentsByOrderIdLoader(request).prime(
+                obj.pk, list(obj.fulfillments.all())
+            )
+            OrderEventsByOrderIdLoader(request).prime(obj.pk, list(obj.events.all()))
+        if obj._meta.label_lower == "order.fulfillment":
+            FulfillmentLinesByFulfillmentIdLoader(request).prime(
+                obj.pk, list(obj.lines.all())
+            )
+
+
+class SnapshotMiddleware:
+    def resolve(self, next_, root, info, **kwargs):
+        node = getattr(root, "node", root)
+        if isinstance(node, models.Model):
+            if not getattr(node, "_webhook_snapshot", False):
+                if node is getattr(info.context, "app", None) or node is getattr(
+                    info.context, "requestor", None
+                ):
+                    return next_(root, info, **kwargs)
+                raise SnapshotUnavailable(
+                    "Selected relation was not captured at event time."
+                )
+            # Historical prices are persisted facts, not an invitation to invoke
+            # a tax/shipping calculation or write recalculated live order data.
+            attributes = {
+                "shippingPrice": "shipping_price",
+                "shippingTaxRate": "shipping_tax_rate",
+                "total": "total",
+                "undiscountedTotal": "undiscounted_total",
+                "unitPrice": "unit_price",
+                "totalPrice": "total_price",
+                "undiscountedUnitPrice": "undiscounted_unit_price",
+                "undiscountedTotalPrice": "undiscounted_total_price",
+                "undiscountedShippingPrice": "undiscounted_base_shipping_price",
+                "unitDiscount": "unit_discount",
+                "unitDiscountValue": "unit_discount_value",
+                "unitDiscountType": "unit_discount_type",
+                "taxRate": "tax_rate",
+            }
+            if (
+                node._meta.label_lower == "order.orderline"
+                and info.field_name == "discounts"
+            ):
+                return list(node.discounts.all())
+            if node._meta.label_lower == "order.order":
+                if info.field_name in {
+                    "availableShippingMethods",
+                    "shippingMethods",
+                    "availableCollectionPoints",
+                }:
+                    raise SnapshotUnavailable(
+                        "Live delivery eligibility is not an event-time fact."
+                    )
+                if info.field_name == "discounts":
+                    return list(node.discounts.all())
+            if (
+                node._meta.label_lower == "order.order"
+                and info.field_name == "subtotal"
+            ):
+                from decimal import Decimal
+
+                from prices import Money, TaxedMoney
+
+                zero = TaxedMoney(
+                    Money(Decimal(0), node.currency), Money(Decimal(0), node.currency)
+                )
+                return sum(
+                    (line.total_price for line in node._webhook_snapshot_lines), zero
+                )
+            if (
+                node._meta.label_lower in ("order.order", "order.orderline")
+                and info.field_name in attributes
+            ):
+                return getattr(node, attributes[info.field_name])
+        return next_(root, info, **kwargs)
