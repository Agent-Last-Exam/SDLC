+++ b/saleor/csv/downloads.py
@@ -0,0 +1,85 @@
+"""Short-lived, authenticated access to private export storage."""
+
+from pathlib import PurePosixPath
+from urllib.parse import urlencode
+
+from django.conf import settings
+from django.core import signing
+from django.http import FileResponse, HttpResponseForbidden, HttpResponseNotFound
+from django.urls import reverse
+from django.utils import timezone
+from django.utils.cache import patch_vary_headers
+from django.views.decorators.http import require_GET
+
+from ..core import JobStatus
+from ..core.db.connection import allow_writer
+from ..core.exceptions import PermissionDenied
+from ..core.utils import build_absolute_uri
+from ..graphql.app.dataloaders import get_app_promise
+from ..graphql.context import get_context_value
+from ..graphql.utils import get_user_or_app_from_context
+from .authorization import actor_for_job, require_job_access
+from .models import ExportFile
+from .utils.effective_export import authorized_snapshot_queryset
+
+DOWNLOAD_SALT = "saleor.csv.export-download"
+
+
+def export_download_url(job):
+    actor_for_job(job)
+    if job.status != JobStatus.SUCCESS or not job.content_file:
+        return None
+    token = signing.dumps(
+        {"job": job.pk, "actor": job.actor_scope, "file": job.content_file.name},
+        salt=DOWNLOAD_SALT,
+    )
+    return build_absolute_uri(
+        reverse("export-download", kwargs={"export_file_id": job.pk})
+        + "?"
+        + urlencode({"token": token})
+    )
+
+
+@require_GET
+@allow_writer()
+def download_export(request, export_file_id):
+    request.allow_replica = False
+    context = get_context_value(request)
+    context.app = get_app_promise(context).get()
+    actor = get_user_or_app_from_context(context)
+    try:
+        job = ExportFile.objects.get(pk=export_file_id)
+        require_job_access(job, actor)
+        token = signing.loads(
+            request.GET.get("token", ""),
+            salt=DOWNLOAD_SALT,
+            max_age=settings.EXPORT_FILES_TIMEDELTA.total_seconds(),
+        )
+        if token != {
+            "job": job.pk,
+            "actor": job.actor_scope,
+            "file": job.content_file.name,
+        }:
+            raise signing.BadSignature()
+        if (
+            job.status != JobStatus.SUCCESS
+            or not job.content_file
+            or timezone.now() - job.updated_at > settings.EXPORT_FILES_TIMEDELTA
+        ):
+            response = HttpResponseNotFound()
+        else:
+            # A signature is not authority. Recheck object/channel/field scope
+            # after authenticating the current staff user or App.
+            authorized_snapshot_queryset(job)
+            response = FileResponse(
+                job.content_file.open("rb"),
+                as_attachment=True,
+                filename=PurePosixPath(job.content_file.name).name,
+            )
+    except (PermissionDenied, signing.BadSignature):
+        response = HttpResponseForbidden()
+    except (ExportFile.DoesNotExist, FileNotFoundError):
+        response = HttpResponseNotFound()
+    response["Cache-Control"] = "private, no-store"
+    patch_vary_headers(response, ["Authorization", "Cookie"])
+    return response
