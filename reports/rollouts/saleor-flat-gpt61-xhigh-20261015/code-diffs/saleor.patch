+import graphene
+from django.core.exceptions import ValidationError
+from graphql.error.base import GraphQLError
+
+from ....core.db.connection import allow_writer
+from ...core import ResolveInfo
+from ...core.mutations import BaseMutation
+from ...core.types import MetadataError, NonNullList
+from ..inputs import AtomicMetadataUpdateInput
+from ..types import MetadataBundle, metadata_bundle_for_target
+from .utils import resolve_target, validate_patch, write_metadata_targets
+
+
+def prepare_targets(info, inputs, *, bulk=True):
+    if not inputs:
+        raise ValidationError(
+            {
+                "input": ValidationError(
+                    "At least one metadata object is required.", code="required"
+                )
+            }
+        )
+    # Complete input validation precedes resolution and CheckoutMetadata creation.
+    for index, patch in enumerate(inputs):
+        prefix = f"input.{index}." if bulk else "input."
+        validate_patch(patch, field_prefix=prefix)
+    targets = []
+    seen = set()
+    for index, patch in enumerate(inputs):
+        prefix = f"input.{index}." if bulk else "input."
+        try:
+            target = resolve_target(info, patch["id"], patch)
+        except GraphQLError as exc:
+            raise ValidationError(
+                {
+                    f"{prefix}id": ValidationError(
+                        "Invalid metadata object ID.", code="invalid"
+                    )
+                }
+            ) from exc
+        except ValidationError as exc:
+            if hasattr(exc, "error_dict"):
+                raise ValidationError(
+                    {
+                        f"{prefix}{field}": errors
+                        for field, errors in exc.error_dict.items()
+                    }
+                ) from exc
+            raise ValidationError({f"{prefix}id": exc}) from exc
+        target.error_prefix = prefix
+        key = target.instance._meta.label_lower, str(target.instance.pk)
+        if key in seen:
+            raise ValidationError(
+                {
+                    f"{prefix}id": ValidationError(
+                        "A metadata object cannot occur twice.", code="invalid"
+                    )
+                }
+            )
+        seen.add(key)
+        targets.append(target)
+    return targets
+
+
+class AtomicMetadataUpdate(BaseMutation):
+    metadata_bundle = graphene.Field(MetadataBundle)
+
+    class Arguments:
+        input = AtomicMetadataUpdateInput(required=True)
+
+    class Meta:
+        description = "Atomically update business public and private metadata using its current version."
+        error_type_class = MetadataError
+
+    @classmethod
+    @allow_writer()
+    def perform_mutation(cls, _root, info: ResolveInfo, /, *, input):
+        targets = prepare_targets(info, [input], bulk=False)
+        write_metadata_targets(info, targets)
+        return cls(
+            metadata_bundle=metadata_bundle_for_target(targets[0], info), errors=[]
+        )
+
+
+class AtomicMetadataBulkUpdate(BaseMutation):
+    metadata_bundles = NonNullList(MetadataBundle, required=True)
+
+    class Arguments:
+        input = NonNullList(AtomicMetadataUpdateInput, required=True)
+
+    class Meta:
+        description = (
+            "Atomically update all business metadata objects, or write none of them."
+        )
+        error_type_class = MetadataError
+
+    @classmethod
+    def handle_errors(cls, error):
+        result = super().handle_errors(error)
+        result.metadata_bundles = []
+        return result
+
+    @classmethod
+    @allow_writer()
+    def perform_mutation(cls, _root, info: ResolveInfo, /, *, input):
+        targets = prepare_targets(info, input)
+        write_metadata_targets(info, targets)
+        return cls(
+            metadata_bundles=[
+                metadata_bundle_for_target(target, info) for target in targets
+            ],
+            errors=[],
+        )
