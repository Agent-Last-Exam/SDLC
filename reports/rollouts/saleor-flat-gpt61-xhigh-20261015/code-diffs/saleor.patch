+import django.db.models.deletion
+from django.conf import settings
+from django.contrib.auth.hashers import make_password
+from django.db import migrations, models
+
+
+def protect_existing_external_accounts(apps, schema_editor):
+    """Existing OIDC metadata is evidence of a link, not proof of an issuer.
+
+    Disable its old password path now. The first verified provider login creates
+    the issuer/subject identity; never invent or merge identities during backfill.
+    """
+    User = apps.get_model("account", "User")
+    database = schema_editor.connection.alias
+    for user in User.objects.using(database).only("pk", "private_metadata").iterator():
+        metadata = user.private_metadata
+        if isinstance(metadata, dict) and any(
+            isinstance(key, str) and key.startswith("oidc:") and bool(subject)
+            for key, subject in metadata.items()
+        ):
+            User.objects.using(database).filter(pk=user.pk).update(
+                external_authentication_required=True,
+                password_token_generation=1,
+                password=make_password(None),
+            )
+
+
+class Migration(migrations.Migration):
+    dependencies = [
+        ("account", "0095_repopulate_user_number_of_orders"),
+    ]
+
+    operations = [
+        migrations.AddField(
+            model_name="user",
+            name="external_authentication_required",
+            field=models.BooleanField(default=False),
+        ),
+        migrations.AddField(
+            model_name="user",
+            name="password_token_generation",
+            field=models.PositiveIntegerField(default=0),
+        ),
+        migrations.CreateModel(
+            name="ExternalIdentity",
+            fields=[
+                (
+                    "id",
+                    models.AutoField(
+                        auto_created=True,
+                        primary_key=True,
+                        serialize=False,
+                        verbose_name="ID",
+                    ),
+                ),
+                ("issuer", models.CharField(max_length=512)),
+                ("subject", models.CharField(max_length=255)),
+                (
+                    "user",
+                    models.ForeignKey(
+                        on_delete=django.db.models.deletion.CASCADE,
+                        related_name="external_identities",
+                        to=settings.AUTH_USER_MODEL,
+                    ),
+                ),
+            ],
+            options={
+                "constraints": [
+                    models.UniqueConstraint(
+                        fields=("issuer", "subject"),
+                        name="account_external_identity_unique",
+                    )
+                ],
+            },
+        ),
+        migrations.RunPython(
+            protect_existing_external_accounts, migrations.RunPython.noop
+        ),
+    ]
