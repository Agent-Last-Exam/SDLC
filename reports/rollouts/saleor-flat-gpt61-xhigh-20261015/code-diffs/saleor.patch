+class _HTMLCleaner(HTMLParser):
+    def __init__(self, path):
+        super().__init__(convert_charrefs=True)
+        self.path = path
+        self.output = []
+        self.open_tags = []
+
+    def handle_starttag(self, tag, attrs):
+        safe_attrs = []
+        # Validate every URL attribute even on a tag which will subsequently be
+        # stripped. A dropped <img src=javascript:...> must not make a write succeed.
+        for name, value in attrs:
+            if name in {"href", "src", "action", "formaction", "poster", "xlink:href"}:
+                _url(value or "", f"{self.path}.link")
+            elif name == "srcset":
+                _error(f"{self.path}.link", "Unsupported URL attribute.", UNSAFE_URL)
+        if tag not in ALLOWED_HTML_TAGS:
+            return
+        if tag == "a":
+            values = dict(attrs)
+            if "href" in values:
+                safe_attrs.append(
+                    ("href", _url(values["href"] or "", f"{self.path}.link"))
+                )
+            target = values.get("target")
+            if target in {"_blank", "_self"}:
+                safe_attrs.append(("target", target))
+            rel = {word.lower() for word in (values.get("rel") or "").split()}
+            rel &= {"noopener", "noreferrer", "nofollow", "ugc", "sponsored"}
+            if target == "_blank":
+                rel |= {"noopener", "noreferrer"}
+            if rel:
+                safe_attrs.append(("rel", " ".join(sorted(rel))))
+        attributes = "".join(
+            f' {name}="{html.escape(value, quote=True)}"' for name, value in safe_attrs
+        )
+        self.output.append(f"<{tag}{attributes}>")
+        if tag != "br":
+            self.open_tags.append(tag)
+
+    def handle_startendtag(self, tag, attrs):
+        self.handle_starttag(tag, attrs)
+        if tag in ALLOWED_HTML_TAGS and tag != "br":
+            self.handle_endtag(tag)
+
+    def handle_endtag(self, tag):
+        if tag in self.open_tags:
+            # Repair malformed nesting rather than allowing browser parser
+            # differences to resurrect an attribute or active tag.
+            while self.open_tags:
+                current = self.open_tags.pop()
+                self.output.append(f"</{current}>")
+                if current == tag:
+                    break
+
+    def handle_data(self, data):
+        self.output.append(html.escape(data, quote=False))
+
+    def result(self):
+        self.close()
+        while self.open_tags:
+            self.output.append(f"</{self.open_tags.pop()}>")
+        return "".join(self.output)
+
