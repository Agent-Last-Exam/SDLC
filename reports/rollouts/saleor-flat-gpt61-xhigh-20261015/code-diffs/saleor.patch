+"""Current list-scope export inputs. Older mutation inputs stay compatible."""
+
+import graphene
+
+from ..core.doc_category import (
+    DOC_CATEGORY_DISCOUNTS,
+    DOC_CATEGORY_GIFT_CARDS,
