@@ -0,0 +1,207 @@
+from decimal import Decimal
+from types import SimpleNamespace
+
+import graphene
+import pytest
+
+from .....payment import TransactionEventType
+from ....tests.utils import get_graphql_content, get_graphql_content_from_response
+from ...types import TransactionItem
+
+pytestmark = pytest.mark.django_db
+
+TRANSACTIONS = """
+query Transactions($filter: RootTransactionFilterInput, $first: Int, $last: Int, $after: String, $before: String) {
+  transactions(filter: $filter, first: $first, last: $last, after: $after, before: $before) {
+    totalCount edges { cursor node { id sourceCheckoutId chargedAmount { amount } } }
+    pageInfo { hasNextPage hasPreviousPage startCursor endCursor }
+  }
+}
+"""
+
+
+def test_root_transaction_owner_filter_and_bidirectional_pages(
+    api_client, customer_user, order, transaction_item_generator
+):
+    # Given three confirmed customer-owned transactions.
+    order.user = customer_user
+    order.save(update_fields=["user"])
+    api_client.user = customer_user
+    items = [
+        transaction_item_generator(order_id=order.pk, charged_value=Decimal(n))
+        for n in (1, 2, 3)
+    ]
+    variables = {
+        "first": 2,
+        "filter": {"orderIds": [graphene.Node.to_global_id("Order", order.pk)]},
+    }
+    # When paging forwards then backwards over a fixed PK-ordered set.
+    first = get_graphql_content(api_client.post_graphql(TRANSACTIONS, variables))[
+        "data"
+    ]["transactions"]
+    assert first["totalCount"] == 3
+    assert first["pageInfo"]["hasNextPage"]
+    assert [edge["node"]["id"] for edge in first["edges"]] == [
+        graphene.Node.to_global_id("TransactionItem", item.token) for item in items[:2]
+    ]
+    variables["after"] = first["pageInfo"]["endCursor"]
+    second = get_graphql_content(api_client.post_graphql(TRANSACTIONS, variables))[
+        "data"
+    ]["transactions"]
+    assert len(second["edges"]) == 1
+    backwards = get_graphql_content(
+        api_client.post_graphql(
+            TRANSACTIONS, {"last": 2, "before": second["edges"][0]["cursor"]}
+        )
+    )["data"]["transactions"]
+    # Then pages contain no duplicates and preserve ascending presentation order.
+    assert backwards["edges"] == first["edges"]
+
+
+@pytest.mark.parametrize(
+    "variables",
+    [
+        {},
+        {"first": 0},
+        {"first": 101},
+        {"first": 1, "last": 1},
+        {"first": 1, "after": "bad-cursor"},
+        {"first": 1, "before": "bad-cursor"},
+        {"first": 1, "filter": {"ids": None}},
+        {
+            "first": 1,
+            "filter": {
+                "ids": [graphene.Node.to_global_id("Order", "not-a-transaction")]
+            },
+        },
+    ],
+)
+def test_root_transaction_rejects_invalid_input(api_client, customer_user, variables):
+    api_client.user = customer_user
+    content = get_graphql_content_from_response(
+        api_client.post_graphql(TRANSACTIONS, variables)
+    )
+    assert content["errors"][0]["extensions"]["code"] == "INPUT_ERROR"
+
+
+def test_root_transaction_explicit_restricted_id_is_not_found(
+    api_client, customer_user, transaction_item
+):
+    transaction_item.order.user = None
+    transaction_item.order.save(update_fields=["user"])
+    api_client.user = customer_user
+    content = get_graphql_content_from_response(
+        api_client.post_graphql(
+            TRANSACTIONS,
+            {
+                "first": 10,
+                "filter": {
+                    "ids": [
+                        graphene.Node.to_global_id(
+                            "TransactionItem", transaction_item.token
+                        )
+                    ]
+                },
+            },
+        )
+    )
+    assert content["errors"][0]["extensions"]["code"] == "NOT_FOUND"
+
+
+def test_root_transaction_empty_arrays_are_empty_scope(
+    api_client, customer_user, order, transaction_item_generator
+):
+    api_client.user = customer_user
+    order.user = customer_user
+    order.save(update_fields=["user"])
+    transaction_item_generator(order_id=order.pk)
+    data = get_graphql_content(
+        api_client.post_graphql(TRANSACTIONS, {"first": 10, "filter": {"ids": []}})
+    )["data"]["transactions"]
+    assert data["totalCount"] == 0
+    assert data["edges"] == []
+
+
+def test_root_transaction_retained_checkout_and_psp_event_distinct(
+    api_client, customer_user, checkout, order, transaction_item_generator
+):
+    api_client.user = customer_user
+    order.user = customer_user
+    order.save(update_fields=["user"])
+    item = transaction_item_generator(checkout_id=checkout.pk)
+    item.checkout = None
+    item.order = order
+    item.save(update_fields=["checkout", "order"])
+    for _ in range(2):
+        item.events.create(
+            type=TransactionEventType.INFO,
+            psp_reference="exact-ref",
+            currency="USD",
+            amount_value=0,
+        )
+    data = get_graphql_content(
+        api_client.post_graphql(
+            TRANSACTIONS,
+            {
+                "first": 10,
+                "filter": {
+                    "checkoutIds": [
+                        graphene.Node.to_global_id("Checkout", checkout.pk)
+                    ],
+                    "pspReference": "exact-ref",
+                },
+            },
+        )
+    )["data"]["transactions"]
+    assert data["totalCount"] == 1
+    assert data["edges"][0]["node"]["sourceCheckoutId"] == graphene.Node.to_global_id(
+        "Checkout", checkout.pk
+    )
+
+
+def test_transaction_node_does_not_bypass_owner_scope(
+    api_client, customer_user, transaction_item
+):
+    transaction_item.order.user = None
+    transaction_item.order.save(update_fields=["user"])
+    # Node isn't exposed as a root Query field in this target schema. Exercise
+    # the type's Node entry point, which nested/global-ID resolution also uses.
+    info = SimpleNamespace(context=SimpleNamespace(user=customer_user, app=None))
+    assert TransactionItem.get_node(info, str(transaction_item.token)) is None
+
+
+def test_owner_transaction_does_not_unlock_metadata(
+    api_client, customer_user, order, transaction_item_generator
+):
+    order.user = customer_user
+    order.save(update_fields=["user"])
+    api_client.user = customer_user
+    item = transaction_item_generator(order_id=order.pk, metadata={"secret": "value"})
+    query = "query($id: ID!) { transaction(id: $id) { id metadata { key value } } }"
+    content = get_graphql_content_from_response(
+        api_client.post_graphql(
+            query, {"id": graphene.Node.to_global_id("TransactionItem", item.token)}
+        )
+    )
+    assert content["errors"][0]["extensions"]["code"] == "PERMISSION_DENIED"
+
+
+def test_payment_app_can_only_list_own_transactions(
+    app_api_client, app, permission_manage_payments, order, transaction_item_generator
+):
+    app.permissions.add(permission_manage_payments)
+    own = transaction_item_generator(order_id=order.pk, app=app)
+    transaction_item_generator(order_id=order.pk)
+    data = get_graphql_content(
+        app_api_client.post_graphql(
+            TRANSACTIONS,
+            {
+                "first": 10,
+                "filter": {"orderIds": [graphene.Node.to_global_id("Order", order.pk)]},
+            },
+        )
+    )["data"]["transactions"]
+    assert data["totalCount"] == 1
+    assert data["edges"][0]["node"]["id"] == graphene.Node.to_global_id(
+        "TransactionItem", own.token
+    )
diff --git a/saleor/graphql/product/types/channel_availability.py b/saleor/graphql/product/types/channel_availability.py
