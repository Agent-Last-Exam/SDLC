@@ -0,0 +1,70 @@
+"""Checkout subject search; this does not change customer/User search."""
+
+import unicodedata
+
+import graphene
+from django.db.models import Exists, OuterRef, Q, Value
+
+from ..core.postgres import NoValidationSearchVector
+from ..core.search import normalize_search_text, parse_search, search_queryset
+from ..payment.models import Payment
+
+
+def prepare_checkout_search_vector_value(checkout, *, already_prefetched=False):
+    vectors = []
+
+    def add(value, weight="A"):
+        if value:
+            vectors.append(
+                NoValidationSearchVector(
+                    Value(str(value)), config="simple", weight=weight
+                )
+            )
+
+    add(checkout.token)
+    add(graphene.Node.to_global_id("Checkout", checkout.token))
+    add(checkout.email)
+    if checkout.user:
+        add(checkout.user.email)
+        add(checkout.user.first_name)
+        add(checkout.user.last_name)
+    for line in checkout.lines.select_related("variant__product").order_by("pk"):
+        add(line.variant.sku)
+        add(line.variant.name)
+        add(line.variant.product.name)
+    for payment in checkout.payments.all().order_by("pk"):
+        add(graphene.Node.to_global_id("Payment", payment.pk), "D")
+        add(payment.psp_reference, "D")
+    return vectors
+
+
+def search_checkouts(queryset, value):
+    """Keep exact identifiers inside the already-authorized list queryset."""
+    from uuid import UUID
+
+    # Validate before decoding IDs or querying payment references. Relay IDs are
+    # case-sensitive: decode the original NFKC text before case-folding tokens.
+    parsed = parse_search(value)
+    if not parsed.terms:
+        return queryset
+    original = unicodedata.normalize("NFKC", value).strip()
+    exact_match = Q()
+    if not any(char.isspace() for char in original) and '"' not in original:
+        try:
+            typename, pk = graphene.Node.from_global_id(original)
+        except Exception:
+            typename, pk = None, None
+        possible_token = pk if typename == "Checkout" else original
+        try:
+            exact_match |= Q(token=UUID(possible_token))
+        except (ValueError, TypeError, AttributeError):
+            pass
+        payments = Payment.objects.using(queryset.db).filter(
+            psp_reference__iexact=normalize_search_text(original)
+        )
+        if typename == "Payment" and pk and pk.isdecimal():
+            payments = Payment.objects.using(queryset.db).filter(
+                Q(pk=pk) | Q(psp_reference__iexact=normalize_search_text(original))
+            )
+        exact_match |= Q(Exists(payments.filter(checkout_id=OuterRef("token"))))
+    return search_queryset(queryset, value, exact_match=exact_match or None)
