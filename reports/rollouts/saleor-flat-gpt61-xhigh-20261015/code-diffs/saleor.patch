+"""Prepare a financial request under a lock, dispatch once outside that lock."""
+
+from django.core.exceptions import ValidationError
+from django.db import transaction as db_transaction
+
+from ..core.db.connection import allow_writer
+from . import (
+    FAILED_TRANSACTION_EVENTS,
+    GIFT_CARD_PROVIDER,
+    PaymentError,
+    TransactionAction,
+    TransactionEventType,
+)
+from .action_reservations import (
+    action_identity,
+    available_charge_amount,
+    available_refund_amount,
+    clean_idempotency_key,
+    existing_action,
+    finish_action,
+    input_fingerprint,
+    lock_source,
+    provider_namespace,
+    touch_transaction_source,
+    validate_amount,
+)
+from .models import PaymentActionRecord, TransactionItem
+
+REQUEST_TYPES = {
+    TransactionAction.CHARGE: TransactionEventType.CHARGE_REQUEST,
+    TransactionAction.REFUND: TransactionEventType.REFUND_REQUEST,
+    TransactionAction.CANCEL: TransactionEventType.CANCEL_REQUEST,
+}
+SUCCESS_TYPES = {
+    TransactionEventType.CHARGE_SUCCESS,
+    TransactionEventType.REFUND_SUCCESS,
+    TransactionEventType.CANCEL_SUCCESS,
+}
+
+
+def reconcile_action(record):
+    """Retain occupancy until a final fact or a represented pending request exists."""
+    item = record.transaction
+    event = record.request_event
+    if event:
+        event.refresh_from_db()
+        candidates = item.events.filter(
+            type__in={
+                TransactionAction.CHARGE: (
+                    TransactionEventType.CHARGE_SUCCESS,
+                    TransactionEventType.CHARGE_FAILURE,
+                ),
+                TransactionAction.REFUND: (
+                    TransactionEventType.REFUND_SUCCESS,
+                    TransactionEventType.REFUND_FAILURE,
+                ),
+                TransactionAction.CANCEL: (
+                    TransactionEventType.CANCEL_SUCCESS,
+                    TransactionEventType.CANCEL_FAILURE,
+                ),
+            }.get(record.action, ()),
+            include_in_calculations=True,
+        )
+        if event.pk and event.type in SUCCESS_TYPES | set(FAILED_TRANSACTION_EVENTS):
+            candidates = candidates.filter(pk=event.pk)
+        elif event.psp_reference:
+            candidates = candidates.filter(psp_reference=event.psp_reference)
+        else:
+            # A later unrelated result is not proof that this request settled.
+            candidates = candidates.none()
+        result = candidates.order_by("-created_at", "-pk").first()
+        if result:
+            finish_action(
+                record,
+                event=result,
+                state="failed"
+                if result.type in FAILED_TRANSACTION_EVENTS
+                else "succeeded",
+            )
+            return
+    if event and not event.include_in_calculations:
+        failed = (
+            item.events.filter(
+                type__in=FAILED_TRANSACTION_EVENTS,
+                include_in_calculations=False,
+                idempotency_key=f"failure:{event.pk}",
+            )
+            .order_by("-pk")
+            .first()
+        )
+        if failed:
+            finish_action(record, event=failed, state="failed")
+            return
+    record.state = "requested"
+    record.save(update_fields=["state", "updated_at"])
+
+
+@allow_writer()
+def request_transaction_action(
+    item,
+    action,
+    *,
+    amount=None,
+    key=None,
+    user=None,
+    app=None,
+    manager,
+    reason=None,
+    reason_reference=None,
+):
+    if item.provider_namespace == GIFT_CARD_PROVIDER:
+        from .gift_card import request_gift_card_action
+
+        result, _ = request_gift_card_action(
+            item,
+            action,
+            amount=amount,
+            key=key,
+            user=user,
+            app=app,
+            manager=manager,
+            reason=reason,
+            reason_reference=reason_reference,
+        )
+        return result
+    if action not in REQUEST_TYPES:
+        raise ValidationError(
+            {
+                "action_type": ValidationError(
+                    "Unsupported action.", code="invalid_state"
+                )
+            }
+        )
+    key = clean_idempotency_key(key)
+    fingerprint = input_fingerprint(
+        {
+            "transaction": str(item.token),
+            "action": action,
+            "amount": amount,
+            "currency": item.currency,
+            "reason": reason,
+            "reason_reference": (reason_reference.pk if reason_reference else None),
+        }
+    )
+    identity = action_identity(
+        transaction=item,
+        provider=provider_namespace(item),
+        action=action,
+        key=key,
+        user=user,
+        app=app,
+    )
+    with db_transaction.atomic():
+        source = item.checkout if item.checkout_id else item.order
+        if not source:
+            raise ValidationError(
+                {
+                    "id": ValidationError(
+                        "Transaction has no payable object.", code="invalid_state"
+                    )
+                }
+            )
+        source = lock_source(source)
+        item = TransactionItem.objects.select_for_update().get(pk=item.pk)
+        if record := existing_action(identity, fingerprint):
+            # Never issue a second request for an ambiguous or failed result.
+            return item
+        if action not in item.available_actions:
+            raise ValidationError(
+                {
+                    "action_type": ValidationError(
+                        "This transaction does not currently support the action.",
+                        code="invalid_state",
+                    )
+                }
+            )
+        available = (
+            available_refund_amount(item)
+            if action == TransactionAction.REFUND
+            else available_charge_amount(item)
+        )
+        requested = validate_amount(amount, item.currency, available)
+        record = PaymentActionRecord.objects.create(
+            **identity,
+            input_hash=fingerprint,
+            transaction=item,
+            requested_amount=requested,
+            reserved_amount=requested,
+            currency=item.currency,
+            state="requested",
+        )
+        event = item.events.create(
+            type=REQUEST_TYPES[action],
+            currency=item.currency,
+            amount_value=requested,
+            idempotency_key=f"payment-action:{record.pk}",
+            user=user if user and user.is_authenticated else None,
+            app=app,
+            app_identifier=app.identifier if app else None,
+            message=reason if action == TransactionAction.REFUND else None,
+            reason_reference=reason_reference
+            if action == TransactionAction.REFUND
+            else None,
+        )
+        record.request_event = event
+        record.save(update_fields=["request_event"])
+        touch_transaction_source(item)
+    from . import gateway
+
+    kwargs = {
+        "transaction": item,
+        "manager": manager,
+        "request_event": event,
+        "channel_slug": source.channel.slug,
+        "user": user,
+        "app": app,
+    }
+    try:
+        if action == TransactionAction.CHARGE:
+            gateway.request_charge_action(**kwargs, charge_value=requested)
+        elif action == TransactionAction.REFUND:
+            gateway.request_refund_action(**kwargs, refund_value=requested)
+        else:
+            gateway.request_cancelation_action(
+                **kwargs, cancel_value=requested, action=action
+            )
+    except PaymentError:
+        reconcile_action(record)
+        raise
+    except Exception:
+        record.state = "unknown"
+        record.save(update_fields=["state", "updated_at"])
+        raise
+    reconcile_action(record)
+    item.refresh_from_db()
+    return item
