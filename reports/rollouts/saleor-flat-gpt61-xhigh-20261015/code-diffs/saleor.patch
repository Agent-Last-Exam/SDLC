+        [{"key": "x", "value": 3}],
+        [{"key": "x", "value": "a"}, {"key": "x", "value": "b"}],
+    ],
+)
+def test_atomic_metadata_rejects_invalid_upserts(field, items):
+    # given / when
+    with pytest.raises(ValidationError) as exc:
+        validate_patch({"expected_version": 0, field: items})
+
+    # then
+    assert field in exc.value.error_dict
+
+
+@pytest.mark.parametrize(
+    ("updates", "deletes"),
+    [("metadata", "delete_keys"), ("private_metadata", "delete_private_keys")],
+)
+def test_atomic_metadata_rejects_upsert_and_delete_same_key(updates, deletes):
+    # given / when
+    with pytest.raises(ValidationError):
+        validate_patch(
+            {
+                "expected_version": 0,
+                updates: [{"key": "x", "value": "a"}],
+                deletes: ["x"],
+            }
+        )
+
+
+def test_atomic_metadata_allows_public_private_same_key_and_noop():
+    # given / when / then
+    validate_patch(
+        {
+            "expected_version": 0,
+            "metadata": [{"key": "x", "value": "public"}],
+            "private_metadata": [{"key": "x", "value": "private"}],
+        }
+    )
+    validate_patch({"expected_version": 0})
+    validate_patch(
+        {
+            "expected_version": 0,
+            "metadata": [],
+            "private_metadata": [],
+            "delete_keys": [],
+            "delete_private_keys": [],
+        }
+    )
+
+
+def test_tax_event_subject_scope_never_uses_request_dict():
