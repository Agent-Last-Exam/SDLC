+RESET = """mutation($email:String!){requestPasswordReset(email:$email,redirectUrl:"https://www.example.com"){errors{field code}}}"""
+SET = """mutation($email:String!,$token:String!){setPassword(email:$email,token:$token,password:"new-safe-password-123"){token errors{field code}}}"""
