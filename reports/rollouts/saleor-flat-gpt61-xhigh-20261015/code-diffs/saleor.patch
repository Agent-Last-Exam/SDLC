+                    "type": "paragraph",
+                    "data": {"text": '<a href="javascript:private-secret">bad</a>'},
+                }
+            ]
+        },
+    ],
+)
+def test_rich_text_graphql_rejection_preserves_saved_content(
+    request,
+    staff_api_client,
+    kind,
+    fixture_name,
+    input_type,
+    mutation,
+    payload,
+    field,
+    permission,
+    invalid,
+):
+    # given
+    instance = request.getfixturevalue(fixture_name)
+    permission = request.getfixturevalue(permission)
+    original = dummy_editorjs("Saved safe content")
+    is_translation = mutation == "productTranslate"
+    target = (
+        instance.translations.create(language_code="pl", description=original)
+        if is_translation
+        else instance
+    )
+    if not is_translation:
+        setattr(target, field, original)
+        target.save(update_fields=[field])
+    language_argument = ", languageCode: PL" if is_translation else ""
+    query = f"""
+        mutation($id: ID!, $input: {input_type}!) {{
+          {mutation}(id: $id, input: $input{language_argument}) {{
+            {payload} {{ id }}
+            errors {{ field code message }}
+          }}
+        }}
+    """
+    # when
+    response = staff_api_client.post_graphql(
+        query,
+        {
+            "id": graphene.Node.to_global_id(kind, instance.pk),
+            "input": {field: json.dumps(invalid)},
+        },
+        permissions=[permission],
+    )
+    # then
+    data = get_graphql_content(response)["data"][mutation]
+    assert data["errors"]
+    error = data["errors"][0]
+    assert error["field"] == field
+    assert error["code"] in {"INVALID_RICH_TEXT_STRUCTURE", "UNSAFE_URL"}
+    assert "private-secret" not in error["message"]
+    target.refresh_from_db()
+    assert getattr(target, field) == original
