+def check_checkout_access(info, checkout, *, management=False):
+    """Check capability ownership and management channel scope before any services."""
+    user = info.context.user
+    app = get_app_promise(info.context).get()
+    permissions = [
+        CheckoutPermissions.MANAGE_CHECKOUTS,
+        CheckoutPermissions.HANDLE_CHECKOUTS,
+    ]
+    if not management:
+        permissions.extend(
+            [PaymentPermissions.HANDLE_PAYMENTS, AccountPermissions.IMPERSONATE_USER]
+        )
+    actor = app or user
+    if app or (user and user.is_authenticated and user.is_staff):
+        if not actor or not any(
+            actor.has_perm(permission) for permission in permissions
+        ):
+            raise PermissionDenied(permissions=permissions)
+        if not app:
+            allowed = get_user_accessible_channels(info, user)
+            if not any(channel.pk == checkout.channel_id for channel in allowed):
+                raise PermissionDenied(
+                    message="You do not have access to this checkout's channel."
+                )
+        return
+    if management:
+        raise PermissionDenied(permissions=permissions)
+    if checkout.user_id and (
+        not user or not user.is_authenticated or user.pk != checkout.user_id
+    ):
+        raise PermissionDenied(message="You do not have access to this checkout.")
+    # An anonymous checkout UUID is the existing non-enumerable checkout capability.
 
 
