index 000000000..e3a83b1d3
--- /dev/null
+++ b/saleor/graphql/csv/export_scope.py
@@ -0,0 +1,362 @@
+"""Export submission takes a current, authorized effective-list snapshot."""
+
+import copy
+import hashlib
+import json
+from enum import Enum
+from uuid import uuid4
+
+from django.conf import settings
+from django.core.exceptions import ValidationError
+from django.db import IntegrityError, transaction
+
+from ...attribute.models import Attribute
+from ...channel.models import Channel
+from ...core.db.connection import allow_writer
+from ...core.search import parse_search
+from ...core.utils.json_serializer import CustomJsonEncoder
+from ...csv.authorization import (
+    actor_scope,
+    allowed_channel_ids,
+    require_export_permission,
+    scope_queryset,
+)
+from ...csv.error_codes import ExportErrorCode
+from ...csv.events import export_started_event
+from ...csv.models import ExportFile
+from ...discount.models import Voucher, VoucherCode
+from ...giftcard.models import GiftCard
+from ...giftcard.search import search_gift_cards
+from ...product.models import Product
+from ...product.search import search_products
+from ...warehouse.models import Warehouse
+from ..core.connection import filter_qs, where_filter_qs
+from ..core.utils import from_global_id_or_error
+from ..discount.filters import VoucherFilter
+from ..giftcard.filters import GiftCardFilter
+from ..product.filters.product import ProductFilter, ProductWhere
+from ..utils import get_user_or_app_from_context
+from ..utils.sorting import sort_queryset, sort_queryset_by_default
+from .mutations.export_products import ExportProducts
+
+DOMAIN_MODEL = {
+    "products": (Product, "Product"),
+    "gift_cards": (GiftCard, "GiftCard"),
+    "vouchers": (Voucher, "Voucher"),
+    "voucher_codes": (VoucherCode, "VoucherCode"),
+}
+
+
+def invalid(field, message, code=ExportErrorCode.INVALID):
+    raise ValidationError({field: ValidationError(message, code=code.value)})
+
+
+def plain_input(value):
+    if isinstance(value, dict):
+        return {key: plain_input(item) for key, item in value.items()}
+    if isinstance(value, list | tuple):
+        return [plain_input(item) for item in value]
+    if isinstance(value, Enum):
+        return value.value
+    return value
+
+
+def input_hash(value):
+    encoded = json.dumps(
+        plain_input(value), cls=CustomJsonEncoder, sort_keys=True, separators=(",", ":")
+    )
+    return hashlib.sha256(encoded.encode()).hexdigest()
+
+
+def resolve_ids(values, typename, field="ids"):
+    if not isinstance(values, list) or not values:
+        invalid(field, "Provide at least one object ID.", ExportErrorCode.REQUIRED)
+    if any(value is None for value in values) or len(values) != len(set(values)):
+        invalid(field, "IDs must be non-null and unique.")
+    pks = []
+    for value in values:
+        try:
+            _, pk = from_global_id_or_error(value, typename)
+        except Exception:
+            invalid(field, "Invalid object ID.")
+        pks.append(pk)
+    # Two differently encoded IDs must not select the same row twice.
+    if len(set(pks)) != len(pks):
+        invalid(field, "IDs must be unique.")
+    return pks
+
+
+def has_constraint(value):
+    if isinstance(value, dict):
+        return any(has_constraint(item) for item in value.values())
+    if isinstance(value, list | tuple):
+        return True  # an explicitly empty list can be a valid empty scope
+    if isinstance(value, str):
+        return bool(value.strip())
+    return value is not None
+
+
+def validate_scope(input, domain):
+    for field in (
+        "ids",
+        "filter",
+        "where",
+        "search",
+        "channel",
+        "sort_by",
+        "export_info",
+        "voucher_id",
+    ):
+        if field in input and input[field] is None:
+            invalid(field, "Explicit null is not a valid export input.")
+    if input.get("channel") is not None and not input["channel"].strip():
+        invalid("channel", "Channel must not be empty.")
+    if domain == "voucher_codes":
+        if "ids" in input and not input["ids"]:
+            invalid("ids", "Provide at least one object ID.", ExportErrorCode.REQUIRED)
+        if "voucher_id" in input and not input["voucher_id"]:
+            invalid("voucher_id", "Provide a valid voucher ID.")
+        if not input.get("ids") and not input.get("voucher_id"):
+            invalid(
+                "ids",
+                "Provide voucherId or a non-empty list of code IDs.",
+                ExportErrorCode.REQUIRED,
+            )
+        return
+    scope = input.get("scope")
+    if scope not in {"all", "ids", "filter"}:
+        invalid("scope", "Invalid export scope.")
+    constrained = any(
+        has_constraint(input.get(field)) for field in ("where", "filter", "channel")
+    )
+    if input.get("search"):
+        constrained |= bool(parse_search(input["search"]).terms)
+    if scope == "all" and ("ids" in input or constrained):
+        invalid("scope", "ALL cannot be combined with selection or effective filters.")
+    if scope == "filter" and ("ids" in input or not constrained):
+        invalid("scope", "FILTER requires current effective filters and no selection.")
+    if scope == "ids" and not input.get("ids"):
+        invalid("ids", "IDS requires a non-empty selection.", ExportErrorCode.REQUIRED)
+
+
+def current_queryset(info, actor, domain, input):
+    model, typename = DOMAIN_MODEL[domain]
+    queryset = scope_queryset(
+        model.objects.using(settings.DATABASE_CONNECTION_DEFAULT_NAME).all(),
+        actor,
+        domain,
+    )
+    channel_slug = input.get("channel")
+    if channel_slug is not None:
+        channel = Channel.objects.filter(slug=channel_slug).first()
+        if channel is None:
+            invalid("channel", "Channel was not found.", ExportErrorCode.NOT_FOUND)
+        channels = allowed_channel_ids(actor)
+        if channels is not None and channel.pk not in channels:
+            from ...core.exceptions import PermissionDenied
+
+            raise PermissionDenied()
+        if domain in {"products", "vouchers"}:
+            queryset = queryset.filter(channel_listings__channel_id=channel.pk)
+    args = {"channel": channel_slug}
+    if domain == "products":
+        if input.get("search") is not None:
+            queryset = search_products(queryset, input["search"])
+        if input.get("where"):
+            queryset = where_filter_qs(
+                queryset,
+                args,
+                ProductWhere,
+                copy.deepcopy(input["where"]),
+                request=info.context,
+            )
+        if input.get("filter"):
+            queryset = filter_qs(
+                queryset,
+                args,
+                ProductFilter,
+                copy.deepcopy(input["filter"]),
+                request=info.context,
+            )
+    elif domain == "gift_cards":
+        if input.get("search") is not None:
+            queryset = search_gift_cards(queryset, input["search"])
+        # This precondition applies even when filter was omitted completely.
+        sort_by = input.get("sort_by")
+        if (
+            sort_by
+            and "current_balance_amount" in (sort_by.get("field") or [])
+            and not (input.get("filter") or {}).get("currency")
+        ):
+            invalid("sort_by", "Sorting by balance requires filtering by currency.")
+        if input.get("filter"):
+            queryset = filter_qs(
+                queryset,
+                args,
+                GiftCardFilter,
+                copy.deepcopy(input["filter"]),
+                request=info.context,
+            )
+    elif domain == "vouchers" and input.get("filter"):
+        queryset = filter_qs(
+            queryset,
+            args,
+            VoucherFilter,
+            copy.deepcopy(input["filter"]),
+            request=info.context,
+        )
+    elif domain == "voucher_codes" and input.get("voucher_id"):
+        pk = resolve_ids([input["voucher_id"]], "Voucher", "voucher_id")[0]
+        if (
+            not scope_queryset(Voucher.objects.all(), actor, "vouchers")
+            .filter(pk=pk)
+            .exists()
+        ):
+            invalid("voucher_id", "Voucher was not found.", ExportErrorCode.NOT_FOUND)
+        queryset = queryset.filter(voucher_id=pk)
+    if input.get("ids"):
+        pks = resolve_ids(input["ids"], typename)
+        queryset = queryset.filter(pk__in=pks)
+        if queryset.values("pk").distinct().count() != len(pks):
+            invalid("ids", "The selection does not match the current effective scope.")
+    if input.get("sort_by"):
+        queryset = sort_queryset(
+            queryset, input["sort_by"], reversed=False, channel_slug=channel_slug
+        )
+    else:
+        queryset, _ = sort_queryset_by_default(queryset, reversed=False)
+    return queryset.distinct()
+
+
+def prepare_export_info(input, actor):
+    data = input.get("export_info") or {}
+    export_info = ExportProducts.get_export_info(data)
+    for field, model in (
+        ("attributes", Attribute),
+        ("warehouses", Warehouse),
+        ("channels", Channel),
+    ):
+        if field not in data:
+            continue
+        if data[field] is None:
+            invalid(
+                "export_info", "Explicit null is not a valid export field selection."
+            )
+        ids = export_info.get(field, [])
+        if len(ids) != len(set(ids)):
+            invalid("export_info", "Export field object IDs must be unique.")
+        if model.objects.filter(pk__in=ids).count() != len(ids):
+            invalid(
+                "export_info",
+                "An export field object was not found.",
+                ExportErrorCode.NOT_FOUND,
+            )
+    channels = allowed_channel_ids(actor)
+    if channels is not None:
+        selected = export_info.get("channels")
+        if selected is not None and any(int(pk) not in channels for pk in selected):
+            invalid("export_info", "Export fields include an inaccessible channel.")
+        # Only requested fields are exported; a channel restriction never adds
+        # headers or data that the caller did not request.
+        warehouses = export_info.get("warehouses") or []
+        if warehouses:
+            from django.db.models import Q
+
+            accessible = (
+                Warehouse.objects.filter(
+                    Q(channels__id__in=channels)
+                    | Q(shipping_zones__channels__id__in=channels)
+                )
+                .filter(pk__in=warehouses)
+                .distinct()
+                .count()
+            )
+            if accessible != len(warehouses):
+                invalid(
+                    "export_info", "Export fields include an inaccessible warehouse."
+                )
+    return export_info
+
+
+@allow_writer()
+def submit_export(info, domain, input, *, compatibility=False):
+    actor = require_export_permission(
+        get_user_or_app_from_context(info.context), domain
+    )
+    input = copy.deepcopy(input)
+    try:
+        validate_scope(input, domain)
+    except Exception as exc:
+        from graphql import GraphQLError
+
+        if isinstance(exc, GraphQLError):
+            invalid("search", str(exc))
+        raise
+    key = input.get("idempotency_key")
+    if compatibility:
+        key = str(uuid4())
+    if not isinstance(key, str) or not key.strip() or len(key) > 255:
+        invalid(
+            "idempotency_key",
+            "Provide a non-empty idempotencyKey of at most 255 characters.",
+        )
+    fingerprint = input_hash(
+        {key: value for key, value in input.items() if key != "idempotency_key"}
+    )
+    owner = actor_scope(actor)
+    existing = ExportFile.objects.filter(
+        actor_scope=owner, domain=domain, idempotency_key=key
+    ).first()
+    if existing:
+        if existing.input_hash != fingerprint:
+            invalid(
+                "idempotency_key",
+                "This idempotencyKey was used with different export parameters.",
+            )
+        return existing
+    from graphql import GraphQLError
+
+    try:
+        queryset = current_queryset(info, actor, domain, input)
+    except (GraphQLError, ValueError, TypeError) as exc:
+        invalid("input", str(exc))
+    ids = list(
+        dict.fromkeys(
+            str(pk)
+            for pk in queryset.values_list("pk", flat=True).iterator(chunk_size=1000)
+        )
+    )
+    snapshot = {
+        "input": plain_input(input),
+        "ids": ids,
+        "file_type": input["file_type"],
+        "export_info": prepare_export_info(input, actor)
+        if domain == "products"
+        else {},
+    }
+    try:
+        with transaction.atomic():
+            job = ExportFile.objects.create(
+                app=actor if owner.startswith("app:") else None,
+                user=actor if owner.startswith("user:") else None,
+                domain=domain,
+                actor_scope=owner,
+                idempotency_key=key,
+                input_hash=fingerprint,
+                scope_hash=input_hash(snapshot),
+                effective_scope_snapshot=snapshot,
+            )
+            export_started_event(export_file=job, app=job.app, user=job.user)
+            from ...csv.tasks import export_effective_scope_task
+
+            transaction.on_commit(lambda: export_effective_scope_task.delay(job.pk))
+    except IntegrityError:
+        job = ExportFile.objects.get(
+            actor_scope=owner, domain=domain, idempotency_key=key
+        )
+        if job.input_hash != fingerprint:
+            invalid(
+                "idempotency_key",
+                "This idempotencyKey was used with different export parameters.",
+            )
+    return job
