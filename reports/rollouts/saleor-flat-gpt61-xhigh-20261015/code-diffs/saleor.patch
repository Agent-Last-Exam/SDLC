+def test_atomic_metadata_parallel_expected_version_has_one_winner(
+    order, app, permission_manage_orders
+):
+    # given
+    app.permissions.add(permission_manage_orders)
+    original = dict(order.metadata)
+    barrier = Barrier(2)
+    order_id = order.pk
+
+    def write(value):
+        close_old_connections()
+        try:
+            local_order = Order.objects.get(pk=order_id)
+            context = SimpleNamespace(app=app, user=None)
+            info = SimpleNamespace(context=context)
+            target = MetadataTarget(
+                str(order_id),
+                "Order",
+                local_order,
+                {"expected_version": 0, "metadata": [{"key": value, "value": value}]},
+            )
+            barrier.wait(timeout=10)
+            try:
+                write_metadata_targets(info, [target])
+            except ValidationError as exc:
+                return exc.error_dict["expected_version"][0].code
+            return "success"
+        finally:
+            close_old_connections()
+
+    # when
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(write, ["first", "second"]))
+
+    # then
+    assert sorted(results) == ["conflict", "success"]
+    order.refresh_from_db()
+    assert order.metadata_version == 1
+    assert len(order.metadata) == len(original) + 1
+    assert order.metadata.items() >= original.items()
