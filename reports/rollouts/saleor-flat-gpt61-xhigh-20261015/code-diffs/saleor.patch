@@ -0,0 +1,45 @@
+"""Export data is never written into the publicly served media storage."""
+
+from pathlib import Path
+
+from django.conf import settings
+from django.core.files.storage import FileSystemStorage, Storage
+from django.utils.deconstruct import deconstructible
+
+from ..core import private_storage
+
+
+@deconstructible
+class ExportStorage(Storage):
+    def backend(self):
+        if (
+            settings.PRIVATE_FILE_STORAGE
+            == "django.core.files.storage.FileSystemStorage"
+            or settings.PRIVATE_FILE_STORAGE
+            == "saleor.tests.storages.PrivateFileSystemStorage"
+        ):
+            root = (
+                getattr(settings, "PRIVATE_MEDIA_ROOT", None)
+                or Path(settings.PROJECT_ROOT) / "private-media"
+            )
+            return FileSystemStorage(location=Path(root) / "exports")
+        return private_storage
+
+    def _open(self, name, mode="rb"):
+        return self.backend().open(name, mode)
+
+    def _save(self, name, content):
+        return self.backend().save(name, content)
+
+    def exists(self, name):
+        return self.backend().exists(name)
+
+    def size(self, name):
+        return self.backend().size(name)
+
+    def delete(self, name):
+        return self.backend().delete(name)
+
+    def url(self, name):
+        # A direct cloud/local URL would bypass current job authorization.
+        raise NotImplementedError("Resolve an authorized export download URL instead.")
diff --git a/saleor/csv/utils/effective_export.py b/saleor/csv/utils/effective_export.py
new file mode 100644
index 000000000..bc16eeddf
--- /dev/null
+++ b/saleor/csv/utils/effective_export.py
@@ -0,0 +1,172 @@
+"""Generate files from a persisted effective selection, never re-run old filters."""
+
+import graphene
+from django.conf import settings
+from django.db.models import Case, IntegerField, When
+
+from ...core.exceptions import PermissionDenied
+from ...csv.authorization import (
+    actor_for_job,
+    allowed_channel_ids,
+    allowed_warehouse_ids,
+    scope_queryset,
+)
+from ...discount.models import Voucher, VoucherCode
+from ...giftcard.models import GiftCard
+from ...product.models import Product
+from .export import (
+    append_to_file,
+    create_file_with_headers,
+    get_filename,
+    save_csv_file_in_export_file,
+)
+from .product_headers import get_product_export_fields_and_headers_info
+from .products_data import get_products_data
+
+BATCH_SIZE = 1000
+DOMAIN_MODEL = {
+    "products": Product,
+    "gift_cards": GiftCard,
+    "vouchers": Voucher,
+    "voucher_codes": VoucherCode,
+}
+
+
+def authorized_snapshot_queryset(job, actor=None):
+    actor = actor or actor_for_job(job)
+    ids = job.effective_scope_snapshot["ids"]
+    queryset = (
+        DOMAIN_MODEL[job.domain]
+        .objects.using(settings.DATABASE_CONNECTION_DEFAULT_NAME)
+        .filter(pk__in=ids)
+    )
+    permitted = scope_queryset(queryset, actor, job.domain)
+    # Revoked object scope fails the whole job; it never silently produces a
+    # smaller or all-store file that disagrees with the submitted selection.
+    if queryset.count() != len(ids) or permitted.count() != len(ids):
+        raise PermissionDenied()
+    channels = allowed_channel_ids(actor)
+    channel_slug = job.effective_scope_snapshot.get("input", {}).get("channel")
+    if channels is not None and channel_slug is not None:
+        from ...channel.models import Channel
+
+        if (
+            not Channel.objects.using(settings.DATABASE_CONNECTION_DEFAULT_NAME)
+            .filter(pk__in=channels, slug=channel_slug)
+            .exists()
+        ):
+            raise PermissionDenied()
+    exported_channels = job.effective_scope_snapshot.get("export_info", {}).get(
+        "channels", []
+    )
+    if channels is not None and any(
+        int(pk) not in channels for pk in exported_channels
+    ):
+        raise PermissionDenied()
+    warehouses = allowed_warehouse_ids(actor)
+    exported_warehouses = job.effective_scope_snapshot.get("export_info", {}).get(
+        "warehouses", []
+    )
+    if warehouses is not None and any(
+        str(pk) not in {str(item) for item in warehouses} for pk in exported_warehouses
+    ):
+        raise PermissionDenied()
+    return permitted
+
+
+def write_effective_export(job):
+    actor = actor_for_job(job)
+    queryset = authorized_snapshot_queryset(job, actor)
+    snapshot = job.effective_scope_snapshot
+    file_type = snapshot["file_type"]
+    export_info = snapshot.get("export_info", {})
+    if job.domain == "products":
+        fields, headers, data_headers = get_product_export_fields_and_headers_info(
+            export_info
+        )
+    elif job.domain == "gift_cards":
+        # Used cards remain in the effective set, but their secret full code is
+        # never exported. The file still has allowed base information for them.
+        headers = data_headers = [
+            "id",
+            "display_code",
+            "code",
+            "is_active",
+            "currency",
+            "current_balance_amount",
+        ]
+    elif job.domain == "voucher_codes":
+        headers = data_headers = ["code"]
+    else:
+        headers = data_headers = [
+            "id",
+            "name",
+            "type",
+            "discount_value_type",
+            "start_date",
+            "end_date",
+            "usage_limit",
+        ]
+    temporary_file = create_file_with_headers(headers, ",", file_type)
+    try:
+        ids = snapshot["ids"]
+        for start in range(0, len(ids), BATCH_SIZE):
+            batch_ids = ids[start : start + BATCH_SIZE]
+            batch = (
+                queryset.filter(pk__in=batch_ids)
+                .annotate(
+                    export_position=Case(
+                        *[
+                            When(pk=pk, then=index)
+                            for index, pk in enumerate(batch_ids)
+                        ],
+                        output_field=IntegerField(),
+                    )
+                )
+                .order_by("export_position")
+            )
+            if job.domain == "products":
+                rows = get_products_data(
+                    batch,
+                    set(fields),
+                    export_info.get("attributes"),
+                    export_info.get("warehouses"),
+                    export_info.get("channels"),
+                )
+                # The reused builder orders product rows by PK; restore the
+                # submitted list order, keeping variant order within a product.
+                positions = {
+                    graphene.Node.to_global_id("Product", pk): index
+                    for index, pk in enumerate(batch_ids)
+                }
+                rows.sort(key=lambda row: positions[row["id"]])
+            elif job.domain == "gift_cards":
+                rows = []
+                for card in batch:
+                    rows.append(
+                        {
+                            "id": graphene.Node.to_global_id("GiftCard", card.pk),
+                            "display_code": card.code[-4:],
+                            "code": card.code
+                            if card.used_by_email is None and card.used_by_id is None
+                            else "",
+                            "is_active": card.is_active,
+                            "currency": card.currency,
+                            "current_balance_amount": card.current_balance_amount,
+                        }
+                    )
+            elif job.domain == "voucher_codes":
+                rows = list(batch.values("code"))
+            else:
+                rows = list(batch.values(*headers))
+                for row in rows:
+                    row["id"] = graphene.Node.to_global_id("Voucher", row["id"])
+            append_to_file(rows, data_headers, temporary_file, file_type, ",")
+        # Re-check rights immediately before publishing a download link.
+        actor_for_job(job)
+        authorized_snapshot_queryset(job)
+        save_csv_file_in_export_file(
+            job, temporary_file, get_filename(job.domain, file_type)
+        )
+    finally:
+        temporary_file.close()
