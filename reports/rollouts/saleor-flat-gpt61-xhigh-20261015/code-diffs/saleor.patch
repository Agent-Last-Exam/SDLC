+++ b/saleor/payment/action_reservations.py
@@ -0,0 +1,269 @@
+"""Durable idempotency and capacity accounting shared by payment entry points."""
+
+import hashlib
+import json
+from decimal import Decimal, InvalidOperation
+from uuid import uuid4
+
+from django.core.exceptions import ValidationError
+
+from ..checkout.models import Checkout
+from ..core.prices import quantize_price
+from . import TransactionAction, TransactionEventType
+from .models import PaymentActionRecord
+
+ACTIVE_ACTION_STATES = ("reserved", "requested", "unknown", "action_required")
+
+
+def actor_scope(user=None, app=None):
+    if app:
+        return f"app:{app.identifier or app.pk}"
+    if user and user.is_authenticated:
+        return f"user:{user.pk}"
+    return "checkout-capability"
+
+
+def source_identity(source=None, transaction=None):
+    if transaction:
+        if transaction.source_checkout_token:
+            return "checkout", str(transaction.source_checkout_token)
+        if transaction.checkout_id:
+            return "checkout", str(transaction.checkout_id)
+        return "order", str(transaction.order_id)
+    return ("checkout" if isinstance(source, Checkout) else "order"), str(source.pk)
+
+
+def clean_idempotency_key(key):
+    if key is None:
+        return str(uuid4())
+    if not isinstance(key, str) or not key.strip() or len(key) > 255:
+        raise ValidationError(
+            {
+                "idempotency_key": ValidationError(
+                    "Use a non-empty key of at most 255 characters.", code="invalid"
+                )
+            }
+        )
+    return key
+
+
+def input_fingerprint(data):
+    serialized = json.dumps(data, sort_keys=True, separators=(",", ":"), default=str)
+    return hashlib.sha256(serialized.encode()).hexdigest()
+
+
+def action_identity(
+    *, source=None, transaction=None, provider, action, key, user=None, app=None
+):
+    kind, source_id = source_identity(source, transaction)
+    return {
+        "actor_scope": actor_scope(user, app),
+        "source_kind": kind,
+        "source_id": source_id,
+        "provider_namespace": provider,
+        "action": action,
+        "idempotency_key": key,
+    }
+
+
+def existing_action(identity, fingerprint):
+    record = PaymentActionRecord.objects.filter(**identity).first()
+    if record and record.input_hash != fingerprint:
+        raise ValidationError(
+            {
+                "idempotency_key": ValidationError(
+                    "The key was already used with different inputs.",
+                    code="idempotency_conflict",
+                )
+            }
+        )
+    return record
+
+
+def failure_transaction(error):
+    """Find a definite provider failure without guessing from later payment events."""
+    seen = set()
+    while error is not None and id(error) not in seen:
+        seen.add(id(error))
+        if result := getattr(error, "transaction", None):
+            return result
+        error = error.__cause__
+    return None
+
+
+def replay_action_error(record):
+    errors = record.result_data.get("errors")
+    if errors:
+        raise ValidationError(
+            {
+                field: [
+                    ValidationError(entry["message"], code=entry["code"])
+                    for entry in entries
+                ]
+                for field, entries in errors.items()
+            }
+        )
+
+
+def finish_action(record, *, event=None, data=None, state="succeeded"):
+    record.result_event = event
+    record.state = state
+    record.result_data = data or {}
+    if state in ("succeeded", "failed"):
+        record.reserved_amount = Decimal(0)
+    record.save(
+        update_fields=[
+            "result_event",
+            "state",
+            "result_data",
+            "reserved_amount",
+            "updated_at",
+        ]
+    )
+
+
+def _unrepresented_reservations(transaction, action):
+    records = transaction.action_records.filter(
+        action=action, state__in=ACTIVE_ACTION_STATES
+    )
+    amount = Decimal(0)
+    final_types = {
+        TransactionAction.CHARGE: (
+            TransactionEventType.CHARGE_SUCCESS,
+            TransactionEventType.CHARGE_FAILURE,
+        ),
+        TransactionAction.CANCEL: (
+            TransactionEventType.CANCEL_SUCCESS,
+            TransactionEventType.CANCEL_FAILURE,
+        ),
+        TransactionAction.REFUND: (
+            TransactionEventType.REFUND_SUCCESS,
+            TransactionEventType.REFUND_FAILURE,
+        ),
+    }.get(action, ())
+    for record in records.select_related("request_event"):
+        event = record.request_event
+        if (
+            event
+            and event.psp_reference
+            and transaction.events.filter(
+                psp_reference=event.psp_reference,
+                type__in=final_types,
+                include_in_calculations=True,
+            ).exists()
+        ):
+            continue
+        if event and event.include_in_calculations and event.psp_reference:
+            # This request is already in the pending aggregate.
+            continue
+        amount += record.reserved_amount
+    return amount
+
+
+def available_charge_amount(transaction):
+    return max(
+        Decimal(0),
+        transaction.authorized_value
+        - transaction.charge_pending_value
+        - transaction.cancel_pending_value
+        - _unrepresented_reservations(transaction, TransactionAction.CHARGE)
+        - _unrepresented_reservations(transaction, TransactionAction.CANCEL),
+    )
+
+
+def available_refund_amount(transaction):
+    return max(
+        Decimal(0),
+        transaction.charged_value
+        - transaction.refund_pending_value
+        - _unrepresented_reservations(transaction, TransactionAction.REFUND),
+    )
+
+
+def validate_amount(amount, currency, available=None):
+    if amount is None:
+        amount = available
+    try:
+        amount = Decimal(str(amount))
+        if not amount.is_finite() or amount <= 0:
+            raise InvalidOperation
+        amount = quantize_price(amount, currency)
+    except (InvalidOperation, ValueError, TypeError):
+        raise ValidationError(
+            {
+                "amount": ValidationError(
+                    "Amount must be a finite positive number.", code="invalid_amount"
+                )
+            }
+        ) from None
+    if amount <= 0:
+        raise ValidationError(
+            {
+                "amount": ValidationError(
+                    "Amount must be greater than zero at currency precision.",
+                    code="invalid_amount",
+                )
+            }
+        )
+    if available is not None and amount > available:
+        raise ValidationError(
+            {
+                "amount": ValidationError(
+                    "Amount exceeds the currently available balance.",
+                    code="amount_exceeds_balance",
+                )
+            }
+        )
+    return amount
+
+
+def provider_namespace(transaction):
+    return (
+        transaction.provider_namespace
+        or transaction.app_identifier
+        or (f"app:{transaction.app_id}" if transaction.app_id else "saleor.manual")
+    )
+
+
+def lock_source(source):
+    """All financial entry points take configuration before the payable parent."""
+    from ..channel.models import Channel
+
+    Channel.objects.select_for_update().get(pk=source.channel_id)
+    return (
+        type(source)
+        .objects.select_for_update()
+        .select_related("channel")
+        .get(pk=source.pk)
+    )
+
+
+def touch_transaction_source(transaction):
+    if transaction.checkout_id:
+        from ..checkout.models import touch_checkout
+
+        touch_checkout(transaction.checkout_id)
+
+
+def get_initialization_amount(source, amount):
+    if amount is not None:
+        return validate_amount(amount, source.currency)
+    remaining = source.total_gross_amount
+    for item in source.payment_transactions.exclude(is_legacy_gift_card=True):
+        remaining -= item.authorized_value + item.charged_value
+        # A capture request backed by successful authorization occupies that same
+        # money, not another payment of the checkout's payable amount.
+        remaining -= item.authorize_pending_value + max(
+            item.charge_pending_value - item.authorized_value, Decimal(0)
+        )
+        for record in item.action_records.filter(
+            action="initialize", state__in=ACTIVE_ACTION_STATES
+        ).select_related("request_event"):
+            event = record.request_event
+            if (
+                not event
+                or not event.include_in_calculations
+                or not event.psp_reference
+            ):
+                remaining -= record.reserved_amount
+    return validate_amount(None, source.currency, max(remaining, Decimal(0)))
