@@ -0,0 +1,317 @@
+"""Idempotent external session dispatch with persistent unknown-result tracking."""
+
+from django.conf import settings
+from django.core.exceptions import ValidationError
+from django.db import transaction as db_transaction
+
+from ..channel import TransactionFlowStrategy
+from ..checkout.models import Checkout
+from ..core.db.connection import allow_writer
+from . import FAILED_TRANSACTION_EVENTS, TransactionEventType
+from .action_reservations import (
+    action_identity,
+    clean_idempotency_key,
+    existing_action,
+    finish_action,
+    get_initialization_amount,
+    input_fingerprint,
+    lock_source,
+    provider_namespace,
+    touch_transaction_source,
+)
+from .interface import TransactionProcessActionData, TransactionSessionData
+from .models import PaymentActionRecord, TransactionItem
+
+
+def _session_state(event):
+    if event.type in FAILED_TRANSACTION_EVENTS:
+        return "failed"
+    if event.type in (
+        TransactionEventType.AUTHORIZATION_ACTION_REQUIRED,
+        TransactionEventType.CHARGE_ACTION_REQUIRED,
+    ):
+        return "action_required"
+    if event.type in (
+        TransactionEventType.AUTHORIZATION_SUCCESS,
+        TransactionEventType.CHARGE_SUCCESS,
+    ):
+        return "succeeded"
+    return "requested"
+
+
+def reconcile_session_actions(item):
+    """Release session occupancy only against an exactly linked provider fact."""
+    from .action_reservations import ACTIVE_ACTION_STATES
+
+    for record in item.action_records.filter(
+        action__in=["initialize", "process"], state__in=ACTIVE_ACTION_STATES
+    ).select_related("request_event"):
+        request = record.request_event
+        if not request:
+            continue
+        final_types = (
+            (TransactionEventType.CHARGE_SUCCESS, TransactionEventType.CHARGE_FAILURE)
+            if request.type
+            in (
+                TransactionEventType.CHARGE_REQUEST,
+                TransactionEventType.CHARGE_ACTION_REQUIRED,
+            )
+            else (
+                TransactionEventType.AUTHORIZATION_SUCCESS,
+                TransactionEventType.AUTHORIZATION_FAILURE,
+            )
+        )
+        final = None
+        if request.psp_reference:
+            final = item.events.filter(
+                psp_reference=request.psp_reference,
+                type__in=final_types,
+                include_in_calculations=True,
+            ).first()
+        if final:
+            record.state = _session_state(final)
+            record.reserved_amount = 0
+            if record.result_event_id is None:
+                record.result_event = final
+            record.save(
+                update_fields=["state", "reserved_amount", "result_event", "updated_at"]
+            )
+        elif request.include_in_calculations and request.psp_reference:
+            # A represented request is already subtracted by the pending aggregate.
+            record.reserved_amount = 0
+            record.save(update_fields=["reserved_amount", "updated_at"])
+
+
+@allow_writer()
+def initialize_external_session(
+    *,
+    source_object,
+    payment_gateway_data,
+    amount,
+    action,
+    customer_ip_address,
+    app,
+    manager,
+    idempotency_key,
+    user=None,
+    requestor_app=None,
+    input_action=None,
+):
+    key = clean_idempotency_key(idempotency_key)
+    identity = action_identity(
+        source=source_object,
+        provider=payment_gateway_data.app_identifier,
+        action="initialize",
+        key=key,
+        user=user,
+        app=requestor_app,
+    )
+    fingerprint = input_fingerprint(
+        {
+            "amount": amount,
+            "action": input_action,
+            "currency": source_object.currency,
+            "data": payment_gateway_data.data,
+        }
+    )
+    with db_transaction.atomic():
+        source = lock_source(source_object)
+        if record := existing_action(identity, fingerprint):
+            return (
+                record.transaction,
+                record.result_event or record.request_event,
+                record.result_data.get("data"),
+            )
+        if isinstance(source, Checkout) and source.is_checkout_locked():
+            raise ValidationError(
+                {
+                    "id": ValidationError(
+                        "Checkout completion is in progress.",
+                        code="checkout_completion_in_progress",
+                    )
+                }
+            )
+        if source.payment_transactions.count() >= settings.TRANSACTION_ITEMS_LIMIT:
+            raise ValidationError(
+                {
+                    "id": ValidationError(
+                        "Transaction limit reached.", code="invalid_state"
+                    )
+                }
+            )
+        requested = get_initialization_amount(source, amount)
+        from .utils import get_transaction_item_params
+
+        previous_payments = []
+        if isinstance(source, Checkout):
+            from ..checkout.utils import cancel_active_payments
+
+            previous_payments = cancel_active_payments(source)
+        params = get_transaction_item_params(source, None, app, None)
+        item = TransactionItem.objects.create(
+            **params, provider_namespace=app.identifier
+        )
+        record = PaymentActionRecord.objects.create(
+            **identity,
+            input_hash=fingerprint,
+            requested_amount=requested,
+            reserved_amount=requested,
+            currency=source.currency,
+            transaction=item,
+            state="requested",
+        )
+        event_type = (
+            TransactionEventType.CHARGE_REQUEST
+            if action == TransactionFlowStrategy.CHARGE
+            else TransactionEventType.AUTHORIZATION_REQUEST
+        )
+        request = item.events.create(
+            type=event_type,
+            amount_value=requested,
+            currency=source.currency,
+            idempotency_key=f"initialize:{record.pk}",
+        )
+        record.request_event = request
+        record.save(update_fields=["request_event"])
+        if hasattr(source, "payment_flow"):
+            source.payment_flow = "transaction"
+            source.save(update_fields=["payment_flow"])
+        touch_transaction_source(item)
+    session = TransactionSessionData(
+        transaction=item,
+        source_object=source,
+        payment_gateway_data=payment_gateway_data,
+        action=TransactionProcessActionData(
+            action_type=action, currency=source.currency, amount=requested
+        ),
+        customer_ip_address=customer_ip_address,
+        idempotency_key=f"initialize:{record.pk}",
+    )
+    try:
+        result = manager.transaction_initialize_session(session)
+        response = result.response if result else None
+        from .utils import create_transaction_event_for_transaction_session
+
+        event = create_transaction_event_for_transaction_session(
+            request, app, manager, transaction_webhook_response=response
+        )
+        data = response.get("data") if response else None
+        state = _session_state(event)
+        if state == "failed" and previous_payments:
+            from ..checkout.utils import activate_payments
+
+            activate_payments(previous_payments)
+        finish_action(record, event=event, data={"data": data}, state=state)
+        if event.include_in_calculations and event.psp_reference:
+            record.reserved_amount = 0
+            record.save(update_fields=["reserved_amount"])
+        return event.transaction, event, data
+    except Exception:
+        record.state = "unknown"
+        record.save(update_fields=["state"])
+        raise
+
+
+@allow_writer()
+def process_external_session(
+    *,
+    item,
+    source,
+    request_event,
+    data,
+    app,
+    action,
+    customer_ip_address,
+    manager,
+    key=None,
+    user=None,
+    requestor_app=None,
+):
+    key = clean_idempotency_key(key)
+    identity = action_identity(
+        transaction=item,
+        provider=provider_namespace(item),
+        action="process",
+        key=key,
+        user=user,
+        app=requestor_app,
+    )
+    fingerprint = input_fingerprint({"transaction": str(item.token), "data": data})
+    with db_transaction.atomic():
+        source = lock_source(source)
+        item = TransactionItem.objects.select_for_update().get(pk=item.pk)
+        if record := existing_action(identity, fingerprint):
+            return record.result_event or record.request_event, record.result_data.get(
+                "data"
+            )
+        finals = item.events.filter(
+            include_in_calculations=True,
+            type__in=(
+                TransactionEventType.AUTHORIZATION_SUCCESS,
+                TransactionEventType.CHARGE_SUCCESS,
+            ),
+        )
+        event = finals.first()
+        record = PaymentActionRecord.objects.create(
+            **identity,
+            input_hash=fingerprint,
+            transaction=item,
+            currency=item.currency,
+            requested_amount=request_event.amount_value,
+            request_event=request_event,
+            state="requested",
+        )
+        if event:
+            finish_action(record, event=event)
+            return event, None
+        if isinstance(source, Checkout) and source.is_checkout_locked():
+            raise ValidationError(
+                {
+                    "id": ValidationError(
+                        "Checkout completion is in progress.",
+                        code="checkout_completion_in_progress",
+                    )
+                }
+            )
+        other = (
+            item.action_records.filter(
+                action="process", state__in=["requested", "unknown"]
+            )
+            .exclude(pk=record.pk)
+            .first()
+        )
+        if other:
+            record.state = "failed"
+            record.save(update_fields=["state"])
+            raise ValidationError(
+                {
+                    "id": ValidationError(
+                        "A continuation is already pending; retry its original key.",
+                        code="invalid_state",
+                    )
+                }
+            )
+    from .interface import PaymentGatewayData
+    from .utils import handle_transaction_process_session
+
+    try:
+        event, response_data = handle_transaction_process_session(
+            transaction_item=item,
+            source_object=source,
+            payment_gateway_data=PaymentGatewayData(
+                app_identifier=app.identifier, data=data
+            ),
+            action=action,
+            app=app,
+            customer_ip_address=customer_ip_address,
+            manager=manager,
+            request_event=request_event,
+            idempotency_key=f"process:{record.pk}",
+        )
+        state = _session_state(event)
+        finish_action(record, event=event, data={"data": response_data}, state=state)
+        return event, response_data
+    except Exception:
+        record.state = "unknown"
+        record.save(update_fields=["state"])
+        raise
