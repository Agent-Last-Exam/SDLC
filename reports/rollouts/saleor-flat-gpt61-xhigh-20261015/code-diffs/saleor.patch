+from django.db import migrations, models
+
+
+def map_known_settings(apps, schema_editor):
+    Extension = apps.get_model("app", "AppExtension")
+    for target in ("new_tab", "widget"):
+        for method in ("GET", "POST"):
+            Extension.objects.filter(target=target, http_target_method=method).update(
+                settings={"method": method}
+            )
+    App = apps.get_model("app", "App")
+    duplicates = (
+        App.objects.filter(removed_at__isnull=True)
+        .exclude(identifier="")
+        .values("identifier")
+        .annotate(count=models.Count("id"))
+        .filter(count__gt=1)
+    )
+    if duplicates.exists():
+        raise RuntimeError(
+            "Duplicate nonremoved App identifiers must be audited before enabling app_active_identifier_unique; no apps were changed or deleted."
+        )
+
+
+class Migration(migrations.Migration):
+    dependencies = [("app", "0032_appextension_http_target_method_and_more")]
+    operations = [
+        migrations.AddField(
+            model_name="app",
+            name="settings_version",
+            field=models.PositiveIntegerField(default=0),
+        ),
+        migrations.AddField(
+            model_name="app",
+            name="token_target_url",
+            field=models.URLField(blank=True, null=True),
+        ),
+        migrations.AddField(
+            model_name="appextension",
+            name="settings",
+            field=models.JSONField(blank=True, default=dict),
+        ),
+        migrations.RunPython(map_known_settings, migrations.RunPython.noop),
+        migrations.AddConstraint(
+            model_name="app",
+            constraint=models.UniqueConstraint(
+                fields=("identifier",),
+                condition=models.Q(removed_at__isnull=True) & ~models.Q(identifier=""),
+                name="app_active_identifier_unique",
+            ),
+        ),
+    ]
