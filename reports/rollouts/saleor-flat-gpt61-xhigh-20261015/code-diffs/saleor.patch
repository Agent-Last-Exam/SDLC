index 000000000..b84a686cf
--- /dev/null
+++ b/saleor/core/search.py
@@ -0,0 +1,239 @@
+"""The bounded search contract shared by Product, Order, GiftCard and Checkout.
+
+User and Page intentionally do not use this module: their basic search contract is
+unchanged. Query text is never interpolated into SQL.
+"""
+
+import hashlib
+import json
+import unicodedata
+from dataclasses import dataclass
+
+from django.contrib.postgres.search import SearchQuery, SearchRank
+from django.db.models import (
+    BigIntegerField,
+    BooleanField,
+    CharField,
+    DecimalField,
+    F,
+    Func,
+    Q,
+    Value,
+)
+from django.db.models.functions import Cast, Coalesce, Round
+from graphql import GraphQLError
+
+from .postgres import FlatConcatSearchVector, NoValidationSearchVector
+
+MAX_SEARCH_LENGTH = 256
+RANK_SCALE = 1_000_000
+
+
+def _search_words(value):
+    """Keep Unicode combining marks and PostgreSQL identifier punctuation.
+
+    A casefold can introduce a mark (İ -> i + dot), which must not split a
+    single indexed lexeme. Slashes in file/path references are PostgreSQL words.
+    """
+    words = []
+    current = []
+    for character in value:
+        if (
+            unicodedata.category(character)[0] in {"L", "N", "M"}
+            or character in "_@.-/"
+        ):
+            current.append(character)
+        else:
+            if current and any(
+                unicodedata.category(char)[0] in {"L", "N"} for char in current
+            ):
+                words.append("".join(current))
+            current = []
+    if current and any(unicodedata.category(char)[0] in {"L", "N"} for char in current):
+        words.append("".join(current))
+    return words
+
+
+def search_input_error(message):
+    error = GraphQLError(message)
+    error.extensions = {"code": "INPUT_ERROR", "field": "search"}
+    return error
+
+
+def normalize_search_text(value):
+    return unicodedata.normalize("NFKC", str(value or "")).casefold()
+
+
+@dataclass(frozen=True)
+class SearchTerm:
+    text: str
+    phrase: bool = False
+    prefix: bool = False
+
+
+@dataclass(frozen=True)
+class ParsedSearch:
+    terms: tuple[SearchTerm, ...]
+
+    @property
+    def fingerprint(self):
+        serialized = json.dumps(
+            [(term.text, term.phrase, term.prefix) for term in self.terms],
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+        return hashlib.sha256(serialized.encode()).hexdigest()
+
+    @property
+    def query(self):
+        query = None
+        for term in self.terms:
+            if term.phrase:
+                item = SearchQuery(term.text, search_type="phrase", config="simple")
+            else:
+                # The raw grammar is built from a single, escaped lexeme. In
+                # particular OR, hyphens and tsquery operators are never syntax.
+                lexeme = term.text.replace("\\", "\\\\").replace("'", "''")
+                item = SearchQuery(
+                    "'" + lexeme + "'" + (":*" if term.prefix else ""),
+                    search_type="raw",
+                    config="simple",
+                )
+            query = item if query is None else query & item
+        return query
+
+
+def parse_search(value):
+    if value is None:
+        return ParsedSearch(())
+    if not isinstance(value, str):
+        raise search_input_error("Search must be a string.")
+    if len(value) > MAX_SEARCH_LENGTH:
+        raise search_input_error("Search cannot exceed 256 Unicode characters.")
+    if any(unicodedata.category(char) in {"Cc", "Cs"} for char in value):
+        raise search_input_error("Search contains an invalid control character.")
+    text = normalize_search_text(value).strip()
+    terms = []
+    offset = 0
+    while offset < len(text):
+        if text[offset].isspace():
+            offset += 1
+            continue
+        if text[offset] == '"':
+            end = text.find('"', offset + 1)
+            if end < 0:
+                raise search_input_error("Search contains an unclosed quotation mark.")
+            words = _search_words(text[offset + 1 : end])
+            if not words:
+                raise search_input_error("A search phrase must contain a word.")
+            terms.append(SearchTerm(" ".join(words), phrase=True))
+            offset = end + 1
+            if offset < len(text) and not text[offset].isspace():
+                raise search_input_error("Search phrases must be separated by spaces.")
+        else:
+            end = offset
+            while end < len(text) and not text[end].isspace():
+                if text[end] == '"':
+                    raise search_input_error(
+                        "Search phrases must be separated by spaces."
+                    )
+                end += 1
+            terms.extend(SearchTerm(word) for word in _search_words(text[offset:end]))
+            offset = end
+    # Conditions are deduplicated, but the original trailing token must retain
+    # its position: "red shoes red" prefixes red, never the middle word shoes.
+    trailing = terms[-1] if terms else None
+    terms = list(dict.fromkeys(terms))
+    if trailing is not None and not trailing.phrase:
+        terms = [term for term in terms if term != trailing]
+        terms.append(SearchTerm(trailing.text, prefix=True))
+    return ParsedSearch(tuple(terms))
+
+
+class PhraseInSearchField(Func):
+    """Require phrase positions to belong to one independently indexed field."""
+
+    output_field = BooleanField()
+
+    def as_sql(self, compiler, connection, **extra_context):
+        fields_sql, fields_params = compiler.compile(self.source_expressions[0])
+        query_sql, query_params = compiler.compile(self.source_expressions[1])
+        return (
+            "EXISTS (SELECT 1 FROM unnest(" + fields_sql + ") AS search_field(value) "
+            "WHERE to_tsvector('simple'::regconfig, search_field.value) @@ "
+            + query_sql
+            + ")",
+            [*fields_params, *query_params],
+        )
+
+
+def search_queryset(queryset, value, *, exact_match=None):
+    parsed = parse_search(value)
+    query = parsed.query
+    if query is None:
+        return queryset
+    matches = Q(search_vector=query)
+    if exact_match is not None:
+        matches |= exact_match
+    queryset = queryset.filter(matches)
+    for term in parsed.terms:
+        if term.phrase:
+            queryset = queryset.filter(
+                PhraseInSearchField(
+                    F("search_fields"),
+                    SearchQuery(term.text, search_type="phrase", config="simple"),
+                )
+            )
+    rank = Coalesce(SearchRank(F("search_vector"), query), Value(0.0))
+    # PostgreSQL round(double precision, integer) is not supported. Cast before
+    # rounding; ORDER BY, cursor and seek all consume this same bigint value.
+    rank_key = Cast(
+        Round(
+            Cast(
+                rank * Value(RANK_SCALE), DecimalField(max_digits=30, decimal_places=10)
+            )
+        ),
+        BigIntegerField(),
+    )
+    return queryset.annotate(
+        search_rank=rank,
+        search_rank_key=rank_key,
+        search_scope_fingerprint=Value(parsed.fingerprint, output_field=CharField()),
+    )
+
+
+def require_search_rank(queryset, **_kwargs):
+    if "search_rank_key" not in queryset.query.annotations:
+        raise search_input_error("Sorting by RANK requires a non-empty search.")
+    return queryset
+
+
+def prepare_search_document(vectors):
+    """Normalize original fields and retain their weights and phrase boundaries.
+
+    Base vector builders use Value expressions, occasionally with several
+    independent fields in one vector (SKU and name). Split those expressions to
+    avoid treating the last word of SKU and first word of name as a phrase.
+    """
+    normalized_vectors = []
+    fields = []
+    for vector in vectors:
+        for expression in vector.get_source_expressions():
+            if not isinstance(expression, Value):
+                raise TypeError(
+                    "Subject search document fields must be literal values."
+                )
+            text = normalize_search_text(expression.value)
+            if not text:
+                continue
+            fields.append(text)
+            normalized_vectors.append(
+                NoValidationSearchVector(
+                    Value(text),
+                    config="simple",
+                    weight=vector.weight.value if vector.weight is not None else None,
+                )
+            )
+    if not normalized_vectors:
+        normalized_vectors = [NoValidationSearchVector(Value(""), config="simple")]
+    return FlatConcatSearchVector(*normalized_vectors), fields
