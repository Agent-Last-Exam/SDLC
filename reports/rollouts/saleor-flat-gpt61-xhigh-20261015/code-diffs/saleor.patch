@@ -0,0 +1,65 @@
+"""Backfill completion facts without choosing between conflicting historical orders."""
+
+import uuid
+
+from django.db import migrations
+
+DUPLICATE_MESSAGE = "Multiple historical orders reference this checkout. Manual reconciliation is required."
+
+
+def backfill_completion_records(apps, schema_editor):
+    Order = apps.get_model("order", "Order")
+    Record = apps.get_model("checkout", "CheckoutCompletionRecord")
+    alias = schema_editor.connection.alias
+    records = Record.objects.using(alias)
+    orders = (
+        Order.objects.using(alias)
+        .exclude(checkout_token="")
+        .exclude(status="draft")
+        .order_by("pk")
+        .values("pk", "checkout_token", "channel_id")
+    )
+    for order in orders.iterator(chunk_size=1000):
+        try:
+            token = uuid.UUID(order["checkout_token"])
+        except (ValueError, TypeError, AttributeError):
+            # Invalid historical identifiers cannot be invented or repaired here.
+            continue
+        record, created = records.get_or_create(
+            checkout_token=token,
+            defaults={
+                "channel_id": order["channel_id"],
+                "order_id": order["pk"],
+                "status": "completed",
+            },
+        )
+        if created or record.order_id == order["pk"]:
+            continue
+        if record.order_id is None and record.error_code != "conflict":
+            records.filter(pk=record.pk).update(
+                order_id=order["pk"],
+                status="completed",
+                lease_until=None,
+                next_attempt_at=None,
+                error_code="",
+                error_field="",
+                safe_message="",
+            )
+            continue
+        records.filter(pk=record.pk).update(
+            order_id=None,
+            status="blocked",
+            lease_until=None,
+            next_attempt_at=None,
+            error_code="conflict",
+            error_field="checkout",
+            safe_message=DUPLICATE_MESSAGE,
+        )
+
+
+class Migration(migrations.Migration):
+    dependencies = [("checkout", "0081_sprint1_checkout_consistency")]
+
+    operations = [
+        migrations.RunPython(backfill_completion_records, migrations.RunPython.noop)
+    ]
