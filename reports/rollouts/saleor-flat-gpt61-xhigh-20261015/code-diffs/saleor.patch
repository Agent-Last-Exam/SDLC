--- /dev/null
+++ b/saleor/warehouse/source.py
@@ -0,0 +1,51 @@
+"""The shared stock-source boundary for reads and new warehouse actions.
+
+Stock source and allocation priority are intentionally independent. Address arguments
+remain accepted in CHANNEL mode, but cannot alter its direct warehouse membership.
+"""
+
+from django.conf import settings
+from django.db import transaction
+
+from ..channel import StockSourceStrategy
+from ..channel.models import Channel
+from .models import Warehouse
+
+
+def eligible_warehouse_ids(
+    channel: Channel,
+    country_code: str | None = None,
+    *,
+    include_collection_points: bool = False,
+    database_connection_name: str = settings.DATABASE_CONNECTION_DEFAULT_NAME,
+):
+    warehouses = Warehouse.objects.using(database_connection_name)
+    current = Channel.objects.using(database_connection_name).get(pk=channel.pk)
+    if current.stock_source_strategy == StockSourceStrategy.CHANNEL:
+        warehouses = warehouses.for_channel(current.pk)
+    elif country_code:
+        eligible = warehouses.for_country_and_channel(country_code, current.pk)
+        if include_collection_points:
+            from . import WarehouseClickAndCollectOption
+
+            eligible = eligible | warehouses.for_channel(current.pk).filter(
+                click_and_collect_option__in=[
+                    WarehouseClickAndCollectOption.LOCAL_STOCK,
+                    WarehouseClickAndCollectOption.ALL_WAREHOUSES,
+                ]
+            )
+        warehouses = eligible
+    else:
+        warehouses = warehouses.for_channel_with_active_shipping_zone_or_cc(
+            current.slug
+        )
+    return warehouses.order_by("pk").values_list("pk", flat=True)
+
+
+def lock_channel_stock_settings(channel: Channel) -> Channel:
+    """Read writer settings under the shared Channel-first business lock order."""
+    if not transaction.get_connection().in_atomic_block:
+        raise RuntimeError(
+            "Stock-source configuration must be locked in a transaction."
+        )
+    return Channel.objects.select_for_update().get(pk=channel.pk)
