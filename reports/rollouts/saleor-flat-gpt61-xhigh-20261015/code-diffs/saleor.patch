@@ -0,0 +1,307 @@
+import copy
+
+import pytest
+from django.core.exceptions import ValidationError
+
+from ..editorjs import clean_editor_js, validate_editor_js
+
+
+def _paragraph(text):
+    return {"blocks": [{"type": "paragraph", "data": {"text": text}}]}
+
+
+def _nested_list(depth):
+    item = {"content": f"level {depth}", "meta": {"checked": False}, "items": []}
+    for level in range(depth - 1, 0, -1):
+        item = {"content": f"level {level}", "items": [item]}
+    return {
+        "blocks": [{"type": "list", "data": {"style": "checklist", "items": [item]}}]
+    }
+
+
+@pytest.mark.parametrize(
+    "url",
+    [
+        "javascript:alert(1)",
+        "JaVaScRiPt:alert(1)",
+        "data:text/html,test",
+        "file:///etc/passwd",
+        "vbscript:msgbox(1)",
+        "java&#x73;cript:alert(1)",
+        "java%73cript:alert(1)",
+        "java%2573cript:alert(1)",
+        "javascript%EF%BC%9Aalert(1)",
+        "javascript&#xFF1A;alert(1)",
+        "java&#9;script:alert(1)",
+        "java%0ascript:alert(1)",
+        "//evil.example/path",
+        "%2f%2fevil.example/path",
+        "https:\\evil.example",
+        "https://user:password@example.com",
+        "https://example.com:bad/path",
+        "https:///missing-host",
+    ],
+)
+def test_sprint1_editorjs_rejects_unsafe_url_without_mutating_input(url):
+    # given
+    value = _paragraph(f'<a href="{url}">link</a>')
+    original = copy.deepcopy(value)
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        clean_editor_js(value)
+
+    # then
+    assert error.value.code == "unsafe_url"
+    assert value == original
+    assert url not in str(error.value)
+
+
+@pytest.mark.parametrize(
+    "url",
+    [
+        "http://example.com/path",
+        "https://example.com/?a=1&b=2",
+        "mailto:test@example.com",
+        "tel:+123456789",
+        "/internal/page",
+        "#anchor",
+        "?page=2",
+        "./page",
+    ],
+)
+def test_sprint1_editorjs_fixed_legal_link_schemes(url):
+    # given
+    value = _paragraph(f'<a href="{url}">link</a>')
+
+    # when
+    cleaned = clean_editor_js(value)
+
+    # then
+    assert "href=" in cleaned["blocks"][0]["data"]["text"]
+    assert clean_editor_js(cleaned) == cleaned
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        {},
+        [],
+        {"blocks": None},
+        {"blocks": [], "unknown": True},
+        {"blocks": [None]},
+        {"blocks": [{"type": "paragraph", "data": {}}]},
+        {"blocks": [{"type": "paragraph", "data": {"text": "ok", "extra": True}}]},
+        {"blocks": [{"type": "paragraph", "data": {"text": "ok"}, "tunes": {"x": 1}}]},
+        {"blocks": [{"type": "header", "data": {"text": "ok", "level": True}}]},
+        {"blocks": [{"type": "header", "data": {"text": "ok", "level": 7}}]},
+        {"blocks": [{"type": "unknown", "data": {}}]},
+        {
+            "blocks": [
+                {
+                    "type": "list",
+                    "data": {
+                        "style": "unordered",
+                        "items": ["text", {"content": "item"}],
+                    },
+                }
+            ]
+        },
+        {
+            "blocks": [
+                {
+                    "type": "list",
+                    "data": {
+                        "style": "checklist",
+                        "items": [{"content": "item", "meta": {"checked": 1}}],
+                    },
+                }
+            ]
+        },
+        {
+            "blocks": [
+                {
+                    "type": "list",
+                    "data": {"style": "ordered", "items": [], "meta": {"start": 0}},
+                }
+            ]
+        },
+    ],
+)
+def test_sprint1_editorjs_rejects_entire_invalid_structure(value):
+    # given
+    original = copy.deepcopy(value)
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        clean_editor_js(value)
+
+    # then
+    assert error.value.code == "invalid_rich_text_structure"
+    assert value == original
+
+
+def test_sprint1_editorjs_depth_ten_preserves_all_items_and_search_text():
+    # given
+    value = _nested_list(10)
+
+    # when
+    cleaned = clean_editor_js(value)
+    text = clean_editor_js(value, to_string=True)
+
+    # then
+    assert cleaned == value
+    assert cleaned is not value
+    assert "level 10" in text
+    assert "level 1" in text
+
+
+def test_sprint1_editorjs_depth_eleven_rejects_entire_write():
+    # given
+    value = _nested_list(11)
+    original = copy.deepcopy(value)
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        clean_editor_js(value)
+
+    # then
+    assert error.value.code == "rich_text_too_deep"
+    assert value == original
+
+
+def test_sprint1_editorjs_sanitizes_attributes_and_protects_blank_target():
+    # given
+    value = _paragraph(
+        '<a href="https://example.com" target="_blank" rel="opener nofollow" onclick="evil()">safe</a><img onerror="evil()"><b style="color:red">bold</b>'
+    )
+
+    # when
+    text = clean_editor_js(value)["blocks"][0]["data"]["text"]
+
+    # then
+    assert 'rel="nofollow noopener noreferrer"' in text
+    assert 'target="_blank"' in text
+    assert "onclick" not in text
+    assert "onerror" not in text
+    assert "style=" not in text
+    assert "<img" not in text
+    assert "<b>bold</b>" in text
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        '<img src="javascript:evil()">',
+        '<svg><a xlink:href="data:evil">x</a></svg>',
+        '<a href="https://safe.example" href="javascript:evil()">x</a>',
+    ],
+)
+def test_sprint1_editorjs_dropped_tags_do_not_hide_unsafe_urls(text):
+    # given
+    value = _paragraph(text)
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        validate_editor_js(value)
+
+    # then
+    assert error.value.code == "unsafe_url"
+
+
+def test_sprint1_editorjs_all_frozen_blocks():
+    # given
+    value = {
+        "time": 1,
+        "version": "2.30.0",
+        "blocks": [
+            {
+                "id": "p",
+                "type": "paragraph",
+                "data": {"text": "paragraph"},
+                "tunes": {},
+            },
+            {"type": "header", "data": {"text": "heading", "level": 6}},
+            {
+                "type": "quote",
+                "data": {"text": "quote", "caption": "caption", "alignment": "center"},
+            },
+            {
+                "type": "list",
+                "data": {
+                    "style": "ordered",
+                    "items": ["legacy"],
+                    "meta": {"start": 2, "counterType": "lower-roman"},
+                },
+            },
+            {
+                "type": "image",
+                "data": {
+                    "file": {"url": "/image.png", "width": 320, "height": 240},
+                    "withBorder": False,
+                },
+            },
+            {
+                "type": "embed",
+                "data": {
+                    "service": "youtube",
+                    "source": "https://example.com/a",
+                    "embed": "https://example.com/b",
+                    "width": 640.5,
+                    "height": 480,
+                },
+            },
+        ],
+    }
+
+    # when
+    cleaned = clean_editor_js(value)
+
+    # then
+    assert cleaned == value
+
+
+def test_sprint1_editorjs_clear_and_tolerant_historical_extraction():
+    # given
+    invalid_historical = {"blocks": [None, {"data": {"text": "<b>old</b>"}}]}
+
+    # when / then
+    assert clean_editor_js(None) is None
+    assert clean_editor_js(invalid_historical, to_string=True) == "old"
+    assert clean_editor_js({}, to_string=True) == ""
+
+
+@pytest.mark.parametrize("value", [{}, [], "", {"blocks": [], "extra": True}])
+def test_sprint1_editorjs_model_validation_rejects_empty_or_unknown_structure(value):
+    # given
+    from ....page.models import Page
+
+    page = Page(title="Title", slug="slug", content=value)
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        page.clean_fields(exclude=["page_type"])
+
+    # then
+    assert error.value.error_dict["content"][0].code == "invalid_rich_text_structure"
+
+
+def test_sprint1_editorjs_model_validation_sanitizes_before_any_save():
+    # given
+    from ....page.models import Page
+
+    page = Page(
+        title="Title",
+        slug="slug",
+        content=_paragraph(
+            '<a href="https://example.com" target="_blank" onclick="bad()">safe</a>'
+        ),
+    )
+
+    # when
+    page.clean_fields(exclude=["page_type"])
+
+    # then
+    text = page.content["blocks"][0]["data"]["text"]
+    assert "onclick" not in text
+    assert 'rel="noopener noreferrer"' in text
diff --git a/saleor/csv/authorization.py b/saleor/csv/authorization.py
new file mode 100644
index 000000000..f6dffeb73
--- /dev/null
+++ b/saleor/csv/authorization.py
@@ -0,0 +1,190 @@
+"""Domain AND export permission checks shared by requests, workers and downloads."""
+
+from django.conf import settings
+
+from ..account.models import User
+from ..app.models import App
+from ..channel.models import Channel
+from ..core.db.connection import allow_writer
+from ..core.exceptions import PermissionDenied
+from ..permission.enums import (
+    DiscountPermissions,
+    GiftcardPermissions,
+    ProductPermissions,
+)
+
+DOMAIN_PERMISSIONS = {
+    "products": (
+        ProductPermissions.MANAGE_PRODUCTS,
+        ProductPermissions.MANAGE_PRODUCT_EXPORTS,
+    ),
+    "gift_cards": (
+        GiftcardPermissions.MANAGE_GIFT_CARD,
+        GiftcardPermissions.MANAGE_GIFT_CARD_EXPORTS,
+    ),
+    "vouchers": (
+        DiscountPermissions.MANAGE_DISCOUNTS,
+        DiscountPermissions.MANAGE_VOUCHER_EXPORTS,
+    ),
+    "voucher_codes": (
+        DiscountPermissions.MANAGE_DISCOUNTS,
+        DiscountPermissions.MANAGE_VOUCHER_EXPORTS,
+    ),
+}
+
+
+def actor_scope(actor):
+    if isinstance(actor, App):
+        return f"app:{actor.pk}"
+    if isinstance(actor, User):
+        return f"user:{actor.pk}"
+    raise PermissionDenied()
+
+
+@allow_writer()
+def fresh_actor(actor):
+    """Never reuse request permission caches for a side-effectful export."""
+    writer = settings.DATABASE_CONNECTION_DEFAULT_NAME
+    if isinstance(actor, App):
+        actor = (
+            App.objects.using(writer)
+            .filter(pk=actor.pk, is_active=True, removed_at__isnull=True)
+            .first()
+        )
+    elif isinstance(actor, User):
+        actor = (
+            User.objects.using(writer)
+            .filter(pk=actor.pk, is_active=True, is_staff=True)
+            .first()
+        )
+    else:
+        actor = None
+    if actor is None:
+        raise PermissionDenied()
+    return actor
+
+
+@allow_writer()
+def actor_has_permissions(actor, permissions):
+    if isinstance(actor, User) and actor.is_superuser:
+        return True
+    queryset = (
+        actor.permissions.all()
+        if isinstance(actor, App)
+        else actor.effective_permissions
+    )
+    actual = {
+        f"{app_label}.{codename}"
+        for app_label, codename in queryset.using(
+            settings.DATABASE_CONNECTION_DEFAULT_NAME
+        ).values_list("content_type__app_label", "codename")
+    }
+    return all(permission.value in actual for permission in permissions)
+
+
+def require_export_permission(actor, domain):
+    actor = fresh_actor(actor)
+    permissions = DOMAIN_PERMISSIONS.get(domain)
+    if permissions is None or not actor_has_permissions(actor, permissions):
+        raise PermissionDenied(
+            "Both the domain and its export permission are required."
+        )
+    return actor
+
+
+@allow_writer()
+def allowed_channel_ids(actor):
+    writer = settings.DATABASE_CONNECTION_DEFAULT_NAME
+    if isinstance(actor, App) or actor.is_superuser:
+        return None
+    groups = actor.groups.using(writer)
+    # Preserve Base unrestricted groups; direct permission-only users are not
+    # artificially locked out of a global product/voucher management scope.
+    if (
+        not groups.exists()
+        or groups.filter(restricted_access_to_channels=False).exists()
+    ):
+        return None
+    return list(
+        Channel.objects.using(writer)
+        .filter(group__in=groups)
+        .distinct()
+        .values_list("pk", flat=True)
+    )
+
+
+@allow_writer()
+def allowed_warehouse_ids(actor):
+    channels = allowed_channel_ids(actor)
+    if channels is None:
+        return None
+    from django.db.models import Q
+
+    from ..warehouse.models import Warehouse
+
+    return list(
+        Warehouse.objects.using(settings.DATABASE_CONNECTION_DEFAULT_NAME)
+        .filter(
+            Q(channels__pk__in=channels) | Q(shipping_zones__channels__pk__in=channels)
+        )
+        .distinct()
+        .values_list("pk", flat=True)
+    )
+
+
+def scope_queryset(queryset, actor, domain):
+    channels = allowed_channel_ids(actor)
+    if channels is None:
+        return queryset
+    if domain == "products":
+        return queryset.filter(channel_listings__channel_id__in=channels).distinct()
+    if domain == "vouchers":
+        return queryset.filter(channel_listings__channel_id__in=channels).distinct()
+    if domain == "voucher_codes":
+        return queryset.filter(
+            voucher__channel_listings__channel_id__in=channels
+        ).distinct()
+    # Gift-card management is global in Base; it has no channel FK. No invented
+    # channel association is inferred from the user who redeemed a card.
+    return queryset
+
+
+def require_job_access(job, actor):
+    actor = require_export_permission(actor, job.domain)
+    if job.actor_scope != actor_scope(actor):
+        raise PermissionDenied()
+    if isinstance(actor, App):
+        if job.app_id != actor.pk:
+            raise PermissionDenied()
+    elif job.user_id != actor.pk or job.app_id:
+        raise PermissionDenied()
+    return actor
+
+
+@allow_writer()
+def actor_for_job(job):
+    if job.app_id:
+        actor = (
+            App.objects.using(settings.DATABASE_CONNECTION_DEFAULT_NAME)
+            .filter(pk=job.app_id)
+            .first()
+        )
+    else:
+        actor = (
+            User.objects.using(settings.DATABASE_CONNECTION_DEFAULT_NAME)
+            .filter(pk=job.user_id)
+            .first()
+        )
+    return require_job_access(job, actor)
+
+
+def authorized_jobs(queryset, actor):
+    actor = fresh_actor(actor)
+    domains = [
+        domain
+        for domain, perms in DOMAIN_PERMISSIONS.items()
+        if actor_has_permissions(actor, perms)
+    ]
+    if not domains:
+        raise PermissionDenied()
+    return queryset.filter(domain__in=domains, actor_scope=actor_scope(actor))
