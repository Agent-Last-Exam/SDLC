+    schedule = mocker.patch(
+        "saleor.graphql.account.mutations.authentication.request_password_reset."
+        "trigger_send_password_reset_notification.delay"
+    )
+
+    # when
+    known = api_client.post_graphql(RESET, {"email": customer_user.email}).json()
+    unknown = api_client.post_graphql(RESET, {"email": "unknown@example.com"}).json()
+
+    # then
+    assert known == unknown
+    assert known["data"] == {"requestPasswordReset": {"errors": []}}
+    schedule.assert_called_once()
