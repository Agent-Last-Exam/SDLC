@@ -0,0 +1,195 @@
+"""Server-owned money decomposition; successful net amounts are not reduced twice."""
+
+from dataclasses import dataclass
+from decimal import Decimal, InvalidOperation
+
+from prices import Money, TaxedMoney
+
+from ..giftcard import GiftCardEvents
+from ..giftcard.models import GiftCardEvent
+from . import (
+    GiftCardAmountBasis,
+    PaymentAggregationFlow,
+    PaymentMethodType,
+    TransactionKind,
+)
+
+
+@dataclass
+class PaymentSummaryData:
+    merchandise_after_discounts: TaxedMoney
+    shipping_after_discounts: TaxedMoney
+    discount: Money
+    tax: Money
+    total: Money
+    payable_before_gift_cards: Money
+    gift_card_charged: Money
+    authorized: Money
+    charged: Money
+    refunded: Money
+    charge_pending: Money
+    refund_pending: Money
+    balance: Money
+    outstanding: Money
+    gift_card_amount_basis: str
+    payment_flow: str
+
+
+def _legacy_gift_card_amount(order):
+    amount = Decimal(0)
+    for event in GiftCardEvent.objects.using(order._state.db).filter(
+        order=order, type=GiftCardEvents.USED_IN_ORDER
+    ):
+        parameters = event.parameters
+        if not isinstance(parameters, dict):
+            continue
+        balance = parameters.get("balance", {})
+        if not isinstance(balance, dict) or balance.get("currency") != order.currency:
+            continue
+        if "old_current_balance" not in balance or "current_balance" not in balance:
+            # No reliable historical evidence: do not infer from the current card.
+            continue
+        try:
+            contribution = Decimal(str(balance["old_current_balance"])) - Decimal(
+                str(balance["current_balance"])
+            )
+        except (InvalidOperation, ValueError, TypeError):
+            continue
+        if contribution.is_finite():
+            amount += max(contribution, Decimal(0))
+    return amount
+
+
+def _summary(source, *, checkout):
+    currency = source.currency
+
+    def money(value):
+        return Money(value, currency)
+
+    transactions = list(source.payment_transactions.all())
+    payments = list(source.payments.all())
+    ordinary = [item for item in transactions if not item.is_legacy_gift_card]
+    # A real active legacy Payment wins, matching Core's compatibility branch.
+    # Synthetic historical gift-card transactions never select a different flow.
+    flow = (
+        PaymentAggregationFlow.PAYMENT
+        if any(p.is_active for p in payments)
+        else PaymentAggregationFlow.TRANSACTION
+        if ordinary
+        else getattr(source, "payment_flow", PaymentAggregationFlow.PAYMENT)
+    )
+    basis = getattr(
+        source, "gift_card_amount_basis", GiftCardAmountBasis.LEGACY_TOTAL_DEDUCTION
+    )
+    if flow == PaymentAggregationFlow.TRANSACTION:
+        authorized = sum((item.authorized_value for item in ordinary), Decimal(0))
+        charged = sum((item.charged_value for item in ordinary), Decimal(0))
+        refunded = sum((item.refunded_value for item in ordinary), Decimal(0))
+        pending = sum((item.charge_pending_value for item in ordinary), Decimal(0))
+        refund_pending = sum(
+            (item.refund_pending_value for item in ordinary), Decimal(0)
+        )
+    else:
+        authorized = sum(
+            (p.get_authorized_amount().amount for p in payments if p.is_active),
+            Decimal(0),
+        )
+        charged = sum((p.captured_amount for p in payments), Decimal(0))
+        refunded = sum(
+            (
+                t.amount
+                for p in payments
+                for t in p.transactions.all()
+                if t.is_success
+                and not t.action_required
+                and t.kind == TransactionKind.REFUND
+            ),
+            Decimal(0),
+        )
+        from .order_actions import pending_payment_transactions
+
+        pending = sum(
+            (
+                t.amount
+                for p in payments
+                for t in pending_payment_transactions(p, "capture")
+            ),
+            Decimal(0),
+        )
+        refund_pending = sum(
+            (
+                t.amount
+                for p in payments
+                for t in pending_payment_transactions(p, "refund")
+            ),
+            Decimal(0),
+        )
+    gift_charged = sum(
+        (
+            item.charged_value
+            for item in transactions
+            if item.payment_method_type == PaymentMethodType.GIFT_CARD
+        ),
+        Decimal(0),
+    )
+    total = source.total.gross
+    payable = total
+    if basis == GiftCardAmountBasis.LEGACY_TOTAL_DEDUCTION:
+        if checkout:
+            # Checkout.total is the persisted pre-card pricing cache; its public
+            # payable total applies the existing legacy deduction at resolution.
+            # Reuse that bounded current fact without recalculating tax/discounts.
+            gift_charged = min(
+                source.get_total_gift_cards_balance(source._state.db).amount,
+                total.amount,
+            )
+            total -= money(gift_charged)
+        else:
+            gift_charged = _legacy_gift_card_amount(source)
+            payable = total + money(gift_charged)
+    grants = (
+        Decimal(0)
+        if checkout or flow == PaymentAggregationFlow.PAYMENT
+        else sum((g.amount_value for g in source.granted_refunds.all()), Decimal(0))
+    )
+    balance = money(
+        charged
+        + (pending if flow == PaymentAggregationFlow.TRANSACTION else Decimal(0))
+        - total.amount
+        + grants
+    )
+    discount = (
+        money(source.discount_amount)
+        if checkout
+        else money(
+            max(source.undiscounted_total.gross.amount - payable.amount, Decimal(0))
+        )
+    )
+    merchandise = source.subtotal
+    shipping = source.shipping_price
+    return PaymentSummaryData(
+        merchandise_after_discounts=merchandise,
+        shipping_after_discounts=shipping,
+        discount=discount,
+        tax=merchandise.tax + shipping.tax,
+        total=total,
+        payable_before_gift_cards=payable,
+        gift_card_charged=money(gift_charged),
+        authorized=money(authorized),
+        charged=money(charged),
+        refunded=money(refunded),
+        charge_pending=money(pending),
+        refund_pending=money(refund_pending),
+        balance=balance,
+        outstanding=money(max(-balance.amount, Decimal(0))),
+        gift_card_amount_basis=basis,
+        payment_flow=flow,
+    )
+
+
+def get_order_payment_summary(order):
+    return _summary(order, checkout=False)
+
+
+def get_checkout_payment_summary(checkout):
+    return _summary(checkout, checkout=True)
