+import graphene
+
+from ..core.mutations import validation_error_to_error_type
+from ..core.types import CheckoutError
+from ..order.types import Order
+from .enums import CheckoutAutomaticCompletionStatusEnum
+from .utils import check_checkout_access
+
+
+class CheckoutAutomaticCompletion(graphene.ObjectType):
+    status = CheckoutAutomaticCompletionStatusEnum(required=True)
+    last_attempt_at = graphene.Field("saleor.graphql.core.scalars.DateTime")
+    next_attempt_at = graphene.Field("saleor.graphql.core.scalars.DateTime")
+    error = graphene.Field(CheckoutError)
+    order = graphene.Field(Order)
+
+
+def resolve_automatic_completion(checkout, info):
+    from django.core.exceptions import ValidationError
+
+    from ...checkout.models import CheckoutCompletionRecord
+
+    check_checkout_access(info, checkout, management=True)
+    record = (
+        CheckoutCompletionRecord.objects.filter(checkout_token=checkout.token)
+        .select_related("order")
+        .first()
+    )
+    if not record:
+        return None
+    error = None
+    if record.error_code:
+        error = validation_error_to_error_type(
+            ValidationError(
+                {
+                    record.error_field or "checkout": ValidationError(
+                        record.safe_message, code=record.error_code
+                    )
+                }
+            ),
+            CheckoutError,
+        )[0]
+    from ..core.context import SyncWebhookControlContext
+
+    return CheckoutAutomaticCompletion(
+        status=record.status.upper(),
+        last_attempt_at=record.last_attempt_at,
+        next_attempt_at=record.next_attempt_at,
+        error=error,
+        order=SyncWebhookControlContext(record.order) if record.order_id else None,
+    )
