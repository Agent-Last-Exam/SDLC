+from unittest.mock import patch
+from uuid import uuid4
+
+import graphene
+import pytest
+from django.core.cache import cache
+from django.test import override_settings
+
+from .....checkout import base_calculations
+from .....checkout.error_codes import CheckoutErrorCode
+from .....checkout.fetch import fetch_checkout_info, fetch_checkout_lines
+from .....checkout.utils import add_variant_to_checkout
+from .....plugins.manager import get_plugins_manager
+from .....shipping.interface import ShippingMethodData
+from .....webhook.transport.shipping_helpers import to_shipping_app_id
+from ....core.utils import to_global_id_or_none
+from ....tests.utils import get_graphql_content
+
+MUTATION_CHECKOUT_DELIVERY_OPTIONS_RECALCULATE = """
+    mutation checkoutDeliveryOptionsRecalculate($id: ID, $token: UUID) {
+      checkoutDeliveryOptionsRecalculate(id: $id, token: $token) {
+        checkout {
+          id
+          token
+        }
+        deliveryOptions {
+          availableDeliveryOptions {
+            id
+            name
+            price {
+              currency
+              amount
+            }
+            message
+            deliveryMethod {
+              __typename
+              ... on ShippingMethod {
+                id
+                name
+              }
+              ... on Warehouse {
+                id
+                name
+              }
+            }
+          }
+          selectedDeliveryOptionId
+          isSelectedDeliveryOptionAvailable
+        }
+        errors {
+          field
+          code
+          message
+        }
+      }
+    }
+"""
+
+
+def _get_recalculate_data(api_client, checkout, token=None):
+    variables = {"id": to_global_id_or_none(checkout)}
+    if token is not None:
+        variables["token"] = token
+        variables["id"] = None
+    response = api_client.post_graphql(
+        MUTATION_CHECKOUT_DELIVERY_OPTIONS_RECALCULATE, variables
+    )
+    content = get_graphql_content(response)
+    return content["data"]["checkoutDeliveryOptionsRecalculate"]
+
+
+def test_checkout_delivery_options_recalculate_uses_current_address(
+    staff_api_client,
+    checkout_with_shipping_method,
+    shipping_method,
+):
+    # given
+    checkout = checkout_with_shipping_method
+    checkout.shipping_address.country = "DE"
+    checkout.shipping_address.city = "Berlin"
+    checkout.shipping_address.save(update_fields=["country", "city"])
+
+    method_id = graphene.Node.to_global_id("ShippingMethod", shipping_method.id)
+
+    # when
+    data = _get_recalculate_data(staff_api_client, checkout)
+
+    # then
+    assert not data["errors"]
+    delivery_options = data["deliveryOptions"]
+    assert delivery_options is not None
+
+    options = delivery_options["availableDeliveryOptions"]
+    ids = [option["id"] for option in options]
+    assert method_id in ids
+
+    option = next(option for option in options if option["id"] == method_id)
+    assert option["name"] == shipping_method.name
+    assert option["price"]["currency"] == "USD"
+    assert option["price"]["amount"] == 10.0
+    assert option["deliveryMethod"]["__typename"] == "ShippingMethod"
+    assert option["deliveryMethod"]["id"] == method_id
+
+    # The returned options match the server side computation for the new address.
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    expected_ids = {
+        method.graphql_id
+        for method in checkout_info.valid_delivery_methods
+        if isinstance(method, ShippingMethodData)
+    }
+    assert set(ids) == expected_ids
+
+    assert delivery_options["selectedDeliveryOptionId"] == method_id
+    assert delivery_options["isSelectedDeliveryOptionAvailable"] is True
+
+
+def test_checkout_delivery_options_recalculate_when_lines_change(
+    staff_api_client,
+    checkout_with_shipping_address,
+    shipping_method,
+    product,
+    channel_USD,
+):
+    # given
+    checkout = checkout_with_shipping_address
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    subtotal = base_calculations.base_checkout_subtotal(
+        lines, channel_USD, checkout.currency
+    )
+
+    # Make the shipping method available only up to the current subtotal.
+    listing = shipping_method.channel_listings.get(channel=channel_USD)
+    listing.maximum_order_price = listing.price.__class__(
+        subtotal.amount, checkout.currency
+    )
+    listing.save(update_fields=["maximum_order_price_amount"])
+
+    method_id = graphene.Node.to_global_id("ShippingMethod", shipping_method.id)
+
+    # when
+    data = _get_recalculate_data(staff_api_client, checkout)
+
+    # then
+    assert not data["errors"]
+    ids = [o["id"] for o in data["deliveryOptions"]["availableDeliveryOptions"]]
+    assert method_id in ids
+
+    # when the line items change (subtotal grows above the maximum order price)
+    add_variant_to_checkout(checkout_info, product.variants.first(), 1)
+    data = _get_recalculate_data(staff_api_client, checkout)
+
+    # then the no longer applicable option disappears from the available options
+    assert not data["errors"]
+    ids = [o["id"] for o in data["deliveryOptions"]["availableDeliveryOptions"]]
+    assert method_id not in ids
+
+
+@override_settings(PLUGINS=["saleor.plugins.webhook.plugin.WebhookPlugin"])
+@patch("saleor.webhook.transport.synchronous.transport.send_webhook_request_sync")
+def test_checkout_delivery_options_recalculate_external_service_result_change(
+    mock_send_request,
+    staff_api_client,
+    checkout_with_shipping_address,
+    shipping_app,
+):
+    # given
+    checkout = checkout_with_shipping_address
+
+    def _webhook_response(method_id):
+        return [
+            {
+                "id": method_id,
+                "name": f"Provider - {method_id}",
+                "amount": "10",
+                "currency": "USD",
+                "maximum_delivery_days": "7",
+            }
+        ]
+
+    method_a = to_shipping_app_id(shipping_app, "A")
+    method_b = to_shipping_app_id(shipping_app, "B")
+
+    # when the synchronous service only returns method A
+    mock_send_request.return_value = _webhook_response("A")
+    data = _get_recalculate_data(staff_api_client, checkout)
+
+    # then only A is available
+    assert not data["errors"]
+    ids = [o["id"] for o in data["deliveryOptions"]["availableDeliveryOptions"]]
+    assert method_a in ids
+    assert method_b not in ids
+
+    # when the synchronous service now only returns method B
+    cache.clear()
+    mock_send_request.return_value = _webhook_response("B")
+    data = _get_recalculate_data(staff_api_client, checkout)
+
+    # then only B is available and the previous result is not mixed in
+    assert not data["errors"]
+    ids = [o["id"] for o in data["deliveryOptions"]["availableDeliveryOptions"]]
+    assert method_b in ids
+    assert method_a not in ids
+
