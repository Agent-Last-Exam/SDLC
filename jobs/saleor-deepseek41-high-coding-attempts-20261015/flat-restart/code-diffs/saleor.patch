+from .....payment import TransactionEventType
+from .....payment.gift_card_payments import create_gift_card_transaction
+from .....payment.models import TransactionItem
+from ....tests.utils import get_graphql_content
+from ...enums import TransactionActionEnum
+
+MUTATION_TRANSACTION_REQUEST_ACTION = """
+mutation TransactionRequestAction(
+    $id: ID
+    $action_type: TransactionActionEnum!
+    $amount: PositiveDecimal
+    ){
+    transactionRequestAction(
+            id: $id,
+            actionType: $action_type,
+            amount: $amount,
+        ){
+        transaction{
+                id
+                authorizedAmount{ amount currency }
+                chargedAmount{ amount currency }
+                refundedAmount{ amount currency }
+        }
+        errors{ field message code }
+    }
+}
+"""
+
+
+def _gift_card(code="gc-card", amount="100"):
+    return GiftCard.objects.create(
+        code=code,
+        initial_balance=Money(Decimal(amount), "USD"),
+        current_balance=Money(Decimal(amount), "USD"),
+    )
+
+
+def _authorize_on_order(order, gift_card, amount, app, key):
+    return create_gift_card_transaction(
+        source_object=order,
+        gift_card=gift_card,
+        amount=Decimal(amount),
+        user=None,
+        app=app,
+        idempotency_key=key,
+    )
+
+
+def test_transaction_request_action_gift_card_charge(
+    app_api_client, order_with_lines, permission_manage_payments, app
+):
+    # given
+    order = order_with_lines
+    gift_card = _gift_card(code="charge-card")
+    transaction = _authorize_on_order(order, gift_card, "10", app, "gc-charge")
+    variables = {
+        "id": graphene.Node.to_global_id("TransactionItem", transaction.token),
+        "action_type": TransactionActionEnum.CHARGE.name,
+        "amount": Decimal("5"),
+    }
+
+    # when
+    response = app_api_client.post_graphql(
+        MUTATION_TRANSACTION_REQUEST_ACTION,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["transactionRequestAction"]
+    assert not data["errors"]
+    assert data["transaction"]["chargedAmount"]["amount"] == Decimal("5")
+
+    gift_card.refresh_from_db()
+    assert gift_card.current_balance_amount == Decimal("95")
+    assert gift_card.reserved_balance_amount == Decimal("5")
+
+    transaction.refresh_from_db()
+    assert TransactionEventType.CHARGE_SUCCESS in list(
+        transaction.events.values_list("type", flat=True)
+    )
+
+
+def test_transaction_request_action_gift_card_charge_caps_at_authorized(
+    app_api_client, order_with_lines, permission_manage_payments, app
+):
+    # given
+    order = order_with_lines
+    gift_card = _gift_card(code="cap-card")
+    transaction = _authorize_on_order(order, gift_card, "10", app, "gc-cap")
+    variables = {
+        "id": graphene.Node.to_global_id("TransactionItem", transaction.token),
+        "action_type": TransactionActionEnum.CHARGE.name,
+        "amount": Decimal("100"),
+    }
+
+    # when
+    response = app_api_client.post_graphql(
+        MUTATION_TRANSACTION_REQUEST_ACTION,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+
+    # then - charged amount is capped to the authorized value
+    content = get_graphql_content(response)
+    data = content["data"]["transactionRequestAction"]
+    assert not data["errors"]
+    assert data["transaction"]["chargedAmount"]["amount"] == Decimal("10")
+
+    gift_card.refresh_from_db()
+    assert gift_card.current_balance_amount == Decimal("90")
+    assert gift_card.reserved_balance_amount == Decimal("0")
+
+
+def test_transaction_request_action_gift_card_refund(
+    app_api_client, order_with_lines, permission_manage_payments, app
+):
+    # given
+    order = order_with_lines
+    gift_card = _gift_card(code="refund-card")
+    transaction = _authorize_on_order(order, gift_card, "10", app, "gc-refund")
+
+    charge_variables = {
+        "id": graphene.Node.to_global_id("TransactionItem", transaction.token),
+        "action_type": TransactionActionEnum.CHARGE.name,
+        "amount": Decimal("10"),
+    }
+    app_api_client.post_graphql(
+        MUTATION_TRANSACTION_REQUEST_ACTION,
+        charge_variables,
+        permissions=[permission_manage_payments],
+    )
+    gift_card.refresh_from_db()
+    assert gift_card.current_balance_amount == Decimal("90")
+
+    variables = {
+        "id": graphene.Node.to_global_id("TransactionItem", transaction.token),
+        "action_type": TransactionActionEnum.REFUND.name,
+        "amount": Decimal("4"),
+    }
+
+    # when
+    response = app_api_client.post_graphql(
+        MUTATION_TRANSACTION_REQUEST_ACTION,
+        variables,
+        permissions=[permission_manage_payments],
+        check_no_permissions=False,
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["transactionRequestAction"]
+    assert not data["errors"]
+    assert data["transaction"]["chargedAmount"]["amount"] == Decimal("10")
+    assert data["transaction"]["refundedAmount"]["amount"] == Decimal("4")
+
+    gift_card.refresh_from_db()
+    assert gift_card.current_balance_amount == Decimal("94")
+    assert gift_card.events.filter(type=GiftCardEvents.REFUNDED).exists()
+
+
+def test_transaction_request_action_gift_card_cancel_releases_balance(
+    app_api_client, order_with_lines, permission_manage_payments, app
+):
