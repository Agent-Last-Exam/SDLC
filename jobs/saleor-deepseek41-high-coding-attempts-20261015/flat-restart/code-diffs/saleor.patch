+from decimal import Decimal
+
+from .....checkout import CheckoutAuthorizeStatus
+from .....giftcard import GiftCardEvents
+from .....giftcard.models import GiftCard
+from .....payment.error_codes import PaymentErrorCode
+from .....payment.models import TransactionItem
+from ....core.utils import to_global_id_or_none
+from ....tests.utils import get_graphql_content
+
+CHECKOUT_GIFT_CARD_PAYMENT_CREATE_MUTATION = """
+mutation CheckoutGiftCardPaymentCreate(
+    $id: ID!,
+    $input: CheckoutGiftCardPaymentCreateInput!
+    ){
+    checkoutGiftCardPaymentCreate(id: $id, input: $input){
+        transaction { id authorizedAmount { amount currency } }
+        errors { field code message }
+    }
+}
+"""
+
+CHECKOUT_GIFT_CARD_PAYMENT_CANCEL_MUTATION = """
+mutation CheckoutGiftCardPaymentCancel($id: ID!, $transactionId: ID!){
+    checkoutGiftCardPaymentCancel(id: $id, transactionId: $transactionId){
+        checkout { id authorizeStatus }
+        transaction {
+            id
+            authorizedAmount { amount currency }
+            events { type }
+        }
+        errors { field code message }
+    }
+}
+"""
+
+
+def _create_gift_card(code="cancel-card", amount="1000"):
+    from .....core.prices import Money
+
+    return GiftCard.objects.create(
+        code=code,
+        initial_balance=Money(Decimal(amount), "USD"),
+        current_balance=Money(Decimal(amount), "USD"),
+    )
+
+
+def _authorize(staff_api_client, checkout, gift_card, permission_manage_payments):
+    variables = {
+        "id": to_global_id_or_none(checkout),
+        "input": {"giftCardCode": gift_card.code},
+    }
+    response = staff_api_client.post_graphql(
+        CHECKOUT_GIFT_CARD_PAYMENT_CREATE_MUTATION,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+    content = get_graphql_content(response)
+    data = content["data"]["checkoutGiftCardPaymentCreate"]
+    assert not data["errors"]
+    return data["transaction"]["id"]
+
+
+def test_checkout_gift_card_payment_cancel(
+    staff_api_client, checkout_with_item, permission_manage_payments
+):
+    # given
+    checkout = checkout_with_item
+    gift_card = _create_gift_card()
+    transaction_id = _authorize(
+        staff_api_client, checkout, gift_card, permission_manage_payments
+    )
+    gift_card.refresh_from_db()
+    reserved_after_authorize = gift_card.reserved_balance_amount
+    assert reserved_after_authorize > Decimal("0")
+
+    variables = {
+        "id": to_global_id_or_none(checkout),
+        "transactionId": transaction_id,
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CHECKOUT_GIFT_CARD_PAYMENT_CANCEL_MUTATION,
+        variables,
+        permissions=[permission_manage_payments],
+        check_no_permissions=False,
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["checkoutGiftCardPaymentCancel"]
+    assert not data["errors"]
+    assert data["transaction"]["id"] == transaction_id
+
+    gift_card.refresh_from_db()
+    assert gift_card.reserved_balance_amount == Decimal("0")
+    assert gift_card.available_balance.amount == gift_card.current_balance_amount
+    assert gift_card.events.filter(
+        type=GiftCardEvents.AUTHORIZATION_RELEASED
+    ).exists()
+
+    checkout.refresh_from_db()
+    assert checkout.authorize_status == CheckoutAuthorizeStatus.NONE
+
+
+def test_checkout_gift_card_payment_cancel_invalid_transaction(
+    staff_api_client, checkout_with_item, permission_manage_payments
+):
+    # given
+    import graphene
+
+    variables = {
+        "id": to_global_id_or_none(checkout_with_item),
+        "transactionId": graphene.Node.to_global_id("TransactionItem", 999999),
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CHECKOUT_GIFT_CARD_PAYMENT_CANCEL_MUTATION,
+        variables,
+        permissions=[permission_manage_payments],
+        check_no_permissions=False,
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["checkoutGiftCardPaymentCancel"]
+    assert data["transaction"] is None
+    assert data["errors"][0]["code"] == PaymentErrorCode.NOT_FOUND.name
+    assert not TransactionItem.objects.exists()
