+import graphene
+from django.core.exceptions import ValidationError
+
+from .....checkout.calculations import calculate_checkout_total_with_gift_cards
+from .....checkout.fetch import fetch_checkout_info, fetch_checkout_lines
+from ....checkout.mutations.utils import get_checkout
+from .....checkout.payment_utils import update_checkout_payment_statuses
+from .....payment.error_codes import PaymentErrorCode
+from .....payment.gift_card_payments import (
+    GiftCardPaymentError,
+    release_gift_card_authorization,
+)
+from .....payment.models import TransactionItem
+from .....permission.enums import PaymentPermissions
+from .....permission.utils import message_one_of_permissions_required
+from ....app.dataloaders import get_app_promise
+from ....checkout.types import Checkout
+from ....core import ResolveInfo
+from ....core.descriptions import ADDED_IN_323
+from ....core.context import SyncWebhookControlContext
+from ....core.doc_category import DOC_CATEGORY_PAYMENTS
+from ....core.mutations import BaseMutation
+from ....core.types import common as common_types
+from ....core.utils import from_global_id_or_error
+from ....plugins.dataloaders import get_plugin_manager_promise
+from ...types import TransactionItem as TransactionItemType
+
+
+class CheckoutGiftCardPaymentCancel(BaseMutation):
+    checkout = graphene.Field(
+        Checkout, description="The checkout the authorization was cancelled for."
+    )
+    transaction = graphene.Field(
+        TransactionItemType, description="The cancelled transaction."
+    )
+
+    class Arguments:
+        id = graphene.ID(
+            description="The ID of the checkout.",
+            required=True,
+        )
+        transaction_id = graphene.ID(
+            description="The ID of the gift card transaction to cancel.",
+            required=True,
+        )
+
+    class Meta:
+        description = (
+            "Cancels a gift card authorization made for a checkout and releases "
+            "the held balance."
+            + message_one_of_permissions_required(
+                [PaymentPermissions.HANDLE_PAYMENTS]
+            )
+            + ADDED_IN_323
+        )
+        doc_category = DOC_CATEGORY_PAYMENTS
+        error_type_class = common_types.PaymentError
+        permissions = (PaymentPermissions.HANDLE_PAYMENTS,)
+        auto_permission_message = False
+
+    @classmethod
+    def get_transaction_or_error(
+        cls, checkout, transaction_id: str
+    ) -> TransactionItem:
+        _, pk = from_global_id_or_error(
+            transaction_id, only_type="TransactionItem", raise_error=True
+        )
+        if str(pk).isdigit():
+            transaction = TransactionItem.objects.filter(pk=pk).first()
+        else:
+            transaction = TransactionItem.objects.filter(token=pk).first()
+        if transaction is None or transaction.checkout_id != checkout.pk:
+            raise ValidationError(
+                {
+                    "transactionId": ValidationError(
+                        "Couldn't resolve to a gift card transaction of this checkout.",
+                        code=PaymentErrorCode.NOT_FOUND.value,
+                    )
+                }
+            )
+        if transaction.gift_card_id is None:
+            raise ValidationError(
+                {
+                    "transactionId": ValidationError(
+                        "The transaction is not a gift card payment.",
+                        code=PaymentErrorCode.GIFT_CARD_NOT_APPLICABLE.value,
+                    )
+                }
+            )
+        return transaction
+
+    @classmethod
+    def perform_mutation(  # type: ignore[override]
+        cls,
+        _root,
+        info: ResolveInfo,
+        /,
+        *,
+        id: str,
+        transaction_id: str,
+    ):
+        checkout = get_checkout(cls, info, id=id)
+
+        transaction = cls.get_transaction_or_error(checkout, transaction_id)
+
+        app = get_app_promise(info.context).get()
+        user = info.context.user
+
+        try:
+            release_gift_card_authorization(transaction, user=user, app=app)
+        except GiftCardPaymentError as e:
+            raise ValidationError(
+                {"transactionId": ValidationError(e.message, code=e.code)}
+            ) from e
+
+        manager = get_plugin_manager_promise(info.context).get()
