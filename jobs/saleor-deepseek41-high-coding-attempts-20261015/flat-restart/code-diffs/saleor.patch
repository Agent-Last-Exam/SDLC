+    mutation checkoutShippingMethodUpdate($id: ID, $shippingMethodId: ID) {
+      checkoutShippingMethodUpdate(id: $id, shippingMethodId: $shippingMethodId) {
+        checkout {
+          shippingMethod {
+            id
+            name
+          }
+        }
+        errors {
+          field
+          code
+          message
+        }
+      }
+    }
+"""
+
+MUTATION_CHECKOUT_COMPLETE = """
+    mutation checkoutComplete($id: ID, $redirectUrl: String) {
+      checkoutComplete(id: $id, redirectUrl: $redirectUrl) {
+        order {
+          id
+        }
+        errors {
+          field
+          code
+          message
+        }
+      }
+    }
+"""
+
+MUTATION_CHECKOUT_DELIVERY_OPTIONS_RECALCULATE = """
+    mutation checkoutDeliveryOptionsRecalculate($id: ID) {
+      checkoutDeliveryOptionsRecalculate(id: $id) {
+        deliveryOptions {
+          availableDeliveryOptions {
+            id
+          }
+        }
+        errors {
+          field
+          code
+        }
+      }
+    }
+"""
+
+
+def test_checkout_delivery_method_update_revalidates_stale_method(
+    staff_api_client,
+    checkout_with_shipping_method,
+    shipping_method,
+    shipping_zone,
+):
+    # given
+    checkout = checkout_with_shipping_method
+    method_id = graphene.Node.to_global_id("ShippingMethod", shipping_method.id)
+
+    # The saved delivery method is no longer applicable to the current address.
+    shipping_zone.countries = ["US"]
+    shipping_zone.save(update_fields=["countries"])
+
+    # when
+    response = staff_api_client.post_graphql(
+        MUTATION_UPDATE_DELIVERY_METHOD,
+        {"id": to_global_id_or_none(checkout), "deliveryMethodId": method_id},
+    )
+    data = get_graphql_content(response)["data"]["checkoutDeliveryMethodUpdate"]
+
+    # then
+    assert len(data["errors"]) == 1
+    assert data["errors"][0]["code"] == CheckoutErrorCode.DELIVERY_METHOD_NOT_APPLICABLE.name
+
+    # no new delivery selection is saved
+    checkout.refresh_from_db()
+    assert checkout.shipping_method_id == shipping_method.id
+
+
+def test_checkout_delivery_method_update_rejects_foreign_method(
+    staff_api_client,
+    checkout_with_shipping_method,
+    channel_USD,
+    default_tax_class,
+):
+    # given
+    checkout = checkout_with_shipping_method
+    original_method_id = checkout.shipping_method_id
+
+    # A shipping method that has no channel listing for the checkout's channel is
+    # not applicable to the checkout.
+    zone = ShippingZone.objects.create(name="No listing zone", countries=["PL"])
+    zone.channels.add(channel_USD)
+    foreign_method = zone.shipping_methods.create(
+        name="Ghost",
+        type=ShippingMethodType.PRICE_BASED,
+        shipping_zone=zone,
+        tax_class=default_tax_class,
+    )
+    foreign_method_id = graphene.Node.to_global_id("ShippingMethod", foreign_method.id)
+
+    # when
+    response = staff_api_client.post_graphql(
+        MUTATION_UPDATE_DELIVERY_METHOD,
+        {"id": to_global_id_or_none(checkout), "deliveryMethodId": foreign_method_id},
+    )
+    data = get_graphql_content(response)["data"]["checkoutDeliveryMethodUpdate"]
+
+    # then
+    assert len(data["errors"]) == 1
+    assert data["errors"][0]["code"] == CheckoutErrorCode.DELIVERY_METHOD_NOT_FOUND.name
+
+    # the original selection is untouched
+    checkout.refresh_from_db()
+    assert checkout.shipping_method_id == original_method_id
+
+
+def test_checkout_shipping_method_update_legacy_parity(
+    staff_api_client,
+    checkout_with_shipping_address,
+    shipping_method,
+):
+    # given
+    checkout = checkout_with_shipping_address
+    method_id = graphene.Node.to_global_id("ShippingMethod", shipping_method.id)
+
+    # when
+    response = staff_api_client.post_graphql(
+        MUTATION_UPDATE_SHIPPING_METHOD,
+        {"id": to_global_id_or_none(checkout), "shippingMethodId": method_id},
+    )
+    data = get_graphql_content(response)["data"]["checkoutShippingMethodUpdate"]
+
+    # then
+    assert not data["errors"]
+    checkout.refresh_from_db()
+    assert checkout.shipping_method_id == shipping_method.id
+    assert checkout.shipping_method_name == shipping_method.name
+    # the deprecated read still works
+    assert data["checkout"]["shippingMethod"]["id"] == method_id
+
+
+def test_checkout_delivery_options_recalculate_requires_permission(
+    api_client,
+    checkout_with_shipping_method,
+):
+    # given
+    checkout = checkout_with_shipping_method
+
+    # when
+    response = api_client.post_graphql(
+        MUTATION_CHECKOUT_DELIVERY_OPTIONS_RECALCULATE,
+        {"id": to_global_id_or_none(checkout)},
+    )
+
+    # then
+    assert_no_permission(response)
+
+
+def test_checkout_complete_blocks_on_stale_delivery_method_and_can_retry(
+    api_client,
+    checkout_with_shipping_method,
+    shipping_method,
+    shipping_zone,
+    payment_dummy,
+    address,
+):
+    # given
+    checkout = checkout_with_shipping_method
+    checkout.email = "test@example.com"
+    checkout.billing_address = address
+    checkout.save(update_fields=["email", "billing_address"])
+
+    # make the saved delivery method stale (address outside the shipping zone)
+    shipping_zone.countries = ["US"]
+    shipping_zone.save(update_fields=["countries"])
+
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    total = calculations.calculate_checkout_total(
+        manager=manager, checkout_info=checkout_info, lines=lines, address=address
+    )
+
+    payment = payment_dummy
+    payment.is_active = True
+    payment.order = None
+    payment.total = total.gross.amount
+    payment.currency = total.gross.currency
+    payment.checkout = checkout
+    payment.save()
+
+    initial_order_count = Order.objects.count()
+    variables = {
+        "id": to_global_id_or_none(checkout),
+        "redirectUrl": "https://www.example.com",
+    }
+
+    # when
+    response = api_client.post_graphql(MUTATION_CHECKOUT_COMPLETE, variables)
+    data = get_graphql_content(response)["data"]["checkoutComplete"]
+
+    # then
+    assert len(data["errors"]) == 1
+    assert data["errors"][0]["code"] in [
+        CheckoutErrorCode.DELIVERY_METHOD_NOT_APPLICABLE.name,
+        CheckoutErrorCode.SHIPPING_METHOD_NOT_SET.name,
+        CheckoutErrorCode.SHIPPING_ADDRESS_NOT_SET.name,
+    ]
+    assert Order.objects.count() == initial_order_count
+    assert not Reservation.objects.filter(checkout_line__checkout=checkout).exists()
+    assert payment.transactions.count() == 0
+
+    checkout.refresh_from_db()
+    assert not checkout.completing_started_at
+
+    # when the delivery selection is fixed, the checkout can be completed
+    shipping_zone.countries = ["PL"]
+    shipping_zone.save(update_fields=["countries"])
+    checkout.shipping_method = shipping_method
+    checkout.shipping_method_name = shipping_method.name
+    checkout.save(update_fields=["shipping_method", "shipping_method_name"])
+
+    response = api_client.post_graphql(MUTATION_CHECKOUT_COMPLETE, variables)
+    data = get_graphql_content(response)["data"]["checkoutComplete"]
+
+    # then
+    assert not data["errors"]
+    assert Order.objects.count() == initial_order_count + 1
