+    checkout.billing_address = None
+    checkout.save(update_fields=["billing_address"])
+    charged_before = transaction.charged_value
+
+    # the first attempt fails and leaves a diagnostic
+    run_task(checkout_pk, app)
+    assert get_diagnostic(checkout)["code"] == AutomaticCompletionReason.MISSING_BILLING_ADDRESS
+
+    # when the condition is fixed and the checkout is processed again
+    checkout.billing_address = billing_address
+    checkout.save(update_fields=["billing_address"])
+    with django_capture_on_commit_callbacks(execute=True):
+        run_task(checkout_pk, app)
