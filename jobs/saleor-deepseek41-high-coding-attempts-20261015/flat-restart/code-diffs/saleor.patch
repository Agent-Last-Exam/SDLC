+def revalidate_delivery_method(
+    checkout_info: "CheckoutInfo",
+    lines: list["CheckoutLineInfo"],
+    error_code: type[CheckoutErrorCode] = CheckoutErrorCode,
+):
+    """Revalidate the currently selected delivery method of the checkout.
+
+    The validation is performed against the current checkout facts: the address,
+    line items, channel, stock and the results of the synchronous shipping
+    webhooks (reused through ``CheckoutInfo.valid_delivery_methods`` and
+    ``CheckoutInfo.get_delivery_method_info``).
+
+    Unlike ``clean_checkout_shipping`` the raised error is distinguishable so a
+    caller can branch on the exact failure reason:
+
+    * ``SHIPPING_METHOD_NOT_SET`` (field ``shipping_method``) - shipping is
+      required but no delivery method is set,
+    * ``SHIPPING_ADDRESS_NOT_SET`` (field ``shipping_address``) - a delivery
+      method is set but the shipping address is missing or invalid,
+    * ``DELIVERY_METHOD_NOT_APPLICABLE`` (field ``shipping_method``) - the set
+      delivery method is no longer applicable to the checkout; the stale
+      selection is cleared before raising.
+
+    When the selection is still valid, nothing is written.
+    """
+    if not is_shipping_required(lines):
+        return
+
+    delivery_method_info = checkout_info.get_delivery_method_info()
+
+    if not delivery_method_info.delivery_method:
