+def get_password_login_mode(info) -> str:
+    """Return the currently effective password login mode.
+
+    The mode is read from ``SiteSettings`` on every request, so a value saved by
+    ``shopSettingsUpdate`` takes effect immediately without any caching.
+    """
+    return get_site_promise(info.context).get().settings.password_login_mode
+
+
+def validate_password_login_allowed(info, user=None, field: str = "email") -> None:
+    """Enforce the shop-wide password login policy.
+
+    Raises a ``ValidationError`` carrying ``PASSWORD_LOGIN_DISABLED`` when password
+    authentication is turned off, or ``PASSWORD_LOGIN_CUSTOMERS_ONLY`` when it is
+    limited to customers and ``user`` is a staff account. When ``user`` is ``None``
+    only the ``DISABLED`` mode can be detected.
+    """
+    mode = get_password_login_mode(info)
+    if mode == PasswordLoginMode.DISABLED:
+        raise ValidationError(
+            {
+                field: ValidationError(
+                    "Password authentication is disabled.",
+                    code=AccountErrorCode.PASSWORD_LOGIN_DISABLED.value,
+                )
+            }
+        )
+    if (
+        mode == PasswordLoginMode.CUSTOMERS_ONLY
+        and user is not None
+        and user.is_staff
+    ):
+        raise ValidationError(
+            {
+                field: ValidationError(
+                    "Password authentication is restricted to customers.",
+                    code=AccountErrorCode.PASSWORD_LOGIN_CUSTOMERS_ONLY.value,
+                )
+            }
+        )
+
+
+def is_password_owner_token(payload) -> bool:
+    """Return ``True`` if the token was issued by Saleor's native (password) flow."""
+    return payload.get(JWT_OWNER_FIELD) == JWT_SALEOR_OWNER_NAME
+
+
+def validate_password_token_allowed(info, payload, field: str = "token") -> None:
+    """Reject native (password) tokens when password authentication is disabled.
+
+    Tokens issued by external authentication plugins carry a different owner and
+    are therefore not affected by the password login policy.
+    """
+    if not is_password_owner_token(payload):
+        return
+    if get_password_login_mode(info) == PasswordLoginMode.DISABLED:
+        raise ValidationError(
+            {
+                field: ValidationError(
+                    "Password authentication is disabled.",
+                    code=AccountErrorCode.PASSWORD_LOGIN_DISABLED.value,
+                )
+            }
+        )
 
 
 def get_user(payload):
