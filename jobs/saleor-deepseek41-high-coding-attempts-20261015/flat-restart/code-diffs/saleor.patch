+import graphene
+import pytest
+
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+QUERY_ORDER_SHIPPING_METHOD_PUBLIC_METADATA = """
+    query OrderShippingMetadata($token: UUID!) {
+        orderByToken(token: $token) {
+            shippingMethodMetadata {
+                key
+                value
+            }
+            shippingMethodMetafield(key: "public_key")
+            shippingMethodMetafields(keys: ["public_key"])
+        }
+    }
+"""
+
+QUERY_ORDER_SHIPPING_METHOD_PRIVATE_METADATA = """
+    query OrderShippingMetadata($token: UUID!) {
+        orderByToken(token: $token) {
+            shippingMethodPrivateMetadata {
+                key
+                value
+            }
+            shippingMethodPrivateMetafield(key: "private_key")
+            shippingMethodPrivateMetafields(keys: ["private_key"])
+        }
+    }
+"""
+
+QUERY_ORDER_SHIPPING_METHOD_DELIVERY_METADATA = """
+    query OrderShippingMetadata($token: UUID!) {
+        orderByToken(token: $token) {
+            shippingMethod {
+                metadata {
+                    key
+                    value
+                }
+            }
+        }
+    }
+"""
+
+
+def test_order_shipping_method_public_metadata_snapshot_as_anonymous(
+    api_client, order, shipping_method
+):
+    # given
+    order.shipping_method = shipping_method
+    order.shipping_method_metadata = {"public_key": "public_value"}
+    order.shipping_method_private_metadata = {"private_key": "private_value"}
+    order.save()
+    variables = {"token": order.id}
+
+    # when
+    response = api_client.post_graphql(
+        QUERY_ORDER_SHIPPING_METHOD_PUBLIC_METADATA, variables
+    )
+    content = get_graphql_content(response)
+
+    # then
+    data = content["data"]["orderByToken"]
+    assert data["shippingMethodMetadata"] == [
+        {"key": "public_key", "value": "public_value"}
+    ]
+    assert data["shippingMethodMetafield"] == "public_value"
+    assert data["shippingMethodMetafields"] == {"public_key": "public_value"}
+
+
+def test_order_shipping_method_public_metadata_empty_snapshot(
+    api_client, order, shipping_method
+):
+    # given
+    order.shipping_method = shipping_method
+    order.shipping_method_metadata = {}
+    order.shipping_method_private_metadata = {}
+    order.save()
+    variables = {"token": order.id}
+
+    # when
+    response = api_client.post_graphql(
+        QUERY_ORDER_SHIPPING_METHOD_PUBLIC_METADATA, variables
+    )
+    content = get_graphql_content(response)
+
+    # then: stable empty value, never null
+    data = content["data"]["orderByToken"]
+    assert data["shippingMethodMetadata"] == []
+    assert data["shippingMethodMetafield"] is None
+    assert data["shippingMethodMetafields"] == {}
+
+
+def test_order_shipping_method_private_metadata_snapshot_requires_staff(
+    api_client, order, shipping_method
+):
+    # given
+    order.shipping_method = shipping_method
+    order.shipping_method_private_metadata = {"private_key": "private_value"}
+    order.save()
+    variables = {"token": order.id}
+
+    # when
+    response = api_client.post_graphql(
+        QUERY_ORDER_SHIPPING_METHOD_PRIVATE_METADATA, variables
+    )
+
+    # then
+    assert_no_permission(response)
+
