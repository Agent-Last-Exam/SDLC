+from decimal import Decimal
+
+import graphene
+import pytest
+
+from .....checkout import CheckoutAuthorizeStatus
+from .....checkout.calculations import calculate_checkout_total_with_gift_cards
+from .....checkout.fetch import fetch_checkout_info, fetch_checkout_lines
+from .....core.prices import Money
+from .....giftcard import GiftCardEvents
+from .....giftcard.models import GiftCard
+from .....payment.error_codes import PaymentErrorCode
+from .....payment.models import TransactionItem
+from .....plugins.manager import get_plugins_manager
+from ....core.utils import to_global_id_or_none
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+CHECKOUT_GIFT_CARD_PAYMENT_CREATE_MUTATION = """
+mutation CheckoutGiftCardPaymentCreate(
+    $id: ID!,
+    $input: CheckoutGiftCardPaymentCreateInput!,
+    $idempotencyKey: String
+    ){
+    checkoutGiftCardPaymentCreate(id: $id, input: $input, idempotencyKey: $idempotencyKey){
+        checkout {
+            id
+            totalPrice { gross { amount currency } }
+            authorizeStatus
+        }
+        transaction {
+            id
+            authorizedAmount { amount currency }
+            chargedAmount { amount currency }
+            paymentMethodDetails {
+                __typename
+                ... on GiftCardPaymentMethodDetails {
+                    name
+                    giftCard { id }
+                }
+            }
+        }
+        errors {
+            field
+            code
+            message
+        }
+    }
+}
+"""
+
+
+def _create_gift_card(amount="1000", currency="USD", **kwargs):
+    return GiftCard.objects.create(
+        code=kwargs.pop("code", "test-gift-code"),
+        initial_balance=Money(Decimal(amount), currency),
+        current_balance=Money(Decimal(amount), currency),
+        **kwargs,
+    )
+
+
+def _checkout_total(checkout):
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    total = calculate_checkout_total_with_gift_cards(
+        manager=manager,
+        checkout_info=checkout_info,
+        lines=lines,
+        address=checkout.shipping_address or checkout.billing_address,
+    )
+    return total.gross
+
+
+def test_checkout_gift_card_payment_create(
+    staff_api_client, checkout_with_item, permission_manage_payments
+):
+    # given
+    checkout = checkout_with_item
+    total = _checkout_total(checkout)
+    gift_card = _create_gift_card(amount=str(total.amount), currency=checkout.currency)
+    variables = {
+        "id": to_global_id_or_none(checkout),
+        "input": {"giftCardCode": gift_card.code},
+        "idempotencyKey": "key-1",
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CHECKOUT_GIFT_CARD_PAYMENT_CREATE_MUTATION,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["checkoutGiftCardPaymentCreate"]
+    assert not data["errors"]
+    transaction = data["transaction"]
+    assert transaction is not None
+    assert transaction["authorizedAmount"]["amount"] == total.amount
+    assert transaction["paymentMethodDetails"]["__typename"] == (
+        "GiftCardPaymentMethodDetails"
+    )
+    assert transaction["paymentMethodDetails"]["giftCard"]["id"] == (
+        to_global_id_or_none(gift_card)
+    )
+
+    gift_card.refresh_from_db()
+    assert gift_card.reserved_balance_amount == total.amount
+    assert gift_card.available_balance.amount == Decimal("0")
+    assert gift_card.current_balance_amount == total.amount
+
+    # AUTHORIZED event is written to the gift card history
+    assert gift_card.events.filter(type=GiftCardEvents.AUTHORIZED).exists()
+
+    checkout.refresh_from_db()
+    assert checkout.authorize_status == CheckoutAuthorizeStatus.FULL
+
+
+def test_checkout_gift_card_payment_create_gift_card_not_found(
+    staff_api_client, checkout_with_item, permission_manage_payments
+):
+    # given
+    variables = {
+        "id": to_global_id_or_none(checkout_with_item),
+        "input": {"giftCardCode": "does-not-exist"},
