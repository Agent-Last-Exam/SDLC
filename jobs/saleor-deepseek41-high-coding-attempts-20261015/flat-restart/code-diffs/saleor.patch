+def test_checkout_gift_card_payment_create_idempotent(
+    staff_api_client, checkout_with_item, permission_manage_payments
+):
+    # given
+    checkout = checkout_with_item
+    total = _checkout_total(checkout)
+    gift_card = _create_gift_card(amount=str(total.amount), code="idem-card")
+    variables = {
+        "id": to_global_id_or_none(checkout),
+        "input": {"giftCardCode": gift_card.code},
+        "idempotencyKey": "same-key",
+    }
+
+    # when
+    response_1 = staff_api_client.post_graphql(
+        CHECKOUT_GIFT_CARD_PAYMENT_CREATE_MUTATION,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+    response_2 = staff_api_client.post_graphql(
+        CHECKOUT_GIFT_CARD_PAYMENT_CREATE_MUTATION,
+        variables,
+        permissions=[permission_manage_payments],
+        check_no_permissions=False,
+    )
+
+    # then
+    content_1 = get_graphql_content(response_1)
+    content_2 = get_graphql_content(response_2)
+    data_1 = content_1["data"]["checkoutGiftCardPaymentCreate"]
+    data_2 = content_2["data"]["checkoutGiftCardPaymentCreate"]
+    assert not data_1["errors"]
+    assert not data_2["errors"]
+    assert data_1["transaction"]["id"] == data_2["transaction"]["id"]
+
+    assert TransactionItem.objects.filter(checkout=checkout).count() == 1
+    gift_card.refresh_from_db()
+    # only one balance change
+    assert gift_card.reserved_balance_amount == total.amount
+
+
+def test_checkout_gift_card_payment_create_idempotency_key_reused(
+    staff_api_client, checkout_with_item, permission_manage_payments
+):
+    # given
+    checkout = checkout_with_item
+    total = _checkout_total(checkout)
+    gift_card = _create_gift_card(amount=str(total.amount * 2), code="reuse-card")
+    variables = {
+        "id": to_global_id_or_none(checkout),
+        "input": {"giftCardCode": gift_card.code},
+        "idempotencyKey": "reused-key",
