+import datetime
+from unittest.mock import patch
+
+import pytest
+from celery import Task
+from celery.exceptions import Retry
+from celery.utils.threads import LocalStack
+
+from ...core import EventDeliveryStatus
+from ...core.models import EventDelivery, EventDeliveryAttempt
+from ..transport.utils import (
+    WebhookResponse,
+    handle_webhook_retry,
+    process_failed_deliveries,
+)
+
+
+class DummyTask(Task):
+    retry_backoff = 10
+    retry_kwargs = {"max_retries": 2}
+    request_stack = LocalStack()
+
+
+def _delivery_attempt(delivery):
+    return EventDeliveryAttempt(
+        id=1,
+        created_at=datetime.datetime.now(tz=datetime.UTC),
+        delivery=delivery,
+        request_headers="",
+        task_id="123",
+    )
+
+
+def test_process_failed_deliveries_marks_retrying_when_retries_left(
+    event_delivery, event_attempt
+):
+    # given
+    # attempt_count is below the retry limit, so another attempt will follow
+    # when
+    process_failed_deliveries([(event_delivery, event_attempt, 0)], 5)
+
+    # then
+    event_delivery.refresh_from_db()
+    assert event_delivery.status == EventDeliveryStatus.RETRYING
+
+
+def test_process_failed_deliveries_marks_failed_when_retries_exhausted(
+    event_delivery, event_attempt
+):
+    # given
+    # attempt_count reached the retry limit
+    # when
+    process_failed_deliveries([(event_delivery, event_attempt, 5)], 5)
+
+    # then
+    event_delivery.refresh_from_db()
+    assert event_delivery.status == EventDeliveryStatus.FAILED
+
+
+def test_handle_webhook_retry_persists_retrying_status(webhook, event_delivery):
+    # given
+    attempt = _delivery_attempt(event_delivery)
+    task = DummyTask()
+    task.push_request(retries=0)
+    response = WebhookResponse(
+        content="Error!",
+        response_status_code=500,
+        status=EventDeliveryStatus.FAILED,
+    )
+
+    # when
+    with pytest.raises(Retry):
+        handle_webhook_retry(task, webhook, response, event_delivery, attempt)
+
+    # then
+    # the delivery is marked as retrying so it is not reported as still pending
+    event_delivery.refresh_from_db()
+    assert event_delivery.status == EventDeliveryStatus.RETRYING
+
+
+def test_handle_webhook_retry_does_not_mark_retrying_for_4xx(webhook, event_delivery):
+    # given
+    attempt = _delivery_attempt(event_delivery)
+    task = DummyTask()
+    task.push_request(retries=0)
+    response = WebhookResponse(
+        content="Error!",
+        response_status_code=404,
+        status=EventDeliveryStatus.FAILED,
+    )
+
+    # when
+    retry = handle_webhook_retry(task, webhook, response, event_delivery, attempt)
+
+    # then
+    assert retry is False
+    event_delivery.refresh_from_db()
+    # no retry is scheduled, so the delivery is not moved to RETRYING
+    assert event_delivery.status == EventDeliveryStatus.PENDING
+
+
+@patch(
+    "saleor.webhook.transport.asynchronous.transport.send_webhook_using_scheme_method"
+)
+@patch(
+    "saleor.webhook.transport.asynchronous.transport.send_webhooks_async_for_app.apply_async"
+)
+def test_send_webhooks_async_for_app_isolates_failing_delivery(
+    mocked_apply_async,
+    mocked_send_webhook_using_scheme_method,
+    app,
+    event_deliveries,
+):
+    # given
+    from ..transport.asynchronous.transport import send_webhooks_async_for_app
+
+    deliveries = list(EventDelivery.objects.order_by("id"))
+    assert len(deliveries) == 3
+
+    # the first delivery always fails, the remaining ones succeed
+    mocked_send_webhook_using_scheme_method.side_effect = [
+        WebhookResponse(content="", status=EventDeliveryStatus.FAILED),
+        WebhookResponse(content="", status=EventDeliveryStatus.SUCCESS),
+        WebhookResponse(content="", status=EventDeliveryStatus.SUCCESS),
+    ]
+
+    # when
+    send_webhooks_async_for_app(app_id=app.id)
+
+    # then
+    # only the failing delivery remains and is scheduled for a retry
+    failing_delivery = EventDelivery.objects.get()
+    assert failing_delivery.pk == deliveries[0].pk
+    assert failing_delivery.status == EventDeliveryStatus.RETRYING
+    # the two successful deliveries were completed (cleared) and not redone
+    assert mocked_send_webhook_using_scheme_method.call_count == 3
