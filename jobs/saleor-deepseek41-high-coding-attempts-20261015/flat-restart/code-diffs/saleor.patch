+):
+    # given
+    channel_USD.automatically_complete_fully_paid_checkouts = True
+    cutoff = timezone.now() - datetime.timedelta(hours=1)
+    channel_USD.automatic_completion_cutoff_date = cutoff
+    channel_USD.save(
+        update_fields=[
+            "automatically_complete_fully_paid_checkouts",
+            "automatic_completion_cutoff_date",
+        ]
+    )
+
+    old_checkout = checkout_with_prices
+    old_checkout.channel = channel_USD
+    old_checkout.save(update_fields=["channel"])
+    Checkout.objects.filter(pk=old_checkout.pk).update(
+        created_at=cutoff - datetime.timedelta(minutes=1)
+    )
+
+    new_checkout = Checkout.objects.create(
+        currency=channel_USD.currency_code, channel=channel_USD, email="new@example.com"
+    )
+    Checkout.objects.filter(pk=new_checkout.pk).update(
