+    # when - reuse the key for a different gift card
+    other_gift_card = _create_gift_card(amount=str(total.amount * 2), code="other-card")
+    variables_3 = {
+        "id": to_global_id_or_none(checkout),
+        "input": {"giftCardCode": other_gift_card.code},
+        "idempotencyKey": "reused-key",
+    }
+    response = staff_api_client.post_graphql(
+        CHECKOUT_GIFT_CARD_PAYMENT_CREATE_MUTATION,
