diff --git a/saleor/checkout/automatic_completion.py b/saleor/checkout/automatic_completion.py
new file mode 100644
index 0000000000000000000000000000000000000000..a707055d5cd6162bdc4ae18cd6f494a89f6485b2
--- /dev/null
+++ b/saleor/checkout/automatic_completion.py
@@ -0,0 +1,330 @@
+"""Eligibility checks and candidate selection for the automatic completion of
+fully paid checkouts (R05).
+
+The automatic completion must not relax any of the conditions the manual flow
+requires. A checkout is only converted into an order when it is fully paid and
+when the customer, address, delivery, stock and amount conditions hold. When a
+checkout is not eligible the reason is persisted as a diagnostic so that a
+merchant can tell why nothing happened and retry after fixing the condition.
+"""
+
+from __future__ import annotations
+
+import datetime
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Optional
+
+from django.db.models import QuerySet
+from django.utils import timezone
+
+from ..core.taxes import zero_money, zero_taxed_money
+from . import CheckoutChargeStatus
+from .models import Checkout
+from .utils import is_fully_paid
+
+if TYPE_CHECKING:
+    from ..plugins.manager import PluginsManager
+    from .fetch import CheckoutInfo, CheckoutLineInfo
+
+
+# Key under which the last automatic completion failure is stored in the
+# checkout metadata. The value holds the reason code, a human readable message
+# and the moment the attempt was made.
+DIAGNOSTIC_METADATA_KEY = "automatic_completion.last_error"
+
+# Key under which the number of automatic completion attempts is stored. It is
+# used to keep the retry state observable without changing the checkout itself.
+ATTEMPTS_METADATA_KEY = "automatic_completion.attempts"
+
+
+class AutomaticCompletionReason:
+    """Reason codes explaining why a checkout was not automatically completed."""
+
+    NOT_FULLY_PAID = "not_fully_paid"
+    MISSING_CUSTOMER = "missing_customer"
+    MISSING_BILLING_ADDRESS = "missing_billing_address"
+    MISSING_SHIPPING_ADDRESS = "missing_shipping_address"
+    MISSING_DELIVERY_METHOD = "missing_delivery_method"
+    DELIVERY_METHOD_NOT_APPLICABLE = "delivery_method_not_applicable"
+    UNAVAILABLE_PRODUCTS = "unavailable_products"
+    ZERO_TOTAL = "zero_total"
+    ORDER_ALREADY_EXISTS = "order_already_exists"
+    DELAY_NOT_ELAPSED = "delay_not_elapsed"
+    CREATED_BEFORE_CUTOFF = "created_before_cutoff"
+
+
+@dataclass(frozen=True)
+class EligibilityResult:
+    """Outcome of the automatic completion eligibility check."""
+
+    eligible: bool
+    reason: Optional[str] = None
+    message: str = ""
+
+    @staticmethod
+    def success() -> "EligibilityResult":
+        return EligibilityResult(eligible=True)
+
+    @staticmethod
+    def failure(reason: str, message: str) -> "EligibilityResult":
+        return EligibilityResult(eligible=False, reason=reason, message=message)
+
+
+def _has_active_transaction_payment(checkout: Checkout) -> bool:
+    return checkout.charge_status in (
+        CheckoutChargeStatus.FULL,
+        CheckoutChargeStatus.OVERCHARGED,
+    )
+
+
+def get_checkout_transaction_amounts(checkout: Checkout) -> tuple:
+    """Return the ``(authorized, charged)`` amounts of the checkout's transactions.
+
+    The values are read from the transactions themselves instead of the
+    denormalized ``Checkout.authorize_status``/``charge_status`` columns, so that
+    the eligibility does not depend on when the statuses were last refreshed.
+    """
+    authorized = zero_money(checkout.currency)
+    charged = zero_money(checkout.currency)
+    for transaction in checkout.payment_transactions.all():
+        authorized += (
+            transaction.amount_authorized + transaction.amount_authorize_pending
+        )
+        charged += transaction.amount_charged + transaction.amount_charge_pending
+    return authorized, charged
+
+
+def _is_paid_by_transactions(checkout: Checkout, total_gross) -> bool:
+    """Whether the transactions cover the checkout total.
+
+    Both a complete charge and a complete authorization are accepted: payment
+    methods that only authorize are handled by the completion flow itself. A
+    partial authorization or a partial charge is not enough.
+    """
+    authorized, charged = get_checkout_transaction_amounts(checkout)
+    covered = authorized + charged
+    zero = zero_money(checkout.currency)
+    if covered <= zero:
+        return False
+    return covered >= total_gross
+
+
+def unavailable_products_failure(unavailable_variant_pks) -> EligibilityResult:
+    """Failure result for a checkout holding products that are not available."""
+    return EligibilityResult.failure(
+        AutomaticCompletionReason.UNAVAILABLE_PRODUCTS,
+        "The checkout contains products that are not available: {}.".format(
+            ", ".join(sorted(str(pk) for pk in unavailable_variant_pks))
+        ),
+    )
+
+
+def check_automatic_completion_eligibility(
+    manager: "PluginsManager",
+    checkout_info: "CheckoutInfo",
+    lines: list["CheckoutLineInfo"],
+    unavailable_variant_pks: Optional[set] = None,
+) -> EligibilityResult:
+    """Check whether the checkout may be converted into an order.
+
+    The check is re-run right before the order is created, so that stock,
+    delivery and payment conditions that changed while the checkout was queued
+    are honoured.
+    """
+    from ..order.models import Order
+
+    checkout = checkout_info.checkout
+
+    # A checkout that was already processed must never produce a second order.
+    if Order.objects.get_by_checkout_token(checkout.token):
+        return EligibilityResult.failure(
+            AutomaticCompletionReason.ORDER_ALREADY_EXISTS,
+            "The checkout was already completed and an order exists for it.",
+        )
+
+    from . import calculations
+
+    address = checkout_info.shipping_address or checkout_info.billing_address
+    checkout_total = calculations.calculate_checkout_total(
+        manager=manager,
+        checkout_info=checkout_info,
+        lines=lines,
+        address=address,
+    )
+    total_gross = max(
+        checkout_total, zero_taxed_money(checkout_total.currency)
+    ).gross
+
+    # Payment: a fully charged transaction, a complete authorization of a
+    # payment method that supports it, or a fully paid legacy payment flow.
+    # Partially authorized or partially charged checkouts are never eligible and
+    # the two paths are not summed together.
+    if not (
+        _is_paid_by_transactions(checkout, total_gross)
+        or _has_active_transaction_payment(checkout)
+        or is_fully_paid(manager, checkout_info, lines)
+    ):
+        return EligibilityResult.failure(
+            AutomaticCompletionReason.NOT_FULLY_PAID,
+            "The checkout is not fully paid.",
+        )
+
+    if not checkout_info.get_customer_email():
+        return EligibilityResult.failure(
+            AutomaticCompletionReason.MISSING_CUSTOMER,
+            "The checkout has neither a customer nor an email address.",
+        )
+
+    if checkout_info.billing_address is None:
+        return EligibilityResult.failure(
+            AutomaticCompletionReason.MISSING_BILLING_ADDRESS,
+            "The checkout has no billing address.",
+        )
+
+    if unavailable_variant_pks:
+        return unavailable_products_failure(unavailable_variant_pks)
+
+    if checkout.is_shipping_required():
+        if checkout_info.shipping_address is None:
+            return EligibilityResult.failure(
+                AutomaticCompletionReason.MISSING_SHIPPING_ADDRESS,
+                "The checkout requires shipping but has no shipping address.",
+            )
+
+        delivery_method_info = checkout_info.get_delivery_method_info()
+        if not delivery_method_info.is_delivery_method_set():
+            return EligibilityResult.failure(
+                AutomaticCompletionReason.MISSING_DELIVERY_METHOD,
+                "The checkout requires shipping but no delivery method is set.",
+            )
+        if not (
+            delivery_method_info.is_valid_delivery_method()
+            and delivery_method_info.is_method_in_valid_methods(checkout_info)
+        ):
+            return EligibilityResult.failure(
+                AutomaticCompletionReason.DELIVERY_METHOD_NOT_APPLICABLE,
+                "The selected delivery method is no longer applicable.",
+            )
+
+    if total_gross.amount <= 0:
+        return EligibilityResult.failure(
+            AutomaticCompletionReason.ZERO_TOTAL,
+            "The checkout total is not greater than zero.",
+        )
+
+    return EligibilityResult.success()
+
+
+def record_automatic_completion_failure(
+    checkout: Checkout, result: EligibilityResult
+) -> None:
+    """Persist a diagnosable, retryable failure state on the checkout.
+
+    The payment and amount records are never touched here: a failed automatic
+    completion must leave the checkout exactly as it was, apart from the
+    diagnostic entry itself.
+    """
+    if result.eligible or result.reason is None:
+        return
+
+    from .utils import get_or_create_checkout_metadata
+
+    metadata_storage = get_or_create_checkout_metadata(checkout)
+
+    try:
+        attempts = int(metadata_storage.get_value_from_metadata(ATTEMPTS_METADATA_KEY, 0))
+    except (TypeError, ValueError):
+        attempts = 0
+
+    metadata_storage.store_value_in_metadata(
+        items={
+            ATTEMPTS_METADATA_KEY: attempts + 1,
+            DIAGNOSTIC_METADATA_KEY: {
+                "code": result.reason,
+                "message": result.message,
+                "at": timezone.now().isoformat(),
+                "attempts": attempts + 1,
+            },
+        }
+    )
+    metadata_storage.save(update_fields=["metadata"])
+
+
+def clear_automatic_completion_failure(checkout: Checkout) -> None:
+    """Drop the failure diagnostics once the checkout became eligible again."""
+    from .utils import get_checkout_metadata
+
+    metadata_storage = get_checkout_metadata(checkout)
+    if metadata_storage is None:
+        return
+
+    metadata = metadata_storage.metadata or {}
+    if (
+        DIAGNOSTIC_METADATA_KEY not in metadata
+        and ATTEMPTS_METADATA_KEY not in metadata
+    ):
+        return
+
+    metadata.pop(DIAGNOSTIC_METADATA_KEY, None)
+    metadata.pop(ATTEMPTS_METADATA_KEY, None)
+    metadata_storage.metadata = metadata
+    metadata_storage.save(update_fields=["metadata"])
+
+
+def get_automatic_completion_delay(channel) -> Optional[datetime.timedelta]:
+    """Delay configured for the channel, or ``None`` when not configured.
+
+    The delay is measured from the moment the checkout was last changed.
+    """
+    delay = getattr(channel, "automatic_completion_delay", None)
+    if delay is None or delay <= datetime.timedelta(0):
+        return None
+    return delay
+
+
+def get_automatic_completion_cutoff(channel) -> Optional[datetime.datetime]:
+    """Lower bound of the checkout creation time, or ``None`` when not set.
+
+    This is *not* the moment at which the task stops running: checkouts created
+    after the cutoff keep being picked up.
+    """
+    return getattr(channel, "automatic_completion_cutoff_date", None)
+
+
+def checkouts_pending_automatic_completion(
+    channel,
+    *,
+    now: Optional[datetime.datetime] = None,
+    batch_size: Optional[int] = None,
+    exclude_pks: Optional[set] = None,
+) -> QuerySet[Checkout]:
+    """Return the checkouts of a channel that may be automatically completed.
+
+    Only channels that explicitly enabled the automatic completion are
+    considered, so that channels which were never configured keep their
+    existing manual flow. The delay is measured from ``Checkout.last_change``
+    and the cutoff is a lower bound on ``Checkout.created_at``.
+    """
+    from django.conf import settings as django_settings
+
+    if not getattr(channel, "automatically_complete_fully_paid_checkouts", False):
+        return Checkout.objects.none()
+
+    now = now or timezone.now()
+    queryset = Checkout.objects.filter(channel=channel)
+
+    cutoff = get_automatic_completion_cutoff(channel)
+    if cutoff is not None:
+        queryset = queryset.filter(created_at__gte=cutoff)
+
+    delay = get_automatic_completion_delay(channel)
+    if delay is not None:
+        queryset = queryset.filter(last_change__lte=now - delay)
+
+    if exclude_pks:
+        queryset = queryset.exclude(pk__in=exclude_pks)
+
+    batch_size = batch_size or getattr(
+        django_settings, "CHECKOUT_AUTOMATIC_COMPLETION_BATCH_SIZE", 100
+    )
+    return queryset.order_by("last_change", "pk")[:batch_size]
