+import datetime
+from decimal import Decimal
+from unittest import mock
+
+import graphene
+import pytest
+
+from ....product.models import (
+    Product,
+    ProductChannelListing,
+    ProductType,
+    ProductVariant,
+    ProductVariantChannelListing,
+)
+from ....warehouse.models import Stock
+from ...tests.utils import assert_no_permission, get_graphql_content
+
+QUERY_PRODUCT_DIAGNOSTICS = """
+query ProductChannelDiagnostics(
+  $id: ID!
+  $channel: String
+  $filter: ProductChannelAvailabilityDiagnosticsFilterInput
+  $sortBy: ProductChannelAvailabilityDiagnosticsSortingInput
+  $first: Int
+  $after: String
+) {
+  product(id: $id, channel: $channel) {
+    channelAvailabilityDiagnostics(
+      filter: $filter
+      sortBy: $sortBy
+      first: $first
+      after: $after
+    ) {
+      totalCount
+      edges {
+        cursor
+        channel {
+          slug
+          name
+          currencyCode
+        }
+        node {
+          problemsCount
+          warningsCount
+          notApplicableCount
+          problems {
+            type
+            severity
+            message
+            field
+            variantId
+          }
+        }
+      }
+      pageInfo {
+        hasNextPage
+        endCursor
+      }
+    }
+  }
+}
+"""
+
+
+def _get_connection(content):
+    return content["data"]["product"]["channelAvailabilityDiagnostics"]
+
+
+def _variables(product, channel, **extra):
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "channel": channel.slug,
+        "first": 10,
+    }
+    variables.update(extra)
+    return variables
+
+
+def _problems_by_type(node):
+    return {problem["type"]: problem for problem in node["problems"]}
+
+
+def _count_by_severity(node, severity):
+    return sum(1 for problem in node["problems"] if problem["severity"] == severity)
+
+
+def _create_variant_listing(product, channel, price="10.00"):
+    variant = product.variants.first()
+    ProductVariantChannelListing.objects.create(
+        variant=variant,
+        channel=channel,
+        price_amount=Decimal(price),
+        currency=channel.currency_code,
+    )
+    return variant
+
+
+def test_diagnostics_filter_by_channel_and_counts_match(
+    staff_api_client,
+    permission_manage_products,
+    product,
+    channel_USD,
+    channel_PLN,
+):
+    # given
+    ProductChannelListing.objects.create(
+        product=product,
+        channel=channel_PLN,
+        is_published=True,
+        visible_in_listings=True,
+        currency=channel_PLN.currency_code,
+    )
+    _create_variant_listing(product, channel_PLN)
+    variables = _variables(product, channel_USD, filter={"channel": channel_PLN.slug})
+
+    # when
+    response = staff_api_client.post_graphql(
+        QUERY_PRODUCT_DIAGNOSTICS,
+        variables,
+        permissions=[permission_manage_products],
+        check_no_permissions=False,
+    )
+
+    # then
+    content = get_graphql_content(response)
+    connection = _get_connection(content)
+    assert connection["totalCount"] == 1
+    assert len(connection["edges"]) == 1
+
+    edge = connection["edges"][0]
+    assert edge["channel"]["slug"] == channel_PLN.slug
+
+    node = edge["node"]
+    assert node["problemsCount"] == _count_by_severity(node, "BLOCKER")
+    assert node["warningsCount"] == _count_by_severity(node, "WARNING")
+    assert node["notApplicableCount"] == _count_by_severity(node, "NOT_APPLICABLE")
+    assert (
+        node["problemsCount"]
+        + node["warningsCount"]
+        + node["notApplicableCount"]
+        == len(node["problems"])
+    )
+
+
+def test_diagnostics_filter_by_currency(
+    staff_api_client,
+    permission_manage_products,
+    product,
+    channel_USD,
+    channel_PLN,
+):
+    # given
+    ProductChannelListing.objects.create(
+        product=product,
+        channel=channel_PLN,
+        is_published=True,
+        visible_in_listings=True,
+        currency=channel_PLN.currency_code,
+    )
+    variables = _variables(product, channel_USD, filter={"currency": "pln"})
+
+    # when
+    response = staff_api_client.post_graphql(
+        QUERY_PRODUCT_DIAGNOSTICS,
+        variables,
+        permissions=[permission_manage_products],
+        check_no_permissions=False,
+    )
+
+    # then
+    content = get_graphql_content(response)
+    connection = _get_connection(content)
+    assert connection["totalCount"] == 1
+    assert connection["edges"][0]["channel"]["currencyCode"] == "PLN"
+
+
+def test_diagnostics_sort_by_currency(
+    staff_api_client,
+    permission_manage_products,
+    product,
+    channel_USD,
+    channel_PLN,
+    channel_JPY,
+):
+    # given
+    for channel in (channel_PLN, channel_JPY):
+        ProductChannelListing.objects.create(
+            product=product,
+            channel=channel,
+            is_published=True,
+            visible_in_listings=True,
+            currency=channel.currency_code,
+        )
+    variables = _variables(
+        product, channel_USD, sortBy={"field": "CURRENCY", "direction": "ASC"}
+    )
+
+    # when
+    response = staff_api_client.post_graphql(
+        QUERY_PRODUCT_DIAGNOSTICS,
+        variables,
+        permissions=[permission_manage_products],
+        check_no_permissions=False,
+    )
+
+    # then
+    content = get_graphql_content(response)
+    connection = _get_connection(content)
+    currencies = [edge["channel"]["currencyCode"] for edge in connection["edges"]]
+    assert currencies == sorted(currencies)
+
