@@ -0,0 +1,66 @@
+from .....account.search import prepare_user_search_document_value
+from ....tests.utils import get_graphql_content
+
+QUERY_CUSTOMERS_SEARCH = """
+query Customers($search: String, $first: Int) {
+  customers(search: $search, first: $first) {
+    totalCount
+    edges {
+      node {
+        email
+      }
+    }
+  }
+}
+"""
+
+
+def _customers(staff_api_client, permission_manage_users, search):
+    response = staff_api_client.post_graphql(
+        QUERY_CUSTOMERS_SEARCH,
+        {"search": search, "first": 10},
+        permissions=[permission_manage_users],
+        check_no_permissions=False,
+    )
+    content = get_graphql_content(response)
+    return content["data"]["customers"]
+
+
+def test_customers_search_blank_keyword_returns_all_without_error(
+    staff_api_client, permission_manage_users, customer_user
+):
+    # given / when
+    data = _customers(staff_api_client, permission_manage_users, "   ")
+
+    # then
+    assert data["totalCount"] >= 1
+
+
+def test_customers_search_overlong_keyword_returns_explicit_empty_state(
+    staff_api_client, permission_manage_users, customer_user
+):
+    # given / when
+    data = _customers(staff_api_client, permission_manage_users, "a" * 256)
+
+    # then
+    assert data["totalCount"] == 0
+    assert data["edges"] == []
+
+
+def test_customers_search_keeps_space_combined_word_semantics(
+    staff_api_client, permission_manage_users, customer_user
+):
+    # given
+    customer_user.search_document = prepare_user_search_document_value(customer_user)
+    customer_user.save(update_fields=["search_document"])
+
+    # when
+    data = _customers(
+        staff_api_client,
+        permission_manage_users,
+        f"{customer_user.email}",
+    )
+
+    # then
+    assert data["totalCount"] == 1
+    assert data["edges"][0]["node"]["email"] == customer_user.email
