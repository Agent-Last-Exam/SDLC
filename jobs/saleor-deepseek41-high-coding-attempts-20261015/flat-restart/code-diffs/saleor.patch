+import graphene
+
+from ....tests.utils import get_graphql_content
+
+DRAFT_ORDER_COMPLETE_MUTATION = """
+    mutation draftComplete($id: ID!) {
+        draftOrderComplete(id: $id) {
+            errors {
+                field
+                code
+            }
+            order {
+                shippingMethodMetadata {
+                    key
+                    value
+                }
+                shippingMethodPrivateMetadata {
+                    key
+                    value
+                }
+            }
+        }
+    }
+"""
+
+
+def test_draft_order_complete_stores_shipping_method_metadata_snapshot(
+    staff_api_client,
+    permission_group_manage_orders,
+    draft_order,
+    shipping_method,
+):
+    # given
+    order = draft_order
+    shipping_method.store_value_in_metadata({"public_key": "public_value"})
+    shipping_method.store_value_in_private_metadata({"private_key": "private_value"})
+    shipping_method.save()
+    order.shipping_method = shipping_method
+    order.save()
+
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    variables = {"id": graphene.Node.to_global_id("Order", order.id)}
+
+    # when
+    response = staff_api_client.post_graphql(DRAFT_ORDER_COMPLETE_MUTATION, variables)
+    content = get_graphql_content(response)
+
+    # then
+    data = content["data"]["draftOrderComplete"]
+    assert not data["errors"]
+    assert data["order"]["shippingMethodMetadata"] == [
+        {"key": "public_key", "value": "public_value"}
+    ]
+    assert data["order"]["shippingMethodPrivateMetadata"] == [
+        {"key": "private_key", "value": "private_value"}
+    ]
+
+    order.refresh_from_db()
+    assert order.shipping_method_metadata == {"public_key": "public_value"}
+    assert order.shipping_method_private_metadata == {"private_key": "private_value"}
+
+
+def test_draft_order_complete_snapshot_is_frozen_after_source_change(
+    staff_api_client,
+    permission_group_manage_orders,
+    draft_order,
+    shipping_method,
+):
+    # given
+    order = draft_order
+    shipping_method.store_value_in_metadata({"public_key": "public_value"})
+    shipping_method.save()
+    order.shipping_method = shipping_method
+    order.save()
+
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    variables = {"id": graphene.Node.to_global_id("Order", order.id)}
+
+    # when
+    staff_api_client.post_graphql(DRAFT_ORDER_COMPLETE_MUTATION, variables)
+    order.refresh_from_db()
+    shipping_method.store_value_in_metadata({"public_key": "changed"})
+    shipping_method.save()
+
+    # then
+    assert order.shipping_method_metadata == {"public_key": "public_value"}
