+CHECKOUT_DELIVERY_OPTIONS_RECALCULATE_DESCRIPTION = (
+    "Recalculates delivery options for a checkout using the current checkout facts\n"
+    "(address, lines, channel and the results of the synchronous shipping webhooks).\n"
+    "Returns the available options, the currently selected option and whether that\n"
+    "selection is still applicable.\n\n"
+    "This operation does not change the checkout. When the recalculation fails the\n"
+    "previously selected delivery option is preserved and no partial selection is\n"
+    "written.\n\n"
+    "Requires one of the following permissions: "
+    f"{AuthorizationFilters.AUTHENTICATED_APP.name}, "
+    f"{AuthorizationFilters.AUTHENTICATED_STAFF_USER.name}.\n\n"
+    "Added in Saleor 3.23."
+)
+
+
+class DeliveryOption(BaseObjectType):
+    id = graphene.ID(
+        required=True,
+        description=(
+            "ID of the delivery option. The value is accepted by\n"
+            "`checkoutDeliveryMethodUpdate`."
+        ),
+    )
+    delivery_method = graphene.Field(
+        DeliveryMethod, description="The underlying delivery method."
+    )
+    name = graphene.String(
+        required=True, description="Human readable name of the delivery option."
+    )
+    price = graphene.Field(Money, description="Price of the delivery option.")
+    message = graphene.String(
+        description=(
+            "Message returned by the synchronous delivery options service for this "
+            "option,\nif any."
+        )
+    )
+
+    class Meta:
+        description = (
+            "A single delivery option that can be selected for a checkout."
+            + ADDED_IN_323
+        )
+        doc_category = DOC_CATEGORY_CHECKOUT
+
+
+class CheckoutDeliveryOptions(BaseObjectType):
+    available_delivery_options = NonNullList(
+        DeliveryOption,
+        required=True,
+        description="Delivery options currently applicable to the checkout.",
+    )
+    selected_delivery_option_id = graphene.ID(
+        description="ID of the delivery option currently selected for the checkout, "
+        "if any."
+    )
+    is_selected_delivery_option_available = graphene.Boolean(
+        description=(
+            "Determines whether the currently selected delivery option is still "
+            "applicable.\n`null` when no delivery option is selected for the checkout."
+        )
+    )
+
+    class Meta:
+        description = (
+            "Delivery options currently applicable to a checkout." + ADDED_IN_323
+        )
+        doc_category = DOC_CATEGORY_CHECKOUT
+
+
+def _get_delivery_method_info_without_denormalization(
+    checkout_info: CheckoutInfo,
+) -> DeliveryMethodBase:
+    """Resolve the currently selected delivery method info without side effects.
+
+    ``CheckoutInfo.get_delivery_method_info()`` persists the denormalized shipping
+    method fields (``shipping_method_name`` and
+    ``undiscounted_base_shipping_price_amount``) through
+    ``_update_denormalized_shipping_method_fields``. The recalculation must stay a
+    read-only operation, so the selected method is resolved here and the info
+    object is built directly through the module level ``get_delivery_method_info``
+    singledispatch (which does not write anything back to the checkout).
+    """
+    checkout = checkout_info.checkout
+    delivery_method: Union[ShippingMethodData, warehouse_models.Warehouse, None] = None
+
+    if checkout_info.shipping_method:
+        for listing in checkout_info.shipping_channel_listings:
+            if listing.shipping_method_id == checkout_info.shipping_method.id:
+                delivery_method = convert_to_shipping_method_data(
+                    checkout_info.shipping_method, listing
+                )
+                break
+    elif external_shipping_method_id := get_external_shipping_id(checkout):
+        if checkout_info.allow_sync_webhooks:
+            methods = {method.id: method for method in checkout_info.get_all_shipping_methods()}
+            delivery_method = methods.get(external_shipping_method_id)
+            if delivery_method is None:
+                new_shipping_method_id = convert_to_app_id_with_identifier(
+                    external_shipping_method_id
+                )
+                if new_shipping_method_id is not None:
+                    delivery_method = methods.get(new_shipping_method_id)
+        else:
+            delivery_method = ShippingMethodData(
+                id=external_shipping_method_id,
+                name=checkout.shipping_method_name or "",
+                price=checkout.undiscounted_base_shipping_price,
+            )
+    else:
+        delivery_method = checkout_info.collection_point
+
+    return get_delivery_method_info(delivery_method, checkout_info.shipping_address)
+
+
+def _get_delivery_option_id(
+    delivery_method: Union[ShippingMethodData, warehouse_models.Warehouse],
+) -> str:
+    if isinstance(delivery_method, ShippingMethodData):
+        return delivery_method.graphql_id
+    return graphene.Node.to_global_id("Warehouse", delivery_method.pk)
+
+
+def _build_delivery_options(
+    checkout_info: CheckoutInfo,
+) -> list[DeliveryOption]:
+    options = []
+    for method in checkout_info.valid_delivery_methods:
+        if isinstance(method, ShippingMethodData):
+            options.append(
+                DeliveryOption(
+                    id=method.graphql_id,
+                    delivery_method=method,
+                    name=method.name or "",
+                    price=method.price,
+                    message=method.message or None,
+                )
+            )
+        else:
+            options.append(
+                DeliveryOption(
+                    id=graphene.Node.to_global_id("Warehouse", method.pk),
+                    delivery_method=method,
+                    name=str(method),
+                    price=zero_money(checkout_info.checkout.currency),
+                    message=None,
+                )
+            )
+    return options
+
+
+class CheckoutDeliveryOptionsRecalculate(BaseMutation, I18nMixin):
+    checkout = graphene.Field(
+        Checkout, description="The checkout the options were calculated for."
+    )
+    delivery_options = graphene.Field(
+        CheckoutDeliveryOptions,
+        description="Recalculated delivery options of the checkout.",
+    )
+
+    class Arguments:
+        id = graphene.ID(description="The ID of the checkout.", required=False)
+        token = UUID(
+            description=f"Checkout token.{DEPRECATED_IN_3X_INPUT} Use `id` instead.",
+            required=False,
+        )
+
+    class Meta:
+        description = (
+            "Recalculates delivery options for a checkout using the current checkout "
+            "facts\n(address, lines, channel and the results of the synchronous "
+            "shipping webhooks) and\nreturns the available options together with the "
+            "currently selected one.\n\nThe recalculation does not persist the "
+            "checkout delivery method: a failed\nrecalculation leaves the stored "
+            "selection untouched and writes no partial\nselection."
+            + ADDED_IN_323
+        )
+        doc_category = DOC_CATEGORY_CHECKOUT
+        error_type_class = CheckoutError
+        permissions = (
+            AuthorizationFilters.AUTHENTICATED_APP,
+            AuthorizationFilters.AUTHENTICATED_STAFF_USER,
+        )
+        auto_permission_message = False
+        auto_webhook_events_message = False
+        webhook_events_info = [
+            WebhookEventInfo(
+                type=WebhookEventSyncType.SHIPPING_LIST_METHODS_FOR_CHECKOUT,
+            ),
+            WebhookEventInfo(
+                type=WebhookEventSyncType.CHECKOUT_FILTER_SHIPPING_METHODS,
+            ),
+        ]
+
+    @classmethod
+    def validate_shipping_address(
+        cls,
+        checkout_info: CheckoutInfo,
+        lines: list[CheckoutLineInfo],
+    ) -> None:
+        """Validate that the shipping address allows calculating delivery options.
+
+        Raises ``ValidationError`` with the ``shippingAddress`` field and the
+        ``SHIPPING_ADDRESS_NOT_SET`` code when the address is missing or does not
+        contain all the required fields. The address is not modified.
+        """
+        if not is_shipping_required(lines):
+            return
+
+        shipping_address = checkout_info.shipping_address
+        if shipping_address is None:
+            raise ValidationError(
+                {
+                    "shippingAddress": ValidationError(
+                        "Shipping address is not set",
+                        code=CheckoutErrorCode.SHIPPING_ADDRESS_NOT_SET.value,
+                    )
+                }
+            )
+        if shipping_address.validation_skipped:
+            return
+        try:
+            cls.validate_address(
+                shipping_address.as_data(),
+                address_type=AddressType.SHIPPING,
+                format_check=False,
+                required_check=True,
+                enable_normalization=False,
+            )
+        except ValidationError as error:
+            raise ValidationError(
+                {
+                    "shippingAddress": ValidationError(
+                        "Shipping address is not set or is incomplete",
+                        code=CheckoutErrorCode.SHIPPING_ADDRESS_NOT_SET.value,
+                    )
+                }
+            ) from error
+
+    @classmethod
+    def perform_mutation(  # type: ignore[override]
+        cls,
+        _root,
+        info: ResolveInfo,
+        /,
+        *,
+        id=None,
+        token=None,
+    ):
+        checkout = get_checkout(cls, info, checkout_id=None, token=token, id=id)
+
+        manager = get_plugin_manager_promise(info.context).get()
+        lines, _ = fetch_checkout_lines(checkout)
+        checkout_info = fetch_checkout_info(checkout, lines, manager)
+
+        cls.validate_shipping_address(checkout_info, lines)
+
+        try:
+            available_options = _build_delivery_options(checkout_info)
+            selected_info = _get_delivery_method_info_without_denormalization(
+                checkout_info
+            )
+        except Exception as error:
+            # The synchronous delivery options service (or any other part of the
+            # delivery calculation) failed. The checkout is left untouched: no
+            # partial selection is written.
+            raise ValidationError(
+                {
+                    "deliveryOptions": ValidationError(
+                        "The synchronous delivery options service failed.",
+                        code=CheckoutErrorCode.DELIVERY_OPTIONS_SERVICE_ERROR.value,
+                    )
+                }
+            ) from error
+
+        selected_delivery_method = selected_info.delivery_method
+        if selected_delivery_method is None:
+            selected_delivery_option_id = None
+            is_selected_delivery_option_available = None
+        else:
+            selected_delivery_option_id = _get_delivery_option_id(
+                selected_delivery_method
+            )
+            is_selected_delivery_option_available = (
+                selected_info.is_method_in_valid_methods(checkout_info)
+            )
+
+        delivery_options = CheckoutDeliveryOptions(
+            available_delivery_options=available_options,
+            selected_delivery_option_id=selected_delivery_option_id,
+            is_selected_delivery_option_available=is_selected_delivery_option_available,
+        )
+
+        return CheckoutDeliveryOptionsRecalculate(
+            checkout=SyncWebhookControlContext(checkout),
+            delivery_options=delivery_options,
+        )
