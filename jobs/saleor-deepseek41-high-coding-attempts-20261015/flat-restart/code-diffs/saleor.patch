+                "automaticCompletionCutoffDate": "2025-01-01T10:00:00+00:00",
+            },
+        }
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CHANNEL_CREATE_MUTATION_WITH_STOCK_AND_CHECKOUT_SETTINGS,
+        variables=variables,
+        permissions=(permission_manage_channels,),
