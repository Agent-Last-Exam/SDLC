+    @classmethod
+    def handle_gift_card_transaction_action(
+        cls,
+        action,
+        action_kwargs,
+        action_value: Decimal | None,
+        user: Optional["User"],
+        app: App | None,
+    ):
+        """Handle cancel/charge/refund of a gift card backed transaction.
+
+        Gift cards do not go through a payment app webhook. The balance is
+        updated synchronously and the related order/checkout payment statuses
+        are recalculated.
+        """
+        transaction = action_kwargs["transaction"]
+        try:
+            if action == TransactionAction.CANCEL:
+                release_gift_card_authorization(transaction, user, app)
+            elif action == TransactionAction.CHARGE:
+                amount = action_value or transaction.authorized_value
+                amount = min(amount, transaction.authorized_value)
+                charge_gift_card(transaction, amount, user, app)
+            elif action == TransactionAction.REFUND:
+                refundable = transaction.charged_value - transaction.refunded_value
+                amount = action_value or refundable
+                amount = min(amount, refundable)
+                refund_gift_card(transaction, amount, user, app)
+            else:
+                raise ValidationError(
+                    {
+                        "actionType": ValidationError(
+                            "Incorrect action.",
+                            code=TransactionRequestActionErrorCode.INVALID.value,
+                        )
+                    }
+                )
