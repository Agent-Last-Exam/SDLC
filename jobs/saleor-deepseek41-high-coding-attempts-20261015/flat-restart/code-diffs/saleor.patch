+def backfill_shipping_method_metadata(apps, schema_editor):
+    """Idempotently snapshot delivery method metadata for existing orders.
+
+    Only orders whose snapshot is still empty and that reference a shipping
+    method are backfilled, so running the migration more than once never
+    duplicates or overwrites data. Orders without a shipping method (or whose
+    method has no metadata) keep a stable empty value.
+    """
+    Order = apps.get_model("order", "Order")
+    ShippingMethod = apps.get_model("shipping", "ShippingMethod")
+
+    orders = Order.objects.filter(shipping_method__isnull=False).only(
+        "pk",
+        "shipping_method_id",
+        "shipping_method_metadata",
+        "shipping_method_private_metadata",
+    )
+    methods = {
+        method.pk: method
+        for method in ShippingMethod.objects.filter(
+            pk__in=orders.values_list("shipping_method_id", flat=True)
+        )
+    }
+    to_update = []
+    for order in orders.iterator():
+        # Idempotency: never touch an order that already has a snapshot.
+        if order.shipping_method_metadata or order.shipping_method_private_metadata:
+            continue
+        method = methods.get(order.shipping_method_id)
+        if method is None:
+            continue
+        metadata = method.metadata or {}
+        private_metadata = method.private_metadata or {}
+        if not metadata and not private_metadata:
+            continue
+        order.shipping_method_metadata = metadata
+        order.shipping_method_private_metadata = private_metadata
+        to_update.append(order)
+    if to_update:
+        Order.objects.bulk_update(
+            to_update,
+            ["shipping_method_metadata", "shipping_method_private_metadata"],
+            batch_size=500,
+        )
+
