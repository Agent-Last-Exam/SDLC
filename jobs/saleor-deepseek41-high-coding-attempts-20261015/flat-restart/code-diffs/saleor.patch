+def test_unpublished_channel_reports_blocker_without_duplicating_dependencies(
+    staff_api_client,
+    permission_manage_products,
+    product,
+    channel_USD,
+):
+    # given
+    listing = product.channel_listings.get(channel=channel_USD)
+    listing.is_published = False
+    listing.save(update_fields=["is_published"])
+    # Remove the stock so the stock dependency would otherwise be reported.
+    Stock.objects.filter(product_variant__product=product).delete()
+    variables = _variables(product, channel_USD)
+
+    # when
+    response = staff_api_client.post_graphql(
+        QUERY_PRODUCT_DIAGNOSTICS,
+        variables,
+        permissions=[permission_manage_products],
+        check_no_permissions=False,
+    )
+
+    # then
+    content = get_graphql_content(response)
+    node = _get_connection(content)["edges"][0]["node"]
+    problems = _problems_by_type(node)
+
+    assert problems["NOT_PUBLISHED"]["severity"] == "BLOCKER"
+    # Dependencies are reported as not-applicable instead of duplicated errors.
+    assert problems["NO_STOCK"]["severity"] == "NOT_APPLICABLE"
+
