+import importlib
+
+import pytest
+from django.apps import apps as django_apps
+
+from ..models import Order
+
+migration = importlib.import_module(
+    "saleor.order.migrations.0218_order_shipping_method_metadata_snapshot"
+)
+backfill_shipping_method_metadata = migration.backfill_shipping_method_metadata
+
+
+@pytest.fixture
+def order_with_shipping_method(order, shipping_method):
+    order.shipping_method = shipping_method
+    order.shipping_method_metadata = {}
+    order.shipping_method_private_metadata = {}
+    order.save()
+    return order
+
+
+def test_backfill_snapshots_shipping_method_metadata(order_with_shipping_method):
+    # given
+    order = order_with_shipping_method
+    method = order.shipping_method
+    method.store_value_in_metadata({"public_key": "public_value"})
+    method.store_value_in_private_metadata({"private_key": "private_value"})
+    method.save()
+
+    # when
+    backfill_shipping_method_metadata(django_apps, None)
+
+    # then
+    order.refresh_from_db()
+    assert order.shipping_method_metadata == {"public_key": "public_value"}
+    assert order.shipping_method_private_metadata == {"private_key": "private_value"}
+
+
+def test_backfill_is_idempotent(order_with_shipping_method):
+    # given
+    order = order_with_shipping_method
+    method = order.shipping_method
+    method.store_value_in_metadata({"public_key": "public_value"})
+    method.save()
+
+    # when: run twice
+    backfill_shipping_method_metadata(django_apps, None)
+    first = Order.objects.get(pk=order.pk)
+    backfill_shipping_method_metadata(django_apps, None)
+    second = Order.objects.get(pk=order.pk)
+
+    # then: unchanged on the second run, no data loss
+    assert first.shipping_method_metadata == {"public_key": "public_value"}
+    assert second.shipping_method_metadata == {"public_key": "public_value"}
+
+
+def test_backfill_does_not_overwrite_existing_snapshot(order_with_shipping_method):
+    # given
+    order = order_with_shipping_method
+    order.shipping_method_metadata = {"existing": "snapshot"}
+    order.save(update_fields=["shipping_method_metadata"])
+    method = order.shipping_method
+    method.store_value_in_metadata({"public_key": "public_value"})
+    method.save()
+
+    # when
+    backfill_shipping_method_metadata(django_apps, None)
+
+    # then
+    order.refresh_from_db()
+    assert order.shipping_method_metadata == {"existing": "snapshot"}
+
+
+def test_backfill_leaves_order_without_shipping_method_empty(order):
+    # given
+    order.shipping_method = None
+    order.save(update_fields=["shipping_method"])
+
+    # when
+    backfill_shipping_method_metadata(django_apps, None)
+
+    # then
+    order.refresh_from_db()
+    assert order.shipping_method_metadata == {}
+    assert order.shipping_method_private_metadata == {}
