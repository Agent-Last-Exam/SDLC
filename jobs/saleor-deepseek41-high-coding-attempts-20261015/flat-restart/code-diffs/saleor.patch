@@ -0,0 +1,147 @@
+import graphene
+import pytest
+
+from ....core.error_codes import MetadataErrorCode
+from ...tests.utils import assert_no_permission, get_graphql_content
+
+UPDATE_PUBLIC_METADATA_MUTATION = """
+    mutation UpdateMetadata($id: ID!, $input: [MetadataInput!]!) {
+        updateMetadata(id: $id, input: $input) {
+            errors {
+                field
+                code
+                message
+            }
+            item {
+                metadata {
+                    key
+                    value
+                }
+            }
+        }
+    }
+"""
+
+
+def test_update_and_read_order_metadata(
+    staff_api_client, order, permission_manage_orders
+):
+    # given
+    order.metadata = {}
+    order.save(update_fields=["metadata"])
+    variables = {
+        "id": graphene.Node.to_global_id("Order", order.pk),
+        "input": [{"key": "legal_key", "value": "legal_value"}],
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_PUBLIC_METADATA_MUTATION,
+        variables,
+        [permission_manage_orders],
+        check_no_permissions=False,
+    )
+    content = get_graphql_content(response)
+
+    # then
+    assert not content["data"]["updateMetadata"]["errors"]
+    order.refresh_from_db()
+    assert order.metadata == {"legal_key": "legal_value"}
+
+
+def test_update_order_metadata_with_empty_key_is_rejected_and_preserves_original(
+    staff_api_client, order, permission_manage_orders
+):
+    # given
+    order.metadata = {}
+    order.store_value_in_metadata({"original": "value"})
+    order.save(update_fields=["metadata"])
+    variables = {
+        "id": graphene.Node.to_global_id("Order", order.pk),
+        "input": [{"key": "", "value": "value"}],
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_PUBLIC_METADATA_MUTATION,
+        variables,
+        [permission_manage_orders],
+        check_no_permissions=False,
+    )
+    content = get_graphql_content(response)
+
+    # then
+    errors = content["data"]["updateMetadata"]["errors"]
+    assert errors
+    assert errors[0]["code"] == MetadataErrorCode.REQUIRED.name
+    # no partial write: original value untouched
+    order.refresh_from_db()
+    assert order.metadata == {"original": "value"}
+
+
+def test_update_order_metadata_without_permission_does_not_change(
+    staff_api_client, order
+):
+    # given
+    order.metadata = {}
+    order.store_value_in_metadata({"original": "value"})
+    order.save(update_fields=["metadata"])
+    variables = {
+        "id": graphene.Node.to_global_id("Order", order.pk),
+        "input": [{"key": "key", "value": "value"}],
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_PUBLIC_METADATA_MUTATION, variables
+    )
+
+    # then
+    assert_no_permission(response)
+    order.refresh_from_db()
+    assert order.metadata == {"original": "value"}
+
+
+def test_order_line_metadata_still_available(
+    staff_api_client, order_with_lines, permission_manage_orders
+):
+    # given
+    order_line = order_with_lines.lines.first()
+    order_line.metadata = {}
+    order_line.save(update_fields=["metadata"])
+    variables = {
+        "id": graphene.Node.to_global_id("OrderLine", order_line.pk),
+        "input": [{"key": "line_key", "value": "line_value"}],
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_PUBLIC_METADATA_MUTATION,
+        variables,
+        [permission_manage_orders],
+        check_no_permissions=False,
+    )
+    content = get_graphql_content(response)
+
+    # then
+    assert not content["data"]["updateMetadata"]["errors"]
+    order_line.refresh_from_db()
+    assert order_line.metadata == {"line_key": "line_value"}
+
+
+def test_no_dedicated_metadata_mutations_are_exposed():
+    """Only the four generic metadata mutations are exposed (no per-object entry)."""
+    from ...api import schema
+
+    mutation_type = schema.get_type("Mutation")
+    metadata_mutations = {
+        name
+        for name in mutation_type.fields
+        if "metadata" in name.lower()
+    }
+    assert metadata_mutations == {
+        "updateMetadata",
+        "deleteMetadata",
+        "updatePrivateMetadata",
+        "deletePrivateMetadata",
+    }
