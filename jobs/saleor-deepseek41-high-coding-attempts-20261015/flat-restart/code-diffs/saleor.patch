+def test_checkout_delivery_options_recalculate_incomplete_shipping_address(
+    staff_api_client,
+    checkout_with_shipping_method,
+):
+    # given
+    checkout = checkout_with_shipping_method
+    shipping_method_id = checkout.shipping_method_id
+    shipping_method_name = checkout.shipping_method_name
+
+    # Break a required field of the shipping address.
+    checkout.shipping_address.street_address_1 = ""
+    checkout.shipping_address.save(update_fields=["street_address_1"])
+
+    # when
+    data = _get_recalculate_data(staff_api_client, checkout)
