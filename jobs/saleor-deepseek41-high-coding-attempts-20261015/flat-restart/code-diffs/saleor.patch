+def test_order_shipping_method_private_metadata_snapshot_as_staff(
+    staff_api_client, order, shipping_method, permission_manage_orders
+):
+    # given
+    order.shipping_method = shipping_method
+    order.shipping_method_private_metadata = {"private_key": "private_value"}
+    order.save()
+    variables = {"token": order.id}
+
+    # when
