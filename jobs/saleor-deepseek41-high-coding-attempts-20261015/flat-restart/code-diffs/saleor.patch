+    checkout_with_shipping_method,
+):
+    # given
+    checkout = checkout_with_shipping_method
+    checkout.shipping_address = None
+    checkout.save(update_fields=["shipping_address"])
+    checkout_info, lines = _get_checkout_info(checkout)
+
+    # when
+    with pytest.raises(ValidationError) as exc:
+        revalidate_delivery_method(checkout_info, lines, CheckoutErrorCode)
+
+    # then
+    error = exc.value.error_dict
+    assert list(error.keys()) == ["shipping_address"]
+    assert error["shipping_address"][0].code == (
+        CheckoutErrorCode.SHIPPING_ADDRESS_NOT_SET.value
+    )
+
+
+def test_revalidate_delivery_method_not_applicable(
+    checkout_with_shipping_method,
+    shipping_zone,
+):
+    # given
+    checkout = checkout_with_shipping_method
+    shipping_zone.countries = ["US"]
+    shipping_zone.save(update_fields=["countries"])
+    checkout_info, lines = _get_checkout_info(checkout)
+
+    # when
+    with pytest.raises(ValidationError) as exc:
+        revalidate_delivery_method(checkout_info, lines, CheckoutErrorCode)
+
+    # then
+    error = exc.value.error_dict
+    assert list(error.keys()) == ["shipping_method"]
+    assert error["shipping_method"][0].code == (
+        CheckoutErrorCode.DELIVERY_METHOD_NOT_APPLICABLE.value
+    )
+    # the stale selection is cleared
+    checkout.refresh_from_db()
+    assert checkout.shipping_method_id is None
+
+
+def test_revalidate_delivery_method_not_shipping_required(checkout_without_shipping_required):
+    # given
+    checkout = checkout_without_shipping_required
+    checkout_info, lines = _get_checkout_info(checkout)
+
+    assert not is_shipping_required(lines)
