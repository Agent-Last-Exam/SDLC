index 0000000000000000000000000000000000000000..947872439790417fa899bef6d10b95d98547568a
--- /dev/null
+++ b/saleor/graphql/shop/tests/test_password_login_mode.py
@@ -0,0 +1,156 @@
+"""Tests for the shop-wide ``passwordLoginMode`` setting (R16 / BD11).
+
+Covers the GraphQL surface of the policy: reading the effective value from the
+``shop`` query, updating it through ``shopSettingsUpdate`` (permission gated),
+and the fact that a saved value takes effect immediately without caching.
+"""
+
+from unittest.mock import patch
+
+from ....account.error_codes import AccountErrorCode
+from ....site import PasswordLoginMode
+from ...tests.utils import assert_no_permission, get_graphql_content
+
+SHOP_PASSWORD_LOGIN_MODE_QUERY = """
+    query {
+        shop {
+            passwordLoginMode
+        }
+    }
+"""
+
+SHOP_SETTINGS_UPDATE_MUTATION = """
+    mutation updateSettings($input: ShopSettingsInput!) {
+        shopSettingsUpdate(input: $input) {
+            shop {
+                passwordLoginMode
+            }
+            errors {
+                field
+                message
+                code
+            }
+        }
+    }
+"""
+
+MUTATION_CREATE_TOKEN = """
+    mutation tokenCreate($email: String!, $password: String!){
+        tokenCreate(email: $email, password: $password) {
+            token
+            errors {
+                field
+                message
+                code
+            }
+        }
+    }
+"""
+
+
+def test_shop_query_exposes_password_login_mode(api_client, site_settings):
+    # given
+    site_settings.password_login_mode = PasswordLoginMode.CUSTOMERS_ONLY
+    site_settings.save(update_fields=["password_login_mode"])
+
+    # when
+    response = api_client.post_graphql(SHOP_PASSWORD_LOGIN_MODE_QUERY)
+
+    # then
+    content = get_graphql_content(response)
+    assert content["data"]["shop"]["passwordLoginMode"] == "CUSTOMERS_ONLY"
+
+
+def test_shop_settings_update_password_login_mode(
+    staff_api_client, site_settings, permission_manage_settings
+):
+    # given
+    variables = {"input": {"passwordLoginMode": "DISABLED"}}
+
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE_MUTATION,
+        variables,
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["shopSettingsUpdate"]
+    assert data["errors"] == []
+    assert data["shop"]["passwordLoginMode"] == "DISABLED"
+
+    site_settings.refresh_from_db()
+    assert site_settings.password_login_mode == PasswordLoginMode.DISABLED
+
+
+def test_shop_settings_update_password_login_mode_without_permission(
+    staff_api_client, site_settings
+):
+    # given
+    site_settings.password_login_mode = PasswordLoginMode.ENABLED
+    site_settings.save(update_fields=["password_login_mode"])
+    variables = {"input": {"passwordLoginMode": "DISABLED"}}
+
+    # when
+    response = staff_api_client.post_graphql(SHOP_SETTINGS_UPDATE_MUTATION, variables)
+
+    # then
+    assert_no_permission(response)
+    site_settings.refresh_from_db()
+    assert site_settings.password_login_mode == PasswordLoginMode.ENABLED
+
+
+@patch("saleor.account.throttling.cache")
+def test_password_login_mode_takes_effect_immediately(
+    _mocked_cache,
+    staff_api_client,
+    api_client,
+    customer_user,
+    site_settings,
+    permission_manage_settings,
+):
+    # given
+    site_settings.password_login_mode = PasswordLoginMode.ENABLED
+    site_settings.save(update_fields=["password_login_mode"])
+    login_variables = {
+        "email": customer_user.email,
+        "password": customer_user._password,
+    }
+
+    # when - disable the policy through the API
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE_MUTATION,
+        {"input": {"passwordLoginMode": "DISABLED"}},
+        permissions=[permission_manage_settings],
+        check_no_permissions=False,
+    )
+    content = get_graphql_content(response)
+    assert content["data"]["shopSettingsUpdate"]["errors"] == []
+    assert content["data"]["shopSettingsUpdate"]["shop"]["passwordLoginMode"] == (
+        "DISABLED"
+    )
+
+    # then - the next password login is rejected right away, without a restart
+    disabled_login = api_client.post_graphql(MUTATION_CREATE_TOKEN, login_variables)
+    disabled_data = get_graphql_content(disabled_login)["data"]["tokenCreate"]
+    assert disabled_data["token"] is None
+    assert (
+        disabled_data["errors"][0]["code"] == AccountErrorCode.PASSWORD_LOGIN_DISABLED.name
+    )
+
+    # when - re-enable the policy
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE_MUTATION,
+        {"input": {"passwordLoginMode": "ENABLED"}},
+        permissions=[permission_manage_settings],
+        check_no_permissions=False,
+    )
+    content = get_graphql_content(response)
+    assert content["data"]["shopSettingsUpdate"]["errors"] == []
+
+    # then - password login works again immediately
+    enabled_login = api_client.post_graphql(MUTATION_CREATE_TOKEN, login_variables)
+    enabled_data = get_graphql_content(enabled_login)["data"]["tokenCreate"]
+    assert enabled_data["errors"] == []
+    assert enabled_data["token"]
