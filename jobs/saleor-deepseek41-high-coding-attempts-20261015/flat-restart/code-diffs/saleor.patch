+++ b/saleor/graphql/product/diagnostics_enums.py
@@ -0,0 +1,339 @@
+"""GraphQL types for product channel availability diagnostics (R04 / BD04)."""
+
+from enum import Enum
+
+import graphene
+
+from ..core.descriptions import ADDED_IN_323
+from ..core.doc_category import DOC_CATEGORY_PRODUCTS
+from ..core.enums import OrderDirection
+from ..core.types import (
+    BaseConnection,
+    BaseEnum,
+    BaseInputObjectType,
+    BaseObjectType,
+    NonNullList,
+)
+from ...product.utils.diagnostics import (
+    ProductChannelAvailabilityProblemSeverity,
+    ProductChannelAvailabilityProblemType,
+)
+from ..channel.types import Channel
+
+
+# Per-value descriptions for ``ProductChannelAvailabilityProblemTypeEnum``. Keyed
+# by the string value because graphene enum members are not hashable.
+_PROBLEM_TYPE_DESCRIPTIONS = {
+    "NOT_PUBLISHED": "The product is not published in the channel.",
+    "NOT_AVAILABLE_FOR_PURCHASE": (
+        "The product is not available for purchase in the channel."
+    ),
+    "NOT_VISIBLE_IN_LISTINGS": (
+        "The product is not visible in listings of the channel."
+    ),
+    "NO_STOCK": "No variant of the product has sellable stock in the channel.",
+    "NO_WAREHOUSE_ASSIGNED": (
+        "No warehouse able to serve the channel is assigned."
+    ),
+    "NO_SHIPPING_ZONE": (
+        "The channel has no shipping zone covering the delivery context."
+    ),
+    "NO_VARIANTS": "The product has no variants.",
+    "SHIPPING_NOT_APPLICABLE": (
+        "Shipping related checks were skipped because the product is not shippable."
+    ),
+    "PRODUCT_TYPE_CONFIGURATION": (
+        "Product type configuration does not allow selling in the channel."
+    ),
+    "DIAGNOSTICS_UNAVAILABLE": (
+        "Diagnostics could not be computed for the channel."
+    ),
+}
+
+
+class ProductChannelAvailabilityProblemSeverityEnum(BaseEnum):
+    """Severity of a product channel availability diagnostic."""
+
+    BLOCKER = ProductChannelAvailabilityProblemSeverity.BLOCKER.value
+    WARNING = ProductChannelAvailabilityProblemSeverity.WARNING.value
+    NOT_APPLICABLE = ProductChannelAvailabilityProblemSeverity.NOT_APPLICABLE.value
+
+    class Meta:
+        doc_category = DOC_CATEGORY_PRODUCTS
+        description = (
+            "Severity of a product channel availability diagnostic." + ADDED_IN_323
+        )
+
+    @property
+    def description(self):
+        # pylint: disable=no-member
+        if self == ProductChannelAvailabilityProblemSeverityEnum.BLOCKER:
+            return "The problem blocks the product from being sold in the channel."
+        if self == ProductChannelAvailabilityProblemSeverityEnum.WARNING:
+            return "The problem does not block selling but should be reviewed."
+        if self == ProductChannelAvailabilityProblemSeverityEnum.NOT_APPLICABLE:
+            return "The check does not apply to the product in the channel."
+        raise ValueError(f"Unsupported enum value: {self.value}")
+
+
+class ProductChannelAvailabilityProblemTypeEnum(BaseEnum):
+    """Type of a product channel availability diagnostic."""
+
+    NOT_PUBLISHED = ProductChannelAvailabilityProblemType.NOT_PUBLISHED.value
+    NOT_AVAILABLE_FOR_PURCHASE = (
+        ProductChannelAvailabilityProblemType.NOT_AVAILABLE_FOR_PURCHASE.value
+    )
+    NOT_VISIBLE_IN_LISTINGS = (
+        ProductChannelAvailabilityProblemType.NOT_VISIBLE_IN_LISTINGS.value
+    )
+    NO_STOCK = ProductChannelAvailabilityProblemType.NO_STOCK.value
+    NO_WAREHOUSE_ASSIGNED = (
+        ProductChannelAvailabilityProblemType.NO_WAREHOUSE_ASSIGNED.value
+    )
+    NO_SHIPPING_ZONE = ProductChannelAvailabilityProblemType.NO_SHIPPING_ZONE.value
+    NO_VARIANTS = ProductChannelAvailabilityProblemType.NO_VARIANTS.value
+    SHIPPING_NOT_APPLICABLE = (
+        ProductChannelAvailabilityProblemType.SHIPPING_NOT_APPLICABLE.value
+    )
+    PRODUCT_TYPE_CONFIGURATION = (
+        ProductChannelAvailabilityProblemType.PRODUCT_TYPE_CONFIGURATION.value
+    )
+    DIAGNOSTICS_UNAVAILABLE = (
+        ProductChannelAvailabilityProblemType.DIAGNOSTICS_UNAVAILABLE.value
+    )
+
+    class Meta:
+        doc_category = DOC_CATEGORY_PRODUCTS
+        description = (
+            "Type of a product channel availability diagnostic." + ADDED_IN_323
+        )
+
+    @property
+    def description(self):
+        # Graphene enum members are unhashable (an ``__eq__`` is injected), so the
+        # descriptions are keyed by the underlying string value.
+        # pylint: disable=no-member
+        try:
+            return _PROBLEM_TYPE_DESCRIPTIONS[self.value]
+        except KeyError as e:
