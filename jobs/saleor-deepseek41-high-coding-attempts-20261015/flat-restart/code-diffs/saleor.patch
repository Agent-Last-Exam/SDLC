new file mode 100644
index 0000000000000000000000000000000000000000..9e188ea6fa2e0a54f3fba0759b2fa7986310fba4
--- /dev/null
+++ b/saleor/graphql/page/tests/queries/test_page_search_hardening.py
@@ -0,0 +1,89 @@
+from ....tests.utils import get_graphql_content
+
+QUERY_PAGES_SEARCH = """
+query Pages($search: String, $first: Int) {
+  pages(search: $search, first: $first) {
+    totalCount
+    edges {
+      node {
+        slug
+      }
+    }
+  }
+}
+"""
+
+QUERY_PAGE_TYPES_SEARCH = """
+query PageTypes($search: String, $first: Int) {
+  pageTypes(filter: {search: $search}, first: $first) {
+    totalCount
+    edges {
+      node {
+        name
+      }
+    }
+  }
+}
+"""
+
+
+def _pages(api_client, search):
+    response = api_client.post_graphql(QUERY_PAGES_SEARCH, {"search": search, "first": 10})
+    content = get_graphql_content(response)
+    return content["data"]["pages"]
+
+
+def _page_types(api_client, search):
+    response = api_client.post_graphql(
+        QUERY_PAGE_TYPES_SEARCH, {"search": search, "first": 10}
+    )
+    content = get_graphql_content(response)
+    return content["data"]["pageTypes"]
+
+
+def test_pages_search_blank_keyword_returns_all_without_error(api_client, page):
+    # given / when
+    data = _pages(api_client, "   ")
+
+    # then
+    assert data["totalCount"] == 1
+    assert data["edges"][0]["node"]["slug"] == page.slug
+
+
+def test_pages_search_overlong_keyword_returns_explicit_empty_state(api_client, page):
+    # given / when
+    data = _pages(api_client, "a" * 256)
+
+    # then
+    assert data["totalCount"] == 0
+    assert data["edges"] == []
+
+
+def test_pages_search_keeps_semantics(api_client, page):
+    # given / when
+    data = _pages(api_client, page.title)
+
+    # then
+    assert data["totalCount"] == 1
+    assert data["edges"][0]["node"]["slug"] == page.slug
+
+
+def test_page_types_search_blank_keyword_returns_all_without_error(
+    api_client, page_type
+):
+    # given / when
+    data = _page_types(api_client, "   ")
+
+    # then
+    assert data["totalCount"] >= 1
+
+
+def test_page_types_search_overlong_keyword_returns_explicit_empty_state(
+    api_client, page_type
+):
+    # given / when
+    data = _page_types(api_client, "a" * 256)
+
+    # then
+    assert data["totalCount"] == 0
+    assert data["edges"] == []
