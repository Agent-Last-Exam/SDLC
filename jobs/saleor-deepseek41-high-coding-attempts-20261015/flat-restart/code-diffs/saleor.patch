index 0000000000000000000000000000000000000000..f93f32b09bf3ba68575f360a675ab96e21ddb945
--- /dev/null
+++ b/saleor/plugins/openid_connect/tests/test_google_offline_access.py
@@ -0,0 +1,178 @@
+"""Tests for Google OIDC offline authorization and external identity linking.
+
+Covers R17 / BD12:
+* Google relies on ``access_type=offline`` instead of the ``offline_access``
+  scope (AC-17-1), while other providers keep their own contract (AC-17-2).
+* Auth failures expose an identifiable error without leaking tokens (AC-17-3).
+* First-time linking of an OIDC identity to a local user removes the old
+  password path (AC-17-4) and subsequent logins resolve to the same user without
+  duplicating the identity (AC-17-5).
+"""
+
+from unittest.mock import MagicMock, Mock, patch
+from urllib.parse import parse_qs, urlparse
+
+import pytest
+from authlib.integrations.base_client.errors import OAuthError
+from django.core import signing
+from django.core.exceptions import ValidationError
+
+from ....core.jwt import jwt_encode, jwt_user_payload
+from ..utils import get_or_create_user_from_payload
+
+GOOGLE_AUTHORIZATION_URL = "https://accounts.google.com/o/oauth2/v2/auth"
+GOOGLE_TOKEN_URL = "https://oauth2.googleapis.com/token"
+NON_GOOGLE_AUTHORIZATION_URL = "https://saleor.io/oauth/authorize"
+
+
+def _authorization_url(plugin, rf, settings):
+    settings.ALLOWED_CLIENT_HOSTS = ["*"]
+    redirect_uri = "http://localhost:3000/oauth-callback/"
+    response = plugin.external_authentication_url(
+        {"redirectUri": redirect_uri}, rf.request(), None
+    )
+    return response["authorizationUrl"]
+
+
+def test_google_uses_access_type_offline_without_offline_scope(
+    openid_plugin, rf, settings
+):
+    # given
+    plugin = openid_plugin(
+        oauth_authorization_url=GOOGLE_AUTHORIZATION_URL,
+        oauth_token_url=GOOGLE_TOKEN_URL,
+        enable_refresh_token=True,
+    )
+
+    # when
+    scope = plugin._get_oauth_session().scope
+    auth_url = _authorization_url(plugin, rf, settings)
+
+    # then
+    assert "offline_access" not in scope
+    query = parse_qs(urlparse(auth_url).query)
+    assert query["access_type"] == ["offline"]
+
+
+def test_non_google_provider_keeps_offline_scope(openid_plugin, rf, settings):
+    # given
+    plugin = openid_plugin(
+        oauth_authorization_url=NON_GOOGLE_AUTHORIZATION_URL,
+        enable_refresh_token=True,
+    )
+
+    # when
+    scope = plugin._get_oauth_session().scope
+    auth_url = _authorization_url(plugin, rf, settings)
+
+    # then
+    assert "offline_access" in scope
+    query = parse_qs(urlparse(auth_url).query)
+    assert "access_type" not in query
+
+
+def test_google_without_refresh_token_does_not_request_offline(
+    openid_plugin, rf, settings
+):
+    # given
+    plugin = openid_plugin(
+        oauth_authorization_url=GOOGLE_AUTHORIZATION_URL,
+        oauth_token_url=GOOGLE_TOKEN_URL,
+        enable_refresh_token=False,
+    )
+
+    # when
+    scope = plugin._get_oauth_session().scope
+    auth_url = _authorization_url(plugin, rf, settings)
+
+    # then
+    assert "offline_access" not in scope
+    query = parse_qs(urlparse(auth_url).query)
+    assert "access_type" not in query
+
+
+def test_failed_token_exchange_does_not_leak_sensitive_data(
+    openid_plugin, monkeypatch, rf, id_payload
+):
+    # given
+    secret_token = "super-secret-refresh-token"
+    mocked_jwt_validator = MagicMock()
+    mocked_jwt_validator.__getitem__.side_effect = id_payload.__getitem__
+    mocked_jwt_validator.get.side_effect = id_payload.get
+
+    monkeypatch.setattr(
+        "saleor.plugins.openid_connect.utils.get_decoded_token",
+        Mock(return_value=mocked_jwt_validator),
+    )
+    plugin = openid_plugin(use_oauth_scope_permissions=True)
+    monkeypatch.setattr(
+        "saleor.plugins.openid_connect.client.OAuth2Client.fetch_token",
+        Mock(side_effect=OAuthError(error="invalid_grant", description=secret_token)),
+    )
+
+    state = signing.dumps({"redirectUri": "http://localhost:3000/used-logged-in"})
+
+    # when
+    with pytest.raises(ValidationError) as exc_info:
+        plugin.external_obtain_access_tokens(
+            {"state": state, "code": "oauth-code"}, rf.request(), previous_value=None
+        )
+
+    # then
+    errors = exc_info.value.error_dict
+    assert "code" in errors
+    message = str(errors["code"][0].message)
+    assert secret_token not in message
+    assert "invalid_grant" in message
+
+
+@patch("saleor.plugins.openid_connect.utils.cache.set")
+@patch("saleor.plugins.openid_connect.utils.cache.get")
+def test_first_time_link_disables_local_password(
+    mocked_cache_get, mocked_cache_set, customer_user
+):
+    # given
+    oauth_url = "https://saleor.io/oauth"
+    sub_id = "google|1234"
+    assert customer_user.has_usable_password()
+    mocked_cache_get.side_effect = lambda cache_key: None
+
+    # when
+    user, _, _ = get_or_create_user_from_payload(
+        payload={"sub": sub_id, "email": customer_user.email},
+        oauth_url=oauth_url,
+    )
+
+    # then
+    user.refresh_from_db()
+    assert user.id == customer_user.id
+    assert not user.has_usable_password()
+    assert user.private_metadata[f"oidc:{oauth_url}"] == sub_id
+
+
+@patch("saleor.plugins.openid_connect.utils.cache.set")
+@patch("saleor.plugins.openid_connect.utils.cache.get")
+def test_subsequent_logins_resolve_to_same_user(
+    mocked_cache_get, mocked_cache_set, customer_user
+):
+    # given
+    oauth_url = "https://saleor.io/oauth"
+    sub_id = "google|1234"
+    customer_user.private_metadata = {f"oidc:{oauth_url}": sub_id}
+    customer_user.save()
+    mocked_cache_get.side_effect = lambda cache_key: None
+    payload = {"sub": sub_id, "email": customer_user.email}
+
+    # when
+    first_user, _, _ = get_or_create_user_from_payload(payload, oauth_url)
+    second_user, _, _ = get_or_create_user_from_payload(payload, oauth_url)
+
+    # then
+    assert first_user.id == customer_user.id
+    assert second_user.id == customer_user.id
+    second_user.refresh_from_db()
+    oidc_keys = [
+        key for key in second_user.private_metadata if key.startswith("oidc:")
+    ]
+    assert oidc_keys == [f"oidc:{oauth_url}"]
+    assert second_user.private_metadata[f"oidc:{oauth_url}"] == sub_id
