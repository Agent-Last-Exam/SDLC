+def test_diagnostics_pagination_is_stable(
+    staff_api_client,
+    permission_manage_products,
+    product,
+    channel_USD,
+    channel_PLN,
+    channel_JPY,
+):
+    # given
+    for channel in (channel_PLN, channel_JPY):
+        ProductChannelListing.objects.create(
+            product=product,
+            channel=channel,
+            is_published=True,
+            visible_in_listings=True,
+            currency=channel.currency_code,
+        )
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+    base_variables = {"id": product_id, "channel": channel_USD.slug}
+
+    # when
+    first_response = staff_api_client.post_graphql(
+        QUERY_PRODUCT_DIAGNOSTICS,
+        {**base_variables, "first": 2},
+        permissions=[permission_manage_products],
+        check_no_permissions=False,
+    )
+    first_connection = _get_connection(get_graphql_content(first_response))
+
+    second_response = staff_api_client.post_graphql(
+        QUERY_PRODUCT_DIAGNOSTICS,
+        {
+            **base_variables,
+            "first": 2,
+            "after": first_connection["pageInfo"]["endCursor"],
+        },
+        permissions=[permission_manage_products],
+        check_no_permissions=False,
+    )
+    second_connection = _get_connection(get_graphql_content(second_response))
+
+    # then
+    assert first_connection["totalCount"] == 3
+    assert len(first_connection["edges"]) == 2
+    assert first_connection["pageInfo"]["hasNextPage"] is True
+    assert len(second_connection["edges"]) == 1
+    assert second_connection["pageInfo"]["hasNextPage"] is False
+
+    cursors = {edge["cursor"] for edge in first_connection["edges"]} | {
+        edge["cursor"] for edge in second_connection["edges"]
+    }
+    assert len(cursors) == 3
+
