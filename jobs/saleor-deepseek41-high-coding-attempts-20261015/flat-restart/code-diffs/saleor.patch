+from .....core.models import EventDelivery, EventDeliveryAttempt
+from .....webhook.event_types import WebhookEventAsyncType
+from ....tests.utils import get_graphql_content
+
+EVENT_DELIVERY_QUERY = """
+    query webhook($id: ID!, $first: Int){
+      webhook(id: $id){
+        eventDeliveries(first: $first){
+          edges{
+            node{
+              status
+              eventType
+              id
+              attempts(first: $first){
+                edges{
+                  node{
+                    id
+                    status
+                    response
+                    responseStatusCode
+                  }
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+"""
+
+
+def _query_deliveries(staff_api_client, webhook):
+    webhook_id = graphene.Node.to_global_id("Webhook", webhook.pk)
+    response = staff_api_client.post_graphql(
+        EVENT_DELIVERY_QUERY, {"id": webhook_id, "first": 3}
+    )
+    content = get_graphql_content(response)
+    return content["data"]["webhook"]["eventDeliveries"]["edges"]
+
+
+def test_event_delivery_status_enum_has_retrying():
+    # given
+    from ....api import schema
+
+    # when
+    enum_type = schema.get_type("EventDeliveryStatusEnum")
+    values = {value.name: value for value in enum_type.values}
+
+    # then
+    # the existing values are unchanged and RETRYING is added
+    assert set(values) == {"PENDING", "SUCCESS", "FAILED", "RETRYING"}
+    assert values["RETRYING"].description == (
+        "The delivery failed and is scheduled for or undergoing a retry."
+        "\n\nAdded in Saleor 3.23."
+    )
+
+
+def test_event_delivery_retrying_status_is_queryable(
+    event_payload, webhook, staff_api_client, permission_manage_apps
+):
+    # given
+    delivery = EventDelivery.objects.create(
+        event_type=WebhookEventAsyncType.ANY,
+        payload=event_payload,
+        webhook=webhook,
+        status=EventDeliveryStatus.RETRYING,
+    )
+    staff_api_client.user.user_permissions.add(permission_manage_apps)
+
+    # when
+    edges = _query_deliveries(staff_api_client, webhook)
+
+    # then
+    assert len(edges) == 1
+    node = edges[0]["node"]
+    assert node["id"] == graphene.Node.to_global_id("EventDelivery", delivery.pk)
+    assert node["status"] == "RETRYING"
+
+
+def test_event_delivery_failed_status_shows_error_info(
+    event_payload, webhook, staff_api_client, permission_manage_apps
+):
+    # given
+    delivery = EventDelivery.objects.create(
+        event_type=WebhookEventAsyncType.ANY,
+        payload=event_payload,
+        webhook=webhook,
+        status=EventDeliveryStatus.FAILED,
+    )
+    EventDeliveryAttempt.objects.create(
+        delivery=delivery,
+        status=EventDeliveryStatus.FAILED,
+        response="Receiver unavailable",
+        response_status_code=503,
+    )
+    staff_api_client.user.user_permissions.add(permission_manage_apps)
+
+    # when
+    edges = _query_deliveries(staff_api_client, webhook)
+
+    # then
+    node = edges[0]["node"]
+    assert node["status"] == "FAILED"
+    attempt = node["attempts"]["edges"][0]["node"]
+    assert attempt["status"] == "FAILED"
+    assert attempt["response"] == "Receiver unavailable"
+    assert attempt["responseStatusCode"] == 503
+
+
+def test_event_delivery_pending_is_not_shown_as_success(
+    event_payload, webhook, staff_api_client, permission_manage_apps
+):
+    # given
+    # a delivery whose asynchronous payload has not been generated yet
+    EventDelivery.objects.create(
+        event_type=WebhookEventAsyncType.ANY,
+        payload=event_payload,
+        webhook=webhook,
+        status=EventDeliveryStatus.PENDING,
+    )
+    staff_api_client.user.user_permissions.add(permission_manage_apps)
+
+    # when
+    edges = _query_deliveries(staff_api_client, webhook)
+
+    # then
+    assert edges[0]["node"]["status"] == "PENDING"
+
+
+def test_schema_does_not_expose_app_problems():
+    # given
+    from ....api import schema
+
+    graphql_schema = schema
+
+    # when / then
+    # App Problems must not be introduced as part of this release
+    assert graphql_schema.get_type("AppProblem") is None
+    assert graphql_schema.get_type("AppProblemCreate") is None
+    assert graphql_schema.get_type("AppProblemDelete") is None
+
+    query_type = graphql_schema.get_type("Query")
+    mutation_type = graphql_schema.get_type("Mutation")
+    assert not any("problem" in name.lower() for name in query_type.fields)
+    assert not any("problem" in name.lower() for name in mutation_type.fields)
