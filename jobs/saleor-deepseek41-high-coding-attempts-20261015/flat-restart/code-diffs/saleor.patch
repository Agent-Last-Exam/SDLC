+    assert data["deliveryOptions"] is None
+
+    # the previous valid selection is preserved
+    checkout.refresh_from_db()
+    assert checkout.shipping_method_id == shipping_method_id
+    assert checkout.shipping_method_name == shipping_method_name
+
