+from ...plugins.manager import get_plugins_manager
+
+
+def _get_checkout_info(checkout):
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    return checkout_info, lines
+
+
+def test_revalidate_delivery_method_valid(checkout_with_shipping_method):
+    # given
+    checkout = checkout_with_shipping_method
+    checkout_info, lines = _get_checkout_info(checkout)
+
+    assert is_shipping_required(lines)
+
+    # when
+    revalidate_delivery_method(checkout_info, lines, CheckoutErrorCode)
+
+    # then
+    checkout.refresh_from_db()
+    assert checkout.shipping_method_id is not None
+
+
+def test_revalidate_delivery_method_shipping_method_not_set(checkout_with_item):
+    # given
+    checkout = checkout_with_item
+    checkout_info, lines = _get_checkout_info(checkout)
+
+    assert is_shipping_required(lines)
+
+    # when
+    with pytest.raises(ValidationError) as exc:
+        revalidate_delivery_method(checkout_info, lines, CheckoutErrorCode)
+
+    # then
+    error = exc.value.error_dict
+    assert list(error.keys()) == ["shipping_method"]
+    assert error["shipping_method"][0].code == (
+        CheckoutErrorCode.SHIPPING_METHOD_NOT_SET.value
+    )
+
+
