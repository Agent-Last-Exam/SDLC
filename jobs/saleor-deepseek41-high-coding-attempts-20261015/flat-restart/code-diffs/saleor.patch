new file mode 100644
index 0000000000000000000000000000000000000000..5fc4978810ee9accf2469b08044098c151674c83
--- /dev/null
+++ b/saleor/payment/gift_card_payments.py
@@ -0,0 +1,314 @@
+"""Helpers for tracking gift cards as payment transactions.
+
+Gift cards used as a payment method are represented by ``TransactionItem``
+records (with ``gift_card`` set and ``payment_method_type`` equal to
+``gift_card``). This module centralizes the balance and event bookkeeping so the
+authorization/cancel/charge/refund lifecycle stays consistent and idempotent.
+"""
+
+from __future__ import annotations
+
+from decimal import Decimal
+from typing import TYPE_CHECKING, Optional
+from uuid import uuid4
+
+from django.db import transaction as db_transaction
+from django.utils import timezone
+from prices import Money
+
+from ..core.taxes import zero_money
+from ..giftcard import GiftCardEvents
+from ..giftcard.models import GiftCard, GiftCardEvent
+from . import PaymentMethodType, TransactionEventType
+from .error_codes import PaymentErrorCode
+from .models import TransactionEvent, TransactionItem
+
+if TYPE_CHECKING:
+    from ..account.models import User
+    from ..app.models import App
+    from ..checkout.models import Checkout
+    from ..order.models import Order
+
+
+GIFT_CARD_PAYMENT_NAME = "Gift card"
+
+
+def get_order_total_gift_card(order: "Order") -> Money:
+    """Return the effective amount covered by gift card transactions of an order.
+
+    The amount is counted once per transaction (the charged amount when the
+    transaction was charged, otherwise the authorized amount) and is not added
+    on top of regular payments.
+    """
+    total = zero_money(order.currency)
+    transactions = order.payment_transactions.filter(gift_card__isnull=False)
+    for gift_card_transaction in transactions:
+        charged = gift_card_transaction.amount_charged
+        if charged.amount > Decimal(0):
+            total += charged
+        else:
+            total += gift_card_transaction.amount_authorized
+    return total
+
+
+def get_gift_card_balance_event(
+    gift_card: GiftCard,
+    event_type: str,
+    user: Optional["User"],
+    app: Optional["App"],
+    order: Optional["Order"] = None,
+) -> GiftCardEvent:
+    """Create a gift card history event with the current balance snapshot."""
+    balance_data = {
+        "currency": gift_card.currency,
+        "current_balance": gift_card.current_balance_amount,
+        "reserved_balance": gift_card.reserved_balance_amount,
+    }
+    return GiftCardEvent.objects.create(
+        gift_card=gift_card,
+        user=user,
+        app=app,
+        order=order,
+        type=event_type,
+        parameters={"balance": balance_data},
+    )
+
+
+def validate_gift_card_for_payment(
+    gift_card: GiftCard | None, currency: str, amount: Decimal
+) -> None:
+    """Validate that a gift card can cover the given amount.
+
+    Raises ``PaymentErrorCode`` based ``ValidationError`` codes via
+    :class:`PaymentError` when the gift card cannot be used. The gift card
+    balance is not modified.
+    """
+    if (
+        gift_card is None
+        or not gift_card.is_active
+        or (gift_card.expiry_date and gift_card.expiry_date < timezone.now().date())
+    ):
+        raise GiftCardPaymentError(
+            "The gift card cannot be used for this checkout or order.",
+            PaymentErrorCode.GIFT_CARD_NOT_APPLICABLE.value,
+        )
+    if gift_card.currency != currency:
+        raise GiftCardPaymentError(
+            "The gift card currency does not match the currency of the checkout "
+            "or order.",
+            PaymentErrorCode.GIFT_CARD_INVALID.value,
+        )
+    if gift_card.available_balance.amount < amount:
+        raise GiftCardPaymentError(
+            "The gift card balance does not cover the requested amount.",
+            PaymentErrorCode.GIFT_CARD_INSUFFICIENT_BALANCE.value,
+        )
+
+
+class GiftCardPaymentError(Exception):
+    """Raised when a gift card payment cannot be performed."""
+
+    def __init__(self, message: str, code: str):
+        super().__init__(message)
+        self.message = message
+        self.code = code
+
+
+def create_gift_card_transaction(
+    source_object: "Checkout | Order",
+    gift_card: GiftCard,
+    amount: Decimal,
+    user: Optional["User"],
+    app: Optional["App"],
+    idempotency_key: str,
+) -> TransactionItem:
+    """Create a gift card authorization transaction and reserve the balance."""
+    from ..checkout.models import Checkout
+
+    is_checkout = isinstance(source_object, Checkout)
+    with db_transaction.atomic():
+        gift_card = GiftCard.objects.select_for_update().get(pk=gift_card.pk)
+        gift_card.reserved_balance_amount += amount
+        gift_card.save(update_fields=["reserved_balance_amount"])
+
+        transaction = TransactionItem.objects.create(
+            token=uuid4(),
+            use_old_id=True,
+            checkout_id=source_object.pk if is_checkout else None,
+            order_id=None if is_checkout else source_object.pk,
+            currency=source_object.currency,
+            gift_card=gift_card,
+            payment_method_type=PaymentMethodType.GIFT_CARD,
+            payment_method_name=GIFT_CARD_PAYMENT_NAME,
+            idempotency_key=idempotency_key,
+            authorized_value=amount,
+            user=user if user and getattr(user, "is_authenticated", False) else None,
+            app=app,
+            app_identifier=app.identifier if app else None,
+        )
+        TransactionEvent.objects.create(
+            transaction=transaction,
+            type=TransactionEventType.AUTHORIZATION_SUCCESS,
+            amount_value=amount,
+            currency=transaction.currency,
+            include_in_calculations=True,
+            gift_card=gift_card,
+            user=user if user and getattr(user, "is_authenticated", False) else None,
+            app=app,
+            app_identifier=app.identifier if app else None,
+            psp_reference=None,
+        )
+        get_gift_card_balance_event(
+            gift_card, GiftCardEvents.AUTHORIZED, user, app
+        )
+        return transaction
+
+
+def release_gift_card_authorization(
+    transaction: TransactionItem,
+    user: Optional["User"],
+    app: Optional["App"],
+) -> TransactionItem:
+    """Release a gift card authorization and free the reserved balance."""
+    gift_card = transaction.gift_card
+    if gift_card is None:
+        raise GiftCardPaymentError(
+            "The transaction is not a gift card payment.",
+            PaymentErrorCode.GIFT_CARD_NOT_APPLICABLE.value,
+        )
+    amount = transaction.amount_authorized.amount
+    with db_transaction.atomic():
+        gift_card = GiftCard.objects.select_for_update().get(pk=gift_card.pk)
+        gift_card.reserved_balance_amount = max(
+            gift_card.reserved_balance_amount - amount, Decimal(0)
+        )
+        gift_card.save(update_fields=["reserved_balance_amount"])
+
+        # Release the held authorization so the payment status reflects the
+        # cancellation. ``authorized + charged`` stays equal to the original
+        # authorization amount at every step of the lifecycle.
+        transaction.authorized_value = max(
+            transaction.authorized_value - amount, Decimal(0)
+        )
+        transaction.canceled_value = transaction.canceled_value + amount
+        transaction.save(
+            update_fields=["authorized_value", "canceled_value", "modified_at"]
+        )
+
+        TransactionEvent.objects.create(
+            transaction=transaction,
+            type=TransactionEventType.CANCEL_SUCCESS,
+            amount_value=amount,
+            currency=transaction.currency,
+            include_in_calculations=True,
+            gift_card=gift_card,
+            user=user if user and getattr(user, "is_authenticated", False) else None,
+            app=app,
+            app_identifier=app.identifier if app else None,
+            psp_reference=None,
+        )
+        get_gift_card_balance_event(
+            gift_card, GiftCardEvents.AUTHORIZATION_RELEASED, user, app
+        )
+    return transaction
+
+
+def charge_gift_card(
+    transaction: TransactionItem,
+    amount: Decimal,
+    user: Optional["User"],
+    app: Optional["App"],
+) -> TransactionItem:
+    """Charge an authorized gift card transaction."""
+    gift_card = transaction.gift_card
+    if gift_card is None:
+        raise GiftCardPaymentError(
+            "The transaction is not a gift card payment.",
+            PaymentErrorCode.GIFT_CARD_NOT_APPLICABLE.value,
+        )
+    if amount > transaction.amount_authorized.amount:
+        raise GiftCardPaymentError(
+            "The amount exceeds the authorized amount.",
+            PaymentErrorCode.GIFT_CARD_INSUFFICIENT_BALANCE.value,
+        )
+    with db_transaction.atomic():
+        gift_card = GiftCard.objects.select_for_update().get(pk=gift_card.pk)
+        gift_card.current_balance_amount = max(
+            gift_card.current_balance_amount - amount, Decimal(0)
+        )
+        gift_card.reserved_balance_amount = max(
+            gift_card.reserved_balance_amount - amount, Decimal(0)
+        )
+        gift_card.save(
+            update_fields=["current_balance_amount", "reserved_balance_amount"]
+        )
+
+        # Move the amount from the authorized bucket to the charged bucket.
+        transaction.authorized_value = max(
+            transaction.authorized_value - amount, Decimal(0)
+        )
+        transaction.charged_value = transaction.charged_value + amount
+        transaction.save(
+            update_fields=["authorized_value", "charged_value", "modified_at"]
+        )
+
+        TransactionEvent.objects.create(
+            transaction=transaction,
+            type=TransactionEventType.CHARGE_SUCCESS,
+            amount_value=amount,
+            currency=transaction.currency,
+            include_in_calculations=True,
+            gift_card=gift_card,
+            user=user if user and getattr(user, "is_authenticated", False) else None,
+            app=app,
+            app_identifier=app.identifier if app else None,
+            psp_reference=None,
+        )
+    return transaction
+
+
+def refund_gift_card(
+    transaction: TransactionItem,
+    amount: Decimal,
+    user: Optional["User"],
+    app: Optional["App"],
+) -> TransactionItem:
+    """Refund a charged gift card transaction within the refundable balance."""
+    gift_card = transaction.gift_card
+    if gift_card is None:
+        raise GiftCardPaymentError(
+            "The transaction is not a gift card payment.",
+            PaymentErrorCode.GIFT_CARD_NOT_APPLICABLE.value,
+        )
+    refundable = transaction.amount_charged.amount - transaction.amount_refunded.amount
+    if amount > refundable:
+        raise GiftCardPaymentError(
+            "The refund amount exceeds the refundable amount.",
+            PaymentErrorCode.GIFT_CARD_INSUFFICIENT_BALANCE.value,
+        )
+    with db_transaction.atomic():
+        gift_card = GiftCard.objects.select_for_update().get(pk=gift_card.pk)
+        gift_card.current_balance_amount += amount
+        gift_card.save(update_fields=["current_balance_amount"])
+
+        # The charged amount stays intact so the refundable balance is
+        # ``charged - refunded``; only the refunded bucket grows.
+        transaction.refunded_value = transaction.refunded_value + amount
+        transaction.save(update_fields=["refunded_value", "modified_at"])
+
+        TransactionEvent.objects.create(
+            transaction=transaction,
+            type=TransactionEventType.REFUND_SUCCESS,
+            amount_value=amount,
+            currency=transaction.currency,
+            include_in_calculations=True,
+            gift_card=gift_card,
+            user=user if user and getattr(user, "is_authenticated", False) else None,
+            app=app,
+            app_identifier=app.identifier if app else None,
+            psp_reference=None,
+        )
+        get_gift_card_balance_event(
+            gift_card, GiftCardEvents.REFUNDED, user, app
+        )
+    return transaction
