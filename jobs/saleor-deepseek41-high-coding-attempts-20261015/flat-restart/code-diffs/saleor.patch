+from ....core import ResolveInfo
+from ....core.descriptions import ADDED_IN_323
+from ....core.context import SyncWebhookControlContext
+from ....core.doc_category import DOC_CATEGORY_PAYMENTS
+from ....core.mutations import BaseMutation
+from ....core.types import BaseInputObjectType
+from ....core.types import common as common_types
+from ....core.utils import WebhookEventInfo
+from ....plugins.dataloaders import get_plugin_manager_promise
+from ...types import TransactionItem as TransactionItemType
+
+
+class CheckoutGiftCardPaymentCreateInput(BaseInputObjectType):
+    gift_card_code = graphene.String(
+        description="The code of the gift card used to pay the checkout.",
+        required=True,
+    )
+
+    class Meta:
+        description = (
+            "Input data required to pay a checkout with a gift card." + ADDED_IN_323
+        )
+        doc_category = DOC_CATEGORY_PAYMENTS
+
+
+class CheckoutGiftCardPaymentCreate(BaseMutation):
+    checkout = graphene.Field(
+        Checkout, description="The checkout the payment was created for."
+    )
+    transaction = graphene.Field(
+        TransactionItemType, description="The created transaction."
+    )
+
+    class Arguments:
+        id = graphene.ID(
+            description="The ID of the checkout.",
+            required=True,
+        )
+        input = CheckoutGiftCardPaymentCreateInput(
+            required=True,
+            description="Input data required to pay the checkout with a gift card.",
+        )
+        idempotency_key = graphene.String(
+            description=(
+                "Idempotency key. Repeated requests carrying the same key do not "
+                "create a second authorization or a second balance change."
+            ),
+            required=False,
+        )
+
+    class Meta:
+        description = (
+            "Pays a checkout with a gift card. Creates a gift card backed "
+            "transaction and reserves the corresponding balance. Repeated requests "
+            "with the same idempotency key produce a single authorization."
+            + message_one_of_permissions_required(
+                [PaymentPermissions.HANDLE_PAYMENTS]
+            )
+            + ADDED_IN_323
+        )
+        doc_category = DOC_CATEGORY_PAYMENTS
+        error_type_class = common_types.PaymentError
+        permissions = (PaymentPermissions.HANDLE_PAYMENTS,)
+        auto_permission_message = False
+        auto_webhook_events_message = False
+        webhook_events_info = [
+            WebhookEventInfo(
+                type=WebhookEventSyncType.TRANSACTION_CHARGE_REQUESTED,
+                description="A transaction charge was requested.",
+            )
+        ]
+
+    @classmethod
+    def get_gift_card(cls, gift_card_code: str) -> GiftCard | None:
+        return GiftCard.objects.filter(code=gift_card_code).first()
+
+    @classmethod
+    def perform_mutation(  # type: ignore[override]
+        cls,
+        _root,
+        info: ResolveInfo,
+        /,
+        *,
+        id: str,
+        input: dict,
+        idempotency_key: str | None = None,
+    ):
+        checkout = get_checkout(cls, info, id=id)
+
+        gift_card_code = input["gift_card_code"]
+        gift_card = cls.get_gift_card(gift_card_code)
+
+        manager = get_plugin_manager_promise(info.context).get()
+        lines, _ = fetch_checkout_lines(checkout)
+        checkout_info = fetch_checkout_info(checkout, lines, manager)
+        address = checkout.shipping_address or checkout.billing_address
+        checkout_total = calculate_checkout_total_with_gift_cards(
+            manager=manager,
+            checkout_info=checkout_info,
+            lines=lines,
+            address=address,
+        )
+        amount = quantize_price(checkout_total.gross.amount, checkout.currency)
+
+        app = get_app_promise(info.context).get()
+        user = info.context.user
+        app_identifier = app.identifier if app else None
+
+        # Idempotency handling must happen before balance validation, because a
+        # repeated request has already reserved the gift card balance.
+        key = idempotency_key or str(uuid4())
+        existing = TransactionItem.objects.filter(
+            idempotency_key=key, app_identifier=app_identifier
+        ).first()
+        if existing is not None:
+            same_payload = (
+                existing.checkout_id == checkout.pk
+                and existing.gift_card_id == (gift_card.pk if gift_card else None)
+                and existing.amount_authorized.amount == amount
+            )
+            if not same_payload:
+                raise ValidationError(
+                    {
+                        "idempotencyKey": ValidationError(
+                            "The idempotency key was already used with a different "
+                            "payload.",
+                            code=PaymentErrorCode.IDEMPOTENCY_KEY_REUSED.value,
+                        )
+                    }
+                )
+            return CheckoutGiftCardPaymentCreate(
+                checkout=SyncWebhookControlContext(node=checkout),
+                transaction=existing,
+            )
+
+        try:
+            validate_gift_card_for_payment(gift_card, checkout.currency, amount)
+        except GiftCardPaymentError as e:
+            raise ValidationError(
+                {"giftCardCode": ValidationError(e.message, code=e.code)}
+            ) from e
+
+        # Subtract amounts already covered by other gift card transactions so a
+        # second gift card only covers the outstanding part.
+        already_covered = Decimal(0)
+        other_transactions = TransactionItem.objects.filter(
+            checkout=checkout, gift_card__isnull=False
+        ).exclude(gift_card=gift_card)
+        for transaction in other_transactions:
+            already_covered += max(
+                transaction.amount_charged.amount,
+                transaction.amount_authorized.amount,
+            )
+        amount = max(amount - already_covered, Decimal(0))
+
+        transaction = create_gift_card_transaction(
+            source_object=checkout,
+            gift_card=gift_card,
+            amount=amount,
+            user=user,
+            app=app,
+            idempotency_key=key,
+        )
+
+        update_checkout_payment_statuses(
+            checkout,
+            checkout_total.gross,
+            checkout_has_lines=bool(lines),
+        )
+
+        return CheckoutGiftCardPaymentCreate(
+            checkout=SyncWebhookControlContext(node=checkout),
+            transaction=transaction,
+        )
