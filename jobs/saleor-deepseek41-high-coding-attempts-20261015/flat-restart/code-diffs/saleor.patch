+def resolve_transactions(info, where=None):
+    connection_name = get_database_connection_name(info.context)
+    requestor = get_user_or_app_from_context(info.context)
+    qs = models.TransactionItem.objects.using(connection_name).all()
+
+    if where:
+        if ids := where.get("ids"):
+            tokens = []
+            for global_id in ids:
+                _, token = from_global_id_or_error(
+                    global_id, only_type="TransactionItem", raise_error=True
+                )
+                tokens.append(token)
+            qs = qs.filter(token__in=tokens)
+        if order_id := where.get("order_id"):
+            _, pk = from_global_id_or_error(
+                order_id, only_type="Order", raise_error=True
+            )
+            qs = qs.filter(order_id=pk)
+        if checkout_id := where.get("checkout_id"):
+            _, pk = from_global_id_or_error(
+                checkout_id, only_type="Checkout", raise_error=True
+            )
+            qs = qs.filter(checkout_id=pk)
+        if psp_reference := where.get("psp_reference"):
+            qs = qs.filter(psp_reference=psp_reference)
+        if app_id := where.get("app_id"):
+            _, pk = from_global_id_or_error(app_id, only_type="App", raise_error=True)
+            qs = qs.filter(app_id=pk)
+        if metadata := where.get("metadata"):
+            qs = filter_where_metadata(qs, None, metadata)
+
+    # Apps may only see the transactions they created.
+    if isinstance(requestor, app_models.App):
+        qs = qs.filter(app_identifier=requestor.identifier)
+
+    return qs
