+import graphene
+import pytest
+
+from .....app.models import AppExtension
+from .....app.types import AppExtensionMount, AppExtensionTarget
+from ....tests.utils import get_graphql_content
+
+QUERY_APP_EXTENSION = """
+query ($id: ID!) {
+  appExtension(id: $id) {
+    mount
+    target
+    mountName
+    targetName
+    settings
+    options {
+      ... on AppExtensionOptionsWidget {
+        widgetTarget {
+          method
+        }
+      }
+      ... on AppExtensionOptionsNewTab {
+        newTabTarget {
+          method
+        }
+      }
+    }
+  }
+}
+"""
+
+
+def _query_extension(api_client, extension):
+    extension_id = graphene.Node.to_global_id("AppExtension", extension.id)
+    response = api_client.post_graphql(QUERY_APP_EXTENSION, {"id": extension_id})
+    return get_graphql_content(response)["data"]["appExtension"]
+
+
+def test_app_extension_widget_new_fields(app, staff_api_client):
+    # given
+    extension = AppExtension.objects.create(
+        app=app,
+        label="Widget extension",
+        url="https://www.example.com/app-widget",
+        mount=AppExtensionMount.PRODUCT_DETAILS_WIDGETS,
+        target=AppExtensionTarget.WIDGET,
+        http_target_method="POST",
+    )
+
+    # when
+    data = _query_extension(staff_api_client, extension)
+
+    # then
+    # new fields reflect the stored extension data
+    assert data["mountName"] == "PRODUCT_DETAILS_WIDGETS"
+    assert data["targetName"] == "WIDGET"
+    assert data["settings"] == {"widgetTarget": {"method": "POST"}}
+    # deprecated fields remain readable
+    assert data["mount"] == "PRODUCT_DETAILS_WIDGETS"
+    assert data["target"] == "WIDGET"
+    assert data["options"]["widgetTarget"]["method"] == "POST"
+
+
+def test_app_extension_new_tab_new_fields(app, staff_api_client):
+    # given
+    extension = AppExtension.objects.create(
+        app=app,
+        label="New tab extension",
+        url="https://www.example.com/app-new-tab",
+        mount=AppExtensionMount.PRODUCT_OVERVIEW_CREATE,
+        target=AppExtensionTarget.NEW_TAB,
+        http_target_method="GET",
+    )
+
+    # when
+    data = _query_extension(staff_api_client, extension)
+
+    # then
+    assert data["mountName"] == "PRODUCT_OVERVIEW_CREATE"
+    assert data["targetName"] == "NEW_TAB"
+    assert data["settings"] == {"newTabTarget": {"method": "GET"}}
+
+
+def test_app_extension_popup_settings_empty(app, staff_api_client):
+    # given
+    # historical extension with no settings (e.g. POPUP target)
+    extension = AppExtension.objects.create(
+        app=app,
+        label="Popup extension",
+        url="https://www.example.com/app-popup",
+        mount=AppExtensionMount.PRODUCT_OVERVIEW_MORE_ACTIONS,
+        target=AppExtensionTarget.POPUP,
+    )
+
+    # when
+    data = _query_extension(staff_api_client, extension)
+
+    # then
+    # settings is a JSON object, never null; empty when there is nothing to expose
+    assert data["settings"] == {}
+    assert data["mountName"] == "PRODUCT_OVERVIEW_MORE_ACTIONS"
+    assert data["targetName"] == "POPUP"
+
+
+def test_app_extension_historical_extension_still_renderable(
+    app, staff_api_client, permission_manage_products
+):
+    # given
+    # a historical extension created before the new fields existed
+    extension = AppExtension.objects.create(
+        app=app,
+        label="Historical extension",
+        url="https://www.example.com/app-historical",
+        mount=AppExtensionMount.PRODUCT_DETAILS_WIDGETS,
+        target=AppExtensionTarget.WIDGET,
+        http_target_method="POST",
+    )
+    extension.permissions.add(permission_manage_products)
+
+    # when
+    data = _query_extension(staff_api_client, extension)
+
+    # then
+    # settings preserved from the stored HTTP target method (equivalent to old options)
+    assert data["settings"] == {"widgetTarget": {"method": "POST"}}
+
+    # and the extension is still editable
+    extension.label = "Historical extension renamed"
+    extension.save(update_fields=["label"])
+    data = _query_extension(staff_api_client, extension)
+    assert data["settings"] == {"widgetTarget": {"method": "POST"}}
+
+
+def test_app_extension_deprecated_fields_reasons():
+    # given
+    from ....api import schema
+
+    graphql_schema = schema
+
+    # when / then
+    app_extension = graphql_schema.get_type("AppExtension")
+    assert (
+        app_extension.fields["mount"].deprecation_reason == "Use `mountName` instead."
+    )
+    assert (
+        app_extension.fields["target"].deprecation_reason == "Use `targetName` instead."
+    )
+    assert (
+        app_extension.fields["options"].deprecation_reason
+        == "Use `settings` field instead."
+    )
+
+    manifest_extension = graphql_schema.get_type("AppManifestExtension")
+    assert (
+        manifest_extension.fields["mount"].deprecation_reason
+        == "Use `mountName` instead."
+    )
+    assert (
+        manifest_extension.fields["target"].deprecation_reason
+        == "Use `targetName` instead."
+    )
