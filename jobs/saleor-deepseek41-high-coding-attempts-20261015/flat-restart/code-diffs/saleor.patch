+++ b/saleor/graphql/payment/tests/queries/test_transactions.py
@@ -0,0 +1,339 @@
+from decimal import Decimal
+
+import graphene
+import pytest
+
+from .....payment.models import TransactionItem
+from ....core.utils import to_global_id_or_none
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+TRANSACTIONS_QUERY = """
+query Transactions($where: TransactionWhereInput, $first: Int = 100, $after: String) {
+  transactions(where: $where, first: $first, after: $after) {
+    totalCount
+    pageInfo { hasNextPage endCursor }
+    edges {
+      node {
+        id
+        pspReference
+        order { id }
+        checkout { id }
+        authorizedAmount { amount currency }
+        paymentMethodDetails { __typename }
+      }
+    }
+  }
+}
+"""
+
+
+def _create_transaction(**kwargs):
+    defaults = {
+        "name": "Credit card",
+        "currency": "USD",
+        "authorized_value": Decimal(10),
+    }
+    defaults.update(kwargs)
+    return TransactionItem.objects.create(**defaults)
+
+
+def test_transactions_query_by_order(
+    staff_api_client, order_with_lines, permission_manage_payments
+):
+    # given
+    order = order_with_lines
+    transactions = [
+        _create_transaction(order_id=order.pk, psp_reference=f"psp-{i}")
+        for i in range(3)
+    ]
+    variables = {
+        "where": {"orderId": to_global_id_or_none(order)},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        TRANSACTIONS_QUERY,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["transactions"]
+    returned_ids = {edge["node"]["id"] for edge in data["edges"]}
+    expected_ids = {
+        graphene.Node.to_global_id("TransactionItem", t.token) for t in transactions
+    }
+    assert returned_ids == expected_ids
+    assert data["totalCount"] == 3
+
+
+def test_transactions_query_by_checkout(
+    staff_api_client, checkout_with_item, permission_manage_payments
+):
+    # given
+    checkout = checkout_with_item
+    transactions = [
+        _create_transaction(checkout_id=checkout.pk, psp_reference=f"c-psp-{i}")
+        for i in range(2)
+    ]
+    variables = {
+        "where": {"checkoutId": to_global_id_or_none(checkout)},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        TRANSACTIONS_QUERY,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["transactions"]
+    returned_ids = {edge["node"]["id"] for edge in data["edges"]}
+    expected_ids = {
+        graphene.Node.to_global_id("TransactionItem", t.token) for t in transactions
+    }
+    assert returned_ids == expected_ids
+    assert data["totalCount"] == 2
+
+
+def test_transactions_query_by_ids(
+    staff_api_client, order_with_lines, permission_manage_payments
+):
+    # given
+    order = order_with_lines
+    transaction = _create_transaction(order_id=order.pk, psp_reference="by-id")
+    _create_transaction(order_id=order.pk, psp_reference="other")
+    variables = {
+        "where": {
+            "ids": [graphene.Node.to_global_id("TransactionItem", transaction.token)]
+        },
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        TRANSACTIONS_QUERY,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["transactions"]
+    assert data["totalCount"] == 1
+    assert data["edges"][0]["node"]["pspReference"] == "by-id"
+
+
+def test_transactions_query_by_psp_reference(
+    staff_api_client, order_with_lines, permission_manage_payments
+):
+    # given
+    order = order_with_lines
+    _create_transaction(order_id=order.pk, psp_reference="target-psp")
+    _create_transaction(order_id=order.pk, psp_reference="other-psp")
+    variables = {"where": {"pspReference": "target-psp"}}
+
+    # when
+    response = staff_api_client.post_graphql(
+        TRANSACTIONS_QUERY,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["transactions"]
+    assert data["totalCount"] == 1
+    assert data["edges"][0]["node"]["pspReference"] == "target-psp"
+
+
+def test_transactions_query_by_app_id(
+    staff_api_client,
+    order_with_lines,
+    permission_manage_payments,
+    app,
+):
+    # given
+    order = order_with_lines
+    _create_transaction(
+        order_id=order.pk, app=app, app_identifier=app.identifier, psp_reference="a"
+    )
+    _create_transaction(order_id=order.pk, psp_reference="b")
+    variables = {"where": {"appId": to_global_id_or_none(app)}}
+
+    # when
+    response = staff_api_client.post_graphql(
+        TRANSACTIONS_QUERY,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["transactions"]
+    assert data["totalCount"] == 1
+    assert data["edges"][0]["node"]["pspReference"] == "a"
+
+
+def test_transactions_query_pagination_stable(
+    staff_api_client, order_with_lines, permission_manage_payments
+):
+    # given
+    order = order_with_lines
+    for i in range(5):
+        _create_transaction(order_id=order.pk, psp_reference=f"page-{i}")
+    where = {"orderId": to_global_id_or_none(order)}
+
+    def _run(first, after=None):
+        variables = {"where": where, "first": first}
+        if after:
+            variables["after"] = after
+        response = staff_api_client.post_graphql(
+            TRANSACTIONS_QUERY,
+            variables,
+            permissions=[permission_manage_payments],
+            check_no_permissions=False,
+        )
+        return get_graphql_content(response)["data"]["transactions"]
+
+    # when
+    page_1 = _run(2)
+    page_2 = _run(2, page_1["pageInfo"]["endCursor"])
+    page_3 = _run(2, page_2["pageInfo"]["endCursor"])
+
+    # then
+    all_ids = [
+        edge["node"]["id"]
+        for page in (page_1, page_2, page_3)
+        for edge in page["edges"]
+    ]
+    assert len(all_ids) == 5
+    assert len(set(all_ids)) == 5
+    assert page_1["totalCount"] == 5
+
+    # repeated query yields the same result set and order
+    page_1_again = _run(2)
+    assert [e["node"]["id"] for e in page_1_again["edges"]] == [
+        e["node"]["id"] for e in page_1["edges"]
+    ]
+
+
+def test_transactions_query_empty_result(
+    staff_api_client, order_with_lines, permission_manage_payments
+):
+    # given
+    variables = {"where": {"pspReference": "does-not-exist"}}
+
+    # when
+    response = staff_api_client.post_graphql(
+        TRANSACTIONS_QUERY,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["transactions"]
+    assert data["edges"] == []
+    assert data["totalCount"] == 0
+    assert data["pageInfo"]["hasNextPage"] is False
+
+
+def test_transactions_query_no_permission(api_client, order_with_lines):
+    # given
+    variables = {"where": {"orderId": to_global_id_or_none(order_with_lines)}}
+
+    # when
+    response = api_client.post_graphql(TRANSACTIONS_QUERY, variables, permissions=[])
+
+    # then
+    assert_no_permission(response)
+
+
+def test_transactions_query_app_scoped_to_own_transactions(
+    app_api_client,
+    order_with_lines,
+    permission_manage_payments,
+    app,
+):
+    # given
+    from .....app.models import App
+
+    other_app = App.objects.create(
+        name="Other app",
+        is_active=True,
+        identifier="saleor.app.other",
+        manifest_url="http://localhost:3001/manifest",
+    )
+    order = order_with_lines
+    own = _create_transaction(
+        order_id=order.pk,
+        app=app,
+        app_identifier=app.identifier,
+        psp_reference="own",
+    )
+    _create_transaction(
+        order_id=order.pk,
+        app=other_app,
+        app_identifier=other_app.identifier,
+        psp_reference="foreign",
+    )
+    variables = {}
+
+    # when
+    response = app_api_client.post_graphql(
+        TRANSACTIONS_QUERY,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["transactions"]
+    returned_ids = {edge["node"]["id"] for edge in data["edges"]}
+    assert returned_ids == {
+        graphene.Node.to_global_id("TransactionItem", own.token)
+    }
+
+
+def test_transactions_query_invalid_where_field_returns_error(
+    staff_api_client, permission_manage_payments
+):
+    # given - date based filtering is intentionally not supported
+    query = """
+    query {
+      transactions(where: {createdAt: "2020-01-01"}) {
+        totalCount
+      }
+    }
+    """
+
+    # when
+    response = staff_api_client.post_graphql(
+        query, permissions=[permission_manage_payments], check_no_permissions=False
+    )
+
+    # then
+    content = get_graphql_content(response, ignore_errors=True)
+    assert "errors" in content
+    assert content.get("data", {}).get("transactions") is None
+
+
+def test_transactions_query_invalid_id_returns_error(
+    staff_api_client, permission_manage_payments
+):
+    # given
+    variables = {"where": {"orderId": "not-a-valid-id"}}
+
+    # when
+    response = staff_api_client.post_graphql(
+        TRANSACTIONS_QUERY,
+        variables,
+        permissions=[permission_manage_payments],
+    )
+
+    # then
+    content = get_graphql_content(response, ignore_errors=True)
+    assert "errors" in content
