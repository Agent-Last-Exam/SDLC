@@ -0,0 +1,77 @@
+from unittest import mock
+
+from ...tests.utils import get_graphql_content
+
+QUERY_PRODUCTS_SEARCH = """
+query Products($search: String, $channel: String, $first: Int) {
+  products(search: $search, channel: $channel, first: $first) {
+    totalCount
+    edges {
+      node {
+        slug
+      }
+    }
+  }
+}
+"""
+
+
+def _products(api_client, channel_USD, search):
+    response = api_client.post_graphql(
+        QUERY_PRODUCTS_SEARCH,
+        {"search": search, "channel": channel_USD.slug, "first": 10},
+    )
+    content = get_graphql_content(response)
+    return content["data"]["products"]
+
+
+def test_products_search_blank_keyword_returns_all_without_error(
+    api_client, product_list, channel_USD
+):
+    # given / when
+    data = _products(api_client, channel_USD, "   ")
+
+    # then
+    assert data["totalCount"] == len(product_list)
+    assert len(data["edges"]) == len(product_list)
+
+
+def test_products_search_overlong_keyword_returns_explicit_empty_state(
+    api_client, product_list, channel_USD
+):
+    # given / when
+    data = _products(api_client, channel_USD, "a" * 256)
+
+    # then
+    assert data["totalCount"] == 0
+    assert data["edges"] == []
+
+
+def test_products_search_keeps_full_text_semantics(
+    api_client, product_list, channel_USD
+):
+    # given / when
+    data = _products(api_client, channel_USD, "blue")
+
+    # then
+    assert data["totalCount"] == 1
+    assert data["edges"][0]["node"]["slug"] == "test-product-a"
+
+
+def test_products_search_backend_failure_returns_error_not_empty_result(
+    api_client, product_list, channel_USD
+):
+    # given / when
+    with mock.patch(
+        "saleor.graphql.product.schema.search_products",
+        side_effect=Exception("search backend unavailable"),
+    ):
+        response = api_client.post_graphql(
+            QUERY_PRODUCTS_SEARCH,
+            {"search": "blue", "channel": channel_USD.slug, "first": 10},
+        )
+
+    # then - a failing search service must not be reported as an empty success
+    content = get_graphql_content(response, ignore_errors=True)
+    assert content["errors"]
+    assert content["data"]["products"] is None
