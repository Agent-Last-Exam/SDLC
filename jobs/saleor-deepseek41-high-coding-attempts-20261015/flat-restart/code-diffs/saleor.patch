diff --git a/saleor/product/tests/test_search_hardening.py b/saleor/product/tests/test_search_hardening.py
new file mode 100644
index 0000000000000000000000000000000000000000..bd8fcfd79331e5e254851bb21e756363345295cb
--- /dev/null
+++ b/saleor/product/tests/test_search_hardening.py
@@ -0,0 +1,138 @@
+"""Unit tests for the search keyword hardening (R12 / R13).
+
+These tests pin down the explainability rules applied to every search entry
+point:
+
+* an empty or whitespace-only keyword must short circuit instead of running an
+  uncontrolled query over the whole table (AC-13-4),
+* an over-long keyword must produce an explicit empty state without failing the
+  surrounding list (AC-13-5),
+* a non-empty keyword must keep the pre-existing search semantics (R12).
+"""
+
+from ...account.models import User
+from ...account.search import MAX_SEARCH_KEYWORD_LENGTH as ACCOUNT_MAX
+from ...account.search import search_users
+from ...giftcard.search import MAX_SEARCH_KEYWORD_LENGTH as GIFTCARD_MAX
+from ...giftcard.search import search_gift_cards
+from ...graphql.checkout.filters import MAX_SEARCH_KEYWORD_LENGTH as CHECKOUT_MAX
+from ...graphql.checkout.filters import filter_checkout_search
+from ...order.search import MAX_SEARCH_KEYWORD_LENGTH as ORDER_MAX
+from ...order.search import search_orders
+from ..models import Product
+from ..search import MAX_SEARCH_KEYWORD_LENGTH as PRODUCT_MAX
+from ..search import search_products, update_products_search_vector
+
+OVERLONG = "a" * 256
+
+
+def test_all_search_modules_share_the_same_keyword_bound():
+    assert {
+        PRODUCT_MAX,
+        ORDER_MAX,
+        ACCOUNT_MAX,
+        GIFTCARD_MAX,
+        CHECKOUT_MAX,
+    } == {255}
+    assert len(OVERLONG) > PRODUCT_MAX
+
+
+# --- products ---------------------------------------------------------------
+
+
+def test_search_products_blank_keyword_is_short_circuited(product_list):
+    qs = Product.objects.all()
+    # The very same queryset is returned, so no filtering query is built.
+    assert search_products(qs, "") is qs
+    assert search_products(qs, "   ") is qs
+
+
+def test_search_products_overlong_keyword_returns_empty_state(product_list):
+    qs = Product.objects.all()
+    assert qs.exists()
+    assert search_products(qs, OVERLONG).count() == 0
+
+
+def test_search_products_keeps_full_text_search(product_list):
+    # given
+    update_products_search_vector(Product.objects.values_list("id", flat=True))
+
+    # when
+    result = search_products(Product.objects.all(), "blue")
+
+    # then
+    assert result.count() == 1
+    assert result.first().slug == "test-product-a"
+
+
+# --- orders -----------------------------------------------------------------
+
+
+def test_search_orders_blank_keyword_is_short_circuited(order):
+    from ...order.models import Order
+
+    qs = Order.objects.all()
+    assert search_orders(qs, "") is qs
+    assert search_orders(qs, "  ") is qs
+
+
+def test_search_orders_overlong_keyword_returns_empty_state(order):
+    from ...order.models import Order
+
+    qs = Order.objects.all()
+    assert qs.exists()
+    assert search_orders(qs, OVERLONG).count() == 0
+
+
+# --- users ------------------------------------------------------------------
+
+
+def test_search_users_blank_keyword_is_short_circuited(customer_user):
+    qs = User.objects.all()
+    # A whitespace-only value used to build an empty lookup and return every row.
+    assert search_users(qs, "") is qs
+    assert search_users(qs, "   ") is qs
+
+
+def test_search_users_overlong_keyword_returns_empty_state(customer_user):
+    qs = User.objects.all()
+    assert qs.exists()
+    assert search_users(qs, OVERLONG).count() == 0
+
+
+# --- gift cards -------------------------------------------------------------
+
+
+def test_search_gift_cards_blank_keyword_is_short_circuited(gift_card):
+    from ...giftcard.models import GiftCard
+
+    qs = GiftCard.objects.all()
+    assert search_gift_cards(qs, "") is qs
+    assert search_gift_cards(qs, "   ") is qs
+
+
+def test_search_gift_cards_overlong_keyword_returns_empty_state(gift_card):
+    from ...giftcard.models import GiftCard
+
+    qs = GiftCard.objects.all()
+    assert qs.exists()
+    assert search_gift_cards(qs, OVERLONG).count() == 0
+
+
+# --- checkouts --------------------------------------------------------------
+
+
+def test_checkout_search_blank_keyword_is_short_circuited(checkout):
+    from ...checkout.models import Checkout
+
+    qs = Checkout.objects.all()
+    assert filter_checkout_search(qs, None, "") is qs
+    assert filter_checkout_search(qs, None, "   ") is qs
+
+
+def test_checkout_search_overlong_keyword_returns_empty_state(checkout):
+    from ...checkout.models import Checkout
+
+    qs = Checkout.objects.all()
+    assert qs.exists()
+    assert filter_checkout_search(qs, None, OVERLONG).count() == 0
diff --git a/saleor/product/utils/diagnostics.py b/saleor/product/utils/diagnostics.py
new file mode 100644
index 0000000000000000000000000000000000000000..863e1220b9642866e0d3cf6cbefbf5ed1aff1eda
--- /dev/null
+++ b/saleor/product/utils/diagnostics.py
@@ -0,0 +1,398 @@
+"""Product channel availability diagnostics (R04 / BD04).
+
+Computes, per channel, the facts that decide whether a product can be sold.
+Each finding is classified as a blocker, a warning or a not-applicable check so
+that checks which are a natural consequence of another blocker do not drown out
+the real problem.
+
+The algorithm is intentionally side effect free and never cached: every call
+recomputes the diagnostics from the current server side facts.
+"""
+
+import logging
+from dataclasses import dataclass, field
+from enum import Enum
+
+from django.utils import timezone
+
+from ...shipping.models import ShippingZone
+from ...warehouse.models import Stock, Warehouse
+from ..models import Product, ProductVariantChannelListing
+
+logger = logging.getLogger(__name__)
+
+
+class ProductChannelAvailabilityProblemSeverity(str, Enum):
+    """Severity of a product channel availability diagnostic."""
+
+    BLOCKER = "BLOCKER"
+    WARNING = "WARNING"
+    NOT_APPLICABLE = "NOT_APPLICABLE"
+
+
+class ProductChannelAvailabilityProblemType(str, Enum):
+    """Type of a product channel availability diagnostic."""
+
+    NOT_PUBLISHED = "NOT_PUBLISHED"
+    NOT_AVAILABLE_FOR_PURCHASE = "NOT_AVAILABLE_FOR_PURCHASE"
+    NOT_VISIBLE_IN_LISTINGS = "NOT_VISIBLE_IN_LISTINGS"
+    NO_STOCK = "NO_STOCK"
+    NO_WAREHOUSE_ASSIGNED = "NO_WAREHOUSE_ASSIGNED"
+    NO_SHIPPING_ZONE = "NO_SHIPPING_ZONE"
+    NO_VARIANTS = "NO_VARIANTS"
+    SHIPPING_NOT_APPLICABLE = "SHIPPING_NOT_APPLICABLE"
+    PRODUCT_TYPE_CONFIGURATION = "PRODUCT_TYPE_CONFIGURATION"
+    DIAGNOSTICS_UNAVAILABLE = "DIAGNOSTICS_UNAVAILABLE"
+
+
+PROBLEM_MESSAGES = {
+    ProductChannelAvailabilityProblemType.NOT_PUBLISHED: (
+        "The product is not published in the channel."
+    ),
+    ProductChannelAvailabilityProblemType.NOT_AVAILABLE_FOR_PURCHASE: (
+        "The product is not available for purchase in the channel."
+    ),
+    ProductChannelAvailabilityProblemType.NOT_VISIBLE_IN_LISTINGS: (
+        "The product is not visible in listings of the channel."
+    ),
+    ProductChannelAvailabilityProblemType.NO_STOCK: (
+        "No variant of the product has sellable stock in the channel."
+    ),
+    ProductChannelAvailabilityProblemType.NO_WAREHOUSE_ASSIGNED: (
+        "No warehouse able to serve the channel is assigned."
+    ),
+    ProductChannelAvailabilityProblemType.NO_SHIPPING_ZONE: (
+        "The channel has no shipping zone covering the delivery context."
+    ),
+    ProductChannelAvailabilityProblemType.NO_VARIANTS: (
+        "The product has no variants."
+    ),
+    ProductChannelAvailabilityProblemType.SHIPPING_NOT_APPLICABLE: (
+        "Shipping related checks were skipped because the product is not shippable."
+    ),
+    ProductChannelAvailabilityProblemType.PRODUCT_TYPE_CONFIGURATION: (
+        "Product type configuration does not allow selling in the channel."
+    ),
+    ProductChannelAvailabilityProblemType.DIAGNOSTICS_UNAVAILABLE: (
+        "Diagnostics could not be computed for the channel."
+    ),
+}
+
+
+@dataclass
+class ProductChannelAvailabilityProblem:
+    type: ProductChannelAvailabilityProblemType
+    severity: ProductChannelAvailabilityProblemSeverity
+    message: str
+    field: str | None = None
+    variant_id: int | None = None
+
+
+@dataclass
+class ProductChannelDiagnostics:
+    """Diagnostics of product availability in a single channel."""
+
+    channel: "Channel"  # noqa: F821 - forward reference to channel model
+    problems: list[ProductChannelAvailabilityProblem] = field(default_factory=list)
+
+    @property
+    def problems_count(self) -> int:
+        return sum(
+            1
+            for problem in self.problems
+            if problem.severity
+            == ProductChannelAvailabilityProblemSeverity.BLOCKER
+        )
+
+    @property
+    def warnings_count(self) -> int:
+        return sum(
+            1
+            for problem in self.problems
+            if problem.severity
+            == ProductChannelAvailabilityProblemSeverity.WARNING
+        )
+
+    @property
+    def not_applicable_count(self) -> int:
+        return sum(
+            1
+            for problem in self.problems
+            if problem.severity
+            == ProductChannelAvailabilityProblemSeverity.NOT_APPLICABLE
+        )
+
+
+def _problem(
+    problem_type: ProductChannelAvailabilityProblemType,
+    severity: ProductChannelAvailabilityProblemSeverity,
+    *,
+    field_name: str | None = None,
+    variant_id: int | None = None,
+) -> ProductChannelAvailabilityProblem:
+    return ProductChannelAvailabilityProblem(
+        type=problem_type,
+        severity=severity,
+        message=PROBLEM_MESSAGES[problem_type],
+        field=field_name,
+        variant_id=variant_id,
+    )
+
+
+def _total_available_quantity(
+    variant_ids: list[int],
+    warehouse_ids: list[int],
+    database_connection_name: str,
+) -> int:
+    if not variant_ids or not warehouse_ids:
+        return 0
+    stocks = (
+        Stock.objects.using(database_connection_name)
+        .filter(
+            product_variant_id__in=variant_ids,
+            warehouse_id__in=warehouse_ids,
+        )
+        .annotate_available_quantity()
+    )
+    return sum(stock.available_quantity for stock in stocks)
+
+
+def _channel_has_shipping_zone(channel, database_connection_name: str) -> bool:
+    """Whether the channel has a usable shipping zone.
+
+    A zone is usable when it is assigned to the channel, covers at least one
+    country and has at least one shipping method available in the channel.
+    """
+    zones = ShippingZone.objects.using(database_connection_name).filter(channels=channel)
+    for zone in zones:
+        if not zone.countries:
+            continue
+        if zone.shipping_methods.filter(channel_listings__channel=channel).exists():
+            return True
+    return False
+
+
+def _compute_problems(
+    product: Product, listing, channel, database_connection_name: str
+) -> list[ProductChannelAvailabilityProblem]:
+    now = timezone.now()
+    problems: list[ProductChannelAvailabilityProblem] = []
+
+    publish_blocker = False
+    if listing.is_published is False:
+        publish_blocker = True
+        problems.append(
+            _problem(
+                ProductChannelAvailabilityProblemType.NOT_PUBLISHED,
+                ProductChannelAvailabilityProblemSeverity.BLOCKER,
+                field_name="isPublished",
+            )
+        )
+
+    available_for_purchase_at = listing.available_for_purchase_at
+    if available_for_purchase_at is not None and available_for_purchase_at > now:
+        publish_blocker = True
+        problems.append(
+            _problem(
+                ProductChannelAvailabilityProblemType.NOT_AVAILABLE_FOR_PURCHASE,
+                ProductChannelAvailabilityProblemSeverity.BLOCKER,
+                field_name="availableForPurchaseAt",
+            )
+        )
+
+    if listing.visible_in_listings is False:
+        problems.append(
+            _problem(
+                ProductChannelAvailabilityProblemType.NOT_VISIBLE_IN_LISTINGS,
+                ProductChannelAvailabilityProblemSeverity.WARNING,
+                field_name="visibleInListings",
+            )
+        )
+
+    # A blocker on publishing makes stock and shipping dependencies irrelevant.
+    dependency_severity = (
+        ProductChannelAvailabilityProblemSeverity.NOT_APPLICABLE
+        if publish_blocker
+        else ProductChannelAvailabilityProblemSeverity.WARNING
+    )
+    shipping_blocker_severity = (
+        ProductChannelAvailabilityProblemSeverity.NOT_APPLICABLE
+        if publish_blocker
+        else ProductChannelAvailabilityProblemSeverity.BLOCKER
+    )
+
+    variants = list(product.variants.all())
+    if not variants:
+        problems.append(
+            _problem(
+                ProductChannelAvailabilityProblemType.NO_VARIANTS,
+                ProductChannelAvailabilityProblemSeverity.BLOCKER,
+                field_name="variants",
+            )
+        )
+    else:
+        variant_ids = [variant.pk for variant in variants]
+        variant_listings = ProductVariantChannelListing.objects.using(
+            database_connection_name
+        ).filter(variant_id__in=variant_ids, channel=channel)
+        if not any(
+            variant_listing.price_amount is not None
+            for variant_listing in variant_listings
+        ):
+            problems.append(
+                _problem(
+                    ProductChannelAvailabilityProblemType.PRODUCT_TYPE_CONFIGURATION,
+                    ProductChannelAvailabilityProblemSeverity.BLOCKER,
+                    field_name="variants",
+                )
+            )
+
+        warehouse_ids = list(
+            Warehouse.objects.using(database_connection_name)
+            .for_channel_stock_source(channel)
+            .values_list("id", flat=True)
+        )
+        if not warehouse_ids:
+            problems.append(
+                _problem(
+                    ProductChannelAvailabilityProblemType.NO_WAREHOUSE_ASSIGNED,
+                    dependency_severity,
+                )
+            )
+
+        stock_required_variant_ids = [
+            variant.pk for variant in variants if variant.track_inventory
+        ]
+        if stock_required_variant_ids:
+            available_quantity = _total_available_quantity(
+                stock_required_variant_ids, warehouse_ids, database_connection_name
+            )
+            if available_quantity <= 0:
+                problems.append(
+                    _problem(
+                        ProductChannelAvailabilityProblemType.NO_STOCK,
+                        dependency_severity,
+                        field_name="variants",
+                    )
+                )
+
+    if product.product_type.is_shipping_required:
+        if not _channel_has_shipping_zone(channel, database_connection_name):
+            problems.append(
+                _problem(
+                    ProductChannelAvailabilityProblemType.NO_SHIPPING_ZONE,
+                    shipping_blocker_severity,
+                )
+            )
+    else:
+        problems.append(
+            _problem(
+                ProductChannelAvailabilityProblemType.SHIPPING_NOT_APPLICABLE,
+                ProductChannelAvailabilityProblemSeverity.NOT_APPLICABLE,
+            )
+        )
+
+    return problems
+
+
+def _diagnostics_for_channel(
+    product: Product, listing, database_connection_name: str
+) -> ProductChannelDiagnostics:
+    channel = listing.channel
+    try:
+        problems = _compute_problems(
+            product, listing, channel, database_connection_name
+        )
+    except Exception:  # noqa: BLE001 - a single channel must not fail the request
+        logger.exception(
+            "Failed to compute channel availability diagnostics for "
+            "product %s and channel %s.",
+            product.pk,
+            channel.slug,
+        )
+        problems = [
+            _problem(
+                ProductChannelAvailabilityProblemType.DIAGNOSTICS_UNAVAILABLE,
+                ProductChannelAvailabilityProblemSeverity.WARNING,
+            )
+        ]
+    return ProductChannelDiagnostics(channel=channel, problems=problems)
+
+
+def _apply_filter(diagnostics, filter_data):
+    if not filter_data:
+        return diagnostics
+
+    channel_query = filter_data.get("channel")
+    currency = filter_data.get("currency")
+    severities = {
+        str(severity)
+        for severity in (filter_data.get("severity") or [])
+        if severity is not None
+    }
+
+    filtered = []
+    for diagnostics_item in diagnostics:
+        channel = diagnostics_item.channel
+        if channel_query:
+            needle = channel_query.lower()
+            name = (channel.name or "").lower()
+            slug = (channel.slug or "").lower()
+            if needle not in name and needle not in slug:
+                continue
+        if currency and (channel.currency_code or "").lower() != currency.lower():
+            continue
+        if severities:
+            problem_severities = {
+                str(problem.severity.value)
+                if isinstance(problem.severity, Enum)
+                else str(problem.severity)
+                for problem in diagnostics_item.problems
+            }
+            if not problem_severities & severities:
+                continue
+        filtered.append(diagnostics_item)
+    return filtered
+
+
+def _apply_sort(diagnostics, sort_by):
+    field = (sort_by or {}).get("field") or "CHANNEL_NAME"
+    direction = (sort_by or {}).get("direction") or ""
+    reverse = direction == "-"
+
+    if field == "CURRENCY":
+        key = lambda item: (  # noqa: E731
+            (item.channel.currency_code or "").lower(),
+            item.channel.pk,
+        )
+    else:
+        key = lambda item: (  # noqa: E731
+            (item.channel.name or "").lower(),
+            item.channel.pk,
+        )
+    return sorted(diagnostics, key=key, reverse=reverse)
+
+
+def get_product_channel_diagnostics(
+    product: Product,
+    *,
+    filter_data=None,
+    sort_by=None,
+    database_connection_name: str = "default",
+) -> list[ProductChannelDiagnostics]:
+    """Return the per channel diagnostics for the given product.
+
+    Diagnostics are recomputed on every call from the current server side facts;
+    the result is never cached.
+    """
+    listings = (
+        product.channel_listings.using(database_connection_name)
+        .select_related("channel")
+        .order_by("channel__name", "pk")
+    )
+    diagnostics = [
+        _diagnostics_for_channel(product, listing, database_connection_name)
+        for listing in listings
+    ]
+    diagnostics = _apply_filter(diagnostics, filter_data)
+    return _apply_sort(diagnostics, sort_by)
