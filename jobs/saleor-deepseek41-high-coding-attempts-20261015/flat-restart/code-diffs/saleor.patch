+
+def test_order_shipping_method_metadata_snapshot_not_rewritten_by_source_change(
+    api_client, order, shipping_method
+):
+    # given
+    order.shipping_method = shipping_method
+    order.shipping_method_metadata = {"public_key": "snapshot_value"}
+    order.shipping_method_private_metadata = {"private_key": "snapshot_value"}
+    order.save()
+    # The source delivery method is later modified.
+    shipping_method.store_value_in_metadata({"public_key": "changed_value"})
+    shipping_method.store_value_in_private_metadata({"private_key": "changed_value"})
+    shipping_method.save()
+
+    variables = {"token": order.id}
+
+    # when
+    response = api_client.post_graphql(
+        QUERY_ORDER_SHIPPING_METHOD_PUBLIC_METADATA, variables
+    )
+    content = get_graphql_content(response)
+
+    # then
+    data = content["data"]["orderByToken"]
+    assert data["shippingMethodMetadata"] == [
+        {"key": "public_key", "value": "snapshot_value"}
+    ]
+
+
+def test_order_shipping_method_metadata_snapshot_survives_method_deletion(
+    api_client, order, shipping_method
+):
+    # given
+    order.shipping_method = shipping_method
+    order.shipping_method_metadata = {"public_key": "snapshot_value"}
+    order.save()
+    shipping_method.delete()
+    order.refresh_from_db()
+
+    variables = {"token": order.id}
+
+    # when
+    response = api_client.post_graphql(
+        QUERY_ORDER_SHIPPING_METHOD_PUBLIC_METADATA, variables
+    )
+    content = get_graphql_content(response)
+
+    # then
+    data = content["data"]["orderByToken"]
+    assert data["shippingMethodMetadata"] == [
+        {"key": "public_key", "value": "snapshot_value"}
+    ]
+
+
+def test_order_shipping_method_reports_snapshot_after_source_change(
+    api_client, order, shipping_method
+):
+    """AC-24-5: the delivery info reported for the order (e.g. in event
+    payloads) comes from the snapshot, not the source delivery method."""
+    # given
+    order.shipping_method = shipping_method
+    order.shipping_method_metadata = {"public_key": "snapshot_value"}
+    order.shipping_method_private_metadata = {"private_key": "snapshot_value"}
+    order.save()
+    # The source delivery method changes after the order was created.
+    shipping_method.store_value_in_metadata({"public_key": "changed_value"})
+    shipping_method.store_value_in_private_metadata({"private_key": "changed_value"})
+    shipping_method.save()
+
+    variables = {"token": order.id}
+
+    # when
+    response = api_client.post_graphql(
+        QUERY_ORDER_SHIPPING_METHOD_DELIVERY_METADATA, variables
+    )
+    content = get_graphql_content(response)
+
+    # then
+    data = content["data"]["orderByToken"]
+    assert data["shippingMethod"]["metadata"] == [
+        {"key": "public_key", "value": "snapshot_value"}
+    ]
+
