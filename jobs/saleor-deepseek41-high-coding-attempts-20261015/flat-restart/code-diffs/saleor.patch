@@ -0,0 +1,209 @@
+from decimal import Decimal
+
+import pytest
+
+from ...core.prices import Money
+from ...giftcard import GiftCardEvents
+from ...giftcard.models import GiftCard
+from .. import PaymentMethodType, TransactionEventType
+from ..gift_card_payments import (
+    GiftCardPaymentError,
+    charge_gift_card,
+    create_gift_card_transaction,
+    get_order_total_gift_card,
+    refund_gift_card,
+    release_gift_card_authorization,
+    validate_gift_card_for_payment,
+)
+from ..models import TransactionItem
+
+
+def _gift_card(amount="100", currency="USD", code="gc-test"):
+    return GiftCard.objects.create(
+        code=code,
+        initial_balance=Money(Decimal(amount), currency),
+        current_balance=Money(Decimal(amount), currency),
+    )
+
+
+def test_get_order_total_gift_card_counts_charged_amount_once(order_with_lines):
+    # given
+    order = order_with_lines
+    gift_card = _gift_card("100")
+    transaction = create_gift_card_transaction(
+        order, gift_card, Decimal("40"), None, None, "key-1"
+    )
+    charge_gift_card(transaction, Decimal("40"), None, None)
+    # a regular (non gift card) transaction must not be counted
+    TransactionItem.objects.create(
+        currency=order.currency,
+        order_id=order.pk,
+        charged_value=Decimal("60"),
+        name="card",
+    )
+
+    # when
+    total = get_order_total_gift_card(order)
+
+    # then
+    assert total.amount == Decimal("40")
+    assert total.currency == order.currency
+
+
+def test_get_order_total_gift_card_uses_authorized_when_not_charged(order_with_lines):
+    # given
+    order = order_with_lines
+    gift_card = _gift_card("100")
+    create_gift_card_transaction(order, gift_card, Decimal("25"), None, None, "key-2")
+
+    # when
+    total = get_order_total_gift_card(order)
+
+    # then
+    assert total.amount == Decimal("25")
+
+
+def test_create_gift_card_transaction_reserves_balance(order_with_lines):
+    # given
+    order = order_with_lines
+    gift_card = _gift_card("100")
+
+    # when
+    transaction = create_gift_card_transaction(
+        order, gift_card, Decimal("30"), None, None, "key-3"
+    )
+
+    # then
+    gift_card.refresh_from_db()
+    assert gift_card.reserved_balance_amount == Decimal("30")
+    assert gift_card.available_balance.amount == Decimal("70")
+    assert gift_card.current_balance_amount == Decimal("100")
+    assert transaction.payment_method_type == PaymentMethodType.GIFT_CARD
+    assert transaction.gift_card_id == gift_card.pk
+    assert transaction.amount_authorized.amount == Decimal("30")
+    assert transaction.events.filter(
+        type=TransactionEventType.AUTHORIZATION_SUCCESS
+    ).exists()
+    assert gift_card.events.filter(type=GiftCardEvents.AUTHORIZED).exists()
+
+
+def test_charge_gift_card_moves_reserved_to_charged(order_with_lines):
+    # given
+    order = order_with_lines
+    gift_card = _gift_card("100")
+    transaction = create_gift_card_transaction(
+        order, gift_card, Decimal("40"), None, None, "key-4"
+    )
+
+    # when
+    charge_gift_card(transaction, Decimal("40"), None, None)
+
+    # then
+    gift_card.refresh_from_db()
+    assert gift_card.current_balance_amount == Decimal("60")
+    assert gift_card.reserved_balance_amount == Decimal("0")
+    transaction.refresh_from_db()
+    assert transaction.amount_charged.amount == Decimal("40")
+
+
+def test_charge_gift_card_above_authorized_is_rejected(order_with_lines):
+    # given
+    order = order_with_lines
+    gift_card = _gift_card("100")
+    transaction = create_gift_card_transaction(
+        order, gift_card, Decimal("40"), None, None, "key-5"
+    )
+
+    # when / then
+    with pytest.raises(GiftCardPaymentError):
+        charge_gift_card(transaction, Decimal("50"), None, None)
+    gift_card.refresh_from_db()
+    assert gift_card.current_balance_amount == Decimal("100")
+
+
+def test_release_gift_card_authorization(order_with_lines):
+    # given
+    order = order_with_lines
+    gift_card = _gift_card("100")
+    transaction = create_gift_card_transaction(
+        order, gift_card, Decimal("40"), None, None, "key-6"
+    )
+
+    # when
+    release_gift_card_authorization(transaction, None, None)
+
+    # then
+    gift_card.refresh_from_db()
+    assert gift_card.reserved_balance_amount == Decimal("0")
+    assert gift_card.available_balance.amount == Decimal("100")
+    assert gift_card.events.filter(
+        type=GiftCardEvents.AUTHORIZATION_RELEASED
+    ).exists()
+
+
+def test_refund_gift_card_within_refundable(order_with_lines):
+    # given
+    order = order_with_lines
+    gift_card = _gift_card("100")
+    transaction = create_gift_card_transaction(
+        order, gift_card, Decimal("100"), None, None, "key-7"
+    )
+    charge_gift_card(transaction, Decimal("100"), None, None)
+
+    # when
+    refund_gift_card(transaction, Decimal("60"), None, None)
+
+    # then
+    gift_card.refresh_from_db()
+    assert gift_card.current_balance_amount == Decimal("60")
+    transaction.refresh_from_db()
+    assert transaction.amount_refunded.amount == Decimal("60")
+    assert gift_card.events.filter(type=GiftCardEvents.REFUNDED).exists()
+
+
+def test_refund_gift_card_above_refundable_is_rejected(order_with_lines):
+    # given
+    order = order_with_lines
+    gift_card = _gift_card("100")
+    transaction = create_gift_card_transaction(
+        order, gift_card, Decimal("100"), None, None, "key-8"
+    )
+    charge_gift_card(transaction, Decimal("100"), None, None)
+    refund_gift_card(transaction, Decimal("30"), None, None)
+
+    # when / then
+    with pytest.raises(GiftCardPaymentError):
+        refund_gift_card(transaction, Decimal("80"), None, None)
+    gift_card.refresh_from_db()
+    assert gift_card.current_balance_amount == Decimal("30")
+
+
+def test_validate_gift_card_for_payment_currency_mismatch():
+    # given
+    gift_card = _gift_card("100", currency="EUR")
+
+    # when / then
+    with pytest.raises(GiftCardPaymentError) as exc:
+        validate_gift_card_for_payment(gift_card, "USD", Decimal("10"))
+    assert exc.value.code == "gift_card_invalid"
+
+
+def test_validate_gift_card_for_payment_insufficient_balance():
+    # given
+    gift_card = _gift_card("10")
+
+    # when / then
+    with pytest.raises(GiftCardPaymentError) as exc:
+        validate_gift_card_for_payment(gift_card, "USD", Decimal("20"))
+    assert exc.value.code == "gift_card_insufficient_balance"
+
+
+def test_validate_gift_card_for_payment_inactive():
+    # given
+    gift_card = _gift_card("100")
+    gift_card.is_active = False
+
+    # when / then
+    with pytest.raises(GiftCardPaymentError) as exc:
+        validate_gift_card_for_payment(gift_card, "USD", Decimal("10"))
+    assert exc.value.code == "gift_card_not_applicable"
