+@app.task
+@allow_writer()
+def automatic_checkout_completion_scan_task(batch_size: int | None = None) -> int:
+    """Enqueue the automatic completion of the eligible checkouts.
+
+    Only the channels which explicitly enabled the automatic completion are
+    scanned, so channels that were never configured keep their existing manual
+    flow. The task only schedules the work: every checkout is re-checked right
+    before the order is created, and a single failing checkout never stops the
+    other ones from being processed.
+
+    :param batch_size: The maximum number of checkouts enqueued per channel.
+
+    :return: The number of enqueued checkouts.
+    """
+    enqueued: int = 0
+
+    channels = Channel.objects.filter(
+        automatically_complete_fully_paid_checkouts=True
+    ).iterator()
+
+    for channel in channels:
+        checkouts = checkouts_pending_automatic_completion(
+            channel, batch_size=batch_size
+        )
+        for checkout_pk in checkouts.values_list("pk", flat=True).iterator():
+            automatic_checkout_completion_task.delay(checkout_pk, None, None)
+            enqueued += 1
+
+    if enqueued:
+        task_logger.debug(
+            "Enqueued the automatic checkout completion for %d checkouts.", enqueued
+        )
+
+    return enqueued
