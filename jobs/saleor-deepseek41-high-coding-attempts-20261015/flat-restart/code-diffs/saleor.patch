@@ -0,0 +1,370 @@
+"""Tests for the shop-wide password login policy (R16 / BD11).
+
+The policy is read from ``SiteSettings.password_login_mode`` on every request, so
+a value saved by ``shopSettingsUpdate`` takes effect immediately. These tests
+cover the server-side enforcement points: password login, password reset, set
+password, password change and the native (password-owner) token paths.
+"""
+
+import datetime
+from unittest.mock import patch
+
+from freezegun import freeze_time
+
+from ......account.error_codes import AccountErrorCode
+from ......core.jwt import (
+    JWT_ACCESS_TYPE,
+    JWT_REFRESH_TYPE,
+    create_access_token,
+    create_refresh_token,
+    jwt_encode,
+    jwt_user_payload,
+)
+from ......core.tokens import token_generator
+from ......site import PasswordLoginMode
+from .....tests.utils import get_graphql_content
+
+EXTERNAL_TOKEN_OWNER = "mirumee.authentication.openid"
+
+MUTATION_CREATE_TOKEN = """
+    mutation tokenCreate($email: String!, $password: String!){
+        tokenCreate(email: $email, password: $password) {
+            token
+            refreshToken
+            user {
+                email
+            }
+            errors {
+                field
+                message
+                code
+            }
+        }
+    }
+"""
+
+MUTATION_REQUEST_PASSWORD_RESET = """
+    mutation RequestPasswordReset($email: String!, $redirectUrl: String!) {
+        requestPasswordReset(email: $email, redirectUrl: $redirectUrl) {
+            errors {
+                field
+                message
+                code
+            }
+        }
+    }
+"""
+
+MUTATION_SET_PASSWORD = """
+    mutation SetPassword($email: String!, $token: String!, $password: String!) {
+        setPassword(email: $email, token: $token, password: $password) {
+            errors {
+                field
+                message
+                code
+            }
+            token
+        }
+    }
+"""
+
+MUTATION_PASSWORD_CHANGE = """
+    mutation PasswordChange($oldPassword: String, $newPassword: String!) {
+        passwordChange(oldPassword: $oldPassword, newPassword: $newPassword) {
+            errors {
+                field
+                message
+                code
+            }
+        }
+    }
+"""
+
+MUTATION_TOKEN_REFRESH = """
+    mutation tokenRefresh($token: String){
+        tokenRefresh(refreshToken: $token){
+            token
+            errors{
+              code
+              field
+            }
+        }
+    }
+"""
+
+MUTATION_TOKEN_VERIFY = """
+    mutation tokenVerify($token: String!){
+        tokenVerify(token: $token){
+            isValid
+            errors{
+              code
+              field
+            }
+        }
+    }
+"""
+
+
+def _set_mode(site_settings, mode):
+    site_settings.password_login_mode = mode
+    site_settings.save(update_fields=["password_login_mode"])
+    return site_settings
+
+
+def _external_access_token(user):
+    payload = jwt_user_payload(
+        user,
+        JWT_ACCESS_TYPE,
+        datetime.timedelta(minutes=5),
+        token_owner=EXTERNAL_TOKEN_OWNER,
+    )
+    return jwt_encode(payload)
+
+
+def _external_refresh_token(user):
+    payload = jwt_user_payload(
+        user,
+        JWT_REFRESH_TYPE,
+        datetime.timedelta(minutes=5),
+        token_owner=EXTERNAL_TOKEN_OWNER,
+    )
+    return jwt_encode(payload)
+
+
