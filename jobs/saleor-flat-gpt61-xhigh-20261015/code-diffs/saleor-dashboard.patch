@@ -0,0 +1,44 @@
+import { Box, Button, Text } from "@saleor/macaw-ui-next";
+import { ReactNode } from "react";
+import { useIntl } from "react-intl";
+import { Link } from "react-router-dom";
+
+import { useLoginPolicy } from "../hooks/useLoginPolicy";
+
+/** Also guards direct reset/new-password URLs, not just the link on the sign-in form. */
+export function PasswordPolicyGate({ children }: { children: ReactNode }) {
+  const policy = useLoginPolicy();
+  const intl = useIntl();
+
+  if (policy.passwordEnabled) {
+    return <>{children}</>;
+  }
+
+  return (
+    <Box>
+      <Text role={policy.error ? "alert" : "status"}>
+        {policy.loading
+          ? intl.formatMessage({
+              id: "0Sgt8I",
+              defaultMessage: "Loading sign-in methods…",
+            })
+          : policy.error
+            ? intl.formatMessage({
+                id: "HOpq0e",
+                defaultMessage: "Unable to load sign-in methods.",
+              })
+            : intl.formatMessage({
+                id: "nSg6i4",
+                defaultMessage:
+                  "Staff password authentication is unavailable. Use an external sign-in method or contact your store administrator.",
+              })}
+      </Text>
+      {policy.error && (
+        <Button onClick={policy.reload}>
+          {intl.formatMessage({ id: "62nsdy", defaultMessage: "Retry" })}
+        </Button>
+      )}
+      <Link to="/">{intl.formatMessage({ id: "odTkf5", defaultMessage: "Back to sign in" })}</Link>
+    </Box>
+  );
+}
diff --git a/src/auth/hooks/useLoginPolicy.ts b/src/auth/hooks/useLoginPolicy.ts
new file mode 100644
index 0000000..b1c6156
--- /dev/null
+++ b/src/auth/hooks/useLoginPolicy.ts
@@ -0,0 +1,23 @@
+import {
+  PasswordAuthenticationModeEnum,
+  useAvailableExternalAuthenticationsQuery,
+} from "@dashboard/graphql";
+
+/** The public policy query must not use the authenticated, permission-gated Shop fragment. */
+export function useLoginPolicy() {
+  const result = useAvailableExternalAuthenticationsQuery({
+    fetchPolicy: "network-only",
+    errorPolicy: "none",
+  });
+  const mode = result.data?.shop?.passwordAuthenticationMode;
+
+  return {
+    mode,
+    providers: result.data?.shop?.availableExternalAuthentications ?? [],
+    loading: result.loading,
+    error: !!result.error || (!result.loading && !mode),
+    passwordEnabled:
+      !result.loading && !result.error && mode === PasswordAuthenticationModeEnum.ENABLED,
+    reload: () => result.refetch(),
+  };
+}
