@@ -0,0 +1,145 @@
+import { ProductTypeQuery } from "@dashboard/graphql";
+import { ProductCreateData } from "@dashboard/products/components/ProductCreatePage/form";
+import { waitFor } from "@testing-library/react";
+
+import { createHandler } from "./handlers";
+
+const setup = (hasVariants = false) => {
+  const productType = { id: "type", hasVariants } as ProductTypeQuery["productType"];
+  const upload = jest.fn();
+  const create = jest
+    .fn()
+    .mockResolvedValue({ data: { productCreate: { errors: [], product: { id: "product" } } } });
+  const variant = jest.fn().mockResolvedValue({
+    data: { productVariantCreate: { errors: [], productVariant: { id: "variant" } } },
+  });
+  const channels = jest.fn().mockResolvedValue({
+    data: { productChannelListingUpdate: { errors: [], product: { id: "product" } } },
+  });
+  const variantChannels = jest.fn().mockResolvedValue({
+    data: { productVariantChannelListingUpdate: { errors: [], variant: { id: "variant" } } },
+  });
+  const remove = jest
+    .fn()
+    .mockResolvedValue({ data: { productDelete: { errors: [], product: { id: "product" } } } });
+  const data = {
+    productType,
+    attributesWithNewFileValue: [],
+    attributes: [],
+    collections: [],
+    channelListings: [],
+    description: null,
+    weight: "",
+    stocks: [],
+  } as unknown as ProductCreateData;
+  const submit = createHandler(
+    productType,
+    upload,
+    create,
+    variant,
+    channels,
+    variantChannels,
+    remove,
+  );
+
+  return { submit, data, create, variant, channels, variantChannels, remove };
+};
+
+describe("product create completion", () => {
+  it("waits for variant channel confirmation before returning success", async () => {
+    // Arrange
+    const { submit, data, variantChannels } = setup();
+    let resolve: (value: unknown) => void;
+
+    variantChannels.mockImplementation(
+      () =>
+        new Promise(done => {
+          resolve = done;
+        }),
+    );
+
+    let completed = false;
+    // Act
+    const pending = submit(data).then(result => {
+      completed = true;
+
+      return result;
+    });
+
+    await waitFor(() => expect(variantChannels).toHaveBeenCalledTimes(1));
+    // Assert
+    expect(variantChannels).toHaveBeenCalledTimes(1);
+    expect(completed).toBe(false);
+    resolve!({
+      data: { productVariantChannelListingUpdate: { errors: [], variant: { id: "variant" } } },
+    });
+    await expect(pending).resolves.toEqual({ id: "product", errors: [] });
+  });
+
+  it.each([{}, { data: { productCreate: null } }, { data: { productCreate: { errors: [] } } }])(
+    "rejects unconfirmed product response %#",
+    async response => {
+      // Arrange
+      const { submit, data, create, channels } = setup();
+
+      create.mockResolvedValue(response);
+
+      // Act
+      const result = await submit(data).catch(() => null);
+
+      // Assert
+      expect(result === null || result.errors.length > 0).toBe(true);
+      expect(channels).not.toHaveBeenCalled();
+    },
+  );
+
+  it("does not start a variant after channel rejection", async () => {
+    // Arrange
+    const { submit, data, channels, variant, remove } = setup();
+    const errors = [{ code: "INVALID", field: "channels", message: "Rejected" }];
+
+    channels.mockResolvedValue({ data: { productChannelListingUpdate: { errors } } });
+
+    // Act
+    const result = await submit(data);
+
+    // Assert
+    expect(result).toEqual({ errors });
+    expect(variant).not.toHaveBeenCalled();
+    expect(remove).toHaveBeenCalledTimes(1);
+  });
+
+  it("returns a variant channel failure, not success", async () => {
+    // Arrange
+    const { submit, data, variantChannels } = setup();
+
+    variantChannels.mockResolvedValue({});
+
+    // Act
+    const result = await submit(data);
+
+    // Assert
+    expect(result.errors.length).toBeGreaterThan(0);
+    expect(result).not.toHaveProperty("id");
+  });
+
+  it("rejects an unconfirmed cleanup instead of claiming rollback", async () => {
+    // Arrange
+    const { submit, data, channels, remove } = setup();
+
+    channels.mockResolvedValue({});
+    remove.mockResolvedValue({});
+    // Act / Assert
+    await expect(submit(data)).rejects.toThrow("cleanup could not be confirmed");
+  });
+
+  it("retains ordinary products with variants without creating a default variant", async () => {
+    // Arrange
+    const { submit, data, variant, variantChannels } = setup(true);
+
+    // Act / Assert
+    await expect(submit(data)).resolves.toEqual({ id: "product", errors: [] });
+    expect(variant).not.toHaveBeenCalled();
+    expect(variantChannels).not.toHaveBeenCalled();
+  });
+});
