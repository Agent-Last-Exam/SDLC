+import { gql } from "@apollo/client";
+
+export const metadataBundleQuery = gql`
+  query MetadataBundle($id: ID!, $includePrivate: Boolean!) {
+    metadataBundle(id: $id) {
+      id
+      version
+      metadata {
+        key
+        value
+      }
+      privateMetadata @include(if: $includePrivate) {
+        key
+        value
+      }
+    }
+  }
+`;
