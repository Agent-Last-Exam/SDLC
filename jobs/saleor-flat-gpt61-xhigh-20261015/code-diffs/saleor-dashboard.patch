+import { ApolloError, MutationResult } from "@apollo/client";
+import { GraphQLError } from "graphql";
+
+import { extractMutationErrors, getMutationErrors, getMutationStatus, weight } from "./misc";
+
+jest.mock("./components/Datagrid/customCells/PillCell", () => ({
+  hueToPillColorDark: jest.fn(),
+  hueToPillColorLight: jest.fn(),
+}));
+
+const unconfirmedError = {
+  code: "GRAPHQL_ERROR",
+  field: null,
+  message: "The operation could not be confirmed. Please try again.",
+};
+
+describe("getMutationErrors", () => {
+  it.each([undefined, {}, { data: undefined }, { data: null }, { data: {} }])(
+    "does not confirm a completed response without mutation data (%s)",
+    result => {
+      // Arrange / Act
+      const errors = getMutationErrors(result as any);
+
+      // Assert
+      expect(errors).toEqual([unconfirmedError]);
+    },
+  );
+
+  it("keeps GraphQL permission failures even when HTTP 200 includes partial data", () => {
+    // Arrange
+    const error = new GraphQLError("Not permitted", {
+      extensions: { code: "PERMISSION_DENIED", field: "privateMetadata" },
+    });
+    const result = { data: { update: { errors: [] } }, errors: [error] };
+
+    // Act
+    const errors = getMutationErrors(result);
+
+    // Assert
+    expect(errors).toEqual([
+      { code: "PERMISSION_DENIED", field: "privateMetadata", message: "Not permitted" },
+    ]);
+  });
+
+  it("keeps a top-level validation error with missing data", () => {
+    // Arrange
+    const error = new GraphQLError("Invalid input");
+
+    // Act
+    const errors = getMutationErrors({ errors: [error] });
+
+    // Assert
+    expect(errors).toEqual([{ code: "GRAPHQL_ERROR", field: null, message: "Invalid input" }]);
+  });
+
+  it("merges payload and bulk-row errors without dropping unknown business codes", () => {
+    // Arrange
+    const error = { code: "FUTURE_FAILURE", field: "name", message: "Cannot save" };
+    const rowError = { code: "INVALID", field: "weight", message: "Invalid weight" };
+    const result = {
+      data: {
+        update: { errors: [error] },
+        bulkUpdate: { errors: [], results: [{ errors: [] }, { errors: [rowError] }] },
+      },
+    };
+
+    // Act
+    const errors = getMutationErrors(result);
+
+    // Assert
+    expect(errors).toEqual([error, rowError]);
+  });
+
+  it.each([
+    { data: { update: null } },
+    { data: { update: {} } },
+    { data: { update: { events: [] } } },
+    { data: { update: { errors: null } } },
+    { data: { update: { errors: [], results: [null] } } },
+  ])("does not confirm a null mutation payload or error list (%s)", result => {
+    // Arrange / Act
+    const errors = getMutationErrors(result);
+
+    // Assert
+    expect(errors).toEqual([unconfirmedError]);
+  });
+
+  it("preserves successful empty events and empty bulk results", () => {
+    // Arrange
+    const result = {
+      data: {
+        __typename: "Mutation",
+        request: { errors: [], events: [] },
+        bulkUpdate: { errors: [], results: [] },
+      },
+    };
+
+    // Act
+    const errors = getMutationErrors(result);
+
+    // Assert
+    expect(errors).toEqual([]);
+  });
+
+  it("allows a confirmed request with no matching transactions or events", () => {
+    // Arrange
+    const result = { data: { request: { errors: [], transactions: { edges: [] }, events: [] } } };
+
+    // Act
+    const errors = getMutationErrors(result);
+
+    // Assert
+    expect(errors).toEqual([]);
+  });
+
+  it.each([
+    { called: false, loading: false },
+    { called: true, loading: true },
+  ])("does not show a missing-data error on an idle/loading hook (%s)", state => {
+    // Arrange
+    const result = { data: undefined, ...state };
+
+    // Act
+    const errors = getMutationErrors(result);
+
+    // Assert
+    expect(errors).toEqual([]);
+  });
+
+  it("reads Apollo hook errors as failures", () => {
+    // Arrange
+    const error = new ApolloError({
+      graphQLErrors: [new GraphQLError("Input rejected", { extensions: { code: "INPUT_ERROR" } })],
+    });
+
+    // Act
+    const errors = getMutationErrors({ data: { update: null }, error });
+
+    // Assert
+    expect(errors).toEqual([{ code: "INPUT_ERROR", field: null, message: "Input rejected" }]);
+  });
+
+  it("reports a network failure without exposing transport details", () => {
+    // Arrange
+    const error = new ApolloError({ networkError: new Error("secret credentials") });
+
+    // Act
+    const errors = getMutationErrors({ data: { update: { errors: [] } }, error });
+
+    // Assert
+    expect(errors).toEqual([unconfirmedError]);
+  });
+
+  it("propagates unconfirmed results through extractMutationErrors", async () => {
+    // Arrange
+    const response = Promise.resolve({ data: null });
+
+    // Act
+    const errors = await extractMutationErrors(response);
+
+    // Assert
+    expect(errors).toEqual([unconfirmedError]);
+  });
+});
+
+describe("getMutationStatus", () => {
+  it.each([
+    [{ called: false, loading: false }, "default"],
+    [{ called: true, loading: true }, "loading"],
+    [{ called: true, loading: false }, "error"],
+    [{ called: true, loading: false, data: { request: { errors: [], events: [] } } }, "success"],
