index 0000000..2bd6e64
--- /dev/null
+++ b/src/components/ConditionalFilter/useScopedExport.ts
@@ -0,0 +1,265 @@
+import { gql, useApolloClient } from "@apollo/client";
+import { useUser } from "@dashboard/auth";
+import { ConfirmButtonTransitionState } from "@dashboard/components/ConfirmButton";
+import { Task, TaskStatus } from "@dashboard/containers/BackgroundTasks/types";
+import { ExportErrorFragment, JobStatusEnum, UserPermissionFragment } from "@dashboard/graphql";
+import useBackgroundTask from "@dashboard/hooks/useBackgroundTask";
+import useNotifier from "@dashboard/hooks/useNotifier";
+import { DocumentNode } from "graphql";
+import { useEffect, useRef, useState } from "react";
+import { useIntl } from "react-intl";
+import { v4 as uuid } from "uuid";
+
+import { downloadExport } from "./downloadExport";
+import { scopeFingerprint } from "./effectiveScope";
+
+export type ExportDomain = "products" | "giftCards" | "vouchers";
+
+const permissions: Record<ExportDomain, [string, string]> = {
+  products: ["MANAGE_PRODUCT_EXPORTS", "MANAGE_PRODUCTS"],
+  giftCards: ["MANAGE_GIFT_CARD_EXPORTS", "MANAGE_GIFT_CARD"],
+  vouchers: ["MANAGE_VOUCHER_EXPORTS", "MANAGE_DISCOUNTS"],
+};
+
+export const canExport = (
+  domain: ExportDomain,
+  granted: readonly Pick<UserPermissionFragment, "code">[] | null | undefined = [],
+): boolean =>
+  permissions[domain].every(code => granted?.some(permission => permission.code === code));
+
+export class ExportRequest {
+  private fingerprint?: string;
+
+  private key?: string;
+
+  snapshot<T extends object>(input: T): T & { idempotencyKey: string } {
+    const fingerprint = scopeFingerprint(input);
+
+    if (fingerprint !== this.fingerprint) {
+      this.fingerprint = fingerprint;
+      this.key = uuid();
+    }
+
+    return { ...JSON.parse(fingerprint), idempotencyKey: this.key! };
+  }
+
+  complete() {
+    this.fingerprint = undefined;
+    this.key = undefined;
+  }
+}
+
+export const exportJobStatus = (
+  job?: { status: JobStatusEnum; url?: string | null } | null,
+): TaskStatus => {
+  if (!job || job.status === JobStatusEnum.FAILED) return TaskStatus.FAILURE;
+
+  if (job.status === JobStatusEnum.SUCCESS && job.url) return TaskStatus.SUCCESS;
+
+  return TaskStatus.PENDING;
+};
+
+export const scopedExportFile = gql`
+  query ScopedExportFile($id: ID!) {
+    exportFile(id: $id) {
+      id
+      status
+      url
+    }
+  }
+`;
+
+interface ExportPayload {
+  errors: ExportErrorFragment[];
+  exportFile?: { id: string; status: JobStatusEnum; url?: string | null } | null;
+}
+
+/** Export Query creates a job: never register it as watchQuery, batch it, or cache/replay on mount. */
+export const useScopedExport = (
+  domain: ExportDomain,
+  document: DocumentNode,
+  field: string,
+  contextKey?: string,
+) => {
+  const client = useApolloClient();
+  const { user } = useUser();
+  const { queue } = useBackgroundTask();
+  const notify = useNotifier();
+  const intl = useIntl();
+  const request = useRef(new ExportRequest());
+  const busy = useRef(false);
+  const [feedback, setFeedback] = useState<{
+    contextKey?: string;
+    status: ConfirmButtonTransitionState;
+    errors: ExportErrorFragment[];
+  }>({ contextKey, status: "default", errors: [] });
+  const status = feedback.contextKey === contextKey ? feedback.status : "default";
+  const errors = feedback.contextKey === contextKey ? feedback.errors : [];
+  const allowed = canExport(domain, user?.userPermissions);
+  const currentContext = useRef(contextKey);
+
+  useEffect(() => {
+    currentContext.current = contextKey;
+  }, [contextKey]);
+
+  const mounted = useRef(true);
+
+  useEffect(() => {
+    mounted.current = true;
+
+    return () => {
+      mounted.current = false;
+    };
+  }, []);
+
+  const submit = async <T extends object>(input: T, ready: boolean): Promise<boolean> => {
+    if (!allowed || !ready || busy.current) return false;
+
+    const submittedContext = contextKey;
+    const isCurrent = () => mounted.current && currentContext.current === submittedContext;
+
+    busy.current = true;
+    setFeedback({ contextKey: submittedContext, status: "loading", errors: [] });
+
+    try {
+      const result = await client.query<Record<string, ExportPayload | null>>({
+        query: document,
+        variables: { input: request.current.snapshot(input) },
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+        context: { useBatching: false, fetchOptions: { method: "POST" } },
+      });
+      const payload = result.data?.[field];
+
+      if (result.errors?.length || !payload || payload.errors.length || !payload.exportFile?.id) {
+        if (isCurrent()) {
+          setFeedback({
+            contextKey: submittedContext,
+            errors: payload?.errors ?? [],
+            status: "error",
+          });
+        }
+
+        notify({
+          status: "error",
+          text: intl.formatMessage({
+            id: "VwBAqv",
+            defaultMessage:
+              "The export request was not accepted. Check the current scope and permissions.",
+          }),
+        });
+
+        return false;
+      }
+
+      request.current.complete();
+
+      if (isCurrent()) {
+        setFeedback({ contextKey: submittedContext, status: "default", errors: [] });
+      }
+
+      notify({
+        text: intl.formatMessage({
+          id: "tC+oPP",
+          defaultMessage: "Export requested. The file is not ready yet.",
+        }),
+      });
+
+      let completedUrl: string | undefined;
+      let downloading = false;
+      const download = async () => {
+        if (!completedUrl || downloading) return;
+
+        downloading = true;
+
+        try {
+          await downloadExport(completedUrl);
+        } catch {
+          notify({
+            status: "error",
+            text: intl.formatMessage({
+              defaultMessage:
+                "The export could not be downloaded. Check your current permissions and try again.",
+              id: "LRvrLA",
+            }),
+          });
+        } finally {
+          downloading = false;
+        }
+      };
+
+      queue(Task.CUSTOM, {
+        handle: async () => {
+          const result = await client.query<{ exportFile: ExportPayload["exportFile"] }>({
+            query: scopedExportFile,
+            variables: { id: payload.exportFile!.id },
+            fetchPolicy: "no-cache",
+            errorPolicy: "none",
+          });
+          const job = result.data?.exportFile;
+          const jobStatus = exportJobStatus(job);
+
+          if (jobStatus === TaskStatus.SUCCESS) completedUrl = job?.url ?? undefined;
+
+          return jobStatus;
+        },
+        onCompleted: ({ status }) =>
+          notify({
+            status: status === TaskStatus.SUCCESS ? "success" : "error",
+            autohide: status === TaskStatus.SUCCESS ? 60000 : undefined,
+            actionBtn:
+              status === TaskStatus.SUCCESS && completedUrl
+                ? {
+                    label: intl.formatMessage({ defaultMessage: "Download", id: "5q3qC0" }),
+                    action: () => {
+                      void download();
+                    },
+                  }
+                : undefined,
+            text:
+              status === TaskStatus.SUCCESS
+                ? intl.formatMessage({
+                    id: "vnMY76",
+                    defaultMessage: "The export file is ready.",
+                  })
+                : intl.formatMessage({
+                    id: "Rp2xo+",
+                    defaultMessage: "The export failed. Please try again.",
+                  }),
+          }),
+        onError: () =>
+          notify({
+            status: "error",
+            text: intl.formatMessage({
+              id: "bwqcoh",
+              defaultMessage:
+                "Could not check the export status. Completion has not been confirmed.",
+            }),
+          }),
+      });
+
+      // Keep monitoring accepted jobs, but never close a newer dialog or clear
+      // selection in a different context when an old response arrives.
+      return isCurrent();
+    } catch {
+      if (isCurrent()) {
+        setFeedback({ contextKey: submittedContext, status: "error", errors: [] });
+      }
+
+      notify({
+        status: "error",
+        text: intl.formatMessage({
+          id: "Aii9Vh",
+          defaultMessage:
+            "The export could not be confirmed. Retry the same request to check its status.",
+        }),
+      });
+
+      return false;
+    } finally {
+      busy.current = false;
+    }
+  };
+
+  return { submit, status, errors, allowed };
+};
