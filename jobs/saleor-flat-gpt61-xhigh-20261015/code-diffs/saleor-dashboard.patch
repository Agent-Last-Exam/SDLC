+import { act, fireEvent, render, screen } from "@testing-library/react";
+import { IntlProvider } from "react-intl";
+
+import SearchInput from "./SearchInput";
+
+jest.mock("@saleor/macaw-ui-next", () => ({
+  Box: ({ children }: { children: React.ReactNode }) => <div>{children}</div>,
+  SearchInput: (props: React.InputHTMLAttributes<HTMLInputElement>) => <input {...props} />,
+}));
+
+describe("bounded list search input", () => {
+  beforeEach(() => jest.useFakeTimers());
+  afterEach(() => jest.useRealTimers());
+
+  it("makes old results unavailable immediately and cancels an older valid debounce on invalid input", () => {
+    // Arrange
+    const onSearchChange = jest.fn();
+    const onSearchPending = jest.fn();
+
+    render(
+      <IntlProvider locale="en">
+        <SearchInput
+          initialSearch="old"
+          placeholder="Search"
+          searchMode="subject"
+          onSearchChange={onSearchChange}
+          onSearchPending={onSearchPending}
+        />
+      </IntlProvider>,
+    );
+    // Act
+    fireEvent.change(screen.getByRole("textbox"), { target: { value: "new" } });
+    expect(onSearchPending).toHaveBeenLastCalledWith(true);
+    fireEvent.change(screen.getByRole("textbox"), { target: { value: '"unclosed' } });
+    act(() => {
+      jest.advanceTimersByTime(600);
+    });
+    // Assert
+    expect(onSearchChange).not.toHaveBeenCalled();
+    expect(screen.getByRole("alert")).toBeInTheDocument();
+    expect(screen.getByRole("textbox")).toHaveAttribute("aria-invalid", "true");
+    fireEvent.change(screen.getByRole("textbox"), { target: { value: '"closed phrase"' } });
+    act(() => {
+      jest.advanceTimersByTime(500);
+    });
+    expect(onSearchChange).toHaveBeenLastCalledWith('"closed phrase"');
+  });
+
+  it("retains the complete long Unicode keyword and keeps Page/User basic mode without phrase rules", () => {
+    // Arrange
+    const onSearchChange = jest.fn();
+
+    render(
+      <IntlProvider locale="en">
+        <SearchInput initialSearch="" placeholder="Basic search" onSearchChange={onSearchChange} />
+      </IntlProvider>,
+    );
+
+    const keyword = "界".repeat(256);
+
+    // Act
+    fireEvent.change(screen.getByRole("textbox"), { target: { value: keyword } });
+    act(() => {
+      jest.advanceTimersByTime(500);
+    });
+    // Assert
+    expect(onSearchChange).toHaveBeenLastCalledWith(keyword);
+    expect(screen.getByRole("textbox")).toHaveAttribute("title", keyword);
+    fireEvent.change(screen.getByRole("textbox"), { target: { value: keyword + "界" } });
+    expect(screen.getByRole("textbox")).toHaveValue(keyword + "界");
+    expect(screen.getByRole("alert")).toBeInTheDocument();
+    fireEvent.change(screen.getByRole("textbox"), { target: { value: 'basic "literal' } });
+    act(() => {
+      jest.advanceTimersByTime(500);
+    });
+    expect(onSearchChange).toHaveBeenLastCalledWith('basic "literal');
+    expect(screen.queryByRole("alert")).not.toBeInTheDocument();
+  });
+});
