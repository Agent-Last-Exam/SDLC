+import { useMutation, useQuery } from "@apollo/client";
+import { useHasManagedAppsPermission } from "@dashboard/hooks/useHasManagedAppsPermission";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+
+import { AppExtensionSettingsCard, parseExtensionReplacement } from "./AppExtensionSettingsCard";
+
+jest.mock("@apollo/client", () => ({
+  ...jest.requireActual<typeof import("@apollo/client")>("@apollo/client"),
+  useQuery: jest.fn(),
+  useMutation: jest.fn(),
+}));
+jest.mock("@dashboard/hooks/useHasManagedAppsPermission");
+jest.mock("react-intl", () => ({
+  ...jest.requireActual<typeof import("react-intl")>("react-intl"),
+  useIntl: () => ({
+    formatMessage: (message: { defaultMessage: string }, values?: Record<string, unknown>) =>
+      message.defaultMessage.replace(/\{(\w+)\}/g, (_match, key: string) =>
+        String(values?.[key] ?? `{${key}}`),
+      ),
+  }),
+}));
+
+const extension = {
+  id: "extension",
+  label: "Extension",
+  url: "/path",
+  mountName: "PRODUCT_DETAILS_MORE_ACTIONS",
+  targetName: "POPUP",
+  settings: {},
+  permissions: [],
+};
+const app = { id: "app", settingsVersion: 4, extensions: [extension] };
+const update = jest.fn();
+const refetch = jest.fn();
+const draft = JSON.stringify([{ ...extension, label: "Draft" }]);
+
+const prepare = () => {
+  render(<AppExtensionSettingsCard appId="app" />);
+
+  const editor = screen.getByRole("textbox", { name: "Extensions JSON" });
+
+  fireEvent.change(editor, { target: { value: draft } });
+
+  return editor;
+};
+
+describe("extension settings atomic replacement", () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+    (useHasManagedAppsPermission as jest.Mock).mockReturnValue({ hasManagedAppsPermission: true });
+    (useQuery as jest.Mock).mockReturnValue({ data: { app }, loading: false, refetch });
+    (useMutation as jest.Mock).mockReturnValue([update, { loading: false }]);
+    refetch.mockResolvedValue({ data: { app: { ...app, settingsVersion: 7 } } });
+  });
+
+  it("keeps owned IDs and normalizes current fields", () => {
+    // Arrange / Act
+    const result = parseExtensionReplacement(
+      JSON.stringify([extension, { ...extension, id: undefined, label: "New" }]),
+      ["extension"],
+    );
+
+    // Assert
+    expect(result[0]).toEqual(extension);
+    expect(result[1]).not.toHaveProperty("id");
+  });
+
+  it.each([
+    {},
+    [{ ...extension, id: "foreign" }],
+    [extension, extension],
+    [{ ...extension, mount: "PRODUCT_DETAILS_MORE_ACTIONS" }],
+    [{ ...extension, settings: { method: "POST" } }],
+  ])("rejects the complete replacement if any input is invalid %#", input => {
+    // Arrange / Act / Assert
+    expect(() => parseExtensionReplacement(JSON.stringify(input), ["extension"])).toThrow();
+  });
+
+  it("requires MANAGE_APPS", () => {
+    // Arrange
+    (useHasManagedAppsPermission as jest.Mock).mockReturnValue({ hasManagedAppsPermission: false });
+
+    // Act
+    render(<AppExtensionSettingsCard appId="app" />);
+
+    // Assert
+    expect(screen.queryByRole("textbox")).not.toBeInTheDocument();
+    expect(useQuery).toHaveBeenCalledWith(
+      expect.anything(),
+      expect.objectContaining({ skip: true }),
+    );
+  });
+
+  it("submits the complete list with expectedVersion and confirms an increased version", async () => {
+    // Arrange
+    update.mockResolvedValue({
+      data: {
+        appUpdate: {
+          app: { ...app, settingsVersion: 5, extensions: [{ ...extension, label: "Draft" }] },
+          errors: [],
+        },
+      },
+    });
+    prepare();
+
+    // Act
+    fireEvent.click(screen.getByRole("button", { name: "Save settings" }));
+    await screen.findByText("Extension settings saved.");
+
+    // Assert
+    expect(update).toHaveBeenCalledWith({
+      variables: {
+        id: "app",
+        input: { expectedVersion: 4, extensions: [{ ...extension, label: "Draft" }] },
+      },
+    });
+    expect(screen.getByText("Settings version: 5")).toBeInTheDocument();
+  });
+
+  it("preserves a conflict draft and requires explicit reload, never automatic retry", async () => {
+    // Arrange
+    update.mockResolvedValue({
+      data: { appUpdate: { app: null, errors: [{ code: "CONFLICT" }] } },
+    });
+
+    const editor = prepare();
+
+    // Act
+    fireEvent.click(screen.getByRole("button", { name: "Save settings" }));
+    await screen.findByText(
+      "Settings changed on the server. Your draft is kept. Reload to review the latest version before resubmitting.",
+    );
+
+    // Assert
+    expect(editor).toHaveValue(draft);
+    expect(update).toHaveBeenCalledTimes(1);
+    expect(refetch).not.toHaveBeenCalled();
+    expect(screen.getByRole("button", { name: "Save settings" })).toBeDisabled();
+    fireEvent.change(editor, { target: { value: `${draft} ` } });
+    expect(screen.getByRole("button", { name: "Save settings" })).toBeDisabled();
+
+    // Act
+    fireEvent.click(screen.getByRole("button", { name: "Reload settings (discard draft)" }));
+    await screen.findByText("Settings version: 7");
+
+    // Assert
+    expect(editor).not.toHaveValue(draft);
+    expect(screen.getByRole("button", { name: "Save settings" })).toBeEnabled();
+  });
+
+  it.each([
+    {},
+    { data: { appUpdate: null } },
+    { data: { appUpdate: { app, errors: [] } } },
+    { data: { appUpdate: { app: { ...app, id: "other", settingsVersion: 5 }, errors: [] } } },
+    {
+      data: { appUpdate: { app: { ...app, settingsVersion: 5 }, errors: [] } },
+      errors: [{ message: "top-level failure" }],
+    },
+  ])("never claims save for missing, stale or erroneous payload %#", async result => {
+    // Arrange
+    update.mockResolvedValue(result);
+
+    const editor = prepare();
+
+    // Act
+    fireEvent.click(screen.getByRole("button", { name: "Save settings" }));
+    await screen.findByText("Settings were not saved. Your draft is kept.");
+
+    // Assert
+    expect(editor).toHaveValue(draft);
+    expect(screen.queryByText("Extension settings saved.")).not.toBeInTheDocument();
+  });
+
+  it("does not overwrite a later local revision on successful acceptance", async () => {
+    // Arrange
+    let resolve: (result: unknown) => void = () => {
+      throw new Error("The settings request has not started.");
+    };
+
+    update.mockReturnValue(
+      new Promise(result => {
+        resolve = result;
+      }),
+    );
+
+    const editor = prepare();
+
+    // Act
+    fireEvent.click(screen.getByRole("button", { name: "Save settings" }));
+    fireEvent.change(editor, { target: { value: "later draft" } });
+    resolve({ data: { appUpdate: { app: { ...app, settingsVersion: 5 }, errors: [] } } });
+    await waitFor(() => expect(screen.getByText("Settings version: 5")).toBeInTheDocument());
+
+    // Assert
+    expect(editor).toHaveValue("later draft");
+    expect(screen.queryByText("Extension settings saved.")).not.toBeInTheDocument();
+  });
+});
