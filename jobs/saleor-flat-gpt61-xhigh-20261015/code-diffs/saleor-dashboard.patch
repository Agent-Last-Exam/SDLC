+import { z } from "zod";
+
+import { httpUrlSchema } from "./urls";
+
+const localized = z.object({ en: z.string().min(1) }).catchall(z.string());
+const logo = z
+  .object({
+    light: z.object({ source: httpUrlSchema }).strict(),
+    dark: z.object({ source: httpUrlSchema }).strict(),
+  })
+  .strict();
+const common = {
+  id: z.string().min(1),
+  name: localized,
+  description: localized,
+  logo,
+  installed: z.boolean().optional(),
+  disabled: z.boolean().optional(),
+};
+const extension = z.discriminatedUnion("type", [
+  z
+    .object({
+      ...common,
+      type: z.literal("APP"),
+      kind: z.enum(["OFFICIAL", "OSS"]),
+      manifestUrl: httpUrlSchema.nullable(),
+      repositoryUrl: httpUrlSchema.nullable(),
+      isCustomApp: z.boolean().optional(),
+      appId: z.string().min(1).optional(),
+    })
+    .strict(),
+  z.object({ ...common, type: z.literal("PLUGIN") }).strict(),
+]);
+
+export const catalogSchema = z
+  .array(
+    z
+      .object({
+        id: z.enum(["payments", "taxes", "cms", "automation"]),
+        name: localized,
+        extensions: z
+          .array(extension)
+          .refine(
+            items => new Set(items.map(item => item.id)).size === items.length,
+            "Duplicate extension ID in group.",
+          ),
+      })
+      .strict(),
+  )
+  .refine(
+    groups => new Set(groups.map(group => group.id)).size === groups.length,
+    "Duplicate group ID.",
