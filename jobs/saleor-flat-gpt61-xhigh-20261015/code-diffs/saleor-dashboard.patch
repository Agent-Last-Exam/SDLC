+import { FormResult } from "@dashboard/extensions/components/AppExtensionContext/useAppFormExtension";
+import { Box, Text } from "@saleor/macaw-ui-next";
+import { FormattedMessage } from "react-intl";
+
+export const TranslationAppFeedback = ({ result }: { result?: FormResult }) => {
+  if (!result) return null;
+
+  return (
+    <Box
+      padding={4}
+      marginBottom={4}
+      borderStyle="solid"
+      borderWidth={1}
+      borderColor="default1"
+      role={
+        result.status === "VALIDATION_ERROR" || result.status === "PERMISSION_ERROR"
+          ? "alert"
+          : "status"
+      }
+    >
+      {result.status === "SUCCESS" && (
+        <Text>
+          <FormattedMessage
+            id="m/Y4dM"
+            defaultMessage="App values have been added to the translation draft. Review and save each edited field to apply them."
+          />
+        </Text>
+      )}
+      {result.status === "PERMISSION_ERROR" && (
+        <Text>
+          <FormattedMessage
+            id="/kkQp6"
+            defaultMessage="The App could not access this translation. Your draft has not changed."
+          />
+        </Text>
+      )}
+      {result.status === "CLOSED" && (
+        <Text>
+          <FormattedMessage
+            id="9OkQy4"
+            defaultMessage="The App was closed. Your translation draft has not changed."
+          />
+        </Text>
+      )}
+      {result.status === "VALIDATION_ERROR" && (
+        <>
+          <Text>
+            <FormattedMessage
+              id="eRPlac"
+              defaultMessage="The App returned validation errors. The preview below has not been added to your draft or saved."
+            />
+          </Text>
+          <ul>
+            {result.errors.map((error, index) => (
+              <li key={`${error.field}:${index}`}>
+                {error.field}: {error.message || error.code}
+              </li>
+            ))}
+          </ul>
+          {result.previewValues && Object.keys(result.previewValues).length > 0 && (
+            <>
+              <Text fontWeight="bold">
+                <FormattedMessage id="GnzcER" defaultMessage="App preview (not saved)" />
+              </Text>
+              <dl>
+                {Object.entries(result.previewValues).map(([field, value]) => (
+                  <div key={field}>
+                    <dt>{field}</dt>
+                    <dd>
+                      <pre style={{ whiteSpace: "pre-wrap", overflowWrap: "anywhere" }}>
+                        {typeof value === "string" ? value : JSON.stringify(value, null, 2)}
+                      </pre>
+                    </dd>
+                  </div>
+                ))}
+              </dl>
+            </>
+          )}
+        </>
+      )}
+    </Box>
+  );
+};
