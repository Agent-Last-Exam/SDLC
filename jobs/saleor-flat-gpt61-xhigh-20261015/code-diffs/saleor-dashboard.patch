+import { ConfirmButton } from "@dashboard/components/ConfirmButton";
+import { DashboardModal } from "@dashboard/components/Modal";
+import { ExportScope, FileTypesEnum } from "@dashboard/graphql";
+import { Box, Button, Text } from "@saleor/macaw-ui-next";
+import { DocumentNode } from "graphql";
+import { useState } from "react";
+import { FormattedMessage, useIntl } from "react-intl";
+
+import { hasScopeConstraints, scopeFingerprint, uniqueIds } from "./effectiveScope";
+import { ExportDomain, useScopedExport } from "./useScopedExport";
+
+export const hasExportConstraints = (scope: object): boolean => {
+  const { sortBy: _sort, ...filters } = scope as Record<string, unknown>;
+
+  return hasScopeConstraints(filters);
+};
+
+export const scopedExportInput = <T extends object>(
+  scope: T,
+  selection: string[],
+  exportScope: ExportScope,
+  fileType: FileTypesEnum,
+) => {
+  if (exportScope === ExportScope.ALL && hasExportConstraints(scope))
+    throw new Error("ALL cannot discard the current scope");
+
+  if (exportScope === ExportScope.IDS && !selection.length) throw new Error("No current selection");
+
+  return {
+    ...scope,
+    scope: exportScope,
+    fileType,
+    ids: exportScope === ExportScope.IDS ? uniqueIds(selection) : undefined,
+  };
+};
+
+/** Mounted only from an explicit export action; the list owns the current scope. */
+export const ScopedExportDialog = ({
+  open,
+  onClose,
+  domain,
+  document,
+  field,
+  scope,
+  ids,
+  ready,
+}: {
+  open: boolean;
+  onClose: () => void;
+  domain: ExportDomain;
+  document: DocumentNode;
+  field: string;
+  scope: object;
+  ids: string[];
+  ready: boolean;
+}) => {
+  const intl = useIntl();
+  const exporter = useScopedExport(
+    domain,
+    document,
+    field,
+    scopeFingerprint({ open, scope, ids, ready }),
+  );
+  const [selected, setSelected] = useState(ExportScope.FILTER);
+  const [fileType, setFileType] = useState(FileTypesEnum.CSV);
+  // If the list changes while open, ALL/IDS must never become a broader request.
+  const invalid =
+    (selected === ExportScope.ALL && hasExportConstraints(scope)) ||
+    (selected === ExportScope.IDS && !ids.length);
+
+  return (
+    <DashboardModal open={open && exporter.allowed} onChange={onClose}>
+      <DashboardModal.Content size="sm">
+        <DashboardModal.Header>
+          <FormattedMessage id="Oa1QFm" defaultMessage="Export current scope" />
+        </DashboardModal.Header>
+        <Box display="flex" flexDirection="column" gap={3}>
+          <label>
+            {intl.formatMessage({ id: "c2Bvpf", defaultMessage: "Export rows" })}
+            <select
+              value={selected}
+              onChange={event => setSelected(event.target.value as ExportScope)}
+            >
+              <option value={ExportScope.FILTER}>
+                {intl.formatMessage({
+                  id: "GuIwuA",
+                  defaultMessage: "All matching rows (not just this page)",
+                })}
+              </option>
+              <option value={ExportScope.IDS} disabled={!ids.length}>
+                {intl.formatMessage({
+                  id: "Gef4sP",
+                  defaultMessage: "Selected rows",
+                })}
+              </option>
+              <option value={ExportScope.ALL} disabled={hasExportConstraints(scope)}>
+                {intl.formatMessage({
+                  id: "oYAYFi",
+                  defaultMessage: "All rows (unrestricted scope only)",
+                })}
+              </option>
+            </select>
+          </label>
+          <label>
+            {intl.formatMessage({ id: "PVHvsl", defaultMessage: "File format" })}
+            <select
+              value={fileType}
+              onChange={event => setFileType(event.target.value as FileTypesEnum)}
+            >
+              <option value={FileTypesEnum.CSV}>CSV</option>
+              <option value={FileTypesEnum.XLSX}>XLSX</option>
+            </select>
+          </label>
+          {exporter.errors.map((error, index) => (
+            <Text key={index} role="alert">
+              {error.message ?? error.code}
+            </Text>
+          ))}
+        </Box>
+        <DashboardModal.Actions>
+          <Button variant="secondary" onClick={onClose}>
+            <FormattedMessage id="47FYwb" defaultMessage="Cancel" />
+          </Button>
+          <ConfirmButton
+            transitionState={exporter.status}
+            disabled={!ready || invalid}
+            onClick={async () => {
+              if (!ready || invalid) return;
+
+              const input = scopedExportInput(scope, ids, selected, fileType);
+
+              if (await exporter.submit(input, ready)) onClose();
+            }}
+          >
+            <FormattedMessage id="7bRbxA" defaultMessage="Request export" />
+          </ConfirmButton>
+        </DashboardModal.Actions>
+      </DashboardModal.Content>
+    </DashboardModal>
+  );
+};
