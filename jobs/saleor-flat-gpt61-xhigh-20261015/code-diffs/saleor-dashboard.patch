--- /dev/null
+++ b/src/siteSettings/useSiteSettings.ts
@@ -0,0 +1,161 @@
+import { useApolloClient } from "@apollo/client";
+import { ConfirmButtonTransitionState } from "@dashboard/components/ConfirmButton";
+import {
+  ShopErrorCode,
+  ShopErrorFragment,
+  ShopSettingsUpdateDocument,
+  ShopSettingsUpdateMutation,
+  ShopSettingsUpdateMutationVariables,
+  SiteSettingsDocument,
+  SiteSettingsQuery,
+} from "@dashboard/graphql";
+import { useEffect, useRef, useState } from "react";
+
+const failure = (message: string): ShopErrorFragment[] => [
+  { __typename: "ShopError", code: ShopErrorCode.INVALID, field: null, message },
+];
+
+export function useSiteSettings(enabled: boolean) {
+  const client = useApolloClient();
+  const generation = useRef(0);
+  const submission = useRef(0);
+  const [shop, setShop] = useState<SiteSettingsQuery["shop"]>();
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState(false);
+  const [errors, setErrors] = useState<ShopErrorFragment[]>([]);
+  const [status, setStatus] = useState<ConfirmButtonTransitionState>("default");
+  const reload = async () => {
+    if (!enabled) {
+      return;
+    }
+
+    const request = ++generation.current;
+
+    setLoading(true);
+    setError(false);
+
+    try {
+      const result = await client.query<SiteSettingsQuery>({
+        query: SiteSettingsDocument,
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+      });
+
+      if (request !== generation.current) {
+        return;
+      }
+
+      if (!result.data?.shop || !Number.isInteger(result.data.shop.settingsVersion)) {
+        throw new Error("Incomplete shop settings response");
+      }
+
+      setShop(result.data.shop);
+    } catch {
+      if (request === generation.current) {
+        setError(true);
+      }
+    } finally {
+      if (request === generation.current) {
+        setLoading(false);
+      }
+    }
+  };
+
+  useEffect(() => {
+    if (enabled) {
+      reload();
+    } else {
+      setLoading(false);
+    }
+
+    return () => {
+      generation.current += 1;
+      submission.current += 1;
+    };
+  }, [enabled]);
+
+  const update = async (variables: ShopSettingsUpdateMutationVariables) => {
+    const request = ++submission.current;
+
+    generation.current += 1;
+    setStatus("loading");
+    setErrors([]);
+
+    try {
+      const expectedVersion = variables.shopSettingsInput.expectedVersion;
+
+      if (typeof expectedVersion !== "number" || !Number.isInteger(expectedVersion)) {
+        throw new Error("Reload the shop settings before saving.");
+      }
+
+      const result = await client.mutate<
+        ShopSettingsUpdateMutation,
+        ShopSettingsUpdateMutationVariables
+      >({
+        mutation: ShopSettingsUpdateDocument,
+        variables,
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+      });
+      const payload = result.data?.shopSettingsUpdate;
+      const saved = payload?.shop;
+      const address = result.data?.shopAddressUpdate;
+      const payloadErrors = [...(payload?.errors ?? []), ...(address?.errors ?? [])];
+      const errors = payloadErrors.length
+        ? payloadErrors
+        : !payload ||
+            !Array.isArray(payload.errors) ||
+            !saved ||
+            !Number.isInteger(saved.settingsVersion) ||
+            saved.settingsVersion <= expectedVersion ||
+            (variables.updateAddress && (!address?.shop || !Array.isArray(address.errors)))
+          ? failure("The settings save could not be confirmed. Please reload and try again.")
+          : [];
+
+      if (request !== submission.current) {
+        return failure("This response belongs to an earlier settings save.");
+      }
+
+      if (errors.length) {
+        setErrors(errors);
+        setStatus("error");
+
+        if (errors.some(error => error.code === ShopErrorCode.CONFLICT)) {
+          await reload();
+        }
+
+        return errors;
+      }
+
+      if (!saved) {
+        throw new Error("The saved shop settings are missing.");
+      }
+
+      const next = {
+        ...saved,
+        companyAddress: address?.shop?.companyAddress ?? saved.companyAddress,
+      };
+      const cached = client.cache.readQuery<SiteSettingsQuery>({ query: SiteSettingsDocument });
+
+      if (!cached || cached.shop.settingsVersion <= next.settingsVersion) {
+        client.cache.writeQuery({ query: SiteSettingsDocument, data: { shop: next } });
+      }
+
+      setShop(next);
+      setStatus("success");
+
+      return [];
+    } catch {
+      const errors = failure("Settings were not confirmed saved. Check your connection and retry.");
+
+      if (request === submission.current) {
+        setErrors(errors);
+        setStatus("error");
+      }
+
+      return errors;
+    }
+  };
+
+  return { shop, loading, error, errors, status, reload, update };
+}
