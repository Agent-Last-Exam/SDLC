+import { ProductVariantFragment, WeightUnitsEnum } from "@dashboard/graphql";
+import { act, fireEvent, render, screen } from "@testing-library/react";
+import { IntlProvider } from "react-intl";
+
+import { ProductVariantUpdateForm } from "./form";
+
+jest.mock("@dashboard/components/Datagrid/customCells/PillCell", () => ({
+  hueToPillColorDark: jest.fn(),
+  hueToPillColorLight: jest.fn(),
+}));
+jest.mock("@dashboard/utils/richText/useMultipleRichText", () => ({
+  useMultipleRichText: () => ({ getters: {}, getValues: async () => ({}) }),
+}));
+
+const makeVariant = (value: number, unit: WeightUnitsEnum): ProductVariantFragment =>
+  ({
+    id: "variant-1",
+    name: "Ordinary variant",
+    sku: "variant-sku",
+    trackInventory: true,
+    weight: { value, unit },
+    metadata: [],
+    privateMetadata: [],
+    selectionAttributes: [],
+    nonSelectionAttributes: [],
+    stocks: [],
+    channelListings: [],
+    media: [],
+    product: { id: "product-1", channelListings: [] },
+  }) as unknown as ProductVariantFragment;
+
+const renderForm = (
+  variant: ProductVariantFragment,
+  unit: WeightUnitsEnum | undefined,
+  onSubmit = jest.fn(async () => []),
+) => {
+  const form = (nextVariant: ProductVariantFragment, nextUnit: WeightUnitsEnum | undefined) => (
+    <IntlProvider locale="en">
+      <ProductVariantUpdateForm
+        variant={nextVariant}
+        defaultWeightUnit={nextUnit as WeightUnitsEnum}
+        loading={false}
+        onSubmit={onSubmit}
+        currentChannels={[]}
+        referencePages={[]}
+        referenceProducts={[]}
+        referenceCategories={[]}
+        referenceCollections={[]}
+      >
+        {({ data, change, submit, isSaveDisabled, validationErrors }) => (
+          <>
+            <input
+              aria-label="Variant weight"
+              name="weight"
+              value={data.weight}
+              onChange={change}
+            />
+            <button disabled={isSaveDisabled} onClick={() => void submit()} type="button">
+              Save variant
+            </button>
+            <output aria-label="Validation errors">{validationErrors.length}</output>
+          </>
+        )}
+      </ProductVariantUpdateForm>
+    </IntlProvider>
+  );
+  const rendered = render(form(variant, unit));
+
+  return {
+    ...rendered,
+    onSubmit,
+    rerenderForm: (nextVariant: ProductVariantFragment, nextUnit: WeightUnitsEnum | undefined) =>
+      rendered.rerender(form(nextVariant, nextUnit)),
+  };
+};
+
+describe("variant weight form integration", () => {
+  it.each([
+    [1, WeightUnitsEnum.KG],
+    [1000, WeightUnitsEnum.G],
+    [0.001, WeightUnitsEnum.TONNE],
+  ])("submits equivalent %s %s source weights in the shop unit", async (value, unit) => {
+    // Arrange
+    const { onSubmit } = renderForm(makeVariant(value, unit), WeightUnitsEnum.KG);
+
+    // Act
+    await act(async () => {
+      fireEvent.click(screen.getByRole("button", { name: "Save variant" }));
+    });
+
+    // Assert
+    expect(screen.getByLabelText("Variant weight")).toHaveValue("1");
+    expect(onSubmit).toHaveBeenCalledWith(
+      expect.objectContaining({
+        weight: "1",
+        sku: "variant-sku",
+        variantName: "Ordinary variant",
+      }),
+    );
+  });
+
+  it("disables saving and leaves the value blank until the shop unit loads", () => {
+    // Arrange
+    renderForm(makeVariant(1000, WeightUnitsEnum.G), undefined);
+
+    // Act / Assert
+    expect(screen.getByLabelText("Variant weight")).toHaveValue("");
+    expect(screen.getByRole("button", { name: "Save variant" })).toBeDisabled();
+  });
+
+  it("does not relabel a dirty draft when the shop unit changes", () => {
+    // Arrange
+    const variant = makeVariant(1000, WeightUnitsEnum.G);
+    const { rerenderForm } = renderForm(variant, WeightUnitsEnum.KG);
+
+    // Act
+    fireEvent.change(screen.getByLabelText("Variant weight"), { target: { value: "2" } });
+    rerenderForm(variant, WeightUnitsEnum.LB);
+
+    // Assert
+    expect(screen.getByLabelText("Variant weight")).not.toHaveValue("2");
+    expect(screen.getByLabelText("Variant weight")).toHaveValue(
+      "2.204622621848775807229738013450270338542",
+    );
+  });
+
+  it("preserves a tiny conversion instead of submitting zero", async () => {
+    // Arrange
+    const { onSubmit } = renderForm(makeVariant(1, WeightUnitsEnum.G), WeightUnitsEnum.TONNE);
+
+    // Act
+    await act(async () => {
+      fireEvent.click(screen.getByRole("button", { name: "Save variant" }));
+    });
+
+    // Assert
+    expect(onSubmit).toHaveBeenCalledWith(expect.objectContaining({ weight: "0.000001" }));
+  });
+
+  it("rejects an invalid decimal without invoking the mutation", async () => {
+    // Arrange
+    const { onSubmit } = renderForm(makeVariant(1, WeightUnitsEnum.KG), WeightUnitsEnum.KG);
+
+    // Act
+    fireEvent.change(screen.getByLabelText("Variant weight"), { target: { value: "1kg" } });
+    await act(async () => {
+      fireEvent.click(screen.getByRole("button", { name: "Save variant" }));
+    });
+
+    // Assert
+    expect(onSubmit).not.toHaveBeenCalled();
+    expect(screen.getByLabelText("Validation errors")).toHaveTextContent("1");
+  });
+
+  it("fails closed on an unsupported API source unit without crashing the form", () => {
+    // Arrange
+    renderForm(makeVariant(1, "STONE" as WeightUnitsEnum), WeightUnitsEnum.KG);
+
+    // Act / Assert
+    expect(screen.getByLabelText("Variant weight")).toHaveValue("");
+    expect(screen.getByRole("button", { name: "Save variant" })).toBeDisabled();
+  });
+});
