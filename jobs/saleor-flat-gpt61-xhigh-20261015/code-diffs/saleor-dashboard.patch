+export const MAX_SEARCH_LENGTH = 256;
+export type SearchMode = "subject" | "basic";
+export type SearchValidationError = "tooLong" | "controlCharacter" | "unclosedQuote";
+
+/** Validate input only. Core owns matching, normalization, prefix and relevance semantics. */
+export const validateSearch = (
+  value = "",
+  mode: SearchMode = "basic",
+): SearchValidationError | undefined => {
+  if (Array.from(value).length > MAX_SEARCH_LENGTH) return "tooLong";
+
+  if (
+    Array.from(value).some(
+      character => character.codePointAt(0)! < 32 || character.codePointAt(0) === 127,
+    )
+  )
+    return "controlCharacter";
+
+  if (mode === "subject" && (value.match(/"/g)?.length ?? 0) % 2 !== 0) return "unclosedQuote";
+
+  return undefined;
+};
+
+export const searchQuery = (value?: string): string | undefined => value?.trim() || undefined;
