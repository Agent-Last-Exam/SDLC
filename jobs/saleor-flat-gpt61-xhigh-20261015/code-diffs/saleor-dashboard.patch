@@ -0,0 +1,212 @@
+import { useApolloClient } from "@apollo/client";
+import { useUserPermissions } from "@dashboard/auth/hooks/useUserPermissions";
+import { DashboardCard } from "@dashboard/components/Card";
+import { hasPermissions } from "@dashboard/components/RequirePermissions";
+import {
+  OrderRootTransactionsQuery,
+  PermissionEnum,
+  TransactionActionEnum,
+} from "@dashboard/graphql";
+import { orderRootTransactionsQuery } from "@dashboard/orders/queries";
+import { TextField } from "@material-ui/core";
+import { Box, Button, Text } from "@saleor/macaw-ui-next";
+import { useEffect, useId, useLayoutEffect, useRef, useState } from "react";
+import { FormattedMessage, useIntl } from "react-intl";
+
+import OrderTransaction from "../OrderTransaction";
+
+/** Basic transaction lookup is always intersected with this order, never a report. */
+export const OrderRootTransactions = ({
+  orderId,
+  onTransactionAction,
+}: {
+  orderId: string;
+  onTransactionAction: (id: string, action: TransactionActionEnum) => void;
+}) => {
+  const client = useApolloClient();
+  const intl = useIntl();
+  const locatorId = useId();
+  const permissions = useUserPermissions();
+  const allowed = hasPermissions(permissions ?? [], [PermissionEnum.HANDLE_PAYMENTS]);
+  const [locator, setLocator] = useState({ ids: "", pspReference: "", appIdentifier: "" });
+  const [filter, setFilter] = useState(locator);
+  const [after, setAfter] = useState<string | undefined>();
+  const [revision, setRevision] = useState(0);
+  const key = JSON.stringify([orderId, allowed, filter, after, revision]);
+  const current = useRef(key);
+
+  useLayoutEffect(() => {
+    current.current = key;
+  }, [key]);
+
+  const [state, setState] = useState<{
+    key: string;
+    data?: OrderRootTransactionsQuery;
+    error?: boolean;
+    loading: boolean;
+  }>({ key, loading: allowed && !!orderId });
+
+  if (state.key !== key) {
+    setState({ key, loading: allowed && !!orderId });
+  }
+
+  useEffect(() => {
+    let active = true;
+
+    if (!allowed || !orderId) {
+      return;
+    }
+
+    const ids = filter.ids
+      .split(",")
+      .map(id => id.trim())
+      .filter(Boolean);
+
+    client
+      .query<OrderRootTransactionsQuery>({
+        query: orderRootTransactionsQuery,
+        variables: {
+          first: 25,
+          after,
+          filter: {
+            orderIds: [orderId],
+            ...(filter.ids ? { ids } : {}),
+            ...(filter.pspReference ? { pspReference: filter.pspReference } : {}),
+            ...(filter.appIdentifier ? { appIdentifier: filter.appIdentifier } : {}),
+          },
+        },
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+      })
+      .then(result => {
+        if (active && current.current === key) {
+          if (result.errors?.length || !result.data?.transactions) {
+            throw new Error("Missing transactions connection");
+          }
+
+          setState({ key, data: result.data, loading: false });
+        }
+      })
+      .catch(() => {
+        if (active && current.current === key) {
+          setState({ key, error: true, loading: false });
+        }
+      });
+
+    return () => {
+      active = false;
+    };
+  }, [key, client, orderId, allowed, after, filter.ids, filter.pspReference, filter.appIdentifier]);
+
+  const scoped = state.key === key ? state : { loading: true, data: undefined, error: false };
+
+  if (!allowed) {
+    return (
+      <Text>
+        <FormattedMessage
+          defaultMessage="Transaction details require HANDLE_PAYMENTS permission."
+          id="OHh2K1"
+        />
+      </Text>
+    );
+  }
+
+  return (
+    <DashboardCard>
+      <DashboardCard.Header>
+        <DashboardCard.Title>
+          <FormattedMessage defaultMessage="Transactions" id="/jJLYy" />
+        </DashboardCard.Title>
+      </DashboardCard.Header>
+      <DashboardCard.Content>
+        <Box display="grid" gap={3}>
+          <Text>
+            <FormattedMessage
+              defaultMessage="Scope locked to this order. Locators are combined with AND; comma-separated transaction IDs use OR."
+              id="zGbIMV"
+            />
+          </Text>
+          <TextField
+            id={`${locatorId}-ids`}
+            label={intl.formatMessage({ defaultMessage: "Transaction IDs", id: "ydbpJJ" })}
+            value={locator.ids}
+            onChange={event => setLocator({ ...locator, ids: event.target.value })}
+          />
+          <TextField
+            id={`${locatorId}-psp`}
+            label={intl.formatMessage({ defaultMessage: "PSP reference", id: "5jNyR5" })}
+            value={locator.pspReference}
+            onChange={event => setLocator({ ...locator, pspReference: event.target.value })}
+          />
+          <TextField
+            id={`${locatorId}-app`}
+            label={intl.formatMessage({ defaultMessage: "App identifier", id: "DWN93O" })}
+            value={locator.appIdentifier}
+            onChange={event => setLocator({ ...locator, appIdentifier: event.target.value })}
+          />
+          <Box display="flex" gap={2}>
+            <Button
+              onClick={() => {
+                setFilter(locator);
+                setAfter(undefined);
+                setRevision(value => value + 1);
+              }}
+              disabled={scoped.loading}
+            >
+              <FormattedMessage defaultMessage="Find transactions" id="rKW2lO" />
+            </Button>
+            <Button
+              variant="secondary"
+              onClick={() => setRevision(value => value + 1)}
+              disabled={scoped.loading}
+            >
+              <FormattedMessage defaultMessage="Refresh" id="rELDbB" />
+            </Button>
+            {after && (
+              <Button variant="secondary" onClick={() => setAfter(undefined)}>
+                <FormattedMessage defaultMessage="First page" id="A64Z+T" />
+              </Button>
+            )}
+          </Box>
+          {scoped.loading && (
+            <Text role="status">
+              <FormattedMessage defaultMessage="Loading transactions…" id="Ug3TEV" />
+            </Text>
+          )}
+          {scoped.error && (
+            <Text color="critical1">
+              <FormattedMessage
+                defaultMessage="Transactions could not be loaded. Refresh to retry."
+                id="751eUT"
+              />
+            </Text>
+          )}
+          {!scoped.loading && !scoped.error && scoped.data?.transactions?.edges.length === 0 && (
+            <Text>
+              <FormattedMessage
+                defaultMessage="No transactions match this order and these locators."
+                id="HT+Tn5"
+              />
+            </Text>
+          )}
+          {scoped.data?.transactions?.edges.map(({ node }, index) => (
+            <OrderTransaction
+              key={node.id}
+              transaction={{ ...node, index }}
+              onTransactionAction={onTransactionAction}
+            />
+          ))}
+          {scoped.data?.transactions?.pageInfo.hasNextPage && (
+            <Button
+              variant="secondary"
+              onClick={() => setAfter(scoped.data?.transactions?.pageInfo.endCursor ?? undefined)}
+              disabled={scoped.loading}
+            >
+              <FormattedMessage defaultMessage="Next page" id="rBj9Ib" />
+            </Button>
+          )}
+        </Box>
+      </DashboardCard.Content>
+    </DashboardCard>
+  );
+};
