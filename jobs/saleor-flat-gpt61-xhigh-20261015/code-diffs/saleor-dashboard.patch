@@ -0,0 +1,53 @@
+import { Box, Button, Text } from "@saleor/macaw-ui-next";
+import { FormattedMessage } from "react-intl";
+
+import { useConditionalFilterContext } from "./context";
+import { FilterContainer, FilterElement } from "./FilterElement";
+
+const labels = (filters: FilterContainer): string[] =>
+  filters.flatMap(item => {
+    if (Array.isArray(item)) return labels(item);
+
+    if (!FilterElement.isCompatible(item)) return [];
+
+    const value = item.condition.selected.value;
+    const description = typeof value === "object" ? JSON.stringify(value) : String(value ?? "");
+
+    return [`${item.value.label}: ${description}`];
+  });
+
+/** Trusted context stays visible and has no remove/clear affordance. */
+export const LockedScope = () => {
+  const { lockedFilters = [], valueProvider } = useConditionalFilterContext();
+
+  return (
+    <>
+      {lockedFilters.length > 0 && (
+        <Box paddingX={6} paddingY={2} display="flex" gap={2} flexWrap="wrap">
+          {labels(lockedFilters).map((label, index) => (
+            <Text key={`${index}-${label}`} title={label}>
+              <FormattedMessage
+                id="1LMrOu"
+                defaultMessage="Locked: {condition}"
+                values={{ condition: label }}
+              />
+            </Text>
+          ))}
+        </Box>
+      )}
+      {valueProvider.error && (
+        <Box role="alert" padding={4}>
+          <Text>
+            <FormattedMessage
+              id="BdCZUx"
+              defaultMessage="Filters could not be loaded. Previous results cannot be used."
+            />
+          </Text>
+          <Button variant="secondary" onClick={valueProvider.retry}>
+            <FormattedMessage id="PZDIsm" defaultMessage="Retry filters" />
+          </Button>
+        </Box>
+      )}
+    </>
+  );
+};
