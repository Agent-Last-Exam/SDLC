@@ -0,0 +1,47 @@
+import { z } from "zod";
+
+export const hasUnsafeUrlCharacters = (value: string) =>
+  Array.from(value).some(character => {
+    const code = character.charCodeAt(0);
+
+    return (
+      /\s/u.test(character) || code <= 32 || (code >= 127 && code <= 159) || character === "\\"
+    );
+  });
+
+export const httpUrlSchema = z
+  .string()
+  .regex(/^https?:\/\//)
+  .refine(value => {
+    if (hasUnsafeUrlCharacters(value)) return false;
+
+    try {
+      const url = new URL(value);
+
+      return (
+        ["https:", "http:"].includes(url.protocol) &&
+        !!url.hostname &&
+        !url.username &&
+        !url.password
+      );
+    } catch {
+      return false;
+    }
+  });
+export const relativePathSchema = z
+  .string()
+  .refine(
+    value => value.startsWith("/") && !value.startsWith("//") && !hasUnsafeUrlCharacters(value),
+  );
+export const extensionUrlSchema = z.union([httpUrlSchema, relativePathSchema]);
+export const resolveExtensionUrl = (url: string, appUrl?: string | null) => {
+  if (!extensionUrlSchema.safeParse(url).success) return null;
+
+  try {
+    const resolved = new URL(url, appUrl ?? undefined).toString();
+
+    return httpUrlSchema.safeParse(resolved).success ? resolved : null;
+  } catch {
+    return null;
+  }
+};
