+import { OutputData } from "@editorjs/editorjs";
+
+import { assertSafeRichText, isSafeRichTextUrl, RichTextValidationError } from "./validation";
+
+const paragraph = (text: string) => ({ blocks: [{ type: "paragraph", data: { text } }] });
+const nested = (
+  depth: number,
+): { content: string; meta: { checked: boolean }; items: unknown[] } => ({
+  content: `Level ${depth}`,
+  meta: { checked: true },
+  items: depth > 1 ? [nested(depth - 1)] : [],
+});
+
+describe("rich text boundary", () => {
+  it.each([9, 10])("preserves all nested list content and metadata at depth %s", depth => {
+    // Arrange
+    const value = {
+      time: 1,
+      version: "2.30.7",
+      blocks: [
+        {
+          id: "list",
+          type: "list",
+          data: {
+            style: "ordered",
+            meta: { start: 3, counterType: "lower-alpha" },
+            items: [nested(depth)],
+          },
+        },
+      ],
+    };
+    // Act
+    const saved = assertSafeRichText(value);
+
+    // Assert
+    expect(saved).toEqual(value);
+  });
+  it("rejects depth 11 as a whole document", () => {
+    // Arrange
+    const value = { blocks: [{ type: "list", data: { style: "unordered", items: [nested(11)] } }] };
+
+    // Act / Assert
+    expect(() => assertSafeRichText(value)).toThrow(RichTextValidationError);
+
+    try {
+      assertSafeRichText(value);
+    } catch (error) {
+      expect((error as RichTextValidationError).issues[0].code).toBe("RICH_TEXT_TOO_DEEP");
+    }
+  });
+  it("preserves legacy string lists", () => {
+    // Arrange
+    const value = {
+      blocks: [{ type: "list", data: { style: "unordered", items: ["one", "two"] } }],
+    };
+
+    // Act / Assert
+    expect(assertSafeRichText(value)).toEqual(value);
+  });
+  it.each([
+    { blocks: [], unknown: true },
+    { blocks: [{ type: "paragraph", data: { text: "ok", unknown: true } }] },
+    { blocks: [{ type: "paragraph", data: {} }] },
+    { blocks: [{ type: "unknown", data: { text: "bad" } }] },
+    {
+      blocks: [
+        { type: "list", data: { style: "unordered", items: ["legacy", { content: "new" }] } },
+      ],
+    },
+    {
+      blocks: [
+        { type: "list", data: { style: "unordered", items: [{ text: "missing content" }] } },
+      ],
+    },
+  ])("rejects unknown, missing and mixed structure %#", value => {
+    // Arrange / Act / Assert
+    expect(() => assertSafeRichText(value)).toThrow(RichTextValidationError);
+  });
+  it.each([
+    "javascript:alert(1)",
+    "JaVaScRiPt:alert(1)",
+    "jav&#x61;script:alert(1)",
+    "%6a%61vascript:alert(1)",
+    "java%0ascript:alert(1)",
+    "data:text/html,bad",
+    "vbscript:bad",
+    "//evil.example/path",
+    "https:\\evil.example",
+    "https://user:password@example.com",
+    "https%3A%2F%2Fexample.com%2F%250Ajavascript:bad",
+  ])("rejects unsafe or obfuscated URL %s", url => {
+    // Arrange / Act / Assert
+    expect(isSafeRichTextUrl(url)).toBe(false);
+    expect(() => assertSafeRichText(paragraph(`<a href="${url}">link</a>`))).toThrow(
+      RichTextValidationError,
+    );
+  });
+  it.each([
+    "https://example.com/a",
+    "http://example.com",
+    "mailto:hello@example.com",
+    "tel:+1234",
+    "/safe/path",
+    "../safe",
+    "relative/path",
+    "#anchor",
+    "?q=ok",
+  ])("accepts fixed protocols and safe relative URL %s", url => {
+    // Arrange / Act / Assert
+    expect(isSafeRichTextUrl(url)).toBe(true);
+  });
+  it("enforces noopener noreferrer on new-tab links without flattening inline markup", () => {
+    // Arrange
+    const value = paragraph(
+      '<a href="https://example.com" target="_blank" rel="opener"><strong>link</strong></a>',
+    );
+    // Act
+    const saved = assertSafeRichText(value);
+
+    // Assert
+    expect(saved.blocks[0].data.text).toBe(
+      '<a href="https://example.com" target="_blank" rel="noopener noreferrer"><strong>link</strong></a>',
+    );
+  });
+  it.each([
+    "<script>alert(1)</script>",
+    '<b onclick="bad()">bad</b>',
+    '<iframe src="https://example.com"></iframe>',
+  ])("rejects active HTML %s", text => {
+    // Arrange / Act / Assert
+    expect(() => assertSafeRichText(paragraph(text))).toThrow(RichTextValidationError);
+  });
+  it("validates image and embed URL fields", () => {
+    // Arrange
+    const valid: OutputData = {
+      blocks: [
+        { type: "image", data: { file: { url: "/image.jpg", width: 1 } } },
+        {
+          type: "embed",
+          data: {
+            service: "test",
+            source: "https://example.com",
+            embed: "https://example.com/embed",
+          },
+        },
+      ],
+    };
+
+    // Act / Assert
+    expect(assertSafeRichText(valid)).toEqual(valid);
+    expect(() =>
+      assertSafeRichText({
+        blocks: [{ type: "image", data: { file: { url: "data:image/png;base64,abc" } } }],
+      }),
+    ).toThrow(RichTextValidationError);
+  });
+});
