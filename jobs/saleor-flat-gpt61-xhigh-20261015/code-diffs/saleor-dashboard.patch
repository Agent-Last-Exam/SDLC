+    // Act
+    await waitForNextUpdate();
+    // Assert
+    expect(result.current.bundles.order.privateMetadata).toBeNull();
+    expect(query.mock.calls[0][0].variables.includePrivate).toBe(false);
+  });
+
+  it("does not install partial bundles after a failed multi-object read", async () => {
+    // Arrange
+    const query = jest
+      .fn()
+      .mockResolvedValueOnce({
+        data: { metadataBundle: { id: "line", version: 1, metadata: [], privateMetadata: [] } },
+      })
+      .mockRejectedValueOnce(new Error("permission"));
+
+    (useApolloClient as jest.Mock).mockReturnValue({ query });
+
+    const { result, waitForNextUpdate } = renderHook(() =>
+      useMetadataBundles("context", [
+        { id: "line", includePrivate: true },
+        { id: "variant", includePrivate: true },
+      ]),
