new file mode 100644
index 0000000..5c58946
--- /dev/null
+++ b/src/channels/views/ChannelDetails/useChannelSettings.ts
@@ -0,0 +1,180 @@
+import { useApolloClient } from "@apollo/client";
+import { ConfirmButtonTransitionState } from "@dashboard/components/ConfirmButton";
+import {
+  ChannelDetailsFragment,
+  ChannelDetailsFragmentDoc,
+  ChannelDocument,
+  ChannelErrorCode,
+  ChannelErrorFragment,
+  ChannelQuery,
+  ChannelQueryVariables,
+  ChannelUpdateDocument,
+  ChannelUpdateInput,
+  ChannelUpdateMutation,
+  ChannelUpdateMutationVariables,
+} from "@dashboard/graphql";
+import { useEffect, useRef, useState } from "react";
+
+const failedSave = (message: string): ChannelErrorFragment[] => [
+  { __typename: "ChannelError", field: null, code: ChannelErrorCode.INVALID, message },
+];
+
+export function useChannelSettings(id: string) {
+  const client = useApolloClient();
+  const active = useRef({ id, generation: 0, submission: 0 });
+  const [state, setState] = useState<{
+    id: string;
+    channel?: ChannelDetailsFragment | null;
+    loading: boolean;
+    error?: Error;
+  }>({ id, loading: true });
+  const [save, setSave] = useState<{
+    id: string;
+    status: ConfirmButtonTransitionState;
+    errors: ChannelErrorFragment[];
+  }>({ id, status: "default", errors: [] });
+
+  if (active.current.id !== id) {
+    active.current = {
+      id,
+      generation: active.current.generation + 1,
+      submission: active.current.submission + 1,
+    };
+  }
+
+  const cacheSaved = (channel: ChannelDetailsFragment) => {
+    const cacheId = client.cache.identify(channel);
+    const cached = client.cache.readFragment<ChannelDetailsFragment>({
+      id: cacheId,
+      fragment: ChannelDetailsFragmentDoc,
+      fragmentName: "ChannelDetails",
+    });
+
+    if (!cached || cached.settingsVersion <= channel.settingsVersion) {
+      client.cache.writeFragment({
+        id: cacheId,
+        fragment: ChannelDetailsFragmentDoc,
+        fragmentName: "ChannelDetails",
+        data: channel,
+      });
+    }
+  };
+  const reload = async () => {
+    const generation = ++active.current.generation;
+
+    setState(previous => ({ ...previous, id, loading: true, error: undefined }));
+
+    try {
+      const result = await client.query<ChannelQuery, ChannelQueryVariables>({
+        query: ChannelDocument,
+        variables: { id },
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+      });
+
+      if (active.current.id !== id || generation !== active.current.generation) {
+        return;
+      }
+
+      const channel = result.data?.channel;
+
+      if (channel && (!Number.isInteger(channel.settingsVersion) || channel.id !== id)) {
+        throw new Error("The channel settings response is incomplete.");
+      }
+
+      if (channel) {
+        cacheSaved(channel);
+      }
+
+      setState({ id, channel, loading: false });
+    } catch (error) {
+      if (active.current.id === id && generation === active.current.generation) {
+        setState(previous => ({ ...previous, id, loading: false, error: error as Error }));
+      }
+    }
+  };
+
+  useEffect(() => {
+    reload();
+
+    return () => {
+      active.current.generation += 1;
+      active.current.submission += 1;
+    };
+  }, [id]);
+
+  const update = async (input: ChannelUpdateInput): Promise<ChannelErrorFragment[]> => {
+    const submission = ++active.current.submission;
+    const isCurrent = () => active.current.id === id && submission === active.current.submission;
+
+    // A read started before this save is not a candidate for the next baseline.
+    active.current.generation += 1;
+    setSave({ id, status: "loading", errors: [] });
+
+    try {
+      const expectedVersion = input.expectedVersion;
+
+      if (typeof expectedVersion !== "number" || !Number.isInteger(expectedVersion)) {
+        throw new Error("Reload the channel settings before saving.");
+      }
+
+      const result = await client.mutate<ChannelUpdateMutation, ChannelUpdateMutationVariables>({
+        mutation: ChannelUpdateDocument,
+        variables: { id, input },
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+      });
+      const payload = result.data?.channelUpdate;
+      const channel = payload?.channel;
+      const errors =
+        payload && payload.errors.length > 0
+          ? payload.errors
+          : !payload ||
+              !Array.isArray(payload.errors) ||
+              !channel ||
+              channel.id !== id ||
+              !Number.isInteger(channel.settingsVersion) ||
+              channel.settingsVersion <= expectedVersion
+            ? failedSave("The settings save could not be confirmed. Please reload and try again.")
+            : [];
+
+      if (!isCurrent()) {
+        return failedSave("This save belongs to a previous editing context.");
+      }
+
+      if (errors.length) {
+        setSave({ id, status: "error", errors });
+
+        if (errors.some(error => error.code === ChannelErrorCode.CONFLICT)) {
+          await reload();
+        }
+      } else if (channel) {
+        cacheSaved(channel);
+        setState({ id, channel, loading: false });
+        setSave({ id, status: "success", errors: [] });
+      }
+
+      return errors;
+    } catch {
+      const errors = failedSave(
+        "Settings were not confirmed saved. Check your connection and retry.",
+      );
+
+      if (isCurrent()) {
+        setSave({ id, status: "error", errors });
+      }
+
+      return errors;
+    }
+  };
+
+  return {
+    channel: state.id === id ? state.channel : undefined,
+    loading: state.id !== id || state.loading,
+    error: state.id === id ? state.error : undefined,
+    errors: save.id === id ? save.errors : [],
+    status: save.id === id ? save.status : "default",
+    reload,
+    update,
+  };
+}
