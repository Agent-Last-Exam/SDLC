+import { useExitFormDialog } from "@dashboard/components/Form";
+import { act, renderHook } from "@testing-library/react-hooks";
+
+import useHandleFormSubmit from "./useHandleFormSubmit";
+
+jest.mock("@dashboard/components/Form", () => ({ useExitFormDialog: jest.fn() }));
+
+const setIsDirty = jest.fn();
+const setIsSubmitting = jest.fn();
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  (useExitFormDialog as jest.Mock).mockReturnValue({ setIsDirty, setIsSubmitting });
+});
+
+test("only a confirmed save invokes the submitted snapshot callback", async () => {
+  // Arrange
+  const data = { name: "submitted" };
+  const onSuccess = jest.fn();
+  const { result } = renderHook(() => useHandleFormSubmit({ onSubmit: async () => [], onSuccess }));
+
+  // Act
+  await act(async () => {
+    await result.current(data);
+  });
+
+  // Assert
+  expect(onSuccess).toHaveBeenCalledWith(data);
+  expect(setIsDirty).toHaveBeenCalledWith(false);
+  expect(setIsSubmitting).toHaveBeenLastCalledWith(false);
+});
+
+test("a new edit prevents an older save from cleaning the draft", async () => {
+  // Arrange
+  let current = true;
+  let finish: (errors: string[]) => void = () => undefined;
+  const onSuccess = jest.fn();
+  const { result } = renderHook(() =>
+    useHandleFormSubmit({
+      onSubmit: () =>
+        new Promise<string[]>(resolve => {
+          finish = resolve;
+        }),
+      onSuccess,
+    }),
+  );
+
+  // Act
+  let save: Promise<string[]>;
+
+  act(() => {
+    save = result.current({}, () => current);
+  });
+  current = false;
+  await act(async () => {
+    finish([]);
+    await save;
+  });
+
+  // Assert
+  expect(onSuccess).not.toHaveBeenCalled();
+  expect(setIsDirty).not.toHaveBeenCalled();
+  expect(setIsSubmitting).toHaveBeenLastCalledWith(false);
+});
+
+test.each([undefined, async () => undefined])("missing save facts fail closed", async onSubmit => {
+  // Arrange
+  const onSuccess = jest.fn();
+  const { result } = renderHook(() =>
+    useHandleFormSubmit({
+      onSubmit: onSubmit as unknown as Parameters<typeof useHandleFormSubmit>[0]["onSubmit"],
+      onSuccess,
+    }),
+  );
+
+  // Act / Assert
+  await act(async () => {
+    await expect(result.current({})).rejects.toThrow();
+  });
+  expect(onSuccess).not.toHaveBeenCalled();
+  expect(setIsDirty).not.toHaveBeenCalled();
+  expect(setIsSubmitting).toHaveBeenLastCalledWith(false);
+});
+
+test("business validation errors retain dirty state", async () => {
+  // Arrange
+  const { result } = renderHook(() => useHandleFormSubmit({ onSubmit: async () => ["invalid"] }));
+
+  // Act
+  await act(async () => {
+    expect(await result.current({})).toEqual(["invalid"]);
+  });
+
+  // Assert
+  expect(setIsDirty).not.toHaveBeenCalled();
+  expect(setIsSubmitting).toHaveBeenLastCalledWith(false);
+});
+
+test("an unmounted form ignores a late successful save", async () => {
+  // Arrange
+  let finish: (errors: string[]) => void = () => undefined;
+  const onSuccess = jest.fn();
+  const { result, unmount } = renderHook(() =>
+    useHandleFormSubmit({
+      onSubmit: () =>
+        new Promise<string[]>(resolve => {
+          finish = resolve;
+        }),
+      onSuccess,
+    }),
+  );
+
+  // Act
+  let save: Promise<string[]>;
+
+  act(() => {
+    save = result.current({});
+  });
+  unmount();
+  await act(async () => {
+    finish([]);
+    await save;
+  });
+
+  // Assert
+  expect(onSuccess).not.toHaveBeenCalled();
+  expect(setIsDirty).not.toHaveBeenCalled();
+});
