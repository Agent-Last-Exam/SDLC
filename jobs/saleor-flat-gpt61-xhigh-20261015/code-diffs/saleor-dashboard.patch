+import useNotifier from "@dashboard/hooks/useNotifier";
+import { act, renderHook } from "@testing-library/react-hooks";
+import { GraphQLError } from "graphql";
+
+import { useTranslationMutation } from "./useTranslationMutation";
+
+jest.mock("@dashboard/hooks/useNotifier", () => ({ __esModule: true, default: jest.fn() }));
+jest.mock("react-intl", () => ({
+  ...jest.requireActual<typeof import("react-intl")>("react-intl"),
+  useIntl: () => ({
+    formatMessage: ({ defaultMessage }: { defaultMessage: string }) => defaultMessage,
+  }),
+}));
+
+const success = { data: { productTranslate: { errors: [], product: { id: "product" } } } };
+
+describe("useTranslationMutation", () => {
+  const notify = jest.fn();
+  const refetch = jest.fn();
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+    (useNotifier as jest.Mock).mockReturnValue(notify);
+  });
+
+  it("refreshes server facts only for confirmed success", async () => {
+    // Arrange
+    const { result } = renderHook(() => useTranslationMutation("product:PL", refetch));
+    let errors;
+
+    // Act
+    await act(async () => {
+      errors = await result.current(Promise.resolve(success), "productTranslate");
+    });
+
+    // Assert
+    expect(errors).toEqual([]);
+    expect(refetch).toHaveBeenCalledTimes(1);
+    expect(notify).toHaveBeenCalledTimes(1);
+  });
+
+  it.each([
+    { data: null },
+    { data: { productTranslate: { errors: [] } } },
+    { data: { productTranslate: { errors: [], product: null } } },
+    { ...success, errors: [new GraphQLError("Permission denied")] },
+    {
+      data: {
+        productTranslate: {
+          errors: [{ field: "description", code: "UNSAFE_URL", message: "blocks[0]" }],
+          product: null,
+        },
+      },
+    },
+  ])("does not refresh or announce unconfirmed/failed responses %p", async response => {
+    // Arrange
+    const { result } = renderHook(() => useTranslationMutation("product:PL", refetch));
+    let errors;
+
+    // Act
+    await act(async () => {
+      errors = await result.current(Promise.resolve(response), "productTranslate");
+    });
+
+    // Assert
+    expect(errors).not.toHaveLength(0);
+    expect(refetch).not.toHaveBeenCalled();
+    expect(notify).not.toHaveBeenCalled();
+  });
+
+  it("does not refresh or announce an old object's late success", async () => {
+    // Arrange
+    let resolve!: (value: typeof success) => void;
+    const pending = new Promise<typeof success>(res => {
+      resolve = res;
+    });
+    const { result, rerender } = renderHook(
+      ({ context }) => useTranslationMutation(context, refetch),
+      { initialProps: { context: "product:PL" } },
+    );
+    let request!: Promise<unknown>;
+
+    act(() => {
+      request = result.current(pending, "productTranslate");
+    });
+
+    // Act
+    rerender({ context: "other:DE" });
+    await act(async () => {
+      resolve(success);
+      await request;
+    });
+
+    // Assert
+    expect(refetch).not.toHaveBeenCalled();
+    expect(notify).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/translations/views/useTranslationMutation.ts b/src/translations/views/useTranslationMutation.ts
new file mode 100644
index 0000000..a9786a8
--- /dev/null
+++ b/src/translations/views/useTranslationMutation.ts
@@ -0,0 +1,86 @@
+/* eslint-disable react-hooks/refs -- Invalidate in-flight mutation side effects synchronously when the translated object or language changes. */
+import { FetchResult } from "@apollo/client";
+import useNotifier from "@dashboard/hooks/useNotifier";
+import { commonMessages } from "@dashboard/intl";
+import { useEffect, useRef } from "react";
+import { useIntl } from "react-intl";
+
+import { TranslationSubmitError } from "../components/TranslationFields/useTranslationFieldSubmit";
+
+/** Confirm payload success before refreshing server data; closing belongs to the submitted draft. */
+export function useTranslationMutation(contextKey: string, refetch: () => unknown) {
+  const notify = useNotifier();
+  const intl = useIntl();
+  const current = useRef({ contextKey, generation: 0, request: 0, mounted: true });
+
+  if (current.current.contextKey !== contextKey) {
+    current.current = {
+      contextKey,
+      generation: current.current.generation + 1,
+      request: 0,
+      mounted: true,
+    };
+  }
+
+  useEffect(() => {
+    current.current.mounted = true;
+
+    return () => {
+      current.current.mounted = false;
+      current.current.generation++;
+    };
+  }, [contextKey]);
+
+  return async (
+    request: Promise<FetchResult<unknown>>,
+    payloadName: string,
+  ): Promise<TranslationSubmitError[]> => {
+    const generation = current.current.generation;
+    const submission = ++current.current.request;
+    const response = await request;
+    const responseData = response.data;
+    const payload =
+      responseData && typeof responseData === "object"
+        ? (responseData as Record<string, unknown>)[payloadName]
+        : undefined;
+    const failure = [
+      {
+        code: "GRAPHQL_ERROR",
+        message: intl.formatMessage({
+          id: "zlTejC",
+          defaultMessage:
+            "The translation could not be saved. Your draft has been kept. Please try again.",
+        }),
+      },
+    ];
+
+    if (
+      response.errors?.length ||
+      !payload ||
+      typeof payload !== "object" ||
+      !("errors" in payload) ||
+      !Array.isArray(payload.errors)
+    )
+      return failure;
+
+    if (payload.errors.length) return payload.errors;
+
+    const hasObject = Object.entries(payload).some(
+      ([key, value]) =>
+        !["__typename", "errors"].includes(key) && value !== null && typeof value === "object",
+    );
+
+    if (!hasObject) return failure;
+
+    if (
+      current.current.mounted &&
+      current.current.generation === generation &&
+      current.current.request === submission
+    ) {
+      void refetch();
+      notify({ status: "success", text: intl.formatMessage(commonMessages.savedChanges) });
+    }
+
+    return [];
+  };
+}
