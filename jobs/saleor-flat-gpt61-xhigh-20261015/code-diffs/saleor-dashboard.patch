index 0000000..58d3f8e
--- /dev/null
+++ b/src/translations/components/TranslationFields/useTranslationFieldSubmit.ts
@@ -0,0 +1,119 @@
+import { useExitFormDialog } from "@dashboard/components/Form/useExitFormDialog";
+import { SubmitPromise } from "@dashboard/hooks/useForm";
+import { RichTextValidationError } from "@dashboard/utils/richText/validation";
+import { useEffect, useRef, useState } from "react";
+import { useIntl } from "react-intl";
+
+export interface TranslationSubmitError {
+  field?: string | null;
+  code?: string;
+  message?: string | null;
+}
+
+/** A successful request may only clean and close the exact draft it submitted. */
+export function useTranslationFieldSubmit<T>({
+  contextKey,
+  getValue,
+  markSaved,
+  onSubmit,
+  onSaved,
+}: {
+  contextKey: string;
+  getValue: () => Promise<T>;
+  markSaved: (snapshot: T) => boolean;
+  onSubmit: (snapshot: T) => SubmitPromise<TranslationSubmitError[]>;
+  onSaved?: () => void;
+}) {
+  const intl = useIntl();
+  const exit = useExitFormDialog();
+  const [errors, setErrors] = useState<TranslationSubmitError[]>([]);
+  const [submitting, setSubmitting] = useState(false);
+  const current = useRef({ contextKey, generation: 0, request: 0, mounted: true });
+  const handlers = useRef({ getValue, markSaved, onSubmit, onSaved, exit });
+
+  handlers.current = { getValue, markSaved, onSubmit, onSaved, exit };
+
+  if (current.current.contextKey !== contextKey) {
+    current.current = {
+      contextKey,
+      generation: current.current.generation + 1,
+      request: current.current.request + 1,
+      mounted: true,
+    };
+  }
+
+  const failure = (): TranslationSubmitError[] => [
+    {
+      code: "GRAPHQL_ERROR",
+      message: intl.formatMessage({
+        id: "zlTejC",
+        defaultMessage:
+          "The translation could not be saved. Your draft has been kept. Please try again.",
+      }),
+    },
+  ];
+  const handleSubmit = async () => {
+    const { generation } = current.current;
+    const request = ++current.current.request;
+    const submittedHandlers = handlers.current;
+    const isCurrent = () =>
+      current.current.mounted &&
+      current.current.generation === generation &&
+      current.current.request === request;
+
+    setSubmitting(true);
+    setErrors([]);
+
+    try {
+      const snapshot = await submittedHandlers.getValue();
+
+      if (!isCurrent()) return failure();
+
+      const result = await submittedHandlers.onSubmit(snapshot);
+      const confirmed = Array.isArray(result) ? result : failure();
+
+      if (isCurrent()) {
+        setErrors(confirmed);
+
+        if (confirmed.length === 0 && submittedHandlers.markSaved(snapshot)) {
+          submittedHandlers.exit.setIsDirty(false);
+          handlers.current.onSaved?.();
+        }
+      }
+
+      return confirmed;
+    } catch (error) {
+      const result =
+        error instanceof RichTextValidationError
+          ? error.issues.map(issue => ({
+              ...issue,
+              field: issue.path,
+              message: `${issue.path}: ${issue.message}`,
+            }))
+          : failure();
+
+      if (isCurrent()) setErrors(result);
+
+      return result;
+    } finally {
+      if (isCurrent()) setSubmitting(false);
+    }
+  };
+
+  useEffect(() => {
+    current.current.mounted = true;
+    setErrors([]);
+    setSubmitting(false);
+
+    return () => {
+      current.current.mounted = false;
+      current.current.generation++;
+      handlers.current.exit.setIsDirty(false);
+      handlers.current.exit.setExitDialogSubmitRef(async () => []);
+    };
+  }, [contextKey]);
+
+  useEffect(() => exit.setExitDialogSubmitRef(handleSubmit));
+
+  return { errors, submitting, handleSubmit, setIsDirty: exit.setIsDirty };
+}
