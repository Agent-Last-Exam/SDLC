index 0000000..55e4b3d
--- /dev/null
+++ b/src/hooks/useMetadataBundles.ts
@@ -0,0 +1,141 @@
+import { useApolloClient } from "@apollo/client";
+import { metadataBundleQuery } from "@dashboard/queries/metadata";
+import { useCallback, useEffect, useRef, useState } from "react";
+
+export interface MetadataValue {
+  key: string;
+  value: string;
+}
+
+export interface MetadataBundle {
+  id: string;
+  version: number;
+  metadata: MetadataValue[];
+  privateMetadata?: MetadataValue[] | null;
+}
+
+export interface MetadataTarget {
+  id: string;
+  includePrivate: boolean;
+}
+
+export const useMetadataBundles = (contextKey: string, targets: MetadataTarget[], skip = false) => {
+  const client = useApolloClient();
+  const requestKey = JSON.stringify([contextKey, targets, skip]);
+  const current = useRef({ key: requestKey, generation: 0 });
+  const [state, setState] = useState<{
+    key: string;
+    bundles: Record<string, MetadataBundle>;
+    loading: boolean;
+    error?: Error;
+  }>({ key: requestKey, bundles: {}, loading: !skip });
+  const [revision, setRevision] = useState(0);
+
+  if (current.current.key !== requestKey) {
+    current.current = { key: requestKey, generation: current.current.generation + 1 };
+  }
+
+  useEffect(() => {
+    const generation = ++current.current.generation;
+    let active = true;
+    const isCurrent = () => active && generation === current.current.generation;
+
+    if (skip) {
+      setState({ key: requestKey, bundles: {}, loading: false });
+
+      return;
+    }
+
+    setState(previous => ({
+      key: requestKey,
+      bundles: previous.key === requestKey ? previous.bundles : {},
+      loading: true,
+    }));
+
+    const load = async () => {
+      try {
+        const bundles: Record<string, MetadataBundle> = {};
+
+        for (const target of targets) {
+          const result = await client.query<{ metadataBundle: MetadataBundle | null }>({
+            query: metadataBundleQuery,
+            variables: target,
+            fetchPolicy: "no-cache",
+            errorPolicy: "none",
+          });
+          const bundle = result.data?.metadataBundle;
+
+          if (
+            result.errors?.length ||
+            !bundle ||
+            bundle.id !== target.id ||
+            !Number.isInteger(bundle.version) ||
+            !Array.isArray(bundle.metadata) ||
+            (target.includePrivate && !Array.isArray(bundle.privateMetadata))
+          ) {
+            throw new Error("Metadata could not be loaded. Retry before saving.");
+          }
+
+          bundles[target.id] = {
+            ...bundle,
+            privateMetadata: target.includePrivate ? bundle.privateMetadata : null,
+          };
+        }
+
+        if (isCurrent()) {
+          setState({ key: requestKey, bundles, loading: false });
+        }
+      } catch (error) {
+        if (isCurrent()) {
+          setState(previous => ({
+            ...previous,
+            key: requestKey,
+            loading: false,
+            error: error instanceof Error ? error : new Error("Metadata could not be loaded."),
+          }));
+        }
+      }
+    };
+
+    void load();
+
+    return () => {
+      active = false;
+    };
+    // requestKey contains the complete object/permission context.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [client, requestKey, revision]);
+
+  const accept = useCallback(
+    (bundles: MetadataBundle[]) => {
+      if (current.current.key !== requestKey) {
+        return;
+      }
+
+      setState(previous => {
+        if (previous.key !== requestKey) {
+          return previous;
+        }
+
+        const next = { ...previous.bundles };
+
+        for (const bundle of bundles) {
+          if (next[bundle.id] && bundle.version >= next[bundle.id].version) {
+            next[bundle.id] = bundle;
+          }
+        }
+
+        return { ...previous, bundles: next, error: undefined };
+      });
+    },
+    [requestKey],
+  );
+
+  return {
+    bundles: state.key === requestKey ? state.bundles : {},
+    loading: !skip && (state.key !== requestKey || state.loading),
+    error: state.key === requestKey ? state.error : undefined,
+    retry: () => setRevision(value => value + 1),
+    accept,
+  };
+};
