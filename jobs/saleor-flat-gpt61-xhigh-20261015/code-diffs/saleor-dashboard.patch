+import { useApolloClient } from "@apollo/client";
+import { ShopErrorCode } from "@dashboard/graphql";
+import { act, renderHook } from "@testing-library/react-hooks";
+
+import { useSiteSettings } from "./useSiteSettings";
+
+jest.mock("@apollo/client", () => ({
+  ...jest.requireActual<typeof import("@apollo/client")>("@apollo/client"),
+  useApolloClient: jest.fn(),
+}));
+
+const shop = (settingsVersion = 2) => ({
+  __typename: "Shop",
+  settingsVersion,
+  passwordAuthenticationMode: "ENABLED",
+  companyAddress: null,
+});
+const client = {
+  query: jest.fn(),
+  mutate: jest.fn(),
+  cache: { readQuery: jest.fn(() => null), writeQuery: jest.fn() },
+};
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  (useApolloClient as jest.Mock).mockReturnValue(client);
+  client.query.mockResolvedValue({ data: { shop: shop() } });
+});
+
+describe("shop settings confirmed CAS saves", () => {
+  it("saves a mode-only CAS without the company-address mutation", async () => {
+    // Arrange
+    const { result, waitForNextUpdate } = renderHook(() => useSiteSettings(true));
+
+    await waitForNextUpdate();
+
+    const saved = { ...shop(3), passwordAuthenticationMode: "CUSTOMERS_ONLY" };
+    const variables = {
+      shopSettingsInput: { expectedVersion: 2, passwordAuthenticationMode: "CUSTOMERS_ONLY" },
+      updateAddress: false,
+    } as any;
+
+    client.mutate.mockResolvedValue({ data: { shopSettingsUpdate: { shop: saved, errors: [] } } });
+
+    // Act
+    await act(async () => {
+      expect(await result.current.update(variables)).toEqual([]);
+    });
+
+    // Assert
+    expect(client.mutate).toHaveBeenCalledTimes(1);
+    expect(client.mutate).toHaveBeenCalledWith(
+      expect.objectContaining({ variables, fetchPolicy: "no-cache", errorPolicy: "none" }),
+    );
+    expect(client.cache.writeQuery).toHaveBeenCalledWith(
+      expect.objectContaining({ data: { shop: saved } }),
+    );
+    expect(result.current.status).toBe("success");
+  });
+
+  it.each([
+    undefined,
+    { shopSettingsUpdate: null },
+    { shopSettingsUpdate: { shop: shop(3) } },
+    { shopSettingsUpdate: { shop: null, errors: [] } },
+    { shopSettingsUpdate: { shop: shop(2), errors: [] } },
+    {
+      shopSettingsUpdate: {
+        shop: shop(3),
+        errors: [{ code: ShopErrorCode.INVALID, message: "Rejected", field: null }],
+      },
+    },
+  ])("does not cache a rejected or incomplete save %p", async data => {
+    // Arrange
+    const { result, waitForNextUpdate } = renderHook(() => useSiteSettings(true));
+
+    await waitForNextUpdate();
+    client.mutate.mockResolvedValue({ data });
+
+    // Act
+    await act(async () => {
+      expect(
+        await result.current.update({
+          shopSettingsInput: { expectedVersion: 2 },
+          updateAddress: false,
+        } as any),
+      ).not.toEqual([]);
+    });
+
+    // Assert
+    expect(client.cache.writeQuery).not.toHaveBeenCalled();
+    expect(result.current.shop?.settingsVersion).toBe(2);
+    expect(result.current.status).toBe("error");
+  });
+
+  it("refreshes a conflict baseline without retrying or caching its rejected candidate", async () => {
+    // Arrange
+    const { result, waitForNextUpdate } = renderHook(() => useSiteSettings(true));
+
+    await waitForNextUpdate();
+    client.mutate.mockResolvedValue({
+      data: {
+        shopSettingsUpdate: {
+          shop: shop(3),
+          errors: [{ code: ShopErrorCode.CONFLICT, field: "expectedVersion", message: "Conflict" }],
+        },
+      },
+    });
+    client.query.mockResolvedValue({ data: { shop: shop(4) } });
+
+    // Act
+    await act(async () => {
+      await result.current.update({
+        shopSettingsInput: { expectedVersion: 2 },
+        updateAddress: false,
+      } as any);
+    });
+
+    // Assert
+    expect(client.mutate).toHaveBeenCalledTimes(1);
+    expect(client.cache.writeQuery).not.toHaveBeenCalled();
+    expect(result.current.shop?.settingsVersion).toBe(4);
+    expect(result.current.errors[0].code).toBe(ShopErrorCode.CONFLICT);
+  });
+
+  it("does not query restricted settings without permission", () => {
+    // Arrange & Act
+    const { result } = renderHook(() => useSiteSettings(false));
+
+    // Assert
+    expect(client.query).not.toHaveBeenCalled();
+    expect(result.current.shop).toBeUndefined();
+  });
+});
