+import { useApolloClient } from "@apollo/client";
+import { act, renderHook } from "@testing-library/react-hooks";
+
+import { MetadataBundle } from "./useMetadataBundles";
+import { getMetadataUpdateInput, useMetadataUpdate } from "./useMetadataUpdate";
+
+jest.mock("@apollo/client", () => ({
+  ...jest.requireActual<typeof import("@apollo/client")>("@apollo/client"),
+  useApolloClient: jest.fn(),
+}));
+
+const bundle: MetadataBundle = {
+  id: "line",
+  version: 3,
+  metadata: [
+    { key: "keep", value: "old" },
+    { key: "remove", value: "x" },
+  ],
+  privateMetadata: [{ key: "secret", value: "old" }],
+};
+
+describe("atomic metadata", () => {
+  it("combines public/private upserts and deletions with one expected version", () => {
+    // Arrange / Act
+    const input = getMetadataUpdateInput(bundle, {
+      metadata: [{ key: "keep", value: "new" }],
+      privateMetadata: [{ key: "next", value: "new" }],
+    });
+
+    // Assert
+    expect(input).toEqual({
+      id: "line",
+      expectedVersion: 3,
+      metadata: [{ key: "keep", value: "new" }],
+      deleteKeys: ["remove"],
+      privateMetadata: [{ key: "next", value: "new" }],
+      deletePrivateKeys: ["secret"],
+    });
+  });
+
+  it("preserves private null as unavailable and rejects duplicate/empty keys", () => {
+    // Arrange / Act / Assert
+    expect(
+      getMetadataUpdateInput(
+        { ...bundle, privateMetadata: null },
+        { metadata: bundle.metadata, privateMetadata: [] },
+      ),
+    ).toBeNull();
+    expect(() =>
+      getMetadataUpdateInput(bundle, { metadata: [{ key: " ", value: "x" }] }),
+    ).toThrow();
+    expect(() =>
+      getMetadataUpdateInput(bundle, {
+        metadata: [
+          { key: "a", value: "x" },
+          { key: "a", value: "y" },
+        ],
+      }),
+    ).toThrow();
+  });
+
+  it("sends line and variant changes in one bulk request and preserves conflict errors", async () => {
+    // Arrange
+    const mutate = jest.fn().mockResolvedValue({
+      data: {
+        metadataBulkUpdate: {
+          metadataBundles: [],
+          errors: [{ field: "expectedVersion", code: "CONFLICT", message: "Reload version" }],
+        },
+      },
+    });
+
+    (useApolloClient as jest.Mock).mockReturnValue({ mutate });
+
+    const { result } = renderHook(() => useMetadataUpdate("order:line"));
+    // Act
+    let response: Awaited<ReturnType<ReturnType<typeof useMetadataUpdate>["save"]>> | undefined;
+
+    await act(async () => {
+      response = await result.current.save(
+        [
+          { id: "line", expectedVersion: 3, metadata: [] },
+          { id: "variant", expectedVersion: 8, deleteKeys: ["x"] },
+        ],
+        true,
+      );
+    });
+    // Assert
+    expect(mutate).toHaveBeenCalledTimes(1);
+    expect(mutate.mock.calls[0][0].variables.input).toHaveLength(2);
+    expect(response?.errors[0].code).toBe("CONFLICT");
+    expect(response?.bundles).toEqual([]);
+  });
+
+  it.each([
+    {},
+    { data: {} },
+    { data: { metadataUpdate: { metadataBundle: null, errors: [] } } },
+    { data: { metadataUpdate: { metadataBundle: { ...bundle, version: 3 }, errors: [] } } },
+  ])("fails closed on missing or stale success payload", async response => {
+    // Arrange
+    (useApolloClient as jest.Mock).mockReturnValue({
+      mutate: jest.fn().mockResolvedValue(response),
+    });
+
+    const { result } = renderHook(() => useMetadataUpdate("line"));
+    // Act
+    let saved: Awaited<ReturnType<ReturnType<typeof useMetadataUpdate>["save"]>> | undefined;
+
+    await act(async () => {
+      saved = await result.current.save(
+        [{ id: "line", expectedVersion: 3, deleteKeys: ["remove"] }],
+        true,
+      );
+    });
+    // Assert
+    expect(saved?.errors[0].code).toBe("UNCONFIRMED");
+    expect(saved?.bundles).toEqual([]);
+  });
+
+  it("does not apply a late save to another context", async () => {
+    // Arrange
+    let resolve: (value: unknown) => void;
+
+    (useApolloClient as jest.Mock).mockReturnValue({
+      mutate: jest.fn(
+        () =>
+          new Promise(done => {
+            resolve = done;
+          }),
+      ),
+    });
+
+    const { result, rerender } = renderHook(({ context }) => useMetadataUpdate(context), {
+      initialProps: { context: "a" },
+    });
+    let pending: ReturnType<ReturnType<typeof useMetadataUpdate>["save"]> | undefined;
+
+    act(() => {
+      pending = result.current.save(
+        [{ id: "line", expectedVersion: 3, deleteKeys: ["remove"] }],
+        true,
+      );
+    });
+    // Act
+    rerender({ context: "b" });
+    await act(async () => {
+      resolve({
+        data: { metadataUpdate: { metadataBundle: { ...bundle, version: 4 }, errors: [] } },
+      });
+      await pending;
+    });
+    // Assert
+    expect(result.current.called).toBe(false);
+    expect(result.current.errors).toEqual([]);
+  });
+});
diff --git a/src/hooks/useMetadataUpdate.ts b/src/hooks/useMetadataUpdate.ts
new file mode 100644
index 0000000..73d04ec
--- /dev/null
+++ b/src/hooks/useMetadataUpdate.ts
@@ -0,0 +1,197 @@
+import { useApolloClient } from "@apollo/client";
+import {
+  atomicMetadataBulkUpdateMutation,
+  atomicMetadataUpdateMutation,
+} from "@dashboard/mutations/metadata";
+import { useEffect, useRef, useState } from "react";
+
+import { MetadataBundle, MetadataValue } from "./useMetadataBundles";
+
+export interface MetadataDraft {
+  metadata: MetadataValue[];
+  privateMetadata?: MetadataValue[];
+}
+
+export interface MetadataUpdateInput {
+  id: string;
+  expectedVersion: number;
+  metadata?: MetadataValue[];
+  privateMetadata?: MetadataValue[];
+  deleteKeys?: string[];
+  deletePrivateKeys?: string[];
+}
+
+export interface MetadataSaveError {
+  field: string | null;
+  code: string;
+  message: string;
+}
+
+const diff = (previous: MetadataValue[], draft: MetadataValue[]) => {
+  const keys = new Set<string>();
+
+  for (const item of draft) {
+    if (!item.key.trim() || keys.has(item.key)) {
+      throw new Error("Metadata keys must be non-empty and unique.");
+    }
+
+    keys.add(item.key);
+  }
+
+  return {
+    upserts: draft
+      .filter(item => !previous.some(old => old.key === item.key && old.value === item.value))
+      .map(({ key, value }) => ({ key, value })),
+    deletes: previous.filter(item => !keys.has(item.key)).map(item => item.key),
+  };
+};
+
+export const getMetadataUpdateInput = (
+  bundle: MetadataBundle,
+  draft: MetadataDraft,
+): MetadataUpdateInput | null => {
+  const publicChanges = diff(bundle.metadata, draft.metadata);
+  const privateChanges =
+    bundle.privateMetadata != null && draft.privateMetadata != null
+      ? diff(bundle.privateMetadata, draft.privateMetadata)
+      : { upserts: [], deletes: [] };
+
+  if (
+    !(
+      publicChanges.upserts.length ||
+      publicChanges.deletes.length ||
+      privateChanges.upserts.length ||
+      privateChanges.deletes.length
+    )
+  ) {
+    return null;
+  }
+
+  return {
+    id: bundle.id,
+    expectedVersion: bundle.version,
+    ...(publicChanges.upserts.length ? { metadata: publicChanges.upserts } : {}),
+    ...(publicChanges.deletes.length ? { deleteKeys: publicChanges.deletes } : {}),
+    ...(privateChanges.upserts.length ? { privateMetadata: privateChanges.upserts } : {}),
+    ...(privateChanges.deletes.length ? { deletePrivateKeys: privateChanges.deletes } : {}),
+  };
+};
+
+const unknownResult: MetadataSaveError = {
+  field: null,
+  code: "UNCONFIRMED",
+  message:
+    "Metadata was not confirmed saved. Your changes are preserved; retry or reload to check the latest version.",
+};
+
+export const useMetadataUpdate = (contextKey: string) => {
+  const client = useApolloClient();
+  const current = useRef({ key: contextKey, generation: 0, pending: false });
+  const [state, setState] = useState<{
+    key: string;
+    loading: boolean;
+    called: boolean;
+    errors: MetadataSaveError[];
+  }>({
+    key: contextKey,
+    loading: false,
+    called: false,
+    errors: [],
+  });
+
+  if (current.current.key !== contextKey) {
+    current.current = {
+      key: contextKey,
+      generation: current.current.generation + 1,
+      pending: false,
+    };
+  }
+
+  useEffect(
+    () => () => {
+      current.current = { ...current.current, key: "unmounted" };
+    },
+    [],
+  );
+
+  const save = async (input: MetadataUpdateInput[], includePrivate: boolean) => {
+    const request = current.current;
+    const isCurrent = () => request === current.current && request.key === contextKey;
+
+    if (!isCurrent() || request.pending) {
+      return { errors: [unknownResult], bundles: [] as MetadataBundle[] };
+    }
+
+    if (!input.length) {
+      return { errors: [] as MetadataSaveError[], bundles: [] as MetadataBundle[] };
+    }
+
+    request.pending = true;
+    setState({ key: contextKey, loading: true, called: true, errors: [] });
+
+    try {
+      const snapshot = input.map(item => ({ ...item }));
+      const bulk = input.length > 1;
+      const result = await client.mutate<{
+        metadataUpdate?: { metadataBundle: MetadataBundle | null; errors: MetadataSaveError[] };
+        metadataBulkUpdate?: { metadataBundles: MetadataBundle[]; errors: MetadataSaveError[] };
+      }>({
+        mutation: bulk ? atomicMetadataBulkUpdateMutation : atomicMetadataUpdateMutation,
+        variables: { input: bulk ? snapshot : snapshot[0], includePrivate },
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+      });
+      const payload = bulk ? result.data?.metadataBulkUpdate : result.data?.metadataUpdate;
+      const bundles = bulk
+        ? result.data?.metadataBulkUpdate?.metadataBundles
+        : result.data?.metadataUpdate?.metadataBundle
+          ? [result.data.metadataUpdate.metadataBundle]
+          : [];
+      let errors =
+        result.errors?.length || !Array.isArray(payload?.errors) ? [unknownResult] : payload.errors;
+
+      if (
+        !errors.length &&
+        (!bundles ||
+          bundles.length !== input.length ||
+          new Set(bundles.map(bundle => bundle.id)).size !== input.length ||
+          input.some(
+            item =>
+              !bundles.some(
+                bundle =>
+                  bundle.id === item.id &&
+                  Number.isInteger(bundle.version) &&
+                  bundle.version > item.expectedVersion &&
+                  Array.isArray(bundle.metadata) &&
+                  (!includePrivate || Array.isArray(bundle.privateMetadata)),
+              ),
+          ))
+      ) {
+        errors = [unknownResult];
+      }
+
+      if (!isCurrent()) {
+        return { errors: [unknownResult], bundles: [] as MetadataBundle[] };
+      }
+
+      setState({ key: contextKey, loading: false, called: true, errors });
+
+      return { errors, bundles: errors.length ? [] : (bundles ?? []) };
+    } catch {
+      if (isCurrent()) {
+        setState({ key: contextKey, loading: false, called: true, errors: [unknownResult] });
+      }
+
+      return { errors: [unknownResult], bundles: [] as MetadataBundle[] };
+    } finally {
+      request.pending = false;
+    }
+  };
+
+  return {
+    save,
+    loading: state.key === contextKey && state.loading,
+    called: state.key === contextKey && state.called,
+    errors: state.key === contextKey ? state.errors : [],
+  };
+};
