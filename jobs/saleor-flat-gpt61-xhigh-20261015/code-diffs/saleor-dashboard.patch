+import { AppFormSession } from "@dashboard/extensions/views/ViewManifestExtension/components/AppFrame/formProtocol";
+import { act, renderHook } from "@testing-library/react-hooks";
+import { Provider } from "jotai";
+import { PropsWithChildren } from "react";
+
+import { useAppFormExtension, useCurrentAppFormBinding } from "./useAppFormExtension";
+
+const wrapper = ({ children }: PropsWithChildren<{ version: number; language: string }>) => (
+  <Provider>{children}</Provider>
+);
+
+describe("current App form bindings", () => {
+  it("invalidates captures for edits, object/language changes and unmount", () => {
+    // Arrange
+    const callback = jest.fn();
+    const { result, rerender, unmount } = renderHook(
+      ({ version, language }) => {
+        useAppFormExtension({
+          formType: "TRANSLATION",
+          objectId: "product",
+          languageCode: language,
+          contextVersion: version,
+          allowedFields: ["name", "description"],
+          nullableFields: ["description"],
+          onResult: callback,
+        });
+
+        return useCurrentAppFormBinding();
+      },
+      { wrapper, initialProps: { version: 1, language: "PL" } },
+    );
+    const first = result.current;
+
+    // Act
+    rerender({ version: 2, language: "PL" });
+
+    const second = result.current;
+
+    rerender({ version: 2, language: "DE" });
+    // Assert
+    expect(first.isCurrent()).toBe(false);
+    expect(second.isCurrent()).toBe(false);
+    expect(result.current.isCurrent()).toBe(true);
+
+    const last = result.current;
+
+    act(() => unmount());
+    expect(last.isCurrent()).toBe(false);
+  });
+
+  it("rejects a response after a synchronous edit before React commits the revision", () => {
+    // Arrange
+    const onResult = jest.fn();
+    let revision = 1;
+    const { result } = renderHook(
+      () => {
+        useAppFormExtension({
+          formType: "PRODUCT",
+          objectId: "product",
+          contextVersion: 1,
+          allowedFields: ["name"],
+          nullableFields: [],
+          onResult,
+          isCurrent: () => revision === 1,
+        });
+
+        return useCurrentAppFormBinding();
+      },
+      { wrapper, initialProps: { version: 1, language: "PL" } },
+    );
+    const frame = document.createElement("iframe");
+
+    document.body.appendChild(frame);
+
+    const session = new AppFormSession(result.current, "frame", "request");
+    const receive = (data: Record<string, unknown>) =>
+      session.receive(
+        new MessageEvent("message", {
+          origin: "https://app.example",
+          source: frame.contentWindow,
+          data: { frameId: "frame", requestId: "request", contextVersion: 1, ...data },
+        }),
+        frame,
+        "https://app.example",
+      );
+
+    session.load();
+    receive({ type: "SALEOR_FORM_READY", action: "formReady" });
+    // Act — no render or layout effect runs between the edit and message.
+    revision++;
+
+    const ack = receive({
+      type: "SALEOR_FORM_RESPONSE",
+      action: "formResult",
+      formType: "PRODUCT",
+      status: "SUCCESS",
+      values: { name: "App draft" },
+    });
+
+    // Assert
+    expect(ack).toEqual(expect.objectContaining({ status: "REJECTED", code: "STALE_CONTEXT" }));
+    expect(onResult).not.toHaveBeenCalled();
+    frame.remove();
+  });
+});
diff --git a/src/extensions/components/AppExtensionContext/useAppFormExtension.ts b/src/extensions/components/AppExtensionContext/useAppFormExtension.ts
new file mode 100644
index 0000000..f8d72d0
--- /dev/null
+++ b/src/extensions/components/AppExtensionContext/useAppFormExtension.ts
@@ -0,0 +1,76 @@
+import {
+  AppFormBinding,
+  FormField,
+  FormResult,
+  FormType,
+  isValidFormBinding,
+} from "@dashboard/extensions/views/ViewManifestExtension/components/AppFrame/formProtocol";
+import { atom, useAtomValue, useSetAtom } from "jotai";
+import { useLayoutEffect, useRef } from "react";
+
+const bindingsAtom = atom<AppFormBinding[]>([]);
+
+export interface UseAppFormExtensionOptions {
+  formType: FormType;
+  objectId: string;
+  languageCode?: string;
+  contextVersion: number;
+  allowedFields: FormField[];
+  nullableFields: FormField[];
+  onResult: (result: FormResult) => void;
+  /** Read the form's synchronous revision guard, including edits not committed by React yet. */
+  isCurrent?: () => boolean;
+}
+
+/** Register the current editable form. Every user edit must advance contextVersion. */
+export const useAppFormExtension = (options: UseAppFormExtensionOptions) => {
+  const setBindings = useSetAtom(bindingsAtom);
+  const current = useRef(options);
+  const mounted = useRef(false);
+  const signature = JSON.stringify({ ...options, onResult: undefined });
+  const currentSignature = useRef(signature);
+
+  useLayoutEffect(() => {
+    current.current = options;
+    currentSignature.current = signature;
+  });
+
+  useLayoutEffect(() => {
+    let active = true;
+
+    mounted.current = true;
+
+    const synchronousGuard = current.current.isCurrent;
+    const binding: AppFormBinding = {
+      ...current.current,
+      onResult: result => current.current.onResult(result),
+      isCurrent: () =>
+        active &&
+        mounted.current &&
+        currentSignature.current === signature &&
+        (!synchronousGuard || synchronousGuard()),
+    };
+
+    if (isValidFormBinding(binding)) setBindings(bindings => [...bindings, binding]);
+
+    return () => {
+      active = false;
+      mounted.current = false;
+      setBindings(bindings => bindings.filter(item => item !== binding));
+    };
+  }, [signature, setBindings]);
+};
+
+export const useCurrentAppFormBinding = () => {
+  const bindings = useAtomValue(bindingsAtom);
+
+  return bindings[bindings.length - 1];
+};
+
+export type {
+  AppFormBinding,
+  FormField,
+  FormResult,
+  FormType,
+  FormValues,
+} from "@dashboard/extensions/views/ViewManifestExtension/components/AppFrame/formProtocol";
