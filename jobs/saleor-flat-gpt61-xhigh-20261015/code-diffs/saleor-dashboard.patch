@@ -0,0 +1,141 @@
+import { useApolloClient } from "@apollo/client";
+import { DashboardCard } from "@dashboard/components/Card";
+import { OrderShippingMetadataSnapshotQuery } from "@dashboard/graphql";
+import { orderShippingMetadataSnapshotQuery } from "@dashboard/orders/queries";
+import { Box, Text } from "@saleor/macaw-ui-next";
+import { useEffect, useState } from "react";
+import { FormattedMessage } from "react-intl";
+
+const Snapshot = ({ items }: { items: Array<{ key: string; value: string }> }) =>
+  items.length ? (
+    <Box as="dl">
+      {items.map(item => (
+        <Box key={item.key}>
+          <Box as="dt" fontWeight="bold">
+            {item.key}
+          </Box>
+          <Box as="dd">{item.value}</Box>
+        </Box>
+      ))}
+    </Box>
+  ) : (
+    <Text>
+      <FormattedMessage defaultMessage="Empty historical snapshot" id="cGc2Ui" />
+    </Text>
+  );
+
+/** Historical facts are read-only and never fall back to the current shipping method. */
+export const OrderShippingMetadataSnapshot = ({
+  order,
+  includePrivate,
+}: {
+  order: {
+    id: string;
+    shippingMethodMetadata: Array<{ key: string; value: string }>;
+    fulfillments: Array<{
+      id: string;
+      shippingMethodMetadata: Array<{ key: string; value: string }>;
+    }>;
+  };
+  includePrivate: boolean;
+}) => {
+  const client = useApolloClient();
+  const key = JSON.stringify([order.id, includePrivate]);
+  const [state, setState] = useState<{
+    key: string;
+    data?: OrderShippingMetadataSnapshotQuery;
+    error?: boolean;
+  }>({ key });
+
+  useEffect(() => {
+    let active = true;
+
+    if (includePrivate) {
+      client
+        .query<OrderShippingMetadataSnapshotQuery>({
+          query: orderShippingMetadataSnapshotQuery,
+          variables: { id: order.id, includePrivate },
+          fetchPolicy: "no-cache",
+          errorPolicy: "none",
+        })
+        .then(({ data, errors }) => {
+          if (active) {
+            setState({
+              key,
+              data: errors?.length || data?.order?.id !== order.id ? undefined : data,
+              error: !!errors?.length || data?.order?.id !== order.id,
+            });
+          }
+        })
+        .catch(() => {
+          if (active) {
+            setState({ key, error: true });
+          }
+        });
+    }
+
+    return () => {
+      active = false;
+    };
+  }, [key, client, includePrivate, order.id]);
+
+  const privateOrder = includePrivate && state.key === key ? state.data?.order : undefined;
+
+  return (
+    <DashboardCard>
+      <DashboardCard.Header>
+        <DashboardCard.Title>
+          <FormattedMessage defaultMessage="Shipping method metadata snapshot" id="1ial0S" />
+        </DashboardCard.Title>
+      </DashboardCard.Header>
+      <DashboardCard.Content>
+        <Box display="grid" gap={3}>
+          <Text color="default2">
+            <FormattedMessage
+              defaultMessage="Immutable creation-time metadata; it may legitimately be empty for historical records."
+              id="7F6+mx"
+            />
+          </Text>
+          <Snapshot items={order.shippingMethodMetadata} />
+          {includePrivate && state.key === key && state.error && (
+            <Text color="critical1">
+              <FormattedMessage
+                defaultMessage="Private snapshots could not be loaded. Public snapshots are unchanged."
+                id="tAX7sg"
+              />
+            </Text>
+          )}
+          {privateOrder?.privateShippingMethodMetadata && (
+            <>
+              <Text fontWeight="bold">
+                <FormattedMessage defaultMessage="Private snapshot" id="yvVGIN" />
+              </Text>
+              <Snapshot items={privateOrder.privateShippingMethodMetadata} />
+            </>
+          )}
+          {order.fulfillments.map(fulfillment => (
+            <Box key={fulfillment.id}>
+              <Text fontWeight="bold">
+                <FormattedMessage
+                  defaultMessage="Fulfillment {id}"
+                  id="WUCPvh"
+                  values={{ id: fulfillment.id }}
+                />
+              </Text>
+              <Snapshot items={fulfillment.shippingMethodMetadata} />
+              {privateOrder?.fulfillments.find(item => item.id === fulfillment.id)
+                ?.privateShippingMethodMetadata && (
+                <Snapshot
+                  items={
+                    privateOrder.fulfillments.find(item => item.id === fulfillment.id)!
+                      .privateShippingMethodMetadata!
+                  }
+                />
+              )}
+            </Box>
+          ))}
+        </Box>
+      </DashboardCard.Content>
+    </DashboardCard>
+  );
+};
