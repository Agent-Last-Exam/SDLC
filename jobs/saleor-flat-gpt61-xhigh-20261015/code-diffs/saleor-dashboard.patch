+import { renderHook } from "@testing-library/react-hooks";
+
+import {
+  andWhere,
+  hasScopeConstraints,
+  intersectLegacyFilters,
+  isCurrentListResult,
+  scopeFingerprint,
+  uniqueById,
+  uniqueIds,
+  useScopedSelection,
+} from "./effectiveScope";
+
+describe("effective list scope", () => {
+  it("ANDs trusted WHERE and ordinary conditions without overwriting either", () => {
+    // Arrange
+    const locked = { category: { eq: "locked-category" } };
+    const ordinary = { category: { eq: "other-category" } };
+    // Act
+    const result = andWhere(locked, ordinary);
+
+    // Assert
+    expect(result).toEqual({ AND: [locked, ordinary] });
+    expect(andWhere(locked, {})).toEqual(locked);
+  });
+
+  it("retains scalar locks and reports an unrepresentable legacy conflict", () => {
+    // Arrange
+    const locked = { currency: "USD", isActive: true };
+    // Act
+    const result = intersectLegacyFilters(locked, { currency: "EUR", isActive: false });
+
+    // Assert
+    expect(result).toEqual({ filter: locked, conflict: true });
+    expect(intersectLegacyFilters(locked, {})).toEqual({ filter: locked, conflict: false });
+  });
+
+  it("intersects ID sets/ranges and preserves conjunctive metadata", () => {
+    // Arrange
+    const locked = {
+      products: ["p1", "p2"],
+      currentBalance: { gte: 5, lte: 20 },
+      metadata: [{ key: "tenant", value: "a" }],
+    };
+    const ordinary = {
+      products: ["p2", "p3"],
+      currentBalance: { gte: 10, lte: 30 },
+      metadata: [{ key: "tag", value: "b" }],
+    };
+    // Act
+    const result = intersectLegacyFilters(locked, ordinary);
+
+    // Assert
+    expect(result).toEqual({
+      filter: {
+        products: ["p2"],
+        currentBalance: { gte: 10, lte: 20 },
+        metadata: [...locked.metadata, ...ordinary.metadata],
+      },
+      conflict: false,
+    });
+    expect(intersectLegacyFilters({ products: ["p1"] }, { products: ["p2"] }).conflict).toBe(true);
+    expect(hasScopeConstraints({ products: [] })).toBe(true);
+    expect(hasScopeConstraints({ filter: {}, search: undefined })).toBe(false);
+  });
+
+  it("fingerprints object keys canonically and deduplicates object identity by ID", () => {
+    // Arrange
+    const items = [
+      { id: "1", name: "same" },
+      { id: "2", name: "same" },
+      { id: "1", name: "updated" },
+    ];
+
+    // Act / Assert
+    expect(scopeFingerprint({ search: "term", filter: { active: true }, missing: undefined })).toBe(
+      scopeFingerprint({ filter: { active: true }, search: "term" }),
+    );
+    expect(uniqueById(items)).toEqual([items[2], items[1]]);
+    expect(uniqueIds(["1", "1", "2"])).toEqual(["1", "2"]);
+  });
+
+  it("never makes loading, failed or previous-variable results actionable", () => {
+    // Arrange
+    const expected = { filter: { currency: "EUR" } };
+    const result = { loading: false, data: { giftCards: {} }, variables: expected };
+
+    // Act / Assert
+    expect(isCurrentListResult(result, expected)).toBe(true);
+    expect(isCurrentListResult({ ...result, loading: true }, expected)).toBe(false);
+    expect(isCurrentListResult({ ...result, error: new Error("failed") }, expected)).toBe(false);
+    expect(
+      isCurrentListResult({ ...result, variables: { filter: { currency: "USD" } } }, expected),
+    ).toBe(false);
+    expect(isCurrentListResult({ loading: false }, expected)).toBe(false);
+  });
+
+  it("hides obsolete selected IDs during the scope-changing render", () => {
+    // Arrange
+    const clear = jest.fn();
+    const { result, rerender } = renderHook(
+      ({ fingerprint }) => useScopedSelection(fingerprint, ["old", "old"], clear),
+      { initialProps: { fingerprint: "old-scope" } },
+    );
+
+    expect(result.current).toEqual(["old"]);
+    // Act
+    rerender({ fingerprint: "new-scope" });
+    // Assert
+    expect(result.current).toEqual([]);
+    expect(clear).toHaveBeenCalledTimes(1);
+  });
+});
