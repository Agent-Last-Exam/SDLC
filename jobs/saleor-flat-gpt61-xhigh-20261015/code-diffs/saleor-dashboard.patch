@@ -0,0 +1,64 @@
+import { hasUnsafeUrlCharacters } from "@dashboard/extensions/domain/urls";
+import { PermissionEnum } from "@dashboard/graphql";
+import { z } from "zod";
+
+const id = z.string().min(1);
+const action = <T extends z.ZodTypeAny>(type: string, payload: T) =>
+  z.object({ type: z.literal(type), payload }).strict();
+const safeLocation = z
+  .string()
+  .min(1)
+  .refine(value => {
+    if (hasUnsafeUrlCharacters(value) || value.startsWith("//")) return false;
+
+    if (value.startsWith("/")) return true;
+
+    try {
+      const url = new URL(value);
+
+      return ["http:", "https:"].includes(url.protocol) && !url.username && !url.password;
+    } catch {
+      return false;
+    }
+  });
+
+export const legacyAppActionSchema = z.union([
+  action("notifyReady", z.object({ actionId: id }).strict()),
+  action(
+    "notification",
+    z
+      .object({
+        actionId: id,
+        status: z.enum(["info", "success", "warning", "error"]).optional(),
+        title: z.string().optional(),
+        text: z.string().optional(),
+        apiMessage: z.string().optional(),
+      })
+      .strict(),
+  ),
+  action(
+    "redirect",
+    z.object({ actionId: id, to: safeLocation, newContext: z.boolean().optional() }).strict(),
+  ),
+  action(
+    "updateRouting",
+    z
+      .object({
+        actionId: id,
+        newRoute: z
+          .string()
+          .refine(value => !value.startsWith("//") && !hasUnsafeUrlCharacters(value)),
+      })
+      .strict(),
+  ),
+  action(
+    "requestPermissions",
+    z
+      .object({
+        actionId: id,
+        permissions: z.array(z.nativeEnum(PermissionEnum)),
+        redirectPath: safeLocation,
+      })
+      .strict(),
+  ),
+]);
