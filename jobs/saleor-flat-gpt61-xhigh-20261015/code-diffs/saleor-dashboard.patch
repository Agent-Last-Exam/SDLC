+});
+
+describe("saved product channel diagnostics", () => {
+  it("uses server counts and severity, including digital not-applicable facts", async () => {
+    // Arrange & Act
+    render(<ProductChannelDiagnostics productId="product" savedRevision={0} />);
+
+    // Assert
+    expect(await screen.findByText("Online USD · USD")).toBeInTheDocument();
+    expect(screen.getByText("41 visible channels")).toBeInTheDocument();
+    expect(screen.getByText(/2 issues \(blocking and warnings\)/)).toBeInTheDocument();
+    expect(screen.getByText(/Blocking · PRODUCT_NOT_YET_AVAILABLE/)).toBeInTheDocument();
+    expect(screen.getByText(/Warning · INSUFFICIENT_STOCK/)).toBeInTheDocument();
+    expect(screen.getByText(/Not applicable · SHIPPING_NOT_REQUIRED/)).toBeInTheDocument();
+    expect(screen.getByText(/Based on the saved product, not unsaved edits/)).toBeInTheDocument();
+    expect(query).toHaveBeenCalledWith(
+      expect.objectContaining({
+        variables: { id: "product", filter: {}, first: 20 },
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+      }),
+    );
+  });
+
+  it("applies channel name and currency filters and resets bounded paging", async () => {
+    // Arrange
+    render(<ProductChannelDiagnostics productId="product" savedRevision={0} />);
+    await screen.findByText("Online USD · USD");
+
+    // Act
+    fireEvent.click(screen.getByRole("button", { name: "Next" }));
+    await waitFor(() =>
+      expect(query).toHaveBeenLastCalledWith(
+        expect.objectContaining({
+          variables: { id: "product", filter: {}, first: 20, after: "end" },
+        }),
+      ),
+    );
+    fireEvent.change(screen.getByLabelText("Channel name"), { target: { value: "  Europe  " } });
+    fireEvent.change(screen.getByLabelText("Currency (ISO code)"), { target: { value: "eur" } });
+    fireEvent.click(screen.getByRole("button", { name: "Apply filters" }));
+
+    // Assert
+    await waitFor(() =>
+      expect(query).toHaveBeenLastCalledWith(
+        expect.objectContaining({
+          variables: { id: "product", filter: { search: "Europe", currency: "EUR" }, first: 20 },
+        }),
+      ),
+    );
+  });
+
+  it("does not issue invalid filter requests", async () => {
+    // Arrange
+    render(<ProductChannelDiagnostics productId="product" savedRevision={0} />);
+    await screen.findByText("Online USD · USD");
+
+    // Act
+    fireEvent.change(screen.getByLabelText("Currency (ISO code)"), { target: { value: "EU" } });
+    fireEvent.click(screen.getByRole("button", { name: "Apply filters" }));
+
+    // Assert
+    expect(screen.getByRole("alert")).toHaveTextContent("three-letter currency code");
+    expect(query).toHaveBeenCalledTimes(1);
+  });
+
+  it("shows request errors rather than a false zero-issue state", async () => {
+    // Arrange
+    query.mockRejectedValueOnce(new Error("offline"));
+
+    // Act
+    render(<ProductChannelDiagnostics productId="product" savedRevision={0} />);
+
+    // Assert
+    expect(await screen.findByRole("alert")).toHaveTextContent(
+      "This does not mean the product has no issues",
+    );
+    expect(screen.queryByText(/visible channels/)).not.toBeInTheDocument();
+    expect(screen.getByRole("button", { name: "Retry" })).toBeInTheDocument();
+  });
+
+  it("does not request diagnostics without product permission", () => {
+    // Arrange
+    (useUser as jest.Mock).mockReturnValue({ user: { userPermissions: [] } });
+
+    // Act
+    const { container } = render(
+      <ProductChannelDiagnostics productId="product" savedRevision={0} />,
+    );
+
+    // Assert
+    expect(query).not.toHaveBeenCalled();
+    expect(container).toBeEmptyDOMElement();
+  });
+
+  it("renders server permission errors explicitly", async () => {
+    // Arrange
+    query.mockRejectedValueOnce(
+      new ApolloError({
+        graphQLErrors: [
+          new GraphQLError("Forbidden", { extensions: { code: "PERMISSION_DENIED" } }),
+        ],
+      }),
+    );
+
+    // Act
+    render(<ProductChannelDiagnostics productId="product" savedRevision={0} />);
+
+    // Assert
+    expect(await screen.findByRole("alert")).toHaveTextContent("do not have permission");
+  });
+
+  it("ignores old-product responses and refreshes only for saved revisions", async () => {
+    // Arrange
+    let resolve!: (value: unknown) => void;
+
+    query.mockReturnValueOnce(
+      new Promise(done => {
+        resolve = done;
+      }),
+    );
+
+    const { rerender } = render(<ProductChannelDiagnostics productId="old" savedRevision={0} />);
+
+    // Act
+    query.mockResolvedValue(response("new", "New channel"));
+    rerender(<ProductChannelDiagnostics productId="new" savedRevision={0} />);
+    await screen.findByText("New channel · USD");
+    await act(async () => {
+      resolve(response("old", "Old channel"));
+    });
+
+    // Assert
+    expect(screen.queryByText("Old channel · USD")).not.toBeInTheDocument();
+    expect(screen.getByText("New channel · USD")).toBeInTheDocument();
+    rerender(<ProductChannelDiagnostics productId="new" savedRevision={1} />);
+    await waitFor(() => expect(query).toHaveBeenCalledTimes(3));
+  });
+});
diff --git a/src/products/components/ProductUpdatePage/ProductChannelDiagnostics.tsx b/src/products/components/ProductUpdatePage/ProductChannelDiagnostics.tsx
new file mode 100644
index 0000000..8b077ac
--- /dev/null
+++ b/src/products/components/ProductUpdatePage/ProductChannelDiagnostics.tsx
@@ -0,0 +1,328 @@
+import { ApolloError, useApolloClient } from "@apollo/client";
+import { useUser } from "@dashboard/auth";
+import { hasPermission } from "@dashboard/auth/misc";
+import { DashboardCard } from "@dashboard/components/Card";
+import {
+  AvailabilityIssueSeverityEnum,
+  PermissionEnum,
+  ProductChannelAvailabilityDocument,
+  ProductChannelAvailabilityQuery,
+  ProductChannelAvailabilityQueryVariables,
+} from "@dashboard/graphql";
+import { Box, Button, Input, Text } from "@saleor/macaw-ui-next";
+import { useLayoutEffect, useRef, useState } from "react";
+import { useIntl } from "react-intl";
+
+type Connection = NonNullable<ProductChannelAvailabilityQuery["product"]>["channelAvailability"];
+
+export function ProductChannelDiagnostics({
+  productId,
+  savedRevision,
+}: {
+  productId: string;
+  savedRevision: number;
+}) {
+  const client = useApolloClient();
+  const intl = useIntl();
+  const { user } = useUser();
+  const canRead = !!user && hasPermission(PermissionEnum.MANAGE_PRODUCTS, user);
+  const [search, setSearch] = useState("");
+  const [currency, setCurrency] = useState("");
+  const [filter, setFilter] = useState<{ search?: string; currency?: string }>({});
+  const [page, setPage] = useState<
+    Pick<ProductChannelAvailabilityQueryVariables, "first" | "last" | "before" | "after">
+  >({ first: 20 });
+  const [retry, setRetry] = useState(0);
+  const [validationError, setValidationError] = useState(false);
+  const fingerprint = JSON.stringify([productId, filter, page, savedRevision, retry, canRead]);
+  const active = useRef({ fingerprint, generation: 0 });
+  const [result, setResult] = useState<{
+    fingerprint: string;
+    connection?: Connection;
+    loading: boolean;
+    error?: "permission" | "request" | "notFound";
+  }>({ fingerprint, loading: true });
+
+  useLayoutEffect(() => {
+    active.current = { fingerprint, generation: active.current.generation + 1 };
+
+    if (!canRead) {
+      return;
+    }
+
+    const generation = ++active.current.generation;
+
+    client
+      .query<ProductChannelAvailabilityQuery, ProductChannelAvailabilityQueryVariables>({
+        query: ProductChannelAvailabilityDocument,
+        variables: { id: productId, filter, ...page },
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+      })
+      .then(response => {
+        if (
+          active.current.fingerprint !== fingerprint ||
+          generation !== active.current.generation
+        ) {
+          return;
+        }
+
+        if (!response.data?.product || response.data.product.id !== productId) {
+          setResult({ fingerprint, loading: false, error: "notFound" });
+        } else if (!response.data.product.channelAvailability) {
+          setResult({ fingerprint, loading: false, error: "request" });
+        } else {
+          setResult({
+            fingerprint,
+            loading: false,
+            connection: response.data.product.channelAvailability,
+          });
+        }
+      })
+      .catch(error => {
+        if (
+          active.current.fingerprint === fingerprint &&
+          generation === active.current.generation
+        ) {
+          const permission =
+            error instanceof ApolloError &&
+            error.graphQLErrors.some(item => item.extensions?.code === "PERMISSION_DENIED");
+
+          setResult({ fingerprint, loading: false, error: permission ? "permission" : "request" });
+        }
+      });
+
+    return () => {
+      active.current.generation += 1;
+    };
+  }, [fingerprint, canRead, retry]);
+
+  if (!canRead) {
+    return null;
+  }
+
+  const sameScope = result.fingerprint === fingerprint;
+  const loading = !sameScope || result.loading;
+  const connection = sameScope ? result.connection : undefined;
+  const applyFilter = () => {
+    const nextSearch = search.trim();
+    const nextCurrency = currency.trim().toUpperCase();
+    const invalid =
+      Array.from(nextSearch).length > 256 ||
+      (nextCurrency !== "" && !/^[A-Z]{3}$/.test(nextCurrency));
+
+    setValidationError(invalid);
+
+    if (!invalid) {
+      setPage({ first: 20 });
+      setFilter({
+        ...(nextSearch ? { search: nextSearch } : {}),
+        ...(nextCurrency ? { currency: nextCurrency } : {}),
+      });
+    }
+  };
+  const severityLabel = (severity: AvailabilityIssueSeverityEnum) => {
+    switch (severity) {
+      case AvailabilityIssueSeverityEnum.BLOCKING:
+        return intl.formatMessage({
+          id: "jPm39S",
+          defaultMessage: "Blocking",
+        });
+      case AvailabilityIssueSeverityEnum.WARNING:
+        return intl.formatMessage({ id: "3SVI5p", defaultMessage: "Warning" });
+      case AvailabilityIssueSeverityEnum.NOT_APPLICABLE:
+        return intl.formatMessage({
+          id: "61zy45",
+          defaultMessage: "Not applicable",
+        });
+    }
+  };
+
+  return (
+    <DashboardCard>
+      <DashboardCard.Header>
+        <DashboardCard.Title>
+          {intl.formatMessage({
+            id: "bTLxTm",
+            defaultMessage: "Channel availability diagnostics",
+          })}
+        </DashboardCard.Title>
+      </DashboardCard.Header>
+      <DashboardCard.Content>
+        <Text display="block" marginBottom={3}>
+          {intl.formatMessage({
+            id: "N2TYlT",
+            defaultMessage:
+              "Based on the saved product, not unsaved edits. Diagnostics are read-only and do not replace checkout validation.",
+          })}
+        </Text>
+        <Box display="flex" flexDirection="column" gap={3}>
+          <Input
+            name="diagnosticSearch"
+            label={intl.formatMessage({
+              id: "/xYsBJ",
+              defaultMessage: "Channel name",
+            })}
+            value={search}
+            onChange={event => setSearch(event.target.value)}
+          />
+          <Input
+            name="diagnosticCurrency"
+            label={intl.formatMessage({
+              id: "NSCSdz",
+              defaultMessage: "Currency (ISO code)",
+            })}
+            value={currency}
+            onChange={event => setCurrency(event.target.value)}
+          />
+          <Button type="button" onClick={applyFilter}>
+            {intl.formatMessage({
+              id: "wTo1un",
+              defaultMessage: "Apply filters",
+            })}
+          </Button>
+          <Button type="button" disabled={loading} onClick={() => setRetry(value => value + 1)}>
+            {intl.formatMessage({
+              id: "u93KL0",
+              defaultMessage: "Refresh diagnostics",
+            })}
+          </Button>
+        </Box>
+        {validationError && (
+          <Text role="alert">
+            {intl.formatMessage({
+              id: "zV1yn8",
+              defaultMessage:
+                "Use at most 256 characters for the channel name and a three-letter currency code.",
+            })}
+          </Text>
+        )}
+        {loading && (
+          <Text role="status">
+            {intl.formatMessage({
+              id: "ip0PsT",
+              defaultMessage: "Refreshing diagnostics. Any displayed results are out of date.",
+            })}
+          </Text>
+        )}
+        {sameScope && result.error && (
+          <Box role="alert">
+            <Text>
+              {result.error === "permission"
+                ? intl.formatMessage({
+                    id: "YuJG8Y",
+                    defaultMessage: "You do not have permission to read these diagnostics.",
+                  })
+                : result.error === "notFound"
+                  ? intl.formatMessage({
+                      id: "pokID7",
+                      defaultMessage: "Product not found.",
+                    })
+                  : intl.formatMessage({
+                      id: "erMsTP",
+                      defaultMessage:
+                        "Diagnostics could not be loaded. This does not mean the product has no issues.",
+                    })}
+            </Text>
+            <Button type="button" onClick={() => setRetry(value => value + 1)}>
+              {intl.formatMessage({ id: "62nsdy", defaultMessage: "Retry" })}
+            </Button>
+          </Box>
+        )}
+        {connection && (
+          <>
+            <Text display="block" marginTop={4}>
+              {intl.formatMessage(
+                { id: "1uEtIA", defaultMessage: "{count} visible channels" },
+                { count: connection.totalCount },
+              )}
+            </Text>
+            {connection.edges.length === 0 && (
+              <Text>
+                {intl.formatMessage({
+                  id: "tD/UMK",
+                  defaultMessage: "No channels match these filters.",
+                })}
+              </Text>
+            )}
+            {connection.edges.map(({ node }) => (
+              <Box
+                key={node.channel.id}
+                paddingY={4}
+                borderBottomWidth={1}
+                borderBottomStyle="solid"
+                borderColor="default1"
+              >
+                <Text fontWeight="bold" display="block">
+                  {node.channel.name} · {node.channel.currencyCode}
+                </Text>
+                <Text display="block">
+                  {node.isAvailable
+                    ? intl.formatMessage({
+                        id: "PgJGHT",
+                        defaultMessage: "Available",
+                      })
+                    : intl.formatMessage({
+                        id: "UpwcFd",
+                        defaultMessage: "Unavailable",
+                      })}{" "}
+                  ·{" "}
+                  {intl.formatMessage(
+                    {
+                      id: "wOI1TL",
+                      defaultMessage: "{count} issues (blocking and warnings)",
+                    },
+                    { count: node.issueCount },
+                  )}
+                </Text>
+                <Text size={2} display="block">
+                  {intl.formatMessage(
+                    {
+                      id: "dVMtqh",
+                      defaultMessage: "Evaluated at {timestamp}",
+                    },
+                    { timestamp: node.evaluatedAt },
+                  )}
+                </Text>
+                <ul>
+                  {node.issues.map((issue, index) => (
+                    <li key={`${issue.code}-${index}`}>
+                      <Text
+                        color={
+                          issue.severity === AvailabilityIssueSeverityEnum.BLOCKING
+                            ? "critical1"
+                            : "default1"
+                        }
+                      >
+                        {severityLabel(issue.severity)} · {issue.code}: {issue.message}
+                      </Text>
+                    </li>
+                  ))}
+                </ul>
+              </Box>
+            ))}
+            <Box display="flex" gap={3} marginTop={4}>
+              <Button
+                type="button"
+                disabled={loading || !connection.pageInfo.hasPreviousPage}
+                onClick={() => setPage({ last: 20, before: connection.pageInfo.startCursor })}
+              >
+                {intl.formatMessage({
+                  id: "JJNc3c",
+                  defaultMessage: "Previous",
+                })}
+              </Button>
+              <Button
+                type="button"
+                disabled={loading || !connection.pageInfo.hasNextPage}
+                onClick={() => setPage({ first: 20, after: connection.pageInfo.endCursor })}
+              >
+                {intl.formatMessage({ id: "9+Ddtu", defaultMessage: "Next" })}
+              </Button>
+            </Box>
+          </>
+        )}
+      </DashboardCard.Content>
+    </DashboardCard>
+  );
+}
