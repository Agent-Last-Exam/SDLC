+import { OrderDetailsFragment } from "@dashboard/graphql";
+import { paymentSummaryFixture, prepareMoney } from "@dashboard/orders/fixtures";
+import { render, screen } from "@testing-library/react";
+
+import { PaymentsSummary } from "../OrderPaymentSummaryCard/components/PaymentsSummary/PaymentsSummary";
+import OrderSummaryCard from "./OrderSummaryCard";
+
+jest.mock("./SummaryLine", () => ({
+  __esModule: true,
+  default: ({
+    text,
+    subText,
+    money,
+  }: {
+    text: React.ReactNode;
+    subText?: React.ReactNode;
+    money: { amount: number };
+  }) => (
+    <li>
+      {text}
+      <span>{subText}</span>
+      <output>{money.amount}</output>
+    </li>
+  ),
+}));
+jest.mock("../OrderPaymentSummaryCard/styles", () => ({ useStyles: () => ({ amountGrid: "" }) }));
+jest.mock("./utils", () => ({ getDeliveryMethodName: () => "Historical delivery" }));
+
+const makeOrder = () =>
+  ({
+    paymentSummary: {
+      ...paymentSummaryFixture(),
+      charged: prepareMoney(80),
+      refunded: prepareMoney(20),
+      giftCardCharged: prepareMoney(20),
+      balance: prepareMoney(-50),
+      outstanding: prepareMoney(50),
+      chargePending: prepareMoney(7),
+      refundPending: prepareMoney(3),
+    },
+    totalCharged: prepareMoney(999),
+    total: { gross: prepareMoney(999) },
+  }) as OrderDetailsFragment;
+
+describe("authoritative order summary", () => {
+  it("shows current net charged without deducting historical refunds again and keeps pending separate", () => {
+    // Arrange
+    const order = makeOrder();
+
+    // Act
+    render(<PaymentsSummary order={order} />);
+    // Assert
+    expect(screen.getByText("Net charged").closest("li")).toHaveTextContent("80");
+    expect(screen.getByText("Historical refunded").closest("li")).toHaveTextContent("20");
+    expect(screen.getByText("Charge pending").closest("li")).toHaveTextContent("7");
+    expect(screen.getByText("Refund pending").closest("li")).toHaveTextContent("3");
+    expect(screen.getByText("Outstanding").closest("li")).toHaveTextContent("50");
+    expect(screen.queryByText("999")).not.toBeInTheDocument();
+  });
+
+  it("uses server total and explains gift-card payment without subtracting contribution or discounts again", () => {
+    // Arrange
+    const order = makeOrder();
+
+    // Act
+    render(<OrderSummaryCard order={order} />);
+    // Assert
+    expect(screen.getByText("Total").closest("li")).toHaveTextContent("110");
+    expect(screen.getByText("Gift card contribution").closest("li")).toHaveTextContent("20");
+    expect(
+      screen.getByText("Payment contribution, not an additional discount"),
+    ).toBeInTheDocument();
+    expect(screen.getByText("Already included in gross prices")).toBeInTheDocument();
+    expect(screen.queryByText("999")).not.toBeInTheDocument();
+  });
+
+  it("labels a historical gift-card deduction as already included", () => {
+    // Arrange
+    const order = makeOrder();
+
+    order.paymentSummary.giftCardAmountBasis =
+      "LEGACY_TOTAL_DEDUCTION" as typeof order.paymentSummary.giftCardAmountBasis;
+    // Act
+    render(<OrderSummaryCard order={order} />);
+    // Assert
+    expect(screen.getByText("Historical deduction already included in total")).toBeInTheDocument();
+    expect(screen.getByText("Total").closest("li")).toHaveTextContent("110");
+  });
+});
diff --git a/src/orders/hooks/useDraftEligibility.ts b/src/orders/hooks/useDraftEligibility.ts
new file mode 100644
index 0000000..b610973
--- /dev/null
+++ b/src/orders/hooks/useDraftEligibility.ts
@@ -0,0 +1,164 @@
+import { useApolloClient } from "@apollo/client";
+import { OrderDetailsFragment, OrderDraftEligibilityQuery } from "@dashboard/graphql";
+import { orderDraftEligibilityQuery } from "@dashboard/orders/queries";
+import { getVariantSearchAddress } from "@dashboard/orders/utils/data";
+import { getDraftEligibilityError } from "@dashboard/orders/utils/draftEligibility";
+import { useEffect, useRef, useState } from "react";
+
+export const getDraftVariantQuantities = (lines: OrderDetailsFragment["lines"]) =>
+  lines.reduce<Record<string, number>>((quantities, line) => {
+    if (line.variant) {
+      quantities[line.variant.id] = (quantities[line.variant.id] ?? 0) + line.quantity;
+    }
+
+    return quantities;
+  }, {});
+
+export const useDraftEligibility = (order: OrderDetailsFragment, canManageOrders: boolean) => {
+  const client = useApolloClient();
+  const quantities = getDraftVariantQuantities(order.lines);
+  const address = getVariantSearchAddress(order);
+  const context = JSON.stringify([
+    order.id,
+    order.status,
+    order.channel.slug,
+    address,
+    quantities,
+    canManageOrders,
+  ]);
+  const current = useRef({ context, pending: false });
+  const mounted = useRef(true);
+  const [state, setState] = useState<{
+    context: string;
+    loading: boolean;
+    data?: OrderDraftEligibilityQuery;
+    error?: string;
+  }>({ context, loading: true });
+
+  if (current.current.context !== context) {
+    current.current = { context, pending: false };
+  }
+
+  useEffect(
+    () => () => {
+      mounted.current = false;
+    },
+    [],
+  );
+
+  const isCurrent = () => mounted.current && current.current.context === context;
+  const fetch = async (selected: Record<string, number>) => {
+    if (Object.keys(selected).length > 100) {
+      throw new Error("Check at most 100 variants at a time before adding or finalizing.");
+    }
+
+    const result = await client.query<OrderDraftEligibilityQuery>({
+      query: orderDraftEligibilityQuery,
+      variables: {
+        id: order.id,
+        channel: order.channel.slug,
+        variantIds: Object.keys(selected),
+        address,
+      },
+      fetchPolicy: "no-cache",
+      errorPolicy: "none",
+    });
+
+    if (result.errors?.length || !result.data?.order) {
+      throw new Error("Current eligibility could not be loaded.");
+    }
+
+    return result.data;
+  };
+
+  useEffect(() => {
+    let active = true;
+
+    if (!canManageOrders) {
+      setState({ context, loading: false });
+
+      return;
+    }
+
+    setState({ context, loading: true });
+    void fetch(quantities)
+      .then(data => {
+        if (active && isCurrent()) {
+          setState({ context, loading: false, data });
+        }
+      })
+      .catch(error => {
+        if (active && isCurrent()) {
+          setState({
+            context,
+            loading: false,
+            error:
+              error instanceof Error ? error.message : "Current eligibility could not be loaded.",
+          });
+        }
+      });
+
+    return () => {
+      active = false;
+    };
+    // The serialized context includes every order, permission and address input to this read.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [client, context]);
+
+  const scoped =
+    state.context === context
+      ? state
+      : { context, loading: true, data: undefined, error: undefined };
+  const reason = !canManageOrders
+    ? "Order-management permission is required."
+    : scoped.loading
+      ? "Checking current channel, product, shipping and configuration eligibility…"
+      : (scoped.error ??
+        getDraftEligibilityError(scoped.data, order.channel.slug, quantities, true));
+  const check = async (selected: Record<string, number>, finalize: boolean) => {
+    const scope = current.current;
+
+    if (!canManageOrders || !isCurrent()) {
+      return "Order context or permissions changed.";
+    }
+
+    if (scope.pending) {
+      return "An eligibility check is already in progress.";
+    }
+
+    if (Object.keys(selected).length > 100) {
+      return "Check at most 100 variants at a time before adding or finalizing.";
+    }
+
+    scope.pending = true;
+    setState(previous => ({ ...previous, loading: true }));
+
+    try {
+      const data = await fetch(selected);
+
+      if (!isCurrent() || current.current !== scope) {
+        return "Order context changed.";
+      }
+
+      const error = getDraftEligibilityError(data, order.channel.slug, selected, finalize);
+
+      setState({ context, loading: false, data, error: error ?? undefined });
+
+      return error;
+    } catch {
+      if (isCurrent() && current.current === scope) {
+        setState({
+          context,
+          loading: false,
+          error: "Current eligibility could not be confirmed. No mutation was sent.",
+        });
+      }
+
+      return "Current eligibility could not be confirmed. No mutation was sent.";
+    } finally {
+      scope.pending = false;
+    }
+  };
+
+  return { reason, loading: scoped.loading, quantities, check, isCurrent };
+};
diff --git a/src/orders/hooks/useOrderInlineMetadata.ts b/src/orders/hooks/useOrderInlineMetadata.ts
new file mode 100644
index 0000000..a5942f0
--- /dev/null
+++ b/src/orders/hooks/useOrderInlineMetadata.ts
@@ -0,0 +1,128 @@
+import { MetadataIdSchema } from "@dashboard/components/Metadata";
+import { useMetadataBundles } from "@dashboard/hooks/useMetadataBundles";
+import {
+  getMetadataUpdateInput,
+  MetadataSaveError,
+  useMetadataUpdate,
+} from "@dashboard/hooks/useMetadataUpdate";
+import useNotifier from "@dashboard/hooks/useNotifier";
+import { commonMessages } from "@dashboard/intl";
+import { useEffect, useLayoutEffect, useRef, useState } from "react";
+import { useIntl } from "react-intl";
+
+export const useOrderInlineMetadata = (
+  order: { id: string; fulfillments: Array<{ id: string }> } | null | undefined,
+  canManageOrders: boolean,
+) => {
+  const intl = useIntl();
+  const notify = useNotifier();
+  const contextKey = JSON.stringify([
+    order?.id,
+    canManageOrders,
+    order?.fulfillments.map(item => item.id),
+  ]);
+  const current = useRef(contextKey);
+  const mounted = useRef(true);
+  const [localErrors, setLocalErrors] = useState<{
+    contextKey: string;
+    errors: MetadataSaveError[];
+  }>({ contextKey, errors: [] });
+
+  useLayoutEffect(() => {
+    current.current = contextKey;
+  }, [contextKey]);
+  useEffect(
+    () => () => {
+      mounted.current = false;
+    },
+    [],
+  );
+
+  const targets = order
+    ? [order.id, ...order.fulfillments.map(item => item.id)].map(id => ({
+        id,
+        includePrivate: canManageOrders,
+      }))
+    : [];
+  const source = useMetadataBundles(contextKey, targets, !order);
+  const mutation = useMetadataUpdate(contextKey);
+  const initial: MetadataIdSchema = Object.fromEntries(
+    Object.values(source.bundles).map(bundle => [
+      bundle.id,
+      {
+        metadata: bundle.metadata,
+        privateMetadata: bundle.privateMetadata ?? [],
+      },
+    ]),
+  );
+  const save = async (draft: MetadataIdSchema) => {
+    const isCurrent = () => mounted.current && current.current === contextKey;
+    const fail = (code: string, message: string) => {
+      const errors = [{ field: null, code, message }];
+
+      if (isCurrent()) {
+        setLocalErrors({ contextKey, errors });
+      }
+
+      return errors;
+    };
+
+    if (!isCurrent() || source.loading || source.error || !canManageOrders || !order) {
+      return fail("UNCONFIRMED", "Load the current metadata before saving.");
+    }
+
+    setLocalErrors({ contextKey, errors: [] });
+
+    try {
+      const input = targets.flatMap(({ id }) => {
+        const bundle = source.bundles[id];
+
+        if (!bundle || !draft[id]) {
+          throw new Error("Load the current metadata before saving.");
+        }
+
+        const update = getMetadataUpdateInput(bundle, draft[id]);
+
+        return update ? [update] : [];
+      });
+      const result = await mutation.save(input, canManageOrders);
+
+      if (!isCurrent()) {
+        return [
+          {
+            field: null,
+            code: "UNCONFIRMED",
+            message: "Order context changed; the old save was not applied to this form.",
+          },
+        ];
+      }
+
+      if (!result.errors.length) {
+        source.accept(result.bundles);
+
+        if (input.length) {
+          notify({ status: "success", text: intl.formatMessage(commonMessages.savedChanges) });
+        }
+      }
+
+      return result.errors;
+    } catch (error) {
+      return fail(
+        "INVALID",
+        error instanceof Error ? error.message : "Metadata could not be saved.",
+      );
+    }
+  };
+
+  return {
+    ...source,
+    ...mutation,
+    initial,
+    save,
+    errors: [
+      ...mutation.errors,
+      ...(localErrors.contextKey === contextKey ? localErrors.errors : []),
+    ],
+    loading: source.loading || mutation.loading,
+  };
+};
diff --git a/src/orders/hooks/useOrderPaymentActions.ts b/src/orders/hooks/useOrderPaymentActions.ts
new file mode 100644
index 0000000..7549054
--- /dev/null
+++ b/src/orders/hooks/useOrderPaymentActions.ts
@@ -0,0 +1,230 @@
+import { useUserPermissions } from "@dashboard/auth/hooks/useUserPermissions";
+import { hasPermissions } from "@dashboard/components/RequirePermissions";
+import {
+  OrderAction,
+  OrderDetailsFragment,
+  PermissionEnum,
+  TransactionActionEnum,
+} from "@dashboard/graphql";
+import { OrderUrlQueryParams } from "@dashboard/orders/urls";
+import {
+  canMarkOrderPaid,
+  compareAmounts,
+  getAvailableCapture,
+  isTransactionActionAvailable,
+  validatePaymentAmount,
+} from "@dashboard/orders/utils/payments";
+
+import { usePaymentRequest } from "./usePaymentRequest";
+
+interface Provider {
+  mutate: (variables: any) => Promise<any>;
+}
+
+/** Dialog handlers recheck the latest visible facts, even when invoked without a button click. */
+export const useOrderPaymentActions = ({
+  order,
+  params,
+  capture,
+  markPaid,
+  transaction,
+  refresh,
+}: {
+  order: OrderDetailsFragment | undefined;
+  params: OrderUrlQueryParams;
+  capture: Provider;
+  markPaid: Provider;
+  transaction: Provider;
+  refresh: () => Promise<any>;
+}) => {
+  const permissions = useUserPermissions();
+  const canManageOrders = hasPermissions(permissions ?? [], [PermissionEnum.MANAGE_ORDERS]);
+  const canHandlePayments = hasPermissions(permissions ?? [], [PermissionEnum.HANDLE_PAYMENTS]);
+  const selectedTransaction = order?.transactions?.find(item => item.id === params.id);
+  const availableCapture = getAvailableCapture(order);
+  const context = JSON.stringify([
+    order?.id,
+    params.action,
+    params.id,
+    params.type,
+    selectedTransaction?.name,
+    selectedTransaction?.pspReference,
+    order?.payments.map(payment => [payment.id, payment.gateway]),
+    canManageOrders,
+    canHandlePayments,
+  ]);
+  const request = usePaymentRequest(context);
+  const permissionVariables = {
+    hasHandlePayments: canHandlePayments,
+    hasManageGiftCards: hasPermissions(permissions ?? [], [PermissionEnum.MANAGE_GIFT_CARD]),
+  };
+  const checkPayload = (result: any, field: string) => {
+    if (result.errors?.length || result.error) {
+      throw new Error("GraphQL payment result was not confirmed");
+    }
+
+    const payload = result.data?.[field];
+
+    if (!payload || !Array.isArray(payload.errors)) {
+      throw new Error("Missing payment payload");
+    }
+
+    return payload;
+  };
+  const failure = (errors: Array<{ message?: string }>) => ({
+    status: "failed" as const,
+    message: errors.map(error => error.message || "The payment action was rejected.").join(" "),
+  });
+
+  const capturePayment = ({ amount }: { amount: string }) => {
+    if (
+      !order ||
+      !canManageOrders ||
+      params.action !== "capture" ||
+      !order.actions.includes(OrderAction.CAPTURE) ||
+      validatePaymentAmount(amount, availableCapture?.amount, availableCapture?.currency)
+    ) {
+      return;
+    }
+
+    return request.run(`capture:${amount}`, async (idempotencyKey, isCurrent) => {
+      const payload = checkPayload(
+        await capture.mutate({ id: order.id, amount, idempotencyKey, ...permissionVariables }),
+        "orderCapture",
+      );
+
+      if (payload.errors.length) {
+        return failure(payload.errors);
+      }
+
+      if (!payload.order || payload.order.id !== order.id || !payload.order.paymentSummary) {
+        throw new Error("Missing updated payment facts");
+      }
+
+      if (isCurrent()) {
+        await refresh();
+      }
+
+      const confirmed =
+        compareAmounts(
+          payload.order.paymentSummary.charged.amount,
+          order.paymentSummary.charged.amount,
+        ) === 1;
+
+      return {
+        status: confirmed ? "succeeded" : "pending",
+        message: confirmed
+          ? "Capture confirmed by updated charged amount."
+          : "Capture request accepted. Financial completion is pending; check refreshed amounts and events.",
+      };
+    });
+  };
+  const markOrderPaid = (transactionReference: string) => {
+    if (params.action !== "mark-paid" || !canMarkOrderPaid(order, canManageOrders)) {
+      return;
+    }
+
+    return request.run(`mark-paid:${transactionReference}`, async (idempotencyKey, isCurrent) => {
+      const payload = checkPayload(
+        await markPaid.mutate({
+          id: order!.id,
+          transactionReference,
+          idempotencyKey,
+          ...permissionVariables,
+        }),
+        "orderMarkAsPaid",
+      );
+
+      if (payload.errors.length) {
+        return failure(payload.errors);
+      }
+
+      if (!payload.order || payload.order.id !== order!.id) {
+        throw new Error("Missing updated order");
+      }
+
+      if (isCurrent()) {
+        await refresh();
+      }
+
+      return {
+        status: payload.order.isPaid ? "succeeded" : "pending",
+        message: payload.order.isPaid
+          ? "Updated order facts confirm the order is paid."
+          : "Request accepted; payment is not yet confirmed.",
+      };
+    });
+  };
+  const requestTransactionAction = (amount?: string, allAvailable = false) => {
+    const action = params.type;
+
+    if (
+      !canHandlePayments ||
+      params.action !== "transaction-action" ||
+      !selectedTransaction ||
+      !action ||
+      !isTransactionActionAvailable(selectedTransaction, action)
+    ) {
+      return;
+    }
+
+    const available =
+      action === TransactionActionEnum.REFUND
+        ? selectedTransaction.availableRefundAmount
+        : action === TransactionActionEnum.CHARGE
+          ? selectedTransaction.availableChargeAmount
+          : selectedTransaction.authorizedAmount;
+
+    if (
+      (amount === undefined && !allAvailable) ||
+      (amount !== undefined && validatePaymentAmount(amount, available.amount, available.currency))
+    ) {
+      return;
+    }
+
+    return request.run(
+      `transaction:${action}:${amount ?? "explicit-all"}`,
+      async (idempotencyKey, isCurrent) => {
+        const payload = checkPayload(
+          await transaction.mutate({
+            transactionId: selectedTransaction.id,
+            action,
+            ...(amount === undefined ? {} : { amount }),
+            idempotencyKey,
+          }),
+          "transactionRequestAction",
+        );
+
+        if (payload.errors.length) {
+          return failure(payload.errors);
+        }
+
+        if (!payload.transaction || payload.transaction.id !== selectedTransaction.id) {
+          throw new Error("Missing updated transaction");
+        }
+
+        if (isCurrent()) {
+          await refresh();
+        }
+
+        // Acceptance alone, including an empty event list, is never financial success.
+        return {
+          status: "pending",
+          message:
+            "Action request accepted. Check the transaction's pending, failure or success events and refreshed net amounts for confirmation.",
+        };
+      },
+    );
+  };
+
+  return {
+    request,
+    availableCapture,
+    selectedTransaction,
+    canManageOrders,
+    canHandlePayments,
+    capturePayment,
+    markOrderPaid,
+    requestTransactionAction,
+  };
+};
diff --git a/src/orders/hooks/usePaymentRequest.test.ts b/src/orders/hooks/usePaymentRequest.test.ts
new file mode 100644
index 0000000..b20099c
--- /dev/null
+++ b/src/orders/hooks/usePaymentRequest.test.ts
@@ -0,0 +1,100 @@
+import { act, renderHook } from "@testing-library/react-hooks";
+
+import { usePaymentRequest } from "./usePaymentRequest";
+
+const deferred = <T>() => {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>(done => {
+    resolve = done;
+  });
+
+  return { promise, resolve };
+};
+
+describe("payment request identity", () => {
+  it("reuses a UUID on an unconfirmed retry but rotates it for a changed amount or context", async () => {
+    // Arrange
+    const request = jest.fn().mockRejectedValue(new Error("network"));
+    const { result, rerender } = renderHook(({ context }) => usePaymentRequest(context), {
+      initialProps: { context: "order:provider:charge" },
+    });
+
+    // Act
+    await act(async () => {
+      await result.current.run("amount:1", request);
+    });
+    await act(async () => {
+      await result.current.run("amount:1", request);
+    });
+    await act(async () => {
+      await result.current.run("amount:2", request);
+    });
+    rerender({ context: "another-order:provider:charge" });
+    await act(async () => {
+      await result.current.run("amount:2", request);
+    });
+
+    // Assert
+    const keys = request.mock.calls.map(call => call[0]);
+
+    expect(keys[0]).toMatch(/^[\da-f]{8}-[\da-f]{4}-4[\da-f]{3}-[89ab][\da-f]{3}-[\da-f]{12}$/i);
+    expect(keys[1]).toBe(keys[0]);
+    expect(keys[2]).not.toBe(keys[1]);
+    expect(keys[3]).not.toBe(keys[2]);
+    expect(result.current.status).toBe("unconfirmed");
+  });
+
+  it("blocks simultaneous clicks and suppresses stale result side effects after switching objects", async () => {
+    // Arrange
+    const waiting = deferred<{ status: "pending" }>();
+    let isCurrent!: () => boolean;
+    const request = jest.fn((_key, current) => {
+      isCurrent = current;
+
+      return waiting.promise;
+    });
+    const { result, rerender } = renderHook(({ context }) => usePaymentRequest(context), {
+      initialProps: { context: "a" },
+    });
+    let pending: Promise<void> | undefined;
+
+    // Act
+    act(() => {
+      pending = result.current.run("amount:1", request);
+      void result.current.run("amount:1", request);
+    });
+    rerender({ context: "b" });
+    await act(async () => {
+      waiting.resolve({ status: "pending" });
+      await pending;
+    });
+    // Assert
+    expect(request).toHaveBeenCalledTimes(1);
+    expect(isCurrent()).toBe(false);
+    expect(result.current.status).toBe("idle");
+  });
+
+  it("invalidates a pending provider callback when its dialog unmounts", async () => {
+    // Arrange
+    const waiting = deferred<{ status: "pending" }>();
+    let isCurrent!: () => boolean;
+    const { result, unmount } = renderHook(() => usePaymentRequest("order:refund"));
+    let pending: Promise<void> | undefined;
+
+    // Act
+    act(() => {
+      pending = result.current.run("amount:1", (_key, current) => {
+        isCurrent = current;
+
+        return waiting.promise;
+      });
+    });
+    unmount();
+    await act(async () => {
+      waiting.resolve({ status: "pending" });
+      await pending;
+    });
+    // Assert
+    expect(isCurrent()).toBe(false);
+  });
+});
