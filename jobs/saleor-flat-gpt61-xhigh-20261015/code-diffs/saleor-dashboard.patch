+import { gql } from "@apollo/client";
+import { Task, TaskStatus } from "@dashboard/containers/BackgroundTasks/types";
+import { JobStatusEnum } from "@dashboard/graphql";
+import { act, renderHook } from "@testing-library/react-hooks";
+
+import { canExport, exportJobStatus, ExportRequest, useScopedExport } from "./useScopedExport";
+
+const mockQuery = jest.fn();
+const mockNotify = jest.fn();
+const mockQueue = jest.fn();
+const mockDownload = jest.fn();
+let mockPermissions: Array<{ code: string }> = [];
+
+jest.mock("@apollo/client", () => ({
+  ...jest.requireActual<typeof import("@apollo/client")>("@apollo/client"),
+  useApolloClient: () => ({ query: mockQuery }),
+}));
+jest.mock("./downloadExport", () => ({
+  downloadExport: (...args: unknown[]) => mockDownload(...args),
+}));
+jest.mock("@dashboard/auth", () => ({
+  useUser: () => ({ user: { userPermissions: mockPermissions } }),
+}));
+jest.mock("@dashboard/hooks/useNotifier", () => ({ __esModule: true, default: () => mockNotify }));
+jest.mock("@dashboard/hooks/useBackgroundTask", () => ({
+  __esModule: true,
+  default: () => ({ queue: mockQueue }),
+}));
+
+const operation = gql`
+  query TestExport($input: ProductsExportInput!) {
+    productsExport(input: $input) {
+      exportFile {
+        id
+      }
+    }
+  }
+`;
+
+describe("explicit export-query contract", () => {
+  beforeEach(() => {
+    mockQuery.mockReset();
+    mockNotify.mockReset();
+    mockQueue.mockReset();
+    mockDownload.mockReset();
+    mockPermissions = [{ code: "MANAGE_PRODUCTS" }, { code: "MANAGE_PRODUCT_EXPORTS" }];
+  });
+
+  it.each([
+    ["products", "MANAGE_PRODUCTS", "MANAGE_PRODUCT_EXPORTS"],
+    ["giftCards", "MANAGE_GIFT_CARD", "MANAGE_GIFT_CARD_EXPORTS"],
+    ["vouchers", "MANAGE_DISCOUNTS", "MANAGE_VOUCHER_EXPORTS"],
+  ] as const)(
+    "requires dedicated AND domain permission for %s",
+    (domain, manage, exportPermission) => {
+      // Arrange / Act / Assert
+      const granted = (codes: string[]) =>
+        codes.map(code => ({ code })) as Parameters<typeof canExport>[1];
+
+      expect(canExport(domain, granted([manage]))).toBe(false);
+      expect(canExport(domain, granted([exportPermission]))).toBe(false);
+      expect(canExport(domain, granted([manage, exportPermission]))).toBe(true);
+    },
+  );
+
+  it("takes an immutable current snapshot and keeps the same UUID for identical retry", () => {
+    // Arrange
+    const request = new ExportRequest();
+    const scope = { filter: { tags: ["current"] } };
+    // Act
+    const first = request.snapshot(scope);
+
+    scope.filter.tags.push("new");
+
+    const retry = request.snapshot({ filter: { tags: ["current"] } });
+    const changed = request.snapshot(scope);
+
+    // Assert
+    expect(first.filter.tags).toEqual(["current"]);
+    expect(first.idempotencyKey).toMatch(/^[0-9a-f-]{36}$/i);
+    expect(retry.idempotencyKey).toBe(first.idempotencyKey);
+    expect(changed.idempotencyKey).not.toBe(first.idempotencyKey);
+  });
+
+  it("does not call an export on mount, and sends no-cache POST only on explicit action", async () => {
+    // Arrange
+    mockQuery.mockResolvedValue({
+      data: {
+        productsExport: { errors: [], exportFile: { id: "job", status: JobStatusEnum.PENDING } },
+      },
+    });
+
+    const { result } = renderHook(() => useScopedExport("products", operation, "productsExport"));
+
+    expect(mockQuery).not.toHaveBeenCalled();
+    // Act
+    await act(async () => {
+      await result.current.submit({ where: { category: { eq: "locked" } }, search: "coat" }, true);
+    });
+    // Assert
+    expect(mockQuery).toHaveBeenCalledWith(
+      expect.objectContaining({
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+        context: { useBatching: false, fetchOptions: { method: "POST" } },
+        variables: {
+          input: expect.objectContaining({
+            where: { category: { eq: "locked" } },
+            search: "coat",
+            idempotencyKey: expect.any(String),
+          }),
+        },
+      }),
+    );
+    expect(mockNotify).not.toHaveBeenCalledWith(expect.objectContaining({ status: "success" }));
+    expect(mockQueue).toHaveBeenCalledWith(Task.CUSTOM, expect.any(Object));
+    expect(result.current.status).toBe("default");
+  });
+
+  it("blocks stale/failed scope and preserves the key on uncertain transport failure", async () => {
+    // Arrange
+    mockQuery.mockRejectedValue(new Error("network"));
+
+    const { result } = renderHook(() => useScopedExport("products", operation, "productsExport"));
+
+    // Act
+    await act(async () => {
+      await result.current.submit({ search: "current" }, false);
+    });
+    expect(mockQuery).not.toHaveBeenCalled();
+    await act(async () => {
+      await result.current.submit({ search: "current" }, true);
+    });
+    await act(async () => {
+      await result.current.submit({ search: "current" }, true);
+    });
+    // Assert
+    expect(mockQuery.mock.calls[0][0].variables.input.idempotencyKey).toBe(
+      mockQuery.mock.calls[1][0].variables.input.idempotencyKey,
+    );
+    expect(mockQueue).not.toHaveBeenCalled();
+  });
+
+  it("monitors accepted jobs but ignores stale dialog completion after context changes", async () => {
+    // Arrange
+    let resolve!: (value: unknown) => void;
+
+    mockQuery.mockReturnValue(
+      new Promise(value => {
+        resolve = value;
+      }),
+    );
+
+    const { result, rerender } = renderHook(
+      ({ context }) => useScopedExport("products", operation, "productsExport", context),
+      { initialProps: { context: "old" } },
+    );
+    let pending!: Promise<boolean>;
+
+    // Act
+    act(() => {
+      pending = result.current.submit({ search: "old" }, true);
+    });
+    rerender({ context: "new" });
+    expect(result.current.status).toBe("default");
+
+    let accepted = true;
+
+    await act(async () => {
+      resolve({
+        data: {
+          productsExport: { errors: [], exportFile: { id: "job", status: JobStatusEnum.PENDING } },
+        },
+      });
+      accepted = await pending;
+    });
+    // Assert
+    expect(accepted).toBe(false);
+    expect(mockQueue).toHaveBeenCalledWith(Task.CUSTOM, expect.any(Object));
+  });
+
+  it("offers authenticated download only after confirmed completion and reports a denied fetch", async () => {
+    // Arrange
+    mockQuery.mockResolvedValueOnce({
+      data: {
+        productsExport: { errors: [], exportFile: { id: "job", status: JobStatusEnum.PENDING } },
+      },
+    });
+
+    const { result } = renderHook(() => useScopedExport("products", operation, "productsExport"));
+
+    await act(async () => {
+      await result.current.submit({ search: "current" }, true);
+    });
+
+    const task = mockQueue.mock.calls[0][1] as {
+      handle: () => Promise<TaskStatus>;
+      onCompleted: (result: { status: TaskStatus }) => void;
+    };
+    const url = "https://core.example/export-download/123/?signature=x";
+
+    mockQuery.mockResolvedValueOnce({
+      data: { exportFile: { id: "job", status: JobStatusEnum.SUCCESS, url } },
+    });
+
+    // Act
+    const status = await task.handle();
+
+    task.onCompleted({ status });
+    // Assert
+    expect(mockDownload).not.toHaveBeenCalled();
+
+    const notification = mockNotify.mock.calls[mockNotify.mock.calls.length - 1][0] as {
+      actionBtn: { action: () => void };
+    };
+
+    mockDownload.mockRejectedValueOnce(new Error("403"));
+    await act(async () => {
+      notification.actionBtn.action();
+    });
+    expect(mockDownload).toHaveBeenCalledWith(url);
+    expect(mockNotify).toHaveBeenLastCalledWith(expect.objectContaining({ status: "error" }));
+  });
+
+  it("requires SUCCESS and a downloadable URL, never job acceptance alone", () => {
+    // Arrange / Act / Assert
+    expect(exportJobStatus({ status: JobStatusEnum.PENDING })).toBe(TaskStatus.PENDING);
+    expect(exportJobStatus({ status: JobStatusEnum.SUCCESS, url: null })).toBe(TaskStatus.PENDING);
+    expect(
+      exportJobStatus({ status: JobStatusEnum.SUCCESS, url: "https://files.invalid/export.csv" }),
+    ).toBe(TaskStatus.SUCCESS);
+    expect(exportJobStatus({ status: JobStatusEnum.FAILED })).toBe(TaskStatus.FAILURE);
+  });
+});
diff --git a/src/components/ConditionalFilter/useScopedExport.ts b/src/components/ConditionalFilter/useScopedExport.ts
