+import { useApolloClient } from "@apollo/client";
+import { useUserPermissions } from "@dashboard/auth/hooks/useUserPermissions";
+import { PermissionEnum } from "@dashboard/graphql";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+
+import { OrderRootTransactions } from "./OrderRootTransactions";
+
+jest.mock("@apollo/client", () => ({
+  ...jest.requireActual<typeof import("@apollo/client")>("@apollo/client"),
+  useApolloClient: jest.fn(),
+}));
+jest.mock("@dashboard/auth/hooks/useUserPermissions");
+jest.mock("../OrderTransaction", () => ({
+  __esModule: true,
+  default: ({ transaction }: { transaction: { id: string } }) => <div>{transaction.id}</div>,
+}));
+
+const connection = (hasNextPage = false) => ({
+  data: { transactions: { edges: [], pageInfo: { hasNextPage, endCursor: "cursor" } } },
+});
+const query = jest.fn();
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  (useApolloClient as jest.Mock).mockReturnValue({ query });
+  (useUserPermissions as jest.Mock).mockReturnValue([{ code: PermissionEnum.HANDLE_PAYMENTS }]);
+  query.mockResolvedValue(connection());
+});
+
+describe("order-scoped basic transaction lookup", () => {
+  it("locks order IDs while combining locators and uses bounded one-way pagination", async () => {
+    // Arrange
+    query.mockResolvedValueOnce(connection(true));
+    render(<OrderRootTransactions orderId="order" onTransactionAction={jest.fn()} />);
+    await screen.findByText("Next page");
+    // Act
+    fireEvent.click(screen.getByText("Next page"));
+    await waitFor(() => expect(query).toHaveBeenCalledTimes(2));
+    await screen.findByText("No transactions match this order and these locators.");
+    fireEvent.change(screen.getByLabelText("Transaction IDs"), { target: { value: "a, b" } });
+    fireEvent.change(screen.getByLabelText("PSP reference"), { target: { value: "psp" } });
+    fireEvent.change(screen.getByLabelText("App identifier"), { target: { value: "app" } });
+    fireEvent.click(screen.getByText("Find transactions"));
+    await waitFor(() => expect(query).toHaveBeenCalledTimes(3));
+    // Assert
+    expect(query.mock.calls[1][0].variables).toEqual({
+      first: 25,
+      after: "cursor",
+      filter: { orderIds: ["order"] },
+    });
+    expect(query.mock.calls[2][0]).toEqual(
+      expect.objectContaining({
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+        variables: {
+          first: 25,
+          after: undefined,
+          filter: {
+            orderIds: ["order"],
+            ids: ["a", "b"],
+            pspReference: "psp",
+            appIdentifier: "app",
+          },
+        },
+      }),
+    );
