+import { groupOrderHistory } from "./groupOrderHistory";
+
+describe("order history calendar grouping", () => {
+  it("uses the same timezone for cross-day/month keys and labels", () => {
+    // Arrange
+    const events = [
+      { date: "2025-03-01T00:30:00Z", id: "a" },
+      { date: "2025-03-01T08:30:00Z", id: "b" },
+    ];
+    // Act
+    const groups = groupOrderHistory(events, "en-US", "America/Los_Angeles");
+
+    // Assert
+    expect(groups.map(group => [group.key, group.label])).toEqual([
+      ["2025-03-01", "March 1, 2025"],
+      ["2025-02-28", "February 28, 2025"],
+    ]);
+  });
+
+  it("keeps repeated DST times in one local calendar day", () => {
+    // Arrange
+    const events = [{ date: "2025-11-02T05:30:00Z" }, { date: "2025-11-02T06:30:00Z" }];
+    // Act
+    const groups = groupOrderHistory(events, "en-US", "America/New_York");
+
+    // Assert
+    expect(groups).toHaveLength(1);
+    expect(groups[0].key).toBe("2025-11-02");
+    expect(groups[0].events).toHaveLength(2);
+  });
+
+  it("handles spring DST and a non-English locale consistently", () => {
+    // Arrange / Act
+    const groups = groupOrderHistory(
+      [{ date: "2025-03-09T06:59:00Z" }, { date: "2025-03-09T07:01:00Z" }],
+      "de-DE",
+      "America/New_York",
