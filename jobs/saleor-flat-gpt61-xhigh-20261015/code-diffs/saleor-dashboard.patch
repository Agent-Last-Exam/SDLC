+import { TransactionActionEnum } from "@dashboard/graphql";
+
+import {
+  compareAmounts,
+  currencyPrecision,
+  getTransactionActionState,
+  validatePaymentAmount,
+} from "./payments";
+
+describe("payment amount facts", () => {
+  it.each([
+    ["0", 10, "USD", "positive"],
+    ["-1", 10, "USD", "positive"],
+    ["10.01", 10, "USD", "exceeds"],
+    ["1.001", 10, "USD", "precision"],
+    ["1.1", 10, "JPY", "precision"],
+    ["1.001", 10, "KWD", null],
+    ["1", undefined, "USD", "unavailable"],
+    ["1e2", 100, "USD", "positive"],
+  ])("validates %s without clipping", (amount, available, currency, expected) => {
+    // Arrange / Act
+    const result = validatePaymentAmount(
+      String(amount),
+      available as number | undefined,
+      String(currency),
+    );
+
+    // Assert
+    expect(result).toBe(expected);
+  });
+
+  it("compares decimal strings without floating-point subtraction", () => {
+    // Arrange / Act / Assert
+    expect(compareAmounts("9007199254740993.01", "9007199254740993.00")).toBe(1);
+    expect(compareAmounts("1.00", "1")).toBe(0);
+    expect(currencyPrecision("JPY")).toBe(0);
+    expect(currencyPrecision("KWD")).toBe(3);
+  });
+
+  it("does not treat an empty or old event list as financial success", () => {
+    // Arrange
+    const transaction = {
+      events: [{ id: "old", type: "CHARGE_SUCCESS", pspReference: "old-request" }],
+    };
+
+    // Act / Assert
+    expect(getTransactionActionState({ events: [] }, TransactionActionEnum.CHARGE)).toBe("pending");
+    expect(getTransactionActionState(transaction, "CHARGE", ["old"])).toBe("pending");
+    expect(
+      getTransactionActionState(
+        { events: [{ id: "new", type: "CHARGE_FAILURE", pspReference: "request" }] },
+        "CHARGE",
+      ),
+    ).toBe("failed");
+  });
+});
