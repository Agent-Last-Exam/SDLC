new file mode 100644
index 0000000..af0215d
--- /dev/null
+++ b/src/channels/views/ChannelDetails/useChannelSettings.test.ts
@@ -0,0 +1,166 @@
+import { useApolloClient } from "@apollo/client";
+import { ChannelDetailsFragment, ChannelErrorCode } from "@dashboard/graphql";
+import { act, renderHook } from "@testing-library/react-hooks";
+
+import { useChannelSettings } from "./useChannelSettings";
+
+jest.mock("@apollo/client", () => ({
+  ...jest.requireActual<typeof import("@apollo/client")>("@apollo/client"),
+  useApolloClient: jest.fn(),
+}));
+
+const channel = (id = "one", settingsVersion = 2) =>
+  ({ __typename: "Channel", id, settingsVersion, name: `Channel ${id}` }) as ChannelDetailsFragment;
+const deferred = <T>() => {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>(done => {
+    resolve = done;
+  });
+
+  return { promise, resolve };
+};
+const client = {
+  query: jest.fn(),
+  mutate: jest.fn(),
+  cache: {
+    identify: jest.fn(value => `Channel:${value.id}`),
+    readFragment: jest.fn(() => null),
+    writeFragment: jest.fn(),
+  },
+};
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  (useApolloClient as jest.Mock).mockReturnValue(client);
+  client.query.mockResolvedValue({ data: { channel: channel() } });
+});
+
+describe("channel settings confirmed CAS saves", () => {
+  it("sends the complete warehouse order in one no-cache mutation", async () => {
+    // Arrange
+    const { result, waitForNextUpdate } = renderHook(() => useChannelSettings("one"));
+
+    await waitForNextUpdate();
+    client.mutate.mockResolvedValue({
+      data: { channelUpdate: { channel: channel("one", 3), errors: [] } },
+    });
+
+    const input = {
+      expectedVersion: 2,
+      addWarehouses: ["b"],
+      removeWarehouses: ["a"],
+      warehouseOrder: ["b", "c"],
+    };
+
+    // Act
+    await act(async () => {
+      expect(await result.current.update(input)).toEqual([]);
+    });
+
+    // Assert
+    expect(client.mutate).toHaveBeenCalledTimes(1);
+    expect(client.mutate).toHaveBeenCalledWith(
+      expect.objectContaining({
+        variables: { id: "one", input },
+        fetchPolicy: "no-cache",
+        errorPolicy: "none",
+      }),
+    );
+    expect(client.cache.writeFragment).toHaveBeenLastCalledWith(
+      expect.objectContaining({ data: channel("one", 3) }),
+    );
+    expect(result.current.status).toBe("success");
+  });
+
+  it.each([
+    undefined,
+    { channelUpdate: null },
+    { channelUpdate: { channel: channel("one", 3) } },
+    { channelUpdate: { channel: null, errors: [] } },
+    { channelUpdate: { channel: channel("other", 3), errors: [] } },
+    { channelUpdate: { channel: channel("one", 2), errors: [] } },
+    {
+      channelUpdate: {
+        channel: channel("one", 3),
+        errors: [{ code: ChannelErrorCode.INVALID, message: "Rejected", field: null }],
+      },
+    },
+  ])("does not commit an unconfirmed or rejected candidate %p", async data => {
+    // Arrange
+    const { result, waitForNextUpdate } = renderHook(() => useChannelSettings("one"));
+
+    await waitForNextUpdate();
+    client.cache.writeFragment.mockClear();
+    client.mutate.mockResolvedValue({ data });
+
+    // Act
+    await act(async () => {
+      expect(await result.current.update({ expectedVersion: 2 })).not.toEqual([]);
+    });
+
+    // Assert
+    expect(client.cache.writeFragment).not.toHaveBeenCalled();
+    expect(result.current.channel?.settingsVersion).toBe(2);
+    expect(result.current.status).toBe("error");
+  });
+
+  it("refreshes the baseline on conflict without retrying the mutation", async () => {
+    // Arrange
+    const { result, waitForNextUpdate } = renderHook(() => useChannelSettings("one"));
+
+    await waitForNextUpdate();
+    client.mutate.mockResolvedValue({
+      data: {
+        channelUpdate: {
+          channel: null,
+          errors: [
+            { code: ChannelErrorCode.CONFLICT, field: "expectedVersion", message: "Conflict" },
+          ],
+        },
+      },
+    });
+    client.query.mockResolvedValue({ data: { channel: channel("one", 4) } });
+
+    // Act
+    await act(async () => {
+      await result.current.update({ expectedVersion: 2 });
+    });
+
+    // Assert
+    expect(client.mutate).toHaveBeenCalledTimes(1);
+    expect(result.current.channel?.settingsVersion).toBe(4);
+    expect(result.current.errors[0].code).toBe(ChannelErrorCode.CONFLICT);
+    expect(result.current.status).toBe("error");
+  });
+
+  it("ignores a previous channel's delayed save", async () => {
+    // Arrange
+    const pending = deferred<any>();
+    const { result, rerender, waitForNextUpdate } = renderHook(({ id }) => useChannelSettings(id), {
+      initialProps: { id: "one" },
+    });
+
+    await waitForNextUpdate();
+    client.mutate.mockReturnValue(pending.promise);
+
+    let submitted: Promise<unknown>;
+
+    // Act
+    act(() => {
+      submitted = result.current.update({ expectedVersion: 2 });
+    });
+    client.query.mockResolvedValue({ data: { channel: channel("two", 8) } });
+    rerender({ id: "two" });
+    await waitForNextUpdate();
+    client.cache.writeFragment.mockClear();
+    await act(async () => {
+      pending.resolve({ data: { channelUpdate: { channel: channel("one", 3), errors: [] } } });
+      await submitted;
+    });
+
+    // Assert
+    expect(result.current.channel?.id).toBe("two");
+    expect(client.cache.writeFragment).not.toHaveBeenCalled();
+    expect(result.current.status).toBe("default");
+  });
+});
