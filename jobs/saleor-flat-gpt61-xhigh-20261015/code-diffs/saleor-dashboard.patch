+++ b/src/utils/richText/validation.ts
@@ -0,0 +1,359 @@
+import { OutputData } from "@editorjs/editorjs";
+import { z } from "zod";
+
+export const MAX_RICH_TEXT_DEPTH = 10;
+
+export type RichTextErrorCode = "INVALID_RICH_TEXT_STRUCTURE" | "UNSAFE_URL" | "RICH_TEXT_TOO_DEEP";
+
+export interface RichTextIssue {
+  code: RichTextErrorCode;
+  path: string;
+  message: string;
+}
+
+const listMetadata = z
+  .object({
+    start: z.number().int().min(1).optional(),
+    counterType: z
+      .enum(["numeric", "lower-roman", "upper-roman", "lower-alpha", "upper-alpha"])
+      .optional(),
+  })
+  .strict();
+
+const listItemSchema = (depth: number): z.ZodTypeAny =>
+  z
+    .object({
+      content: z.string(),
+      meta: z.object({ checked: z.boolean().optional() }).strict().optional(),
+      items:
+        depth === MAX_RICH_TEXT_DEPTH
+          ? z.array(z.never()).max(0).optional()
+          : z.array(listItemSchema(depth + 1)).optional(),
+    })
+    .strict();
+
+const block = <K extends string, T extends z.ZodTypeAny>(type: K, data: T) =>
+  z
+    .object({
+      id: z.string().min(1).optional(),
+      type: z.literal(type),
+      data,
+      tunes: z.object({}).strict().optional(),
+    })
+    .strict();
+
+const richTextSchema = z
+  .object({
+    time: z.number().int().min(0).optional(),
+    version: z.string().min(1).optional(),
+    blocks: z.array(
+      z.union([
+        block("paragraph", z.object({ text: z.string() }).strict()),
+        block(
+          "header",
+          z.object({ text: z.string(), level: z.number().int().min(1).max(6) }).strict(),
+        ),
+        block(
+          "quote",
+          z
+            .object({
+              text: z.string(),
+              caption: z.string().optional(),
+              alignment: z.enum(["left", "center"]).optional(),
+            })
+            .strict(),
+        ),
+        block(
+          "list",
+          z
+            .object({
+              style: z.enum(["ordered", "unordered", "checklist"]),
+              meta: listMetadata.optional(),
+              items: z.union([z.array(z.string()), z.array(listItemSchema(1))]),
+            })
+            .strict(),
+        ),
+        block(
+          "image",
+          z
+            .object({
+              file: z
+                .object({
+                  url: z.string(),
+                  width: z.number().int().min(0).optional(),
+                  height: z.number().int().min(0).optional(),
+                })
+                .strict(),
+              caption: z.string().optional(),
+              withBorder: z.boolean().optional(),
+              withBackground: z.boolean().optional(),
+              stretched: z.boolean().optional(),
+            })
+            .strict(),
+        ),
+        block(
+          "embed",
+          z
+            .object({
+              service: z.string().min(1),
+              source: z.string(),
+              embed: z.string(),
+              width: z.number().min(0).optional(),
+              height: z.number().min(0).optional(),
+              caption: z.string().optional(),
+            })
+            .strict(),
+        ),
+      ]),
+    ),
+  })
+  .strict();
+
+const formatPath = (path: Array<string | number>) =>
+  path.reduce<string>(
+    (result, part) =>
+      typeof part === "number" ? `${result}[${part}]` : `${result}${result ? "." : ""}${part}`,
+    "",
+  );
+
+export class RichTextValidationError extends Error {
+  constructor(public readonly issues: RichTextIssue[]) {
+    super(issues.map(issue => `${issue.path}: ${issue.message}`).join("; "));
+    this.name = "RichTextValidationError";
+  }
+}
+
+const unsafeUrl = (path: string): never => {
+  throw new RichTextValidationError([
+    { code: "UNSAFE_URL", path, message: "Use a safe relative URL or http, https, mailto or tel." },
+  ]);
+};
+
+/** Fixed protocols, never supplied by an App, editor option or deployment setting. */
+export const isSafeRichTextUrl = (input: string, mode: "link" | "image" | "http" = "link") => {
+  let decoded = input.trim();
+
+  for (let i = 0; i < 5; i++) {
+    const element = document.createElement("textarea");
+
+    element.innerHTML = decoded;
+
+    let next = element.value;
+
+    try {
+      next = decodeURIComponent(next);
+    } catch {
+      return false;
+    }
+
+    if (next === decoded) break;
+
+    decoded = next;
+  }
+
+  if (
+    !decoded ||
+    Array.from(decoded).some(character => {
+      const code = character.charCodeAt(0);
+
+      return (
+        /\s/u.test(character) || code <= 32 || (code >= 127 && code <= 159) || character === "\\"
+      );
+    })
+  )
+    return false;
+
+  if (decoded.startsWith("//")) return false;
+
+  const scheme = /^([a-z][a-z\d+.-]*):/i.exec(decoded)?.[1]?.toLowerCase();
+
+  if (scheme) {
+    if (scheme === "http" || scheme === "https") {
+      if (!/^https?:\/\//i.test(decoded)) return false;
+
+      try {
+        const url = new URL(decoded);
+
+        return !!url.hostname && !url.username && !url.password;
+      } catch {
+        return false;
+      }
+    }
+
+    return mode === "link" && (scheme === "mailto" || scheme === "tel");
+  }
+
+  if (mode === "http") return false;
+
+  if (mode === "image") return decoded.startsWith("/");
+
+  // A colon before any path separator may be an encoded/unsupported scheme.
+  return !decoded.split(/[/?#]/, 1)[0].includes(":");
+};
+
+const allowedTags = new Set([
+  "A",
+  "B",
+  "STRONG",
+  "I",
+  "EM",
+  "U",
+  "S",
+  "STRIKE",
+  "DEL",
+  "BR",
+  "P",
+  "UL",
+  "OL",
+  "LI",
+  "SPAN",
+  "CODE",
+]);
+const dangerousTags = new Set([
+  "SCRIPT",
+  "STYLE",
+  "IFRAME",
+  "OBJECT",
+  "EMBED",
+  "SVG",
+  "MATH",
+  "FORM",
+]);
+
+const safeHtml = (html: string, path: string): string => {
+  const template = document.createElement("template");
+
+  template.innerHTML = html;
+  for (const element of Array.from(template.content.querySelectorAll("*"))) {
+    if (dangerousTags.has(element.tagName)) unsafeUrl(path);
+
+    for (const attribute of Array.from(element.attributes)) {
+      if (/^on/i.test(attribute.name)) unsafeUrl(path);
+
+      if (["href", "src", "action", "formaction", "xlink:href"].includes(attribute.name)) {
+        if (!isSafeRichTextUrl(attribute.value)) unsafeUrl(`${path}.${attribute.name}`);
+      }
+
+      if (element.tagName !== "A" || !["href", "title", "target", "rel"].includes(attribute.name)) {
+        element.removeAttribute(attribute.name);
+      }
+    }
+
+    if (element.tagName === "A") {
+      if (element.getAttribute("target") === "_blank") {
+        element.setAttribute("rel", "noopener noreferrer");
+      } else {
+        element.removeAttribute("target");
+        element.removeAttribute("rel");
+      }
+    }
+
+    if (!allowedTags.has(element.tagName)) element.replaceWith(...Array.from(element.childNodes));
+  }
+
+  return template.innerHTML;
+};
+
+const checkListDepth = (items: unknown, depth: number, path: string, seen: Set<object>) => {
+  if (!Array.isArray(items)) return;
+
+  for (const [index, item] of items.entries()) {
+    if (!item || typeof item !== "object") continue;
+
+    if (depth > MAX_RICH_TEXT_DEPTH || seen.has(item)) {
+      throw new RichTextValidationError([
+        {
+          code: "RICH_TEXT_TOO_DEEP",
+          path: `${path}[${index}]`,
+          message: "Lists support at most 10 levels.",
+        },
+      ]);
+    }
+
+    seen.add(item);
+    checkListDepth(item.items, depth + 1, `${path}[${index}].items`, seen);
+    seen.delete(item);
+  }
+};
+
+interface NestedListItem {
+  content: string;
+  meta?: { checked?: boolean };
+  items?: Array<string | NestedListItem>;
+}
+
+const safeList = (
+  items: Array<string | NestedListItem>,
+  path: string,
+): Array<string | NestedListItem> =>
+  items.map((item, index) =>
+    typeof item === "string"
+      ? safeHtml(item, `${path}[${index}]`)
+      : {
+          ...item,
+          content: safeHtml(item.content, `${path}[${index}].content`),
+          ...(item.items ? { items: safeList(item.items, `${path}[${index}].items`) } : {}),
+        },
+  );
+
+/** Validate the entire value before returning a safe copy. Never flatten nested lists. */
+export const assertSafeRichText = (input: unknown): OutputData => {
+  if (input && typeof input === "object" && Array.isArray((input as OutputData).blocks)) {
+    (input as OutputData).blocks.forEach((entry, index) => {
+      if (entry?.type === "list") {
+        checkListDepth(entry.data?.items, 1, `blocks[${index}].data.items`, new Set());
+      }
+    });
+  }
+
+  const result = richTextSchema.safeParse(input);
+
+  if (!result.success) {
+    throw new RichTextValidationError(
+      result.error.issues.map(issue => ({
+        code: "INVALID_RICH_TEXT_STRUCTURE",
+        path: formatPath(issue.path) || "description",
+        message: "Invalid rich text structure or unsupported field.",
+      })),
+    );
+  }
+
+  return {
+    ...result.data,
+    blocks: result.data.blocks.map((entry, index) => {
+      const data: Record<string, any> = { ...entry.data };
+      const path = `blocks[${index}].data`;
+
+      if (typeof data.text === "string") data.text = safeHtml(data.text, `${path}.text`);
+
+      if (typeof data.caption === "string")
+        data.caption = safeHtml(data.caption, `${path}.caption`);
+
+      if (entry.type === "list") data.items = safeList(data.items, `${path}.items`);
+
+      if (entry.type === "image") {
+        if (!isSafeRichTextUrl(data.file.url, "image")) unsafeUrl(`${path}.file.url`);
+      }
+
+      if (entry.type === "embed") {
+        for (const field of ["source", "embed"]) {
+          if (!isSafeRichTextUrl(data[field], "http")) unsafeUrl(`${path}.${field}`);
+        }
+      }
+
+      return { ...entry, type: entry.type!, data };
+    }),
+  };
+};
+
+export const validateRichText = (input: unknown) => {
+  try {
+    return { success: true as const, value: assertSafeRichText(input) };
+  } catch (error) {
+    if (error instanceof RichTextValidationError) {
+      return { success: false as const, issues: error.issues };
+    }
+
+    throw error;
+  }
+};
