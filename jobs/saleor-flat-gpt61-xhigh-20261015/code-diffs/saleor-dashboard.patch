--- /dev/null
+++ b/src/components/ConditionalFilter/downloadExport.ts
@@ -0,0 +1,53 @@
+import { getApiUrl } from "@dashboard/config";
+import { createFetch } from "@saleor/sdk";
+
+/** A signed URL is not authorization: only send the current SDK token to Core. */
+export const exportDownloadUrl = (value: string): URL => {
+  const core = new URL(getApiUrl(), window.location.href);
+  const url = new URL(value, core);
+
+  if (
+    !["http:", "https:"].includes(url.protocol) ||
+    url.origin !== core.origin ||
+    url.username ||
+    url.password ||
+    url.hash ||
+    !/^\/export-download\/[A-Za-z0-9_-]+\/$/.test(url.pathname)
+  ) {
+    throw new Error("Invalid Core export download URL");
+  }
+
+  return url;
+};
+
+export const downloadExport = async (value: string): Promise<void> => {
+  const url = exportDownloadUrl(value);
+  // The SDK attaches the current authorization-bearer token and refreshes it if
+  // needed. Its GraphQL error-body retry cannot parse binary download responses.
+  const response = await createFetch({ refreshOnUnauthorized: false })(url.href, {
+    method: "GET",
+    credentials: "include",
+    cache: "no-store",
+    redirect: "error",
+  });
+
+  if (!response.ok || response.redirected) {
+    throw new Error("Export download was not authorized or could not be retrieved");
+  }
+
+  const blob = await response.blob();
+  const objectUrl = URL.createObjectURL(blob);
+  const anchor = document.createElement("a");
+
+  anchor.href = objectUrl;
+  anchor.download = blob.type.includes("spreadsheet") ? "saleor-export.xlsx" : "saleor-export.csv";
+  document.body.appendChild(anchor);
+
+  try {
+    anchor.click();
+  } finally {
+    anchor.remove();
+    // Let the browser start reading the object URL before releasing the blob.
+    window.setTimeout(() => URL.revokeObjectURL(objectUrl), 0);
+  }
+};
