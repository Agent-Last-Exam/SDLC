index 0000000..cea3870
--- /dev/null
+++ b/src/components/ConditionalFilter/effectiveScope.ts
@@ -0,0 +1,145 @@
+import { useEffect, useRef } from "react";
+
+/** Canonical, immutable query scope. Pagination and selected rows are deliberately not scope. */
+export const scopeFingerprint = (value: unknown): string => {
+  const canonicalize = (item: unknown): unknown => {
+    if (Array.isArray(item)) {
+      return item.map(canonicalize);
+    }
+
+    if (item !== null && typeof item === "object") {
+      return Object.fromEntries(
+        Object.entries(item)
+          .filter(([, entry]) => entry !== undefined)
+          .sort(([left], [right]) => left.localeCompare(right))
+          .map(([key, entry]) => [key, canonicalize(entry)]),
+      );
+    }
+
+    return item;
+  };
+
+  return JSON.stringify(canonicalize(value));
+};
+
+export const uniqueById = <T extends { id: string }>(items: readonly T[] = []): T[] =>
+  Array.from(new Map(items.map(item => [item.id, item])).values());
+
+export const uniqueIds = (ids: readonly string[] = []): string[] => Array.from(new Set(ids));
+
+export const hasScopeConstraints = (value: unknown): boolean => {
+  if (Array.isArray(value)) {
+    // An explicitly empty ID intersection is a constraint, not an unrestricted scope.
+    return true;
+  }
+
+  if (value !== null && typeof value === "object") {
+    return Object.values(value).some(hasScopeConstraints);
+  }
+
+  return value !== undefined && value !== null && value !== "";
+};
+
+export const andWhere = <T extends object>(locked: T, ordinary: Partial<T>): T => {
+  const parts = [locked, ordinary].filter(hasScopeConstraints);
+
+  if (parts.length === 2) {
+    return { AND: parts } as T;
+  }
+
+  return (parts[0] ?? {}) as T;
+};
+
+/** Legacy FILTER has no AND. Only representable intersections may be sent to Core. */
+export const intersectLegacyFilters = <T extends object>(locked: T, ordinary: Partial<T>) => {
+  let conflict = false;
+  const comparable = (value: unknown): value is string | number =>
+    typeof value === "string" || typeof value === "number";
+  const intersect = (left: unknown, right: unknown, field = ""): unknown => {
+    if (right === undefined || right === null) return left;
+
+    if (left === undefined || left === null) return right;
+
+    if (scopeFingerprint(left) === scopeFingerprint(right)) return left;
+
+    if (Array.isArray(left) && Array.isArray(right)) {
+      // Metadata entries are conjunctive. Unlike an ID/status OR-list, intersecting
+      // them would silently drop a locked predicate.
+      if (field === "metadata") {
+        return Array.from(
+          new Map([...left, ...right].map(value => [scopeFingerprint(value), value])).values(),
+        );
+      }
+
+      const values = left.filter(value =>
+        right.some(other => scopeFingerprint(value) === scopeFingerprint(other)),
+      );
+
+      if (!values.length) conflict = true;
+
+      return values;
+    }
+
+    if (typeof left === "object" && typeof right === "object") {
+      const result = { ...(right as object), ...(left as object) } as Record<string, unknown>;
+
+      for (const key of Object.keys(result)) {
+        const l = (left as Record<string, unknown>)[key];
+        const r = (right as Record<string, unknown>)[key];
+
+        if (["gte", "min"].includes(key) && comparable(l) && comparable(r)) {
+          result[key] = l > r ? l : r;
+        } else if (["lte", "max"].includes(key) && comparable(l) && comparable(r)) {
+          result[key] = l < r ? l : r;
+        } else {
+          result[key] = intersect(l, r, key);
+        }
+      }
+
+      if (
+        (comparable(result.gte) && comparable(result.lte) && result.gte > result.lte) ||
+        (comparable(result.min) && comparable(result.max) && result.min > result.max)
+      )
+        conflict = true;
+
+      return result;
+    }
+
+    // Never replace a trusted scalar lock with a user/URL value.
+    conflict = true;
+
+    return left;
+  };
+
+  return { filter: intersect(locked, ordinary) as T, conflict };
+};
+
+/** Hide old IDs during the very render that changes scope, before effects clear the grid. */
+export const useScopedSelection = (fingerprint: string, ids: string[], clear: () => void) => {
+  const previous = useRef(fingerprint);
+  // Intentional render-time comparison: old IDs must disappear before the clearing effect runs.
+  // eslint-disable-next-line react-hooks/refs
+  const changed = previous.current !== fingerprint;
+
+  useEffect(() => {
+    if (previous.current !== fingerprint) {
+      previous.current = fingerprint;
+      clear();
+    }
+  }, [fingerprint, clear]);
+
+  return changed ? [] : uniqueIds(ids);
+};
+
+export const isCurrentListResult = (
+  result: { loading: boolean; error?: unknown; data?: unknown; variables?: object },
+  expected: object,
+): boolean =>
+  !result.loading &&
+  !result.error &&
+  !!result.data &&
+  Object.entries(expected).every(
+    ([key, value]) =>
+      scopeFingerprint((result.variables as Record<string, unknown> | undefined)?.[key]) ===
+      scopeFingerprint(value),
+  );
