+import { act, renderHook } from "@testing-library/react-hooks";
+
+import { AppActionsHandler } from "./appActionsHandler";
+import { useAppActions } from "./useAppActions";
+
+jest.mock("./appActionsHandler", () => {
+  const handle = jest.fn(action => ({
+    type: "response",
+    payload: { actionId: action.payload.actionId, ok: true },
+  }));
+
+  return {
+    AppActionsHandler: {
+      useHandleNotificationAction: () => ({ handle }),
+      useHandleUpdateRoutingAction: () => ({ handle }),
+      useHandleRedirectAction: () => ({ handle }),
+      useNotifyReadyAction: () => ({ handle }),
+      useHandlePermissionRequest: () => ({ handle }),
+      createResponseStatus: (actionId: string, ok: boolean) => ({
+        type: "response",
+        payload: { actionId, ok },
+      }),
+    },
+  };
+});
+
+describe("AppFrame action boundary", () => {
+  it("checks source and load, deduplicates legacy actions and rejects unknown actions without a throw", () => {
+    // Arrange
+    const frame = document.createElement("iframe");
+
+    document.body.append(frame);
+
+    const post = jest
+      .spyOn(frame.contentWindow!, "postMessage")
+      .mockImplementation(() => undefined);
+    const origin = "https://app.example";
+    const { result, unmount } = renderHook(() =>
+      useAppActions(frame, origin, "app", "token", { core: "1", dashboard: "1" }),
+    );
+    const notification = { type: "notification", payload: { actionId: "n", text: "Draft" } };
+    const dispatch = (data: unknown, source: MessageEventSource | null = frame.contentWindow) =>
+      act(() => {
+        window.dispatchEvent(new MessageEvent("message", { origin, source, data }));
+      });
+
+    // Act
+    dispatch(notification);
+    act(() => {
+      result.current.handleLoad();
+      result.current.setHandshakeDone(true);
+    });
+    dispatch(notification, window);
+    dispatch(notification);
+    dispatch(notification);
+    dispatch({ type: "unknown", payload: { actionId: "unknown" } });
+    // Assert
+    expect(AppActionsHandler.useHandleNotificationAction().handle).toHaveBeenCalledTimes(1);
+    expect(post).toHaveBeenLastCalledWith(
+      { type: "response", payload: { actionId: "unknown", ok: false } },
+      origin,
+    );
+    unmount();
+    frame.remove();
+  });
+});
