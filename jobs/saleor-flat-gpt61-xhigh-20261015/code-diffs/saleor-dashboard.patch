@@ -0,0 +1,74 @@
+/* eslint-disable react-hooks/refs -- Keep draft revisions synchronous with edits/context switches so pending saves cannot clear a newer draft. */
+import { SubmitPromise } from "@dashboard/hooks/useForm";
+import { useCallback, useEffect, useRef, useState } from "react";
+
+import { TranslationSubmitError, useTranslationFieldSubmit } from "./useTranslationFieldSubmit";
+
+export interface TranslationDraft<T> {
+  revision: number;
+  value: T;
+}
+
+export function useTranslationStringDraft({
+  initial,
+  contextKey,
+  draft,
+  onChange,
+  onSubmit,
+  onSaved,
+}: {
+  initial: string | null;
+  contextKey: string;
+  draft?: TranslationDraft<string | null>;
+  onChange?: () => void;
+  onSubmit: (value: string | null) => SubmitPromise<TranslationSubmitError[]>;
+  onSaved?: () => void;
+}) {
+  const [, render] = useState(0);
+  const current = useRef({ contextKey, value: initial, dirty: false, revision: 0, applied: -1 });
+
+  if (current.current.contextKey !== contextKey) {
+    current.current = { contextKey, value: initial, dirty: false, revision: 0, applied: -1 };
+  }
+
+  const submit = useTranslationFieldSubmit({
+    contextKey,
+    getValue: async () => ({ value: current.current.value, revision: current.current.revision }),
+    markSaved: snapshot => {
+      if (snapshot.revision !== current.current.revision) return false;
+
+      current.current.dirty = false;
+
+      return true;
+    },
+    onSubmit: snapshot => onSubmit(snapshot.value),
+    onSaved,
+  });
+  const setIsDirty = submit.setIsDirty;
+  const change = useCallback(
+    (value: string | null) => {
+      current.current.value = value;
+      current.current.dirty = true;
+      current.current.revision++;
+      setIsDirty(true);
+      onChange?.();
+      render(revision => revision + 1);
+    },
+    [onChange, setIsDirty],
+  );
+
+  useEffect(() => {
+    if (!current.current.dirty) {
+      current.current.value = initial;
+      render(revision => revision + 1);
+    }
+  }, [initial, contextKey]);
+  useEffect(() => {
+    if (draft && draft.revision !== current.current.applied) {
+      current.current.applied = draft.revision;
+      change(draft.value);
+    }
+  }, [draft, contextKey, change]);
+
+  return { ...submit, value: current.current.value, change };
+}
