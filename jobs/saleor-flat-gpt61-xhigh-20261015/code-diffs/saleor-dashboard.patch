+import { useExitFormDialog } from "@dashboard/components/Form/useExitFormDialog";
+import { act, renderHook } from "@testing-library/react-hooks";
+
+import { TranslationSubmitError } from "./useTranslationFieldSubmit";
+import { useTranslationStringDraft } from "./useTranslationStringDraft";
+
+jest.mock("@dashboard/components/Form/useExitFormDialog", () => ({ useExitFormDialog: jest.fn() }));
+jest.mock("react-intl", () => ({
+  useIntl: () => ({
+    formatMessage: ({ defaultMessage }: { defaultMessage: string }) => defaultMessage,
+  }),
+}));
+
+const deferred = () => {
+  let resolve!: (errors: TranslationSubmitError[]) => void;
+  const promise = new Promise<TranslationSubmitError[]>(res => {
+    resolve = res;
+  });
+
+  return { promise, resolve };
+};
+
+describe("useTranslationStringDraft", () => {
+  const setIsDirty = jest.fn();
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+    (useExitFormDialog as jest.Mock).mockReturnValue({
+      setIsDirty,
+      setExitDialogSubmitRef: jest.fn(),
+    });
+  });
+
+  it("retains edits when delayed saved data arrives", () => {
+    // Arrange
+    const onSubmit = jest.fn();
+    const { result, rerender } = renderHook(
+      ({ initial }) =>
+        useTranslationStringDraft({ initial, contextKey: "product:PL:name", onSubmit }),
+      { initialProps: { initial: "Saved" } },
+    );
+
+    // Act
+    act(() => result.current.change("Draft"));
+    rerender({ initial: "Delayed saved" });
+
+    // Assert
+    expect(result.current.value).toBe("Draft");
+    expect(setIsDirty).toHaveBeenCalledWith(true);
+  });
+
+  it.each(["name", "seoDescription"])(
+    'keeps concurrent edits dirty and does not navigate for "%s"',
+    async field => {
+      // Arrange
+      const pending = deferred();
+      const onSubmit = jest.fn(() => pending.promise);
+      const onSaved = jest.fn();
+      const { result } = renderHook(() =>
+        useTranslationStringDraft({
+          initial: "Saved",
+          contextKey: `product:PL:${field}`,
+          onSubmit,
+          onSaved,
+        }),
+      );
+
+      act(() => result.current.change("Submitted"));
+
+      let request!: Promise<unknown>;
+
+      act(() => {
+        request = result.current.handleSubmit();
+      });
+      await act(async () => {
+        await Promise.resolve();
+      });
+
+      // Act
+      act(() => result.current.change("Edited while saving"));
+      setIsDirty.mockClear();
+      await act(async () => {
+        pending.resolve([]);
+        await request;
+      });
+
+      // Assert
+      expect(onSubmit).toHaveBeenCalledWith("Submitted");
+      expect(result.current.value).toBe("Edited while saving");
+      expect(setIsDirty).not.toHaveBeenCalledWith(false);
+      expect(onSaved).not.toHaveBeenCalled();
+    },
+  );
+
+  it("keeps failed draft and renders field errors", async () => {
+    // Arrange
+    const errors = [{ field: "name", code: "INVALID", message: "Fix name" }];
+    const onSaved = jest.fn();
+    const { result } = renderHook(() =>
+      useTranslationStringDraft({
+        initial: "Saved",
+        contextKey: "product:PL:name",
+        onSubmit: jest.fn().mockResolvedValue(errors),
+        onSaved,
+      }),
+    );
+
+    act(() => result.current.change("Draft"));
+    setIsDirty.mockClear();
+
+    // Act
+    await act(async () => {
+      await result.current.handleSubmit();
+    });
+
+    // Assert
+    expect(result.current.value).toBe("Draft");
+    expect(result.current.errors).toEqual(errors);
+    expect(setIsDirty).not.toHaveBeenCalledWith(false);
+    expect(onSaved).not.toHaveBeenCalled();
+  });
+
+  it("accepts explicit nullable App draft without automatically submitting", () => {
+    // Arrange
+    const onSubmit = jest.fn();
+    const onChange = jest.fn();
+    const { result } = renderHook(() =>
+      useTranslationStringDraft({
+        initial: "Saved",
+        contextKey: "product:PL:name",
+        draft: { revision: 1, value: null },
+        onSubmit,
+        onChange,
+      }),
+    );
+
+    // Act
+    const value = result.current.value;
+
+    // Assert
+    expect(value).toBeNull();
+    expect(setIsDirty).toHaveBeenCalledWith(true);
+    expect(onChange).toHaveBeenCalled();
+    expect(onSubmit).not.toHaveBeenCalled();
+  });
+
+  it("only closes after an unchanged submitted draft succeeds", async () => {
+    // Arrange
+    const onSaved = jest.fn();
+    const { result } = renderHook(() =>
+      useTranslationStringDraft({
+        initial: "Saved",
+        contextKey: "product:PL:name",
+        onSubmit: jest.fn().mockResolvedValue([]),
+        onSaved,
+      }),
+    );
+
+    act(() => result.current.change("Submitted"));
+
+    // Act
+    await act(async () => {
+      await result.current.handleSubmit();
+    });
+
+    // Assert
+    expect(setIsDirty).toHaveBeenCalledWith(false);
+    expect(onSaved).toHaveBeenCalledTimes(1);
+  });
+
+  it("rejects a late success after object or language changes", async () => {
+    // Arrange
+    const pending = deferred();
+    const onSaved = jest.fn();
+    const { result, rerender } = renderHook(
+      ({ contextKey }) =>
+        useTranslationStringDraft({
+          initial: "Saved",
+          contextKey,
+          onSubmit: () => pending.promise,
+          onSaved,
+        }),
+      { initialProps: { contextKey: "product:PL:name" } },
+    );
+
+    act(() => result.current.change("Submitted"));
+
+    let request!: Promise<unknown>;
+
+    act(() => {
+      request = result.current.handleSubmit();
+    });
+    await act(async () => {
+      await Promise.resolve();
+    });
+
+    // Act
+    rerender({ contextKey: "other:DE:name" });
+    act(() => result.current.change("New draft"));
+    setIsDirty.mockClear();
+    await act(async () => {
+      pending.resolve([]);
+      await request;
+    });
+
+    // Assert
+    expect(result.current.value).toBe("New draft");
+    expect(setIsDirty).not.toHaveBeenCalled();
+    expect(onSaved).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/translations/components/TranslationFields/useTranslationStringDraft.ts b/src/translations/components/TranslationFields/useTranslationStringDraft.ts
