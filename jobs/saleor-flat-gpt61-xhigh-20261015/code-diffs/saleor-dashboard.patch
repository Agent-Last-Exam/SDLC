@@ -0,0 +1,329 @@
+import { gql, useMutation, useQuery } from "@apollo/client";
+import { appExtensionManifest } from "@dashboard/extensions/domain/app-extension-manifest";
+import { useHasManagedAppsPermission } from "@dashboard/hooks/useHasManagedAppsPermission";
+import { Box, Button, Text } from "@saleor/macaw-ui-next";
+import { useEffect, useLayoutEffect, useRef, useState } from "react";
+import { useIntl } from "react-intl";
+
+const settingsQuery = gql`
+  query AppExtensionSettings($id: ID!) {
+    app(id: $id) {
+      id
+      settingsVersion
+      extensions {
+        id
+        label
+        url
+        mountName
+        targetName
+        settings
+        permissions {
+          code
+        }
+      }
+    }
+  }
+`;
+const settingsMutation = gql`
+  mutation UpdateAppExtensionSettings($id: ID!, $input: AppInput!) {
+    appUpdate(id: $id, input: $input) {
+      app {
+        id
+        settingsVersion
+        extensions {
+          id
+          label
+          url
+          mountName
+          targetName
+          settings
+          permissions {
+            code
+          }
+        }
+      }
+      errors {
+        field
+        code
+        message
+      }
+    }
+  }
+`;
+
+interface SettingsApp {
+  id: string;
+  settingsVersion: number;
+  extensions: Array<{
+    id: string;
+    label: string;
+    url: string;
+    mountName: string;
+    targetName: string;
+    settings: unknown;
+    permissions: Array<{ code: string }>;
+  }>;
+}
+
+const serialize = (app: SettingsApp) =>
+  JSON.stringify(
+    app.extensions.map(({ id, label, url, mountName, targetName, settings, permissions }) => ({
+      id,
+      label,
+      url,
+      mountName,
+      targetName,
+      settings,
+      permissions: permissions.map(({ code }) => code),
+    })),
+    null,
+    2,
+  );
+
+export const parseExtensionReplacement = (text: string, ownedIds: string[]) => {
+  const input: unknown = JSON.parse(text);
+
+  if (!Array.isArray(input)) throw new Error("Expected extensions array");
+
+  const used = new Set<string>();
+
+  return input.map(item => {
+    if (!item || typeof item !== "object" || Array.isArray(item))
+      throw new Error("Invalid extension");
+
+    const { id, ...fields } = item;
+
+    if (id !== undefined && (typeof id !== "string" || !ownedIds.includes(id) || used.has(id)))
+      throw new Error("Extension ID is not owned or is duplicated");
+
+    if (id) used.add(id);
+
+    return { ...(id ? { id } : {}), ...appExtensionManifest.parse(fields) };
+  });
+};
+
+export const AppExtensionSettingsCard = ({ appId }: { appId: string }) => {
+  const { formatMessage } = useIntl();
+  const { hasManagedAppsPermission } = useHasManagedAppsPermission();
+  const query = useQuery<{ app: SettingsApp | null }>(settingsQuery, {
+    variables: { id: appId },
+    skip: !hasManagedAppsPermission,
+    fetchPolicy: "network-only",
+    errorPolicy: "none",
+  });
+  const [update, mutation] = useMutation<{
+    appUpdate: { app: SettingsApp | null; errors: Array<{ code: string }> } | null;
+  }>(settingsMutation, { errorPolicy: "none" });
+  const [draft, setDraft] = useState("");
+  const [base, setBase] = useState<SettingsApp>();
+  const [message, setMessage] = useState<"invalid" | "failed" | "conflict" | "saved" | null>(null);
+  const [conflicted, setConflicted] = useState(false);
+  const mounted = useRef(false);
+  const current = useRef(appId);
+  const revision = useRef(0);
+  const locked = useRef(false);
+
+  useLayoutEffect(() => {
+    mounted.current = true;
+
+    return () => {
+      mounted.current = false;
+    };
+  }, []);
+  useLayoutEffect(() => {
+    if (current.current !== appId) {
+      current.current = appId;
+      revision.current++;
+    }
+  }, [appId]);
+
+  useEffect(() => {
+    setBase(undefined);
+    setDraft("");
+    setMessage(null);
+    setConflicted(false);
+  }, [appId]);
+  useEffect(() => {
+    if (!base && query.data?.app?.id === appId && !query.error) {
+      setBase(query.data.app);
+      setDraft(serialize(query.data.app));
+    }
+  }, [query.data, query.error, base, appId]);
+
+  if (!hasManagedAppsPermission) return null;
+
+  const save = async () => {
+    if (!base || base.id !== appId || locked.current || conflicted || !hasManagedAppsPermission)
+      return;
+
+    let extensions: ReturnType<typeof parseExtensionReplacement>;
+
+    try {
+      extensions = parseExtensionReplacement(
+        draft,
+        base.extensions.map(extension => extension.id),
+      );
+    } catch {
+      setMessage("invalid");
+
+      return;
+    }
+
+    locked.current = true;
+
+    const submittedRevision = revision.current;
+    const submittedApp = appId;
+
+    setMessage(null);
+
+    try {
+      const result = await update({
+        variables: {
+          id: submittedApp,
+          input: { extensions, expectedVersion: base.settingsVersion },
+        },
+      });
+
+      if (!mounted.current || current.current !== submittedApp) return;
+
+      const payload = result.data?.appUpdate;
+
+      if (result.errors?.length || !payload || !Array.isArray(payload.errors)) {
+        setMessage("failed");
+
+        return;
+      }
+
+      if (payload.errors.some(error => error.code === "CONFLICT")) {
+        setConflicted(true);
+        setMessage("conflict");
+
+        return;
+      }
+
+      if (
+        result.errors?.length ||
+        !payload ||
+        payload.errors.length ||
+        !payload.app ||
+        payload.app.id !== submittedApp ||
+        payload.app.settingsVersion <= base.settingsVersion
+      ) {
+        setMessage("failed");
+
+        return;
+      }
+
+      setBase(payload.app);
+
+      if (revision.current === submittedRevision) {
+        setDraft(serialize(payload.app));
+        setMessage("saved");
+      }
+    } catch {
+      if (mounted.current && current.current === submittedApp) setMessage("failed");
+    } finally {
+      locked.current = false;
+    }
+  };
+  const reload = async () => {
+    const identity = appId;
+
+    try {
+      const result = await query.refetch();
+
+      if (
+        mounted.current &&
+        current.current === identity &&
+        !result.errors?.length &&
+        result.data?.app?.id === identity
+      ) {
+        revision.current++;
+        setBase(result.data.app);
+        setDraft(serialize(result.data.app));
+        setConflicted(false);
+        setMessage(null);
+      }
+    } catch {
+      if (mounted.current && current.current === identity) setMessage("failed");
+    }
+  };
+
+  return (
+    <Box padding={6} borderTopWidth={1} borderTopStyle="solid" borderColor="default1">
+      <Text as="h2" size={5} fontWeight="bold">
+        {formatMessage({ defaultMessage: "Extension settings", id: "h0tTkg" })}
+      </Text>
+      <Text as="p">
+        {formatMessage({
+          defaultMessage:
+            "Edit the complete extension list. Keep the IDs of existing extensions. Changes use the displayed version and never overwrite a concurrent update.",
+          id: "FyMCza",
+        })}
+      </Text>
+      <Text as="p">
+        {formatMessage(
+          { defaultMessage: "Settings version: {version}", id: "ivqEgX" },
+          { version: base?.settingsVersion ?? "—" },
+        )}
+      </Text>
+      {query.error && (
+        <Text role="alert">
+          {formatMessage({
+            defaultMessage: "Extension settings could not be loaded.",
+            id: "biGeFT",
+          })}
+        </Text>
+      )}
+      <textarea
+        aria-label={formatMessage({ defaultMessage: "Extensions JSON", id: "ucb+AI" })}
+        rows={12}
+        style={{ width: "100%" }}
+        value={base?.id === appId ? draft : ""}
+        disabled={!base || query.loading || mutation.loading}
+        onChange={event => {
+          revision.current++;
+          setDraft(event.target.value);
+          setMessage(null);
+        }}
+      />
+      {message && (
+        <Text as="p" role="status">
+          {message === "conflict"
+            ? formatMessage({
+                defaultMessage:
+                  "Settings changed on the server. Your draft is kept. Reload to review the latest version before resubmitting.",
+                id: "gylyaC",
+              })
+            : message === "saved"
+              ? formatMessage({ defaultMessage: "Extension settings saved.", id: "tYAhp6" })
+              : message === "invalid"
+                ? formatMessage({
+                    defaultMessage:
+                      "Invalid extension settings. Use current fields, safe URLs and IDs owned by this app.",
+                    id: "OvyeZ3",
+                  })
+                : formatMessage({
+                    defaultMessage: "Settings were not saved. Your draft is kept.",
+                    id: "8KC8TW",
+                  })}
+        </Text>
+      )}
+      <Box display="flex" gap={3} marginTop={3}>
+        <Button
+          disabled={!base || query.loading || mutation.loading || conflicted}
+          onClick={() => void save()}
+        >
+          {formatMessage({ defaultMessage: "Save settings", id: "muqizb" })}
+        </Button>
+        <Button
+          variant="secondary"
+          disabled={query.loading || mutation.loading}
+          onClick={() => void reload()}
+        >
+          {formatMessage({ defaultMessage: "Reload settings (discard draft)", id: "dbrc0G" })}
+        </Button>
+      </Box>
+    </Box>
+  );
+};
diff --git a/src/extensions/views/ViewManifestExtension/components/AppFrame/formProtocol.test.ts b/src/extensions/views/ViewManifestExtension/components/AppFrame/formProtocol.test.ts
