+import { QueryResult } from "@apollo/client";
+import { PageInfoFragment } from "@dashboard/graphql";
+import { UseSearchHook } from "@dashboard/hooks/makeSearch";
+import { act, renderHook } from "@testing-library/react-hooks";
+
+import { scopedSearch } from "./scopedSearch";
+
+type Variables = { first: number; query: string; channel: string };
+type Data = {
+  search: {
+    edges: Array<{ node: { id: string } }>;
+    pageInfo: PageInfoFragment;
+  };
+};
+
+describe("current category/warehouse search candidates", () => {
+  it("preserves a nullable search result without reusing stale candidates", () => {
+    // Arrange
+    const variables = { first: 10, query: "", channel: "a" };
+    const base: UseSearchHook<{ search: null }, Variables> = () => ({
+      search: jest.fn(),
+      loadMore: jest.fn(),
+      query: "",
+      result: {
+        data: { search: null },
+        variables,
+        loading: false,
+      } as QueryResult<{ search: null }, Variables>,
+    });
+    const useSearch = scopedSearch(base);
+
+    // Act
+    const { result } = renderHook(() => useSearch({ variables }));
+
+    // Assert
+    expect(result.current.result.data?.search).toBeNull();
+    expect(result.current.result.loading).toBe(false);
+  });
+
+  it("deduplicates IDs and rejects previous query, assignment context and failed data", () => {
+    // Arrange
+    const search = jest.fn();
+    const loadMore = jest.fn();
+    let variables = { first: 10, query: "", channel: "a" };
+    let error: unknown;
+    const data: Data = {
+      search: {
+        edges: [{ node: { id: "one" } }, { node: { id: "one" } }, { node: { id: "two" } }],
+        pageInfo: {
+          __typename: "PageInfo",
+          hasNextPage: true,
+          hasPreviousPage: false,
+          startCursor: null,
+          endCursor: "cursor",
+        },
+      },
+    };
+    const base: UseSearchHook<Data, Variables> = () => ({
+      search,
+      loadMore,
+      query: variables.query,
+      result: { data, variables, loading: false, error } as QueryResult<Data, Variables>,
+    });
+    const useSearch = scopedSearch(base);
+    const { result, rerender } = renderHook(
+      ({ channel }) => useSearch({ variables: { first: 10, query: "", channel } }),
+      { initialProps: { channel: "a" } },
+    );
+
+    expect(result.current.result.data?.search.edges).toHaveLength(2);
+    // Act
+    act(() => result.current.search("next"));
+    // Assert
+    expect(result.current.result.data).toBeUndefined();
+    act(() => result.current.loadMore());
+    expect(loadMore).not.toHaveBeenCalled();
+    variables = { ...variables, query: "next" };
+    rerender({ channel: "a" });
+    expect(result.current.result.data?.search.edges).toHaveLength(2);
+    rerender({ channel: "b" });
+    expect(result.current.result.data).toBeUndefined();
+    variables = { ...variables, channel: "b" };
+    error = new Error("failed");
+    rerender({ channel: "b" });
+    expect(result.current.result.data).toBeUndefined();
+  });
+});
diff --git a/src/components/ConditionalFilter/scopedSearch.ts b/src/components/ConditionalFilter/scopedSearch.ts
new file mode 100644
index 0000000..ffff1e2
--- /dev/null
+++ b/src/components/ConditionalFilter/scopedSearch.ts
@@ -0,0 +1,60 @@
+import { SearchVariables, UseSearchHook } from "@dashboard/hooks/makeSearch";
+import { SearchData } from "@dashboard/hooks/makeTopLevelSearch/makeTopLevelSearch";
+import { useState } from "react";
+
+import { isCurrentListResult, scopeFingerprint, uniqueById } from "./effectiveScope";
+import { validateSearch } from "./search";
+
+/** Hide candidates immediately when typing or changing assignment/channel context. */
+export const scopedSearch =
+  <TData extends SearchData, TVariables extends SearchVariables>(
+    useSearch: UseSearchHook<TData, TVariables>,
+  ): UseSearchHook<TData, TVariables> =>
+  opts => {
+    const [query, setQuery] = useState("");
+    const invalid = !!validateSearch(query);
+    const base = useSearch({ ...opts, skip: opts.skip || invalid });
+    const expected = { ...opts.variables, query };
+    const ready = !opts.skip && !invalid && isCurrentListResult(base.result, expected);
+    const data =
+      ready && base.result.data
+        ? ({
+            ...base.result.data,
+            search: base.result.data.search
+              ? {
+                  ...base.result.data.search,
+                  edges: uniqueById(
+                    base.result.data.search.edges.map(edge => ({
+                      id: edge.node.id as string,
+                      edge,
+                    })),
+                  ).map(item => item.edge),
+                }
+              : null,
+          } as TData)
+        : undefined;
+
+    return {
+      ...base,
+      query,
+      search: value => {
+        setQuery(value);
+        base.search(value);
+      },
+      loadMore: () => {
+        if (ready) base.loadMore();
+      },
+      result: {
+        ...base.result,
+        data,
+        loading:
+          !invalid &&
+          (base.result.loading ||
+            Object.entries(expected).some(
+              ([key, value]) =>
+                scopeFingerprint(base.result.variables?.[key as keyof TVariables]) !==
+                scopeFingerprint(value),
+            )),
+      },
+    };
+  };
