index 0000000..c933ba5
--- /dev/null
+++ b/src/products/components/ProductVariantPage/useVariantFormSubmit.ts
@@ -0,0 +1,109 @@
+import { useExitFormDialog } from "@dashboard/components/Form/useExitFormDialog";
+import { MessageContext } from "@dashboard/components/messages";
+import { FormChange, UseFormResult } from "@dashboard/hooks/useForm";
+import { getMutationErrors } from "@dashboard/misc";
+import cloneDeep from "lodash/cloneDeep";
+import { useContext, useLayoutEffect, useRef } from "react";
+
+/** Variant forms collect attributes asynchronously, outside useForm.submit. */
+export const useVariantFormSubmit = <TData extends object>(
+  form: Pick<
+    UseFormResult<TData>,
+    "data" | "formId" | "handleChange" | "triggerChange" | "cleanChanged"
+  >,
+  contextKey: string,
+) => {
+  const requests = useRef({
+    generation: 0,
+    revision: 0,
+    submission: 0,
+    mounted: false,
+    submitting: false,
+  });
+  const { setIsSubmitting, setEnableExitDialog } = useExitFormDialog({ formId: form.formId });
+  const setSubmitting = useRef(setIsSubmitting);
+  const enableExitDialog = useRef(setEnableExitDialog);
+
+  setSubmitting.current = setIsSubmitting;
+  enableExitDialog.current = setEnableExitDialog;
+
+  const messages = useContext(MessageContext);
+
+  useLayoutEffect(() => {
+    const state = requests.current;
+
+    state.generation += 1;
+    state.revision = 0;
+    state.mounted = true;
+
+    // A new object/unit must not inherit an obsolete request's submitting state.
+    if (state.submitting) {
+      state.submitting = false;
+      setSubmitting.current(false);
+      enableExitDialog.current(true);
+    }
+
+    return () => {
+      state.mounted = false;
+      state.generation += 1;
+    };
+  }, [contextKey]);
+
+  const triggerChange = () => {
+    requests.current.revision += 1;
+    form.triggerChange();
+  };
+  const change: FormChange = (event, callback) => {
+    requests.current.revision += 1;
+    form.handleChange(event, callback);
+  };
+  const submit = async <TSubmit, TError>(
+    getSubmitData: () => Promise<TSubmit>,
+    onSubmit: (data: TSubmit) => Promise<TError[]>,
+    onSuccess?: () => void,
+  ) => {
+    const state = requests.current;
+    const generation = state.generation;
+    const revision = state.revision;
+    const submission = ++state.submission;
+    const snapshot = cloneDeep(form.data);
+    const isCurrent = () =>
+      requests.current.mounted &&
+      generation === requests.current.generation &&
+      submission === requests.current.submission;
+
+    state.submitting = true;
+    setIsSubmitting(true);
+    messages?.clearErrorNotifications?.();
+
+    try {
+      const data = await getSubmitData();
+
+      if (!isCurrent() || revision !== requests.current.revision) {
+        return getMutationErrors({ data: null });
+      }
+
+      const errors = await onSubmit(data);
+
+      if (
+        isCurrent() &&
+        revision === requests.current.revision &&
+        Array.isArray(errors) &&
+        errors.length === 0
+      ) {
+        form.cleanChanged(snapshot);
+        onSuccess?.();
+      }
+
+      return errors;
+    } finally {
+      if (isCurrent()) {
+        state.submitting = false;
+        setSubmitting.current(false);
+        enableExitDialog.current(true);
+      }
+    }
+  };
+
+  return { change, triggerChange, submit };
+};
