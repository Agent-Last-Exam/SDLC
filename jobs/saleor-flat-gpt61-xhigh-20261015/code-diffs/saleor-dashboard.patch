+import { searchQuery, validateSearch } from "./search";
+
+describe("bounded Core search input", () => {
+  it("counts Unicode characters rather than UTF-16 code units", () => {
+    // Arrange / Act / Assert
+    expect(validateSearch("𠮷".repeat(256), "subject")).toBeUndefined();
+    expect(validateSearch("𠮷".repeat(257), "subject")).toBe("tooLong");
+  });
+  it("validates subject phrases without adding matching to Page/User basic search", () => {
+    // Arrange / Act / Assert
+    expect(validateSearch('blue "winter coat"', "subject")).toBeUndefined();
+    expect(validateSearch('blue "winter', "subject")).toBe("unclosedQuote");
+    expect(validateSearch('blue "winter', "basic")).toBeUndefined();
+    expect(validateSearch("bad\u0000input", "basic")).toBe("controlCharacter");
+    expect(searchQuery("   ")).toBeUndefined();
+    expect(searchQuery('  RED red "winter coat" pre  ')).toBe('RED red "winter coat" pre');
+  });
+});
