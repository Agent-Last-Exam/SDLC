@@ -0,0 +1,159 @@
+import { WeightUnitsEnum } from "@dashboard/graphql";
+
+import { getWeightInUnit, isValidWeight, isWeightUnit, serializeWeight } from "./weight";
+
+describe("weight conversion", () => {
+  it.each([
+    [WeightUnitsEnum.KG, "1"],
+    [WeightUnitsEnum.G, "1000"],
+    [WeightUnitsEnum.TONNE, "0.001"],
+  ])("displays equivalent %s weights in the shop unit", (unit, value) => {
+    // Arrange
+    const weight = { value, unit };
+
+    // Act
+    const displayed = getWeightInUnit(weight, WeightUnitsEnum.KG);
+
+    // Assert
+    expect(displayed).toBe("1");
+  });
+
+  it.each([
+    [WeightUnitsEnum.LB, "453.59237"],
+    [WeightUnitsEnum.OZ, "28.349523125"],
+  ])("uses the exact %s conversion factor", (unit, expected) => {
+    // Arrange
+    const weight = { value: "1", unit };
+
+    // Act
+    const displayed = getWeightInUnit(weight, WeightUnitsEnum.G);
+
+    // Assert
+    expect(displayed).toBe(expected);
+  });
+
+  it("converts decimal values without a binary floating-point artifact", () => {
+    // Arrange
+    const weight = { value: "0.1", unit: WeightUnitsEnum.LB };
+
+    // Act
+    const displayed = getWeightInUnit(weight, WeightUnitsEnum.G);
+
+    // Assert
+    expect(displayed).toBe("45.359237");
+  });
+
+  it("round-trips a displayed weight through the submitted shop unit", () => {
+    // Arrange
+    const weight = { value: "453.59237", unit: WeightUnitsEnum.G };
+
+    // Act
+    const displayed = getWeightInUnit(weight, WeightUnitsEnum.LB);
+    const saved = serializeWeight(displayed);
+    const reloaded =
+      saved === null
+        ? null
+        : getWeightInUnit({ value: saved, unit: WeightUnitsEnum.LB }, WeightUnitsEnum.G);
+
+    // Assert
+    expect(saved).toBe("1");
+    expect(reloaded).toBe(weight.value);
+  });
+
+  it("does not quantize away a small weight before submission", () => {
+    // Arrange
+    const weight = { value: "1", unit: WeightUnitsEnum.G };
+
+    // Act
+    const displayed = getWeightInUnit(weight, WeightUnitsEnum.TONNE);
+    const saved = serializeWeight(displayed);
+
+    // Assert
+    expect(saved).toBe("0.000001");
+  });
+
+  it("does not treat zero as a missing weight", () => {
+    // Arrange
+    const weight = { value: 0, unit: WeightUnitsEnum.KG };
+
+    // Act
+    const displayed = getWeightInUnit(weight, WeightUnitsEnum.G);
+
+    // Assert
+    expect(displayed).toBe("0");
+  });
+
+  it("does not relabel a value when the shop unit has not loaded", () => {
+    // Arrange
+    const weight = { value: "1000", unit: WeightUnitsEnum.G };
+
+    // Act
+    const displayed = getWeightInUnit(weight, undefined);
+
+    // Assert
+    expect(displayed).toBe("");
+  });
+
+  it.each([null, undefined])("keeps an unset weight blank (%s)", weight => {
+    // Arrange / Act
+    const displayed = getWeightInUnit(weight, WeightUnitsEnum.KG);
+
+    // Assert
+    expect(displayed).toBe("");
+  });
+
+  it("rejects an unsupported unit instead of using a bare value", () => {
+    // Arrange
+    const weight = { value: "1", unit: "STONE" as WeightUnitsEnum };
+
+    // Act / Assert
+    expect(() => getWeightInUnit(weight, WeightUnitsEnum.KG)).toThrow(RangeError);
+  });
+});
+
+describe("weight unit validation", () => {
+  it.each([
+    WeightUnitsEnum.G,
+    WeightUnitsEnum.KG,
+    WeightUnitsEnum.LB,
+    WeightUnitsEnum.OZ,
+    WeightUnitsEnum.TONNE,
+  ])("recognizes the target schema unit %s", unit => {
+    // Arrange / Act / Assert
+    expect(isWeightUnit(unit)).toBe(true);
+  });
+
+  it.each([undefined, null, "", "STONE", "toString", "constructor"])(
+    "rejects an unavailable or unsupported unit %s",
+    unit => {
+      // Arrange / Act / Assert
+      expect(isWeightUnit(unit)).toBe(false);
+    },
+  );
+});
+
+describe("weight serialization", () => {
+  it.each([
+    ["", null],
+    ["   ", null],
+    ["0", "0"],
+    [" 1.2500 ", "1.25"],
+    ["1e-6", "0.000001"],
+    ["0.123456789123456789", "0.123456789123456789"],
+  ])("serializes %s as a decimal scalar", (value, expected) => {
+    // Arrange / Act
+    const result = serializeWeight(value);
+
+    // Assert
+    expect(result).toBe(expected);
+  });
+
+  it.each(["-1", "NaN", "Infinity", "1 kg", "1.2.3", "0x10", "1_000"])(
+    "rejects invalid weight %s without submitting a truncated value",
+    value => {
+      // Arrange / Act / Assert
+      expect(isValidWeight(value)).toBe(false);
+      expect(() => serializeWeight(value)).toThrow();
+    },
+  );
+});
