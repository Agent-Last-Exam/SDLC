+import { OutputData } from "@editorjs/editorjs";
+import { act, render, screen } from "@testing-library/react";
+
+import RichTextEditor from "./RichTextEditor";
+
+let editorOnChange: (event: { saver: { save: () => Promise<OutputData> } }) => Promise<void>;
+
+jest.mock("./ReactEditorJS", () => ({
+  ReactEditorJS: ({
+    onChange,
+    children,
+  }: {
+    onChange: typeof editorOnChange;
+    children: React.ReactNode;
+  }) => {
+    editorOnChange = onChange;
+
+    return children;
+  },
+}));
+jest.mock("./consts", () => ({ tools: {} }));
+jest.mock("./styles", () => ({ __esModule: true, default: () => ({}) }));
+
+const setup = () => {
+  const onChangeStart = jest.fn();
+  const onChange = jest.fn();
+
+  render(
+    <RichTextEditor
+      name="description"
+      label="Description"
+      disabled={false}
+      error={false}
+      editorRef={null}
+      onChangeStart={onChangeStart}
+      onChange={onChange}
+    />,
+  );
+
+  return { onChangeStart, onChange };
+};
+
+describe("rich text input boundary", () => {
+  it("invalidates a draft synchronously before asynchronous saving and returns only safe content", async () => {
+    // Arrange
+    const { onChangeStart, onChange } = setup();
+    let resolve: (value: OutputData) => void;
+    const save = jest.fn(
+      () =>
+        new Promise<OutputData>(result => {
+          resolve = result;
+        }),
+    );
+    let pending: Promise<void>;
+
+    // Act
+    act(() => {
+      pending = editorOnChange({ saver: { save } });
+    });
+
+    // Assert
+    expect(onChangeStart).toHaveBeenCalledTimes(1);
+    expect(onChange).not.toHaveBeenCalled();
+
+    // Act
+    await act(async () => {
+      resolve({
+        blocks: [
+          {
+            type: "paragraph",
+            data: { text: '<a href="https://example.com" target="_blank">link</a>' },
+          },
+        ],
+      });
+      await pending;
+    });
+
+    // Assert
+    expect(onChangeStart).toHaveBeenCalledTimes(1);
+    expect(onChange.mock.calls[0][0].blocks[0].data.text).toContain('rel="noopener noreferrer"');
+  });
+
+  it("still invalidates the draft when EditorJS saving fails", async () => {
+    // Arrange
+    const { onChangeStart, onChange } = setup();
+
+    // Act
+    await act(async () =>
+      editorOnChange({
+        saver: {
+          save: async () => {
+            throw new Error("editor failure");
+          },
+        },
+      }),
+    );
+
+    // Assert
+    expect(onChangeStart).toHaveBeenCalledTimes(1);
+    expect(onChange).not.toHaveBeenCalled();
+    expect(
+      screen.getByText(
+        "Invalid rich text. Check the structure, links and maximum list depth of 10.",
+      ),
+    ).toBeInTheDocument();
+  });
+});
diff --git a/src/discounts/exportQueries.ts b/src/discounts/exportQueries.ts
