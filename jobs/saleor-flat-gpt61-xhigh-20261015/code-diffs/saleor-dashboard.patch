+++ b/src/products/views/ProductUpdate/handlers/useProductUpdateHandler.test.ts
@@ -0,0 +1,197 @@
+import { ProductErrorCode, ProductFragment } from "@dashboard/graphql";
+import { ProductUpdateSubmitData } from "@dashboard/products/components/ProductUpdatePage/types";
+import { waitFor } from "@testing-library/react";
+import { act, renderHook } from "@testing-library/react-hooks";
+
+import { useProductUpdateHandler } from "./useProductUpdateHandler";
+
+const mockUpdateProduct = jest.fn();
+const mockUpdateChannels = jest.fn();
+const mockNotify = jest.fn();
+
+jest.mock("@dashboard/hooks/useNotifier", () => ({
+  __esModule: true,
+  default: () => mockNotify,
+}));
+jest.mock("@dashboard/attributes/utils/handlers", () => ({
+  ...jest.requireActual<typeof import("@dashboard/attributes/utils/handlers")>(
+    "@dashboard/attributes/utils/handlers",
+  ),
+  handleUploadMultipleFiles: jest.fn().mockResolvedValue([]),
+  handleDeleteMultipleAttributeValues: jest.fn().mockResolvedValue([]),
+}));
+jest.mock("@dashboard/graphql", () => ({
+  ...jest.requireActual<typeof import("@dashboard/graphql")>("@dashboard/graphql"),
+  useUpdateMetadataMutation: () => [jest.fn()],
+  useUpdatePrivateMetadataMutation: () => [jest.fn()],
+  useProductVariantBulkUpdateMutation: () => [jest.fn()],
+  useProductVariantBulkCreateMutation: () => [jest.fn()],
+  useProductVariantBulkDeleteMutation: () => [jest.fn()],
+  useFileUploadMutation: () => [jest.fn()],
+  useAttributeValueDeleteMutation: () => [jest.fn()],
+  useProductUpdateMutation: () => [mockUpdateProduct, { called: false }],
+  useProductChannelListingUpdateMutation: () => [mockUpdateChannels, { called: false }],
+}));
+
+const product = {
+  id: "product-a",
+  attributes: [],
+  variants: [],
+  channelListings: [],
+  metadata: [],
+  privateMetadata: [],
+} as unknown as ProductFragment;
+const data = {
+  name: "Draft",
+  attributes: [],
+  attributesWithNewFileValue: [],
+  channels: { updateChannels: [], removeChannels: [] },
+  variants: { added: [], removed: [], updates: [] },
+} as unknown as ProductUpdateSubmitData;
+
+describe("product update confirmation", () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+    mockUpdateProduct.mockResolvedValue({
+      data: { productUpdate: { errors: [], product: { id: product.id } } },
+    });
+    mockUpdateChannels.mockResolvedValue({
+      data: { productChannelListingUpdate: { errors: [], product: { id: product.id } } },
+    });
+  });
+
+  it.each([
+    {},
+    { data: { productUpdate: null } },
+    { data: { productUpdate: { product: { id: product.id } } } },
+    { data: { productUpdate: { errors: [] } } },
+    { data: { productUpdate: { errors: [], product: { id: "other" } } } },
+  ])("never reports unconfirmed product responses as success %#", async response => {
+    // Arrange
+    mockUpdateProduct.mockResolvedValue(response);
+
+    const { result } = renderHook(() => useProductUpdateHandler(product));
+    let errors: unknown[] = [];
+
+    // Act
+    await act(async () => {
+      errors = await result.current[0](data);
+    });
+
+    // Assert
+    expect(errors).not.toHaveLength(0);
+    expect(result.current[1].loading).toBe(false);
+    expect(mockNotify).not.toHaveBeenCalled();
+  });
+
+  it("preserves business errors and does not show a saved notification", async () => {
+    // Arrange
+    const errors = [{ code: ProductErrorCode.INVALID, field: "name", message: "Rejected" }];
+
+    mockUpdateProduct.mockResolvedValue({ data: { productUpdate: { errors } } });
+
+    const { result } = renderHook(() => useProductUpdateHandler(product));
+    let returned: unknown[] = [];
+
+    // Act
+    await act(async () => {
+      returned = await result.current[0](data);
+    });
+
+    // Assert
+    expect(returned).toEqual(errors);
+    expect(mockNotify).not.toHaveBeenCalled();
+  });
+
+  it("clears submitting after transport rejection without cleaning the draft", async () => {
+    // Arrange
+    mockUpdateProduct.mockRejectedValue(new Error("Offline"));
+
+    const { result } = renderHook(() => useProductUpdateHandler(product));
+    let errors: unknown[] = [];
+
+    // Act
+    await act(async () => {
+      errors = await result.current[0](data);
+    });
+
+    // Assert
+    expect(errors).not.toHaveLength(0);
+    expect(result.current[1].loading).toBe(false);
+    expect(result.current[1].errors).not.toHaveLength(0);
+    expect(mockNotify).not.toHaveBeenCalled();
+  });
+
+  it("stops after an unconfirmed channel listing instead of saving the product", async () => {
+    // Arrange
+    mockUpdateChannels.mockResolvedValue({
+      data: { productChannelListingUpdate: { errors: [] } },
+    });
+
+    const { result } = renderHook(() => useProductUpdateHandler(product));
+    let errors: unknown[] = [];
+
+    // Act
+    await act(async () => {
+      errors = await result.current[0]({
+        ...data,
+        channels: { removeChannels: [], updateChannels: [{ channelId: "channel" }] },
+      });
+    });
+
+    // Assert
+    expect(errors).not.toHaveLength(0);
+    expect(mockUpdateProduct).not.toHaveBeenCalled();
+    expect(mockNotify).not.toHaveBeenCalled();
+  });
+
+  it("shows saved only after a confirmed saved product", async () => {
+    // Arrange
+    const { result } = renderHook(() => useProductUpdateHandler(product));
+    let errors: unknown[] = ["not submitted"];
+
+    // Act
+    await act(async () => {
+      errors = await result.current[0](data);
+    });
+
+    // Assert
+    expect(errors).toEqual([]);
+    expect(mockNotify).toHaveBeenCalledTimes(1);
+    expect(result.current[1].loading).toBe(false);
+  });
+
+  it("ignores a previous product's delayed completion", async () => {
+    // Arrange
+    let resolve!: (response: unknown) => void;
+
+    mockUpdateProduct.mockImplementationOnce(
+      () =>
+        new Promise(done => {
+          resolve = done;
+        }),
+    );
+
+    const { result, rerender } = renderHook(
+      ({ id }) => useProductUpdateHandler({ ...product, id }),
+      { initialProps: { id: product.id } },
+    );
+    let pending!: Promise<unknown[]>;
+    let errors: unknown[] = [];
+
+    // Act
+    act(() => {
+      pending = result.current[0](data);
+    });
+    await waitFor(() => expect(mockUpdateProduct).toHaveBeenCalledTimes(1));
+    rerender({ id: "product-b" });
+    await act(async () => {
+      resolve({ data: { productUpdate: { errors: [], product: { id: product.id } } } });
+      errors = await pending;
+    });
+
+    // Assert
+    expect(errors).not.toHaveLength(0);
+    expect(mockNotify).not.toHaveBeenCalled();
+  });
+});
