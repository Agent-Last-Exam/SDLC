+import { OrderDraftEligibilityQuery, OrderStatus } from "@dashboard/graphql";
+
+export const getDraftEligibilityError = (
+  data: OrderDraftEligibilityQuery | undefined,
+  channel: string,
+  quantities: Record<string, number>,
+  finalize: boolean,
+  now = Date.now(),
+): string | null => {
+  const order = data?.order;
+
+  if (!order || order.channel.slug !== channel) {
+    return "Current order eligibility has not loaded.";
+  }
+
+  if (order.status !== OrderStatus.DRAFT) {
+    return "This order is no longer a draft.";
+  }
+
+  if (!order.channel.isActive) {
+    return "The channel is inactive.";
+  }
+
+  if (Object.keys(quantities).length > 100) {
+    return "Check at most 100 variants at a time before adding or finalizing.";
+  }
+
+  if (finalize && !order.lines.length) {
+    return "Add at least one product before finalizing.";
+  }
+
+  if (finalize && order.errors.length) {
+    return order.errors.map(error => error.message || error.code).join(" ");
+  }
+
+  if (finalize && !order.billingAddress) {
+    return "A billing address is required.";
+  }
+
+  if (finalize && order.isShippingRequired && (!order.shippingAddress || !order.deliveryMethod)) {
+    return "Choose a shipping address and delivery method.";
+  }
+
+  const deliveryMethod = order.deliveryMethod;
+
+  if (
+    finalize &&
+    deliveryMethod?.__typename === "ShippingMethod" &&
+    !order.shippingMethods.some(method => method.id === deliveryMethod.id && method.active)
+  ) {
+    return "The selected shipping method is unavailable.";
+  }
+
+  for (const [id, quantity] of Object.entries(quantities)) {
+    const variant = data?.productVariants?.edges.find(({ node }) => node.id === id)?.node;
+    const productListing = variant?.product.channelListings?.find(
+      listing => listing.channel.slug === channel,
+    );
+    const variantListing = variant?.channelListings?.find(
+      listing => listing.channel.slug === channel,
+    );
+    const inFuture = (date?: string | null) => !!date && new Date(date).getTime() > now;
+
+    if (!variant || !productListing || !variantListing) {
+      return "A selected variant is not listed in this channel.";
+    }
+
+    if (!productListing.isPublished || inFuture(productListing.publishedAt)) {
+      return "A selected product is not currently published.";
+    }
+
+    if (!productListing.isAvailableForPurchase || inFuture(productListing.availableForPurchaseAt)) {
+      return "A selected product is not currently available for purchase.";
+    }
+
+    if (!variantListing.price || !variant.pricing?.price) {
+      return "A selected variant has no current channel price or pricing configuration.";
+    }
+
+    if (
+      variant.trackInventory &&
+      (variant.quantityAvailable === null || variant.quantityAvailable < quantity)
+    ) {
+      return "A selected variant has insufficient current inventory.";
+    }
+  }
+
+  if (finalize && !order.canFinalize) {
+    return "Core currently reports that this draft cannot be finalized. Check products, shipping and channel configuration.";
+  }
+
+  return null;
+};
