+import { ApolloLink, execute, gql, Observable } from "@apollo/client";
+import { GraphQLError } from "graphql";
+
+import {
+  getSessionPolicyFailure,
+  sessionPolicyLink,
+  subscribeSessionPolicyFailure,
+} from "./sessionPolicy";
+
+const policy = "EXTERNAL_AUTHENTICATION_REQUIRED";
+
+describe("explicit session policy failures", () => {
+  it.each(["PASSWORD_AUTHENTICATION_DISABLED", "PASSWORD_AUTHENTICATION_CUSTOMERS_ONLY", policy])(
+    "recognizes %s AccountError payloads",
+    code => {
+      // Arrange & Act
+      const result = getSessionPolicyFailure({
+        data: { tokenRefresh: { errors: [{ __typename: "AccountError", code }] } },
+      });
+
+      // Assert
+      expect(result).toBe(code);
+    },
+  );
+
+  it.each([{ code: policy }, { exception: { code: policy } }])(
+    "recognizes explicit top-level codes %p",
+    extensions => {
+      // Arrange & Act
+      const result = getSessionPolicyFailure({
+        errors: [new GraphQLError("Denied", { extensions })],
+      });
+
+      // Assert
+      expect(result).toBe(policy);
+    },
+  );
+
+  it.each([
+    {},
+    { data: { product: null } },
+    { errors: [new GraphQLError("Forbidden", { extensions: { code: "PERMISSION_DENIED" } })] },
+    { data: { productUpdate: { errors: [{ __typename: "ProductError", code: policy }] } } },
+  ])("does not invalidate sessions for unrelated failures %p", result => {
+    // Arrange & Act & Assert
+    expect(getSessionPolicyFailure(result)).toBeUndefined();
+  });
+
+  it("publishes only the safe code, leaves the response unchanged and supports unsubscribe", async () => {
+    // Arrange
+    const listener = jest.fn();
+    const unsubscribe = subscribeSessionPolicyFailure(listener);
+    const response = {
+      data: { me: null },
+      errors: [new GraphQLError("Denied", { extensions: { code: policy } })],
+    };
+    const link = ApolloLink.from([
+      sessionPolicyLink,
+      new ApolloLink(() => Observable.of(response)),
+    ]);
+    const request = {
+      query: gql`
+        query CurrentUser {
+          me {
+            id
+          }
+        }
+      `,
+    };
+
+    // Act
+    const result = await new Promise(resolve =>
+      execute(link, request).subscribe({ next: resolve }),
+    );
+
+    unsubscribe();
+    await new Promise(resolve => execute(link, request).subscribe({ next: resolve }));
+
+    // Assert
+    expect(result).toBe(response);
+    expect(listener).toHaveBeenCalledTimes(1);
+    expect(listener).toHaveBeenCalledWith(policy);
+  });
+});
diff --git a/src/graphql/sessionPolicy.ts b/src/graphql/sessionPolicy.ts
new file mode 100644
index 0000000..0ed6c8d
--- /dev/null
+++ b/src/graphql/sessionPolicy.ts
@@ -0,0 +1,74 @@
+import { ApolloLink, FetchResult } from "@apollo/client";
+
+const policyCodes = [
+  "PASSWORD_AUTHENTICATION_DISABLED",
+  "PASSWORD_AUTHENTICATION_CUSTOMERS_ONLY",
+  "EXTERNAL_AUTHENTICATION_REQUIRED",
+] as const;
+
+export type SessionPolicyCode = (typeof policyCodes)[number];
+
+const listeners = new Set<(code: SessionPolicyCode) => void>();
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+  !!value && typeof value === "object";
+const isPolicyCode = (value: unknown): value is SessionPolicyCode =>
+  typeof value === "string" && policyCodes.some(code => code === value);
+
+/** Only explicit password/session policy failures qualify, never generic permission/network errors. */
+export const getSessionPolicyFailure = (result: FetchResult): SessionPolicyCode | undefined => {
+  for (const error of result.errors ?? []) {
+    const extensions = error.extensions;
+    const exception = extensions?.exception;
+    const codes = [extensions?.code, isRecord(exception) ? exception.code : undefined];
+    const code = codes.find(isPolicyCode);
+
+    if (code) {
+      return code;
+    }
+  }
+
+  const findAccountError = (value: unknown): SessionPolicyCode | undefined => {
+    if (Array.isArray(value)) {
+      for (const item of value) {
+        const found = findAccountError(item);
+
+        if (found) return found;
+      }
+    } else if (isRecord(value)) {
+      if (value.__typename === "AccountError" && isPolicyCode(value.code)) {
+        return value.code;
+      }
+
+      for (const item of Object.values(value)) {
+        const found = findAccountError(item);
+
+        if (found) return found;
+      }
+    }
+
+    return undefined;
+  };
+
+  return findAccountError(result.data);
+};
+
+/** Contains only a safe policy code. Never publishes tokens, credentials or response data. */
+export const subscribeSessionPolicyFailure = (listener: (code: SessionPolicyCode) => void) => {
+  listeners.add(listener);
+
+  return () => {
+    listeners.delete(listener);
+  };
+};
+
+export const sessionPolicyLink = new ApolloLink((operation, forward) =>
+  forward(operation).map(result => {
+    const code = getSessionPolicyFailure(result);
+
+    if (code) {
+      listeners.forEach(listener => listener(code));
+    }
+
+    return result;
+  }),
+);
