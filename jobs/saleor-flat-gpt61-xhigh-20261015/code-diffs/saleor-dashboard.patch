+import { ConfirmButtonTransitionState } from "@dashboard/components/ConfirmButton";
+import { SubmitPromise } from "@dashboard/hooks/useForm";
+import { TextField } from "@material-ui/core";
+import { FormEvent } from "react";
+import { useIntl } from "react-intl";
+
+import TranslationFieldsSave from "./TranslationFieldsSave";
+import { TranslationDraft, useTranslationStringDraft } from "./useTranslationStringDraft";
+
+export interface TranslationStringEditorProps {
+  disabled: boolean;
+  initial: string | null;
+  contextKey: string;
+  saveButtonState: ConfirmButtonTransitionState;
+  draft?: TranslationDraft<string | null>;
+  onChange?: () => void;
+  onDiscard: () => void;
+  onSubmit: (data: string | null) => SubmitPromise;
+  onSaved?: () => void;
+}
+
+export const TranslationStringEditor = ({
+  disabled,
+  initial,
+  contextKey,
+  saveButtonState,
+  draft,
+  onChange,
+  onDiscard,
+  onSubmit,
+  onSaved,
+  multiline = false,
+}: TranslationStringEditorProps & { multiline?: boolean }) => {
+  const intl = useIntl();
+  const { value, change, handleSubmit, errors, submitting } = useTranslationStringDraft({
+    initial,
+    contextKey,
+    draft,
+    onChange,
+    onSubmit,
+    onSaved,
+  });
+  const submit = (event: FormEvent) => {
+    event.preventDefault();
+    void handleSubmit();
+  };
+
+  return (
+    <form onSubmit={submit}>
+      <TextField
+        disabled={disabled}
+        fullWidth
+        multiline={multiline}
+        label={intl.formatMessage({ id: "/vCXIP", defaultMessage: "Translation" })}
+        name="translation"
+        data-test-id="translation-field"
+        value={value ?? ""}
+        onChange={event => change(event.target.value)}
+        error={errors.length > 0}
+        helperText={errors.map(error => error.message || error.code).join("; ")}
+      />
+      <TranslationFieldsSave
+        disabled={disabled || submitting}
+        saveButtonState={saveButtonState}
+        onDiscard={onDiscard}
+        onSave={handleSubmit}
+      />
+    </form>
+  );
+};
