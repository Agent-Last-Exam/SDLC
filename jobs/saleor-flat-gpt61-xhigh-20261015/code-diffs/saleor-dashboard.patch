+import { intersectLegacyFilters } from "@dashboard/components/ConditionalFilter/effectiveScope";
+import { FilterContainer } from "@dashboard/components/ConditionalFilter/FilterElement";
+import { createGiftCardQueryVariables } from "@dashboard/components/ConditionalFilter/queryVariables";
+import { searchQuery } from "@dashboard/components/ConditionalFilter/search";
+import { GiftCardFilterInput, GiftCardSortingInput } from "@dashboard/graphql";
+
+export interface GiftCardEffectiveScope {
+  filter: GiftCardFilterInput;
+  search?: string;
+  sortBy?: GiftCardSortingInput;
+}
+
+export const giftCardEffectiveScope = (
+  ordinary: FilterContainer,
+  locked: FilterContainer,
+  query?: string,
+  sortBy?: GiftCardSortingInput,
+) => {
+  const { filter, conflict } = intersectLegacyFilters(
+    createGiftCardQueryVariables(locked),
+    createGiftCardQueryVariables(ordinary),
+  );
+
+  return { scope: { filter, search: searchQuery(query), sortBy }, conflict };
+};
