+++ b/src/utils/weight.ts
@@ -0,0 +1,66 @@
+import type { WeightUnitsEnum } from "@dashboard/graphql";
+import Decimal from "decimal.js";
+
+// Keep intermediate conversions unrounded. WeightScalar/Core is the authority for
+// the final stored precision; rounding here would erase e.g. 1 g in tonnes.
+const WeightDecimal = Decimal.clone({ precision: 40 });
+const gramsPerUnit: Record<WeightUnitsEnum, string> = {
+  G: "1",
+  KG: "1000",
+  LB: "453.59237",
+  OZ: "28.349523125",
+  TONNE: "1000000",
+};
+
+/** Validate runtime schema values before using a shop-unit label or enabling save. */
+export const isWeightUnit = (unit: unknown): unit is WeightUnitsEnum =>
+  typeof unit === "string" && Object.prototype.hasOwnProperty.call(gramsPerUnit, unit);
+
+interface WeightValue {
+  value: number | string;
+  unit: WeightUnitsEnum;
+}
+
+const parseWeight = (value: string | number) => {
+  if (!/^(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?$/i.test(String(value))) {
+    throw new RangeError("Weight must be a decimal.");
+  }
+
+  const parsed = new WeightDecimal(value);
+
+  if (!parsed.isFinite() || parsed.isNegative()) {
+    throw new RangeError("Weight must be a finite, non-negative decimal.");
+  }
+
+  return parsed;
+};
+
+/** Display API weights in the shop unit, never relabel an unconverted value. */
+export const getWeightInUnit = (
+  weight: WeightValue | null | undefined,
+  unit: WeightUnitsEnum | null | undefined,
+): string => {
+  if (!weight || !unit) {
+    return "";
+  }
+
+  if (!isWeightUnit(weight.unit) || !isWeightUnit(unit)) {
+    throw new RangeError("Unknown weight unit.");
+  }
+
+  return parseWeight(weight.value).mul(gramsPerUnit[weight.unit]).div(gramsPerUnit[unit]).toFixed();
+};
+
+/** WeightScalar accepts decimal strings; do not round-trip through a JS float. */
+export const serializeWeight = (value: string): string | null =>
+  value.trim() === "" ? null : parseWeight(value.trim()).toFixed();
+
+export const isValidWeight = (value: string): boolean => {
+  try {
+    serializeWeight(value);
+
+    return true;
+  } catch {
+    return false;
+  }
+};
