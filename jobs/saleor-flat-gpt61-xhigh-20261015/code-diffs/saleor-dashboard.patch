diff --git a/src/translations/components/TranslationsProductsPage/useProductTranslationForm.ts b/src/translations/components/TranslationsProductsPage/useProductTranslationForm.ts
new file mode 100644
index 0000000..f919cc8
--- /dev/null
+++ b/src/translations/components/TranslationsProductsPage/useProductTranslationForm.ts
@@ -0,0 +1,106 @@
+/* eslint-disable react-hooks/refs -- The bridge and draft updates share a synchronous version guard, including before React commits an edit or context switch. */
+import {
+  FormField,
+  FormResult,
+  FormValues,
+  useAppFormExtension,
+} from "@dashboard/extensions/components/AppExtensionContext/useAppFormExtension";
+import { OutputData } from "@editorjs/editorjs";
+import { useRef, useState } from "react";
+
+import { TranslationDraft } from "../TranslationFields/useTranslationStringDraft";
+
+export type ProductTranslationDrafts = Partial<
+  Record<Exclude<FormField, "slug">, TranslationDraft<string | OutputData | null>>
+>;
+
+const fields: FormField[] = ["name", "seoTitle", "seoDescription", "description"];
+
+/** Keep App results separate from server data and from validation-only previews. */
+export function useProductTranslationForm({
+  objectId,
+  languageCode,
+  activeField,
+  ready,
+}: {
+  objectId: string;
+  languageCode: string;
+  activeField: string;
+  ready: boolean;
+}) {
+  const key = JSON.stringify([objectId, languageCode]);
+  const [, render] = useState(0);
+  const current = useRef({
+    key,
+    activeField,
+    version: 0,
+    drafts: {} as ProductTranslationDrafts,
+    result: undefined as FormResult | undefined,
+  });
+
+  if (current.current.key !== key) {
+    current.current = {
+      key,
+      activeField,
+      version: current.current.version + 1,
+      drafts: {},
+      result: undefined,
+    };
+  } else if (current.current.activeField !== activeField) {
+    current.current.activeField = activeField;
+    current.current.version++;
+  }
+
+  const version = current.current.version;
+  const advance = () => {
+    current.current.version++;
+    render(revision => revision + 1);
+  };
+  const receive = (result: FormResult) => {
+    // Also guard synchronously before React commits an edit/context change.
+    if (!ready || current.current.key !== key || current.current.version !== version) return;
+
+    if (result.status === "SUCCESS") {
+      for (const [field, value] of Object.entries(result.values) as Array<
+        [keyof FormValues, string | OutputData | null]
+      >) {
+        if (field !== "slug") current.current.drafts[field] = { value, revision: version + 1 };
+      }
+    }
+
+    current.current.result = result;
+    advance();
+  };
+
+  useAppFormExtension({
+    formType: "TRANSLATION",
+    objectId,
+    languageCode,
+    contextVersion: version,
+    allowedFields: ready ? fields : [],
+    nullableFields: ready ? fields : [],
+    isCurrent: () => ready && current.current.key === key && current.current.version === version,
+    onResult: receive,
+  });
+
+  const removeDraft = (field: string) => {
+    if (field !== "slug" && fields.includes(field as FormField)) {
+      delete current.current.drafts[field as keyof ProductTranslationDrafts];
+    }
+
+    advance();
+  };
+
+  return {
+    contextKey: key,
+    drafts: current.current.drafts,
+    result: current.current.result,
+    change: advance,
+    discard: (field: string) => {
+      removeDraft(field);
+      current.current.result = undefined;
+    },
+    saved: removeDraft,
+    hasDrafts: () => Object.keys(current.current.drafts).length > 0,
+  };
+}
