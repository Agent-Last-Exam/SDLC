@@ -0,0 +1,278 @@
+import { act, renderHook } from "@testing-library/react-hooks";
+
+import { useVariantFormSubmit } from "./useVariantFormSubmit";
+
+const setIsSubmitting = jest.fn();
+const setEnableExitDialog = jest.fn();
+
+jest.mock("@dashboard/components/Form/useExitFormDialog", () => ({
+  useExitFormDialog: () => ({ setIsSubmitting, setEnableExitDialog }),
+}));
+jest.mock("@dashboard/components/Datagrid/customCells/PillCell", () => ({
+  hueToPillColorDark: jest.fn(),
+  hueToPillColorLight: jest.fn(),
+}));
+
+const makeForm = () => ({
+  data: { weight: "1", name: "Variant" },
+  formId: "variant" as any,
+  handleChange: jest.fn(),
+  triggerChange: jest.fn(),
+  cleanChanged: jest.fn(),
+});
+const deferred = <T,>() => {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>(done => {
+    resolve = done;
+  });
+
+  return { promise, resolve };
+};
+
+describe("useVariantFormSubmit", () => {
+  beforeEach(() => jest.clearAllMocks());
+
+  it("cleans the submitted snapshot only after confirmed success", async () => {
+    // Arrange
+    const form = makeForm();
+    const onSuccess = jest.fn();
+    const { result } = renderHook(() => useVariantFormSubmit(form, "variant-1:KG"));
+
+    // Act
+    await act(async () => {
+      await result.current.submit(
+        async () => form.data,
+        async () => [],
+        onSuccess,
+      );
+    });
+
+    // Assert
+    expect(form.cleanChanged).toHaveBeenCalledWith({ weight: "1", name: "Variant" });
+    expect(onSuccess).toHaveBeenCalledTimes(1);
+    expect(setIsSubmitting.mock.calls).toEqual([[true], [false]]);
+    expect(setEnableExitDialog).toHaveBeenCalledWith(true);
+  });
+
+  it("preserves later scalar edits after a successful response", async () => {
+    // Arrange
+    const form = makeForm();
+    const response = deferred<any[]>();
+    const onSuccess = jest.fn();
+    const { result } = renderHook(() => useVariantFormSubmit(form, "variant-1:KG"));
+    let pending: Promise<unknown>;
+
+    // Act
+    await act(async () => {
+      pending = result.current.submit(
+        async () => form.data,
+        () => response.promise,
+        onSuccess,
+      );
+      await Promise.resolve();
+      result.current.change({ target: { name: "weight", value: "2" } });
+      response.resolve([]);
+      await pending;
+    });
+
+    // Assert
+    expect(form.handleChange).toHaveBeenCalled();
+    expect(form.cleanChanged).not.toHaveBeenCalled();
+    expect(onSuccess).not.toHaveBeenCalled();
+  });
+
+  it("preserves later rich-text, stock and attribute edits", async () => {
+    // Arrange
+    const form = makeForm();
+    const response = deferred<any[]>();
+    const { result } = renderHook(() => useVariantFormSubmit(form, "variant-1:KG"));
+
+    // Act
+    await act(async () => {
+      const pending = result.current.submit(
+        async () => form.data,
+        () => response.promise,
+      );
+
+      await Promise.resolve();
+      result.current.triggerChange();
+      response.resolve([]);
+      await pending;
+    });
+
+    // Assert
+    expect(form.triggerChange).toHaveBeenCalled();
+    expect(form.cleanChanged).not.toHaveBeenCalled();
+  });
+
+  it("does not submit a mixed snapshot edited while EditorJS saves", async () => {
+    // Arrange
+    const form = makeForm();
+    const editor = deferred<typeof form.data>();
+    const mutation = jest.fn(async () => []);
+    const { result } = renderHook(() => useVariantFormSubmit(form, "variant-1:KG"));
+
+    // Act
+    await act(async () => {
+      const pending = result.current.submit(() => editor.promise, mutation);
+
+      result.current.triggerChange();
+      editor.resolve(form.data);
+      await pending;
+    });
+
+    // Assert
+    expect(mutation).not.toHaveBeenCalled();
+    expect(form.cleanChanged).not.toHaveBeenCalled();
+  });
+
+  it("does not clear a new variant or unit context after an old response", async () => {
+    // Arrange
+    const form = makeForm();
+    const response = deferred<any[]>();
+    const { result, rerender } = renderHook(({ context }) => useVariantFormSubmit(form, context), {
+      initialProps: { context: "variant-1:KG" },
+    });
+    let pending: Promise<unknown>;
+
+    // Act
+    await act(async () => {
+      pending = result.current.submit(
+        async () => form.data,
+        () => response.promise,
+      );
+      await Promise.resolve();
+    });
+    rerender({ context: "variant-2:G" });
+    expect(setIsSubmitting.mock.calls).toEqual([[true], [false]]);
+    expect(setEnableExitDialog).toHaveBeenCalledWith(true);
+    setIsSubmitting.mockClear();
+    await act(async () => {
+      response.resolve([]);
+      await pending;
+    });
+
+    // Assert
+    expect(form.cleanChanged).not.toHaveBeenCalled();
+    expect(setIsSubmitting).not.toHaveBeenCalled();
+  });
+
+  it.each([[{ code: "INVALID", field: "weight" }], undefined])(
+    "does not clear dirty fields on errors or missing business confirmation (%s)",
+    async errors => {
+      // Arrange
+      const form = makeForm();
+      const { result } = renderHook(() => useVariantFormSubmit(form, "variant-1:KG"));
+
+      // Act
+      await act(async () => {
+        await result.current.submit(
+          async () => form.data,
+          async () => errors as any,
+        );
+      });
+
+      // Assert
+      expect(form.cleanChanged).not.toHaveBeenCalled();
+    },
+  );
+
+  it("keeps edits and releases submitting state after a validation rejection", async () => {
+    // Arrange
+    const form = makeForm();
+    const { result } = renderHook(() => useVariantFormSubmit(form, "variant-1:KG"));
+
+    // Act / Assert
+    await act(async () => {
+      await expect(
+        result.current.submit(
+          async () => {
+            throw new Error("Unsafe rich text");
+          },
+          async () => [],
+        ),
+      ).rejects.toThrow("Unsafe rich text");
+    });
+    expect(form.cleanChanged).not.toHaveBeenCalled();
+    expect(setIsSubmitting.mock.calls).toEqual([[true], [false]]);
+    expect(setEnableExitDialog).toHaveBeenCalledWith(true);
+  });
+
+  it("does not let an old context release a new context's submission", async () => {
+    // Arrange
+    const form = makeForm();
+    const oldResponse = deferred<any[]>();
+    const newResponse = deferred<any[]>();
+    const { result, rerender } = renderHook(({ context }) => useVariantFormSubmit(form, context), {
+      initialProps: { context: "variant-1:KG" },
+    });
+    let oldPending: Promise<unknown>;
+    let newPending: Promise<unknown>;
+
+    // Act
+    await act(async () => {
+      oldPending = result.current.submit(
+        async () => form.data,
+        () => oldResponse.promise,
+      );
+      await Promise.resolve();
+    });
+    rerender({ context: "variant-2:G" });
+    await act(async () => {
+      newPending = result.current.submit(
+        async () => form.data,
+        () => newResponse.promise,
+      );
+      await Promise.resolve();
+      setIsSubmitting.mockClear();
+      setEnableExitDialog.mockClear();
+      oldResponse.resolve([]);
+      await oldPending;
+    });
+
+    // Assert
+    expect(setIsSubmitting).not.toHaveBeenCalled();
+    expect(setEnableExitDialog).not.toHaveBeenCalled();
+    expect(form.cleanChanged).not.toHaveBeenCalled();
+
+    await act(async () => {
+      newResponse.resolve([]);
+      await newPending;
+    });
+    expect(form.cleanChanged).toHaveBeenCalledTimes(1);
+    expect(setIsSubmitting).toHaveBeenCalledWith(false);
+    expect(setEnableExitDialog).toHaveBeenCalledWith(true);
+  });
+
+  it("ignores an older overlapping submission", async () => {
+    // Arrange
+    const form = makeForm();
+    const first = deferred<any[]>();
+    const second = deferred<any[]>();
+    const { result } = renderHook(() => useVariantFormSubmit(form, "variant-1:KG"));
+
+    // Act
+    await act(async () => {
+      const pendingFirst = result.current.submit(
+        async () => form.data,
+        () => first.promise,
+      );
+
+      await Promise.resolve();
+
+      const pendingSecond = result.current.submit(
+        async () => form.data,
+        () => second.promise,
+      );
+
+      await Promise.resolve();
+      second.resolve([]);
+      await pendingSecond;
+      first.resolve([]);
+      await pendingFirst;
+    });
+
+    // Assert
+    expect(form.cleanChanged).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/src/products/components/ProductVariantPage/useVariantFormSubmit.ts b/src/products/components/ProductVariantPage/useVariantFormSubmit.ts
