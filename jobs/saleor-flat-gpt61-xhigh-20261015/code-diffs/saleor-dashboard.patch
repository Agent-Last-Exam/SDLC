+describe("metadata bundle loading", () => {
+  it("keeps a public-only bundle's private field null", async () => {
+    // Arrange
+    const query = jest
+      .fn()
+      .mockResolvedValue({ data: { metadataBundle: { id: "order", version: 1, metadata: [] } } });
+
+    (useApolloClient as jest.Mock).mockReturnValue({ query });
+
+    const { result, waitForNextUpdate } = renderHook(() =>
