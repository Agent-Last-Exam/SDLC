+      automaticCompletionDelay: "10",
+      automaticCompletionCutoffDate: "2026-10-15T09:30:00+08:00",
+      warehousesToDisplay: [{ id: "b" }, { id: "c" }],
+    } as FormData;
+
+    // Act
+    const input = buildChannelUpdateInput(changed, baseline);
+
+    // Assert
+    expect(input).toEqual({
+      expectedVersion: 7,
+      stockSettings: { sourceStrategy: StockSourceStrategyEnum.CHANNEL },
+      checkoutSettings: {
+        automaticallyCompleteFullyPaidCheckouts: true,
+        automaticCompletionDelay: 10,
+        automaticCompletionCutoffDate: "2026-10-15T09:30:00+08:00",
+      },
+      addWarehouses: ["c"],
+      removeWarehouses: ["a"],
+      warehouseOrder: ["b", "c"],
+    });
+    expect(input.paymentSettings).toBeUndefined();
+  });
+
+  it("explicitly clears a saved cutoff and sends full order for a reorder-only save", () => {
+    // Arrange
+    const saved = {
+      ...baseline,
+      checkoutSettings: {
+        ...baseline.checkoutSettings,
+        automaticCompletionCutoffDate: "2026-01-01T00:00:00Z",
+      },
+    };
+
+    // Act
+    const input = buildChannelUpdateInput(
+      { ...draft, warehousesToDisplay: [...draft.warehousesToDisplay].reverse() },
+      saved,
+    );
+
+    // Assert
+    expect(input).toEqual({
+      expectedVersion: 7,
+      checkoutSettings: { automaticCompletionCutoffDate: null },
+      addWarehouses: [],
+      removeWarehouses: [],
+      warehouseOrder: ["b", "a"],
+    });
+  });
+});
diff --git a/src/channels/views/ChannelDetails/settings.ts b/src/channels/views/ChannelDetails/settings.ts
new file mode 100644
index 0000000..1cc2ef5
--- /dev/null
+++ b/src/channels/views/ChannelDetails/settings.ts
@@ -0,0 +1,118 @@
+import {
+  ChannelDetailsFragment,
+  ChannelUpdateInput,
+  StockSourceStrategyEnum,
+} from "@dashboard/graphql";
+import isEqual from "lodash/isEqual";
+
+import { FormData } from "../../components/ChannelForm";
+
+/** Send only changed settings. Relations and the complete resulting order share the same CAS. */
+export function buildChannelUpdateInput(
+  draft: FormData,
+  baseline: ChannelDetailsFragment,
+): ChannelUpdateInput {
+  const input: ChannelUpdateInput = { expectedVersion: baseline.settingsVersion };
+
+  if (draft.name !== baseline.name) {
+    input.name = draft.name;
+  }
+
+  if (draft.slug !== baseline.slug) {
+    input.slug = draft.slug;
+  }
+
+  if (draft.defaultCountry !== baseline.defaultCountry.code) {
+    input.defaultCountry = draft.defaultCountry;
+  }
+
+  const stockSettings: ChannelUpdateInput["stockSettings"] = {};
+
+  if (draft.allocationStrategy !== baseline.stockSettings.allocationStrategy) {
+    stockSettings.allocationStrategy = draft.allocationStrategy;
+  }
+
+  if (draft.sourceStrategy !== baseline.stockSettings.sourceStrategy) {
+    stockSettings.sourceStrategy = draft.sourceStrategy;
+  }
+
+  if (Object.keys(stockSettings).length) {
+    input.stockSettings = stockSettings;
+  }
+
+  const checkoutSettings: ChannelUpdateInput["checkoutSettings"] = {};
+  const delay = Number(draft.automaticCompletionDelay);
+  const cutoff = draft.automaticCompletionCutoffDate?.trim() || null;
+
+  if (
+    draft.automaticallyCompleteCheckouts !==
+    baseline.checkoutSettings.automaticallyCompleteFullyPaidCheckouts
+  ) {
+    checkoutSettings.automaticallyCompleteFullyPaidCheckouts = draft.automaticallyCompleteCheckouts;
+  }
+
+  if (delay !== baseline.checkoutSettings.automaticCompletionDelay) {
+    checkoutSettings.automaticCompletionDelay = delay;
+  }
+
+  if (cutoff !== baseline.checkoutSettings.automaticCompletionCutoffDate) {
+    checkoutSettings.automaticCompletionCutoffDate = cutoff;
+  }
+
+  if (Object.keys(checkoutSettings).length) {
+    input.checkoutSettings = checkoutSettings;
+  }
+
+  const orderSettings: ChannelUpdateInput["orderSettings"] = {};
+  const order = baseline.orderSettings;
+
+  if (draft.markAsPaidStrategy !== order.markAsPaidStrategy) {
+    orderSettings.markAsPaidStrategy = draft.markAsPaidStrategy;
+  }
+
+  if (draft.allowUnpaidOrders !== order.allowUnpaidOrders) {
+    orderSettings.allowUnpaidOrders = draft.allowUnpaidOrders;
+  }
+
+  const expiration =
+    draft.deleteExpiredOrdersAfter == null ? null : Number(draft.deleteExpiredOrdersAfter);
+
+  if (expiration !== order.deleteExpiredOrdersAfter) {
+    orderSettings.deleteExpiredOrdersAfter = expiration;
+  }
+
+  if (Object.keys(orderSettings).length) {
+    input.orderSettings = orderSettings;
+  }
+
+  if (
+    draft.defaultTransactionFlowStrategy !== baseline.paymentSettings.defaultTransactionFlowStrategy
+  ) {
+    input.paymentSettings = {
+      defaultTransactionFlowStrategy: draft.defaultTransactionFlowStrategy,
+    };
+  }
+
+  if (draft.shippingZonesIdsToAdd.length) {
+    input.addShippingZones = Array.from(new Set(draft.shippingZonesIdsToAdd));
+  }
+
+  if (draft.shippingZonesIdsToRemove.length) {
+    input.removeShippingZones = Array.from(new Set(draft.shippingZonesIdsToRemove));
+  }
+
+  const oldIds = baseline.warehouses.map(warehouse => warehouse.id);
+  const newIds = draft.warehousesToDisplay.map(warehouse => warehouse.id);
+
+  if (!isEqual(oldIds, newIds)) {
+    input.addWarehouses = newIds.filter(id => !oldIds.includes(id));
+    input.removeWarehouses = oldIds.filter(id => !newIds.includes(id));
+    input.warehouseOrder = newIds;
+  }
+
+  return input;
+}
+
+export const requiresSourceConfirmation = (draft: FormData, baseline?: ChannelDetailsFragment) =>
+  draft.sourceStrategy === StockSourceStrategyEnum.CHANNEL &&
+  baseline?.stockSettings.sourceStrategy !== StockSourceStrategyEnum.CHANNEL;
