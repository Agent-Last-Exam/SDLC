+      metadataBundle {
+        id
+        version
+        metadata {
+          key
+          value
+        }
+        privateMetadata @include(if: $includePrivate) {
+          key
+          value
+        }
+      }
+      errors {
+        field
+        code
+        message
+      }
+    }
+  }
