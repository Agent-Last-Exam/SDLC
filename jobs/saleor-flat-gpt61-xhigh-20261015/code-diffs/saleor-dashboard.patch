@@ -0,0 +1,231 @@
+import { useCurrentAppFormBinding } from "@dashboard/extensions/components/AppExtensionContext/useAppFormExtension";
+import { AppFormSession } from "@dashboard/extensions/views/ViewManifestExtension/components/AppFrame/formProtocol";
+import { act, renderHook } from "@testing-library/react-hooks";
+import { Provider } from "jotai";
+import { PropsWithChildren } from "react";
+
+import { useProductTranslationForm } from "./useProductTranslationForm";
+
+const context = { objectId: "product", languageCode: "PL", activeField: "name", ready: true };
+const wrapper = ({ children }: PropsWithChildren<Partial<typeof context>>) => (
+  <Provider>{children}</Provider>
+);
+const useForm = (options = context) => {
+  const form = useProductTranslationForm(options);
+  const binding = useCurrentAppFormBinding();
+
+  return { ...form, binding };
+};
+const openSession = (binding: NonNullable<ReturnType<typeof useCurrentAppFormBinding>>) => {
+  const frame = document.createElement("iframe");
+
+  document.body.appendChild(frame);
+
+  const session = new AppFormSession(binding, "frame", "request");
+  const message = {
+    frameId: "frame",
+    requestId: "request",
+    contextVersion: binding.contextVersion,
+  };
+  const receive = (data: object) =>
+    session.receive(
+      new MessageEvent("message", {
+        origin: "https://app.example",
+        source: frame.contentWindow,
+        data: { ...message, ...data },
+      }),
+      frame,
+      "https://app.example",
+    );
+
+  session.load();
+  receive({ type: "SALEOR_FORM_READY", action: "formReady" });
+
+  return { frame, receive };
+};
+
+describe("product translation App form", () => {
+  afterEach(() => {
+    document.body.replaceChildren();
+  });
+
+  it("registers only the four translation fields and patches omitted/null values as a draft", () => {
+    // Arrange
+    const { result } = renderHook(() => useForm(), { wrapper });
+    const description = { blocks: [{ type: "paragraph", data: { text: "App description" } }] };
+    const session = openSession(result.current.binding!);
+
+    // Act
+    act(() => {
+      session.receive({
+        type: "SALEOR_FORM_RESPONSE",
+        action: "formResult",
+        formType: "TRANSLATION",
+        status: "SUCCESS",
+        values: { name: "App name", seoTitle: null, description },
+      });
+    });
+
+    // Assert
+    expect(result.current.binding).toMatchObject({
+      formType: "TRANSLATION",
+      objectId: "product",
+      languageCode: "PL",
+      allowedFields: ["name", "seoTitle", "seoDescription", "description"],
+      nullableFields: ["name", "seoTitle", "seoDescription", "description"],
+    });
+    expect(result.current.drafts.name?.value).toBe("App name");
+    expect(result.current.drafts.seoTitle?.value).toBeNull();
+    expect(result.current.drafts.description?.value).toEqual(description);
+    expect(result.current.drafts.seoDescription).toBeUndefined();
+  });
+
+  it("keeps validation preview separate from the existing draft", () => {
+    // Arrange
+    const { result } = renderHook(() => useForm(), { wrapper });
+
+    act(() => {
+      result.current.binding!.onResult({ status: "SUCCESS", values: { name: "Current draft" } });
+    });
+
+    const errors = [{ field: "name", code: "INVALID", message: "Fix name" }];
+
+    // Act
+    act(() => {
+      result.current.binding!.onResult({
+        status: "VALIDATION_ERROR",
+        errors,
+        previewValues: { name: "Preview only", description: null },
+      });
+    });
+
+    // Assert
+    expect(result.current.drafts.name?.value).toBe("Current draft");
+    expect(result.current.drafts.description).toBeUndefined();
+    expect(result.current.result).toEqual({
+      status: "VALIDATION_ERROR",
+      errors,
+      previewValues: { name: "Preview only", description: null },
+    });
+  });
+
+  it.each(["edit", "close", "object", "language", "field"])(
+    "rejects a late frame result after %s",
+    change => {
+      // Arrange
+      const { result, rerender } = renderHook(options => useForm(options), {
+        wrapper,
+        initialProps: context,
+      });
+      const session = openSession(result.current.binding!);
+
+      // Act
+      act(() => {
+        if (change === "edit") result.current.change();
+
+        if (change === "close") result.current.discard("name");
+      });
+
+      if (change === "object") rerender({ ...context, objectId: "other" });
+
+      if (change === "language") rerender({ ...context, languageCode: "DE" });
+
+      if (change === "field") rerender({ ...context, activeField: "description" });
+
+      let ack;
+
+      act(() => {
+        ack = session.receive({
+          type: "SALEOR_FORM_RESPONSE",
+          action: "formResult",
+          formType: "TRANSLATION",
+          status: "SUCCESS",
+          values: { name: "Late" },
+        });
+      });
+
+      // Assert
+      expect(ack).toMatchObject({ status: "REJECTED", code: "STALE_CONTEXT" });
+      expect(result.current.drafts).toEqual({});
+    },
+  );
+
+  it.each(["edit", "close"])(
+    "rejects the frame ACK immediately after %s before React commits",
+    change => {
+      // Arrange
+      const { result } = renderHook(() => useForm(), { wrapper });
+      const session = openSession(result.current.binding!);
+      let ack;
+
+      // Act
+      act(() => {
+        if (change === "edit") result.current.change();
+        else result.current.discard("name");
+
+        ack = session.receive({
+          type: "SALEOR_FORM_RESPONSE",
+          action: "formResult",
+          formType: "TRANSLATION",
+          status: "SUCCESS",
+          values: { name: "Late in the same event" },
+        });
+      });
+
+      // Assert
