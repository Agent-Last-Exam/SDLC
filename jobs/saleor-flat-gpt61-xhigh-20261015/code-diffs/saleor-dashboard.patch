+import { createFetch } from "@saleor/sdk";
+
+import { downloadExport, exportDownloadUrl } from "./downloadExport";
+
+const mockFetch = jest.fn();
+
+jest.mock("@dashboard/config", () => ({ getApiUrl: () => "https://core.example/graphql/" }));
+jest.mock("@saleor/sdk", () => ({ createFetch: jest.fn(() => mockFetch) }));
+
+describe("authenticated Core export downloads", () => {
+  const createObjectURL = jest.fn(() => "blob:export");
+  const revokeObjectURL = jest.fn();
+
+  beforeEach(() => {
+    // Arrange
+    jest.useFakeTimers();
+    mockFetch.mockReset();
+    createObjectURL.mockClear();
+    revokeObjectURL.mockClear();
+    Object.defineProperty(URL, "createObjectURL", { configurable: true, value: createObjectURL });
+    Object.defineProperty(URL, "revokeObjectURL", { configurable: true, value: revokeObjectURL });
+  });
+
+  afterEach(() => {
+    jest.runOnlyPendingTimers();
+    jest.useRealTimers();
+    jest.restoreAllMocks();
+  });
+
+  it.each([
+    "https://attacker.example/export-download/1/?signature=x",
+    "//attacker.example/export-download/1/?signature=x",
+    "https://staff:secret@core.example/export-download/1/",
+    "/graphql/",
+    "/export-download/one%2Ftwo/",
+    "/export-download/1/#fragment",
+  ])("never attaches SDK authorization to an untrusted URL %s", async value => {
+    // Act / Assert
+    await expect(downloadExport(value)).rejects.toThrow("Invalid Core export download URL");
+    expect(mockFetch).not.toHaveBeenCalled();
+  });
+
+  it("uses the SDK authenticated transport only after an explicit download and saves a blob URL", async () => {
+    // Arrange
+    const blob = new Blob(["id,name"], { type: "text/csv" });
+
+    mockFetch.mockResolvedValue({ ok: true, redirected: false, blob: async () => blob });
+
+    const click = jest.spyOn(HTMLAnchorElement.prototype, "click").mockImplementation(() => {});
+
+    expect(exportDownloadUrl("/export-download/123/?signature=x").origin).toBe(
+      "https://core.example",
+    );
+    expect(mockFetch).not.toHaveBeenCalled();
+    // Act
+    await downloadExport("/export-download/123/?signature=x");
+    // Assert
+    expect(createFetch).toHaveBeenCalledWith({ refreshOnUnauthorized: false });
+    expect(mockFetch).toHaveBeenCalledWith(
+      "https://core.example/export-download/123/?signature=x",
+      {
+        method: "GET",
+        credentials: "include",
+        cache: "no-store",
+        redirect: "error",
+      },
+    );
+    expect(createObjectURL).toHaveBeenCalledWith(blob);
+    expect(click).toHaveBeenCalledTimes(1);
+    expect(document.querySelector("a")).toBeNull();
+    jest.runOnlyPendingTimers();
+    expect(revokeObjectURL).toHaveBeenCalledWith("blob:export");
+  });
+
+  it("does not download a denied, expired or redirected response", async () => {
+    // Arrange
+    mockFetch
+      .mockResolvedValueOnce({ ok: false, status: 403 })
+      .mockResolvedValueOnce({ ok: true, redirected: true });
+    // Act / Assert
+    await expect(downloadExport("/export-download/123/?signature=x")).rejects.toThrow(
+      "not authorized",
+    );
+    await expect(downloadExport("/export-download/123/?signature=x")).rejects.toThrow(
+      "not authorized",
+    );
+    expect(createObjectURL).not.toHaveBeenCalled();
+  });
+});
