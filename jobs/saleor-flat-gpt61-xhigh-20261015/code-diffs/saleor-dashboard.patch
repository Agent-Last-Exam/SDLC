+      {
+        called: true,
+        loading: false,
+        data: { request: { errors: [] } },
+        error: new ApolloError({ networkError: new Error("offline") }),
+      },
+      "error",
+    ],
+  ])("uses completed response facts instead of called alone (%s)", (opts, expected) => {
+    // Arrange / Act
+    const status = getMutationStatus(opts as MutationResult<any>);
+
+    // Assert
+    expect(status).toBe(expected);
