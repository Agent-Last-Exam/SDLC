+    // Act
+    render(<OrderRootTransactions orderId="order" onTransactionAction={jest.fn()} />);
+    // Assert
+    expect(query).not.toHaveBeenCalled();
+    expect(
+      screen.getByText("Transaction details require HANDLE_PAYMENTS permission."),
+    ).toBeInTheDocument();
+  });
+
+  it("distinguishes top-level GraphQL failure from a successful empty connection", async () => {
