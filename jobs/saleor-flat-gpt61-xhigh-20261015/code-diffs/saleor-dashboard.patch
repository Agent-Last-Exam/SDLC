+import {
+  OrderAction,
+  OrderDetailsFragment,
+  TransactionActionEnum,
+  TransactionItemFragment,
+} from "@dashboard/graphql";
+
+export const currencyPrecision = (currency: string) =>
+  new Intl.NumberFormat("en", { style: "currency", currency }).resolvedOptions()
+    .maximumFractionDigits;
+
+const decimal = (value: string | number) => {
+  const text = String(value);
+  const match = /^(\d+)(?:\.(\d+))?$/.exec(text);
+
+  return match ? { integer: match[1], fraction: (match[2] ?? "").replace(/0+$/, "") } : null;
+};
+
+export const compareAmounts = (left: string | number, right: string | number) => {
+  const a = decimal(left);
+  const b = decimal(right);
+
+  if (!a || !b) {
+    return null;
+  }
+
+  const scale = Math.max(a.fraction.length, b.fraction.length);
+  const first = BigInt(a.integer + a.fraction.padEnd(scale, "0"));
+  const second = BigInt(b.integer + b.fraction.padEnd(scale, "0"));
+
+  return first === second ? 0 : first > second ? 1 : -1;
+};
+
+export const validatePaymentAmount = (
+  amount: string,
+  available: string | number | undefined,
+  currency: string | undefined,
+) => {
+  const value = decimal(amount);
+
+  if (!value || compareAmounts(amount, "0") !== 1) {
+    return "positive" as const;
+  }
+
+  if (available === undefined || !currency) {
+    return "unavailable" as const;
+  }
+
+  const precision = currencyPrecision(currency);
+
+  if (precision === undefined) {
+    return "unavailable" as const;
+  }
+
+  if (value.fraction.length > precision) {
+    return "precision" as const;
+  }
+
+  const comparison = compareAmounts(amount, available);
+
+  if (comparison === null) {
+    return "unavailable" as const;
+  }
+
+  if (comparison === 1) {
+    return "exceeds" as const;
+  }
+
+  return null;
+};
+
+export const canMarkOrderPaid = (
+  order: OrderDetailsFragment | undefined,
+  canManageOrders: boolean,
+) =>
+  !!order &&
+  canManageOrders &&
+  order.actions.includes(OrderAction.MARK_AS_PAID) &&
+  !order.payments.length &&
+  Array.isArray(order.transactionRecordIds) &&
+  !order.transactionRecordIds.length &&
+  !!order.billingAddress;
+
+export const getAvailableCapture = (order: OrderDetailsFragment | undefined) => {
+  const payment = order?.payments.find(
+    payment => payment.isActive && payment.actions.includes(OrderAction.CAPTURE),
+  );
+
+  return payment?.availableCaptureAmount ?? undefined;
+};
+
+export const getAvailableRefund = (
+  order: { payments: OrderDetailsFragment["payments"] } | undefined,
+) =>
+  order?.payments.find(payment => payment.isActive && payment.actions.includes(OrderAction.REFUND))
+    ?.availableRefundAmount ?? undefined;
+
+export const isTransactionActionAvailable = (
+  transaction: TransactionItemFragment | undefined,
+  action: TransactionActionEnum,
+) => {
+  if (!transaction?.actions.includes(action)) {
+    return false;
+  }
+
+  if (action === TransactionActionEnum.CHARGE) {
+    return compareAmounts(transaction.availableChargeAmount.amount, "0") === 1;
+  }
+
+  if (action === TransactionActionEnum.REFUND) {
+    return compareAmounts(transaction.availableRefundAmount.amount, "0") === 1;
+  }
+
+  return true;
+};
+
+export const getTransactionActionState = (
+  transaction: { events: Array<{ type: string; id: string; pspReference: string }> } | undefined,
+  action: string,
+  previousEventIds: string[] = [],
+) => {
+  const events =
+    transaction?.events.filter(
+      event => !previousEventIds.includes(event.id) && event.type.startsWith(`${action}_`),
+    ) ?? [];
+
+  if (events.some(event => event.type === `${action}_SUCCESS`)) {
+    return "succeeded" as const;
+  }
+
+  if (events.some(event => event.type === `${action}_FAILURE`)) {
+    return "failed" as const;
+  }
+
+  return "pending" as const;
+};
