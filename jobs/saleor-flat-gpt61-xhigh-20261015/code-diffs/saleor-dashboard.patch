--- /dev/null
+++ b/src/extensions/views/ViewManifestExtension/components/AppFrame/formProtocol.test.ts
@@ -0,0 +1,208 @@
+import { AppFormBinding, AppFormSession } from "./formProtocol";
+
+const origin = "https://app.example:8443";
+const createSession = (formType: AppFormBinding["formType"] = "PRODUCT") => {
+  const frame = document.createElement("iframe");
+
+  document.body.append(frame);
+
+  let current = true;
+  const onResult = jest.fn();
+  const binding: AppFormBinding = {
+    formType,
+    objectId: "product",
+    ...(formType === "TRANSLATION" ? { languageCode: "PL" } : {}),
+    contextVersion: 2,
+    allowedFields:
+      formType === "PRODUCT" ? ["name", "slug", "description"] : ["name", "description"],
+    nullableFields: ["description"],
+    onResult,
+    isCurrent: () => current,
+  };
+  const session = new AppFormSession(binding, "frame", "request");
+  const envelope = { frameId: "frame", requestId: "request", contextVersion: 2 };
+  const ready = { ...envelope, type: "SALEOR_FORM_READY", action: "formReady" };
+  const response = {
+    ...envelope,
+    type: "SALEOR_FORM_RESPONSE",
+    action: "formResult",
+    formType,
+    status: "SUCCESS",
+    values: { name: "Draft" },
+  };
+  const receive = (data: unknown, overrides: Partial<MessageEventInit> = {}) =>
+    session.receive(
+      new MessageEvent("message", { data, origin, source: frame.contentWindow, ...overrides }),
+      frame,
+      origin,
+    );
+
+  return {
+    session,
+    frame,
+    onResult,
+    ready,
+    response,
+    receive,
+    stale: () => {
+      current = false;
+    },
+  };
+};
+
+describe("I19 form protocol", () => {
+  afterEach(() => {
+    document.body.replaceChildren();
+  });
+  it("requires load and ready before accepting only a draft result", () => {
+    // Arrange
+    const { session, receive, response, ready, onResult } = createSession();
+
+    // Act / Assert
+    expect(receive(response)).toBeUndefined();
+    session.load();
+    expect(receive(response)?.code).toBe("NOT_READY");
+    expect(onResult).not.toHaveBeenCalled();
+    receive(ready);
+    expect(receive(response)?.status).toBe("APPLIED");
+    expect(onResult).toHaveBeenCalledWith({ status: "SUCCESS", values: { name: "Draft" } });
+  });
+  it.each([
+    { origin: "https://app.example" },
+    { origin: "https://app.example:8444" },
+    { source: window },
+    { source: null },
+  ])("ignores untrusted origin/source %#", overrides => {
+    // Arrange
+    const { session, receive, response, ready, onResult } = createSession();
+
+    session.load();
+    receive(ready);
+    // Act
+    expect(receive(response, overrides)).toBeUndefined();
+    // Assert
+    expect(onResult).not.toHaveBeenCalled();
+  });
+  it.each([
+    { frameId: "other" },
+    { requestId: "other" },
+    { contextVersion: 1 },
+    { formType: "TRANSLATION" },
+    { action: "save" },
+    { type: "SALEOR_FORM_OTHER" },
+    { unexpected: true },
+  ])("ignores mismatched or structurally invalid envelopes %#", patch => {
+    // Arrange
+    const { session, receive, response, ready, onResult } = createSession();
+
+    session.load();
+    receive(ready);
+    // Act
+    expect(receive({ ...response, ...patch })).toBeUndefined();
+    // Assert
+    expect(onResult).not.toHaveBeenCalled();
+  });
+  it.each([
+    { name: "safe", price: "unauthorized" },
+    { name: "safe", slug: null },
+    { name: 123 },
+    { description: "not EditorJS" },
+    {
+      description: {
+        blocks: [{ type: "paragraph", data: { text: '<a href="javascript:bad">bad</a>' } }],
+      },
+    },
+  ])("rejects the whole patch when any field is invalid %#", values => {
+    // Arrange
+    const { session, receive, response, ready, onResult } = createSession();
+
+    session.load();
+    receive(ready);
+    // Act
+    expect(receive({ ...response, values })?.status).toBe("REJECTED");
+    // Assert
+    expect(onResult).not.toHaveBeenCalled();
+  });
+  it("returns the original ACK on exact replay without applying again after the draft version changed", () => {
+    // Arrange
+    const { session, receive, response, ready, onResult, stale } = createSession();
+
+    session.load();
+    receive(ready);
+
+    // Act
+    const first = receive(response);
+
+    stale();
+
+    const replay = receive(response);
+
+    // Assert
+    expect(replay).toBe(first);
+    expect(onResult).toHaveBeenCalledTimes(1);
+    expect(receive({ ...response, values: { name: "different" } })?.code).toBe("ALREADY_RESPONDED");
+  });
+  it("rejects a stale current context before any result is applied", () => {
+    // Arrange
+    const { session, receive, response, ready, onResult, stale } = createSession();
+
+    session.load();
+    receive(ready);
+    stale();
+    // Act / Assert
+    expect(receive(response)?.code).toBe("STALE_CONTEXT");
+    expect(onResult).not.toHaveBeenCalled();
+  });
+  it("accepts an empty SUCCESS no-op and explicitly permitted null", () => {
+    // Arrange
+    const first = createSession();
+
+    first.session.load();
+    first.receive(first.ready);
+
+    const second = createSession();
+
+    second.session.load();
+    second.receive(second.ready);
+    // Act / Assert
+    expect(first.receive({ ...first.response, values: {} })?.status).toBe("APPLIED");
+    expect(second.receive({ ...second.response, values: { description: null } })?.status).toBe(
+      "APPLIED",
+    );
+  });
+  it("returns validation errors and safe previews without converting them to successful values", () => {
+    // Arrange
+    const { session, receive, response, ready, onResult } = createSession("TRANSLATION");
+
+    session.load();
+    receive(ready);
+
+    const { values: _values, ...envelope } = response;
+    const errors = [{ field: "name", code: "INVALID", message: "Invalid" }];
+    // Act
+    const ack = receive({
+      ...envelope,
+      status: "VALIDATION_ERROR",
+      errors,
+      previewValues: { name: "Preview only" },
+    });
+
+    // Assert
+    expect(ack?.status).toBe("PREVIEWED");
+    expect(onResult).toHaveBeenCalledWith({
+      status: "VALIDATION_ERROR",
+      errors,
+      previewValues: { name: "Preview only" },
+    });
+  });
+  it.each(["PERMISSION_ERROR", "CLOSED"])("does not accept values in %s", status => {
+    // Arrange
+    const { session, receive, response, ready, onResult } = createSession();
+
+    session.load();
+    receive(ready);
+    // Act / Assert
+    expect(receive({ ...response, status })?.status).toBe("REJECTED");
+    expect(onResult).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/extensions/views/ViewManifestExtension/components/AppFrame/formProtocol.ts b/src/extensions/views/ViewManifestExtension/components/AppFrame/formProtocol.ts
new file mode 100644
index 0000000..4c9fe17
--- /dev/null
+++ b/src/extensions/views/ViewManifestExtension/components/AppFrame/formProtocol.ts
@@ -0,0 +1,300 @@
+import { assertSafeRichText, RichTextValidationError } from "@dashboard/utils/richText/validation";
+import { OutputData } from "@editorjs/editorjs";
+import { z } from "zod";
+
+export type FormType = "PRODUCT" | "TRANSLATION";
+export type FormField = "name" | "slug" | "seoTitle" | "seoDescription" | "description";
+export interface FormValues {
+  name?: string | null;
+  slug?: string;
+  seoTitle?: string | null;
+  seoDescription?: string | null;
+  description?: OutputData | null;
+}
+export interface FormFieldError {
+  field: string;
+  code: string;
+  message: string;
+}
+export type FormResult =
+  | { status: "SUCCESS"; values: FormValues }
+  | { status: "VALIDATION_ERROR"; errors: FormFieldError[]; previewValues?: FormValues }
+  | { status: "PERMISSION_ERROR" | "CLOSED" };
+
+export interface AppFormBinding {
+  formType: FormType;
+  objectId: string;
+  languageCode?: string;
+  contextVersion: number;
+  allowedFields: FormField[];
+  nullableFields: FormField[];
+  onResult: (result: FormResult) => void;
+  isCurrent: () => boolean;
+}
+
+export interface FormContext {
+  type: "SALEOR_FORM_CONTEXT";
+  action: "formContext";
+  frameId: string;
+  requestId: string;
+  contextVersion: number;
+  formType: FormType;
+  objectId: string;
+  languageCode?: string;
+  allowedFields: FormField[];
+  nullableFields: FormField[];
+}
+export interface FormAck {
+  type: "SALEOR_FORM_ACK";
+  action: "formResult";
+  frameId: string;
+  requestId: string;
+  contextVersion: number;
+  actionId?: string;
+  status: "APPLIED" | "PREVIEWED" | "CLOSED" | "REJECTED";
+  code?: string;
+}
+
+const id = z.string().min(1);
+const envelope = {
+  frameId: id,
+  requestId: id,
+  contextVersion: z.number().int().min(0),
+  actionId: id.optional(),
+};
+const readySchema = z
+  .object({ ...envelope, type: z.literal("SALEOR_FORM_READY"), action: z.literal("formReady") })
+  .strict();
+const fieldErrorSchema = z.object({ field: id, code: id, message: z.string() }).strict();
+const responseSchema = z
+  .object({
+    ...envelope,
+    type: z.literal("SALEOR_FORM_RESPONSE"),
+    action: z.literal("formResult"),
+    formType: z.enum(["PRODUCT", "TRANSLATION"]),
+    status: z.enum(["SUCCESS", "VALIDATION_ERROR", "PERMISSION_ERROR", "CLOSED"]),
+    values: z.record(z.unknown()).optional(),
+    previewValues: z.record(z.unknown()).optional(),
+    errors: z.array(fieldErrorSchema).min(1).optional(),
+  })
+  .strict();
+
+const productFields: FormField[] = ["name", "slug", "seoTitle", "seoDescription", "description"];
+const translationFields: FormField[] = ["name", "seoTitle", "seoDescription", "description"];
+
+export const isValidFormBinding = (binding: AppFormBinding) => {
+  const fields = binding.formType === "PRODUCT" ? productFields : translationFields;
+  const nullable = binding.formType === "PRODUCT" ? ["description"] : translationFields;
+
+  return (
+    id.safeParse(binding.objectId).success &&
+    Number.isInteger(binding.contextVersion) &&
+    binding.contextVersion >= 0 &&
+    (binding.formType === "PRODUCT" || !!binding.languageCode) &&
+    new Set(binding.allowedFields).size === binding.allowedFields.length &&
+    new Set(binding.nullableFields).size === binding.nullableFields.length &&
+    binding.allowedFields.every(field => fields.includes(field)) &&
+    binding.nullableFields.every(
+      field => binding.allowedFields.includes(field) && nullable.includes(field),
+    )
+  );
+};
+
+const validateValues = (
+  values: Record<string, unknown>,
+  binding: AppFormBinding,
+): FormValues | null => {
+  const output: FormValues = {};
+
+  for (const [field, value] of Object.entries(values)) {
+    if (!binding.allowedFields.includes(field as FormField)) return null;
+
+    if (!productFields.includes(field as FormField)) return null;
+
+    if (value === null) {
+      if (field === "slug" || !binding.nullableFields.includes(field as FormField)) return null;
+
+      output[field as Exclude<FormField, "slug">] = null;
+    } else if (field === "description") {
+      try {
+        output.description = assertSafeRichText(value);
+      } catch (error) {
+        if (error instanceof RichTextValidationError) return null;
+
+        throw error;
+      }
+    } else {
+      if (typeof value !== "string") return null;
+
+      if (
+        binding.formType === "PRODUCT" &&
+        ["name", "slug"].includes(field) &&
+        value.length === 0
+      ) {
+        return null;
+      }
+
+      output[field as Exclude<FormField, "description">] = value;
+    }
+  }
+
+  return output;
+};
+
+/** A session is tied to one contentWindow and one popup request, not merely the App's origin. */
+export class AppFormSession {
+  readonly context: FormContext;
+
+  private loaded = false;
+
+  private ready = false;
+
+  private result?: { fingerprint: string; ack: FormAck };
+
+  constructor(
+    private readonly binding: AppFormBinding,
+    frameId: string,
+    requestId: string,
+  ) {
+    this.context = {
+      type: "SALEOR_FORM_CONTEXT",
+      action: "formContext",
+      frameId,
+      requestId,
+      contextVersion: binding.contextVersion,
+      formType: binding.formType,
+      objectId: binding.objectId,
+      ...(binding.languageCode ? { languageCode: binding.languageCode } : {}),
+      allowedFields: [...binding.allowedFields],
+      nullableFields: [...binding.nullableFields],
+    };
+  }
+
+  load() {
+    this.loaded = true;
+    this.ready = false;
+  }
+
+  receive(
+    event: MessageEvent,
+    frame: HTMLIFrameElement | null,
+    origin: string,
+  ): FormAck | undefined {
+    if (
+      !this.loaded ||
+      !isValidFormBinding(this.binding) ||
+      !frame?.contentWindow ||
+      event.source !== frame.contentWindow ||
+      event.origin !== origin
+    )
+      return;
+
+    const ready = readySchema.safeParse(event.data);
+    const matches = (message: { frameId?: string; requestId?: string; contextVersion?: number }) =>
+      message.frameId === this.context.frameId &&
+      message.requestId === this.context.requestId &&
+      message.contextVersion === this.context.contextVersion;
+
+    if (ready.success) {
+      if (matches(ready.data)) this.ready = true;
+
+      return;
+    }
+
+    const parsed = responseSchema.safeParse(event.data);
+
+    if (!parsed.success || !matches(parsed.data) || parsed.data.formType !== this.context.formType)
+      return;
+
+    const message = parsed.data;
+    const ack = (status: FormAck["status"], code?: string): FormAck => ({
+      type: "SALEOR_FORM_ACK",
+      action: "formResult",
+      frameId: this.context.frameId,
+      requestId: this.context.requestId,
+      contextVersion: this.context.contextVersion,
+      ...(message.actionId ? { actionId: message.actionId } : {}),
+      status,
+      ...(code ? { code } : {}),
+    });
+
+    if (!this.ready) return ack("REJECTED", "NOT_READY");
+
+    let fingerprint: string;
+
+    try {
+      fingerprint = JSON.stringify(message);
+    } catch {
+      return ack("REJECTED", "INVALID_MESSAGE");
+    }
+
+    if (this.result) {
+      return this.result.fingerprint === fingerprint
+        ? this.result.ack
+        : ack("REJECTED", "ALREADY_RESPONDED");
+    }
+
+    if (!this.binding.isCurrent()) return ack("REJECTED", "STALE_CONTEXT");
+
+    let result: FormResult;
+    let accepted: FormAck;
+
+    if (message.status === "SUCCESS") {
+      if (!message.values || message.errors || message.previewValues)
+        return ack("REJECTED", "INVALID_MESSAGE");
+
+      const values = validateValues(message.values, this.binding);
+
+      if (!values) return ack("REJECTED", "INVALID_FIELDS");
+
+      result = { status: "SUCCESS", values };
+      accepted = ack("APPLIED");
+    } else if (message.status === "VALIDATION_ERROR") {
+      if (!message.errors || message.values) return ack("REJECTED", "INVALID_MESSAGE");
+
+      if (
+        message.errors.some(error => !this.binding.allowedFields.includes(error.field as FormField))
+      ) {
+        return ack("REJECTED", "INVALID_FIELDS");
+      }
+
+      const previewValues = message.previewValues
+        ? validateValues(message.previewValues, this.binding)
+        : undefined;
+
+      if (previewValues === null) return ack("REJECTED", "INVALID_FIELDS");
+
+      result = {
+        status: "VALIDATION_ERROR",
+        errors: message.errors.map(error => ({
+          field: error.field!,
+          code: error.code!,
+          message: error.message!,
+        })),
+        ...(previewValues ? { previewValues } : {}),
+      };
+      accepted = ack("PREVIEWED");
+    } else {
+      if (message.values || message.previewValues || message.errors)
+        return ack("REJECTED", "INVALID_MESSAGE");
+
+      result = { status: message.status };
+      accepted = ack(
+        message.status === "CLOSED" ? "CLOSED" : "REJECTED",
+        message.status === "PERMISSION_ERROR" ? "PERMISSION_ERROR" : undefined,
+      );
+    }
+
+    // Record before invoking the form: re-entrant/repeated messages can never apply twice.
+    this.result = { fingerprint, ack: accepted };
+
+    try {
+      this.binding.onResult(result);
+    } catch {
+      accepted = ack("REJECTED", "APPLICATION_ERROR");
+      this.result = { fingerprint, ack: accepted };
+    }
+
+    return accepted;
+  }
+}
diff --git a/src/extensions/views/ViewManifestExtension/components/AppFrame/legacyProtocol.ts b/src/extensions/views/ViewManifestExtension/components/AppFrame/legacyProtocol.ts
