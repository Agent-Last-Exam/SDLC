new file mode 100644
index 0000000..5c43bfc
--- /dev/null
+++ b/src/categories/navigation.ts
@@ -0,0 +1,47 @@
+import { PaginationState } from "@dashboard/hooks/useLocalPaginator";
+
+import { categoryListUrl, categoryPath } from "./urls";
+
+export const categoryPaginationState = (
+  cursor: PaginationState | undefined,
+  pageSize: number,
+): PaginationState => {
+  if (cursor?.after) return { after: cursor.after, first: pageSize };
+
+  if (cursor?.before) return { before: cursor.before, last: pageSize };
+
+  return { first: pageSize };
+};
+
+export interface CategoryNavigationContext {
+  parentId?: string;
+  breadcrumb: Array<{ id: string; name: string }>;
+  listUrl: string;
+  filter?: string;
+  cursor?: { after?: string; before?: string; first?: number; last?: number };
+  tab?: "categories" | "products";
+  lockedContext?: unknown;
+  returnUrl?: string;
+  returnContext?: CategoryNavigationContext;
+}
+
+export const categoryNavigationState = (state: unknown): CategoryNavigationContext | undefined => {
+  const value = (state as { categoryContext?: CategoryNavigationContext } | undefined)
+    ?.categoryContext;
+
+  return value && Array.isArray(value.breadcrumb) ? value : undefined;
+};
+
+export const categoryReturnUrl = (
+  context?: CategoryNavigationContext,
+  parentId?: string,
+): string => {
+  const path = context?.returnUrl;
+
+  // Navigation state is not permission context and cannot redirect outside Dashboard categories.
+  if (path?.startsWith("/categories/") && !path.startsWith("//")) return path;
+
+  if (parentId) return categoryPath(encodeURIComponent(parentId));
+
+  return context?.listUrl?.startsWith("/categories/") ? context.listUrl : categoryListUrl();
+};
