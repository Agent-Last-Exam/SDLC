+import { act, renderHook } from "@testing-library/react-hooks";
+
+import useForm from "./index";
+
+const dirty = jest.fn();
+const submitting = jest.fn();
+
+jest.mock("@dashboard/components/Form", () => ({
+  useExitFormDialog: () => ({
+    formId: Symbol.for("test-form"),
+    setIsDirty: dirty,
+    setIsSubmitting: submitting,
+    setExitDialogSubmitRef: jest.fn(),
+    setEnableExitDialog: jest.fn(),
+    setIsSubmitDisabled: jest.fn(),
+  }),
+}));
+
+function deferred<T>() {
+  let resolve: (value: T) => void;
+  const promise = new Promise<T>(done => {
+    resolve = done;
+  });
+
+  return { promise, resolve: (value: T) => resolve(value) };
+}
+
+describe("useForm editing context and submission snapshots", () => {
+  beforeEach(() => jest.clearAllMocks());
+
+  it("invalidates save guards and retains dirty state through A to B to A edits", async () => {
+    // Arrange
+    const request = deferred<string[]>();
+    const { result } = renderHook(() =>
+      useForm({ name: "old" }, () => request.promise, { confirmLeave: true }),
+    );
+    let pending: Promise<unknown>;
+
+    act(() => result.current.set({ name: "A" }));
+
+    const guard = result.current.getSaveGuard();
+
+    // Act
+    act(() => {
+      pending = result.current.submit();
+    });
+    act(() => result.current.set({ name: "B" }));
+    act(() => result.current.set({ name: "A" }));
+    await act(async () => {
+      request.resolve([]);
+      await pending;
+    });
+
+    // Assert
+    expect(guard()).toBe(false);
+    expect(result.current.changedData).toEqual({ name: "A" });
+    expect(dirty).toHaveBeenLastCalledWith(true);
+  });
+
+  it("merges clean nested fields without overwriting dirty paths", () => {
+    // Arrange
+    const { result, rerender } = renderHook(({ initial }) => useForm(initial), {
+      initialProps: { initial: { name: "old", settings: { delay: 0, enabled: false } } },
+    });
+
+    // Act
+    act(() => result.current.change({ target: { name: "settings.delay", value: 10 } }));
+    rerender({ initial: { name: "new", settings: { delay: 2, enabled: true } } });
+
+    // Assert
+    expect(result.current.data).toEqual({ name: "new", settings: { delay: 10, enabled: true } });
+    expect(result.current.changedData).toEqual({ settings: { delay: 10, enabled: true } });
+  });
+
+  it("set marks changed values dirty but not unchanged spread fields", () => {
+    // Arrange
+    const { result } = renderHook(() => useForm({ name: "old", delay: 0 }));
+
+    // Act
+    act(() => result.current.set({ name: "old", delay: 10 }));
+
+    // Assert
+    expect(result.current.changedData).toEqual({ delay: 10 });
+  });
+
+  it("retains edits made after a submitted snapshot succeeds", async () => {
+    // Arrange
+    const request = deferred<string[]>();
+    const submit = jest.fn(() => request.promise);
+    const { result } = renderHook(() =>
+      useForm({ name: "old", delay: 0 }, submit, { confirmLeave: true }),
+    );
+    let pending: Promise<any>;
+
+    // Act
+    act(() => result.current.set({ name: "submitted", delay: 10 }));
+    act(() => {
+      pending = result.current.submit();
+    });
+    act(() => result.current.change({ target: { name: "name", value: "later edit" } }));
+    await act(async () => {
+      request.resolve([]);
+      await pending;
+    });
+
+    // Assert
+    expect(submit).toHaveBeenCalledWith({ name: "submitted", delay: 10 });
+    expect(result.current.changedData).toEqual({ name: "later edit" });
+    expect(dirty).toHaveBeenLastCalledWith(true);
+    expect(submitting).toHaveBeenLastCalledWith(false);
+  });
+
+  it("does not clear dirty state on failure or a missing result", async () => {
+    // Arrange
+    const submit = jest.fn().mockResolvedValueOnce(["CONFLICT"]).mockResolvedValueOnce(undefined);
+    const { result } = renderHook(() => useForm({ name: "old" }, submit, { confirmLeave: true }));
+
+    // Act
+    act(() => result.current.change({ target: { name: "name", value: "draft" } }));
+    await act(async () => {
+      await result.current.submit();
+      await result.current.submit();
+    });
+
+    // Assert
+    expect(result.current.changedData).toEqual({ name: "draft" });
+    expect(dirty).toHaveBeenLastCalledWith(true);
+  });
+
+  it("ignores a prior object's delayed save and resets errors and draft on context switch", async () => {
+    // Arrange
+    const request = deferred<string[]>();
+    const { result, rerender } = renderHook(
+      ({ id, initial }) =>
+        useForm(initial, () => request.promise, { confirmLeave: true, contextKey: id }),
+      {
+        initialProps: { id: "a", initial: { name: "A" } },
+      },
+    );
+    let pending: Promise<any>;
+
+    // Act
+    act(() => result.current.change({ target: { name: "name", value: "draft A" } }));
+    act(() => {
+      pending = result.current.submit();
+    });
+    rerender({ id: "b", initial: { name: "B" } });
+    act(() => result.current.change({ target: { name: "name", value: "draft B" } }));
+    await act(async () => {
+      request.resolve([]);
+      await pending;
+    });
+
+    // Assert
+    expect(result.current.data.name).toBe("draft B");
+    expect(result.current.changedData).toEqual({ name: "draft B" });
+    expect(dirty).toHaveBeenLastCalledWith(true);
+  });
+
+  it("does not let an earlier submission clear edits when saves resolve in reverse order", async () => {
+    // Arrange
+    const first = deferred<string[]>();
+    const second = deferred<string[]>();
+    const submit = jest.fn().mockReturnValueOnce(first.promise).mockReturnValueOnce(second.promise);
+    const { result } = renderHook(() => useForm({ name: "old" }, submit, { confirmLeave: true }));
+    let firstPending: Promise<any>;
+    let secondPending: Promise<any>;
+
+    // Act
+    act(() => result.current.set({ name: "first" }));
+    act(() => {
+      firstPending = result.current.submit();
+    });
+    act(() => result.current.set({ name: "second" }));
+    act(() => {
+      secondPending = result.current.submit();
+    });
+    await act(async () => {
+      second.resolve([]);
+      await secondPending;
+    });
+    act(() => result.current.set({ name: "third" }));
+    await act(async () => {
+      first.resolve([]);
+      await firstPending;
+    });
+
+    // Assert
+    expect(result.current.changedData).toEqual({ name: "third" });
+    expect(dirty).toHaveBeenLastCalledWith(true);
+  });
+});
