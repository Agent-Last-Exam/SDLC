@@ -0,0 +1,83 @@
+import { useEffect, useRef, useState } from "react";
+import { v4 as uuid } from "uuid";
+
+export type PaymentRequestState =
+  | "idle"
+  | "submitting"
+  | "pending"
+  | "succeeded"
+  | "failed"
+  | "unconfirmed";
+
+/** A retry reuses its operation key; a different object, provider, action or amount never does. */
+export const usePaymentRequest = (contextKey: string) => {
+  const current = useRef({ contextKey, operation: "", key: "", pending: false, generation: 0 });
+  const [state, setState] = useState<{
+    contextKey: string;
+    status: PaymentRequestState;
+    message?: string;
+  }>({ contextKey, status: "idle" });
+
+  if (current.current.contextKey !== contextKey) {
+    current.current = {
+      contextKey,
+      operation: "",
+      key: "",
+      pending: false,
+      generation: current.current.generation + 1,
+    };
+  }
+
+  useEffect(
+    () => () => {
+      current.current = { ...current.current, contextKey: "unmounted" };
+    },
+    [],
+  );
+
+  const run = async (
+    operation: string,
+    request: (
+      key: string,
+      isCurrent: () => boolean,
+    ) => Promise<{ status: "pending" | "succeeded" | "failed"; message?: string }>,
+  ) => {
+    const scope = current.current;
+
+    if (scope.contextKey !== contextKey || scope.pending) {
+      return;
+    }
+
+    if (scope.operation !== operation || !scope.key) {
+      scope.operation = operation;
+      scope.key = uuid();
+    }
+
+    scope.pending = true;
+    setState({ contextKey, status: "submitting" });
+
+    try {
+      const result = await request(scope.key, () => current.current === scope);
+
+      if (current.current === scope) {
+        setState({ contextKey, ...result });
+      }
+    } catch {
+      if (current.current === scope) {
+        setState({
+          contextKey,
+          status: "unconfirmed",
+          message:
+            "The payment result is unconfirmed. Check refreshed facts or retry with the same operation key.",
+        });
+      }
+    } finally {
+      scope.pending = false;
+    }
+  };
+
+  return {
+    ...(state.contextKey === contextKey ? state : { contextKey, status: "idle" as const }),
+    run,
+  };
+};
