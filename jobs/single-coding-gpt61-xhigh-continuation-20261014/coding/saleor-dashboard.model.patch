+    // Arrange
+    mockSetPassword.mockResolvedValue(result);
+    render(<NewPassword {...route()} />);
+    // Act
+    await act(async () => {
+      await mockPage.onSubmit({ password: "new-password" });
+    });
+    // Assert
+    expect(mockNavigate).not.toHaveBeenCalled();
+    expect(mockPage.errors).toHaveLength(1);
+    expect(mockPage.loading).toBe(false);
+  });
+
