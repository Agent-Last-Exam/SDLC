+import { PasswordAuthenticationModeEnum } from "@dashboard/graphql";
+import { render, screen } from "@testing-library/react";
+
+import { PasswordPolicyGate } from "./PasswordPolicyGate";
+
+const mockPolicyQuery = jest.fn();
+
+jest.mock("@dashboard/graphql", () => ({
+  __esModule: true,
+  PasswordAuthenticationModeEnum: jest.requireActual("@dashboard/graphql/types.generated")
+    .PasswordAuthenticationModeEnum,
+  useAvailableExternalAuthenticationsQuery: (options: unknown) => mockPolicyQuery(options),
+}));
+
+describe("staff password policy gate", () => {
+  it.each([PasswordAuthenticationModeEnum.CUSTOMERS_ONLY, PasswordAuthenticationModeEnum.DISABLED])(
+    "hides direct password routes for %s",
+    mode => {
+      // Arrange
+      mockPolicyQuery.mockReturnValue({ data: { shop: { passwordAuthenticationMode: mode } } });
+      // Act
+      render(
+        <PasswordPolicyGate>
+          <button>Password form</button>
+        </PasswordPolicyGate>,
+      );
+      // Assert
+      expect(screen.queryByRole("button")).not.toBeInTheDocument();
+      expect(screen.getByText(/Password authentication for staff is disabled/)).toBeInTheDocument();
+    },
+  );
+
+  it("allows the form only after an enabled policy is loaded", () => {
+    // Arrange
+    mockPolicyQuery.mockReturnValue({
+      data: { shop: { passwordAuthenticationMode: PasswordAuthenticationModeEnum.ENABLED } },
+    });
+    // Act
+    render(
+      <PasswordPolicyGate>
+        <button>Password form</button>
+      </PasswordPolicyGate>,
+    );
+    // Assert
+    expect(screen.getByRole("button")).toBeInTheDocument();
+    expect(mockPolicyQuery).toHaveBeenCalledWith({ fetchPolicy: "network-only" });
+  });
+
+  it("fails closed when settings cannot be loaded", () => {
+    // Arrange
+    mockPolicyQuery.mockReturnValue({ error: new Error("Network error") });
+    // Act
+    render(
+      <PasswordPolicyGate>
+        <button>Password form</button>
+      </PasswordPolicyGate>,
+    );
+    // Assert
+    expect(screen.queryByRole("button")).not.toBeInTheDocument();
+    expect(screen.getByText(/Unable to load sign-in settings/)).toBeInTheDocument();
+  });
+
+  it("does not expose the form while settings are loading", () => {
+    // Arrange
+    mockPolicyQuery.mockReturnValue({ loading: true });
+    // Act
+    render(
+      <PasswordPolicyGate>
+        <button>Password form</button>
+      </PasswordPolicyGate>,
+    );
+    // Assert
+    expect(screen.queryByRole("button")).not.toBeInTheDocument();
+    expect(screen.getByText(/Loading sign-in settings/)).toBeInTheDocument();
+  });
+});
