+export const toLocalDateTimeInput = (value?: string | null): string => {
+  if (!value) {
+    return "";
+  }
+
+  const date = new Date(value);
+
+  if (!Number.isFinite(date.getTime())) {
+    return "";
+  }
+
+  const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
+
+  return local.toISOString().slice(0, 16);
+};
+
+export const isValidCompletionDelay = (value?: string) =>
+  value === undefined || (/^\d+$/.test(value) && Number(value) <= 10080);
+
+export const isValidCompletionCutoff = (value?: string) =>
+  !value || Number.isFinite(new Date(value).getTime());
+
+export const getCompletionSettingsInput = (
+  data: { automaticCompletionDelay?: string; automaticCompletionCutoff?: string },
+  saved?: { automaticCompletionDelay: number; automaticCompletionCutoff?: string | null },
+) => ({
+  ...(data.automaticCompletionDelay !== undefined &&
+  Number(data.automaticCompletionDelay) !== saved?.automaticCompletionDelay
+    ? { automaticCompletionDelay: Number(data.automaticCompletionDelay) }
+    : {}),
+  ...(data.automaticCompletionCutoff !== undefined &&
+  data.automaticCompletionCutoff !== toLocalDateTimeInput(saved?.automaticCompletionCutoff)
+    ? {
+        automaticCompletionCutoff: data.automaticCompletionCutoff
+          ? new Date(data.automaticCompletionCutoff).toISOString()
+          : null,
+      }
+    : {}),
+});
