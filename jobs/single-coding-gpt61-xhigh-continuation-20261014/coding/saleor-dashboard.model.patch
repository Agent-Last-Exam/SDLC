+import { act, renderHook } from "@testing-library/react-hooks";
+
+import useForm from "./index";
+
+jest.mock("@dashboard/hooks/useHandleFormSubmit", () => ({
+  __esModule: true,
+  default: ({ onSubmit }: { onSubmit: (data: unknown) => Promise<unknown[]> }) => onSubmit,
+}));
+
+const mockSetIsDirty = jest.fn();
+
+jest.mock("@dashboard/components/Form", () => ({
+  useExitFormDialog: () => ({
+    setIsDirty: mockSetIsDirty,
+    setExitDialogSubmitRef: jest.fn(),
+    setEnableExitDialog: jest.fn(),
+    setIsSubmitDisabled: jest.fn(),
+  }),
+}));
+
+const original = { name: "Original", slug: "old", settingsRevision: "1" };
+
+describe("configuration editing", () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  it("does not treat a coincidental remote value as a new editing baseline", () => {
+    // Arrange
+    const { result, rerender } = renderHook(
+      ({ initial }) => useForm(initial, undefined, { confirmLeave: false, preserveDirty: true }),
+      { initialProps: { initial: original } },
+    );
+
+    // Act
+    act(() => result.current.change({ target: { name: "name", value: "Local edit" } }));
+    rerender({ initial: { name: "Local edit", slug: "remote", settingsRevision: "2" } });
+    rerender({ initial: { name: "Another remote edit", slug: "newer", settingsRevision: "3" } });
+    // Assert
+    expect(result.current.data).toEqual({
+      name: "Local edit",
+      slug: "newer",
+      settingsRevision: "1",
+    });
+  });
+
+  it("keeps submitted values when the successful response precedes cache hydration", async () => {
+    // Arrange
+    const onSubmit = jest.fn().mockResolvedValue([]);
+    const { result } = renderHook(() =>
+      useForm(original, onSubmit, { confirmLeave: true, preserveDirty: true }),
+    );
+
+    // Act
+    act(() => result.current.change({ target: { name: "name", value: "Saved edit" } }));
+    await act(async () => {
+      await result.current.submit();
+    });
+    // Assert
+    expect(result.current.data.name).toBe("Saved edit");
+    expect(mockSetIsDirty).toHaveBeenLastCalledWith(false);
+  });
+
+  it("preserves edits made during a successful save and their dirty state", async () => {
+    // Arrange
+    let complete: (errors: string[]) => void;
+    const onSubmit = jest.fn(
+      () =>
+        new Promise<string[]>(resolve => {
+          complete = resolve;
+        }),
+    );
+    const { result, rerender } = renderHook(
+      ({ initial }) => useForm(initial, onSubmit, { confirmLeave: true, preserveDirty: true }),
+      { initialProps: { initial: original } },
+    );
+    let pending: Promise<string[]>;
+
+    // Act
+    act(() => result.current.change({ target: { name: "name", value: "Submitted edit" } }));
+    act(() => {
+      pending = result.current.submit();
+    });
+    act(() => result.current.change({ target: { name: "name", value: "New edit" } }));
+    rerender({ initial: { ...original, name: "Submitted edit", settingsRevision: "2" } });
+    await act(async () => {
+      complete([]);
+      await pending;
+    });
+    // Assert
+    expect(result.current.data.name).toBe("New edit");
+    expect(result.current.data.settingsRevision).toBe("2");
+    expect(mockSetIsDirty).toHaveBeenLastCalledWith(true);
+  });
+
+  it("does not mistake an unrelated refetch for the save receipt", async () => {
+    // Arrange
+    let complete: (errors: string[]) => void;
+    const onSubmit = jest.fn(
+      () =>
+        new Promise<string[]>(resolve => {
+          complete = resolve;
+        }),
+    );
+    const { result, rerender } = renderHook(
+      ({ initial }) => useForm(initial, onSubmit, { confirmLeave: true, preserveDirty: true }),
+      { initialProps: { initial: original } },
+    );
+    let pending: Promise<string[]>;
+
+    // Act
+    act(() => result.current.change({ target: { name: "name", value: "Submitted edit" } }));
+    act(() => {
+      pending = result.current.submit();
+    });
+    rerender({
+      initial: { ...original, name: "Another administrator's edit", settingsRevision: "3" },
+    });
+    await act(async () => {
+      complete([]);
+      await pending;
+    });
+
+    // Assert
+    expect(result.current.data.name).toBe("Submitted edit");
+    expect(result.current.data.settingsRevision).toBe("1");
+  });
+
+  it("allows another attempt after a rejected save", async () => {
+    // Arrange
+    const onSubmit = jest.fn().mockRejectedValueOnce(new Error("offline")).mockResolvedValue([]);
+    const { result } = renderHook(() =>
+      useForm(original, onSubmit, { confirmLeave: false, preserveDirty: true }),
+    );
+
+    // Act
+    await act(async () => {
+      await expect(result.current.submit()).rejects.toThrow("offline");
+    });
+    await act(async () => {
+      await result.current.submit();
+    });
+    // Assert
+    expect(onSubmit).toHaveBeenCalledTimes(2);
+  });
+  it("keeps dirty fields and their revision while accepting pristine fields", () => {
+    // Arrange
+    const { result, rerender } = renderHook(
+      ({ initial }) => useForm(initial, undefined, { confirmLeave: false, preserveDirty: true }),
+      { initialProps: { initial: original } },
+    );
+
+    // Act
+    act(() => result.current.change({ target: { name: "name", value: "Local edit" } }));
+    rerender({ initial: { name: "Remote edit", slug: "remote", settingsRevision: "2" } });
+    // Assert
+    expect(result.current.data).toEqual({
+      name: "Local edit",
+      slug: "remote",
+      settingsRevision: "1",
+    });
+  });
+
+  it("hydrates an untouched form with the newest settings", () => {
+    // Arrange
+    const { result, rerender } = renderHook(
+      ({ initial }) => useForm(initial, undefined, { confirmLeave: false, preserveDirty: true }),
+      { initialProps: { initial: original } },
+    );
+    // Act
+    const latest = { name: "Remote edit", slug: "remote", settingsRevision: "2" };
+
+    rerender({ initial: latest });
+    // Assert
+    expect(result.current.data).toEqual(latest);
+  });
+
+  it("does not submit a second command while the first is pending", async () => {
+    // Arrange
+    let complete: (errors: string[]) => void;
+    const onSubmit = jest.fn(
+      () =>
+        new Promise<string[]>(resolve => {
+          complete = resolve;
+        }),
+    );
+    const { result } = renderHook(() =>
+      useForm(original, onSubmit, { confirmLeave: false, preserveDirty: true }),
+    );
+    // Act
+    let first: Promise<string[]>;
+
+    act(() => {
+      first = result.current.submit();
+    });
+    await act(async () => {
+      await result.current.submit();
+    });
+    await act(async () => {
+      complete([]);
+      await first;
+    });
+    // Assert
+    expect(onSubmit).toHaveBeenCalledTimes(1);
+  });
+
+  it("retains edits after a failed save", async () => {
+    // Arrange
+    const onSubmit = jest.fn().mockResolvedValue(["CONFLICT"]);
+    const { result } = renderHook(() =>
+      useForm(original, onSubmit, { confirmLeave: false, preserveDirty: true }),
+    );
+
+    // Act
+    act(() => result.current.change({ target: { name: "name", value: "Local edit" } }));
+    await act(async () => {
+      await result.current.submit();
+    });
+    // Assert
+    expect(result.current.data.name).toBe("Local edit");
+    expect(result.current.data.settingsRevision).toBe("1");
+  });
+});
