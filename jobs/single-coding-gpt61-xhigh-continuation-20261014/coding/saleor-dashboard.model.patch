+import { act, renderHook } from "@testing-library/react-hooks";
+import { createContext } from "react";
+
+import useHandleFormSubmit from "./useHandleFormSubmit";
+
+const mockSetIsSubmitting = jest.fn();
+const mockSetIsDirty = jest.fn();
+
+jest.mock("@dashboard/components/Form", () => ({
+  useExitFormDialog: () => ({ setIsSubmitting: mockSetIsSubmitting, setIsDirty: mockSetIsDirty }),
+}));
+
+jest.mock("@dashboard/components/messages", () => ({
+  MessageContext: createContext(null),
+}));
+
+describe("form submission lifecycle", () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  it("unlocks after an asynchronous failure without clearing dirty state", async () => {
+    // Arrange
+    const { result } = renderHook(() =>
+      useHandleFormSubmit({ onSubmit: () => Promise.reject(new Error("offline")) }),
+    );
+
+    // Act
+    await act(async () => {
+      await expect(result.current({})).rejects.toThrow("offline");
+    });
+    // Assert
+    expect(mockSetIsSubmitting.mock.calls).toEqual([[true], [false]]);
+    expect(mockSetIsDirty).not.toHaveBeenCalled();
+  });
+
+  it("unlocks after a synchronous failure", async () => {
+    // Arrange
+    const { result } = renderHook(() =>
+      useHandleFormSubmit({
+        onSubmit: () => {
+          throw new Error("failed");
+        },
+      }),
+    );
+
+    // Act
+    await act(async () => {
+      await expect(result.current({})).rejects.toThrow("failed");
+    });
+    // Assert
+    expect(mockSetIsSubmitting).toHaveBeenLastCalledWith(false);
+  });
+
+  it("unlocks when no submit handler is provided", async () => {
+    // Arrange
+    const { result } = renderHook(() => useHandleFormSubmit({}));
+
+    // Act
+    await act(async () => {
+      await result.current({});
+    });
+    // Assert
+    expect(mockSetIsSubmitting).toHaveBeenLastCalledWith(false);
+    expect(mockSetIsDirty).not.toHaveBeenCalled();
