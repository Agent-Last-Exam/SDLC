+import {
+  getCompletionSettingsInput,
+  isValidCompletionDelay,
+  toLocalDateTimeInput,
+} from "./completionSettings";
+
+describe("completion settings", () => {
+  it.each(["0", "1", "10080"])("accepts delay %s", value => {
+    // Arrange / Act / Assert
+    expect(isValidCompletionDelay(value)).toBe(true);
+  });
+
+  it.each(["", "-1", "1.1", "10081", "NaN", " 1"])("rejects delay %s", value => {
+    // Arrange / Act / Assert
+    expect(isValidCompletionDelay(value)).toBe(false);
+  });
+
+  it("omits unchanged values without losing cutoff seconds", () => {
+    // Arrange
+    const saved = {
+      automaticCompletionDelay: 7,
+      automaticCompletionCutoff: "2026-10-14T10:02:31Z",
+    };
+    // Act
+    const result = getCompletionSettingsInput(
+      {
+        automaticCompletionDelay: "7",
+        automaticCompletionCutoff: toLocalDateTimeInput(saved.automaticCompletionCutoff),
+      },
+      saved,
+    );
+
+    // Assert
+    expect(result).toEqual({});
+  });
+
+  it("sends null only when clearing a saved cutoff", () => {
+    // Arrange
+    const saved = {
+      automaticCompletionDelay: 0,
+      automaticCompletionCutoff: "2026-10-14T10:00:00Z",
+    };
+    // Act
+    const result = getCompletionSettingsInput({ automaticCompletionCutoff: "" }, saved);
+
+    // Assert
+    expect(result).toEqual({ automaticCompletionCutoff: null });
+  });
+
+  it("does not send omitted settings", () => {
+    // Arrange / Act
+    const result = getCompletionSettingsInput({});
+
+    // Assert
+    expect(result).toEqual({});
+  });
+});
