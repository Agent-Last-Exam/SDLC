diff --git a/src/utils/configurationMutation.test.ts b/src/utils/configurationMutation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6409940ea79a24527019f9973f228d82ee091bbc
--- /dev/null
+++ b/src/utils/configurationMutation.test.ts
@@ -0,0 +1,60 @@
+import { getConfigurationMutationErrors } from "./configurationMutation";
+
+const fallback = { code: "GRAPHQL_ERROR" };
+const success = { resource: { id: "shop" }, errors: [] };
+
+describe("configuration mutation results", () => {
+  it.each([undefined, null, { resource: null, errors: [] }])(
+    "rejects a missing successful payload",
+    payload => {
+      // Arrange
+      const result = {};
+      // Act
+      const errors = getConfigurationMutationErrors(result, [payload], fallback);
+
+      // Assert
+      expect(errors).toEqual([fallback]);
+    },
+  );
+
+  it("does not mistake partial data with GraphQL errors for success", () => {
+    // Arrange
+    const result = { errors: [{ message: "Permission denied" }] } as any;
+    // Act
+    const errors = getConfigurationMutationErrors(result, [success], fallback);
+
+    // Assert
+    expect(errors).toEqual([fallback]);
+  });
+
+  it("rejects a partial multi-field save", () => {
+    // Arrange
+    const payloads = [success, null];
+    // Act
+    const errors = getConfigurationMutationErrors({}, payloads, fallback);
+
+    // Assert
+    expect(errors).toEqual([fallback]);
+  });
+
+  it("preserves the business errors from either step", () => {
+    // Arrange
+    const conflict = { code: "CONFLICT" };
+    const payloads = [success, { resource: null, errors: [conflict] }];
+    // Act
+    const errors = getConfigurationMutationErrors({}, payloads, fallback);
+
+    // Assert
+    expect(errors).toEqual([conflict]);
+  });
+
+  it("accepts success only when every expected payload contains a resource", () => {
+    // Arrange
+    const payloads = [success, success];
+    // Act
+    const errors = getConfigurationMutationErrors({}, payloads, fallback);
+
+    // Assert
+    expect(errors).toEqual([]);
+  });
+});
diff --git a/src/utils/configurationMutation.ts b/src/utils/configurationMutation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..740409f3699b08a516c38584294168776515cda2
--- /dev/null
+++ b/src/utils/configurationMutation.ts
@@ -0,0 +1,24 @@
+import { FetchResult } from "@apollo/client";
+
+type ConfigurationPayload<TError> = {
+  errors: readonly TError[];
+  resource: unknown;
+};
+
+export function getConfigurationMutationErrors<TError>(
+  result: Pick<FetchResult, "errors">,
+  payloads: ReadonlyArray<ConfigurationPayload<TError> | null | undefined>,
+  fallback: TError,
+): TError[] {
+  const errors = payloads.flatMap(payload => payload?.errors ?? []);
+  const invalidResult =
+    result.errors?.length ||
+    payloads.length === 0 ||
+    payloads.some(payload => !payload || !Array.isArray(payload.errors) || !payload.resource);
+
+  if (invalidResult && errors.length === 0) {
+    return [fallback];
+  }
+
+  return errors;
+}
