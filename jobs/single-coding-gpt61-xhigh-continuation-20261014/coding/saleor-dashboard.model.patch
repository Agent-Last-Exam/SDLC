--- /dev/null
+++ b/src/auth/components/PasswordPolicyGate.tsx
@@ -0,0 +1,45 @@
+import {
+  PasswordAuthenticationModeEnum,
+  useAvailableExternalAuthenticationsQuery,
+} from "@dashboard/graphql";
+import { Text } from "@saleor/macaw-ui-next";
+import { ReactNode } from "react";
+import { FormattedMessage } from "react-intl";
+
+export const PasswordPolicyGate = ({ children }: { children: ReactNode }) => {
+  const { data, loading, error } = useAvailableExternalAuthenticationsQuery({
+    fetchPolicy: "network-only",
+  });
+
+  if (loading) {
+    return (
+      <Text>
+        <FormattedMessage id="7khqwr" defaultMessage="Loading sign-in settings…" />
+      </Text>
+    );
+  }
+
+  if (error || !data?.shop) {
+    return (
+      <Text>
+        <FormattedMessage
+          id="s78Y56"
+          defaultMessage="Unable to load sign-in settings. Reload to try again."
+        />
+      </Text>
+    );
+  }
+
+  if (data.shop.passwordAuthenticationMode !== PasswordAuthenticationModeEnum.ENABLED) {
+    return (
+      <Text>
+        <FormattedMessage
+          id="sY9o/g"
+          defaultMessage="Password authentication for staff is disabled. Use a configured external sign-in method or contact your administrator."
+        />
+      </Text>
+    );
+  }
+
+  return <>{children}</>;
+};
