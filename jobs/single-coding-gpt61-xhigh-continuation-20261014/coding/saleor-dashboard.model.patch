+import { act, render } from "@testing-library/react";
+
+import ResetPasswordView from "./ResetPassword";
+
+const mockNavigate = jest.fn();
+const mockReset = jest.fn();
+let mockPage: any;
+
+jest.mock("@dashboard/hooks/useNavigator", () => ({
+  __esModule: true,
+  default: () => mockNavigate,
+}));
+jest.mock("@dashboard/graphql", () => ({
+  AccountErrorCode: { INVALID: "INVALID" },
+  useRequestPasswordResetMutation: () => [mockReset, { loading: false }],
+}));
+jest.mock("react-intl", () => ({
+  ...jest.requireActual<typeof import("react-intl")>("react-intl"),
+  useIntl: () => ({ formatMessage: () => "Request failed" }),
+}));
+jest.mock("../components/PasswordPolicyGate", () => ({
+  PasswordPolicyGate: ({ children }: any) => children,
+}));
+jest.mock("../utils", () => ({
+  getNewPasswordResetRedirectUrl: () => "http://localhost/new-password/",
+}));
+jest.mock("../components/ResetPasswordPage", () => ({
+  __esModule: true,
+  default: (props: unknown) => {
+    mockPage = props;
+
+    return null;
+  },
+}));
+
+describe("password reset result handling", () => {
+  beforeEach(() => jest.clearAllMocks());
+
+  it.each([
+    {},
+    { data: { requestPasswordReset: null } },
+    { data: { requestPasswordReset: { errors: [{ code: "INVALID" }] } } },
+    { data: { requestPasswordReset: { errors: [] } }, errors: [{ message: "failed" }] },
+  ])("does not navigate for an unsuccessful result", async result => {
+    // Arrange
+    mockReset.mockResolvedValue(result);
+    render(<ResetPasswordView />);
+    // Act
+    await act(async () => {
+      await mockPage.onSubmit({ email: "test@example.com" });
+    });
+    // Assert
+    expect(mockNavigate).not.toHaveBeenCalled();
+    expect(mockPage.error).toBe("Request failed");
+    expect(mockPage.disabled).toBe(false);
+  });
+
+  it("unlocks after transport failure and allows retry", async () => {
+    // Arrange
+    mockReset.mockRejectedValueOnce(new Error("offline"));
+    mockReset.mockResolvedValueOnce({ data: { requestPasswordReset: { errors: [] } } });
+    render(<ResetPasswordView />);
+    // Act
+    await act(async () => {
+      await mockPage.onSubmit({ email: "test@example.com" });
+    });
+    expect(mockNavigate).not.toHaveBeenCalled();
+    await act(async () => {
+      await mockPage.onSubmit({ email: "test@example.com" });
+    });
+    // Assert
+    expect(mockPage.disabled).toBe(false);
+    expect(mockNavigate).toHaveBeenCalledWith("/reset-password/success/");
+    expect(mockReset).toHaveBeenCalledTimes(2);
+  });
+
+  it("submits a pending request only once", async () => {
+    // Arrange
+    let resolve: (value: unknown) => void;
+
+    mockReset.mockReturnValue(
+      new Promise(res => {
+        resolve = res;
+      }),
+    );
+    render(<ResetPasswordView />);
+    // Act
+    await act(async () => {
+      const first = mockPage.onSubmit({ email: "test@example.com" });
+
+      await mockPage.onSubmit({ email: "test@example.com" });
+      resolve!({ data: { requestPasswordReset: { errors: [] } } });
+      await first;
+    });
+    // Assert
+    expect(mockReset).toHaveBeenCalledTimes(1);
+    expect(mockNavigate).toHaveBeenCalledTimes(1);
+  });
+});
