new file mode 100644
index 0000000000000000000000000000000000000000..bf3c0f1b2836e2389c72004169ded08f7623eb67
--- /dev/null
+++ b/saleor/graphql/checkout/mutations/checkout_shipping_refresh.py
@@ -0,0 +1,162 @@
+import graphene
+from django.core.exceptions import ValidationError
+from django.utils import timezone
+
+from ....checkout.error_codes import CheckoutErrorCode
+from ....checkout.fetch import fetch_checkout_info, fetch_checkout_lines
+from ....checkout.shipping_context import recalculate_shipping
+from ....checkout.utils import (
+    get_external_shipping_id,
+    get_valid_collection_points_for_checkout,
+    is_shipping_required,
+)
+from ....core.exceptions import SyncEventError
+from ....shipping.interface import ShippingMethodData
+from ...core.context import SyncWebhookControlContext
+from ...core.doc_category import DOC_CATEGORY_CHECKOUT
+from ...core.mutations import BaseMutation
+from ...core.scalars import DateTime
+from ...core.types import CheckoutError, NonNullList
+from ...plugins.dataloaders import get_plugin_manager_promise
+from ...shipping.types import ShippingMethod
+from ...warehouse.types import Warehouse
+from ..types import Checkout, DeliveryMethod
+from .utils import get_checkout
+
+
+class CheckoutShippingRefresh(BaseMutation):
+    checkout = graphene.Field(Checkout)
+    shipping_methods = NonNullList(ShippingMethod, required=True)
+    collection_points = NonNullList(Warehouse, required=True)
+    delivery_method = graphene.Field(DeliveryMethod)
+    selected_method_valid = graphene.Boolean(required=True)
+    calculated_at = DateTime(required=True)
+
+    class Arguments:
+        id = graphene.ID(required=True)
+
+    class Meta:
+        description = (
+            "Recalculate delivery options without assigning or clearing the saved "
+            "delivery method, changing updatedAt, or completing the checkout."
+        )
+        doc_category = DOC_CATEGORY_CHECKOUT
+        error_type_class = CheckoutError
+
+    @classmethod
+    def handle_errors(cls, error, **extra):
+        return super().handle_errors(
+            error,
+            shipping_methods=[],
+            collection_points=[],
+            selected_method_valid=False,
+            calculated_at=timezone.now(),
+            **extra,
+        )
+
+    @classmethod
+    def perform_mutation(cls, _root, info, /, *, id):
+        checkout = get_checkout(cls, info, id=id)
+        if not checkout.channel.is_active:
+            raise ValidationError(
+                {
+                    "id": ValidationError(
+                        "The channel is inactive.",
+                        code=CheckoutErrorCode.CHANNEL_INACTIVE.value,
+                    )
+                }
+            )
+        baseline = (checkout.last_change, checkout.channel.settings_revision)
+        manager = get_plugin_manager_promise(info.context).get()
+        lines, unavailable = fetch_checkout_lines(checkout)
+        if unavailable:
+            raise ValidationError(
+                {
+                    "id": ValidationError(
+                        "Some checkout variants are unavailable.",
+                        code=CheckoutErrorCode.UNAVAILABLE_VARIANT_IN_CHANNEL.value,
+                    )
+                }
+            )
+        shipping_required = is_shipping_required(lines)
+        if shipping_required and not checkout.shipping_address:
+            raise ValidationError(
+                {
+                    "shipping_address": ValidationError(
+                        "Shipping address is required.",
+                        code=CheckoutErrorCode.SHIPPING_ADDRESS_NOT_SET.value,
+                    )
+                }
+            )
+        checkout_info = fetch_checkout_info(checkout, lines, manager)
+        try:
+            with recalculate_shipping():
+                methods = (
+                    checkout_info.valid_shipping_methods if shipping_required else []
+                )
+            points = (
+                list(
+                    get_valid_collection_points_for_checkout(
+                        lines,
+                        checkout.channel_id,
+                        quantity_check=True,
+                    )
+                )
+                if shipping_required
+                else []
+            )
+        except SyncEventError:
+            raise ValidationError(
+                {
+                    "id": ValidationError(
+                        "The shipping service failed. Retry the calculation.",
+                        code=CheckoutErrorCode.SHIPPING_SERVICE_ERROR.value,
+                    )
+                }
+            ) from None
+
+        # Do not call get_delivery_method_info: that helper persists denormalized prices.
+        selected = checkout.collection_point
+        selected_id = (
+            str(checkout.shipping_method_id)
+            if checkout.shipping_method_id
+            else get_external_shipping_id(checkout)
+        )
+        if selected_id:
+            selected = next((m for m in methods if str(m.id) == selected_id), None)
+            if selected is None:
+                selected = ShippingMethodData(
+                    id=selected_id,
+                    name=checkout.shipping_method_name or "",
+                    price=checkout.undiscounted_base_shipping_price,
+                    active=False,
+                )
+        valid = not shipping_required or (
+            selected is not None
+            and selected
+            in (methods if isinstance(selected, ShippingMethodData) else points)
+        )
+        current = (
+            type(checkout)
+            .objects.filter(pk=checkout.pk)
+            .values_list("last_change", "channel__settings_revision")
+            .first()
+        )
+        if current != baseline:
+            raise ValidationError(
+                {
+                    "id": ValidationError(
+                        "Checkout changed during calculation. Retry.",
+                        code=CheckoutErrorCode.CONFLICT.value,
+                    )
+                }
+            )
+        return cls(
+            checkout=SyncWebhookControlContext(checkout, allow_sync_webhooks=False),
+            shipping_methods=methods,
+            collection_points=points,
+            delivery_method=selected,
+            selected_method_valid=valid,
+            calculated_at=timezone.now(),
+            errors=[],
+        )
