+++ b/saleor/app/tests/test_extension_contract.py
@@ -0,0 +1,67 @@
+import pytest
+from django.core.exceptions import ValidationError
+
+from ..extensions import extension_settings, normalize_extension
+from ..models import AppExtension
+from ..types import AppExtensionTarget
+
+
+@pytest.mark.parametrize("method", ["GET", "POST"])
+def test_normalize_legacy_extension_preserves_settings(method):
+    # given
+    legacy = {
+        "label": "Widget",
+        "url": "/widget",
+        "mount": "PRODUCT_DETAILS_WIDGETS",
+        "target": "WIDGET",
+        "options": {"widgetTarget": {"method": method}},
+    }
+    # when
+    result = normalize_extension(legacy)
+    # then
+    assert result["settings"] == legacy["options"]
+    assert result["mountName"] == legacy["mount"]
+    assert "settings" not in legacy
+
+
+@pytest.mark.parametrize(
+    "extension_config",
+    [
+        None,
+        [],
+        "{}",
+        {"other": {}},
+        {"widgetTarget": {"method": "DELETE"}},
+        {"widgetTarget": {"method": "GET", "extra": True}},
+        {"newTabTarget": {"method": "POST"}},
+    ],
+)
+def test_invalid_extension_settings_rejected(extension_config):
+    # given
+    extension = {
+        "mountName": "PRODUCT_DETAILS_WIDGETS",
+        "targetName": "WIDGET",
+        "settings": extension_config,
+    }
+    # when / then
+    with pytest.raises(ValidationError):
+        normalize_extension(extension)
+
+
+def test_default_target_and_settings():
+    # given / when
+    result = normalize_extension({"mountName": "PRODUCT_DETAILS_MORE_ACTIONS"})
+    # then
+    assert result["targetName"] == "POPUP"
+    assert result["settings"] == {}
+
+
+def test_read_settings_preserves_json_and_legacy_method():
+    # given
+    extension = AppExtension(
+        target=AppExtensionTarget.WIDGET, http_target_method="POST"
+    )
+    # when / then
+    assert extension_settings(extension) == {"widgetTarget": {"method": "POST"}}
+    extension.settings = {"widgetTarget": {"method": "GET"}}
+    assert extension_settings(extension) == extension.settings
