+from django.db import migrations
+
+
+def preserve_legacy_settings(apps, schema_editor):
+    extension_model = apps.get_model("app", "AppExtension")
+    alias = schema_editor.connection.alias
+    for target, key in (("widget", "widgetTarget"), ("new_tab", "newTabTarget")):
+        for method in ("GET", "POST"):
+            extension_model.objects.using(alias).filter(
+                target=target, http_target_method=method, settings={}
+            ).update(settings={key: {"method": method}})
+
+
+class Migration(migrations.Migration):
+    dependencies = [("app", "0033_appextension_settings")]
+    operations = [
+        migrations.RunPython(preserve_legacy_settings, migrations.RunPython.noop)
