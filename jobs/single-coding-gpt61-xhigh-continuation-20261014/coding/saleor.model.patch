+            exp_delta=None,
+            additional_payload={"oauth_refresh_token": "provider-secret"},
+            token_owner=plugin.PLUGIN_ID,
+        )
+    )
+    fetch = mocker.patch.object(plugin.oauth, "refresh_token")
+
+    # when / then
+    with pytest.raises(ValidationError):
+        plugin.external_refresh({"refreshToken": legacy}, rf.request(), None)
+    fetch.assert_not_called()
+
+
+def test_refresh_provider_timeout_is_sanitized_and_handle_is_consumed(
