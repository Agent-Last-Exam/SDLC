+    assert not user.has_usable_password()
+    assert user.jwt_token_key != old_key
+    assert ExternalIdentity.objects.get(issuer=ISSUER, subject="subject-1").user == user
+    with pytest.raises(InvalidTokenError):
+        get_user_from_payload(jwt_decode(token))
