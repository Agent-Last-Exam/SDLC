+def test_failed_token_creation_rolls_back_identity_and_password_change(
+    openid_plugin,
+    settings,
+    rf,
+    mocker,
+    identity_payload,
+    customer_user,
+    django_capture_on_commit_callbacks,
+):
+    # given
+    settings.ALLOWED_CLIENT_HOSTS = ["localhost"]
+    plugin = openid_plugin(issuer=ISSUER)
+    response = plugin.external_authentication_url(
+        {"redirectUri": "http://localhost:9000/callback"}, rf.request(), None
+    )
+    state = parse_qs(urlsplit(response["authorizationUrl"]).query)["state"][0]
+    original_password = customer_user.password
+    original_key = customer_user.jwt_token_key
+    mocker.patch.object(
+        plugin.oauth, "fetch_token", return_value={"access_token": "token"}
+    )
+    mocker.patch(
+        "saleor.plugins.openid_connect.plugin.get_parsed_id_token",
+        return_value=identity_payload,
+    )
+    mocker.patch(
+        "saleor.plugins.openid_connect.plugin.create_tokens_from_oauth_payload",
+        side_effect=AuthenticationError("Invalid external token response."),
+    )
+    events = []
+    mocker.patch(
+        "saleor.plugins.openid_connect.plugin.send_user_event",
+        side_effect=lambda *args: transaction.on_commit(lambda: events.append(args)),
+    )
+
+    # when / then
+    with (
+        django_capture_on_commit_callbacks(execute=True),
+        pytest.raises(ValidationError),
+    ):
+        plugin.external_obtain_access_tokens(
+            {"code": "code", "state": state}, rf.request(), None
+        )
+    customer_user.refresh_from_db()
+    assert customer_user.password == original_password
+    assert customer_user.jwt_token_key == original_key
+    assert not customer_user.external_identities.exists()
+    # The event registration rolls back with the outer transaction.
+    assert events == []
+
