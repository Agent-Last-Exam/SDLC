diff --git a/saleor/plugins/openid_connect/refresh_session.py b/saleor/plugins/openid_connect/refresh_session.py
new file mode 100644
index 0000000000000000000000000000000000000000..a4662a27eb3aa0a27783a2164b85e9934e74f9d4
--- /dev/null
+++ b/saleor/plugins/openid_connect/refresh_session.py
@@ -0,0 +1,95 @@
+import base64
+from uuid import UUID
+
+from cryptography.fernet import Fernet, InvalidToken, MultiFernet
+from cryptography.hazmat.primitives import hashes
+from cryptography.hazmat.primitives.kdf.hkdf import HKDF
+from django.conf import settings
+from django.db import transaction
+from django.utils import timezone
+
+from ...account.models import ExternalRefreshSession, User
+from ...core.db.connection import allow_writer
+from .exceptions import AuthenticationError
+
+EXTERNAL_REFRESH_SESSION_FIELD = "external_refresh_session"
+
+
+def _cipher():
+    keys = [settings.SECRET_KEY, *settings.SECRET_KEY_FALLBACKS]
+    return MultiFernet(
+        [
+            Fernet(
+                base64.urlsafe_b64encode(
+                    HKDF(
+                        algorithm=hashes.SHA256(),
+                        length=32,
+                        salt=None,
+                        info=b"saleor.oidc.refresh-session.v1",
+                    ).derive(key.encode())
+                )
+            )
+            for key in keys
+        ]
+    )
+
+
+@allow_writer()
+def create_refresh_session(user: User, refresh_token: str, owner: str, issuer: str):
+    if (
+        not isinstance(refresh_token, str)
+        or not 1 <= len(refresh_token) <= 65536
+        or not isinstance(issuer, str)
+        or not 1 <= len(issuer) <= 512
+        or not isinstance(owner, str)
+        or not 1 <= len(owner) <= 255
+    ):
+        raise AuthenticationError("Invalid external refresh session.")
+    session = ExternalRefreshSession.objects.create(
+        user=user,
+        owner=owner,
+        issuer=issuer,
+        encrypted_refresh_token=_cipher().encrypt(refresh_token.encode()).decode(),
+        expires_at=timezone.now() + settings.JWT_TTL_REFRESH,
+    )
+    return str(session.pk)
+
+
+@allow_writer()
+@transaction.atomic
+def consume_refresh_session(session_id, user: User, owner: str, issuer: str):
+    try:
+        session_pk = (
+            UUID(session_id)
+            if isinstance(session_id, str) and len(session_id) == 36
+            else None
+        )
+    except ValueError:
+        session_pk = None
+    if session_pk is None:
+        raise AuthenticationError("Invalid external refresh session.")
+    now = timezone.now()
+    session = (
+        ExternalRefreshSession.objects.select_for_update()
+        .filter(
+            pk=session_pk,
+            user=user,
+            owner=owner,
+            issuer=issuer,
+            expires_at__gt=now,
+            consumed_at__isnull=True,
+        )
+        .first()
+    )
+    if session is None:
+        raise AuthenticationError("Invalid external refresh session.")
+    try:
+        refresh_token = (
+            _cipher().decrypt(session.encrypted_refresh_token.encode()).decode()
+        )
+    except (InvalidToken, UnicodeError, ValueError) as error:
+        raise AuthenticationError("Invalid external refresh session.") from error
+    session.consumed_at = now
+    session.encrypted_refresh_token = ""
+    session.save(update_fields=["consumed_at", "encrypted_refresh_token"])
+    return refresh_token
