diff --git a/saleor/plugins/openid_connect/tests/test_refresh_session_concurrency.py b/saleor/plugins/openid_connect/tests/test_refresh_session_concurrency.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb2dbf3dbd0691d967d3fdcede3392fd510ba758
--- /dev/null
+++ b/saleor/plugins/openid_connect/tests/test_refresh_session_concurrency.py
@@ -0,0 +1,43 @@
+from concurrent.futures import ThreadPoolExecutor
+from threading import Barrier
+
+import pytest
+from django.db import close_old_connections
+
+from ....account.models import ExternalRefreshSession, User
+from ..exceptions import AuthenticationError
+from ..refresh_session import consume_refresh_session, create_refresh_session
+
+
+@pytest.mark.django_db(transaction=True)
+def test_concurrent_refresh_consumers_only_one_can_obtain_provider_secret(
+    customer_user,
+):
+    # given
+    owner = "mirumee.authentication.openidconnect"
+    issuer = "https://identity.example/"
+    handle = create_refresh_session(customer_user, "provider-secret", owner, issuer)
+    user_pk = customer_user.pk
+    ready = Barrier(2)
+
+    def consume():
+        close_old_connections()
+        try:
+            user = User.objects.get(pk=user_pk)
+            ready.wait(timeout=10)
+            try:
+                return consume_refresh_session(handle, user, owner, issuer)
+            except AuthenticationError:
+                return "rejected"
+        finally:
+            close_old_connections()
+
+    # when
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(lambda _: consume(), range(2)))
+
+    # then
+    assert sorted(results) == ["provider-secret", "rejected"]
+    session = ExternalRefreshSession.objects.get(pk=handle)
+    assert session.consumed_at is not None
+    assert session.encrypted_refresh_token == ""
