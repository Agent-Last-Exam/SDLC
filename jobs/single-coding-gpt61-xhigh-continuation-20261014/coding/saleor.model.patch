+def test_google_offline_authorization_and_one_time_state(
+    openid_plugin, settings, rf, mocker, identity_payload
+):
+    # given
+    settings.ALLOWED_CLIENT_HOSTS = ["localhost"]
+    plugin = openid_plugin(
+        oauth_authorization_url="https://accounts.google.com/o/oauth2/v2/auth",
+        issuer=ISSUER,
+    )
+    response = plugin.external_authentication_url(
+        {"redirectUri": "http://localhost:9000/login/callback"}, rf.request(), None
+    )
+    query = parse_qs(urlsplit(response["authorizationUrl"]).query)
+    state = query["state"][0]
+    state_data = signing.loads(state, salt=plugin.PLUGIN_ID, max_age=600)
+    mocker.patch.object(
+        plugin.oauth, "fetch_token", return_value={"access_token": "token"}
+    )
+    identity_payload["exp"] = int(timezone.now().timestamp()) + 3600
+    decode = mocker.patch(
+        "saleor.plugins.openid_connect.plugin.get_parsed_id_token",
+        return_value=identity_payload,
+    )
+
+    # when
+    result = plugin.external_obtain_access_tokens(
+        {"code": "code", "state": state}, rf.request(), None
+    )
+
+    # then
+    assert result.user.email == identity_payload["email"]
+    assert query["access_type"] == ["offline"]
+    assert "offline_access" not in query["scope"][0]
+    assert query["code_challenge_method"] == ["S256"]
+    verifier = plugin.oauth.fetch_token.call_args.kwargs["code_verifier"]
+    assert query["code_challenge"] == [
+        urlsafe_b64encode(sha256(verifier.encode()).digest()).rstrip(b"=").decode()
+    ]
+    assert "code_verifier" not in query
+    assert decode.call_args.kwargs["nonce"] == state_data["nonce"]
+    with pytest.raises(ValidationError):
+        plugin.external_obtain_access_tokens(
+            {"code": "code", "state": state}, rf.request(), None
+        )
+    assert plugin.oauth.fetch_token.call_count == 1
+
