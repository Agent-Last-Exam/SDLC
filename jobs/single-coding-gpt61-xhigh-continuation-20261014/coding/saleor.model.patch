+    refresh = create_jwt_refresh_token(
+        customer_user,
+        "provider-secret",
+        "csrf",
+        plugin.PLUGIN_ID,
+        issuer=plugin.config.issuer,
+    )
+    mocker.patch.object(
+        plugin.oauth, "refresh_token", side_effect=Timeout("provider-secret")
+    )
+
+    # when / then
+    with pytest.raises(ValidationError) as error:
+        plugin.external_refresh({"refreshToken": refresh}, rf.request(), None)
