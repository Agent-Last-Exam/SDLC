@@ -0,0 +1,282 @@
+import copy
+
+import pytest
+from django.core.exceptions import ValidationError
+
+from ..editorjs import MAX_BLOCKS, MAX_TEXT, clean_editor_js
+
+
+def document(text):
+    return {"blocks": [{"type": "paragraph", "data": {"text": text}}]}
+
+
+@pytest.mark.parametrize(
+    "href",
+    [
+        "https://example.com/a",
+        "http://example.com",
+        "mailto:a@example.com",
+        "tel:+123",
+        "/products/a",
+        "#details",
+    ],
+)
+def test_supported_links_and_opener_protection(href):
+    # given
+    value = document(f'<a href="{href}" target="_blank" rel="nofollow opener">Link</a>')
+    original = copy.deepcopy(value)
+
+    # when
+    result = clean_editor_js(value)
+
+    # then
+    assert 'rel="nofollow noopener noreferrer"' in result["blocks"][0]["data"]["text"]
+    assert value == original
+    assert result is not value
+    assert clean_editor_js(result) == result
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        '<a href="javascript:alert(1)">x</a>',
+        '<a href="&#106;avascript:alert(1)">x</a>',
+        '<a href="java%0ascript:alert(1)">x</a>',
+        '<a href="//example.com">x</a>',
+        '<a href="/\\example.com">x</a>',
+        '<a href="data:text/html,x">x</a>',
+        '<a href="https://user:secret@example.com">x</a>',
+        '<a href="https://example.com" onclick="bad()">x</a>',
+        '<a href="https://example.com" target="window">x</a>',
+        '<b style="color:red">x</b>',
+        "<svg><a>x</a></svg>",
+        "<script>alert(1)</script>",
+        "<!-- hidden -->",
+    ],
+)
+def test_unsafe_content_is_rejected_without_mutation(text):
+    # given
+    value = document(text)
+    original = copy.deepcopy(value)
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        clean_editor_js(value)
+
+    # then
+    assert value == original
+    assert list(error.value.error_dict) == ["description.blocks[0].data.text"]
+    assert (
+        error.value.error_dict["description.blocks[0].data.text"][0].code == "invalid"
+    )
+    assert text not in str(error.value)
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        {},
+        {"blocks": [None]},
+        {"blocks": [{"type": "unknown", "data": {}}]},
+        {"blocks": [], "unknown": True},
+        {"blocks": [], "time": True},
+        {"blocks": [{"type": "paragraph", "data": {"text": "ok", "extra": True}}]},
+    ],
+)
+def test_unknown_or_invalid_structure_is_rejected(value):
+    # given / when / then
+    with pytest.raises(ValidationError):
+        clean_editor_js(value)
+
+
+def nested_list(depth):
+    items = [{"content": "leaf"}]
+    for _ in range(depth - 1):
+        items = [{"content": "parent", "items": items}]
+    return {"blocks": [{"type": "list", "data": {"style": "ordered", "items": items}}]}
+
+
+def test_list_depth_boundary_and_legacy_strings():
+    # given / when
+    result = clean_editor_js(nested_list(8))
+
+    # then
+    assert result["blocks"][0]["data"]["style"] == "ordered"
+    with pytest.raises(ValidationError, match="DEPTH"):
+        clean_editor_js(nested_list(9))
+    value = {
+        "blocks": [
+            {
+                "type": "list",
+                "data": {"style": "unordered", "items": ["one", "<b>two</b>"]},
+            }
+        ]
+    }
+    assert clean_editor_js(value) == value
+
+
+def test_editorjs_resource_boundaries():
+    # given / when / then
+    assert clean_editor_js(document("x" * MAX_TEXT))
+    with pytest.raises(ValidationError, match="SIZE"):
+        clean_editor_js(document("x" * (MAX_TEXT + 1)))
+    with pytest.raises(ValidationError, match="SIZE"):
+        clean_editor_js({"blocks": document("x")["blocks"] * (MAX_BLOCKS + 1)})
+    assert clean_editor_js({"blocks": []}) == {"blocks": []}
+    assert clean_editor_js(None) is None
+
+
+def test_image_and_embed_domains():
+    # given
+    value = {
+        "blocks": [
+            {
+                "type": "image",
+                "data": {"file": {"url": "/media/image.png"}, "caption": "Image"},
+            },
+            {
+                "type": "embed",
+                "data": {
+                    "service": "youtube",
+                    "source": "https://youtu.be/123",
+                    "embed": "https://www.youtube.com/embed/123",
+                },
+            },
+        ]
+    }
+
+    # when / then
+    assert clean_editor_js(value) == value
+    value["blocks"][1]["data"]["embed"] = (
+        "https://youtube.com.attacker.example/embed/123"
+    )
+    with pytest.raises(ValidationError, match="URL_SCHEME"):
+        clean_editor_js(value)
+
+
+@pytest.mark.parametrize(
+    ("text", "normalized"),
+    [
+        (
+            'Text <a href="https://example.com/">',
+            'Text <a href="https://example.com/"></a>',
+        ),
+        (
+            '<a href="https://example.com/">one <a href="mailto:a@example.com">two',
+            '<a href="https://example.com/">one </a><a href="mailto:a@example.com">two</a>',
+        ),
+        ("Text <a >", "Text <a></a>"),
+        ("<strong>Safe <em>formatting", "<strong>Safe <em>formatting</em></strong>"),
+        (
+            '<a href="https://example.com/" target="_blank">safe',
+            '<a href="https://example.com/" target="_blank" rel="noopener noreferrer">safe</a>',
+        ),
+    ],
+)
+def test_historical_inline_html_is_normalized_safely(text, normalized):
+    # given
+    value = document(text)
+    original = copy.deepcopy(value)
+
+    # when
+    result = clean_editor_js(value)
+
+    # then
+    assert result == document(normalized)
+    assert value == original
+    assert clean_editor_js(result) == result
+    assert clean_editor_js(result, to_string=True) == clean_editor_js(
+        original, to_string=True
+    )
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        '<a href="javascript:alert(1)">unclosed',
+        '<a href="https://example.com/">safe<a href="data:text/html,bad">bad',
+        '<a href="https://example.com/" onclick="bad()">unclosed',
+        '<a href="https://example.com/">safe<script>bad',
+        "<b><em>crossed</b></em>",
+        "<unknown>unclosed",
+    ],
+)
+def test_html_normalization_does_not_allow_unsafe_or_crossed_content(text):
+    # given
+    value = document(text)
+    original = copy.deepcopy(value)
+
+    # when / then
+    with pytest.raises(ValidationError):
+        clean_editor_js(value)
+    assert value == original
+
+
+def test_historical_list_image_and_embed_remain_editable():
+    # given
+    value = {
+        "blocks": [
+            {
+                "type": "paragraph",
+                "data": {"text": '<a href="https://example.com/">text'},
+            },
+            {
+                "type": "list",
+                "data": {
+                    "style": "unordered",
+                    "items": ['<a href="https://example.com/">item', "plain item"],
+                },
+            },
+            {
+                "type": "image",
+                "data": {
+                    "file": {"url": "https://example.com/image.png"},
+                    "caption": "Image",
+                    "withBorder": False,
+                    "stretched": False,
+                    "withBackground": False,
+                },
+            },
+            {
+                "type": "embed",
+                "data": {
+                    "service": "youtube",
+                    "source": "https://www.youtube.com/123",
+                    "embed": "https://www.youtube.com/embed/123",
+                    "width": 580,
+                    "height": 320,
+                    "caption": "Video",
+                },
+            },
+        ]
+    }
+    original = copy.deepcopy(value)
+
+    # when
+    result = clean_editor_js(value)
+
+    # then
+    assert (
+        result["blocks"][0]["data"]["text"] == '<a href="https://example.com/">text</a>'
+    )
+    assert result["blocks"][1]["data"]["items"] == [
+        '<a href="https://example.com/">item</a>',
+        "plain item",
+    ]
+    assert result["blocks"][2:] == original["blocks"][2:]
+    assert clean_editor_js(result) == result
+    assert value == original
+
+
+def test_historical_plain_text_projection_preserves_document_order():
+    # given
+    value = {
+        "blocks": [
+            {"type": "paragraph", "data": {"text": "first"}},
+            {"type": "list", "data": {"items": ["second", "third"]}},
+            {"type": "unknown", "data": {"text": "fourth"}},
+        ]
+    }
+
+    # when / then
+    assert clean_editor_js(value, to_string=True) == "first second third fourth"
