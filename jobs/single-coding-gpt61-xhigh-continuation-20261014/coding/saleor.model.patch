diff --git a/saleor/graphql/order/tests/queries/test_shipping_snapshot_contract.py b/saleor/graphql/order/tests/queries/test_shipping_snapshot_contract.py
new file mode 100644
index 0000000000000000000000000000000000000000..206ec772f64f9039e99abca4f8b524f8236c59fa
--- /dev/null
+++ b/saleor/graphql/order/tests/queries/test_shipping_snapshot_contract.py
@@ -0,0 +1,182 @@
+import graphene
+import pytest
+from prices import Money
+
+from .....order import ShippingMetadataSnapshotStatus
+from .....order.shipping_snapshot import shipping_metadata_snapshot
+from .....shipping.interface import ShippingMethodData
+from ....tests.utils import get_graphql_content
+
+QUERY = """
+query Snapshot($id: ID!) {
+  order(id: $id) {
+    shippingMethodMetadata { key value }
+    shippingMetadataSnapshotStatus
+    fulfillments {
+      shippingMethodMetadata { key value }
+      shippingMetadataSnapshotStatus
+    }
+  }
+}
+"""
+PRIVATE_QUERY = """
+query Snapshot($id: ID!) {
+  order(id: $id) {
+    shippingMethodPrivateMetadata { key value }
+    fulfillments { shippingMethodPrivateMetadata { key value } }
+  }
+}
+"""
+
+
+def test_shipping_snapshot_copies_external_metadata_without_aliasing():
+    # given
+    method = ShippingMethodData(
+        id="external",
+        price=Money(1, "USD"),
+        metadata={"service": "express"},
+        private_metadata={"account": "private"},
+    )
+
+    # when
+    snapshot = shipping_metadata_snapshot(method)
+    method.metadata["service"] = "changed"
+    method.private_metadata.clear()
+
+    # then
+    assert snapshot == {
+        "shipping_method_metadata": {"service": "express"},
+        "shipping_method_private_metadata": {"account": "private"},
+        "shipping_metadata_snapshot_status": ShippingMetadataSnapshotStatus.CAPTURED,
+    }
+    assert shipping_metadata_snapshot(None) == {
+        "shipping_method_metadata": {},
+        "shipping_method_private_metadata": {},
+        "shipping_metadata_snapshot_status": ShippingMetadataSnapshotStatus.CAPTURED,
+    }
+
+
+@pytest.mark.parametrize("delete_source", [True, False])
+def test_order_and_fulfillment_use_snapshot_not_shipping_source(
+    fulfilled_order, staff_api_client, permission_manage_orders, delete_source
+):
+    # given
+    order = fulfilled_order
+    source = order.shipping_method
+    source.metadata = {"service": "original"}
+    source.private_metadata = {"account": "private-original"}
+    source.save(update_fields=["metadata", "private_metadata"])
+    snapshot = shipping_metadata_snapshot(source)
+    for field, value in snapshot.items():
+        setattr(order, field, value)
+    order.save(update_fields=list(snapshot))
+    if delete_source:
+        source.delete()
+    else:
+        source.metadata = {"service": "changed"}
+        source.private_metadata = {"account": "private-changed"}
+        source.save(update_fields=["metadata", "private_metadata"])
+    variables = {"id": graphene.Node.to_global_id("Order", order.pk)}
+
+    # when
+    response = staff_api_client.post_graphql(
+        QUERY,
+        variables,
+        permissions=[permission_manage_orders],
+        check_no_permissions=False,
+    )
+    result = get_graphql_content(response)["data"]["order"]
+    private_response = staff_api_client.post_graphql(PRIVATE_QUERY, variables)
+    private_result = get_graphql_content(private_response)["data"]["order"]
+
+    # then
+    expected = [{"key": "service", "value": "original"}]
+    assert result["shippingMethodMetadata"] == expected
+    assert result["shippingMetadataSnapshotStatus"] == "CAPTURED"
+    assert result["fulfillments"][0]["shippingMethodMetadata"] == expected
+    assert result["fulfillments"][0]["shippingMetadataSnapshotStatus"] == "CAPTURED"
+    private = [{"key": "account", "value": "private-original"}]
+    assert private_result["shippingMethodPrivateMetadata"] == private
+    assert private_result["fulfillments"][0]["shippingMethodPrivateMetadata"] == private
+
+
+def test_historical_order_does_not_fabricate_missing_snapshot(
+    order, shipping_method, staff_api_client, permission_manage_orders
+):
+    # given
+    source = shipping_method
+    order.shipping_method = source
+    order.save(update_fields=["shipping_method"])
+    source.metadata = {"not": "historical-fact"}
+    source.save(update_fields=["metadata"])
+
+    # when
+    response = staff_api_client.post_graphql(
+        QUERY,
+        {"id": graphene.Node.to_global_id("Order", order.pk)},
+        permissions=[permission_manage_orders],
+        check_no_permissions=False,
+    )
+
+    # then
+    result = get_graphql_content(response)["data"]["order"]
+    assert result["shippingMethodMetadata"] == []
+    assert result["shippingMetadataSnapshotStatus"] == "UNAVAILABLE"
+
+
+def test_customer_cannot_read_private_shipping_snapshot(user_api_client, order):
+    # given
+    order.shipping_method_private_metadata = {"private": "must-not-leak"}
+    order.shipping_metadata_snapshot_status = ShippingMetadataSnapshotStatus.CAPTURED
+    order.save(
+        update_fields=[
+            "shipping_method_private_metadata",
+            "shipping_metadata_snapshot_status",
+        ]
+    )
+
+    # when
+    response = user_api_client.post_graphql(
+        PRIVATE_QUERY,
+        {"id": graphene.Node.to_global_id("Order", order.pk)},
+        check_no_permissions=False,
+    )
+
+    # then
+    result = response.json()
+    assert result.get("errors")
+    assert "must-not-leak" not in str(result)
+
+
+def test_draft_completion_captures_shipping_metadata(
+    draft_order, staff_api_client, permission_group_manage_orders
+):
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    source = draft_order.shipping_method
+    source.metadata = {"service": "at-completion"}
+    source.private_metadata = {"account": "private"}
+    source.save(update_fields=["metadata", "private_metadata"])
+    mutation = """
+    mutation Complete($id: ID!) {
+      draftOrderComplete(id: $id) {
+        order { id shippingMethodMetadata { key value } shippingMetadataSnapshotStatus }
+        errors { code field }
+      }
+    }
+    """
+
+    # when
+    response = staff_api_client.post_graphql(
+        mutation, {"id": graphene.Node.to_global_id("Order", draft_order.pk)}
+    )
+
+    # then
+    result = get_graphql_content(response)["data"]["draftOrderComplete"]
+    assert result["errors"] == []
+    assert result["order"]["shippingMethodMetadata"] == [
+        {"key": "service", "value": "at-completion"}
+    ]
+    assert result["order"]["shippingMetadataSnapshotStatus"] == "CAPTURED"
+    draft_order.refresh_from_db()
+    assert draft_order.shipping_method_private_metadata == {"account": "private"}
