+import pytest
+
+from ...order import ShippingMetadataSnapshotStatus
+from ...plugins.manager import get_plugins_manager
+from ..complete_checkout import (
+    _create_order,
+    _prepare_order_data,
+    create_order_from_checkout,
+)
+from ..fetch import fetch_checkout_info, fetch_checkout_lines
+
+
+@pytest.mark.parametrize("flow", ["payment", "transaction"])
+def test_checkout_order_creation_captures_shipping_metadata(
+    checkout_with_items_and_shipping, shipping_method, customer_user, flow
+):
+    # given
+    checkout = checkout_with_items_and_shipping
+    shipping_method.metadata = {"service": "at-order-creation"}
+    shipping_method.private_metadata = {"account": "private-at-order-creation"}
+    shipping_method.save(update_fields=["metadata", "private_metadata"])
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+
+    # when
+    if flow == "payment":
+        order = _create_order(
+            checkout_info=checkout_info,
+            checkout_lines=lines,
+            order_data=_prepare_order_data(
+                manager=manager,
+                checkout_info=checkout_info,
+                lines=lines,
+                prices_entered_with_tax=True,
+            ),
+            user=customer_user,
+            app=None,
+            manager=manager,
+        )
+    else:
+        order = create_order_from_checkout(
+            checkout_info=checkout_info,
+            manager=manager,
+            user=customer_user,
+            app=None,
+        )
+    shipping_method.metadata = {"service": "changed-after-creation"}
+    shipping_method.private_metadata = {}
+    shipping_method.save(update_fields=["metadata", "private_metadata"])
+    order.refresh_from_db()
+
+    # then
+    assert order.shipping_method_metadata == {"service": "at-order-creation"}
+    assert order.shipping_method_private_metadata == {
+        "account": "private-at-order-creation"
+    }
+    assert (
+        order.shipping_metadata_snapshot_status
+        == ShippingMetadataSnapshotStatus.CAPTURED
+    )
