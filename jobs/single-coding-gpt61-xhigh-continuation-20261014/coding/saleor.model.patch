@@ -0,0 +1,223 @@
+from datetime import timedelta
+
+import pytest
+from django.core.exceptions import ValidationError
+from django.utils import timezone
+from requests import Timeout
+
+from ....account.models import ExternalIdentity, ExternalRefreshSession
+from ....core.jwt import JWT_REFRESH_TYPE, jwt_decode, jwt_encode, jwt_user_payload
+from ..exceptions import AuthenticationError
+from ..refresh_session import consume_refresh_session, create_refresh_session
+from ..utils import create_jwt_refresh_token, create_jwt_token, validate_refresh_token
+
+ISSUER = "https://identity.example/"
+OWNER = "mirumee.authentication.openidconnect"
+
+
+def test_provider_credentials_are_not_in_client_tokens(customer_user):
+    # given
+    provider_refresh = "provider-refresh-secret"
+    provider_access = "provider-access-secret"
+
+    # when
+    refresh = create_jwt_refresh_token(
+        customer_user, provider_refresh, "csrf", OWNER, issuer=ISSUER
+    )
+    access = create_jwt_token(
+        {"exp": int(timezone.now().timestamp()) + 600},
+        customer_user,
+        provider_access,
+        [],
+        OWNER,
+    )
+    refresh_payload = jwt_decode(refresh)
+    access_payload = jwt_decode(access)
+    session = ExternalRefreshSession.objects.get(
+        pk=refresh_payload["external_refresh_session"]
+    )
+
+    # then
+    assert "oauth_refresh_token" not in refresh_payload
+    assert "oauth_access_key" not in access_payload
+    assert provider_refresh not in str(refresh_payload)
+    assert provider_access not in str(access_payload)
+    assert provider_refresh not in session.encrypted_refresh_token
+    assert refresh_payload["exp"] > refresh_payload["iat"]
+    assert (
+        consume_refresh_session(str(session.pk), customer_user, OWNER, ISSUER)
+        == provider_refresh
+    )
+    session.refresh_from_db()
+    assert session.consumed_at is not None
+    assert session.encrypted_refresh_token == ""
+    with pytest.raises(AuthenticationError):
+        consume_refresh_session(str(session.pk), customer_user, OWNER, ISSUER)
+
+
+@pytest.mark.parametrize(
+    "field", ["owner", "issuer", "user", "expired", "consumed", "ciphertext"]
+)
+def test_invalid_refresh_session_fails_closed(customer_user, staff_user, field):
+    # given
+    session_id = create_refresh_session(customer_user, "secret", OWNER, ISSUER)
+    changes = {
+        "owner": {"owner": "other-owner"},
+        "issuer": {"issuer": "https://other.example/"},
+        "user": {"user": staff_user},
+        "expired": {"expires_at": timezone.now() - timedelta(seconds=1)},
+        "consumed": {"consumed_at": timezone.now()},
+        "ciphertext": {"encrypted_refresh_token": "tampered"},
+    }
+    ExternalRefreshSession.objects.filter(pk=session_id).update(**changes[field])
+
+    # when / then
+    with pytest.raises(AuthenticationError, match="Invalid external refresh session"):
+        consume_refresh_session(session_id, customer_user, OWNER, ISSUER)
+
+
+@pytest.mark.parametrize("session_id", [None, {}, [], 123, "invalid", "", "x" * 10000])
+def test_malformed_refresh_handle_is_rejected(customer_user, session_id):
+    # given / when / then
+    with pytest.raises(AuthenticationError):
+        consume_refresh_session(session_id, customer_user, OWNER, ISSUER)
+
+
+def test_refresh_encryption_supports_server_key_rotation(customer_user, settings):
+    # given
+    settings.SECRET_KEY = "old-test-key"
+    settings.SECRET_KEY_FALLBACKS = []
+    session_id = create_refresh_session(customer_user, "provider-secret", OWNER, ISSUER)
+    settings.SECRET_KEY = "new-test-key"
+    settings.SECRET_KEY_FALLBACKS = ["old-test-key"]
+
+    # when
+    token = consume_refresh_session(session_id, customer_user, OWNER, ISSUER)
+
+    # then
+    assert token == "provider-secret"
+
+
+@pytest.mark.parametrize("rotated", [True, False])
+def test_external_refresh_rotates_handle_and_rejects_replay(
+    customer_user, openid_plugin, rf, mocker, rotated
+):
+    # given
+    plugin = openid_plugin()
+    identity = ExternalIdentity.objects.create(
+        user=customer_user, issuer=plugin.config.issuer, subject="subject"
+    )
+    refresh = create_jwt_refresh_token(
+        customer_user,
+        "provider-secret",
+        "csrf",
+        plugin.PLUGIN_ID,
+        issuer=plugin.config.issuer,
+    )
+    response = {"access_token": "access"}
+    if rotated:
+        response["refresh_token"] = "rotated-secret"
+    fetch = mocker.patch.object(plugin.oauth, "refresh_token", return_value=response)
+    mocker.patch(
+        "saleor.plugins.openid_connect.plugin.get_parsed_id_token",
+        return_value={
+            "iss": identity.issuer,
+            "sub": identity.subject,
+            "exp": int(timezone.now().timestamp()) + 600,
+        },
+    )
+
+    # when
+    tokens = plugin.external_refresh({"refreshToken": refresh}, rf.request(), None)
+
+    # then
+    payload = jwt_decode(tokens.refresh_token)
+    assert "oauth_refresh_token" not in payload
+    assert (
+        payload["external_refresh_session"]
