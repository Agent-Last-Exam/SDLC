@@ -0,0 +1,92 @@
+"""Normalize supported legacy extension fields before validation or persistence."""
+
+from copy import deepcopy
+
+from django.core.exceptions import ValidationError
+
+from .error_codes import AppErrorCode
+from .types import AppExtensionMount, AppExtensionTarget
+
+
+def normalize_extension(extension):
+    if not isinstance(extension, dict):
+        raise ValidationError("Invalid extension.", code=AppErrorCode.INVALID.value)
+    result = deepcopy(extension)
+    allowed = {
+        "label",
+        "url",
+        "permissions",
+        "mount",
+        "target",
+        "options",
+        "mountName",
+        "targetName",
+        "settings",
+    }
+    if set(result) - allowed:
+        raise ValidationError(
+            "Unknown extension field.", code=AppErrorCode.INVALID.value
+        )
+    for current, legacy, choices, default in (
+        ("mountName", "mount", AppExtensionMount.CHOICES, None),
+        ("targetName", "target", AppExtensionTarget.CHOICES, "POPUP"),
+    ):
+        value = result.get(current, result.get(legacy, default))
+        if value is None and default is None:
+            raise ValidationError(
+                "Extension mount is required.", code=AppErrorCode.REQUIRED.value
+            )
+        if not isinstance(value, str) or value not in {
+            code.upper() for code, _ in choices
+        }:
+            raise ValidationError(
+                "Invalid extension mount or target.", code=AppErrorCode.INVALID.value
+            )
+        if current in result and legacy in result and result[current] != result[legacy]:
+            raise ValidationError(
+                "Conflicting extension fields.", code=AppErrorCode.INVALID.value
+            )
+        result[current] = value
+        result[legacy] = value
+    options = result.get("options", {})
+    settings = result.get("settings", options)
+    if "options" in result and "settings" in result and options != settings:
+        raise ValidationError(
+            "Conflicting extension settings.", code=AppErrorCode.INVALID.value
+        )
+    target = result["targetName"]
+    if not isinstance(settings, dict) or set(settings) - {
+        "newTabTarget",
+        "widgetTarget",
+    }:
+        raise ValidationError(
+            "Invalid extension settings.", code=AppErrorCode.INVALID.value
+        )
+    if len(settings) > 1:
+        raise ValidationError(
+            "Conflicting target settings.", code=AppErrorCode.INVALID.value
+        )
+    for key, value in settings.items():
+        if (
+            (key == "newTabTarget" and target != "NEW_TAB")
+            or (key == "widgetTarget" and target != "WIDGET")
+            or not isinstance(value, dict)
+            or set(value) != {"method"}
+            or value["method"] not in ("GET", "POST")
+        ):
+            raise ValidationError(
+                "Invalid target settings.", code=AppErrorCode.INVALID.value
+            )
+    result["settings"] = deepcopy(settings)
+    result["options"] = deepcopy(settings)
+    return result
+
+
+def extension_settings(extension):
+    """Read historical settings without dropping an existing JSON object."""
+    if extension.settings:
+        return deepcopy(extension.settings)
+    key = {"new_tab": "newTabTarget", "widget": "widgetTarget"}.get(extension.target)
+    if key and extension.http_target_method:
+        return {key: {"method": extension.http_target_method}}
+    return {}
