index 0000000000000000000000000000000000000000..9192462f2836a6dda76f04a6a4658c41b3c804ec
--- /dev/null
+++ b/saleor/account/password_policy.py
@@ -0,0 +1,53 @@
+from django.conf import settings
+from django.core.exceptions import ValidationError
+
+from ..core.db.connection import allow_writer
+from ..site import PasswordAuthenticationMode
+from ..site.models import SiteSettings
+from .error_codes import AccountErrorCode
+
+
+@allow_writer()
+def password_policy_error(user=None):
+    # Authentication must not use a cached Site instance or a lagging replica.
+    mode = (
+        SiteSettings.objects.using(settings.DATABASE_CONNECTION_DEFAULT_NAME)
+        .filter(site_id=settings.SITE_ID)
+        .values_list("password_authentication_mode", flat=True)
+        .first()
+    )
+    if mode == PasswordAuthenticationMode.DISABLED:
+        return AccountErrorCode.PASSWORD_AUTHENTICATION_DISABLED
+    if mode == PasswordAuthenticationMode.CUSTOMERS_ONLY and user and user.is_staff:
+        return AccountErrorCode.PASSWORD_AUTHENTICATION_RESTRICTED
+    return None
+
+
+@allow_writer()
+def ensure_password_authentication_allowed(user=None, field="password"):
+    if error := password_policy_error(user):
+        raise ValidationError(
+            {
+                field: ValidationError(
+                    "Password authentication is not available under the current shop policy.",
+                    code=error.value,
+                )
+            }
+        )
+    if user and (
+        any(key.startswith("oidc:") for key in user.private_metadata)
+        or (
+            user.pk
+            and user.external_identities.using(
+                settings.DATABASE_CONNECTION_DEFAULT_NAME
+            ).exists()
+        )
+    ):
+        raise ValidationError(
+            {
+                field: ValidationError(
+                    "This account uses external authentication.",
+                    code=AccountErrorCode.PASSWORD_AUTHENTICATION_RESTRICTED.value,
+                )
+            }
+        )
