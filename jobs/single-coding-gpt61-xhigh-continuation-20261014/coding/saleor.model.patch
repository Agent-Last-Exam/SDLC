@@ -0,0 +1,14 @@
+from copy import deepcopy
+
+from . import ShippingMetadataSnapshotStatus
+
+
+def shipping_metadata_snapshot(method):
+    """Capture the selected method once; never reconstruct historical facts."""
+    return {
+        "shipping_method_metadata": deepcopy(method.metadata) if method else {},
+        "shipping_method_private_metadata": deepcopy(method.private_metadata)
+        if method
+        else {},
+        "shipping_metadata_snapshot_status": ShippingMetadataSnapshotStatus.CAPTURED,
+    }
