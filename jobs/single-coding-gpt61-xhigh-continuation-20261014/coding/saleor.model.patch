+import pytest
+from django.core.exceptions import ValidationError
+
+from ......core.jwt import create_access_token, get_user_from_payload, jwt_decode
+from ......site.models import SiteSettings
+from .....tests.utils import get_graphql_content
+from .test_token_create import MUTATION_CREATE_TOKEN
+
+
+@pytest.mark.parametrize(
+    ("mode", "is_staff", "code"),
+    [
+        ("ENABLED", False, None),
+        ("ENABLED", True, None),
+        ("CUSTOMERS_ONLY", False, None),
+        ("CUSTOMERS_ONLY", True, "PASSWORD_AUTHENTICATION_RESTRICTED"),
+        ("DISABLED", False, "PASSWORD_AUTHENTICATION_DISABLED"),
+        ("DISABLED", True, "PASSWORD_AUTHENTICATION_DISABLED"),
+    ],
+)
+def test_password_policy_applies_to_token_create(
+    api_client, customer_user, mode, is_staff, code
+):
+    # given
+    password = customer_user._password
+    customer_user.is_staff = is_staff
+    customer_user.save(update_fields=["is_staff"])
+    SiteSettings.objects.update(password_authentication_mode=mode.lower())
+    # when
+    response = api_client.post_graphql(
+        MUTATION_CREATE_TOKEN,
+        {"email": customer_user.email, "password": password},
+    )
+    data = get_graphql_content(response)["data"]["tokenCreate"]
+    # then
+    if code:
+        assert data["token"] is None
+        assert data["errors"][0]["code"] == code
+    else:
+        assert data["token"]
+        assert not data["errors"]
+
+
+def test_password_epoch_invalidates_existing_token(customer_user):
+    # given
+    token = create_access_token(customer_user)
+    assert get_user_from_payload(jwt_decode(token)) == customer_user
+    # when
+    SiteSettings.objects.update(password_authentication_epoch=1)
+    # then
+    with pytest.raises(ValidationError):
+        get_user_from_payload(jwt_decode(token))
+
+
+def test_linked_external_identity_rejects_password_token(api_client, customer_user):
+    # given
+    password = customer_user._password
+    customer_user.private_metadata = {
+        "oidc:https://identity.example/authorize": "subject"
+    }
+    customer_user.save(update_fields=["private_metadata"])
+    # when
+    response = api_client.post_graphql(
+        MUTATION_CREATE_TOKEN,
+        {"email": customer_user.email, "password": password},
+    )
+    data = get_graphql_content(response)["data"]["tokenCreate"]
+    # then
+    assert data["token"] is None
+    assert data["errors"][0]["code"] == "PASSWORD_AUTHENTICATION_RESTRICTED"
