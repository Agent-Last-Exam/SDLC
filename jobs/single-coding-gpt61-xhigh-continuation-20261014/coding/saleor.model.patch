+import pytest
+from graphql.language import ast
+
+from ..scalars import UUID, Day, Hour, Minute
+
+
+@pytest.mark.parametrize("scalar", [Minute, Hour, Day])
+@pytest.mark.parametrize("value", [-1, 2147483648, True, False, 1.5, "2", [], {}])
+def test_duration_rejects_invalid_variable(scalar, value):
+    # given / when / then
+    with pytest.raises(ValueError, match="nonnegative 32-bit integer"):
+        scalar.parse_value(value)
+
+
+@pytest.mark.parametrize("scalar", [Minute, Hour, Day])
+@pytest.mark.parametrize("value", [0, 1, 2147483647])
+def test_duration_accepts_integer_boundaries(scalar, value):
+    # given / when / then
+    assert scalar.parse_value(value) == value
+    assert scalar.parse_literal(ast.IntValue(value=str(value))) == value
+
+
+@pytest.mark.parametrize("scalar", [Minute, Hour, Day])
+@pytest.mark.parametrize(
+    "node",
+    [
+        ast.StringValue(value="1"),
+        ast.FloatValue(value="1.0"),
+        ast.BooleanValue(value=True),
+    ],
+)
+def test_duration_rejects_non_integer_literal(scalar, node):
+    # given / when / then
+    with pytest.raises(ValueError, match="nonnegative 32-bit integer"):
+        scalar.parse_literal(node)
+
+
+@pytest.mark.parametrize("value", [None, True, 1, 1.5, [], {}])
+def test_uuid_rejects_non_string_without_leaking_internal_errors(value):
+    # given / when / then
+    with pytest.raises(ValueError, match="UUID must be a string"):
+        UUID.parse_value(value)
+
+
+def test_uuid_keeps_valid_string_and_rejects_malformed_string():
+    # given
+    value = "e8dbf3d1-3ad0-4018-88ba-b71652e38b46"
+    # when / then
+    assert str(UUID.parse_value(value)) == value
+    assert UUID.parse_value("not-a-uuid") is None
