@@ -0,0 +1,51 @@
+from collections import defaultdict
+
+from ..bulk_mutations.product_bulk_create import ProductBulkCreate
+
+
+def test_bulk_product_description_rejects_dangerous_content_before_writes():
+    # given
+    data = {
+        "name": "Unsafe",
+        "description": {
+            "blocks": [
+                {
+                    "type": "paragraph",
+                    "data": {"text": '<a href="javascript:alert(1)">x</a>'},
+                }
+            ]
+        },
+    }
+    errors = defaultdict(list)
+    # when
+    count = ProductBulkCreate.clean_base_fields(data, [], 0, errors)
+    # then
+    assert count == 1
+    assert errors[0][0].code == "invalid"
+    assert errors[0][0].path.startswith("description.blocks")
+
+
+def test_bulk_product_description_normalizes_safe_links():
+    # given
+    data = {
+        "name": "Safe",
+        "description": {
+            "blocks": [
+                {
+                    "type": "paragraph",
+                    "data": {
+                        "text": '<a href="https://example.com" target="_blank">x</a>'
+                    },
+                }
+            ]
+        },
+    }
+    errors = defaultdict(list)
+    # when
+    count = ProductBulkCreate.clean_base_fields(data, [], 0, errors)
+    # then
+    assert count == 0
+    assert not errors[0]
+    assert (
+        'rel="noopener noreferrer"' in data["description"]["blocks"][0]["data"]["text"]
+    )
