+"""Request-local shipping calculation controls, never persisted on a checkout."""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+fresh_shipping_calculation = ContextVar("fresh_shipping_calculation", default=False)
+
+
+@contextmanager
+def recalculate_shipping():
+    token = fresh_shipping_calculation.set(True)
+    try:
+        yield
+    finally:
+        fresh_shipping_calculation.reset(token)
