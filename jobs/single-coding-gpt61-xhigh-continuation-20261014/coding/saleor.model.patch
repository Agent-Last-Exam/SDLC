@@ -0,0 +1,171 @@
+import datetime
+
+import graphene
+import pytest
+from django.core.exceptions import ValidationError
+from django.utils import timezone
+
+from .....channel import StockAvailabilityStrategy
+from .....core.utils.metadata_manager import (
+    MetadataValidationError,
+    create_from_graphql_input,
+)
+from ....core.scalars import Day, Hour, Minute
+from ....tests.utils import get_graphql_content
+from ...mutations.utils import clean_input_checkout_settings
+
+
+@pytest.mark.parametrize("scalar", [Minute, Hour, Day])
+@pytest.mark.parametrize("value", [0, 1, 2147483647])
+def test_duration_accepts_only_nonnegative_integer(scalar, value):
+    # given / when / then
+    assert scalar.parse_value(value) == value
+
+
+@pytest.mark.parametrize("scalar", [Minute, Hour, Day])
+@pytest.mark.parametrize("value", [True, False, -1, 1.0, "1", 2147483648])
+def test_duration_rejects_invalid_type_or_range(scalar, value):
+    # given / when / then
+    with pytest.raises(ValueError, match="Duration must be"):
+        scalar.parse_value(value)
+
+
+@pytest.mark.parametrize("value", [None, -1, 10081, True, 1.0])
+def test_invalid_completion_delay(value):
+    # given / when / then
+    with pytest.raises(ValidationError):
+        clean_input_checkout_settings({"automatic_completion_delay": value}, {})
+
+
+def test_cutoff_null_and_omission_are_distinct():
+    # given
+    cutoff = timezone.now()
+    result = {"automatic_completion_cutoff": cutoff, "automatic_completion_delay": 5}
+
+    # when
+    clean_input_checkout_settings(
+        {"automatically_complete_fully_paid_checkouts": False}, result
+    )
+
+    # then
+    assert result["automatic_completion_cutoff"] == cutoff
+    assert result["automatic_completion_delay"] == 5
+    clean_input_checkout_settings({"automatic_completion_cutoff": None}, result)
+    assert result["automatic_completion_cutoff"] is None
+    with pytest.raises(ValidationError):
+        clean_input_checkout_settings(
+            {
+                "automatic_completion_cutoff": datetime.datetime(
+                    2026, 1, 1, tzinfo=datetime.UTC
+                ).replace(tzinfo=None)
+            },
+            {},
+        )
+
+
+@pytest.mark.parametrize(
+    "items",
+    [
+        [{"key": "same", "value": "one"}, {"key": "same", "value": "two"}],
+        [{"key": "x" * 256, "value": "value"}],
+        [{"key": "key", "value": "x" * 5001}],
+        [{"key": "key", "value": None}],
+        [{"key": str(i), "value": "v"} for i in range(101)],
+    ],
+)
+def test_metadata_contract_rejects_whole_input(items):
+    # given / when / then
+    with pytest.raises(MetadataValidationError):
+        create_from_graphql_input(items)
+
+
+UPDATE = """
+mutation Update($id: ID!, $input: ChannelUpdateInput!) {
+  channelUpdate(id: $id, input: $input) {
+    channel {
+      id settingsRevision
+      stockSettings { availabilityStrategy allocationStrategy }
+      checkoutSettings { automaticCompletionDelay automaticCompletionCutoff automaticallyCompleteFullyPaidCheckouts }
+    }
+    errors { field code }
+  }
+}
+"""
+
+
+def test_channel_settings_revision_conflict_is_atomic(
+    staff_api_client, permission_manage_channels, channel_USD
+):
+    # given
+    channel_id = graphene.Node.to_global_id("Channel", channel_USD.pk)
+    variables = {
+        "id": channel_id,
+        "input": {
+            "expectedSettingsRevision": "0",
+            "checkoutSettings": {
+                "automaticCompletionDelay": 7,
+                "automaticCompletionCutoff": "2026-10-14T10:00:00+00:00",
+            },
+            "stockSettings": {"availabilityStrategy": "CHANNEL_WAREHOUSES"},
+        },
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE, variables, permissions=[permission_manage_channels]
+    )
+    result = get_graphql_content(response)["data"]["channelUpdate"]
+
+    # then
+    assert result["errors"] == []
+    assert result["channel"]["settingsRevision"] == "1"
+    channel_USD.refresh_from_db()
+    assert channel_USD.automatic_completion_delay == 7
+    assert (
+        channel_USD.availability_strategy
+        == StockAvailabilityStrategy.CHANNEL_WAREHOUSES
+    )
+    variables["input"]["name"] = "must not be saved"
+    variables["input"]["checkoutSettings"]["automaticCompletionDelay"] = 9
+    response = staff_api_client.post_graphql(
+        UPDATE,
+        variables,
+        permissions=[permission_manage_channels],
+        check_no_permissions=False,
+    )
+    result = get_graphql_content(response)["data"]["channelUpdate"]
+    assert result["errors"] == [
+        {"field": "expectedSettingsRevision", "code": "CONFLICT"}
+    ]
+    channel_USD.refresh_from_db()
+    assert channel_USD.automatic_completion_delay == 7
+    assert channel_USD.name != "must not be saved"
+    assert channel_USD.settings_revision == 1
+
+
+def test_channel_invalid_delay_does_not_write_other_fields(
+    staff_api_client, permission_manage_channels, channel_USD
+):
+    # given
+    old_name = channel_USD.name
+    variables = {
+        "id": graphene.Node.to_global_id("Channel", channel_USD.pk),
+        "input": {
+            "name": "not saved",
+            "checkoutSettings": {"automaticCompletionDelay": None},
+        },
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE, variables, permissions=[permission_manage_channels]
+    )
+    result = get_graphql_content(response)["data"]["channelUpdate"]
+
