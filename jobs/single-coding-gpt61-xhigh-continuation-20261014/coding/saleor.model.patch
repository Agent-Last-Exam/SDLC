+def _plain_text(definitions):
+    result = []
+    stack = [(definitions, 0, None)]
+    while stack:
+        node, depth, key = stack.pop()
+        if depth > 40:
+            continue
+        if isinstance(node, dict):
+            stack.extend(
+                (value, depth + 1, name) for name, value in reversed(list(node.items()))
+            )
+        elif isinstance(node, list):
+            stack.extend((value, depth + 1, key) for value in reversed(node))
+        elif isinstance(node, str) and key in {
+            "text",
+            "caption",
+            "content",
+            "source",
+            "embed",
+            "url",
+            "items",
+        }:
+            text = strip_tags(node)
+            if text:
+                result.append(text)
+    return " ".join(result)
