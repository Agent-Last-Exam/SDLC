index 0000000000000000000000000000000000000000..b076205736c65ff05cc07157b3680a688df7d881
--- /dev/null
+++ b/saleor/graphql/checkout/tests/mutations/test_checkout_shipping_refresh.py
@@ -0,0 +1,170 @@
+from decimal import Decimal
+from unittest.mock import patch
+
+import graphene
+import pytest
+
+from .....core.exceptions import SyncEventError
+from .....order.models import Order
+from .....plugins.manager import get_plugins_manager
+from .....shipping.models import ShippingZone
+from .....webhook.transport.shipping_helpers import to_shipping_app_id
+from ....tests.utils import get_graphql_content
+
+REFRESH = """
+mutation Refresh($id: ID!) {
+  checkoutShippingRefresh(id: $id) {
+    checkout { id updatedAt }
+    shippingMethods { id active name price { amount currency } }
+    collectionPoints { id }
+    deliveryMethod { ... on ShippingMethod { id active } ... on Warehouse { id } }
+    selectedMethodValid
+    calculatedAt
+    errors { field code message }
+  }
+}
+"""
+
+
+def refresh(client, checkout):
+    response = client.post_graphql(
+        REFRESH, {"id": graphene.Node.to_global_id("Checkout", checkout.pk)}
+    )
+    return get_graphql_content(response)["data"]["checkoutShippingRefresh"]
+
+
+def saved_delivery_state(checkout):
+    checkout.refresh_from_db()
+    return (
+        checkout.last_change,
+        checkout.shipping_method_id,
+        checkout.collection_point_id,
+        checkout.shipping_method_name,
+        checkout.undiscounted_base_shipping_price_amount,
+    )
+
+
+def test_refresh_keeps_saved_selection_prices_and_updated_at(
+    api_client, checkout_ready_to_complete
+):
+    # given
+    checkout = checkout_ready_to_complete
+    before = saved_delivery_state(checkout)
+    order_count = Order.objects.count()
+    # when
+    data = refresh(api_client, checkout)
+    # then
+    assert not data["errors"]
+    assert data["calculatedAt"]
+    assert data["selectedMethodValid"]
+    assert data["deliveryMethod"]["id"] == graphene.Node.to_global_id(
+        "ShippingMethod", checkout.shipping_method_id
+    )
+    assert saved_delivery_state(checkout) == before
+    assert Order.objects.count() == order_count
+
+
+def test_refresh_does_not_offer_or_clear_inapplicable_saved_method(
+    api_client, checkout_ready_to_complete
+):
+    # given
+    checkout = checkout_ready_to_complete
+    ShippingZone.objects.update(countries=[])
+    before = saved_delivery_state(checkout)
+    # when
+    data = refresh(api_client, checkout)
+    # then
+    assert not data["errors"]
+    assert data["shippingMethods"] == []
+    assert not data["selectedMethodValid"]
+    assert data["deliveryMethod"]["active"] is False
+    assert saved_delivery_state(checkout) == before
+
+
+def test_refresh_missing_shipping_address_is_not_a_success_empty_list(
+    api_client, checkout_with_item
+):
+    # given
+    checkout = checkout_with_item
+    before = saved_delivery_state(checkout)
+    # when
+    data = refresh(api_client, checkout)
+    # then
+    assert data["errors"][0]["code"] == "SHIPPING_ADDRESS_NOT_SET"
+    assert data["errors"][0]["field"] == "shippingAddress"
+    assert data["checkout"] is None
+    assert data["shippingMethods"] == []
+    assert saved_delivery_state(checkout) == before
+
+
+def test_refresh_digital_checkout_needs_no_delivery(
+    api_client, checkout_without_shipping_required
+):
+    # given
+    checkout = checkout_without_shipping_required
+    before = saved_delivery_state(checkout)
+    # when
+    data = refresh(api_client, checkout)
+    # then
+    assert not data["errors"]
+    assert data["shippingMethods"] == []
+    assert data["collectionPoints"] == []
+    assert data["selectedMethodValid"]
+    assert saved_delivery_state(checkout) == before
+
+
+@pytest.mark.parametrize("error", [SyncEventError("timeout")])
+def test_refresh_service_failure_preserves_saved_delivery(
+    api_client, checkout_ready_to_complete, monkeypatch, error
+):
+    # given
+    checkout = checkout_ready_to_complete
+    manager = get_plugins_manager(allow_replica=False)
+    before = saved_delivery_state(checkout)
+
+    def fail(*args, **kwargs):
+        raise error
+
+    monkeypatch.setattr(manager, "list_shipping_methods_for_checkout", fail)
+    with patch(
+        "saleor.graphql.checkout.mutations.checkout_shipping_refresh."
+        "get_plugin_manager_promise"
+    ) as loader:
+        loader.return_value.get.return_value = manager
+        # when
+        data = refresh(api_client, checkout)
+    # then
+    assert data["errors"][0]["code"] == "SHIPPING_SERVICE_ERROR"
+    assert data["checkout"] is None
+    assert not data["selectedMethodValid"]
+    assert saved_delivery_state(checkout) == before
+
+
+@patch("saleor.webhook.transport.synchronous.transport.send_webhook_request_sync")
+def test_refresh_recalculates_current_external_methods_instead_of_cached_result(
+    send, api_client, checkout_ready_to_complete, shipping_app, settings
+):
+    # given
+    settings.PLUGINS = ["saleor.plugins.webhook.plugin.WebhookPlugin"]
+    checkout = checkout_ready_to_complete
+    before = saved_delivery_state(checkout)
+    send.return_value = [
+        {
+            "id": "live",
+            "name": "Current shipping",
+            "amount": Decimal(9),
+            "currency": checkout.currency,
+        }
+    ]
+    # when
+    data = refresh(api_client, checkout)
+    # then
+    assert not data["errors"]
+    assert send.called
+    method = next(
+        method
+        for method in data["shippingMethods"]
+        if method["name"] == "Current shipping"
+    )
+    assert method["id"] == to_shipping_app_id(shipping_app, "live")
+    assert saved_delivery_state(checkout) == before
