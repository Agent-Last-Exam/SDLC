diff --git a/saleor/plugins/webhook/tests/test_fresh_shipping.py b/saleor/plugins/webhook/tests/test_fresh_shipping.py
new file mode 100644
index 0000000000000000000000000000000000000000..107eeef3f695324dec395c9e9a4d069442f39556
--- /dev/null
+++ b/saleor/plugins/webhook/tests/test_fresh_shipping.py
@@ -0,0 +1,100 @@
+from unittest.mock import patch
+
+import pytest
+
+from ....checkout.shipping_context import (
+    fresh_shipping_calculation,
+    recalculate_shipping,
+)
+from ....core.exceptions import SyncEventError
+from ....webhook.event_types import WebhookEventSyncType
+from ....webhook.transport.shipping import (
+    get_excluded_shipping_methods_or_fetch,
+    parse_list_shipping_methods_response,
+)
+
+
+@patch("saleor.plugins.webhook.plugin.trigger_webhook_sync_if_not_cached")
+@patch("saleor.plugins.webhook.plugin.trigger_webhook_sync")
+def test_fresh_shipping_bypasses_cached_list(
+    sync, cached, webhook_plugin, checkout_with_item, shipping_app
+):
+    # given
+    sync.return_value = []
+    plugin = webhook_plugin()
+    # when
+    with recalculate_shipping():
+        assert plugin.get_shipping_methods_for_checkout(checkout_with_item, None) == []
+    # then
+    sync.assert_called_once()
+    cached.assert_not_called()
+    assert sync.call_args.kwargs["allow_replica"] is False
+    assert fresh_shipping_calculation.get() is False
+
+
+@pytest.mark.parametrize("response", [None, {}, [{"id": "bad"}]])
+@patch("saleor.plugins.webhook.plugin.trigger_webhook_sync")
+def test_fresh_shipping_rejects_service_failure_or_malformed_result(
+    sync, response, webhook_plugin, checkout_with_item, shipping_app
+):
+    # given
+    sync.return_value = response
+    plugin = webhook_plugin()
+    # when / then
+    with pytest.raises(SyncEventError), recalculate_shipping():
+        plugin.get_shipping_methods_for_checkout(checkout_with_item, None)
+    assert fresh_shipping_calculation.get() is False
+
+
+@patch("saleor.webhook.transport.shipping.trigger_webhook_sync_if_not_cached")
+@patch("saleor.webhook.transport.shipping.trigger_webhook_sync")
+def test_fresh_shipping_bypasses_exclusion_cache(
+    sync, cached, checkout_with_item, shipping_app
+):
+    # given
+    sync.return_value = {"excluded_methods": []}
+    # when
+    with recalculate_shipping():
+        result = get_excluded_shipping_methods_or_fetch(
+            shipping_app.webhooks.all(),
+            WebhookEventSyncType.CHECKOUT_FILTER_SHIPPING_METHODS,
+            '{"checkout": {}}',
+            checkout_with_item,
+            True,
+            None,
+        )
+    # then
+    assert not result
+    sync.assert_called_once()
+    cached.assert_not_called()
+    assert sync.call_args.kwargs["allow_replica"] is False
+
+
+@pytest.mark.parametrize(
+    "response",
+    [None, [], {}, {"excluded_methods": None}, {"excluded_methods": [{"id": "bad"}]}],
+)
+@patch("saleor.webhook.transport.shipping.trigger_webhook_sync")
+def test_fresh_shipping_does_not_treat_failed_exclusions_as_available(
+    sync, response, checkout_with_item, shipping_app
+):
+    # given
+    sync.return_value = response
+    # when / then
+    with pytest.raises(SyncEventError), recalculate_shipping():
+        get_excluded_shipping_methods_or_fetch(
+            shipping_app.webhooks.all(),
+            WebhookEventSyncType.CHECKOUT_FILTER_SHIPPING_METHODS,
+            '{"checkout": {}}',
+            checkout_with_item,
+            False,
+            None,
+        )
+
+
+def test_fresh_shipping_empty_methods_are_a_valid_response(shipping_app):
+    # given / when
+    with recalculate_shipping():
+        methods = parse_list_shipping_methods_response([], shipping_app, "USD")
+    # then
+    assert methods == []
