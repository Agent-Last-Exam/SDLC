eor.\nsaleor/settings.py:29:from . import PatchedSubscriberExecutionContext, __version__\nsaleor/settings.py:187:# URL on which Saleor is hosted (e.g., https://api.example.com/). This has precedence\nsaleor/settings.py:247:# Additional password algorithms that can be used by Saleor.\nsaleor/settings.py:339:    \"version\": 1,\nsaleor/settings.py:649:# by custom code (e.g., a Saleor fork), the expiration is still present.\nsaleor/settings.py:744:# Saleor needs time to process sending `APP_DELETED` webhook and possible retrying,\nsaleor/settings.py:828:        release=__version__,\nsaleor/settings.py:1082:# Whether to raise or log exceptions for telemetry unit conversion errors\nsaleor/settings.py:1083:# Disabled by default to prevent disruptions caused by unexpected unit conversion issues\nsaleor/settings.py:1084:TELEMETRY_RAISE_UNIT_CONVERSION_ERRORS = False\npyproject.toml:7:version = \"3.22.0\"\npyproject.toml:9:authors = [{ name = \"Saleor Commerce\", email = \"hello@saleor.io\" }]\npyproject.toml:69:    \"semantic-version>=2.10.0,<3\",\npyproject.toml:161:Release new Saleor verison\npyproject.toml:226:target-version = \"py312\"\n", "exitCode": 0, "durationMs": 0}, "threadId": "01a0bfb7-01f3-72c2-b872-82eade8ed25e", "turnId": "01a0bfb7-0694-73f0-a73b-0cfef2f22c59", "completedAtMs": 1789922903956}, "emittedAtMs": 1789922903962}
