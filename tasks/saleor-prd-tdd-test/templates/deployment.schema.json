{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prepare",
    "services",
    "healthchecks"
  ],
  "properties": {
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "argv",
          "cwd"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "description": "Absolute directory beneath /workspace/deployment"
          }
        }
      }
    },
    "healthchecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "http://127.0.0.1:<port>/path, returns 2xx"
      }
    },
    "prepare": {
      "type": "array",
      "maxItems": 12,
      "description": "Executed in order in a fresh candidate copy before starting services; no previous deployment files survive.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "cwd"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "description": "Absolute directory beneath /workspace/deployment; candidate source is /workspace/deployment/repos"
          }
        }
      }
    }
  }
}
