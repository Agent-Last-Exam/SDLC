-      () => Promise.resolve([]),
-      variables => updateMetadata({ variables }),
-      variables => updatePrivateMetadata({ variables }),
-    );
-  }, [initialData, updateMetadata, updatePrivateMetadata]);
-
-  const variantSubmitHandler = useMemo(() => {
