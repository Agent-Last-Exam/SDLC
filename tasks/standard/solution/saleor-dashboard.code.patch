-        events.find(
-          ({ orderId, type }) => type === GiftCardEventsEnum.USED_IN_ORDER && orderId === args.id,
-        ),
-      ),
-    );
-
-    if (!usedInOrderEvents.length) {
-      return null;
-    }
-
-    return usedInOrderEvents.reduce((resultAmount, { balance }) => {
-      /**
