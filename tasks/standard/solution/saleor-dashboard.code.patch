+                    </Text>
+                  </Box>
+                </Box>
+              </Box>
+            </RadioGroup>
+          </Box>
+        </Box>
+
+        {/* Outcome prediction */}
+        {canSubmit && selectedAmount > 0 && (
+          <Box display="flex" alignItems="center" gap={1}>
+            <Text size={2} color="default2">
