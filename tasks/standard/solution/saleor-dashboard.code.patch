-        # Job Status (success|failure|cancelled)
-        self.job_status: str = os.environ["JOB_STATUS"]
-
-        # The kind of job (deployment, release tests, ...)
-        self.job_kind: str = os.getenv("JOB_KIND", "deployment")
-
-    @property
-    def run_permalink(self) -> str:
