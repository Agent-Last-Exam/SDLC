diff --git a/src/products/components/ProductVariantNavigation/hooks/useScrollIntoView.ts b/src/products/components/ProductVariantNavigation/hooks/useScrollIntoView.ts
new file mode 100644
index 0000000000000000000000000000000000000000..11fbe9e48c03e1098d635c513b91a29a0b057ea2
--- /dev/null
+++ b/src/products/components/ProductVariantNavigation/hooks/useScrollIntoView.ts
@@ -0,0 +1,27 @@
+import { useCallback, useRef } from "react";
+
+const DEFAULT_SCROLL_OPTIONS: ScrollIntoViewOptions = { block: "nearest" };
+
+interface UseScrollIntoViewOptions {
+  isActive: boolean;
+  scrollOptions?: ScrollIntoViewOptions;
+}
+
+export const useScrollIntoView = <T extends HTMLElement>({
+  isActive,
+  scrollOptions = DEFAULT_SCROLL_OPTIONS,
+}: UseScrollIntoViewOptions) => {
+  const scrolledRef = useRef(false);
+
+  const scrollRef = useCallback(
+    (node: T | null) => {
+      if (isActive && node && !scrolledRef.current) {
+        node.scrollIntoView(scrollOptions);
+        scrolledRef.current = true;
+      }
+    },
+    [isActive, scrollOptions],
+  );
+
+  return { scrollRef };
+};
