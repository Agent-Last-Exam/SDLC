+  return (
+    <Box display="flex" flexDirection="column" gap={3}>
+      <Box display="flex" alignItems="center" gap={3}>
+        <Box display="flex" alignItems="center">
+          <Eye
+            size={18}
+            color={
+              summary.visibleInListings ? SUCCESS_ICON_COLOR : "var(--mu-colors-text-default2)"
