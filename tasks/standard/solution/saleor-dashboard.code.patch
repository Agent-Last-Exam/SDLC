+          >
+            <FormattedMessage
+              {...messages.captureButton}
+              values={{
+                amount: intl.formatNumber(selectedAmount, {
+                  style: "currency",
+                  currency,
+                }),
+              }}
+            />
+          </ConfirmButton>
+        </DashboardModal.Actions>
+      </DashboardModal.Content>
+    </DashboardModal>
+  );
+};
