+    const key = getDateGroupKey(event.date);
+
+    if (!groupMap.has(key)) {
+      groupMap.set(key, groups.length);
+      groups.push([key, []]);
+    }
+
+    const index = groupMap.get(key)!;
+
+    groups[index][1].push(event);
+  });
+
+  return groups;
+};
