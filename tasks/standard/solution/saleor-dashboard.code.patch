-        cancelled: true,
-        authorizedPending: authorizePending > 0,
-        chargedPending: chargePending > 0,
-        cancelledPending: cancelPending > 0,
-      };
-    }
-
-    if (authorized && charged) {
-      return {
-        authorized: true,
-        charged: true,
-        cancelled: !!cancelled,
-        authorizedPending: false,
-        chargedPending: false,
-        cancelledPending: false,
-      };
-    }
-
-    if (charged !== 0 && charged !== total) {
-      return {
-        authorized: false,
-        charged: true,
-        cancelled: !!cancelled,
-        authorizedPending: false,
-        chargedPending: false,
-        cancelledPending: false,
-      };
-    }
-
-    if (authorized !== 0) {
-      return {
-        authorized: true,
-        charged: false,
-        cancelled: !!cancelled,
-        authorizedPending: false,
-        chargedPending: false,
-        cancelledPending: false,
-      };
-    }
-
-    if (cancelled) {
-      return {
-        authorized: false,
-        charged: false,
-        cancelled: true,
-        authorizedPending: false,
-        chargedPending: false,
-        cancelledPending: false,
-      };
-    }
-
-    return {
-      charged: false,
-      authorized: false,
-      cancelled: false,
-      authorizedPending: false,
-      chargedPending: false,
-      cancelledPending: false,
-    };
-  }
-}
