+}
+
+.attributesSectionWrapper {
+  position: relative;
+  height: 260px;
+  min-height: 260px;
+  max-height: 300px;
+  flex-shrink: 0;
+}
+
+.attributesSection {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+  padding: 24px;
+  height: 100%;
+  max-height: 300px;
+  overflow-y: auto;
+}
+
+.attributesSectionWrapper::after {
+  content: "";
+  position: absolute;
+  bottom: 1px;
+  left: 1px;
+  right: 1px;
+  height: 32px;
+  background: linear-gradient(
+    to top,
+    color-mix(in srgb, var(--mu-colors-background-default1) 70%, transparent),
+    transparent
+  );
+  pointer-events: none;
+  border-radius: 0 0 7px 7px;
+}
+
+/* Required attributes section - same height as selection */
+.requiredAttributesSectionWrapper {
+  position: relative;
+  height: 260px;
+  min-height: 260px;
+  max-height: 300px;
+  flex-shrink: 0;
+}
+
+.requiredAttributesSection {
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+  padding: 24px;
+  height: 100%;
+  max-height: 300px;
+  overflow-y: auto;
+}
+
+.requiredAttributesSectionWrapper::after {
+  content: "";
+  position: absolute;
+  bottom: 1px;
+  left: 1px;
+  right: 1px;
+  height: 32px;
+  background: linear-gradient(
