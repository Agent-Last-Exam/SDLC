+            {cancelableStatuses.includes(fulfillment?.status) && (
+              <Dropdown>
+                <Dropdown.Trigger>
+                  <Button
+                    variant="tertiary"
+                    icon={<EllipsisVertical />}
+                    data-test-id="fulfillment-menu-button"
+                    // optical alignment
+                    __marginRight={"-16px"}
+                    title="Show more"
+                  />
+                </Dropdown.Trigger>
+                <Dropdown.Content align="end">
+                  <List
+                    padding={2}
+                    borderRadius={4}
+                    boxShadow="defaultOverlay"
+                    backgroundColor="default1"
+                  >
+                    <Dropdown.Item>
+                      <List.Item
+                        borderRadius={4}
+                        paddingX={1.5}
+                        paddingY={2}
+                        onClick={onOrderFulfillmentCancel}
+                        data-test-id="cancel-fulfillment"
+                      >
+                        <Text>Cancel fulfillment</Text>
+                      </List.Item>
+                    </Dropdown.Item>
+                  </List>
+                </Dropdown.Content>
+              </Dropdown>
+            )}
+          </Box>
+        }
+      />
+      <DashboardCard.Content paddingX={0}>
+        <OrderDetailsDatagrid
+          lines={getLines()}
+          loading={false}
+          onOrderLineShowMetadata={onOrderLineShowMetadata}
+          datagridCustomTheme={{
+            bgHeader: themeValues.colors.background.default2,
+          }}
+        />
+        <Box
