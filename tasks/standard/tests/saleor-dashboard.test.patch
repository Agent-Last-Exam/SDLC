+
+const dirname = path.dirname(fileURLToPath(import.meta.url));
+
+export default defineConfig({
+  test: {
+    coverage: {
+      reportsDirectory: path.join(dirname, "coverage", "storybook"),
+    },
+    onConsoleLog(log) {
+      if (
