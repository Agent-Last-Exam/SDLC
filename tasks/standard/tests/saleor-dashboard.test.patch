+    );
+
+    // Assert
+    expect(result.current.metadataFields).toEqual([
+      {
+        key: "test-key",
+        value: "test-value",
+        id: expect.any(String),
+      },
+    ]);
+    expect(result.current.privateMetadataFields).toEqual([
+      {
+        key: "private-key",
+        value: "private-value",
+        id: expect.any(String),
+      },
+    ]);
+  });
+
+  it("handles update action for metadata keys", () => {
