+
+    const { result } = renderHook(() =>
+      useMetadataForm({
+        graphqlData,
+        submitInProgress: false,
+        lastSubmittedData: undefined,
+      }),
+    );
+
+    const metadataEvent: ChangeEvent = {
+      target: {
+        name: `metadata:0:${EventDataField.value}`,
+        value: "new-value",
