+  describe("when status is WAITING_FOR_APPROVAL", () => {
+    it("renders icon with waiting for approval aria-label", () => {
+      // Arrange & Act
+      render(
+        <Wrapper>
+          <StatusIndicator status={FulfillmentStatus.WAITING_FOR_APPROVAL} />
+        </Wrapper>,
+      );
