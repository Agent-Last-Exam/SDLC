+
+      expect(renderedElement.props.title).toBe("Custom Title");
+    });
+
+    it("falls back to 'Success' for success status without title", () => {
+      // Arrange
+      const { result } = renderHook(() => useNotifier(), { wrapper });
+
+      // Act
+      act(() => {
+        result.current({ status: "success" });
+      });
+
