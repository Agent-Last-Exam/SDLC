+
+      // Assert
+      const renderFn = mockToastCustom.mock.calls[0][0];
+      const renderedElement = renderFn("test-id");
+
+      expect(renderedElement.props.action).toEqual({
+        label: "Undo",
+        onClick: actionFn,
