+      metadata: [{ key: "test-key", value: "old-value", __typename: "MetadataItem" as const }],
+      privateMetadata: [
+        {
+          key: "private-test-key",
+          value: "old-private-value",
+          __typename: "MetadataItem" as const,
+        },
+      ],
