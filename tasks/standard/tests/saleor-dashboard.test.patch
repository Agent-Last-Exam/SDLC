+  });
+
+  describe("excludedFilters option", () => {
+    it("should filter out excluded options from staticOptions", () => {
+      // Arrange
+      const wrapper = createWrapper();
+      const config = createMockConfig();
+      const options: UseModalFiltersOptions = {
