+
+QUERY_CHECKOUT_BASIC_FIELDS = """
+query getCheckout($id: ID) {
+  checkout(id: $id) {
+    id
+    token
+    email
+  }
+}
+"""
+
+
+QUERY_CHECKOUT_LINES_ONLY_ID = """
+query getCheckout($id: ID) {
+  checkout(id: $id) {
