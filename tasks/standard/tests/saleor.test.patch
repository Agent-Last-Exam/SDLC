+      id
+      isGift
+    }
+  }
+}
+"""
+
+
+QUERY_CHECKOUT_LINES_WITH_PRICES = """
+query getCheckout($id: ID) {
+  checkout(id: $id) {
+    token
+    lines {
+      id
+      isGift
+      quantity
+      variant {
+        id
+      }
+      unitPrice {
+        gross {
+          amount
+        }
+      }
+      totalPrice {
+        currency
+        gross {
+          amount
+        }
+      }
+      undiscountedUnitPrice {
+        amount
+        currency
+      }
+      undiscountedTotalPrice {
+        amount
+        currency
+      }
+    }
+  }
+}
+"""
+
