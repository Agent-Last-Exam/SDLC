+                        # Unknown fields, thus should be dropped (but shouldn't return an
+                        # error)
+                        "foo": "bar",
+                        DIRTY: DIRTY,
+                    }
+                },
+            }
+        ]
+    }
+    expected_output = {
+        "blocks": [
+            {
+                "type": "image",
+                "data": {"file": {"url": "https://example.com/image.png"}},
+            }
+        ]
+    }
+
+    actual_output = clean_editorjs(input_data, for_django=False)
+    assert actual_output == expected_output
