+    assert data["errors"][0]["code"] == "GRAPHQL_ERROR"
+    assert (
+        data["errors"][0]["message"]
+        == "At least one of arguments is required: 'byApp', 'byStaffWithIds', 'byStaffWithKeys'."
+    )
+
+
