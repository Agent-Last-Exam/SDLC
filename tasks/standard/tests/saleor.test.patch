+ORDER_QUERY_SHIPPING_METHOD = """
+query OrderQuery($id: ID) {
+  order(id: $id) {
+    shippingMethods {
+      id
+      name
+      active
+      message
+    }
+    availableShippingMethods {
+      id
+      name
+      active
+      message
+    }
+  }
+}
+"""
+
+
+@pytest.fixture
+def available_shipping_methods():
+    methods = []
+    for i in range(2):
+        methods.append(
+            ShippingMethodData(
+                id=str(i),
+                price=Money(Decimal(10), "usd"),
+                name=uuid.uuid4().hex,
+                maximum_order_weight=Weight(kg=0),
+                minimum_order_weight=Weight(kg=0),
