+          }
+          previousPrice {
+            amount
+            currency
+          }
+          newPrice {
+            amount
+            currency
+          }
+        }
+      }
+    }"""
+    webhook = subscription_webhook(query, event_type)
+    subscription_query = SubscriptionQuery(query)
+    webhook.filterable_channel_slugs = subscription_query.get_filterable_channel_slugs()
+    webhook.save()
+
+    previous_price = Decimal("10.00")
